    {
      "hadith_id": 60906,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 13393,
      "text_ar": "عَنْ /94 مَعْمَرٍ /94 ، عَنْ /26 قَتَادَةَ /26 ، /27 عَنِ /26 ابْنِ الْمُسَيِّبِ /26 ، قَالَ : \" /20 يُجْلَدُ أَرْبَعِينَ \" /27 . قَالَ مَعْمَرٌ : وَمَا رَأَيْتُ عَامَّتَهُمْ , إِلا يَقُولُونَ ذَلِكَ * \r\n$13400  13401 13342 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 ذَكْوَانَ /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ /26 ، قَالَ : /27 أَدْرَكْتُ /93 عُمَرَ L5913 /93 ، /93 وَعُثْمَانَ L5543 /93 ، \" وَمَنْ بَعْدَهُمْ مِنَ الْخُلَفَاءِ : /20 لا يَضْرِبُونَ الْمَمْلُوكَ فِي الْقَذْفِ إِلا أَرْبَعِينَ \" /27 * \r\n@ 7 : 438 @ \r\n$13401  13402 13343 /8 /141 عَنْ /94 مَالِكٍ /94 ، عَنْ /26 أَبِي الزِّنَادِ /26 ، /27 \" أَنَّ /26 عُمَرَ بْنَ عَبْدِ الْعَزِيزِ /26 ، \" /20 جَلَدَ عَبْدًا فِي فِرْيَةٍ ثَمَانِينَ \" /27 ، قَالَ : أَبُو الزِّنَادِ ، فَسَأَلْتُ عَبْدَ اللَّهِ بْنَ عَامِرٍ عَنْ ذَلِكَ ؟ فَقَالَ : أَدْرَكْتُ عُمَرَ وَالْخُلَفَاءَ هَلُمَّ جَرَّا ، \" فَمَا رَأَيْتُ أَحَدًا ضَرَبَ فِي الْفِرْيَةِ أَكْثَرَ مِنْ أَرْبَعِينَ * \r\n$13402  13403 13344 /8",
      "sanad_ar": "عَنْ /94 مَعْمَرٍ /94",
      "matn_ar": "عَنْ /26 قَتَادَةَ /26 ، /27 عَنِ /26 ابْنِ الْمُسَيِّبِ /26 ، قَالَ : \" /20 يُجْلَدُ أَرْبَعِينَ \" /27 . قَالَ مَعْمَرٌ : وَمَا رَأَيْتُ عَامَّتَهُمْ , إِلا يَقُولُونَ ذَلِكَ * \r\n$13400  13401 13342 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 ذَكْوَانَ /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ /26 ، قَالَ : /27 أَدْرَكْتُ /93 عُمَرَ L5913 /93 ، /93 وَعُثْمَانَ L5543 /93 ، \" وَمَنْ بَعْدَهُمْ مِنَ الْخُلَفَاءِ : /20 لا يَضْرِبُونَ الْمَمْلُوكَ فِي الْقَذْفِ إِلا أَرْبَعِينَ \" /27 * \r\n@ 7 : 438 @ \r\n$13401  13402 13343 /8 /141 عَنْ /94 مَالِكٍ /94 ، عَنْ /26 أَبِي الزِّنَادِ /26 ، /27 \" أَنَّ /26 عُمَرَ بْنَ عَبْدِ الْعَزِيزِ /26 ، \" /20 جَلَدَ عَبْدًا فِي فِرْيَةٍ ثَمَانِينَ \" /27 ، قَالَ : أَبُو الزِّنَادِ ، فَسَأَلْتُ عَبْدَ اللَّهِ بْنَ عَامِرٍ عَنْ ذَلِكَ ؟ فَقَالَ : أَدْرَكْتُ عُمَرَ وَالْخُلَفَاءَ هَلُمَّ جَرَّا ، \" فَمَا رَأَيْتُ أَحَدًا ضَرَبَ فِي الْفِرْيَةِ أَكْثَرَ مِنْ أَرْبَعِينَ * \r\n$13402  13403 13344 /8",
