      "hadith_id": 59102,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 11589,
      "text_ar": "أَخْبَرَنَا /94 ابْنُ جُرَيْجٍ /94 ، عَنْ /26 مُوسَى بْنِ عُقْبَةَ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قَالَ : \" /20 أَدْنَى مَا أَرَاهُ يُجْزِئُ مِنْ مُتْعَةِ النِّسَاءِ ثَلاثُونَ دِرْهَمًا ، أَوْ مَا أَشْبَهَهَا \" /27 * \r\n$11913  11915 11860 /3 /141 عَنْ /94 مَعْمَرٍ /94 ، عَنْ /26 أَيُّوبَ /26 ، عَنِ /26 ابْنِ سِيرِينَ /26 ، قَالَ : \" كَانَ يُمَتَّعُ بِالْخَادِمِ ، أَوِ النَّفَقَةِ ، وَالْكِسْوَةِ ، /27 /20 وَمَتَّعَ /93 الْحَسَنُ بْنُ عَلِيٍّ L1281 /93 بِمَالٍ أَحْسَبَهُ ، قَالَ : عَشَرَةِ آلافٍ يَعْنِي دِرْهَمٍ \" /27 * \r\n$11914  11916 11861 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ /26 ، عَنِ /26 أَبِيهِ /26 ، عَنِ /26 الْحَسَنِ بْنِ سَعْدٍ /26 ، عَنِ /26 أَبِيهِ /26 ، قَالَ : /27 \" /20 مَتَّعَ /93 الْحَسَنُ بْنُ عَلِيٍّ L1281 /93 امْرَأَتَيْنِ بِعِشْرِينَ أَلْفٍ وَزِقَاقٍ مِنْ عَسَلٍ ، فَقَالَتْ إِحْدَاهُمَا : فَأُرَاهَا    @ 7 : 74 @   جُعْفِيَّةً ، مَتَاعٌ قَلِيلٌ مِنْ حَبِيبٍ مُفَارِقٍ \" /27 * \r\n$11915  11917 11862 /8 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 جَابِرٍ /26 ، عَنِ /26 الشَّعْبِيِّ /26 ، /27 \" أَنَّ /26 شُرَيْحًا /26 /20 مَتَّعَ بِخَمْسِ مِائَةِ دِرْهَمٍ \" /27 * \r\n$11916  11918 11863 /8 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 مَنْصُورٍ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، /27 أَنَّ /26 الأَسْوَدَ بْنَ يَزِيدَ /26 ، \" /20 مَتَّعَ بِثَلاثِ مِائَةِ دِرْهَمٍ \" /27 * \r\n$11917  11919 11864 /3 /141 عَنْ /94 إِسْرَائِيلَ بْنِ يُونُسَ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، \" أَنَّ شُرَيْحًا ، مَتَّعَ بِخَمْسِ مِائَةِ دِرْهَمٍ ، وَمَتَّعَ الأَسْوَدُ بِثَلاثِ مِائَةِ دِرْهَمٍ ، /27 /20 وَمَتَّعَ /93 الْحَسَنُ بْنُ عَلِيٍّ L1281 /93 بِعِشْرِينَ أَلْفَ دِرْهَمٍ ، فَلَمَّا أُتِيَتْ بِهَا وَوُضِعَتْ بَيْنَ يَدَيْهَا , قَالَتْ : مَتَاعٌ قَلِيلٌ مِنْ حَبِيبٍ مُفَارِقٍ \" /27 * \r\n$11918  11920 11865 /3",
      "sanad_ar": "أَخْبَرَنَا /94 ابْنُ جُرَيْجٍ /94",
      "matn_ar": "عَنْ /26 مُوسَى بْنِ عُقْبَةَ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قَالَ : \" /20 أَدْنَى مَا أَرَاهُ يُجْزِئُ مِنْ مُتْعَةِ النِّسَاءِ ثَلاثُونَ دِرْهَمًا ، أَوْ مَا أَشْبَهَهَا \" /27 * \r\n$11913  11915 11860 /3 /141 عَنْ /94 مَعْمَرٍ /94 ، عَنْ /26 أَيُّوبَ /26 ، عَنِ /26 ابْنِ سِيرِينَ /26 ، قَالَ : \" كَانَ يُمَتَّعُ بِالْخَادِمِ ، أَوِ النَّفَقَةِ ، وَالْكِسْوَةِ ، /27 /20 وَمَتَّعَ /93 الْحَسَنُ بْنُ عَلِيٍّ L1281 /93 بِمَالٍ أَحْسَبَهُ ، قَالَ : عَشَرَةِ آلافٍ يَعْنِي دِرْهَمٍ \" /27 * \r\n$11914  11916 11861 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ /26 ، عَنِ /26 أَبِيهِ /26 ، عَنِ /26 الْحَسَنِ بْنِ سَعْدٍ /26 ، عَنِ /26 أَبِيهِ /26 ، قَالَ : /27 \" /20 مَتَّعَ /93 الْحَسَنُ بْنُ عَلِيٍّ L1281 /93 امْرَأَتَيْنِ بِعِشْرِينَ أَلْفٍ وَزِقَاقٍ مِنْ عَسَلٍ ، فَقَالَتْ إِحْدَاهُمَا : فَأُرَاهَا    @ 7 : 74 @   جُعْفِيَّةً ، مَتَاعٌ قَلِيلٌ مِنْ حَبِيبٍ مُفَارِقٍ \" /27 * \r\n$11915  11917 11862 /8 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 جَابِرٍ /26 ، عَنِ /26 الشَّعْبِيِّ /26 ، /27 \" أَنَّ /26 شُرَيْحًا /26 /20 مَتَّعَ بِخَمْسِ مِائَةِ دِرْهَمٍ \" /27 * \r\n$11916  11918 11863 /8 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 مَنْصُورٍ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، /27 أَنَّ /26 الأَسْوَدَ بْنَ يَزِيدَ /26 ، \" /20 مَتَّعَ بِثَلاثِ مِائَةِ دِرْهَمٍ \" /27 * \r\n$11917  11919 11864 /3 /141 عَنْ /94 إِسْرَائِيلَ بْنِ يُونُسَ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، \" أَنَّ شُرَيْحًا ، مَتَّعَ بِخَمْسِ مِائَةِ دِرْهَمٍ ، وَمَتَّعَ الأَسْوَدُ بِثَلاثِ مِائَةِ دِرْهَمٍ ، /27 /20 وَمَتَّعَ /93 الْحَسَنُ بْنُ عَلِيٍّ L1281 /93 بِعِشْرِينَ أَلْفَ دِرْهَمٍ ، فَلَمَّا أُتِيَتْ بِهَا وَوُضِعَتْ بَيْنَ يَدَيْهَا , قَالَتْ : مَتَاعٌ قَلِيلٌ مِنْ حَبِيبٍ مُفَارِقٍ \" /27 * \r\n$11918  11920 11865 /3",
