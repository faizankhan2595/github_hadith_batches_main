      "chapter_id": null,
      "hadith_number": 13780,
      "text_ar": "أَخْبَرَنَا /94 مَعْمَرٌ /94 ، عَنِ /26 الزُّهْرِيِّ /26 ، /27 أَنَّ /93 زَيْدَ بْنَ ثَابِتٍ L3131 /93 ، /93 وَابْنَ عُمَرَ L4967 /93 : كَانَا /20 لا يَرَيَانِ بِبَيْعِ الْقُطُوطِ ، إِذَا خَرَجَتْ ، بَأْسًا ، قَالَ : \" وَلَكِنْ لا يَحِلُّ لِمَنِ ابْتَاعَهَا أَنْ يَبِيعَهَا حَتَّى يَقْبِضَهَا \" /27 * \r\n$13756  13757 /8",
      "sanad_ar": "أَخْبَرَنَا /94 مَعْمَرٌ /94",
      "matn_ar": "عَنِ /26 الزُّهْرِيِّ /26 ، /27 أَنَّ /93 زَيْدَ بْنَ ثَابِتٍ L3131 /93 ، /93 وَابْنَ عُمَرَ L4967 /93 : كَانَا /20 لا يَرَيَانِ بِبَيْعِ الْقُطُوطِ ، إِذَا خَرَجَتْ ، بَأْسًا ، قَالَ : \" وَلَكِنْ لا يَحِلُّ لِمَنِ ابْتَاعَهَا أَنْ يَبِيعَهَا حَتَّى يَقْبِضَهَا \" /27 * \r\n$13756  13757 /8",
