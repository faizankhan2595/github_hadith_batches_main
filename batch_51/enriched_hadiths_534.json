      "chapter_id": null,
      "hadith_number": 18273,
      "text_ar": "حَدَّثَنَا /94 أَبِي /94 ، ثنا /26 مَحْمُودُ بْنُ غَيْلانَ /26 ، ثنا /26 عَلِيُّ بْنُ الْحُسَيْنِ بْنِ شَفِيقٍ /26 ، ثنا /26 الْحُسَيْنُ بْنُ وَاقِدٍ /26 ، ثنا /26 عَلَيْاءُ بْنُ أَحْمَدَ /26 ، /27 عَنْ /26 عِكْرِمَةَ /26 ، قَالَ : /20 يَنْزِلُ اللَّهُ الْمَاءَ مِنَ السَّمَاءِ السَّابِعَةِ ، فَتَسَعُ الْقَطْرَةُ مِنْهُ عَلَى السَّحَابَةِ مِثْلُ الْبَعِيرِ /27 *",
      "sanad_ar": "حَدَّثَنَا /94 أَبِي /94",
      "matn_ar": "ثنا /26 مَحْمُودُ بْنُ غَيْلانَ /26 ، ثنا /26 عَلِيُّ بْنُ الْحُسَيْنِ بْنِ شَفِيقٍ /26 ، ثنا /26 الْحُسَيْنُ بْنُ وَاقِدٍ /26 ، ثنا /26 عَلَيْاءُ بْنُ أَحْمَدَ /26 ، /27 عَنْ /26 عِكْرِمَةَ /26 ، قَالَ : /20 يَنْزِلُ اللَّهُ الْمَاءَ مِنَ السَّمَاءِ السَّابِعَةِ ، فَتَسَعُ الْقَطْرَةُ مِنْهُ عَلَى السَّحَابَةِ مِثْلُ الْبَعِيرِ /27 *",
      "grade": null,
      "page_number": null,
