    {
      "hadith_id": 450948,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 11225,
      "text_ar": "حَدَّثنا /94 مُحَمَّدُ بْنُ إِسْمَاعِيلَ الأَحْمَسِيُّ /94 ، ثنا /26 وَكِيعٌ /26 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 لَيْثٍ /26 ، /27 عَنْ /26 مُجَاهِدٍ /26 ، /26 وَعَطَاءٍ /26 ، /26 وَطَاوُسٍ /26 ، /23 قَالَ /26 سُفْيَانُ /26 : أَوِ اثْنَيْنِ مِنْهُمْ /23 ، قَالُوا : \" /20 كُلُّ شَيْءٍ مِنَ الْقِمَارِ فَهُوَ فِي الْمَيْسِرِ حَتَّى لَعِبَ الصِّبْيَانِ بِالْجَوْزِ \" /27 . وَرَوَى رَاشِدُ بْنُ سَعْدٍ ، وَضَمْرَةُ بْنُ حَبِيبٍ مِثْلَهُ ، وَقَالا : \" حَتَّى الْكِعَابِ ، وَالْجَوْزِ ، وَالْبِيضِ الَّتِي يَلْعَبُ بِهَا الصِّبْيَانُ \" * \r\n\u001bE1348",
      "sanad_ar": "حَدَّثنا /94 مُحَمَّدُ بْنُ إِسْمَاعِيلَ الأَحْمَسِيُّ /94",
      "matn_ar": "ثنا /26 وَكِيعٌ /26 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 لَيْثٍ /26 ، /27 عَنْ /26 مُجَاهِدٍ /26 ، /26 وَعَطَاءٍ /26 ، /26 وَطَاوُسٍ /26 ، /23 قَالَ /26 سُفْيَانُ /26 : أَوِ اثْنَيْنِ مِنْهُمْ /23 ، قَالُوا : \" /20 كُلُّ شَيْءٍ مِنَ الْقِمَارِ فَهُوَ فِي الْمَيْسِرِ حَتَّى لَعِبَ الصِّبْيَانِ بِالْجَوْزِ \" /27 . وَرَوَى رَاشِدُ بْنُ سَعْدٍ ، وَضَمْرَةُ بْنُ حَبِيبٍ مِثْلَهُ ، وَقَالا : \" حَتَّى الْكِعَابِ ، وَالْجَوْزِ ، وَالْبِيضِ الَّتِي يَلْعَبُ بِهَا الصِّبْيَانُ \" * \r\n\u001bE1348",
