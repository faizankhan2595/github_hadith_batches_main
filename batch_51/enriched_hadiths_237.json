    {
      "hadith_id": 453552,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 13829,
      "text_ar": "حَدَّثَنَا /94 أَبُو زُرْعَةَ /94 ، ثنا /26 يَحْيَى بْنُ عَبْدِ اللَّهِ بْنِ بُكَيْرٍ /26 ، حَدَّثَنِي /26 ابْنُ لَهِيعَةَ /26 ، حَدَّثَنِي /26 عَطَاءُ بْنُ دِينَارٍ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، فِي قَوْلِ اللَّهِ : \" /20 /4 قُلْ إِنَّمَا حَرَّمَ رَبِّيَ الْفَوَاحِشَ سورة الأعراف آية 33 /4 : يَعْنِي الزِّنَا \" /27 *",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو زُرْعَةَ /94",
      "matn_ar": "ثنا /26 يَحْيَى بْنُ عَبْدِ اللَّهِ بْنِ بُكَيْرٍ /26 ، حَدَّثَنِي /26 ابْنُ لَهِيعَةَ /26 ، حَدَّثَنِي /26 عَطَاءُ بْنُ دِينَارٍ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، فِي قَوْلِ اللَّهِ : \" /20 /4 قُلْ إِنَّمَا حَرَّمَ رَبِّيَ الْفَوَاحِشَ سورة الأعراف آية 33 /4 : يَعْنِي الزِّنَا \" /27 *",
