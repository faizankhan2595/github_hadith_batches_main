      "hadith_id": 453542,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 13819,
      "text_ar": "حَدَّثَنَا /94 أَبِي /94 ، ثنا /26 مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى /26 ، ثنا /26 مُحَمَّدُ بْنُ ثَوْرٍ /26 ، عَنْ /26 مَعْمَرٍ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، فِي قَوْلُهُ : \" /20 /4 قُلْ هِيَ لِلَّذِينَ آمَنُوا فِي الْحَيَاةِ الدُّنْيَا خَالِصَةً يَوْمَ الْقِيَامَةِ سورة الأعراف آية 32 /4 ، قَالَ : هِيَ لِلْمُؤْمِنِينَ خَالِصَةً فِي الآخِرَةِ ، لا يُشَارِكُهُمْ فِيهَا الْكُفَّارُ ، فَأَمَّا فِي الدُّنْيَا فَقَدْ شَارَكُوهُمْ \" /27 * \r\n$8427  8427 /3",
      "sanad_ar": "حَدَّثَنَا /94 أَبِي /94",
      "matn_ar": "ثنا /26 مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى /26 ، ثنا /26 مُحَمَّدُ بْنُ ثَوْرٍ /26 ، عَنْ /26 مَعْمَرٍ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، فِي قَوْلُهُ : \" /20 /4 قُلْ هِيَ لِلَّذِينَ آمَنُوا فِي الْحَيَاةِ الدُّنْيَا خَالِصَةً يَوْمَ الْقِيَامَةِ سورة الأعراف آية 32 /4 ، قَالَ : هِيَ لِلْمُؤْمِنِينَ خَالِصَةً فِي الآخِرَةِ ، لا يُشَارِكُهُمْ فِيهَا الْكُفَّارُ ، فَأَمَّا فِي الدُّنْيَا فَقَدْ شَارَكُوهُمْ \" /27 * \r\n$8427  8427 /3",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/94,/94,/26,/26,/26,/26,/26,/26,/27,/26,/26,/20,/4,/4,/27,/3",
