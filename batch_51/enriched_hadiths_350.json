      "hadith_id": 455241,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 15518,
      "text_ar": "حَدَّثَنَا /94 عَلِيُّ بْنُ الْحَسَنِ الْهِسِنْجَانِيُّ /94 ، ثنا /26 سَعِيدُ بْنُ أَبِي مَرْيَمَ /26 ، أَنْبَأَ /26 مُفَضَّلُ بْنُ فَضَالَةَ /26 ، /27 عَنْ /26 أَبِي صَخْرٍ /26 ، فِي قَوْلُهُ : \" /20 /4 بِالْغُدُوِّ وَالآصَالِ سورة الأعراف آية 205 /4 ، وَالآصَالِ : مَا بَيْنَ الظُّهْرِ وَالْعَصْرِ \" /27 * \r\n$9508  9508 /8",
      "sanad_ar": "حَدَّثَنَا /94 عَلِيُّ بْنُ الْحَسَنِ الْهِسِنْجَانِيُّ /94",
      "matn_ar": "ثنا /26 سَعِيدُ بْنُ أَبِي مَرْيَمَ /26 ، أَنْبَأَ /26 مُفَضَّلُ بْنُ فَضَالَةَ /26 ، /27 عَنْ /26 أَبِي صَخْرٍ /26 ، فِي قَوْلُهُ : \" /20 /4 بِالْغُدُوِّ وَالآصَالِ سورة الأعراف آية 205 /4 ، وَالآصَالِ : مَا بَيْنَ الظُّهْرِ وَالْعَصْرِ \" /27 * \r\n$9508  9508 /8",
