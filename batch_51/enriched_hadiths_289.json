      "hadith_id": 454330,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 14607,
      "text_ar": "أَخْبَرَنَا /94 مُحَمَّدُ بْنُ سَعْدٍ /94 ، فِيمَا كَتَبَ إِلَيَّ ، حَدَّثَنِي /26 أَبِي /26 ، حَدَّثَنِي /26 عَمِّي /26 ، عَنْ /26 أَبِيهِ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 \" فَلَمَّا /20 أَتَى موسى فرعون بِالرِّسَالَةِ فَاسْتَكْبَرُوا ، قَالَ : لَنْ أُرْسِلَ مَعَكَ بني إسرائيل \" /27 * \r\n@ 5 : 1550 @",
      "sanad_ar": "أَخْبَرَنَا /94 مُحَمَّدُ بْنُ سَعْدٍ /94",
      "matn_ar": "فِيمَا كَتَبَ إِلَيَّ ، حَدَّثَنِي /26 أَبِي /26 ، حَدَّثَنِي /26 عَمِّي /26 ، عَنْ /26 أَبِيهِ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 \" فَلَمَّا /20 أَتَى موسى فرعون بِالرِّسَالَةِ فَاسْتَكْبَرُوا ، قَالَ : لَنْ أُرْسِلَ مَعَكَ بني إسرائيل \" /27 * \r\n@ 5 : 1550 @",
      "grade": null,
