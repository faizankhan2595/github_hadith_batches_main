    {
      "hadith_id": 454037,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 14314,
      "text_ar": "أَخْبَرَنَا /94 أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ /94 ، فِيمَا كَتَبَ إِلَيَّ ، ثنا /26 أَحْمَدُ بْنُ مُفَضَّلٍ /26 ، ثنا /26 أَسْبَاطُ /26 ، /27 عَنِ /26 السُّدِّيِّ /26 ، قَوْلُهُ : \" /20 /4 وَتَصُدُّونَ عَنْ سَبِيلِ اللَّهِ سورة الأعراف آية 86 /4 ، قَالَ : يَصُدُّونَ مَنْ آمَنَ ، عَنْ سَبِيلِ اللَّهِ \" /27 * \r\n E1727",
      "sanad_ar": "أَخْبَرَنَا /94 أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ /94",
      "matn_ar": "فِيمَا كَتَبَ إِلَيَّ ، ثنا /26 أَحْمَدُ بْنُ مُفَضَّلٍ /26 ، ثنا /26 أَسْبَاطُ /26 ، /27 عَنِ /26 السُّدِّيِّ /26 ، قَوْلُهُ : \" /20 /4 وَتَصُدُّونَ عَنْ سَبِيلِ اللَّهِ سورة الأعراف آية 86 /4 ، قَالَ : يَصُدُّونَ مَنْ آمَنَ ، عَنْ سَبِيلِ اللَّهِ \" /27 * \r\n E1727",
