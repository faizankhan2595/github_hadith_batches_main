      "hadith_id": 454091,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 14368,
      "text_ar": "أَخْبَرَنَا /94 أَبُو يَزِيدَ الْقَرَاطِيسِيُّ /94 ، فِيمَا كَتَبَ إِلَيَّ ، ثنا /26 أَصْبَغُ بْنُ الْفَرَجِ /26 ، قَالَ : /27 سَمِعْتُ /26 عَبْدَ الرَّحْمَنِ بْنَ زَيْدِ بْنِ أَسْلَمَ /26 ، فِي قَوْلِ اللَّهِ : \" /20 /4 ثُمَّ بَدَّلْنَا مَكَانَ السَّيِّئَةِ الْحَسَنَةَ سورة الأعراف آية 95 /4 ، يَقُولُ : بَدَّلْنَا مَا كَانَ كَرِهُوا مَا أَحَبُّوا فِي الدُّنْيَا \" /27 *",
      "sanad_ar": "أَخْبَرَنَا /94 أَبُو يَزِيدَ الْقَرَاطِيسِيُّ /94",
      "matn_ar": "فِيمَا كَتَبَ إِلَيَّ ، ثنا /26 أَصْبَغُ بْنُ الْفَرَجِ /26 ، قَالَ : /27 سَمِعْتُ /26 عَبْدَ الرَّحْمَنِ بْنَ زَيْدِ بْنِ أَسْلَمَ /26 ، فِي قَوْلِ اللَّهِ : \" /20 /4 ثُمَّ بَدَّلْنَا مَكَانَ السَّيِّئَةِ الْحَسَنَةَ سورة الأعراف آية 95 /4 ، يَقُولُ : بَدَّلْنَا مَا كَانَ كَرِهُوا مَا أَحَبُّوا فِي الدُّنْيَا \" /27 *",
      "grade": null,
