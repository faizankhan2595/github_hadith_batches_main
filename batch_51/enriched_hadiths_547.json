      "chapter_id": null,
      "hadith_number": 18472,
      "text_ar": "ذَكَرَهُ /26 أَبُو زُرْعَةَ L5401 /26 ، ثنا /26 الْحَسَنُ بْنُ عَطِيَّةَ L1278 /26 ، ثنا /26 إِسْرَائِيلُ L982 /26 ، عَنْ /26 أَبِي إِسْحَاقَ L6155 /26 ، عَنْ /26 أَبِي خُوصٍ L6260 /26 ، /27 عَنْ /93 عَبْدِ اللَّهِ L5079 /93 أَنَّهُ قَالَ : /20 فِي الْقُرْآنِ شِفَاءَانِ : الْقُرْآنُ وَالْعَسَلُ ، فَالْقُرْآنُ شِفَاءٌ لِمَا فِي الصُّدُورِ ، وَالْعَسَلُ شِفَاءٌ مِنْ كُلِّ دَاءٍ /27 * \r\n$11250  11248 /8",
      "sanad_ar": "ذَكَرَهُ /26 أَبُو زُرْعَةَ L5401 /26",
      "matn_ar": "ثنا /26 الْحَسَنُ بْنُ عَطِيَّةَ L1278 /26 ، ثنا /26 إِسْرَائِيلُ L982 /26 ، عَنْ /26 أَبِي إِسْحَاقَ L6155 /26 ، عَنْ /26 أَبِي خُوصٍ L6260 /26 ، /27 عَنْ /93 عَبْدِ اللَّهِ L5079 /93 أَنَّهُ قَالَ : /20 فِي الْقُرْآنِ شِفَاءَانِ : الْقُرْآنُ وَالْعَسَلُ ، فَالْقُرْآنُ شِفَاءٌ لِمَا فِي الصُّدُورِ ، وَالْعَسَلُ شِفَاءٌ مِنْ كُلِّ دَاءٍ /27 * \r\n$11250  11248 /8",
