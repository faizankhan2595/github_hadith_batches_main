      "hadith_id": 259371,
      "book_id": 228,
      "chapter_id": null,
      "hadith_number": 273,
      "text_ar": "حَدَّثَنَا /94 مُجَاهِدُ بْنُ مُوسَى /94 ، ثنا /26 إِسْمَاعِيلُ بْنُ عُلَيَّةَ /26 ، عَنْ /26 لَيْثٍ /26 ، /27 عَنِ /26 الْحَكَمِ /26 ، قَالَ : /20 \" إِذَا كَثُرَتْ ذُنُوبُ الْعَبْدِ ، وَلَمْ يَكُنْ لَهُ مِنَ الْعَمَلِ مَا يُكَفِّرُهَا عَنْهُ ، ابْتَلاهُ اللَّهُ بِالْحُزْنِ لِيُكَفِّرَهَا عَنْهُ \" /27 * \r\n@ 1 : 131 @ \r\n$164  164 /8",
      "sanad_ar": "حَدَّثَنَا /94 مُجَاهِدُ بْنُ مُوسَى /94",
      "matn_ar": "ثنا /26 إِسْمَاعِيلُ بْنُ عُلَيَّةَ /26 ، عَنْ /26 لَيْثٍ /26 ، /27 عَنِ /26 الْحَكَمِ /26 ، قَالَ : /20 \" إِذَا كَثُرَتْ ذُنُوبُ الْعَبْدِ ، وَلَمْ يَكُنْ لَهُ مِنَ الْعَمَلِ مَا يُكَفِّرُهَا عَنْهُ ، ابْتَلاهُ اللَّهُ بِالْحُزْنِ لِيُكَفِّرَهَا عَنْهُ \" /27 * \r\n@ 1 : 131 @ \r\n$164  164 /8",
      "grade": null,
