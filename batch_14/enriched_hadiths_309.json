    {
      "hadith_id": 121624,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 21250,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الرَّبِيعِ /26 ، عَنِ /26 ابْنِ سِيرِينَ /26 ، قَالَ : /27 قُلْتُ /26 لِعَبِيدَةَ /26 : /20 \" أَشْتَرِي السَّرِقَةَ وَأَنَا أَعْلَمُ أَنَّهَا سَرِقَةٌ ؟ \" ، قَالَ : \" لَا \" ، قُلْتُ : \" فَأَشْتَرِي الْخِيَانَةَ وَأَنَا أَعْلَمُ أَنَّهَا خِيَانَةٌ ؟ \" ، قَالَ : \" لَا \" ، قُلْتُ : \" فَأَشْتَرِي نَيْلَ الْعَمَلِ ؟ \" ، قَالَ : \" وَهَلْ تَسْتَطِيعُ تَرْكَهُ ؟ \" /27 ، حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 أَبُو أُسَامَةَ /94 ، عَنْ /26 هَاشِمٍ /26 ، عَنِ /26 ابْنِ سِيرِينَ /26 ، عَنْ /26 عُبَيْدَةَ /26 : بِمِثْلِهِ *",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الرَّبِيعِ /26 ، عَنِ /26 ابْنِ سِيرِينَ /26 ، قَالَ : /27 قُلْتُ /26 لِعَبِيدَةَ /26 : /20 \" أَشْتَرِي السَّرِقَةَ وَأَنَا أَعْلَمُ أَنَّهَا سَرِقَةٌ ؟ \" ، قَالَ : \" لَا \" ، قُلْتُ : \" فَأَشْتَرِي الْخِيَانَةَ وَأَنَا أَعْلَمُ أَنَّهَا خِيَانَةٌ ؟ \" ، قَالَ : \" لَا \" ، قُلْتُ : \" فَأَشْتَرِي نَيْلَ الْعَمَلِ ؟ \" ، قَالَ : \" وَهَلْ تَسْتَطِيعُ تَرْكَهُ ؟ \" /27 ، حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 أَبُو أُسَامَةَ /94 ، عَنْ /26 هَاشِمٍ /26 ، عَنِ /26 ابْنِ سِيرِينَ /26 ، عَنْ /26 عُبَيْدَةَ /26 : بِمِثْلِهِ *",
      "grade": null,
