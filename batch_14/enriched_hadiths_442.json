    {
      "hadith_id": 123619,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 23245,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، /27 عَنِ /26 ابْنِ أَبِي نَجِيحٍ /26 ، عَنْ مُجَاهِدٍ ، قَالَ : /20 مَاءُ /60 زَمْزَمَ /60 لِمَا شُرِبَ لَهُ \" /27 * \r\n$23113  /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 مُغِيرَةَ بْنِ زِيَادٍ /26 ، عَنْ /26 عَطَاءٍ /26 /27 /20 \" فِي مَاءِ /60 زَمْزَمَ /60 يَخْرُجُ بِهِ مِنَ الْحَرَمِ \" , فَقَالَ : انْتَقَلَ كَعْبٌ بِثِنْتَيْ عَشْرَةَ رَاوِيَةٍ إِلَى الشَّامِ يَسْتَقُونَ بِهَا \" /27 * \r\n$23114  /2",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، /27 عَنِ /26 ابْنِ أَبِي نَجِيحٍ /26 ، عَنْ مُجَاهِدٍ ، قَالَ : /20 مَاءُ /60 زَمْزَمَ /60 لِمَا شُرِبَ لَهُ \" /27 * \r\n$23113  /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 مُغِيرَةَ بْنِ زِيَادٍ /26 ، عَنْ /26 عَطَاءٍ /26 /27 /20 \" فِي مَاءِ /60 زَمْزَمَ /60 يَخْرُجُ بِهِ مِنَ الْحَرَمِ \" , فَقَالَ : انْتَقَلَ كَعْبٌ بِثِنْتَيْ عَشْرَةَ رَاوِيَةٍ إِلَى الشَّامِ يَسْتَقُونَ بِهَا \" /27 * \r\n$23114  /2",
