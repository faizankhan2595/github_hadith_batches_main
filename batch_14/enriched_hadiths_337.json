    {
      "hadith_id": 122043,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 21669,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنْ /26 حَجَّاجٍ /26 ، /27 عَنْ /26 عُمَيْرِ بْنِ سَعِيدٍ /26 ، قَالَ : /20 \" كُنَّا نُعْطِي أَهْلَ الْغَنَمِ عَلَى أَنْ يُعْطُونَا كَذَا وَكَذَا مِنَ الْجُبْنِ , وَكَذَا وَكَذَا مِنَ السَّمْنِ , وَكَذَا وَكَذَا مِنَ الْمَصْلِ \" /27 , فَسَأَلْتُ عَلْقَمَةَ ، وَمَسْرُوقًا ، وَعَبْدَ الرَّحْمَنِ بْنَ أَبِي لَيْلَى ، فَكُلُّهُمْ نَهَانِي عَنْهُ \" * \r\n$21819  /8",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنْ /26 حَجَّاجٍ /26 ، /27 عَنْ /26 عُمَيْرِ بْنِ سَعِيدٍ /26 ، قَالَ : /20 \" كُنَّا نُعْطِي أَهْلَ الْغَنَمِ عَلَى أَنْ يُعْطُونَا كَذَا وَكَذَا مِنَ الْجُبْنِ , وَكَذَا وَكَذَا مِنَ السَّمْنِ , وَكَذَا وَكَذَا مِنَ الْمَصْلِ \" /27 , فَسَأَلْتُ عَلْقَمَةَ ، وَمَسْرُوقًا ، وَعَبْدَ الرَّحْمَنِ بْنَ أَبِي لَيْلَى ، فَكُلُّهُمْ نَهَانِي عَنْهُ \" * \r\n$21819  /8",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/94,/94,/26,/26,/27,/26,/26,/20,/27,/8",
