      "hadith_id": 125495,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 25121,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، عَنْ /26 حَبِيبِ بْنِ حُجْرٍ الْعَبْسِيِّ L2259 /26 ، عَنْ /26 ثَابِتٍ L2009 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 ، قَالَ : مَرَّ عَلَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ صِبْيَانٌ فَقَالَ : /20 السَّلامُ عَلَيْكُمْ يَا صِبْيَانُ \" /27 * \r\n$25185  3 /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الأَعْمَشِ /26 ، عَنِ /26 الْحَكَمِ /26 ، /27 عَنْ /26 شُرَيْحٍ /26 ، أَنَّهُ كَانَ /20 يُسَلِّمُ عَلَى الصِّبْيَانِ \" /27 * \r\n$25186  4 /8 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ الأَحْمَرُ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنِ /26 الْحَكَمِ /26 ، /27 أَنَّ /26 شُرَيْحًا /26 كَانَ /20 يَمُرُّ عَلَى الصِّبْيَانِ ، فَيُسَلِّمُ عَلَيْهِمْ \" /27 * \r\n$25187  5 /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، /94 وَحَفْصٌ /94 ، عَنْ /26 حَنَشِ بْنِ الْحَارِثِ /26 ، قَالَ : /27 كَانَ /26 عَمْرُو بْنُ مَيْمُونٍ /26 /20 يَمُرُّ عَلَيْنَا وَنَحْنُ صِبْيَانٌ ، فَيُسَلِّمُ عَلَيْنَا \" /27 * \r\n$25188  /8",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ L8160 /94",
      "matn_ar": "عَنْ /26 حَبِيبِ بْنِ حُجْرٍ الْعَبْسِيِّ L2259 /26 ، عَنْ /26 ثَابِتٍ L2009 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 ، قَالَ : مَرَّ عَلَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ صِبْيَانٌ فَقَالَ : /20 السَّلامُ عَلَيْكُمْ يَا صِبْيَانُ \" /27 * \r\n$25185  3 /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الأَعْمَشِ /26 ، عَنِ /26 الْحَكَمِ /26 ، /27 عَنْ /26 شُرَيْحٍ /26 ، أَنَّهُ كَانَ /20 يُسَلِّمُ عَلَى الصِّبْيَانِ \" /27 * \r\n$25186  4 /8 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ الأَحْمَرُ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنِ /26 الْحَكَمِ /26 ، /27 أَنَّ /26 شُرَيْحًا /26 كَانَ /20 يَمُرُّ عَلَى الصِّبْيَانِ ، فَيُسَلِّمُ عَلَيْهِمْ \" /27 * \r\n$25187  5 /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، /94 وَحَفْصٌ /94 ، عَنْ /26 حَنَشِ بْنِ الْحَارِثِ /26 ، قَالَ : /27 كَانَ /26 عَمْرُو بْنُ مَيْمُونٍ /26 /20 يَمُرُّ عَلَيْنَا وَنَحْنُ صِبْيَانٌ ، فَيُسَلِّمُ عَلَيْنَا \" /27 * \r\n$25188  /8",
