      "chapter_id": null,
      "hadith_number": 18832,
      "text_ar": "نا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، /27 عَنِ /26 ابْنِ طَاوُسٍ /26 ، عَنْ /26 أَبِيهِ /26 ، قَالَ : /20 \" اذْبَحْ بِالْحَجَرِ وَاللِّيطَةِ ، وَكُلِّ شَيْءٍ مِنَ الشَّفْرَةِ ، مَا لَمْ يَجْرَحْ أَوْ يَقُدَّ \" /27 * \r\n$19235  19 /8",
      "sanad_ar": "نا /94 يَحْيَى بْنُ سَعِيدٍ /94",
      "matn_ar": "عَنِ /26 ابْنِ جُرَيْجٍ /26 ، /27 عَنِ /26 ابْنِ طَاوُسٍ /26 ، عَنْ /26 أَبِيهِ /26 ، قَالَ : /20 \" اذْبَحْ بِالْحَجَرِ وَاللِّيطَةِ ، وَكُلِّ شَيْءٍ مِنَ الشَّفْرَةِ ، مَا لَمْ يَجْرَحْ أَوْ يَقُدَّ \" /27 * \r\n$19235  19 /8",
