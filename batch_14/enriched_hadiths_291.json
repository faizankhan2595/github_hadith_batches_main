      "chapter_id": null,
      "hadith_number": 20982,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 سَهْلُ بْنُ يُوسُفَ L3681 /94 ، عَنْ /26 حُمَيْدٍ L2531 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 ، قَالَ : \" نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ /20 بَيْعِ الثَّمَرَةِ حَتَّى يَبْدُوَ صَلَاحُهَا \" /27 ، قِيلَ لِأَنَسٍ : \" وَمَا بُدُوُّ صَلَاحِهَا ؟ \" ، قَالَ : \" تَحْمَرُّ أَوْ تَصْفَرُّ \" * \r\n$21219  /8",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 سَهْلُ بْنُ يُوسُفَ L3681 /94 ، عَنْ /26 حُمَيْدٍ L2531 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 ، قَالَ : \" نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ /20 بَيْعِ الثَّمَرَةِ حَتَّى يَبْدُوَ صَلَاحُهَا \" /27 ، قِيلَ لِأَنَسٍ : \" وَمَا بُدُوُّ صَلَاحِهَا ؟ \" ، قَالَ : \" تَحْمَرُّ أَوْ تَصْفَرُّ \" * \r\n$21219  /8",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/94,/94,/26,/26,/27,/93,/93,/20,/27,/8",
