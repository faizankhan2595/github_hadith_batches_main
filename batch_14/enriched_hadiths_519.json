      "hadith_id": 124772,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 24398,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 ابْنُ نُمَيْرٍ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنْ /26 عَبْدِ الأَعْلَى /26 ، قَالَ : /27 سَأَلْتُ /26 ابْنَ الْحَنَفِيَّةِ /26 عَنِ /20 الْخِضَابِ بِالْوَسْمَةِ ، فَقَالَ : هِيَ خِضَابُنَا أَهْلَ الْبَيْتِ \" /27 * \r\n$24437  8 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 مُحَمَّدِ بْنِ إِسْحَاقَ /26 ، قَالَ : /27 كَانَ /26 أَبُو جَعْفَرٍ /26 /20 يَخْتَضِبُ بِثُلُثَيْ حِنَّاءٍ وَثُلُثِ وَسْمَةٍ \" /27 * \r\n$24438  9 /2 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 شَبَابَةُ L3741 /94 ، قَالَ : حَدَّثَنَا /26 لَيْثُ بْنُ سَعْدٍ L6641 /26 ، قَالَ : حَدَّثَنَا /26 أَبُو عُشَانَةَ الْمَعَافِرِيُّ L2601 /26 قَالَ : /27 رَأَيْتُ /93 عُقْبَةَ بْنَ عَامِرٍ L5672 /93 /20 يُخَضِّبُ بِالسَّوَادِ وَيَقُولُ : نُسَوِّدُ أَعْلاهَا وَتَأْبَى أُصُولُهَا \" /27 * \r\n$24439  /3 /141 حَدَّثَنَا أَبُو بَكْرٍ قَالَ : حَدَّثَنَا /94 الْمُقْرِئُ /94 ، عَنْ /26 سَعِيدِ بْنِ أَبِي أَيُّوبَ /26 قَالَ : حَدَّثَنِي /26 يَزِيدُ بْنُ أَبِي حَبِيبٍ /26 أَنَّ /26 أَبَا الْخَيْرِ /26 حَدَّثَهُ /27 عَنْ /93 عُقْبَةَ بْنِ عَامِرٍ /93 : أَنَّهُ كَانَ /20 \" يَصْبُغُ شَعَرَ رَأْسِهِ بِشجَرَةٍ ، يُقَالُ لَهَا : الصَّبِيبُ كَأَشَدِّ السَّوَادِ \" /27 * \r\n$24440  10 /8",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 ابْنُ نُمَيْرٍ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنْ /26 عَبْدِ الأَعْلَى /26 ، قَالَ : /27 سَأَلْتُ /26 ابْنَ الْحَنَفِيَّةِ /26 عَنِ /20 الْخِضَابِ بِالْوَسْمَةِ ، فَقَالَ : هِيَ خِضَابُنَا أَهْلَ الْبَيْتِ \" /27 * \r\n$24437  8 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 مُحَمَّدِ بْنِ إِسْحَاقَ /26 ، قَالَ : /27 كَانَ /26 أَبُو جَعْفَرٍ /26 /20 يَخْتَضِبُ بِثُلُثَيْ حِنَّاءٍ وَثُلُثِ وَسْمَةٍ \" /27 * \r\n$24438  9 /2 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 شَبَابَةُ L3741 /94 ، قَالَ : حَدَّثَنَا /26 لَيْثُ بْنُ سَعْدٍ L6641 /26 ، قَالَ : حَدَّثَنَا /26 أَبُو عُشَانَةَ الْمَعَافِرِيُّ L2601 /26 قَالَ : /27 رَأَيْتُ /93 عُقْبَةَ بْنَ عَامِرٍ L5672 /93 /20 يُخَضِّبُ بِالسَّوَادِ وَيَقُولُ : نُسَوِّدُ أَعْلاهَا وَتَأْبَى أُصُولُهَا \" /27 * \r\n$24439  /3 /141 حَدَّثَنَا أَبُو بَكْرٍ قَالَ : حَدَّثَنَا /94 الْمُقْرِئُ /94 ، عَنْ /26 سَعِيدِ بْنِ أَبِي أَيُّوبَ /26 قَالَ : حَدَّثَنِي /26 يَزِيدُ بْنُ أَبِي حَبِيبٍ /26 أَنَّ /26 أَبَا الْخَيْرِ /26 حَدَّثَهُ /27 عَنْ /93 عُقْبَةَ بْنِ عَامِرٍ /93 : أَنَّهُ كَانَ /20 \" يَصْبُغُ شَعَرَ رَأْسِهِ بِشجَرَةٍ ، يُقَالُ لَهَا : الصَّبِيبُ كَأَشَدِّ السَّوَادِ \" /27 * \r\n$24440  10 /8",
