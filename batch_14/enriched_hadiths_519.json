      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 24409,
      "text_ar": "$24449  1 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنِ /26 ابْنِ أَبِي ذِئْبٍ /26 ، عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ سَعْدٍ /26 ، قَالَ : /27 رَأَيْتُ /93 عُثْمَانَ بْنَ عَفَّانَ L5543 /93 \" وَهُوَ /20 يَبْنِي الزَّوْرَاءَ عَلَى بَغْلَةٍ شَهْبَاءَ ، مُصَفِّرًا لِحْيَتَهُ \" /27 * \r\n$24450  2 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ الْعَيْزَارِ /26 ، عَنْ /26 سَعِيدٍ الْمَدَنِيِّ /26 ، قَالَ : /27 كُنْتُ مَعَ /93 أَبِي هُرَيْرَةَ L4396 /93 فِي جِنَازَةٍ ، \" وَكَانَ /20 مُصَفِّرًا اللِّحْيَةَ \" /27 * \r\n$24451  3 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 هِلالٍ /26 ، قَالَ : حَدَّثَنِي /26 سَوَادَةُ بْنُ حَنْظَلَةَ /26 قَالَ : /27 \" رَأَيْتُ /93 عَلِيًّا /93 /20 أَصْفَرَ اللِّحْيَةِ \" /27 * \r\n$24452  4 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 أَبُو مُعَاوِيَةَ /94 ، عَنِ /26 الأَعْمَشِ /26 ، قَالَ : /27 \" رَأَيْتُ /26 زَيْدَ بْنَ وَهْبٍ /26 /20 يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24453  5 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ قَالَ : حَدَّثَنَا /94 غُنْدَرٌ مُحَمَّدُ بْنُ جَعْفَرٍ /94 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، عَنْ /26 عَطَاءٍ /26 ، قَالَ : /27 رَأَيْتُ /93 ابْنَ عَبَّاسٍ L4883 /93 ، /93 وَابْنَ عُمَرَ L4967 /93 /20 يُصَفِّرَانِ لِحَاهُمَا \" /27 * \r\n$24454  6 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الْعُمَرِيِّ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، أَنَّهُ \" كَانَ /20 يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24455  7 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 الْفَضْلُ بْنُ دُكَيْنٍ /94 ، عَنْ /26 حَمَّادٍ /26 ، عَنْ /26 أَبِي غَالِبٍ /26 ، قَالَ : /27 \" رَأَيْتُ /93 أَبَا أُمَامَةَ L3929 /93 /20 يُصَفِّرُ \" /27 * \r\n$24456  8 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 إِسْحَاقُ بْنُ سُلَيْمَانَ /94 ، عَنْ /26 جَرِيرٍ /26 ، قَالَ : /27 رَأَيْتُ /93 عَبْدَ اللَّهِ بْنَ بُسْرٍ L4742 /93 /20 يُصَفِّرُ لِحْيَتَهُ وَرَأْسَهُ \" /27 * \r\n\u0019E3552 \r\n$24457  9 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 أَبُو خَالِدٍ /94 ، عَنْ /26 يَزِيدَ /26 مَوْلَى سَلَمَةَ ، قَالَ \" /27 \" رَأَيْتُ /26 سَلَمَةَ /26 /20 يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24458  10 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 مُحَمَّدُ بْنُ بِشْرٍ /94 ، عَنْ /26 إِسْمَاعِيلَ /26 ، قَالَ : \" /27 رَأَيْتُ /26 قَيْسًا /26 /20 يُصَفِّرُ لِحْيَتَهُ , وَرَأَيْتُ /26 شِبْلَ بْنَ عَوْفٍ /26 يُصَفِّرُ لِحْيَتَهُ /27 , وَكَانَ مِنْ أَهْلِ الطَّيَالِسَةِ \" * \r\n$24459  11 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 خَالِدِ بْنِ دِينَارٍ /26 ، قَالَ : /27 رَأَيْتُ /93 أَنَسًا L720 /93 ، وَأَبَا الْعَالِيَةِ ، وَأَبَا السِّوَارِ /20 يُصَفِّرُونَ لِحَاهُمْ \" /27 * \r\n@ 6 : 55 @ \r\n$24460  12 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 فِطْرٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 أَبَا وَائِلَ /26 ، /26 وَالْقَاسِمَ /26 ، /26 وَعَطَاءً /26 /20 يُصَفِّرُونَ لِحَاهُمْ \" /27 * \r\n$24461  13 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 هَارُونُ /94 ، عَنْ /26 دَاوُدَ أَبِي الْيَمَانِ /26 ، قَالَ : /27 \" رَأَيْتُ /93 عَبْدَ اللَّهِ بْنَ أَبِي أَوْفَى L4622 /93 /20 يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24462  14 /2 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 أَبُو أُسَامَةَ L2484 /94 ، عَنْ /26 عُبَيْدِ اللَّهِ L5421 /26 ، عَنْ /26 سَعِيدِ بْنِ أَبِي سَعِيدٍ L3280 /26 ، أَنَّ /26 ابْنَ جُرَيْجٍ L5327 /26 ، سَأَلَ ابْنَ عُمَرَ, قَالَ : /27 رَأَيْتُكَ /20 تُصَفِّرُ لِحْيَتَكَ بِالْوَرْسِ , فَقَالَ /93 ابْنُ عُمَرَ L4967 /93 أَمَّا تَصْفِيرِي لِحْيَتِي فَإِنِّي رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24463  15 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 الْمُحَارِبِيُّ /94 ، عَنْ /26 عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ /26 ، قَالَ : /27 \" رَأَيْتُ /93 الْمُغِيرَةَ بْنَ شُعْبَةَ L1665 /93 /20 يُخَضِّبُ بِالصُّفْرَةِ , وَرَأَيْتُ /93 جَرِيرَ بْنَ عَبْدِ اللَّهِ L2123 /93 يُخَضِّبُ بِالصُّفْرَةِ وَالزَّعْفَرَانِ \" /27 * \r\n\u0012E3553 \r\n$24464  16 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 الْمُحَارِبِيُّ /94 ، عَنِ /26 الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الأَسْوَدَ /26 ، /26 وَابْنَ الأَسْوَدِ /26 /20 يُصَفِّرَانِ لِحَاهُمَا \" /27 * \r\n$24465  17 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 عَبْدُ الأَعْلَى /94 ، عَنِ /26 الْمُسْتَمِرِّ بْنِ الرَّيَّانِ /26 ، /27 عَنْ /26 أَبِي الْجَوْزَاءِ /26 ، أَنَّهُ \" كَانَ /20 يُصَفِّرُ لِحْيَتَهُ , وَأَنَّ /26 أَبَا نَضْرَةَ /26 كَانَ يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24466  /8",
      "sanad_ar": "$24449  1 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنِ /26 ابْنِ أَبِي ذِئْبٍ /26 ، عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ سَعْدٍ /26 ، قَالَ : /27 رَأَيْتُ /93 عُثْمَانَ بْنَ عَفَّانَ L5543 /93 \" وَهُوَ /20 يَبْنِي الزَّوْرَاءَ عَلَى بَغْلَةٍ شَهْبَاءَ ، مُصَفِّرًا لِحْيَتَهُ \" /27 * \r\n$24450  2 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ الْعَيْزَارِ /26 ، عَنْ /26 سَعِيدٍ الْمَدَنِيِّ /26 ، قَالَ : /27 كُنْتُ مَعَ /93 أَبِي هُرَيْرَةَ L4396 /93 فِي جِنَازَةٍ ، \" وَكَانَ /20 مُصَفِّرًا اللِّحْيَةَ \" /27 * \r\n$24451  3 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 هِلالٍ /26 ، قَالَ : حَدَّثَنِي /26 سَوَادَةُ بْنُ حَنْظَلَةَ /26 قَالَ : /27 \" رَأَيْتُ /93 عَلِيًّا /93 /20 أَصْفَرَ اللِّحْيَةِ \" /27 * \r\n$24452  4 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 أَبُو مُعَاوِيَةَ /94 ، عَنِ /26 الأَعْمَشِ /26 ، قَالَ : /27 \" رَأَيْتُ /26 زَيْدَ بْنَ وَهْبٍ /26 /20 يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24453  5 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ قَالَ : حَدَّثَنَا /94 غُنْدَرٌ مُحَمَّدُ بْنُ جَعْفَرٍ /94 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، عَنْ /26 عَطَاءٍ /26 ، قَالَ : /27 رَأَيْتُ /93 ابْنَ عَبَّاسٍ L4883 /93 ، /93 وَابْنَ عُمَرَ L4967 /93 /20 يُصَفِّرَانِ لِحَاهُمَا \" /27 * \r\n$24454  6 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الْعُمَرِيِّ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، أَنَّهُ \" كَانَ /20 يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24455  7 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 الْفَضْلُ بْنُ دُكَيْنٍ /94 ، عَنْ /26 حَمَّادٍ /26 ، عَنْ /26 أَبِي غَالِبٍ /26 ، قَالَ : /27 \" رَأَيْتُ /93 أَبَا أُمَامَةَ L3929 /93 /20 يُصَفِّرُ \" /27 * \r\n$24456  8 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 إِسْحَاقُ بْنُ سُلَيْمَانَ /94 ، عَنْ /26 جَرِيرٍ /26 ، قَالَ : /27 رَأَيْتُ /93 عَبْدَ اللَّهِ بْنَ بُسْرٍ L4742 /93 /20 يُصَفِّرُ لِحْيَتَهُ وَرَأْسَهُ \" /27 * \r\n\u0019E3552 \r\n$24457  9 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 أَبُو خَالِدٍ /94 ، عَنْ /26 يَزِيدَ /26 مَوْلَى سَلَمَةَ ، قَالَ \" /27 \" رَأَيْتُ /26 سَلَمَةَ /26 /20 يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24458  10 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 مُحَمَّدُ بْنُ بِشْرٍ /94 ، عَنْ /26 إِسْمَاعِيلَ /26 ، قَالَ : \" /27 رَأَيْتُ /26 قَيْسًا /26 /20 يُصَفِّرُ لِحْيَتَهُ , وَرَأَيْتُ /26 شِبْلَ بْنَ عَوْفٍ /26 يُصَفِّرُ لِحْيَتَهُ /27 , وَكَانَ مِنْ أَهْلِ الطَّيَالِسَةِ \" * \r\n$24459  11 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 خَالِدِ بْنِ دِينَارٍ /26 ، قَالَ : /27 رَأَيْتُ /93 أَنَسًا L720 /93 ، وَأَبَا الْعَالِيَةِ ، وَأَبَا السِّوَارِ /20 يُصَفِّرُونَ لِحَاهُمْ \" /27 * \r\n@ 6 : 55 @ \r\n$24460  12 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 فِطْرٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 أَبَا وَائِلَ /26 ، /26 وَالْقَاسِمَ /26 ، /26 وَعَطَاءً /26 /20 يُصَفِّرُونَ لِحَاهُمْ \" /27 * \r\n$24461  13 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 هَارُونُ /94 ، عَنْ /26 دَاوُدَ أَبِي الْيَمَانِ /26 ، قَالَ : /27 \" رَأَيْتُ /93 عَبْدَ اللَّهِ بْنَ أَبِي أَوْفَى L4622 /93 /20 يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24462  14 /2 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 أَبُو أُسَامَةَ L2484 /94 ، عَنْ /26 عُبَيْدِ اللَّهِ L5421 /26 ، عَنْ /26 سَعِيدِ بْنِ أَبِي سَعِيدٍ L3280 /26 ، أَنَّ /26 ابْنَ جُرَيْجٍ L5327 /26 ، سَأَلَ ابْنَ عُمَرَ, قَالَ : /27 رَأَيْتُكَ /20 تُصَفِّرُ لِحْيَتَكَ بِالْوَرْسِ , فَقَالَ /93 ابْنُ عُمَرَ L4967 /93 أَمَّا تَصْفِيرِي لِحْيَتِي فَإِنِّي رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24463  15 /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 الْمُحَارِبِيُّ /94 ، عَنْ /26 عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ /26 ، قَالَ : /27 \" رَأَيْتُ /93 الْمُغِيرَةَ بْنَ شُعْبَةَ L1665 /93 /20 يُخَضِّبُ بِالصُّفْرَةِ , وَرَأَيْتُ /93 جَرِيرَ بْنَ عَبْدِ اللَّهِ L2123 /93 يُخَضِّبُ بِالصُّفْرَةِ وَالزَّعْفَرَانِ \" /27 * \r\n\u0012E3553 \r\n$24464  16 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 الْمُحَارِبِيُّ /94 ، عَنِ /26 الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الأَسْوَدَ /26 ، /26 وَابْنَ الأَسْوَدِ /26 /20 يُصَفِّرَانِ لِحَاهُمَا \" /27 * \r\n$24465  17 /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 عَبْدُ الأَعْلَى /94 ، عَنِ /26 الْمُسْتَمِرِّ بْنِ الرَّيَّانِ /26 ، /27 عَنْ /26 أَبِي الْجَوْزَاءِ /26 ، أَنَّهُ \" كَانَ /20 يُصَفِّرُ لِحْيَتَهُ , وَأَنَّ /26 أَبَا نَضْرَةَ /26 كَانَ يُصَفِّرُ لِحْيَتَهُ \" /27 * \r\n$24466  /8",
