    {
      "hadith_id": 121595,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 21221,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 مُعَاذُ بْنُ مُعَاذٍ /94 ، قَالَ : حَدَّثَنَا /26 حُسَيْنٌ الْمُعَلِّمُ /26 ، عَنْ /26 قَيْسِ بْنِ سَعْدٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : /27 قُلْتُ /26 لِعَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى /26 : حَدِّثْنَا حَدِيثًا تَجْمَعُ لِي فِيهِ أَبْوَابَ الرِّبَا ، قَالَ : /20 \" لَا تَأْكُلْ شِفَّ شَيْءٍ لَيْسَ عَلَيْهِ ضَمَانَةٌ \" /27 * \r\n$21443  /2",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 مُعَاذُ بْنُ مُعَاذٍ /94 ، قَالَ : حَدَّثَنَا /26 حُسَيْنٌ الْمُعَلِّمُ /26 ، عَنْ /26 قَيْسِ بْنِ سَعْدٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : /27 قُلْتُ /26 لِعَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى /26 : حَدِّثْنَا حَدِيثًا تَجْمَعُ لِي فِيهِ أَبْوَابَ الرِّبَا ، قَالَ : /20 \" لَا تَأْكُلْ شِفَّ شَيْءٍ لَيْسَ عَلَيْهِ ضَمَانَةٌ \" /27 * \r\n$21443  /2",
