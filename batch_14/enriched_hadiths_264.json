    {
      "hadith_id": 120947,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 20573,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 أَبُو خَالِدٍ الْأَحْمَرُ /94 ، /94 وَابْنُ أَبِي زَائِدَةَ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 حَمَّادٍ /26 ، /27 عَنْ /26 إبْرَاهِيمَ /26 ، قَالَ : /20 إذَا اسْتَوَتِ الْبَيِّنَتَانِ فَهِيَ لِلَّذِي فِي أَيْدِيهِمْ \" /27 * \r\n$20840  /8",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 أَبُو خَالِدٍ الْأَحْمَرُ /94 ، /94 وَابْنُ أَبِي زَائِدَةَ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 حَمَّادٍ /26 ، /27 عَنْ /26 إبْرَاهِيمَ /26 ، قَالَ : /20 إذَا اسْتَوَتِ الْبَيِّنَتَانِ فَهِيَ لِلَّذِي فِي أَيْدِيهِمْ \" /27 * \r\n$20840  /8",
      "grade": null,
