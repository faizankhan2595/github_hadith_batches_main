    {
      "hadith_id": 370113,
      "book_id": 338,
      "chapter_id": null,
      "hadith_number": 37440,
      "text_ar": "كَمَا حَدَّثَنَا /94 بِشْرٌ /94 ، قَالَ : ثنا /26 يَزِيدُ /26 ، قَالَ ثنا /26 سَعِيدٌ /26 ، /27 عَنْ /26 قَتَادَةَ /26 ، قَوْلَهُ : /20 \" /4 مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ خَيْرٌ مِنْهَا سورة القصص آية 84 /4 , أَيْ : لَهُ مِنْهَا حَظُّ خَيْرٍ ، وَالْحَسَنَةُ : الإخْلاصُ ، وَالسَّيِّئَةُ : الشِّرْكُ \" /27 * \r\nوَقَدْ بَيَّنَّا ذَلِكَ بِاخْتِلافِ الْمُخْتَلِفِينَ ، وَدَلَّلْنَا عَلَى الصَّوَابِ مِنَ الْقَوْلِ فِيهِ . وقوله : /4 فَلا يُجْزَى الَّذِينَ عَمِلُوا السَّيِّئَاتِ سورة القصص آية 84 /4 , يقول : فلا يثاب الذين عملوا السيئات على أعمالهم السيئة , /4 إِلا مَا كَانُوا يَعْمَلُونَ سورة القصص آية 84 /4 , يقول : إلا جزاء ما كانوا يعلمون .",
      "sanad_ar": "كَمَا حَدَّثَنَا /94 بِشْرٌ /94",
      "matn_ar": "قَالَ : ثنا /26 يَزِيدُ /26 ، قَالَ ثنا /26 سَعِيدٌ /26 ، /27 عَنْ /26 قَتَادَةَ /26 ، قَوْلَهُ : /20 \" /4 مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ خَيْرٌ مِنْهَا سورة القصص آية 84 /4 , أَيْ : لَهُ مِنْهَا حَظُّ خَيْرٍ ، وَالْحَسَنَةُ : الإخْلاصُ ، وَالسَّيِّئَةُ : الشِّرْكُ \" /27 * \r\nوَقَدْ بَيَّنَّا ذَلِكَ بِاخْتِلافِ الْمُخْتَلِفِينَ ، وَدَلَّلْنَا عَلَى الصَّوَابِ مِنَ الْقَوْلِ فِيهِ . وقوله : /4 فَلا يُجْزَى الَّذِينَ عَمِلُوا السَّيِّئَاتِ سورة القصص آية 84 /4 , يقول : فلا يثاب الذين عملوا السيئات على أعمالهم السيئة , /4 إِلا مَا كَانُوا يَعْمَلُونَ سورة القصص آية 84 /4 , يقول : إلا جزاء ما كانوا يعلمون .",
