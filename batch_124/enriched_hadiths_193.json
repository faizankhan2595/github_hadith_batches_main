    {
      "hadith_id": 1109885,
      "book_id": 4217,
      "chapter_id": null,
      "hadith_number": 42,
      "text_ar": "أخبرنا /94 محمد بن نافع الخزاعي /94 ، /94 والحسن بن أبي الحسن العسكري /94 ، قالا : حدثنا /26 محمد بن أحمد بن حماد /26 ، قال : حدثنا /26 إسحاق بن إبراهيم الرملي /26 ، قال : حدثنا /26 هشام بن محمد بن هاشم بن جزء بن عبد الرحمن بن جزء بن الحدرجان بن مالك /26 ، قال : حدثني /26 أبي /26 ، عن /26 أبيه /26 ، عن /26 جده /26 ، قال : /27 حدثني أبي /93 جزء بن الحدرجان /93 ، قال : /20 قدمت أنا وأخي الأسود على رسول الله صلى الله عليه وسلم ، فآمنا به وصدقناه /27 ، وكان جزء والأسود قد خدما النبي صلى الله عليه وسلم وصحباه . هذا حديث غريب ، لا يعرف إلا بهذا الإسناد ، تفرد به إسحاق الرملي * \r\n.\"E6",
      "sanad_ar": "أخبرنا /94 محمد بن نافع الخزاعي /94",
      "matn_ar": "/94 والحسن بن أبي الحسن العسكري /94 ، قالا : حدثنا /26 محمد بن أحمد بن حماد /26 ، قال : حدثنا /26 إسحاق بن إبراهيم الرملي /26 ، قال : حدثنا /26 هشام بن محمد بن هاشم بن جزء بن عبد الرحمن بن جزء بن الحدرجان بن مالك /26 ، قال : حدثني /26 أبي /26 ، عن /26 أبيه /26 ، عن /26 جده /26 ، قال : /27 حدثني أبي /93 جزء بن الحدرجان /93 ، قال : /20 قدمت أنا وأخي الأسود على رسول الله صلى الله عليه وسلم ، فآمنا به وصدقناه /27 ، وكان جزء والأسود قد خدما النبي صلى الله عليه وسلم وصحباه . هذا حديث غريب ، لا يعرف إلا بهذا الإسناد ، تفرد به إسحاق الرملي * \r\n.\"E6",
      "grade": null,
