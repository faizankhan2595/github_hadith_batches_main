    {
      "hadith_id": 934880,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 1825,
      "text_ar": "أخبرنا بِهِ غير واحد ، منهم :  /94  مسمار بن عمر بن العويس L62839  /94  ،  /94  وَمُحَمَّد بن سرايا بن عَليّ الفقيه L63440  /94  ، قالوا بإسنادهم ، عن  /26  مُحَمَّد بن إِسْمَاعِيل L6817  /26  ، قَالَ : حدثنا  /26  عبد الله بن مُحَمَّد الجعفي L5060  /26  ، أخبرنا  /26  أبو أحمد L7100  /26  ، أخبرنا  /26  عبد الرحمن بن الغسيل L4386  /26  ، عن  /26  حَمْزَة بن أبي أسيد L2507  /26  ، /27 عن  /93  أبي أسيد L6674  /93  ، قَالَ : قَالَ لنا رسول الله صلى الله عَلَيْهِ وسلم يوم بدر : /20 \" إذا كثبوكم فارموهم \" /27 . فهذا فِي الصحيح ، وَأَبُو أنس يتصحف من أبي أسيد . أخرجه ابن منده ، وأبو نعيم .  * \r\n@ 13938",
      "sanad_ar": "أخبرنا بِهِ غير واحد",
      "matn_ar": "منهم :  /94  مسمار بن عمر بن العويس L62839  /94  ،  /94  وَمُحَمَّد بن سرايا بن عَليّ الفقيه L63440  /94  ، قالوا بإسنادهم ، عن  /26  مُحَمَّد بن إِسْمَاعِيل L6817  /26  ، قَالَ : حدثنا  /26  عبد الله بن مُحَمَّد الجعفي L5060  /26  ، أخبرنا  /26  أبو أحمد L7100  /26  ، أخبرنا  /26  عبد الرحمن بن الغسيل L4386  /26  ، عن  /26  حَمْزَة بن أبي أسيد L2507  /26  ، /27 عن  /93  أبي أسيد L6674  /93  ، قَالَ : قَالَ لنا رسول الله صلى الله عَلَيْهِ وسلم يوم بدر : /20 \" إذا كثبوكم فارموهم \" /27 . فهذا فِي الصحيح ، وَأَبُو أنس يتصحف من أبي أسيد . أخرجه ابن منده ، وأبو نعيم .  * \r\n@ 13938",
