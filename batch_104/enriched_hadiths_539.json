    {
      "hadith_id": 935080,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 2025,
      "text_ar": "والد كريم أورده الْحَسَن بن سفيان ، وابن أبي شيبة فِي الصحابة . \r\n$1791  17164 2885 /2 /141 أخبرنا  /94  أبو موسى L53979  /94  ، إذنا ، أخبرنا  /26  الْحَسَن بن أحمد L14761  /26  ، حدثنا  /26  أحمد بن عبد الله L9927  /26  ، أخبرنا  /26  مُحَمَّد بن أحمد بن الْحَسَن L28131  /26  ، أخبرنا  /26  مُحَمَّد بن عثمان بن أبي شيبة L29987  /26  ، أخبرنا  /26  جنادة بن مغلس L2083  /26  ، أخبرنا  /26  قيس بن الربيع L6514  /26  ، عن  /26  أبان بن عبد الله البجلي L16  /26  ، /27 عن  /26  كريم بن أبي حازم L6590  /26  ، عن  /93  أبيه L3910  /93  ، قَالَ : \" /20 اختصم رجلان إلى النَّبِيّ صلى الله عَلَيْهِ وسلم فِي ولد ، فقضى بِهِ لأحدهما \" /27 . أخرجه أبو نعيم ، وَأَبُو موسى  * \r\n@ 14017",
      "sanad_ar": "والد كريم أورده الْحَسَن بن سفيان",
      "matn_ar": "وابن أبي شيبة فِي الصحابة . \r\n$1791  17164 2885 /2 /141 أخبرنا  /94  أبو موسى L53979  /94  ، إذنا ، أخبرنا  /26  الْحَسَن بن أحمد L14761  /26  ، حدثنا  /26  أحمد بن عبد الله L9927  /26  ، أخبرنا  /26  مُحَمَّد بن أحمد بن الْحَسَن L28131  /26  ، أخبرنا  /26  مُحَمَّد بن عثمان بن أبي شيبة L29987  /26  ، أخبرنا  /26  جنادة بن مغلس L2083  /26  ، أخبرنا  /26  قيس بن الربيع L6514  /26  ، عن  /26  أبان بن عبد الله البجلي L16  /26  ، /27 عن  /26  كريم بن أبي حازم L6590  /26  ، عن  /93  أبيه L3910  /93  ، قَالَ : \" /20 اختصم رجلان إلى النَّبِيّ صلى الله عَلَيْهِ وسلم فِي ولد ، فقضى بِهِ لأحدهما \" /27 . أخرجه أبو نعيم ، وَأَبُو موسى  * \r\n@ 14017",
