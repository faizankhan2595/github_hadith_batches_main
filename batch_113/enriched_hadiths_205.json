      "chapter_id": null,
      "hadith_number": 20518,
      "text_ar": "واسمه : أَحْمَد بْن حصن بْن عَبْد الرَّحْمَنِ الفزاري , مولاهم , أَبُو مسلم الدمشقي . /10 ثور بْن يَزِيدَ /10 /10 وجرير بْن حازم /10 /10 وجعفر بْن برقان /10 /10 وسعيد بْن عبد العزيز س /10 /10 وعاصم بْن عُمَرَ /10 /10 وعَبْد اللَّهِ بْن شوذب /10 /10 وعَبْد اللَّهِ بْن لهيعة /10 /10 وعَبْد الرَّحْمَنِ بْن عَمْرو الأوزاعي /10 /10 ومالك بْن أنس كن /10 /10 وأبي الزبير مُحَمَّد بْن مسلم المكي /10 /10 وموسى بْن أبي عائشة /10",
      "sanad_ar": "واسمه",
      "matn_ar": "أَحْمَد بْن حصن بْن عَبْد الرَّحْمَنِ الفزاري , مولاهم , أَبُو مسلم الدمشقي . /10 ثور بْن يَزِيدَ /10 /10 وجرير بْن حازم /10 /10 وجعفر بْن برقان /10 /10 وسعيد بْن عبد العزيز س /10 /10 وعاصم بْن عُمَرَ /10 /10 وعَبْد اللَّهِ بْن شوذب /10 /10 وعَبْد اللَّهِ بْن لهيعة /10 /10 وعَبْد الرَّحْمَنِ بْن عَمْرو الأوزاعي /10 /10 ومالك بْن أنس كن /10 /10 وأبي الزبير مُحَمَّد بْن مسلم المكي /10 /10 وموسى بْن أبي عائشة /10",
