    {
      "hadith_id": 1008455,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 17901,
      "text_ar": "0 /11 إِسْمَاعِيل بْن أبان الغنوي /11 /11 وإسماعيل بْن أَبِي خَالِد وهو من أقرانه /11 /11 وابنه أَبُو سَلَمَة جَرِير بْن السَّرِيّ بْن إِسْمَاعِيل /11 /11 وجرير بْن عبد الحميد /11 /11 وجعفر بْن زِيَاد الأحمر /11 /11 وحاتم بْن إِسْمَاعِيل الْمَدَنِيّ /11 /11 وخالد بْن كثير الْهَمْدَانِيّ ق /11 /11 وداود بْن عِيسَى /11 /11 وسعد بْن الصلت البجلي قاضي شيراز /11 /11 وعبد العزيز بْن أبان الْقُرَشِيّ /11 /11 وعبيد الله بْن مُوسَى /11 /11 وعمر بْن صَالِح الزُّهْرِيّ /11 /11 وعمر بْن علي المقدمي /11 /11 والفضل بْن موفق /11 /11 وفيض بْن الْفَضْل /11 /11 ومالك بْن سعير بْن الخمس /11 /11 ومحمد بْن خَالِد الضَّبِّيّ /11 /11 ومحمد بْن فضيل /11 /11 ومحمد بْن كثير الْكُوفِيّ /11 /11 ومحمد بْن مُسْلِم قيل : هُوَ أَبُو الزُّبَيْر وقيل : الزُّهْرِيّ /11 /11 ومكي بْن إِبْرَاهِيم /11 /11 ومندل بْن علي /11 /11 ونصر بْن إِسْحَاق الْهَمْدَانِيّ /11 /11 ونعيم بْن عبد الحميد الواسطي /11 /11 والهياج بْن بسطام /11 /11 ويزيد بْن هَارُون /11 /11 ويونس بْن بكير /11 /11 وأَبُو إِسْرَائِيل الملائي /11 ++ قال",
      "sanad_ar": "0 /11 إِسْمَاعِيل بْن أبان الغنوي /11 /11 وإسماعيل بْن أَبِي خَالِد وهو من أقرانه /11 /11 وابنه أَبُو سَلَمَة جَرِير بْن السَّرِيّ بْن إِسْمَاعِيل /11 /11 وجرير بْن عبد الحميد /11 /11 وجعفر بْن زِيَاد الأحمر /11 /11 وحاتم بْن إِسْمَاعِيل الْمَدَنِيّ /11 /11 وخالد بْن كثير الْهَمْدَانِيّ ق /11 /11 وداود بْن عِيسَى /11 /11 وسعد بْن الصلت البجلي قاضي شيراز /11 /11 وعبد العزيز بْن أبان الْقُرَشِيّ /11 /11 وعبيد الله بْن مُوسَى /11 /11 وعمر بْن صَالِح الزُّهْرِيّ /11 /11 وعمر بْن علي المقدمي /11 /11 والفضل بْن موفق /11 /11 وفيض بْن الْفَضْل /11 /11 ومالك بْن سعير بْن الخمس /11 /11 ومحمد بْن خَالِد الضَّبِّيّ /11 /11 ومحمد بْن فضيل /11 /11 ومحمد بْن كثير الْكُوفِيّ /11 /11 ومحمد بْن مُسْلِم قيل",
      "matn_ar": "هُوَ أَبُو الزُّبَيْر وقيل : الزُّهْرِيّ /11 /11 ومكي بْن إِبْرَاهِيم /11 /11 ومندل بْن علي /11 /11 ونصر بْن إِسْحَاق الْهَمْدَانِيّ /11 /11 ونعيم بْن عبد الحميد الواسطي /11 /11 والهياج بْن بسطام /11 /11 ويزيد بْن هَارُون /11 /11 ويونس بْن بكير /11 /11 وأَبُو إِسْرَائِيل الملائي /11 ++ قال",
