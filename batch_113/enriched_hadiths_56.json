    {
      "hadith_id": 1008838,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 18284,
      "text_ar": "0 /11 أَبُو مُسْلِم إِبْرَاهِيم بْن عَبْد اللَّهِ الكشي /11 /11 وإبراهيم بْن عَبْد الرَّحِيمِ بْن دنوقا /11 /11 وأَبُو جَعْفَر أَحْمَد بْن مُحَمَّد بْن أَبِي مُحَمَّد يَحْيَى بْن الْمُبَارَك اليزيدي /11 /11 وأَبُو اليمان حذيفة بْن غياث بْن حسان بْن دِينَار البصري العسكري /11 /11 والحسين بْن السكن البصري نزيل بغداد /11 /11 وخلف بْن هِشَام البزار وقرأ عليه القرآن /11 /11 وسفيان بْن زِيَاد بْن آدم العقيلي /11 /11 وأَبُو حاتم سهل بْن مُحَمَّد السجستاني النحوي /11 /11 وأَبُو عُمَر صَالِح بْن إِسْحَاق الجرمي النحوي /11 /11 والضحاك بْن ميمون الْعَطَّار /11 /11 وظفر بْن السميدع /11 /11 والعباس بْن الْفَرَج الرياشي النحوي /11 /11 وعبد الله بْن الْحَكَمِ بْن أَبِي زِيَاد القطواني ت /11 /11 وعبد الله بْن مُحَمَّد بْن أَبِي قريش الثَّقَفِيّ /11 /11 وأَبُو خَالِد عَبْد الْعَزِيزِ بْن معاوية العتبي /11 /11 وعمر بْن شبة النميري /11 /11 وأَبُو عُبَيْد الْقَاسِم بْن سَلام د /11 /11 وقعنب بْن المحرر /11 /11 وأَبُو حاتم مُحَمَّد بْن إِدْرِيس الرازي /11 /11 ومحمد بْن خزيمة البصري نزيل مصر /11 /11 ومحمد بْن سَعْد كاتب الواقدي /11 /11 وأَبُو العيناء مُحَمَّد بْن الْقَاسِم   بْن خلاد /11 /11 ومحمد بْن معاوية بْن عَبْد الرَّحْمَنِ الزيادي البصري /11 /11 ومحمد بْن يَحْيَى بْن المنذر القزاز /11 /11 ومحمد بْن يونسس الكديمي /11 /11 وهارون بْن سُفْيَان المستملي المعروف بالديك /11 /11 ويحيى بْن مُحَمَّد بْن أعين الْمَرْوَزِيّ /11 /11 ويعقوب بْن سُفْيَان الفارسي /11 /11 وأَبُو عُثْمَان المازني النحوي واسمه بَكْر بْن مُحَمَّد بْن بقية /11 ++ قال",
      "sanad_ar": "",
      "matn_ar": "",
