    {
      "hadith_id": 1013317,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 22763,
      "text_ar": "صاحب عَبْد اللَّهِ بْن كثير /10 الحسن بْن مسلم بْن يناق /10 /10 وحميد بْن قيس الأعرج /10 /10 وزيد بْن أسلم /10 /10 وسالم أبي النضر /10 /10 وسَعِيد المقبري /10 /10 وسهيل بْن أبي صالح /10 /10 وأَبِي قزعة سويد بْن حجير س /10 /10 وأَبِي الطفيل عامر بْن واثلة الليثي /10 /10 وعباس بْن سهل بْن سعد الساعدي /10 /10 وأَبِي الزناد عَبْد اللَّهِ بْن ذكوان /10 /10 وعَبْد اللَّهِ بْن كثير القارئ قد /10 /10 وعَبْد اللَّهِ بْن أبي نجيح خ د فق /10 /10 وعبيد اللَّه بْن أبي يزيد /10 /10 وعروة بْن عَبْد الرحمن المدني /10 /10 وعُمَر بْن أبي سُلَيْمَان فق /10 /10 وعُمَر بْن عَبْد الرحمن بْن محيصن /10 /10 وعَمْرو بْن دينار /10 /10 والعلاء بْن عَبْد الرحمن بْن يعقوب /10 /10 والقاسم بْن أبي بزة /10 /10 وقيس بْن الربيع الأسدي وهو من أقرانه /10 /10 وقيس بْن سعد المكي /10 /10 وأَبِي الزبير مُحَمَّد بْن مسلم المكي /10 /10 ومحمد بْن المنكدر /10 /10 وهشام بْن حجير /10 /10 وهشام بْن عروة /10 /10 وأَبِي خلف شيخ يروي عَنْ جابر /10",
