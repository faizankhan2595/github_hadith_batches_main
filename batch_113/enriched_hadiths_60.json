      "hadith_id": 1008890,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 18336,
      "text_ar": "واسمه مقلاص الْخُزَاعِيّ مولاهم أَبُو يَحْيَى المصري /10 بَكْر بْن عَمْرو المعافري بخ د س /10 /10 وجعفر بْن ربيعة خ د س /10 /10 والحارث بْن يَزِيد ق /10 /10 والحسن بْن ثوبان سي /10 /10 وأَبِي صخر حُمَيْد بْن زِيَاد الْمَدَنِيّ د عس /10 /10 وأَبِي هانئ حُمَيْد بْن هانئ الْخَوْلانِيّ مق ق /10 /10 وخالد بْن يَزِيد الصدفي /10 /10 وخالد بْن يَزِيد الإسكندراني مد /10 /10 وخير بْن نُعَيْم الْحَضْرَمِيّ /10 /10 وربيعة بْن سيف س /10 /10 ورزيق بْن حكيم /10 /10 وزبان بْن فائد د /10 /10 وأَبِي عُقَيْل زهرة بْن معبد خ د س /10 /10 وزيد بْن أَبِي عَتَّاب ق /10 /10 وسليمان بْن كيسان مد /10 /10 وشراحيل بْن يَزِيد د /10 /10 وشرحبيل بْن شُرَيْك م ت س /10 /10 وشرحبيل بْن يَزِيد إن كَانَ محفوظا د /10 /10 وأَبِي عبد السلام صَالِح بْن رستم /10 /10 وصفوان بْن سليم /10 /10 والضحاك بْن شرحبيل /10 /10 وعبد الله بْن الْوَلِيد التجيبي د سي /10 /10 وعبد الرحمن بْن مرزوق الشامي س /10 /10 وأَبِي مرحوم عَبْد الرَّحِيمِ بْن ميمون د ت سي ق /10 /10 وعبيد الله بْن أَبِي جَعْفَر م د س /10 /10 وعطاء بْن دِينَار بخ د /10 /10 وعقيل بْن خَالِد خ /10 /10 وعمر بْن عَبْد اللَّهِ العنسي /10 /10 وعمرو بْن جَابِر الْحَضْرَمِيّ ت /10 /10 وعياش بْن عَبَّاس م د س /10 /10 وكعب بْن عَلْقَمَة م د /10 /10 وكليب بْن ذهل /10 /10 وأَبِي الأسود مُحَمَّد بْن عَبْد الرَّحْمَنِ بْن نوفل خ م س /10 /10 ومحمد بْن عَبْد الرَّحْمَنِ المكي د /10 /10 ومحمد بْن عجلان سي /10 /10 وأَبِي مطيع معاوية بْن يَحْيَى /10 /10 ومعروف بْن سويد /10 /10 والوليد بْن أَبِي الْوَلِيد م /10 /10 ويحيى بْن   أَبِي سُلَيْمَان بخ ت س /10 /10 ويزيد بْن أَبِي حَبِيب خ م د س /10 /10 ويزيد بْن عَبْد الْعَزِيزِ الرعيني سي /10 /10 وأَبِي سُفْيَان بْن جَابِر بْن عتيك /10 /10 وأَبِي عَبْد اللَّهِ الْقُرَشِيّ د جليس لجعفر بْن ربيعة /10",
