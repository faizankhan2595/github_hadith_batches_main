    {
      "hadith_id": 1009513,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 18959,
      "text_ar": "0 /11 الْبُخَارِيّ /11 /11 وأَبُو شَيْبَة إِبْرَاهِيم بْن أَبِي بَكْر بْن أَبِي شَيْبَة /11 /11 وأَحْمَد بْن إِبْرَاهِيم بْن كثير الدورقي /11 /11 وأَحْمَد بْن إِسْحَاق /11 /11 وأَحْمَد بْن زِيَاد الْبَزَّاز /11 /11 وإسحاق بْن الضيف /11 /11 والحارث بْن مُحَمَّد بْن أَبِي أُسَامَة /11 /11 والحسن بْن عتبة بْن عَبْد الرَّحْمَنِ الْكُنْدِيّ /11 /11 وعباس بْن مُحَمَّد الدوري /11 /11 وأَبُو بَكْر عَبْد اللَّهِ بْن مُحَمَّد بْن أَبِي شَيْبَة ق /11 /11 والقاسم بْن زكريا بْن دِينَار الْكُوفِيّ س /11 /11 ومحمد بْن خلف التيمي /11 /11 ومحمد بْن عُبَيْد بْن عتبة الْكُنْدِيّ /11 /11 وأَبُو كريب مُحَمَّد بْن العلاء ق /11 /11 ومعاوية بْن صَالِح الأشعري الدِّمَشْقِيّ /11 /11 ويحيى بْن زكريا بْن شَيْبَان /11 ++ قال",
