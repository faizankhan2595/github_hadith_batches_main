    {
      "hadith_id": 1009512,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 18958,
      "text_ar": "من ولد عفيف الْكُنْدِيّ /10 بِشْر بْن عمارة الْخَثْعَمِيّ /10 /10 وحماد بْن ميمون الْكُنْدِيّ /10 /10 وخلاد بْن سُلَيْمَان الْحَضْرَمِيّ /10 /10 وسعيد بْن عطارد العابد /10 /10 والصباح بْن سهل البصري /10 /10 وعبد الله بْن لَهِيعَة ق /10 /10 وعمرو بْن أَبِي المقدام ثَابِت بْن هرمز /10 /10 والقاسم بْن عَبْد اللَّهِ بْن عُمَر العمري /10 /10 والليث بْن سَعْد خ س ق /10 /10 ويحيى بْن العلاء البجلي الرازي /10",
