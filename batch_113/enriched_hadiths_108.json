      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 19063,
      "text_ar": "0 /11 الترمذي /11 /11 والنسائي /11 /11 وأَحْمَد بْن زكريا العابدي المكي /11 /11 وأَحْمَد بْن أَبِي عوف البزوري /11 /11 وأَحْمَد بْن مُحَمَّد بْن إِسْحَاق المكي /11 /11 وأَحْمَد بْن مُحَمَّد بْن العجنس العجنسي النسفي /11 /11 وأَبُو حاتم روح بْن الْفَرَج البغدادي /11 /11 وزكريا بْن يَحْيَى الساجي /11 /11 وعبد الرحمن بْن الْعَبَّاس الْبَزَّاز /11 /11 وعثمان بْن خرزاذ /11 /11 والقاسم بْن عَبْد اللَّهِ بْن مهدي الإخميمي /11 /11 ومحمد بْن إِبْرَاهِيم بْن عَبْد اللَّهِ بْن الْفَضْل الدبيلي المكي /11 /11 وأَبُو بَكْر مُحَمَّد بْن إِسْحَاق بْن خزيمة /11 /11 ومحمد بْن عِمْرَان بْن خزيمة /11 /11 ومحمد بْن يُوسُف بْن مَعْدَان الْبَنَّاء الأصبهاني /11 /11 وأَبُو حَامِد مَحْمُود بْن علي بْن مَالِك بْن الأخطل الشيباني الْبَزَّاز الأصبهاني /11 /11 والمفضل بْن مُحَمَّد الجندي /11 /11 ويحيى بْن الْحَسَن بْن جَعْفَر العلوي النسابة /11 /11 ويحيى بْن مُحَمَّد بْن صَاعِد /11 # قال",
