    {
      "hadith_id": 1009616,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 19062,
      "text_ar": "ويقال : سَعِيد بْن عَبْد الرَّحْمَنِ بْن أَبِي سَعِيد الْقُرَشِيّ ، أَبُو عُبَيْد الله المخزومي المكي /10 إِبْرَاهِيم بْن عُيَيْنَة /10 /10 وحسين بْن زَيْد بْن علي بْن الْحُسَيْن بْن علي /10 /10 وسفيان بْن عُيَيْنَة ت س /10 /10 وعبد الله بْن الْوَلِيد العدني ت /10 /10 وهشام بْن سُلَيْمَان بْن عكرمة بْن خَالِد المخزومي /10",
      "sanad_ar": "ويقال",
      "matn_ar": "سَعِيد بْن عَبْد الرَّحْمَنِ بْن أَبِي سَعِيد الْقُرَشِيّ ، أَبُو عُبَيْد الله المخزومي المكي /10 إِبْرَاهِيم بْن عُيَيْنَة /10 /10 وحسين بْن زَيْد بْن علي بْن الْحُسَيْن بْن علي /10 /10 وسفيان بْن عُيَيْنَة ت س /10 /10 وعبد الله بْن الْوَلِيد العدني ت /10 /10 وهشام بْن سُلَيْمَان بْن عكرمة بْن خَالِد المخزومي /10",
      "grade": null,
