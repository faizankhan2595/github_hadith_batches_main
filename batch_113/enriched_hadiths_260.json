    {
      "hadith_id": 1011895,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 21341,
      "text_ar": "0 /11 أَبُو داود /11 /11 وإبراهيم بْن دحيم الدمشقي /11 /11 وأَحْمَد بْن عمير بْن يوسف بْن جوصى الحافظ /11 /11 وأَبُو طالب أَحْمَد بْن نصر بْن طالب الحافظ /11 /11 وأَحْمَد بْن هارون بْن روح البرديجي الحافظ /11 /11 وبَكْر بن أَحْمَدَ بْن حفص الشعراني /11 /11 وجعفر بْن مُحَمَّد بْن سوار النيسابوري /11 /11 والحسن بْن سُلَيْمَان الفزاري قبيطة /11 /11 وخيثمة بْن سُلَيْمَان الأطرابلسي /11 /11 وسُلَيْمَان بْن مُحَمَّد الخزاعي /11 /11 وأَبُو بكر عَبْد اللَّهِ بْن أبي داود /11 /11 وعَبْد الرحمن بْن أبي حاتم الرازي /11 /11 وعَبْد الصمد بْن سَعِيد القاضي الحمصي /11 /11 وأَبُو القاسم عَبْد القدوس بْن مُوسَى بْن عِيسَى بْن داود بْن صالح الأزدي الحمصي /11 /11 ومحمد بن أَحْمَدَ بْن يحيى بْن صفوان الأنطاكي إمام الجامع /11 /11 ومحمد بْن جرير الطبري ونسبه إلى سُلَيْمَان   /11 /11 وأَبُو بكر مُحَمَّد بْن عَبْد اللَّهِ بْن مُحَمَّد الطائي /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 /11 وأَبُو عوانة يعقوب بْن إسحاق الإسفراييني فِي صحيحه /11 # قال",
