    {
      "hadith_id": 1011894,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 21340,
      "text_ar": "ويقال : ابن سُلَيْمَان البهراني الحكمي , أَبُو أيوب الحمصي /10 أبي اليمان الحكم بْن نافع /10 /10 وحيوة بْن شريح /10 /10 وخطاب بْن عُثْمَانَ الفوزي /10 /10 والربيع بْن روح /10 /10 وسَعِيد بْن عَمْرو الحضرمي /10 /10 وعَبْد اللَّهِ بْن عَبْد الجبار الحمصي /10 /10 وأَبِي التقى عَبْد الحميد بْن إبراهيم الحضرمي /10 /10 وأَبِيه عَبْد الحميد البهراني /10 /10 وعَبْد السلام بْن مُحَمَّد الحضرمي /10 /10 وأَبِي صالح عَبْد الغفار بْن داود الحراني /10 /10 وعتبة بْن السكن الفزاري /10 /10 وعلي بْن عياش الحمصي /10 /10 ومحمد بْن إسماعيل بْن عياش د /10 /10 ومحمد بْن عائذ الدمشقي /10 /10 وأَبِي علقمة نصر بْن خزيمة بْن علقمة بْن محفوظ بْن علقمة الحضرمي /10 /10 وهشام بْن عمار /10 /10 ووساج بْن عقبة بْن وساج /10 /10 ويحيى بْن صالح الوحاظي د /10 /10 ويزيد بْن عَبْد ربه الجرجسي /10",
      "sanad_ar": "ويقال",
      "matn_ar": "ابن سُلَيْمَان البهراني الحكمي , أَبُو أيوب الحمصي /10 أبي اليمان الحكم بْن نافع /10 /10 وحيوة بْن شريح /10 /10 وخطاب بْن عُثْمَانَ الفوزي /10 /10 والربيع بْن روح /10 /10 وسَعِيد بْن عَمْرو الحضرمي /10 /10 وعَبْد اللَّهِ بْن عَبْد الجبار الحمصي /10 /10 وأَبِي التقى عَبْد الحميد بْن إبراهيم الحضرمي /10 /10 وأَبِيه عَبْد الحميد البهراني /10 /10 وعَبْد السلام بْن مُحَمَّد الحضرمي /10 /10 وأَبِي صالح عَبْد الغفار بْن داود الحراني /10 /10 وعتبة بْن السكن الفزاري /10 /10 وعلي بْن عياش الحمصي /10 /10 ومحمد بْن إسماعيل بْن عياش د /10 /10 ومحمد بْن عائذ الدمشقي /10 /10 وأَبِي علقمة نصر بْن خزيمة بْن علقمة بْن محفوظ بْن علقمة الحضرمي /10 /10 وهشام بْن عمار /10 /10 ووساج بْن عقبة بْن وساج /10 /10 ويحيى بْن صالح الوحاظي د /10 /10 ويزيد بْن عَبْد ربه الجرجسي /10",
