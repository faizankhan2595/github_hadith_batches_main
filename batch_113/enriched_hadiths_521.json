    {
      "hadith_id": 1015807,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 25253,
      "text_ar": "ثم الناشري أبو إسماعيل المصري ختن أبي قبيل المعافري /10 إسماعيل بن سفيان الرعيني /10 /10 وحسان بن عبد الله الأموي /10 /10 وأبي صخر حميد بن زياد المدني /10 /10 وأبي قبيل حيي بن هانئ المعافري /10 /10 وخير بن نعيم الحضرمي /10 /10 وربيعة بن سيف المعافري /10 /10 وسليمان بن حميد المزني /10 /10 وطلحة بن أبي سعيد الإسكندراني /10 /10 وأبي حمزة عبد الله بن سليمان الطويل /10 /10 وأبي معن عبد الواحد بن أبي موسى الإسكندراني /10 /10 وعبيد الله بن زحر الإفريقي /10 /10 وعقيل بن خالد الأيلي /10 /10 وعمرو بن جابر الحضرمي /10 /10 والعلاء بن كثير المصري /10 /10 وعياش بن عقبة الحضرمي /10 /10 وقيس بن الحجاج /10 /10 وموسى بن وردان بخ /10 /10 وواهب بن عبد الله المعافري /10 /10 ويزيد بن أبي حبيب /10",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
