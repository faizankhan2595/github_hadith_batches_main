    {
      "hadith_id": 1009639,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 19085,
      "text_ar": "وقال المفضل بْن غسان الغلابي : /27 حَدَّثَنِي /26 الزُّبَيْر يَعْنِي : ابْن بكار /26 قال : سأل أمير المؤمنين يَعْنِي : الرشيد عَبْد اللَّهِ بْن مصعب عَنْ سَعِيد بْن عَبْد الرَّحْمَنِ وهُوَ يومئذ قاضيه فَقَالَ : يَا أمير المؤمنين إني /20 أحسب سَعِيد بْن عَبْد الرَّحْمَنِ لو دخل المسجد الحرام فنظر إِلَى رجل وامرأة على فاحشة ما ظن بهما إلا خيرا لبعده من الآفات /27 . أخبرنا بذلك /94 يُوسُف بْن يَعْقُوب /94 ، قال : أخبرنا /26 زَيْد بْن الْحَسَن /26 ، قال : أخبرنا /26 عَبْد الرَّحْمَنِ بْن مُحَمَّد /26 ، قال : أخبرنا /26 أَحْمَد بْن علي الْحَافِظ /26 ، قال : أخبرنا /26 الْقَاضِي أَبُو العلاء الواسطي /26 ، قال : حدثنا /26 أَبُو بَكْر مُحَمَّد بْن أَحْمَد بْن مُوسَى البابسيري /26 ، قال : حدثنا /26 أَبُو أمية الأحوص بْن المفضل الغلابي /26 ، قال : حدثنا /26 أَبِي /26 فذكره . * \r\n++ قال",
      "sanad_ar": "وقال المفضل بْن غسان الغلابي",
      "matn_ar": "/27 حَدَّثَنِي /26 الزُّبَيْر يَعْنِي : ابْن بكار /26 قال : سأل أمير المؤمنين يَعْنِي : الرشيد عَبْد اللَّهِ بْن مصعب عَنْ سَعِيد بْن عَبْد الرَّحْمَنِ وهُوَ يومئذ قاضيه فَقَالَ : يَا أمير المؤمنين إني /20 أحسب سَعِيد بْن عَبْد الرَّحْمَنِ لو دخل المسجد الحرام فنظر إِلَى رجل وامرأة على فاحشة ما ظن بهما إلا خيرا لبعده من الآفات /27 . أخبرنا بذلك /94 يُوسُف بْن يَعْقُوب /94 ، قال : أخبرنا /26 زَيْد بْن الْحَسَن /26 ، قال : أخبرنا /26 عَبْد الرَّحْمَنِ بْن مُحَمَّد /26 ، قال : أخبرنا /26 أَحْمَد بْن علي الْحَافِظ /26 ، قال : أخبرنا /26 الْقَاضِي أَبُو العلاء الواسطي /26 ، قال : حدثنا /26 أَبُو بَكْر مُحَمَّد بْن أَحْمَد بْن مُوسَى البابسيري /26 ، قال : حدثنا /26 أَبُو أمية الأحوص بْن المفضل الغلابي /26 ، قال : حدثنا /26 أَبِي /26 فذكره . * \r\n++ قال",
