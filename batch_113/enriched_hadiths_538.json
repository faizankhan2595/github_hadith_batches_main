    {
      "hadith_id": 1016070,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 25516,
      "text_ar": "كان من بني سلان ، فباعه عمه من رجل من بلهجيم ، فلم يرجع إلى قومه . /10 جابر بن سمرة /10 /10 وجندب بن عبد الله خ /10 /10 ودلجة بن قيس /10 /10 وعبد الله بن عمر بن الخطاب د /10 /10 وعمرو البكالي /10 /10 وأبي جري الهجيمي د ت س /10 /10 وأبي عثمان النهدي خ ت س فق /10 /10 وأبي المليح بن أسامة الهذلي د سي /10 /10 وأبي موسى الأشعري س /10 /10 وأبي هريرة /10",
      "sanad_ar": "كان من بني سلان",
      "matn_ar": "فباعه عمه من رجل من بلهجيم ، فلم يرجع إلى قومه . /10 جابر بن سمرة /10 /10 وجندب بن عبد الله خ /10 /10 ودلجة بن قيس /10 /10 وعبد الله بن عمر بن الخطاب د /10 /10 وعمرو البكالي /10 /10 وأبي جري الهجيمي د ت س /10 /10 وأبي عثمان النهدي خ ت س فق /10 /10 وأبي المليح بن أسامة الهذلي د سي /10 /10 وأبي موسى الأشعري س /10 /10 وأبي هريرة /10",
