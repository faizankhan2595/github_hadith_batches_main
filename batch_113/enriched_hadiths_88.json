    {
      "hadith_id": 1009312,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 18758,
      "text_ar": "وهُوَ ابْن أَبِي حَفْص الثَّقَفِيّ الطائفي /10 دَاوُد بْن أَبِي عاصم الثَّقَفِيّ /10 /10 وأبيه السَّائِب بْن يسار الثَّقَفِيّ /10 /10 وسفيان الثوري وهُوَ من أقرانه /10 /10 وصالح بْن سَعِيد /10 /10 وعبد الله س ويقال : عُبَيْد الله بْن معية العامري /10 /10 وعبد الله بْن يامين الطائفي ق /10 /10 وعبد الملك بْن أَبِي عاصم بْن عُرْوَة الثَّقَفِيّ /10 /10 وعبيد الله بْن يَزِيد الطائفي س /10 /10 وغضيف س ويقال : غطيف بْن أَبِي سُفْيَان /10 /10 ومحمد بْن السَّائِب بْن أَبِي هندية /10 /10 ومحمد بْن عَبْد اللَّهِ بْن عياض د ق /10 /10 ونوح بْن صعصعة د /10",
      "sanad_ar": "وهُوَ ابْن أَبِي حَفْص الثَّقَفِيّ الطائفي /10 دَاوُد بْن أَبِي عاصم الثَّقَفِيّ /10 /10 وأبيه السَّائِب بْن يسار الثَّقَفِيّ /10 /10 وسفيان الثوري وهُوَ من أقرانه /10 /10 وصالح بْن سَعِيد /10 /10 وعبد الله س ويقال",
      "matn_ar": "عُبَيْد الله بْن معية العامري /10 /10 وعبد الله بْن يامين الطائفي ق /10 /10 وعبد الملك بْن أَبِي عاصم بْن عُرْوَة الثَّقَفِيّ /10 /10 وعبيد الله بْن يَزِيد الطائفي س /10 /10 وغضيف س ويقال : غطيف بْن أَبِي سُفْيَان /10 /10 ومحمد بْن السَّائِب بْن أَبِي هندية /10 /10 ومحمد بْن عَبْد اللَّهِ بْن عياض د ق /10 /10 ونوح بْن صعصعة د /10",
