      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 17479,
      "text_ar": "/10 حَمَّاد بْن مسعدة /10 /10 وخالد بْن الْحَارِث م /10 /10 وروح بْن عبادة /10 /10 وأَبِي قُتَيْبَة سلم بْن قُتَيْبَة /10 /10 وأَبِي دَاوُد سُلَيْمَان بْن دَاوُد الطَّيَالِسِيّ /10 /10 وأَبِي عاصم الضحاك بْن مخلد م /10 /10 وعبد الله بْن بَكْر السهمي /10 /10 وأَبِي مُحَمَّد عَبْد اللَّهِ بْن سنان الهروي نزيل البصرة /10 /10 وأَبِي بحر عَبْد الرَّحْمَنِ بْن عُثْمَان البكراوي /10 /10 وعبد الرحمن بْن مهدي /10 /10 وأَبِي بَكْر عبد الكبير عبد المجيد الحنفي /10 /10 وأَبِي عَامِر عَبْد الْمَلِكِ بْن عَمْرو الْعَقَدِيّ م /10 /10 وعبد الوهاب بْن عبد المجيد الثَّقَفِيّ /10 /10 وأَبِي علي عُبَيْد الله بْن عبد المجيد الحنفي /10 /10 وعمر بْن يُونُس اليمامي م /10 /10 ومحمد بْن جَعْفَر غندر /10 /10 ومحمد بْن سواء /10 /10 وأَبِي أَحْمَد مُحَمَّد بْن عَبْد اللَّهِ بْن الزُّبَيْر الزبيري /10 /10 ومعاذ بْن معاذ العنبري /10 /10 ومعاذ بْن هِشَام الدستوائي /10 /10 ومعتمر بْن سُلَيْمَان /10 /10 ومؤمل بْن إِسْمَاعِيل /10 /10 ووكيع بْن الجراح /10 /10 ووهب بْن جَرِير بْن حازم م /10 /10 ويحيى بْن الْفَضْل /10 /10 ويزيد بْن هَارُون /10 /10 ويعقوب بْن إِسْحَاق الْحَضْرَمِيّ القارئ /10",
