    {
      "hadith_id": 1008485,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 17931,
      "text_ar": "ويقال : أَبُو يَحْيَى البصري /10 ثَابِت البناني /10 /10 والحسن البصري بخ س /10 /10 ورياح بْن عبيدة /10 /10 وزيد بْن أسلم /10 /10 والسري بْن أَبِي السرية /10 /10 وسليمان التيمي /10 /10 وشبيل بْن عزرة /10 /10 وعبد الله بْن شوذب /10 /10 وعبد الله بْن عُبَيْد بْن عمير /10 /10 وعبد الرحمن بْن معقل بْن يسار /10 /10 وعبد الكريم بْن رشيد البصري س /10 /10 وعمرو بْن دِينَار المكي /10 /10 وعمرو بْن دِينَار البصري قهرمان آل الزُّبَيْر /10 /10 ومالك بْن دِينَار /10 /10 وهشام بْن حسان /10 /10 وهشام الدستوائي سي /10 /10 ووهيب بْن الورد المكي /10 /10 وأَبِي حَفْص س إمام لهم /10",
      "sanad_ar": "ويقال",
      "matn_ar": "أَبُو يَحْيَى البصري /10 ثَابِت البناني /10 /10 والحسن البصري بخ س /10 /10 ورياح بْن عبيدة /10 /10 وزيد بْن أسلم /10 /10 والسري بْن أَبِي السرية /10 /10 وسليمان التيمي /10 /10 وشبيل بْن عزرة /10 /10 وعبد الله بْن شوذب /10 /10 وعبد الله بْن عُبَيْد بْن عمير /10 /10 وعبد الرحمن بْن معقل بْن يسار /10 /10 وعبد الكريم بْن رشيد البصري س /10 /10 وعمرو بْن دِينَار المكي /10 /10 وعمرو بْن دِينَار البصري قهرمان آل الزُّبَيْر /10 /10 ومالك بْن دِينَار /10 /10 وهشام بْن حسان /10 /10 وهشام الدستوائي سي /10 /10 ووهيب بْن الورد المكي /10 /10 وأَبِي حَفْص س إمام لهم /10",
