      "chapter_id": null,
      "hadith_number": 21127,
      "text_ar": "أخبرنا /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 الْمَقْدِسِيَّانِ ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلَّانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ الْمُذْهِبِ L14991 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مَالِكٍ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 سُفْيَانُ L3443 /26 ، قال : حدثنا /26 سُلَيْمَانُ بْنُ سُحَيْمٍ L3592 /26 ، قال سُفْيَانُ : لَمْ أَحْفَظُ عَنْهُ غَيْرَهُ سَمِعَهُ مِنْ /26 إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ مَعْبَدِ بْنِ عَبَّاسٍ L853 /26 ، عَنْ /26 أَبِيهِ L5097/26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، قال كَشَفَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، عَنِ السِّتَارَةِ ، والنَّاسُ صُفُوفٌ خَلْفَ أَبِي بَكْرٍ ، فَقَالَ : \" أَيُّهَا النَّاسُ إِنَّهُ /20 لَمْ يَبْقَ مِنْ مُبَشِّرَاتِ النُّبُوَّةِ إِلا الرُّؤْيَا الصَّالِحَةُ يَرَاهَا الْمُسْلِمُ ، أَوْ تُرَى لَهُ ، ثُمَّ قال : أَلا إِنِّي نُهِيتُ أَنْ أَقْرَأَ رَاكِعًا ، أَوْ سَاجِدًا ، فَأَمَّا الرُّكُوعُ ، فَعَظِّمُوا فِيهِ الرَّبُ ، وأَمَّا السُّجُودُ فَاجْتَهِدُوا فِي الدُّعَاءِ ، فَقَمِنَ أَنْ يُسْتَجَابَ لَكُمْ \" /27 . رواه مسلم ، والنسائي من حديث سُفْيَان بْن عيينة ، وإسماعيل بْن جَعْفَر عنه ، وليس لَهُ عندهما غيره ، ورواه أَبُو داود من حديث سُفْيَان ، وليس لَهُ عنده سواه وسوى حديث آخر ، عَنْ أمية بنت أبي الصلت ، وروى ابن ماجه قصة الرؤيا منه من حديث سُفْيَان ، وليس لَهُ عنده سواه ، وسوى حديث آخر ، عَنْ أم حكيم بنت أمية ، والله أعلم * \r\n@ 3053 [ 2520 ] ت#E1887",
      "sanad_ar": "أخبرنا /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94",
      "matn_ar": "/94 وأَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 الْمَقْدِسِيَّانِ ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلَّانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ الْمُذْهِبِ L14991 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مَالِكٍ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 سُفْيَانُ L3443 /26 ، قال : حدثنا /26 سُلَيْمَانُ بْنُ سُحَيْمٍ L3592 /26 ، قال سُفْيَانُ : لَمْ أَحْفَظُ عَنْهُ غَيْرَهُ سَمِعَهُ مِنْ /26 إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ مَعْبَدِ بْنِ عَبَّاسٍ L853 /26 ، عَنْ /26 أَبِيهِ L5097/26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، قال كَشَفَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، عَنِ السِّتَارَةِ ، والنَّاسُ صُفُوفٌ خَلْفَ أَبِي بَكْرٍ ، فَقَالَ : \" أَيُّهَا النَّاسُ إِنَّهُ /20 لَمْ يَبْقَ مِنْ مُبَشِّرَاتِ النُّبُوَّةِ إِلا الرُّؤْيَا الصَّالِحَةُ يَرَاهَا الْمُسْلِمُ ، أَوْ تُرَى لَهُ ، ثُمَّ قال : أَلا إِنِّي نُهِيتُ أَنْ أَقْرَأَ رَاكِعًا ، أَوْ سَاجِدًا ، فَأَمَّا الرُّكُوعُ ، فَعَظِّمُوا فِيهِ الرَّبُ ، وأَمَّا السُّجُودُ فَاجْتَهِدُوا فِي الدُّعَاءِ ، فَقَمِنَ أَنْ يُسْتَجَابَ لَكُمْ \" /27 . رواه مسلم ، والنسائي من حديث سُفْيَان بْن عيينة ، وإسماعيل بْن جَعْفَر عنه ، وليس لَهُ عندهما غيره ، ورواه أَبُو داود من حديث سُفْيَان ، وليس لَهُ عنده سواه وسوى حديث آخر ، عَنْ أمية بنت أبي الصلت ، وروى ابن ماجه قصة الرؤيا منه من حديث سُفْيَان ، وليس لَهُ عنده سواه ، وسوى حديث آخر ، عَنْ أم حكيم بنت أمية ، والله أعلم * \r\n@ 3053 [ 2520 ] ت#E1887",
