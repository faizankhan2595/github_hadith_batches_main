      "hadith_id": 1008602,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 18048,
      "text_ar": "من بني شَيْبَان بْن ثعلبة بْن عكابة أدرك زمان النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ولم يره ، وقال : بعث النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ وأنا أرعى إبلا لأهلي بكاظمة . /10 جبلة بْن حَارِثَة الكلبي ت /10 /10 وحذيفة بْن اليمان /10 /10 وزيد بْن أرقم خ م د ت س /10 /10 وعبد الله بْن مَسْعُود خ م ت س /10 /10 وأَبِي مَسْعُود عُقْبَة بْن عَمْرو الأَنْصَارِيّ م 4 /10 /10 وعلي بْن أَبِي طَالِب /10",
      "sanad_ar": "من بني شَيْبَان بْن ثعلبة بْن عكابة أدرك زمان النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ولم يره",
      "matn_ar": "وقال : بعث النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ وأنا أرعى إبلا لأهلي بكاظمة . /10 جبلة بْن حَارِثَة الكلبي ت /10 /10 وحذيفة بْن اليمان /10 /10 وزيد بْن أرقم خ م د ت س /10 /10 وعبد الله بْن مَسْعُود خ م ت س /10 /10 وأَبِي مَسْعُود عُقْبَة بْن عَمْرو الأَنْصَارِيّ م 4 /10 /10 وعلي بْن أَبِي طَالِب /10",
      "grade": null,
