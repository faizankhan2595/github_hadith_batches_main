      "chapter_id": null,
      "hadith_number": 20433,
      "text_ar": "/10 إِبْرَاهِيم بْن أبي عبلة /10 /10 والأحوص بْن حكيم /10 /10 وإسرائيل بْن يونس /10 /10 وبشر بْن عَبْدِ اللَّهِ السلمي /10 /10 وجسر بْن فرقد /10 /10 والحجاج بْن أرطاة /10 /10 وحسام بْن مصك /10 /10 والحسن بْن فرات القزاز /10 /10 وروح بْن غطيف /10 /10 وسعد بْن طريف الإسكاف /10 /10 وأبي سعد سَعِيد بْن المرزبان البقَالَ /10 /10 وسلم بْن رجاء الجرمي /10 /10 وسلمة بْن سابور /10 /10 وصالح المري /10 /10 وعائذ بْن شريح /10 /10 وعَبْد اللَّهِ بْن ميسرة /10 /10 وعَبْد اللَّهِ بْن الْوَلِيد المزني /10 /10 وعَبْد الرَّحْمَنِ بْن عَبْدِ اللَّهِ بْن دينار ت /10 /10 وعبد الوارث مولى أنس بْن مالك /10 /10 وقيس بْن الربيع /10 /10 ومحمد بْن إِسْحَاقَ بْن يسار /10 /10 ومحمد بْن عَمْرِو بْن علقمة /10 /10 ومدرك بْن الحجاج /10 /10 ومسعر بْن كدام /10 /10 وهشام بْنِ عُرْوَةَ خ /10 /10 والوليد بْن جميل ت ق /10 /10 والوليد بْن عَبْدِ اللَّهِ بْن جميع /10 /10 ويحيى بن أبي عمرو الشيباني /10 /10 وشعثاء الكوفية ق /10",
