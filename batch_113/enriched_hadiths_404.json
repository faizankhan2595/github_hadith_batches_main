    {
      "hadith_id": 1014058,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 23504,
      "text_ar": "وقال الحافظ /26 أبو بَكْر أَحْمَد بْن علي بْن ثابت الخطيب /26 فيما أخبرنا /26 يوسف بْن يعقوب الشيباني /26 ، قال أخبرنا /26 زيد بْن الحسن الكندي /26 ، قال : أخبرنا /26 عَبْد الرحمن بْن مُحَمَّد الشيباني /26 عنه , أخبرنا /26 أَحْمَد بْن مُحَمَّد العتيقي /26 ، /26 وعلي بْن المحسن التنوخي /26 ، قالا : حدثنا /26 عُمَر بْن مُحَمَّد بْن علي /26 ، قال : حدثنا /26 أَحْمَد بْن الْحُسَيْن بْن إسحاق الصوفي /26 ، قال : /27 سمعت /26 سري بْن المغلس السقطي /26 يقول : /20 أربعة كانوا فِي الدنيا اعملوا أنفسهم فِي طلب الحلال ولم يدخلوا أجوافهم إلا الحلال ، فقيل له : من هم يا أبا الحسن ؟ قال : وهيب بْن الورد ، وشعيب بْن حرب ، ويوسف بْن أسباط ، وسُلَيْمَان الخواص /27 * \r\n$1315 /8",
      "sanad_ar": "وقال الحافظ /26 أبو بَكْر أَحْمَد بْن علي بْن ثابت الخطيب /26 فيما أخبرنا /26 يوسف بْن يعقوب الشيباني /26",
      "matn_ar": "قال أخبرنا /26 زيد بْن الحسن الكندي /26 ، قال : أخبرنا /26 عَبْد الرحمن بْن مُحَمَّد الشيباني /26 عنه , أخبرنا /26 أَحْمَد بْن مُحَمَّد العتيقي /26 ، /26 وعلي بْن المحسن التنوخي /26 ، قالا : حدثنا /26 عُمَر بْن مُحَمَّد بْن علي /26 ، قال : حدثنا /26 أَحْمَد بْن الْحُسَيْن بْن إسحاق الصوفي /26 ، قال : /27 سمعت /26 سري بْن المغلس السقطي /26 يقول : /20 أربعة كانوا فِي الدنيا اعملوا أنفسهم فِي طلب الحلال ولم يدخلوا أجوافهم إلا الحلال ، فقيل له : من هم يا أبا الحسن ؟ قال : وهيب بْن الورد ، وشعيب بْن حرب ، ويوسف بْن أسباط ، وسُلَيْمَان الخواص /27 * \r\n$1315 /8",
      "grade": null,
