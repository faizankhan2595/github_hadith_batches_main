      "chapter_id": null,
      "hadith_number": 22053,
      "text_ar": "/10 ابراهيم بْن حبيب بْن الشهيد /10 /10 وإبراهيم بْن مُوسَى الفراء الرازي /10 /10 وأزهر بْن سعدالسمان /10 /10 وأسباط بْن مُحَمَّد القرشي /10 /10 وإِسْمَاعِيل ابْن علية /10 /10 والأسود بْن عامر شاذان /10 /10 وأَبِي أسامة حماد بْن أسامة /10 /10 وحماد بْن مسعدة /10 /10 وحميد بْن عَبْد الرحمن الرؤاسي /10 /10 وروح بْن عبادة /10 /10 وسَعِيد بْن عامر /10 /10 وسُلَيْمَان بْن حرب /10 /10 وأَبِي خالد سُلَيْمَان بْن حيان الأحمر /10 /10 وأَبِي داود سُلَيْمَان بْن داود الطيالسي /10 /10 وشبابة بْن سوار /10 /10 وشعيب بْن حرب /10 /10 وعَبْد اللَّهِ بْن نمير /10 /10 وعَبْد الحميد بْن عَبْد الرحمن الحماني /10 /10 وعَبْد الرحمن بْن غزوان المعروف بقراد أبي نوح /10 /10 وعَبْد الرحمن بْن مُحَمَّد المحاربي /10 /10 وعَبْد الرحمن بْن مهدي /10 /10 وعَبْد الصمد بْن عَبْد الْوَارِثِ /10 /10 وأَبِي عامر عَبْد الملك بْن عَمْرو العقدي /10 /10 وعبدة بْن سُلَيْمَان /10 /10 وعلي بْن عاصم الواسطي /10 /10 وعلي بْن قادم د /10 /10 وأَبِي داود عُمَر بْن سعد الحفري /10 /10 وأَبِي نعيم الفضل بْن دكين /10 /10 وقبيصة بْن عقبة /10 /10 ومبشر بْن إسماعيل الحلبي /10 /10 وأَبِي معاوية مُحَمَّد بْن خازم الضرير /10 /10 ومحمد بْن عِيسَى بْن الطباع س /10 /10 ومحمد بْن كثير المصيصي /10 /10 ومعاذ بْن معاذ العنبري /10 /10 ومنصور بْن عمار /10 /10 ووكيع بْن الجراح مد /10 /10 ووهب بْن جرير بْن حازم /10 /10 ويحيى بْن آدم /10 /10 ويحيى بْن سَعِيد القطان س /10 /10 ويزيد بْن هارون /10 /10 ويعقوب بْن إسحاق الحضرمي /10 /10 ويعقوب بْن مُحَمَّد بْن عِيسَى الزهري /10",
