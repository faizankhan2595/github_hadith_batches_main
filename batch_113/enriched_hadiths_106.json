    {
      "hadith_id": 1009581,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 19027,
      "text_ar": "نزيل مكة /10 إِبْرَاهِيم بْن مُحَمَّد بْن ثَابِت العبدري الحجبي ويقال : الجمحي /10 /10 وحرب بْن أَبِي العالية /10 /10 وحماد بْن سَلَمَة م /10 /10 ودفاع بْن دغفل /10 /10 ورفاعة بْن يَحْيَى الزرقي د /10 /10 وعبد الله بْن عَبْد الْعَزِيزِ الليثي /10 /10 وعبد العزيز بْن مُحَمَّد الدراوردي د /10 /10 والفرات بْن أَبِي الفرات /10 /10 وفضيل بْن عياض /10 /10 ومالك بْن أَنَس /10 /10 ومحمد بْن عَمَّار بْن حَفْص المؤذن /10 /10 والمغيرة بْن عَبْد الرَّحْمَنِ الحزامي /10 /10 وأَبِي بَكْر بْن نَافِع الْمَدَنِيّ /10",
      "sanad_ar": "نزيل مكة /10 إِبْرَاهِيم بْن مُحَمَّد بْن ثَابِت العبدري الحجبي ويقال",
      "matn_ar": "الجمحي /10 /10 وحرب بْن أَبِي العالية /10 /10 وحماد بْن سَلَمَة م /10 /10 ودفاع بْن دغفل /10 /10 ورفاعة بْن يَحْيَى الزرقي د /10 /10 وعبد الله بْن عَبْد الْعَزِيزِ الليثي /10 /10 وعبد العزيز بْن مُحَمَّد الدراوردي د /10 /10 والفرات بْن أَبِي الفرات /10 /10 وفضيل بْن عياض /10 /10 ومالك بْن أَنَس /10 /10 ومحمد بْن عَمَّار بْن حَفْص المؤذن /10 /10 والمغيرة بْن عَبْد الرَّحْمَنِ الحزامي /10 /10 وأَبِي بَكْر بْن نَافِع الْمَدَنِيّ /10",
