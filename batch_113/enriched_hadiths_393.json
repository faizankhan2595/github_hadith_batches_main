    {
      "hadith_id": 1013885,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 23331,
      "text_ar": "وقال الواقدي : الليثي من أنفسهم /10 إبراهيم بْن عَبْد اللَّهِ بْن حنين د تم س /10 /10 وأنس بْن مَالِك خ م د س ق /10 /10 وسَعِيد بْن عَبْد الرحمن بْن مكمل الأعشى /10 /10 وسَعِيد بْن المسيب خ م /10 /10 وعامر بْن سعد بْن أبي وقاص /10 /10 وعَبْد اللَّهِ بْن حنين س /10 /10 وعَبْد اللَّهِ بْن أبي عتيق م س /10 /10 وعَبْد الرحمن بْن أبي سَعِيد الخدري م /10 /10 وعَبْد الرحمن بْن أبي عمرة خ م /10 /10 وعطاء بْن يسار خ م د س ق /10 /10 وعكرمة مولى ابْن عباس /10 /10 وعلي بْن يحيى بْن خلاد /10 /10 وعُمَر بْن الحكم بْن ثوبان /10 /10 وعُمَر بْن نبيه الكعبي وهو من أقرانه /10 /10 وعون بْن عَبْد اللَّهِ بْن عتبة /10 /10 وكريب مولى ابْن عباس خ م د ق /10 /10 ويحيى بْن جعفر بْن أبي كثير وهو أصغر منه /10 /10 وأَبِي السائب مولى هشام بْن زهرة /10 /10 وأَبِي سلمة بْن عَبْد الرحمن بْن عوف د تم س /10 /10 وأَبِي صالح مولى السعديين /10",
      "sanad_ar": "وقال الواقدي",
      "matn_ar": "الليثي من أنفسهم /10 إبراهيم بْن عَبْد اللَّهِ بْن حنين د تم س /10 /10 وأنس بْن مَالِك خ م د س ق /10 /10 وسَعِيد بْن عَبْد الرحمن بْن مكمل الأعشى /10 /10 وسَعِيد بْن المسيب خ م /10 /10 وعامر بْن سعد بْن أبي وقاص /10 /10 وعَبْد اللَّهِ بْن حنين س /10 /10 وعَبْد اللَّهِ بْن أبي عتيق م س /10 /10 وعَبْد الرحمن بْن أبي سَعِيد الخدري م /10 /10 وعَبْد الرحمن بْن أبي عمرة خ م /10 /10 وعطاء بْن يسار خ م د س ق /10 /10 وعكرمة مولى ابْن عباس /10 /10 وعلي بْن يحيى بْن خلاد /10 /10 وعُمَر بْن الحكم بْن ثوبان /10 /10 وعُمَر بْن نبيه الكعبي وهو من أقرانه /10 /10 وعون بْن عَبْد اللَّهِ بْن عتبة /10 /10 وكريب مولى ابْن عباس خ م د ق /10 /10 ويحيى بْن جعفر بْن أبي كثير وهو أصغر منه /10 /10 وأَبِي السائب مولى هشام بْن زهرة /10 /10 وأَبِي سلمة بْن عَبْد الرحمن بْن عوف د تم س /10 /10 وأَبِي صالح مولى السعديين /10",
