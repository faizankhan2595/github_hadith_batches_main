    {
      "hadith_id": 1013925,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 23371,
      "text_ar": "2 ما سمعت من رجل حديثا إلا قال لي : حَدَّثَنِي أو حدثنا إلا حديثا واحدا ، قال شعبة : قال قَتَادَة : قال أنس : قال رَسُول اللَّه صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ : “ إن من حسن الصلاة إقامة الصف “ ، أو كما قال ، فكرهت أن يفسد علي من أجل جودة الحديث",
      "sanad_ar": "2 ما سمعت من رجل حديثا إلا قال لي",
      "matn_ar": "حَدَّثَنِي أو حدثنا إلا حديثا واحدا ، قال شعبة : قال قَتَادَة : قال أنس : قال رَسُول اللَّه صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ : “ إن من حسن الصلاة إقامة الصف “ ، أو كما قال ، فكرهت أن يفسد علي من أجل جودة الحديث",
