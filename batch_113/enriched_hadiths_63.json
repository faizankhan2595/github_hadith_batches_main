    {
      "hadith_id": 1008942,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 18388,
      "text_ar": "2 سألت عَبْد الرَّحْمَنِ بْن إِبْرَاهِيم عَنْ قول من أدرك فِي سَعِيد بْن بشير فَقَالَ : يوثقونه وقال فِي موضع آخر : قلت لدحيم : ما تقول فِي مُحَمَّد بْن راشد ؟ فَقَالَ : ثقة وكان يميل إِلَى هوى قلت : فأين هُوَ من سَعِيد بْن بشير فقدم سعيدا عليه وقال أيضا : قلت لأبي مسهر : كَانَ سَعِيد بْن بشير قدريا ؟ قال : معاذ الله",
      "sanad_ar": "2 سألت عَبْد الرَّحْمَنِ بْن إِبْرَاهِيم عَنْ قول من أدرك فِي سَعِيد بْن بشير فَقَالَ",
      "matn_ar": "يوثقونه وقال فِي موضع آخر : قلت لدحيم : ما تقول فِي مُحَمَّد بْن راشد ؟ فَقَالَ : ثقة وكان يميل إِلَى هوى قلت : فأين هُوَ من سَعِيد بْن بشير فقدم سعيدا عليه وقال أيضا : قلت لأبي مسهر : كَانَ سَعِيد بْن بشير قدريا ؟ قال : معاذ الله",
