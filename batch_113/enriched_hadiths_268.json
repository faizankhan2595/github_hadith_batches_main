    {
      "hadith_id": 1012015,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 21461,
      "text_ar": "0 /11 ابنه جعفر بْن سُلَيْمَان بْن علي الهاشمي /11 /11 والحجاج بْن الحارث الشقري /11 /11 والحكم بْن عبدة /11 /11 وخالد بْن يزيد بْن خالد بْن عَبْد اللَّهِ القسري /11 /11 وخالد بْن يزيد بْن أبي مَالِك /11 /11 وزيد بْن عَبْد الحميد بْن عَبْد الرحمن بْن زيد بْن الخطاب ق /11 /11 وسلام بْن أبي خبزة /11 /11 وصالح الناجي /11 /11 وعافية بْن يزيد الأودي سي /11 /11 وابن أخيه عَبْد الملك ويقال : عَبْد اللَّهِ بْن صالح بْن علي /11 /11 وعَبْد الملك بْن قريب الأصمعي /11 /11 والقاسم بْن مُوسَى /11 /11 والمحبر بْن قحذم والد داود بْن المحبر /11 /11 ومحمد بْن راشد المكحولي /11 /11 وابنه مُحَمَّد بْن سُلَيْمَان بْن الهاشمي /11 /11 ومعمر بْن خاقان الاهتمي /11 /11 والمغيرة بْن جميل الكندي /11 /11 وابنته زينب بنت سُلَيْمَان بْن علي /11 #",
      "sanad_ar": "0 /11 ابنه جعفر بْن سُلَيْمَان بْن علي الهاشمي /11 /11 والحجاج بْن الحارث الشقري /11 /11 والحكم بْن عبدة /11 /11 وخالد بْن يزيد بْن خالد بْن عَبْد اللَّهِ القسري /11 /11 وخالد بْن يزيد بْن أبي مَالِك /11 /11 وزيد بْن عَبْد الحميد بْن عَبْد الرحمن بْن زيد بْن الخطاب ق /11 /11 وسلام بْن أبي خبزة /11 /11 وصالح الناجي /11 /11 وعافية بْن يزيد الأودي سي /11 /11 وابن أخيه عَبْد الملك ويقال",
      "matn_ar": "عَبْد اللَّهِ بْن صالح بْن علي /11 /11 وعَبْد الملك بْن قريب الأصمعي /11 /11 والقاسم بْن مُوسَى /11 /11 والمحبر بْن قحذم والد داود بْن المحبر /11 /11 ومحمد بْن راشد المكحولي /11 /11 وابنه مُحَمَّد بْن سُلَيْمَان بْن الهاشمي /11 /11 ومعمر بْن خاقان الاهتمي /11 /11 والمغيرة بْن جميل الكندي /11 /11 وابنته زينب بنت سُلَيْمَان بْن علي /11 #",
