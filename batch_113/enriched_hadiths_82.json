      "hadith_id": 1009222,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 18668,
      "text_ar": "ويقال : أَبُو عُمَر المدائني /10 إِدْرِيس بْن قادم المدائني /10 /10 وثابت بْن قَيْس الْمَدَنِيّ /10 /10 وحمزة بْن حَبِيب الزَّيَّات /10 /10 والزبير بْن سَعِيد الْهَاشِمِيّ ق /10 /10 وزكريا بْن يَحْيَى /10 /10 وزمعة بْن صَالِح /10 /10 وأَبِي الفيض سَالِم بْن عبد الأعلى /10 /10 وسعيد بْن الْحَكَمِ شيخ يروي عَنْ نفيع أَبِي دَاوُد /10 /10 وعلي بْن أَبِي سارة /10 /10 وعنبسة بْن عَبْد الرَّحْمَنِ الْقُرَشِيّ ت /10",
      "sanad_ar": "ويقال",
      "matn_ar": "أَبُو عُمَر المدائني /10 إِدْرِيس بْن قادم المدائني /10 /10 وثابت بْن قَيْس الْمَدَنِيّ /10 /10 وحمزة بْن حَبِيب الزَّيَّات /10 /10 والزبير بْن سَعِيد الْهَاشِمِيّ ق /10 /10 وزكريا بْن يَحْيَى /10 /10 وزمعة بْن صَالِح /10 /10 وأَبِي الفيض سَالِم بْن عبد الأعلى /10 /10 وسعيد بْن الْحَكَمِ شيخ يروي عَنْ نفيع أَبِي دَاوُد /10 /10 وعلي بْن أَبِي سارة /10 /10 وعنبسة بْن عَبْد الرَّحْمَنِ الْقُرَشِيّ ت /10",
