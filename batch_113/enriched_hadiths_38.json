      "chapter_id": null,
      "hadith_number": 18014,
      "text_ar": "0 /11 إِبْرَاهِيم بْن مُحَمَّد بْن أَبِي يَحْيَى الأسلمي /11 /11 وإسحاق بْن إِبْرَاهِيم بْن نسطاس /11 /11 وأَبُو ضمرة أَنَس بْن عياض /11 /11 وحاتم بْن إِسْمَاعِيل /11 /11 وحماد بْن زَيْد س /11 /11 وخالد بْن أَبِي عِمْرَان /11 /11 وداود بْن قَيْس الفراء د /11 /11 وسعيد بْن عَبْد الرَّحْمَنِ الجمحي /11 /11 وسفيان الثوري س /11 /11 وأَبُو خَالِد سُلَيْمَان بْن حيان الأحمر ق /11 /11 وسليمان بْن سَالِم الْمَدَنِيّ /11 /11 وشعبة بْن الحجاج س /11 /11 وعاصم بْن عَبْد الْعَزِيزِ الأشجعي /11 /11 وعبد الرحمن بْن النعمان الأَنْصَارِيّ /11 /11 وعبد العزيز بْن مُحَمَّد الدراوردي /11 /11 وعبد الملك بْن جريج س /11 /11 وعلي بْن عُمَر المقدمي /11 /11 ومالك بْن أَنَس د ت س /11 /11 ومحمد بْن إِسْحَاق بْن يسار س /11 /11 ومحمد بْن جَعْفَر بْن أَبِي كثير /11 /11 ومحمد بْن مُسْلِم بْن شهاب الزُّهْرِيّ وهُوَ أكبر منه /11 /11 ومحمد بْن مُوسَى الفطري د ت س /11 /11 ونوح بْن أَبِي بِلال /11 /11 ويحيى بْن سَعِيد الأَنْصَارِيّ س ، وهُوَ من أقرانه /11 /11 ويحيى بْن سَعِيد الْقَطَّان ت س   /11 /11 ويحيى بْن عَبْد اللَّهِ بْن أَبِي قتادة وهُوَ من أقرانه /11 /11 ويحيى بْن معن العجلاني /11 /11 ويزيد بْن عَبْد الْمَلِكِ النوفلي /11 /11 ويزيد بْن مُحَمَّد الْقُرَشِيّ س /11 /11 وأَبُو بَكْر بْن عُمَر بْن عَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ بْن عُمَر بْن الخطاب /11 ++ وهُوَ من أقرانه # قال",
      "sanad_ar": "0 /11 إِبْرَاهِيم بْن مُحَمَّد بْن أَبِي يَحْيَى الأسلمي /11 /11 وإسحاق بْن إِبْرَاهِيم بْن نسطاس /11 /11 وأَبُو ضمرة أَنَس بْن عياض /11 /11 وحاتم بْن إِسْمَاعِيل /11 /11 وحماد بْن زَيْد س /11 /11 وخالد بْن أَبِي عِمْرَان /11 /11 وداود بْن قَيْس الفراء د /11 /11 وسعيد بْن عَبْد الرَّحْمَنِ الجمحي /11 /11 وسفيان الثوري س /11 /11 وأَبُو خَالِد سُلَيْمَان بْن حيان الأحمر ق /11 /11 وسليمان بْن سَالِم الْمَدَنِيّ /11 /11 وشعبة بْن الحجاج س /11 /11 وعاصم بْن عَبْد الْعَزِيزِ الأشجعي /11 /11 وعبد الرحمن بْن النعمان الأَنْصَارِيّ /11 /11 وعبد العزيز بْن مُحَمَّد الدراوردي /11 /11 وعبد الملك بْن جريج س /11 /11 وعلي بْن عُمَر المقدمي /11 /11 ومالك بْن أَنَس د ت س /11 /11 ومحمد بْن إِسْحَاق بْن يسار س /11 /11 ومحمد بْن جَعْفَر بْن أَبِي كثير /11 /11 ومحمد بْن مُسْلِم بْن شهاب الزُّهْرِيّ وهُوَ أكبر منه /11 /11 ومحمد بْن مُوسَى الفطري د ت س /11 /11 ونوح بْن أَبِي بِلال /11 /11 ويحيى بْن سَعِيد الأَنْصَارِيّ س",
      "matn_ar": "وهُوَ من أقرانه /11 /11 ويحيى بْن سَعِيد الْقَطَّان ت س   /11 /11 ويحيى بْن عَبْد اللَّهِ بْن أَبِي قتادة وهُوَ من أقرانه /11 /11 ويحيى بْن معن العجلاني /11 /11 ويزيد بْن عَبْد الْمَلِكِ النوفلي /11 /11 ويزيد بْن مُحَمَّد الْقُرَشِيّ س /11 /11 وأَبُو بَكْر بْن عُمَر بْن عَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ بْن عُمَر بْن الخطاب /11 ++ وهُوَ من أقرانه # قال",
