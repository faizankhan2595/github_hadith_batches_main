    {
      "hadith_id": 1010231,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 19677,
      "text_ar": "أخبرنا /94 أَحْمَدُ بْنُ أَبِي الْخَيْرِ L63250 /94 ، /94 والْمُسَلَّمُ بْنُ مُحَمَّدِ بْنِ عَلَّانَ L46139 /94 ، قَالا : أَنْبَأَنَا /26 أَبُو مُحَمَّدٍ الْقَاسِمُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ عَسَاكِرَ L75930 /26 . ح وأَخْبَرَتْنَا /94 فَاطِمَةُ بِنْتُ عَلِيِّ بْنِ الْقَاسِمِ بْنِ عَلِيِّ بْنِ عَسَاكِرَ L63264 /94 ، قَالَتْ : أخبرنا /26 الْخِضْرُ بْنُ كَامِلِ بْنِ سُبَيْعٍ الدَّلالُ L75585 /26 ، قَالا : أخبرنا /26 أَبُو الْفَتْحِ نَصْرُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْقَوِيِّ الْمِصِّيصِيُّ L32682 /26 ، قال : أخبرنا /26 الْقَاضِي أَبُو مَنْصُورٍ مُحَمَّدُ بْنُ أَحْمَدَ بْنِ عَلِيِّ بْنِ شَكْرَوَيْهِ L28309 /26 ، بِأَصْبَهَانَ ، قال : حدثنا /26 أَبُو عَلِيِّ بْنُ الْبَغْدَادِيُّ يَعْنِي الْحَسَنَ بْنَ عَلِيِّ بْنِ أَحْمَدَ بْنِ سُلَيْمَانَ L52166 /26 ، قال : حدثنا /26 الْفَضْلُ بْنُ الْخَصِيبِ L26450 /26 ، قال : حدثنا /26 مُحَمَّدُ بْنُ الْوَزِيرِ الْعَبْدِيُّ الْوَاسِطِيُّ L6873 /26 ، قال : حدثنا /26 أَبُو سُفْيَانَ الْحَمِيرِيُّ L3412 /26 ، عَنِ /26 الضَّحَّاكِ بْنِ حَمْزَةَ L1483 /26 ، /27 عَنْ /26 عمرو بْنِ شُعَيْبٍ L6144 /26 ، عَنْ /26 أَبِيهِ L3815 /26 ، عَنْ /93 جَدِّهِ L4980 /93 ، قال : قال رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ : \" /20 مَنْ سَبَّحَ اللَّهَ تَعَالَى مِائَةٍ بِالْغَدَاةِ ، ومِائَةً بِالْعَشِيِّ ، كَانَ كَمَنْ حَجَّ مِائَةَ حَجَّةٍ ، ومَنْ حَمِدَ اللَّهَ تَعَالَى مِائَةً بِالْغَدَاةِ ، ومِائَةً بِالْعَشِيِّ ، كَانَ كَمَنْ حَمَلَ عَلَى مِائَةَ فَرَسٍ فِي سَبِيلِ اللَّهِ ، أَوْ قال : غَزَا مِائَةَ غَزْوَةٍ ، ومَنْ هَلَّلَ اللَّهَ تَعَالَى مِائَةً بِالْغَدَاةِ ، ومِائَةً بِالْعَشِيِّ ، كَانَ كَمَنْ أَعْتَقَ مِائَةَ رَقَبَةٍ مِنْ ولَدِ إِسْمَاعِيلَ ، ومَنْ كَبَّرَ اللَّهَ تَعَالَى مِائَةً بِالْغَدَاةِ ، ومِائَةً بِالْعَشِيِّ ، لَمْ يَأْتِ فِي ذَلِكَ الْيَوْمِ أَحَدٌ بِأَكْثَرِ مِمَّا أَتَى بِهِ إِلا مَنْ قال مِثْلَ مَا قال ، أَوْ زَادَ عَلَى : مَا قال \" /27 . رواه الترمذي ، عَنْ مُحَمَّد بْن وزير ، فوافقناه فيه بعلو ، وقال حسن غريب ، وليس لأبي سفيان الحميري ، ولا للضحاك بْن حمرة عندي سوى هذا الحديث الواحد * \r\n@ 2878 [ 2380 ] د2E1776",
      "sanad_ar": "أخبرنا /94 أَحْمَدُ بْنُ أَبِي الْخَيْرِ L63250 /94",
      "matn_ar": "/94 والْمُسَلَّمُ بْنُ مُحَمَّدِ بْنِ عَلَّانَ L46139 /94 ، قَالا : أَنْبَأَنَا /26 أَبُو مُحَمَّدٍ الْقَاسِمُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ عَسَاكِرَ L75930 /26 . ح وأَخْبَرَتْنَا /94 فَاطِمَةُ بِنْتُ عَلِيِّ بْنِ الْقَاسِمِ بْنِ عَلِيِّ بْنِ عَسَاكِرَ L63264 /94 ، قَالَتْ : أخبرنا /26 الْخِضْرُ بْنُ كَامِلِ بْنِ سُبَيْعٍ الدَّلالُ L75585 /26 ، قَالا : أخبرنا /26 أَبُو الْفَتْحِ نَصْرُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْقَوِيِّ الْمِصِّيصِيُّ L32682 /26 ، قال : أخبرنا /26 الْقَاضِي أَبُو مَنْصُورٍ مُحَمَّدُ بْنُ أَحْمَدَ بْنِ عَلِيِّ بْنِ شَكْرَوَيْهِ L28309 /26 ، بِأَصْبَهَانَ ، قال : حدثنا /26 أَبُو عَلِيِّ بْنُ الْبَغْدَادِيُّ يَعْنِي الْحَسَنَ بْنَ عَلِيِّ بْنِ أَحْمَدَ بْنِ سُلَيْمَانَ L52166 /26 ، قال : حدثنا /26 الْفَضْلُ بْنُ الْخَصِيبِ L26450 /26 ، قال : حدثنا /26 مُحَمَّدُ بْنُ الْوَزِيرِ الْعَبْدِيُّ الْوَاسِطِيُّ L6873 /26 ، قال : حدثنا /26 أَبُو سُفْيَانَ الْحَمِيرِيُّ L3412 /26 ، عَنِ /26 الضَّحَّاكِ بْنِ حَمْزَةَ L1483 /26 ، /27 عَنْ /26 عمرو بْنِ شُعَيْبٍ L6144 /26 ، عَنْ /26 أَبِيهِ L3815 /26 ، عَنْ /93 جَدِّهِ L4980 /93 ، قال : قال رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ : \" /20 مَنْ سَبَّحَ اللَّهَ تَعَالَى مِائَةٍ بِالْغَدَاةِ ، ومِائَةً بِالْعَشِيِّ ، كَانَ كَمَنْ حَجَّ مِائَةَ حَجَّةٍ ، ومَنْ حَمِدَ اللَّهَ تَعَالَى مِائَةً بِالْغَدَاةِ ، ومِائَةً بِالْعَشِيِّ ، كَانَ كَمَنْ حَمَلَ عَلَى مِائَةَ فَرَسٍ فِي سَبِيلِ اللَّهِ ، أَوْ قال : غَزَا مِائَةَ غَزْوَةٍ ، ومَنْ هَلَّلَ اللَّهَ تَعَالَى مِائَةً بِالْغَدَاةِ ، ومِائَةً بِالْعَشِيِّ ، كَانَ كَمَنْ أَعْتَقَ مِائَةَ رَقَبَةٍ مِنْ ولَدِ إِسْمَاعِيلَ ، ومَنْ كَبَّرَ اللَّهَ تَعَالَى مِائَةً بِالْغَدَاةِ ، ومِائَةً بِالْعَشِيِّ ، لَمْ يَأْتِ فِي ذَلِكَ الْيَوْمِ أَحَدٌ بِأَكْثَرِ مِمَّا أَتَى بِهِ إِلا مَنْ قال مِثْلَ مَا قال ، أَوْ زَادَ عَلَى : مَا قال \" /27 . رواه الترمذي ، عَنْ مُحَمَّد بْن وزير ، فوافقناه فيه بعلو ، وقال حسن غريب ، وليس لأبي سفيان الحميري ، ولا للضحاك بْن حمرة عندي سوى هذا الحديث الواحد * \r\n@ 2878 [ 2380 ] د2E1776",
