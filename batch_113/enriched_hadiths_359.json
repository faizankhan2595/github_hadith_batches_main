    {
      "hadith_id": 1013374,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 22820,
      "text_ar": "أخبرنا به /94 أَبُو إسحاق بْن الدرجي L46609 /94 ، /94 وإِسْمَاعِيل بْن العسقلاني L63233 /94 ، قالا : أَنَبَأَنَا /26 أَبُو جعفر الصيدلاني L46610 /26 ، قال : أخبرنا /26 محمود بْن إسماعيل الصَّيْرَفِيّ L31136 /26 ، قال : أخبرنا /26 أبو بَكْرِ بْنُ شاذان الأعرج L44975 /26 ، قال : أخبرنا /26 أبو بَكْرِ بْنُ فورك القباب L44949 /26 ، قال : أخبرنا /26 أبو بَكْرِ بْنُ أَبِي عاصم L10084 /26 ، قال : حدثنا /26 مُحَمَّد بْن أبي بَكْر المقدمي L6760 /26 ، قال : حدثنا /26 معتمر بْن سُلَيْمَان L7607 /26 , عَنْ /26 شبيب بْن عَبْد الملك L3752 /26 ، عَنْ /26 مقاتل بْن حيان L7653 /26 ، عَنْ /26 سالم L3194 /26 ، /27 عَنِ /93 ابن عُمَر L4967 /93 ، عَنِ النبي صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، قال : /20 “ حرم اللَّه الخمر وكل مسكر حرام “ /27 . رواه النسائي ، عَنْ مُحَمَّد بْن عَبْد الأعلى ، عَنْ معتمر بْن سُلَيْمَان ، فوقع لنا بدلا عاليا ، وحديث أبي داود يأتي ذكره فِي ترجمة عمرة عمة مقاتل بْن حيان إن شاء اللَّه * \r\n@ 3284 [ 2694 ] ع",
      "sanad_ar": "أخبرنا به /94 أَبُو إسحاق بْن الدرجي L46609 /94",
      "matn_ar": "/94 وإِسْمَاعِيل بْن العسقلاني L63233 /94 ، قالا : أَنَبَأَنَا /26 أَبُو جعفر الصيدلاني L46610 /26 ، قال : أخبرنا /26 محمود بْن إسماعيل الصَّيْرَفِيّ L31136 /26 ، قال : أخبرنا /26 أبو بَكْرِ بْنُ شاذان الأعرج L44975 /26 ، قال : أخبرنا /26 أبو بَكْرِ بْنُ فورك القباب L44949 /26 ، قال : أخبرنا /26 أبو بَكْرِ بْنُ أَبِي عاصم L10084 /26 ، قال : حدثنا /26 مُحَمَّد بْن أبي بَكْر المقدمي L6760 /26 ، قال : حدثنا /26 معتمر بْن سُلَيْمَان L7607 /26 , عَنْ /26 شبيب بْن عَبْد الملك L3752 /26 ، عَنْ /26 مقاتل بْن حيان L7653 /26 ، عَنْ /26 سالم L3194 /26 ، /27 عَنِ /93 ابن عُمَر L4967 /93 ، عَنِ النبي صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، قال : /20 “ حرم اللَّه الخمر وكل مسكر حرام “ /27 . رواه النسائي ، عَنْ مُحَمَّد بْن عَبْد الأعلى ، عَنْ معتمر بْن سُلَيْمَان ، فوقع لنا بدلا عاليا ، وحديث أبي داود يأتي ذكره فِي ترجمة عمرة عمة مقاتل بْن حيان إن شاء اللَّه * \r\n@ 3284 [ 2694 ] ع",
