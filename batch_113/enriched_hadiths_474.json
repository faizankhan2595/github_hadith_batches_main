    {
      "hadith_id": 1015101,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 24547,
      "text_ar": "ويقال أبو محمد الدمشقي /10 إبراهيم بن أبي كريمة الصيداوي /10 /10 وإبراهيم بن مرة ق /10 /10 وأصبغ /10 /10 وثور بن يزيد الرحبي /10 /10 وراشد بن داود الصنعاني /10 /10 وزهير بن محمد س /10 /10 وزيد بن واقد ق /10 /10 وسعيد بن أبي عروبة /10 /10 وسليمان بن داود الخولاني /10 /10 وسليمان بن أبي كريمة /10 /10 وصفوان بن عمرو السكسكي /10 /10 وطلحة بن زيد الرقي /10 /10 وعبد الله بن علي القرشي /10 /10 وعبد الرحمن بن ثابت بن ثوبان /10 /10 وعبد الرحمن بن عمرو الآوزاعي /10 /10 وعبد الكريم بن مالك الجزري /10 /10 وعبد الملك بن جريج /10 /10 وأبي وهب عبيد الله بن عبيد الكلاعي /10 /10 وعتبة بن حميد الضبي /10 /10 والعلاء بن الحارث /10 /10 وعياض بن عبد الله الفهري /10 /10 والقاسم أبي عبد الرحمن /10 /10 ومحمد بن أبي عتيق /10 /10 ومحمد بن المنكدر /10 /10 والمهاجر بن أبي حبيب /10 /10 وموسى بن عقبة /10 /10 وموسى بن يسار الأردني ت /10 /10 ونصر بن علقمة الحضرمي فق /10 /10 وهاشم بن زيد ويقال ابن زائد الدمشقي /10 /10 وهشام بن عروة /10 /10 وهشام الكناني /10 /10 والوضين بن عطاء /10 /10 والوليد بن جميل /10 /10 ويحيى بن الحارث الذماري /10 /10 ويونس بن عبيد /10 /10 وأبي عبد الله النجراني /10",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
