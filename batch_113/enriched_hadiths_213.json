    {
      "hadith_id": 1011182,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 20628,
      "text_ar": "0 /11 إِسْمَاعِيل بْن أبي أويس /11 /11 وأَبُو ضمرة أنس بْن عياض الليثي /11 /11 وجعفر بْن عون /11 /11 وخالد بْن يَزِيدَ العمري /11 /11 وسفيان الثوري /11 /11 وعَبْد اللَّهِ بْن المبارك /11 /11 وعَبْد اللَّهِ بْن مسلمة القعنبي /11 /11 وعَبْد اللَّهِ بْن وهب /11 /11 وعبد العزيز بْن مُحَمَّدٍ الدراوردي /11 /11 وعثمان بْن العلاء /11 /11 وعمر بْن هَارُونَ البلخي /11 /11 وأَبُو نعيم الْفَضْل بْن دكين بخ /11 /11 والفضل بْن مُوسَى السيناني ت /11 /11 ومحمد بْن إِبْرَاهِيمَ بْن دينار المدني /11 /11 ومحمد بْن إِسْمَاعِيلَ بْن أبي فديك ت ق /11 /11 ومحمد بْن سُلَيْمَانَ بْن أبي داود الحراني /11 /11 ومحمد بْن عُمَرَ الواقدي /11 /11 والنعمان بْن عبد السلام /11 /11 ووكيع بْن الجراح /11 /11 وأَبُو نباته يونس بْن يَحْيَى بْن نباتة المدني بخ ت /11 /11 وأَبُو الْقَاسِمِ بْن أبي الزناد /11 ++ قال : عمرو بْن عَلِيٍّ سَلَمَة بْن وردان أخو عَبْد الرَّحْمَنِ بْن وردان الكناني وأنكر ذلك الْبُخَارِيّ وأَبُو حاتم وقالا : عَبْد الرَّحْمَنِ مَكِّيّ وسلمة مدني ++ وقال",
      "sanad_ar": "0 /11 إِسْمَاعِيل بْن أبي أويس /11 /11 وأَبُو ضمرة أنس بْن عياض الليثي /11 /11 وجعفر بْن عون /11 /11 وخالد بْن يَزِيدَ العمري /11 /11 وسفيان الثوري /11 /11 وعَبْد اللَّهِ بْن المبارك /11 /11 وعَبْد اللَّهِ بْن مسلمة القعنبي /11 /11 وعَبْد اللَّهِ بْن وهب /11 /11 وعبد العزيز بْن مُحَمَّدٍ الدراوردي /11 /11 وعثمان بْن العلاء /11 /11 وعمر بْن هَارُونَ البلخي /11 /11 وأَبُو نعيم الْفَضْل بْن دكين بخ /11 /11 والفضل بْن مُوسَى السيناني ت /11 /11 ومحمد بْن إِبْرَاهِيمَ بْن دينار المدني /11 /11 ومحمد بْن إِسْمَاعِيلَ بْن أبي فديك ت ق /11 /11 ومحمد بْن سُلَيْمَانَ بْن أبي داود الحراني /11 /11 ومحمد بْن عُمَرَ الواقدي /11 /11 والنعمان بْن عبد السلام /11 /11 ووكيع بْن الجراح /11 /11 وأَبُو نباته يونس بْن يَحْيَى بْن نباتة المدني بخ ت /11 /11 وأَبُو الْقَاسِمِ بْن أبي الزناد /11 ++ قال",
      "matn_ar": "عمرو بْن عَلِيٍّ سَلَمَة بْن وردان أخو عَبْد الرَّحْمَنِ بْن وردان الكناني وأنكر ذلك الْبُخَارِيّ وأَبُو حاتم وقالا : عَبْد الرَّحْمَنِ مَكِّيّ وسلمة مدني ++ وقال",
