    {
      "hadith_id": 1009628,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 19074,
      "text_ar": "قاضي بغداد فِي عسكر المهدي زمن الرشيد /10 سَعْد بْن إِسْحَاق بْن كعب بْن عجرة /10 /10 وأَبِي حازم سَلَمَة بْن دِينَار الْمَدَنِيّ س /10 /10 وسهيل بْن أَبِي صَالِح عخ د س /10 /10 وصالح بْن مُحَمَّد بْن زائدة أَبِي واقِد الليثي الصغير /10 /10 وعبد الله بْن عَبْد اللَّهِ بْن أَبِي طَلْحَة /10 /10 وعبد الله بْن مُحَمَّد بْن سيرين /10 /10 وعبد الحميد بْن جبير بْن شَيْبَة /10 /10 وعبد الرحمن بْن الْقَاسِم بْن مُحَمَّد /10 /10 وعبيد الله بْن عُمَر /10 /10 ومحمد بْن قَيْس الْمَدَنِيّ /10 /10 ومحمد بْن واثلة الأسدي /10 /10 وموسى بْن علي بْن رباح ق /10 /10 وهشام بْن عُرْوَة م د س /10 /10 ويونس بْن يَزِيد الأيلي /10",
