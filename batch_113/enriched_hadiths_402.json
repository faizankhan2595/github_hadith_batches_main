    {
      "hadith_id": 1014017,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 23463,
      "text_ar": "0 /11 أَبُو داود حديثا واحدا /11 /11 وإبراهيم بْن حماد بْن إسحاق بْن إسماعيل بْن حماد بْن زيد القاضي /11 /11 وإبراهيم بْن حمدان بْن نيطر العاقولي /11 /11 وإبراهيم بْن مُحَمَّد بْن عرفة الأزدي نفطويه /11 /11 وأَحْمَد بْن عَبْد اللَّهِ بْن شجاع البغدادي /11 /11 وأَبُو بكر أَحْمَد بْن عَبْد اللَّهِ بْن مُحَمَّد النحاس وكيل أبي صخرة /11 /11 وأَحْمَد بْن عَمْرو بْن عَبْد الخالق البزار /11 /11 وأَحْمَد بْن مُحَمَّد بْن سعدان الواسطي /11 /11 وأَبُو بكر أَحْمَد بْن مُحَمَّد بْن يعقوب الأصبهاني الخزاز /11 /11 والحسن بن أَحْمَدَ بْن الربيع الأنماطي /11 /11 والحسين بْن إسماعيل المحاملي /11 /11 وحمدان بْن جعفر الجنديسابوري /11 /11 وصالح بن أَحْمَدَ بْن أبي مقاتل /11 /11 وأَبُو بكر عَبْد اللَّهِ بْن أبي داود /11 /11 وعَبْد اللَّهِ بْن عُمَر بْن شوذب الواسطي المقرئ /11 /11 وأَبُو نعيم عَبْد الملك بْن مُحَمَّد بْن عدي الحافظ /11 /11 وعبدان بن أَحْمَدَ الأهوازي /11 /11 وأَبُو بشر مُحَمَّد بن أَحْمَدَ بْن حماد الدولابي /11 /11 ومحمد بْن إسحاق الثقفي السراج /11 /11 ومحمد بْن حامد بْن   السَّرِيّ البغدادي المعروف بخال ولد السني /11 /11 ومحمد بْن العباس بْن أيوب الأخرم الأصبهاني /11 /11 ومحمد بْن عَبْد اللَّهِ بْن سُلَيْمَان الحضرمي /11 /11 ومحمد بْن مخلد الدوري /11 /11 والهيثم بْن خلف الدوري /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 ++ قال",
