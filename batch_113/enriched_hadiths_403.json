    {
      "hadith_id": 1014045,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 23491,
      "text_ar": "نزيل مكة من أبناء خراسان كَانَ أحد المذكورين بالعبادة ، والصلاح ، والأمر بالمعروف والنهي عَنِ المنكر . /10 أبان بْن عَبْد اللَّهِ البجلي س /10 /10 وإسرائيل بْن يونس سي /10 /10 وإِسْمَاعِيل بْن مسلم العبدي س /10 /10 وحريز بْن عُثْمَانَ الرحبي /10 /10 والحسن بْن عمارة /10 /10 وداود بْن قيس الفراء /10 /10 وزهير بْن معاوية الجعفي /10 /10 وسَعِيد بْن السائب /10 /10 وسفيان الثوري /10 /10 وسلام بْن مسكين /10 /10 وشعبة بْن الحجاج /10 /10 وصخر بْن جويرية خ /10 /10 وعَبْد العزيز بْن أبي رواد د /10 /10 وعَبْد العزيز بْن عَبْد اللَّهِ بْن أبي سلمة الماجشون س /10 /10 وعُثْمَان بْن واقد /10 /10 وعكرمة بْن عمار س /10 /10 وكامل أبي العلاء /10 /10 ومالك بْن مغول س /10 /10 ومحمد بْن مسلم الطائفي /10 /10 ومسعر بْن كدام عس /10",
      "sanad_ar": "نزيل مكة من أبناء خراسان كَانَ أحد المذكورين بالعبادة",
      "matn_ar": "والصلاح ، والأمر بالمعروف والنهي عَنِ المنكر . /10 أبان بْن عَبْد اللَّهِ البجلي س /10 /10 وإسرائيل بْن يونس سي /10 /10 وإِسْمَاعِيل بْن مسلم العبدي س /10 /10 وحريز بْن عُثْمَانَ الرحبي /10 /10 والحسن بْن عمارة /10 /10 وداود بْن قيس الفراء /10 /10 وزهير بْن معاوية الجعفي /10 /10 وسَعِيد بْن السائب /10 /10 وسفيان الثوري /10 /10 وسلام بْن مسكين /10 /10 وشعبة بْن الحجاج /10 /10 وصخر بْن جويرية خ /10 /10 وعَبْد العزيز بْن أبي رواد د /10 /10 وعَبْد العزيز بْن عَبْد اللَّهِ بْن أبي سلمة الماجشون س /10 /10 وعُثْمَان بْن واقد /10 /10 وعكرمة بْن عمار س /10 /10 وكامل أبي العلاء /10 /10 ومالك بْن مغول س /10 /10 ومحمد بْن مسلم الطائفي /10 /10 ومسعر بْن كدام عس /10",
      "grade": null,
