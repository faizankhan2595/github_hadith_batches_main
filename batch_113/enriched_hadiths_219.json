    {
      "hadith_id": 1011277,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 20723,
      "text_ar": "والخبائر هو ابن سواد بْن عَمْرِو بْن الكلاع بْن شرحبيل بْن حمير /10 أوسط البجلي بخ سي ق /10 /10 وتميم الداري /10 /10 وجبير بْن نفير /10 /10 وشرحبيل بْن السمط د س /10 /10 وأبي أمامة صدي بْن عجلان الباهلي عخ 4 /10 /10 وعَبْد اللَّهِ بْن بسر المازني د ق /10 /10 وعَبْد اللَّهِ بْن الزبير /10 /10 وعَبْد الرَّحْمَنِ بْن عائذ /10 /10 وعَبْد الرَّحْمَنِ بْن قرط الثمالي /10 /10 وعطية بْن بسر د ق /10 /10 وعمرو بْن عبسة د ت س /10 /10 وعوف بْن مالك ق /10 /10 وغضيف بْن الحارث بخ /10 /10 وكثير بْن مرة /10 /10 ومعدي كرب بْن عبد كلال /10 /10 والمقداد بْن الأسود م ت /10 /10 والمقدام بْن معدي كرب /10 /10 وأبي الدرداء /10 /10 وأبي هريرة /10",
