    {
      "hadith_id": 1008475,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 17921,
      "text_ar": "2 الحديث المنكر عَنِ السَّرِيّ بْن إِسْمَاعِيل ما ذكره نُعَيْم بْن عبد الحميد الواسطي ، عَنِ السَّرِيّ ، عَنِ الشعبي ، عَنْ مسروق ، عَنْ عَبْد اللَّهِ بْن مَسْعُود ، قال : كَانَ رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ إذا جاء الشتاء قال : \" مرحبا بالشتاء فيه تنزل البركة ، أما ليله فطويل للقيام ، وأما نهاره فقصير للصيام \"",
      "sanad_ar": "2 الحديث المنكر عَنِ السَّرِيّ بْن إِسْمَاعِيل ما ذكره نُعَيْم بْن عبد الحميد الواسطي",
      "matn_ar": "عَنِ السَّرِيّ ، عَنِ الشعبي ، عَنْ مسروق ، عَنْ عَبْد اللَّهِ بْن مَسْعُود ، قال : كَانَ رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ إذا جاء الشتاء قال : \" مرحبا بالشتاء فيه تنزل البركة ، أما ليله فطويل للقيام ، وأما نهاره فقصير للصيام \"",
