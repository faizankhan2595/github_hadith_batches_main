    {
      "hadith_id": 1012672,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 22118,
      "text_ar": "ويقال : أَبُو زكريا بْن أبي عقيل الواسطي ثم البيروتي , نزيل دمشق من ولد أبي سلام الحبشي /10 إبراهيم بْن أدهم /10 /10 وإبراهيم بْن يزيد الخوزي /10 /10 وبسطام بْن مسلم /10 /10 وسفيان الثوري سي /10 /10 وشعبة بْن الحجاج /10 /10 وعَبْد رب اليشكري البصري /10 /10 وعَبْد الرحمن بْن عَمْرو الأوزاعي س /10 /10 وعَبْد العزيز بْن أبي رواد /10 /10 ومروان بْن سالم /10",
      "sanad_ar": "ويقال",
      "matn_ar": "أَبُو زكريا بْن أبي عقيل الواسطي ثم البيروتي , نزيل دمشق من ولد أبي سلام الحبشي /10 إبراهيم بْن أدهم /10 /10 وإبراهيم بْن يزيد الخوزي /10 /10 وبسطام بْن مسلم /10 /10 وسفيان الثوري سي /10 /10 وشعبة بْن الحجاج /10 /10 وعَبْد رب اليشكري البصري /10 /10 وعَبْد الرحمن بْن عَمْرو الأوزاعي س /10 /10 وعَبْد العزيز بْن أبي رواد /10 /10 ومروان بْن سالم /10",
      "grade": null,
