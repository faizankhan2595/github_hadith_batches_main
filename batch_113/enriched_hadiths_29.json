    {
      "hadith_id": 1008432,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 17878,
      "text_ar": "مروذي الأصل . /10 إِبْرَاهِيم بْن خُثَيْم بْن عراك بْن مَالِك /10 /10 وأَبِي إِسْمَاعِيل إِبْرَاهِيم بْن سُلَيْمَان المؤدب /10 /10 وإسماعيل بْن جَعْفَر م /10 /10 وإسماعيل ابْن علية م /10 /10 وإسماعيل بْن مجالد بْن سَعِيد عس /10 /10 وأصرم بْن غياث /10 /10 وبشر بْن المفضل /10 /10 وحجاج بْن مُحَمَّد م /10 /10 وحميد بْن عَبْد الرَّحْمَنِ الرؤاسي م /10 /10 وخالد بْن نَافِع الأشعري /10 /10 وداود بْن الزبرقان /10 /10 وزكريا بْن منظور القرظي /10 /10 وسفيان بْن عُيَيْنَة /10 /10 وسلم بْن سَالِم الْبَلْخِيّ /10 /10 وأَبِي خَالِد سُلَيْمَان بْن حيان الأحمر /10 /10 وعباد بْن عباد المهلبي م /10 /10 وعباد بْن العوام /10 /10 وعبد الله بْن إِدْرِيس /10 /10 وعبد الله بْن جَعْفَر الْمَدِينِيّ /10 /10 وعبد الله بْن رجاء المكي م س /10 /10 وعبد الرحمن بْن عَبْد الْمَلِكِ بْن أبجر م /10 /10 وعبد الرحمن بْن مهدي /10 /10 وعبد الصمد بْن عَبْد الْوَارِثِ /10 /10 وعبد الوهاب بْن عَطَاء /10 /10 وعبده بْن سُلَيْمَان /10 /10 وعلي بْن ثَابِت الجزري /10 /10 وأَبِي حَفْص عُمَر بْن عَبْد الرَّحْمَنِ الأبار /10 /10 وعمر بْن عُبَيْد الطَّنَافِسِيّ /10 /10 وأَبِي قطن عَمْرو بْن الْهَيْثَم س /10 /10 والفرج بْن فضالة /10 /10 ومحبوب بْن محرز /10 /10 ومحمد بْن عَبْد الرَّحْمَنِ الطفاوي /10 /10 ومحمد بْن يَزِيد الواسطي س /10 /10 ومروان بْن شُجَاع الجزري خ /10 /10 ومروان بْن معاوية الفزاري م /10 /10 وهارون بْن مُسْلِم العجلي /10 /10 وهشيم بْن بشير م س /10 /10 ووكيع بْن الجراح /10 /10 والوليد بْن مُسْلِم /10 /10 ويحيى بْن زكريا بْن أَبِي زائدة م /10 /10 ويحيى بْن سَعِيد الأموي عس /10 /10 ويحيى بْن عَبْد الْمَلِكِ بْن أَبِي غنية س /10 /10 ويزيد بْن هَارُون /10 /10 ويعقوب بْن إِبْرَاهِيم أَبِي يُوسُف الْقَاضِي /10 /10 ويوسف   بْن يَعْقُوب بن الماجشون م /10",
