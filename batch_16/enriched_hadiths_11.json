    {
      "hadith_id": 135158,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 34784,
      "text_ar": "/94 زَيْدُ بْنُ الْحُبَابِ /94 ، عَنْ /26 أُسَامَةَ بْنِ زَيْدٍ /26 ، قال : حَدَّثَنِي /26 إِسْحَاقُ /26 مَوْلَى زَائِدَةَ ، /27 أَنَّ /93 عَائِشَةَ L4049 /93 ، قَالَتْ : /20 \" يَا لَيْتَهَا شَجَرَةٌ تُسَبِّحُ وَتَقْضِي مَا عَلَيْهَا , وَأَنَّهَا لَمْ تُخْلَقْ \" /27 * \r\n$34049  /3",
