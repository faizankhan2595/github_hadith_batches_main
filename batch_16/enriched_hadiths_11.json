      "chapter_id": null,
      "hadith_number": 34778,
      "text_ar": "/94 أَبُو أُسَامَةَ /94 ، عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ /26 ، قَالَ : حَدَّثَنَا /26 الْقَاسِمُ /26 ، /27 عَنْ /93 أَبِي أُمَامَةَ L3929 /93 ، قَالَ : /20 \" مَنْ أَحَبَّ لِلَّهِ وَأَبْغَضَ لِلَّهِ ، وَأَعْطَى لِلَّهِ وَمَنَعَ لِلَّهِ ، فَقَدِ اسْتَكْمَلَ الْإِيمَانَ \" /27 * \r\n$34043  /3",
      "sanad_ar": "/94 أَبُو أُسَامَةَ /94",
      "matn_ar": "عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ /26 ، قَالَ : حَدَّثَنَا /26 الْقَاسِمُ /26 ، /27 عَنْ /93 أَبِي أُمَامَةَ L3929 /93 ، قَالَ : /20 \" مَنْ أَحَبَّ لِلَّهِ وَأَبْغَضَ لِلَّهِ ، وَأَعْطَى لِلَّهِ وَمَنَعَ لِلَّهِ ، فَقَدِ اسْتَكْمَلَ الْإِيمَانَ \" /27 * \r\n$34043  /3",
