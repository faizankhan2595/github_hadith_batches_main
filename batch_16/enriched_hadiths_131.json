    {
      "hadith_id": 136952,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 36578,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، حَدَّثَنَا /26 إِسْمَاعِيلُ بْنُ مُسْلِمٍ الْعَبْدِيُّ L1058 /26 ، حَدَّثَنَا /26 أَبُو الْمُتَوَكِّلِ النَّاجِيِّ L5765 /26 ، /27 عَنْ /93 أَبِي سَعِيدٍ الْخُدْرِيِّ L3260 /93 ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : /20 \" الْبُرُّ بِالْبُرِّ ، وَالشَّعِيرُ بِالشَّعِيرِ ، مِثْلًا بِمِثْلٍ ، يَدًا بِيَدٍ \" /27 ، وَذُكِرَ أَنَّ أَبَا حَنِيفَةَ كَانَ يَقُولُ : \" لَا بَأْسَ بِبَيْعِ الْحِنْطَةِ الْغَائِبَةِ بِعَيْنِهَا بِالْحِنْطَةِ الْحَاضِرَةِ \" * \r\n@ 8 : 429 @\"E5567",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ L8160 /94",
      "matn_ar": "حَدَّثَنَا /26 إِسْمَاعِيلُ بْنُ مُسْلِمٍ الْعَبْدِيُّ L1058 /26 ، حَدَّثَنَا /26 أَبُو الْمُتَوَكِّلِ النَّاجِيِّ L5765 /26 ، /27 عَنْ /93 أَبِي سَعِيدٍ الْخُدْرِيِّ L3260 /93 ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : /20 \" الْبُرُّ بِالْبُرِّ ، وَالشَّعِيرُ بِالشَّعِيرِ ، مِثْلًا بِمِثْلٍ ، يَدًا بِيَدٍ \" /27 ، وَذُكِرَ أَنَّ أَبَا حَنِيفَةَ كَانَ يَقُولُ : \" لَا بَأْسَ بِبَيْعِ الْحِنْطَةِ الْغَائِبَةِ بِعَيْنِهَا بِالْحِنْطَةِ الْحَاضِرَةِ \" * \r\n@ 8 : 429 @\"E5567",
