    {
      "hadith_id": 135048,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 34674,
      "text_ar": "/94 وَكِيعٌ /94 , عَنْ /26 سفيان /26 , عَنْ /26 مَنْصُورٍ /26 , عَنْ /26 سَالِمِ بْنِ أَبِي الْجَعْدِ /26 , /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 , قَالَ : /20 \" لَا يَبْلُغُ عَبْدٌ حَقِيقَةَ الْإِيمَانِ حَتَّى يُعِدَّ النَّاسَ حَمْقَى فِي دِينِهِ \" /27 * \r\n$33942  /3 /141 /94 عَبْدُ اللَّهِ بْنُ نُمَيْرٍ /94 , عَنْ /26 عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 , قَالَ : /27 دَخَلْتُ عَلَى /93 ابْنِ عُمَرَ L4967 /93 فَإِذَا هُوَ /20 مُفْتَرِشٌ ذِرَاعَيْهِ , مُتَوَسِّدٌ وِسَادَةً حَشْوُهَا لِيفٌ \" /27 * \r\n$33943  /3",
      "sanad_ar": "/94 وَكِيعٌ /94 , عَنْ /26 سفيان /26 , عَنْ /26 مَنْصُورٍ /26 , عَنْ /26 سَالِمِ بْنِ أَبِي الْجَعْدِ /26 , /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 , قَالَ",
      "matn_ar": "/20 \" لَا يَبْلُغُ عَبْدٌ حَقِيقَةَ الْإِيمَانِ حَتَّى يُعِدَّ النَّاسَ حَمْقَى فِي دِينِهِ \" /27 * \r\n$33942  /3 /141 /94 عَبْدُ اللَّهِ بْنُ نُمَيْرٍ /94 , عَنْ /26 عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 , قَالَ : /27 دَخَلْتُ عَلَى /93 ابْنِ عُمَرَ L4967 /93 فَإِذَا هُوَ /20 مُفْتَرِشٌ ذِرَاعَيْهِ , مُتَوَسِّدٌ وِسَادَةً حَشْوُهَا لِيفٌ \" /27 * \r\n$33943  /3",
