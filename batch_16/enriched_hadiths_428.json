      "hadith_id": 141412,
      "book_id": 104,
      "chapter_id": null,
      "hadith_number": 1205,
      "text_ar": "يوم السبت آخر يوم من صفر ، وقدم المأمون بغداد يوم الأحد فِي شهر رمضان . وأقام الحج سليمان بْن عَبْد اللَّهِ بْن سليمان بْن عَلِيّ بْن عَبْد اللَّهِ بْن عباس . فِيهَا مات زيد بْن الحباب ، ومحمد بْن بشر ، وحسين بْن عَلِيّ الجعفي ، ويحيى بْن آدم مولى لآل عقبة بْن أَبِي معيط ، ومحمد بْن بَكْر البرساني فِي ذي الحجة ، وأبو أَحْمَد مُحَمَّد بْن عَبْد اللَّهِ الزبيري .\u001bE237",
      "sanad_ar": "يوم السبت آخر يوم من صفر",
      "matn_ar": "وقدم المأمون بغداد يوم الأحد فِي شهر رمضان . وأقام الحج سليمان بْن عَبْد اللَّهِ بْن سليمان بْن عَلِيّ بْن عَبْد اللَّهِ بْن عباس . فِيهَا مات زيد بْن الحباب ، ومحمد بْن بشر ، وحسين بْن عَلِيّ الجعفي ، ويحيى بْن آدم مولى لآل عقبة بْن أَبِي معيط ، ومحمد بْن بَكْر البرساني فِي ذي الحجة ، وأبو أَحْمَد مُحَمَّد بْن عَبْد اللَّهِ الزبيري .\u001bE237",
