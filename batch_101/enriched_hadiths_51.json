    {
      "hadith_id": 900765,
      "book_id": 1083,
      "chapter_id": null,
      "hadith_number": 85,
      "text_ar": "حَدَّثَنَا يَحْيَى بْنُ مَعِينٍ ، قَالَ : حفص بْن غياث روى عَنْ حصين بْن عبد الرحمن النخعي الكاتب ، وحصين بْن عبد الرحمن السلمي . وأما سلم . \r\n$11  11 /2 /143 فحَدَّثَنَا  /94  ابْنُ الأَصْبَهَانِيِّ L6990  /94  ، قَالَ : أنا  /26  شَرِيكٌ L3792  /26  ، عَنْ  /26  سَلْمِ بْنِ عَبْدِ الرَّحْمَنِ النَّخْعِيِّ L3472  /26  ، عَنْ  /26  أَبِي زُرْعَةَ L181  /26  ، /27 عَنْ  /93  أَبِي هُرَيْرَةَ L4396  /93  ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" /20 تَسَمَّوْا بِاسْمِي وَلا تَكَتَنَّوْا بِكُنْيَتِي \" /27  * \r\n$12  12 /2 /143 حَدَّثَنَا  /94  أَبُو نُعَيْمٍ L1548  /94  ، قَالَ : نا  /26  سُفْيَانُ L3436  /26  ، عَنْ  /26  سَلْمِ بْنِ عَبْدِ الرَّحْمَنِ L3472  /26  ، عَنْ  /26  أَبِي زُرْعَةَ L181  /26  ، /27 عَنْ  /93  أَبِي هُرَيْرَةَ L4396  /93  ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 يَكْرَهُ الشِّكَالَ مِنَ الْخَيْلِ \" /27  * \r\n4E8",
      "sanad_ar": "حَدَّثَنَا يَحْيَى بْنُ مَعِينٍ",
      "matn_ar": "قَالَ : حفص بْن غياث روى عَنْ حصين بْن عبد الرحمن النخعي الكاتب ، وحصين بْن عبد الرحمن السلمي . وأما سلم . \r\n$11  11 /2 /143 فحَدَّثَنَا  /94  ابْنُ الأَصْبَهَانِيِّ L6990  /94  ، قَالَ : أنا  /26  شَرِيكٌ L3792  /26  ، عَنْ  /26  سَلْمِ بْنِ عَبْدِ الرَّحْمَنِ النَّخْعِيِّ L3472  /26  ، عَنْ  /26  أَبِي زُرْعَةَ L181  /26  ، /27 عَنْ  /93  أَبِي هُرَيْرَةَ L4396  /93  ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" /20 تَسَمَّوْا بِاسْمِي وَلا تَكَتَنَّوْا بِكُنْيَتِي \" /27  * \r\n$12  12 /2 /143 حَدَّثَنَا  /94  أَبُو نُعَيْمٍ L1548  /94  ، قَالَ : نا  /26  سُفْيَانُ L3436  /26  ، عَنْ  /26  سَلْمِ بْنِ عَبْدِ الرَّحْمَنِ L3472  /26  ، عَنْ  /26  أَبِي زُرْعَةَ L181  /26  ، /27 عَنْ  /93  أَبِي هُرَيْرَةَ L4396  /93  ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 يَكْرَهُ الشِّكَالَ مِنَ الْخَيْلِ \" /27  * \r\n4E8",
