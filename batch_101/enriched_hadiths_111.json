    {
      "hadith_id": 901655,
      "book_id": 1083,
      "chapter_id": null,
      "hadith_number": 975,
      "text_ar": ": \" كان محجوب البصر ، سأل النَّبِيّ عَلَيْهِ السلام أن يأتيه إِلَى منزله فيصلي ففعل \" . \r\n$406  406 /2 /141 حَدَّثَنَا بِذَاكَ  /26  عَلِيُّ بْنُ عَبْدِ الْحَمِيدِ أَبُو الْحُسَيْنِ الْمَعْنِيُّ L5788  /26  ، قَالَ : نَا  /26  سُلَيْمَانُ بْنُ الْمُغِيرَةِ L3570  /26  ، عَنْ  /26  ثَابِتٍ الْبُنَانِيِّ L2009  /26  ، عَنْ  /26  أَنَسِ بْنِ مَالِكٍ L720  /26  ، قَالَ : نَا  /26  مَحْمُودُ بْنُ الرَّبِيعِ L7347  /26  ، /27 عَنْ  /93  عَتْبَانَ بْنِ مَالِكٍ L5459  /93  ، قَالَ : \" /20 أَصَابَنِي فِي بَصَرِي بَعْضُ الشَّيْءِ ، فَقُلْتُ : يَا رَسُولَ اللَّهِ ! إِنَّهُ قَدْ أَصَابَنِي فِي بَصَرِي بَعْضُ الشَّيْءِ ، وَإِنِّي أُحِبُّ أَنْ تَأْتِينِي فَتُصَلِّي فِي مَنْزِلِي فَأَتَّخِذُهُ مُصَلًى . فَفَعَلَ \" /27  * \r\n1687 - \" وشهد مع رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حنينا مسلما \" . أخبرنا بذاك مصعب بن عبد الله . 1688 -",
      "sanad_ar": "",
      "matn_ar": "\" كان محجوب البصر ، سأل النَّبِيّ عَلَيْهِ السلام أن يأتيه إِلَى منزله فيصلي ففعل \" . \r\n$406  406 /2 /141 حَدَّثَنَا بِذَاكَ  /26  عَلِيُّ بْنُ عَبْدِ الْحَمِيدِ أَبُو الْحُسَيْنِ الْمَعْنِيُّ L5788  /26  ، قَالَ : نَا  /26  سُلَيْمَانُ بْنُ الْمُغِيرَةِ L3570  /26  ، عَنْ  /26  ثَابِتٍ الْبُنَانِيِّ L2009  /26  ، عَنْ  /26  أَنَسِ بْنِ مَالِكٍ L720  /26  ، قَالَ : نَا  /26  مَحْمُودُ بْنُ الرَّبِيعِ L7347  /26  ، /27 عَنْ  /93  عَتْبَانَ بْنِ مَالِكٍ L5459  /93  ، قَالَ : \" /20 أَصَابَنِي فِي بَصَرِي بَعْضُ الشَّيْءِ ، فَقُلْتُ : يَا رَسُولَ اللَّهِ ! إِنَّهُ قَدْ أَصَابَنِي فِي بَصَرِي بَعْضُ الشَّيْءِ ، وَإِنِّي أُحِبُّ أَنْ تَأْتِينِي فَتُصَلِّي فِي مَنْزِلِي فَأَتَّخِذُهُ مُصَلًى . فَفَعَلَ \" /27  * \r\n1687 - \" وشهد مع رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حنينا مسلما \" . أخبرنا بذاك مصعب بن عبد الله . 1688 -",
