    {
      "hadith_id": 903655,
      "book_id": 1101,
      "chapter_id": null,
      "hadith_number": 267,
      "text_ar": "$119  119 /3 /141 حَدَّثَنَا /26 ابْنُ بَشَّارٍ /26 ، حَدَّثَنَا /26 مُعَاذُ بْنُ هِشَامٍ /26 ، حَدَّثَنِي /26 أَبِي /26 ، عَنْ /26 قَتَادَة /26 ، عَنِ /26 الحَسَن /26 ، قَالَ : /27 \" /20 أَوَّل مَنْ قَصَّ فِي الْمَسْجِدِ الأْسَوَدُ بْنُ سُرَيْعٍ ، وَكَانَ قَدْ لَقِيَ النَّبِيّ صَلّى اللَّه عَلَيهِ وَسَلّمَ \" /27 * \r\n$120  120 /3 /141 حَدَّثَنِي /26 الحُسَيْن بْنُ بَحْرٍ /26 ، /26 وَإِبْرَاهِيم بْنُ الْحَجَّاجِ /26 ، قَالا : حَدَّثَنَا /26 حَمَّاد /26 ، عَنْ /26 ثَابِتٍ /26 ، /26 وَحُمَيْد /26 ، /26 وَعَلِيَّ بْنُ زَيْدٍ /26 ، عَنْ /26 الحَسَن /26 ، قَالَ : /27 \" /20 أَوَّل مَنْ قَصَّ فِي هَذَا الْمَسْجِدِ الأَسْوَدُ بْنُ سُرَيْعٍ \" /27 * \r\n@ 1 : 176 @",
      "sanad_ar": "$119  119 /3 /141 حَدَّثَنَا /26 ابْنُ بَشَّارٍ /26",
      "matn_ar": "حَدَّثَنَا /26 مُعَاذُ بْنُ هِشَامٍ /26 ، حَدَّثَنِي /26 أَبِي /26 ، عَنْ /26 قَتَادَة /26 ، عَنِ /26 الحَسَن /26 ، قَالَ : /27 \" /20 أَوَّل مَنْ قَصَّ فِي الْمَسْجِدِ الأْسَوَدُ بْنُ سُرَيْعٍ ، وَكَانَ قَدْ لَقِيَ النَّبِيّ صَلّى اللَّه عَلَيهِ وَسَلّمَ \" /27 * \r\n$120  120 /3 /141 حَدَّثَنِي /26 الحُسَيْن بْنُ بَحْرٍ /26 ، /26 وَإِبْرَاهِيم بْنُ الْحَجَّاجِ /26 ، قَالا : حَدَّثَنَا /26 حَمَّاد /26 ، عَنْ /26 ثَابِتٍ /26 ، /26 وَحُمَيْد /26 ، /26 وَعَلِيَّ بْنُ زَيْدٍ /26 ، عَنْ /26 الحَسَن /26 ، قَالَ : /27 \" /20 أَوَّل مَنْ قَصَّ فِي هَذَا الْمَسْجِدِ الأَسْوَدُ بْنُ سُرَيْعٍ \" /27 * \r\n@ 1 : 176 @",
