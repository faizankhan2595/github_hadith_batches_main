    {
      "hadith_id": 567021,
      "book_id": 504,
      "chapter_id": null,
      "hadith_number": 2347,
      "text_ar": "حَدَّثَنَا /94 صَالِحٌ L19515 /94 , قال : ثنا /26 ابْنُ رِشْدِين L10144 /26 َ , قال : ثنا /26 دُحَيْم L4293 /26 ٌ , قال : ثنا /26 سَهْلُ بْنُ هَاشِمٍ L3680 /26 , قال : ثنا /26 سُفْيَانُ L3436 /26 , عَنْ /26 ثَوْرِ بْنِ يَزِيدَ L2058 /26 , عَنْ /26 خَالِدِ بْنِ مَعْدَانَ L2681 /26 , /27 عَنْ /93 ثَوْبَانَ L2055 /93 , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 إِذَا أَهَمَّهُ الشَّيْءُ ، قَالَ : هُوَ اللَّهُ رَبِّي لا شَرِيكَ لَهُ \" /27 * \r\n$1286  /8",
      "sanad_ar": "حَدَّثَنَا /94 صَالِحٌ L19515 /94 , قال",
      "matn_ar": "ثنا /26 ابْنُ رِشْدِين L10144 /26 َ , قال : ثنا /26 دُحَيْم L4293 /26 ٌ , قال : ثنا /26 سَهْلُ بْنُ هَاشِمٍ L3680 /26 , قال : ثنا /26 سُفْيَانُ L3436 /26 , عَنْ /26 ثَوْرِ بْنِ يَزِيدَ L2058 /26 , عَنْ /26 خَالِدِ بْنِ مَعْدَانَ L2681 /26 , /27 عَنْ /93 ثَوْبَانَ L2055 /93 , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 إِذَا أَهَمَّهُ الشَّيْءُ ، قَالَ : هُوَ اللَّهُ رَبِّي لا شَرِيكَ لَهُ \" /27 * \r\n$1286  /8",
