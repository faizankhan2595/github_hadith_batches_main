      "hadith_id": 567020,
      "book_id": 504,
      "chapter_id": null,
      "hadith_number": 2346,
      "text_ar": "حَدَّثَنَـا /94 صَالِحٌ /94 , قال : ثنا ابْنُ النُّعْمَانِ , قال : ثنا /26 مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ /26 , قال : /27 سَمِعْتُ /26 مَعْرُوفًا /26 , يَقُولُ : \" /20 اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ طُولِ أَمَلٍ يَمْنَعُ مِنْ خَيْرِ الْعَمَلِ \" /27 * \r\n$1285  /2",
      "sanad_ar": "حَدَّثَنَـا /94 صَالِحٌ /94 , قال",
      "matn_ar": "ثنا ابْنُ النُّعْمَانِ , قال : ثنا /26 مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ /26 , قال : /27 سَمِعْتُ /26 مَعْرُوفًا /26 , يَقُولُ : \" /20 اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ طُولِ أَمَلٍ يَمْنَعُ مِنْ خَيْرِ الْعَمَلِ \" /27 * \r\n$1285  /2",
