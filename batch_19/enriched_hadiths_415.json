    {
      "hadith_id": 168214,
      "book_id": 127,
      "chapter_id": null,
      "hadith_number": 45,
      "text_ar": "حَدَّثَنَا /94 أَبُو الأَحْوَصِ L3457 /94 ، عَنْ /26 عَطَاءِ بْنِ السَّائِبِ L5629 /26 , /27 عَنْ /26 مَيْسَرَةَ L7800 /26 , قَالَ : /20 \" خَلَقَ اللَّهُ تَبَارَكَ وَتَعَالَى بِيَدِهِ أَرْبَعَةً : خَلَقَ آدَمَ بِيَدِهِ , وَاللَّوْحَ وَالْقَلَمَ بِيَدِهِ , وَغَرَسَ جَنَّةَ عَدْنٍ بِيَدِهِ , ثُمَّ قَالَ : /4 قَدْ أَفْلَحَ الْمُؤْمِنُونَ سورة المؤمنون آية 1 /4 \" , وَقَالَ : الرَّابِعَةُ أَغْفَلَهَا /27 * \r\n@ 1 : 66 @ \r\n$44  44 /8",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو الأَحْوَصِ L3457 /94",
      "matn_ar": "عَنْ /26 عَطَاءِ بْنِ السَّائِبِ L5629 /26 , /27 عَنْ /26 مَيْسَرَةَ L7800 /26 , قَالَ : /20 \" خَلَقَ اللَّهُ تَبَارَكَ وَتَعَالَى بِيَدِهِ أَرْبَعَةً : خَلَقَ آدَمَ بِيَدِهِ , وَاللَّوْحَ وَالْقَلَمَ بِيَدِهِ , وَغَرَسَ جَنَّةَ عَدْنٍ بِيَدِهِ , ثُمَّ قَالَ : /4 قَدْ أَفْلَحَ الْمُؤْمِنُونَ سورة المؤمنون آية 1 /4 \" , وَقَالَ : الرَّابِعَةُ أَغْفَلَهَا /27 * \r\n@ 1 : 66 @ \r\n$44  44 /8",
