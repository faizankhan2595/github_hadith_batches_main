    {
      "hadith_id": 484088,
      "book_id": 442,
      "chapter_id": null,
      "hadith_number": 838,
      "text_ar": "واستخلف الْحَسَن بْن عبد الرحمن بْن إِسْحَاق ، فأقام أيَّامًا ثمَّ مرِض ، فصرفه ، وردّ أمر الحُكم إلى ابن الحدَّاد باتّفاق الشهود عَلَى ذَلكَ ، وخرج ابن هَرَوان وسلَّم الأمر إلى ابن الحدَّاد ، وبشَّره ، ووصله ، وأكرمه .",
      "sanad_ar": "واستخلف الْحَسَن بْن عبد الرحمن بْن إِسْحَاق",
      "matn_ar": "فأقام أيَّامًا ثمَّ مرِض ، فصرفه ، وردّ أمر الحُكم إلى ابن الحدَّاد باتّفاق الشهود عَلَى ذَلكَ ، وخرج ابن هَرَوان وسلَّم الأمر إلى ابن الحدَّاد ، وبشَّره ، ووصله ، وأكرمه .",
