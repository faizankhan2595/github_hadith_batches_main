      "hadith_id": 1021403,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 30849,
      "text_ar": "0 /11 إِبْرَاهِيم بْن عمر بْن كيسان عس /11 /11 وداود بْن قيس /11 /11 وأَبُو الهذيل عمران بْن عَبْدِ الرَّحْمَنِ بْن هربذ الصنعانيون /11 ++ قال عباس الدوري ، عَنْ يَحْيَى بْن معين : عَبْد اللَّهِ بْن وهب بْن منبه أقدم من عَبْد الرَّحْمَنِ بْن وهب بْن منبه . # وقال أَبُو عبيد الآجري ، عَنْ أَبِي دَاوُدَ : معروف . ++ روى له النَّسَائِيّ فِي مسند عَلَى حديثا يأتي ذكره فِي ترجمة أبي خليفة ، إن شاء اللَّه تعالى . @ 4427 [ 3647 ] س",
      "sanad_ar": "0 /11 إِبْرَاهِيم بْن عمر بْن كيسان عس /11 /11 وداود بْن قيس /11 /11 وأَبُو الهذيل عمران بْن عَبْدِ الرَّحْمَنِ بْن هربذ الصنعانيون /11 ++ قال عباس الدوري",
      "matn_ar": "عَنْ يَحْيَى بْن معين : عَبْد اللَّهِ بْن وهب بْن منبه أقدم من عَبْد الرَّحْمَنِ بْن وهب بْن منبه . # وقال أَبُو عبيد الآجري ، عَنْ أَبِي دَاوُدَ : معروف . ++ روى له النَّسَائِيّ فِي مسند عَلَى حديثا يأتي ذكره فِي ترجمة أبي خليفة ، إن شاء اللَّه تعالى . @ 4427 [ 3647 ] س",
