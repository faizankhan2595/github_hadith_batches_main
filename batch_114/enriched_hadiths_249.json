    {
      "hadith_id": 1020730,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 30176,
      "text_ar": "0 /11 الأبيض بْن الأغر /11 /11 وإِسْمَاعِيل بْن عياش /11 /11 وبقية بْن الوليد ق /11 /11 وحاتم بْن إِسْمَاعِيلَ /11 /11 وخارجة بْن مصعب /11 /11 وسفيان الثوري وهُوَ من أقرانه /11 /11 وعَبْد الرَّحْمَنِ بْن سليمان بْن أبي الجون /11 /11 وعَبْد الرَّزَّاقِ بْن همام /11 /11 وعلي بْن ثابت الجزري /11 /11 وعلي بْن هاشم بْن البريد /11 /11 وغياث بْن إِبْرَاهِيمَ النَّخَعِيّ /11 /11 وأَبُو نعيم الفضل بْن دكين /11 /11 ومبشر بْن إِسْمَاعِيلَ الحلبي /11 /11 ومُحَمَّد بْن حمير /11 /11 ومروان بْن معاوية /11 /11 ومندل بْن عَلِيّ /11 /11 وهريم بْن سفيان /11 /11 ويحيى بْن عَبْدِ اللَّهِ البابلتي الحراني /11 /11 وأَبُو يُوسُفَ القاضي /11 ++ قال هلال بْن العلاء الرَّقِّيّ : ولاه أَبُو جَعْفَر قضاء الرقة وهُوَ مولى بني عقيل . ++ وقال حمدان بْن عَلِيّ الوراق عَنْ أَحْمَدَ بْنِ حَنْبَلٍ : ترك الناس حديثه . # وقال معاوية بْن صالح ، عَنْ يَحْيَى بْن معين : ضعيف . #",
      "sanad_ar": "0 /11 الأبيض بْن الأغر /11 /11 وإِسْمَاعِيل بْن عياش /11 /11 وبقية بْن الوليد ق /11 /11 وحاتم بْن إِسْمَاعِيلَ /11 /11 وخارجة بْن مصعب /11 /11 وسفيان الثوري وهُوَ من أقرانه /11 /11 وعَبْد الرَّحْمَنِ بْن سليمان بْن أبي الجون /11 /11 وعَبْد الرَّزَّاقِ بْن همام /11 /11 وعلي بْن ثابت الجزري /11 /11 وعلي بْن هاشم بْن البريد /11 /11 وغياث بْن إِبْرَاهِيمَ النَّخَعِيّ /11 /11 وأَبُو نعيم الفضل بْن دكين /11 /11 ومبشر بْن إِسْمَاعِيلَ الحلبي /11 /11 ومُحَمَّد بْن حمير /11 /11 ومروان بْن معاوية /11 /11 ومندل بْن عَلِيّ /11 /11 وهريم بْن سفيان /11 /11 ويحيى بْن عَبْدِ اللَّهِ البابلتي الحراني /11 /11 وأَبُو يُوسُفَ القاضي /11 ++ قال هلال بْن العلاء الرَّقِّيّ",
      "matn_ar": "ولاه أَبُو جَعْفَر قضاء الرقة وهُوَ مولى بني عقيل . ++ وقال حمدان بْن عَلِيّ الوراق عَنْ أَحْمَدَ بْنِ حَنْبَلٍ : ترك الناس حديثه . # وقال معاوية بْن صالح ، عَنْ يَحْيَى بْن معين : ضعيف . #",
      "grade": null,
