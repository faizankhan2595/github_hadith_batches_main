    {
      "hadith_id": 1017022,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 26468,
      "text_ar": "ويقال : اسمه كنيته وهُوَ أَخُو عَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ بْن مَسْعُود /10 البراء بْن عازب سي /10 /10 وأبيه عَبْد اللَّهِ بْن مَسْعُود 4 , ولَمْ يسمع منه /10 /10 وعَمْرو بْن الْحَارِث بْن المصطلق خ م س /10 /10 وكعب بْن عجرة م س /10 /10 ومسروق بْن الأجدع /10 /10 وأبي موسى الأشعري م س ق /10 /10 وأمه زينب الثقفية /10 /10 وعائشة أم الْمُؤْمِنيِنَ خ س /10",
      "sanad_ar": "ويقال",
      "matn_ar": "اسمه كنيته وهُوَ أَخُو عَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ بْن مَسْعُود /10 البراء بْن عازب سي /10 /10 وأبيه عَبْد اللَّهِ بْن مَسْعُود 4 , ولَمْ يسمع منه /10 /10 وعَمْرو بْن الْحَارِث بْن المصطلق خ م س /10 /10 وكعب بْن عجرة م س /10 /10 ومسروق بْن الأجدع /10 /10 وأبي موسى الأشعري م س ق /10 /10 وأمه زينب الثقفية /10 /10 وعائشة أم الْمُؤْمِنيِنَ خ س /10",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10",
      "created_at": "2025-11-04 07:50:02",
      "book": {
