    {
      "hadith_id": 1017501,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 26947,
      "text_ar": "/10 إِبْرَاهِيم بْن مُحَمَّد بْن أَبِي يَحْيَى الأسلمي /10 /10 وإسماعيل بْن عياش /10 /10 وثابت بْن الْوَلِيد بْن عَبْد اللَّهِ بْن جَمِيع /10 /10 وحاتم بْن إِسْمَاعِيل المدني /10 /10 والحسين بْن زَيْد بْن عَلِي العلوي ق /10 /10 والحكم بْن ظهير /10 /10 وحماد بْن عيسى العبسي /10 /10 وحنان بْن سدير بْن حَكِيم بْن صهيب الصَّيْرَفِي /10 /10 وسلم بْن الْمُغِيرَة الكوفي /10 /10 وشريك بْن عَبْد اللَّهِ النخعي /10 /10 وعباد بْن العوام خ /10 /10 وعبد اللَّه بْن عَبْد القدوس ت /10 /10 وأبي عَبْد الرَّحْمَنِ عَبْد اللَّهِ بْن عَبْد الْمَلِك بْن أَبِي عُبَيْدَة بْن عَبْد اللَّهِ بْن مَسْعُود المسعودي /10 /10 وعَبْد الرَّحْمَنِ بْن مُحَمَّد بْن عبيد اللَّه العرزمي /10 /10 وعبيد بْن مُحَمَّد بْن قَيْس البجلي /10 /10 وعلي بْن عابس الأسدي /10 /10 وعلي بْن هاشم بْن البريد /10 /10 وعَمْرو بْن أَبِي المقدام ثابت بْن هرمز /10 /10 وعيسى بْن راشد الكوفي /10 /10 وعيسى بْن عَبْد الرَّحْمَنِ شيخ يَرْوِي عَنْ : أبيه عَن جده عَن عَلِي /10 /10 والقاسم بْن مُحَمَّد بْن عَبْد اللَّهِ بْن مُحَمَّد بْن عقيل /10 /10 ومُحَمَّد بْن الفضل بْن عطية ت /10 /10 ومُحَمَّد بْن فضل بْن غزوان /10 /10 وموسى بْن عمير الْقُرَشِي /10 /10 والوليد بْن أَبِي ثور ت /10 /10 وأبي المحياة يَحْيَى بْن يعلى التَّيْمِي /10 /10 ويَحْيَى بْن يعلى الأسلمي /10 /10 ويونس بْن أَبِي يعفور العبدي /10",
      "sanad_ar": "/10 إِبْرَاهِيم بْن مُحَمَّد بْن أَبِي يَحْيَى الأسلمي /10 /10 وإسماعيل بْن عياش /10 /10 وثابت بْن الْوَلِيد بْن عَبْد اللَّهِ بْن جَمِيع /10 /10 وحاتم بْن إِسْمَاعِيل المدني /10 /10 والحسين بْن زَيْد بْن عَلِي العلوي ق /10 /10 والحكم بْن ظهير /10 /10 وحماد بْن عيسى العبسي /10 /10 وحنان بْن سدير بْن حَكِيم بْن صهيب الصَّيْرَفِي /10 /10 وسلم بْن الْمُغِيرَة الكوفي /10 /10 وشريك بْن عَبْد اللَّهِ النخعي /10 /10 وعباد بْن العوام خ /10 /10 وعبد اللَّه بْن عَبْد القدوس ت /10 /10 وأبي عَبْد الرَّحْمَنِ عَبْد اللَّهِ بْن عَبْد الْمَلِك بْن أَبِي عُبَيْدَة بْن عَبْد اللَّهِ بْن مَسْعُود المسعودي /10 /10 وعَبْد الرَّحْمَنِ بْن مُحَمَّد بْن عبيد اللَّه العرزمي /10 /10 وعبيد بْن مُحَمَّد بْن قَيْس البجلي /10 /10 وعلي بْن عابس الأسدي /10 /10 وعلي بْن هاشم بْن البريد /10 /10 وعَمْرو بْن أَبِي المقدام ثابت بْن هرمز /10 /10 وعيسى بْن راشد الكوفي /10 /10 وعيسى بْن عَبْد الرَّحْمَنِ شيخ يَرْوِي عَنْ",
      "matn_ar": "أبيه عَن جده عَن عَلِي /10 /10 والقاسم بْن مُحَمَّد بْن عَبْد اللَّهِ بْن مُحَمَّد بْن عقيل /10 /10 ومُحَمَّد بْن الفضل بْن عطية ت /10 /10 ومُحَمَّد بْن فضل بْن غزوان /10 /10 وموسى بْن عمير الْقُرَشِي /10 /10 والوليد بْن أَبِي ثور ت /10 /10 وأبي المحياة يَحْيَى بْن يعلى التَّيْمِي /10 /10 ويَحْيَى بْن يعلى الأسلمي /10 /10 ويونس بْن أَبِي يعفور العبدي /10",
      "grade": null,
