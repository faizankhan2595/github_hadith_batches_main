      "hadith_id": 1024494,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 33940,
      "text_ar": "أخبرنا بِهِ /94 أَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، قال : أنبأنا /26 مُحَمَّدُ بْنُ أَبِي زَيْدٍ الْكَرَّانِيُّ L75048 /26 ، قال : أخبرنا /26 مَحْمُودُ بْنُ إِسْمَاعِيلَ الصَّيْرَفِيُّ L31136 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ شَاذَانَ الأَعْرَجُ L44975 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ فُورَكٍ الْقَبَّابُ L44949 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ أَبِي عَاصِمٍ L10084 /26 ، قال : حدثنا /26 الْحَسَنُ بْنُ الصَّبَّاحِ L1254 /26 ، قال : حدثنا /26 يَحْيَى بْنُ عَبَّادٍ L8282 /26 ، قال : حدثنا /26 يَحْيَى بْنُ عَبْدِ الْعَزِيزِ L8292 /26 ، عَنْ /26 عَبْدِ الْعَزِيزِ بْنِ يَحْيَى L21411 /26 ، قال : حدثنا /26 سَعِيدُ بْنُ صَفْوَانَ L18006 /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ الْمُغِيرَةِ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي بُرْدَةَ L1650 /26 ، قال : /27 سمعت /93 عَبْدَ اللَّهِ بْنَ عَمْرٍو L4980 /93 ، يَقُولُ : قال رَسُولُ اللَّهِ صلى الله عليه وسلم : \" /20 الشَّهَادَةُ تُكَفِّرُ كُلَّ شَيْءٍ إِلا الدَّيْنَ ، والْغَرَقُ يُكَفِّرُ ذَلِكَ كُلَّهُ \" /27 * \r\n++ ذكرناهم للتمييز بينهم . @ 4990 [ 3484 ] د?E3102",
