    {
      "hadith_id": 1018518,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 27964,
      "text_ar": "واسمه قَيْس بْن دِينَار الأسدي مولاهم الكوفي /10 إياس بْن مُعَاوِيَة بْن قرة المزني /10 /10 وأبيه حبيب بْن أَبِي ثابت /10 /10 وحسان بْن أَبِي الأشرس /10 /10 وحمزة بْن عَبْد اللَّهِ ص /10 /10 وسعيد بْن جُبَيْر /10 /10 وطاوس بْن كيسان /10 /10 وعامر الشَّعْبِي /10 /10 وعبد اللَّه بْن عَبْد الرحمن بْن أَبِي حسين م /10 /10 وعطاء بْن أَبِي رباح /10 /10 والقاسم بْن أَبِي بزة الْمَكِّي /10 /10 وأبي جَعْفَر مُحَمَّد بْن عَلِي بْن الْحُسَيْن /10 /10 ومُحَمَّد بْن كعب القرظي /10 /10 وأبي بَكْر بْن عبيد اللَّه بْن أَبِي مليكة /10",
