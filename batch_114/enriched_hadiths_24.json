    {
      "hadith_id": 1017353,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 26799,
      "text_ar": "سكن مَكَّة ، وكَانَ متعبدا /10 إدريس بْن سنان /10 /10 وإسحاق بْن عَبْد اللَّهِ بْن أَبِي طلحة /10 /10 وأيوب السختياني /10 /10 وثابت البناني /10 /10 والحسن بْن ذكوان البصري /10 /10 وزيد بْن عَلِي بْن الْحُسَيْن بْن عَلِي بْن أَبِي طَالِب /10 /10 وسعيد الجريري /10 /10 وسُفْيَان الثَّوْرِي وهُوَ من أقرانه /10 /10 وعبد اللَّه بْن طاوس /10 /10 وعبد اللَّه بْن مُحَمَّد بْن عقيل /10 /10 وعقيل بْن خَالِد /10 /10 وعَمْرو بْن خَالِد الواسطي ق /10 /10 وعَمْرو بْن أَبِي عَمْرو مولى المطلب بْن عَبْد اللَّهِ بْن حنطب /10 /10 والعلاء بْن عَبْد الرَّحْمَنِ د /10 /10 ومالك بْن دِينَار /10 /10 ومُحَمَّد بْن واسع /10 /10 وهِشَام بْن عروة /10 /10 ويَحْيَى بْن الْحَارِث الذماري /10 /10 ويَحْيَى بْن أَبِي كثير ق /10 /10 وأبي الزُّبَيْر الْمَكِّي /10 /10 وأبي الزناد /10 /10 وأبي عَبْد اللَّهِ الشقري /10 /10 وأبي عمران الجوني /10",
      "sanad_ar": "سكن مَكَّة",
      "matn_ar": "وكَانَ متعبدا /10 إدريس بْن سنان /10 /10 وإسحاق بْن عَبْد اللَّهِ بْن أَبِي طلحة /10 /10 وأيوب السختياني /10 /10 وثابت البناني /10 /10 والحسن بْن ذكوان البصري /10 /10 وزيد بْن عَلِي بْن الْحُسَيْن بْن عَلِي بْن أَبِي طَالِب /10 /10 وسعيد الجريري /10 /10 وسُفْيَان الثَّوْرِي وهُوَ من أقرانه /10 /10 وعبد اللَّه بْن طاوس /10 /10 وعبد اللَّه بْن مُحَمَّد بْن عقيل /10 /10 وعقيل بْن خَالِد /10 /10 وعَمْرو بْن خَالِد الواسطي ق /10 /10 وعَمْرو بْن أَبِي عَمْرو مولى المطلب بْن عَبْد اللَّهِ بْن حنطب /10 /10 والعلاء بْن عَبْد الرَّحْمَنِ د /10 /10 ومالك بْن دِينَار /10 /10 ومُحَمَّد بْن واسع /10 /10 وهِشَام بْن عروة /10 /10 ويَحْيَى بْن الْحَارِث الذماري /10 /10 ويَحْيَى بْن أَبِي كثير ق /10 /10 وأبي الزُّبَيْر الْمَكِّي /10 /10 وأبي الزناد /10 /10 وأبي عَبْد اللَّهِ الشقري /10 /10 وأبي عمران الجوني /10",
