      "hadith_number": 35378,
      "text_ar": "2 ++ قال أَبُو حاتم : سمعت منه سنة ثَلاث عشرة ومائتين . ++ وقال مُحَمَّد بْن سَعْد ، وخليفة بْن خياط ، والبخاري : مَاتَ سنة ثَلاث عشرة ومائتين . ++ قال ابْن سَعْد : فِي ذي القعدة . ++ وقال غيره : فِي شوال . ++ وقال يَعْقُوب بْن سُفْيَان : مَاتَ سنة أربع عشرة ومائتين . ++ قال أَبُو بَكْر الخطيب : حدث عَنْهُ خَالِد بْن حميد المهري ، ومحمد بْن يُونُس الكديمي ، وبين وفاتيهما مائة وسبع عشرة سنة . ++ روى له الْجَمَاعَة . ++ \r\n$2090  -10 /2",
      "sanad_ar": "2 ++ قال أَبُو حاتم",
      "matn_ar": "سمعت منه سنة ثَلاث عشرة ومائتين . ++ وقال مُحَمَّد بْن سَعْد ، وخليفة بْن خياط ، والبخاري : مَاتَ سنة ثَلاث عشرة ومائتين . ++ قال ابْن سَعْد : فِي ذي القعدة . ++ وقال غيره : فِي شوال . ++ وقال يَعْقُوب بْن سُفْيَان : مَاتَ سنة أربع عشرة ومائتين . ++ قال أَبُو بَكْر الخطيب : حدث عَنْهُ خَالِد بْن حميد المهري ، ومحمد بْن يُونُس الكديمي ، وبين وفاتيهما مائة وسبع عشرة سنة . ++ روى له الْجَمَاعَة . ++ \r\n$2090  -10 /2",
