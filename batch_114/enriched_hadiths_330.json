    {
      "hadith_id": 1021945,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 31391,
      "text_ar": "أخبرنا بِهِ /94 أَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، قال : أخبرنا الإِمَامُ /26 أَبُو حَفْصٍ عُمَرُ بْنُ مُحَمَّدٍ السُّهْرَوَرْدِيُّ L46203 /26 ، قَدِمَ عَلَيْنَا دِمَشْقَ ، قال : أخبرنا /26 أَبُو الْمَعْمَرِ عَبْدُ اللَّهِ بْنُ سَعْدِ بْنِ الْهَاطرِ الْمَعْرُوفُ L65871 /26 ، بِخُزَيْفَةَ ، قال : أخبرنا /26 أَبُو الْفَضْلِ أَحْمَدُ بْنُ الْحَسَنِ بْنِ خَيْرُونَ L9601 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ شَاذَانَ الْبَزَّازُ L14773 /26 ، قال : أخبرنا /26 أَبُو مُحَمَّدٍ عَبْدُ اللَّهِ بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ الْخُرَاسَانِيِّ L21959 /26 ، قال : حدثنا /26 إِبْرَاهِيمُ بْنُ الْهَيْثَمِ L11265 /26 ، قال : حدثنا /26 عَبْدُ الْحَمِيدِ بْنِ عُمَرَ الذُّهْلِيُّ L20444 /26 ، قال : حدثنا /26 سُفْيَانُ L3436 /26 ، عَنِ /26 الزُّهْرِيِّ L7272 /26 ، /27 عَنْ /93 أَنَسِ بْنِ مَالِكٍ L720 /93 ، قال : قال رَسُولُ اللَّهِ صلى الله عليه وسلم : /20 \" الْمَرْءُ مَعَ مَنْ أَحَبَّ \" /27 * \r\n@ 4533 عبد الحميد بْن كرديد هُوَ ابْن دينار تقدم @ 4534 [ 3727 ] س",
