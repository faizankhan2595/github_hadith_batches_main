    {
      "hadith_id": 1017666,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 27112,
      "text_ar": "0 /11 ابنه أَبِي بْن عَبَّاس بْن سهل بْن سَعْد خ /11 /11 وحازم بْن تمام /11 /11 وسعد بْن سَعِيد الأَنْصَارِي /11 /11 وشبل بْن عباد الْمَكِّي /11 /11 وعبد اللَّه بْن عُمَر العمري /11 /11 وعبد اللَّه بْن عيسى د ، ويقال : عيسى بْن عَبْد اللَّهِ /11 /11 وعبد الحكيم بْن عَبْد اللَّهِ بْن أَبِي فروة /11 /11 وعَبْد الرَّحْمَنِ بْن سُلَيْمَان بْن الغسيل خ /11 /11 وابنه عَبْد المهيمن بْن عَبَّاس بْن سهل بْن سَعْد ت ق /11 /11 وعتبة بْن أَبِي حَكِيم إِن كَانَ محفوظا /11 /11 وعمارة بْن غزية خت /11 /11 وعَمْرو بْن يَحْيَى بْن عُمَارَة خ م د /11 /11 والعلاء بْن عَبْد الرحمن م /11 /11 وفليح بْن سُلَيْمَان د ت ق /11 /11 ومُحَمَّد بْن إِسْحَاق ي د /11 /11 ومُحَمَّد بْن أَبِي حميد المدني /11 /11 ومُحَمَّد بْن عَبْد الرحمن بْن أَبِي ذئب /11 /11 ومُحَمَّد بْن عَمْرو بْن عَطَاء د /11 /11 ومُحَمَّد بْن أَبِي يَحْيَى الأسلمي   /11   # قال",
      "sanad_ar": "0 /11 ابنه أَبِي بْن عَبَّاس بْن سهل بْن سَعْد خ /11 /11 وحازم بْن تمام /11 /11 وسعد بْن سَعِيد الأَنْصَارِي /11 /11 وشبل بْن عباد الْمَكِّي /11 /11 وعبد اللَّه بْن عُمَر العمري /11 /11 وعبد اللَّه بْن عيسى د",
      "matn_ar": "ويقال : عيسى بْن عَبْد اللَّهِ /11 /11 وعبد الحكيم بْن عَبْد اللَّهِ بْن أَبِي فروة /11 /11 وعَبْد الرَّحْمَنِ بْن سُلَيْمَان بْن الغسيل خ /11 /11 وابنه عَبْد المهيمن بْن عَبَّاس بْن سهل بْن سَعْد ت ق /11 /11 وعتبة بْن أَبِي حَكِيم إِن كَانَ محفوظا /11 /11 وعمارة بْن غزية خت /11 /11 وعَمْرو بْن يَحْيَى بْن عُمَارَة خ م د /11 /11 والعلاء بْن عَبْد الرحمن م /11 /11 وفليح بْن سُلَيْمَان د ت ق /11 /11 ومُحَمَّد بْن إِسْحَاق ي د /11 /11 ومُحَمَّد بْن أَبِي حميد المدني /11 /11 ومُحَمَّد بْن عَبْد الرحمن بْن أَبِي ذئب /11 /11 ومُحَمَّد بْن عَمْرو بْن عَطَاء د /11 /11 ومُحَمَّد بْن أَبِي يَحْيَى الأسلمي   /11   # قال",
      "grade": null,
