    {
      "hadith_id": 1018265,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 27711,
      "text_ar": "، ويقال أَبُو بَكْر المدني /10 أَنَس بْن مَالِك خ م ت س /10 /10 وحبيب بْن هند بْن أسماء الأسلمي /10 /10 وحميد بْن نَافِع خ م د ت س /10 /10 وسالم بْن عَبْد اللَّهِ بْن عُمَر س ق /10 /10 وسليمان بْن يسار س /10 /10 وصالح بْن خوات بْن صَالِح بْن خوات بْن جُبَيْر /10 /10 وعباد بْن تميم الأَنْصَارِي خ م د س ق /10 /10 وأبي الزناد عَبْد اللَّهِ بْن ذكوان وهُوَ من أقرانه /10 /10 وعبد اللَّه بْن عَامِر بْن ربيعة /10 /10 وعبد اللَّه بْن واقد بْن عَبْد اللَّهِ بْن عُمَر بْن الْخَطَّاب م /10 /10 وعَبْد الرَّحْمَنِ بْن أبان بْن عُثْمَان بْن عَفَّان /10 /10 وعبد الْمَلِك بْن أَبِي بَكْر بْن عَبْد الرحمن بْن الْحَارِث بْن هِشَام م 4 /10 /10 وعثمان بْن أَبِي سُلَيْمَان بْن جُبَيْر بْن مطعم /10 /10 وعروة بْن الزُّبَيْر خ م د ت س /10 /10 وعلي بْن عَبْد اللَّهِ بْن عَبَّاس /10 /10 وعمر بْن سليم الزرقي /10 /10 وأبي جَعْفَر مُحَمَّد بْن عَلِي بْن الْحُسَيْن ت /10 /10 ومُحَمَّد بْن مُسْلِم بْن شهاب الزُّهْرِي د ت س /10 /10 ويَحْيَى بْن عباد بْن عَبْد اللَّهِ بْن الزُّبَيْر /10 /10 ويَحْيَى بْن عَبْد اللَّهِ بْن عَبْد الرحمن بْن سَعْد بْن زرارة م د /10 /10 ويعقوب بْن عَبْد اللَّهِ بْن أَبِي طَلْحَة /10 /10 وأبيه أَبِي بَكْر بْن مُحَمَّد بْن عَمْرو بْن حزم ع /10 /10 وخالة أَبِيهِ عمرة بنت عَبْد الرحمن ع /10 /10 وأم عيسى الجزار ق /10",
      "sanad_ar": "",
      "matn_ar": "ويقال أَبُو بَكْر المدني /10 أَنَس بْن مَالِك خ م ت س /10 /10 وحبيب بْن هند بْن أسماء الأسلمي /10 /10 وحميد بْن نَافِع خ م د ت س /10 /10 وسالم بْن عَبْد اللَّهِ بْن عُمَر س ق /10 /10 وسليمان بْن يسار س /10 /10 وصالح بْن خوات بْن صَالِح بْن خوات بْن جُبَيْر /10 /10 وعباد بْن تميم الأَنْصَارِي خ م د س ق /10 /10 وأبي الزناد عَبْد اللَّهِ بْن ذكوان وهُوَ من أقرانه /10 /10 وعبد اللَّه بْن عَامِر بْن ربيعة /10 /10 وعبد اللَّه بْن واقد بْن عَبْد اللَّهِ بْن عُمَر بْن الْخَطَّاب م /10 /10 وعَبْد الرَّحْمَنِ بْن أبان بْن عُثْمَان بْن عَفَّان /10 /10 وعبد الْمَلِك بْن أَبِي بَكْر بْن عَبْد الرحمن بْن الْحَارِث بْن هِشَام م 4 /10 /10 وعثمان بْن أَبِي سُلَيْمَان بْن جُبَيْر بْن مطعم /10 /10 وعروة بْن الزُّبَيْر خ م د ت س /10 /10 وعلي بْن عَبْد اللَّهِ بْن عَبَّاس /10 /10 وعمر بْن سليم الزرقي /10 /10 وأبي جَعْفَر مُحَمَّد بْن عَلِي بْن الْحُسَيْن ت /10 /10 ومُحَمَّد بْن مُسْلِم بْن شهاب الزُّهْرِي د ت س /10 /10 ويَحْيَى بْن عباد بْن عَبْد اللَّهِ بْن الزُّبَيْر /10 /10 ويَحْيَى بْن عَبْد اللَّهِ بْن عَبْد الرحمن بْن سَعْد بْن زرارة م د /10 /10 ويعقوب بْن عَبْد اللَّهِ بْن أَبِي طَلْحَة /10 /10 وأبيه أَبِي بَكْر بْن مُحَمَّد بْن عَمْرو بْن حزم ع /10 /10 وخالة أَبِيهِ عمرة بنت عَبْد الرحمن ع /10 /10 وأم عيسى الجزار ق /10",
