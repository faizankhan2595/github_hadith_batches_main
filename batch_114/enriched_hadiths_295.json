    {
      "hadith_id": 1021417,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 30863,
      "text_ar": "ويقال اسمه عباد بْن يَحْيَى, ويقال عباد بْن يَحْيَى ولد هُوَ وأخ لَهُ فِي بطن واحد فقيل لَهُ التوءم وقيل إنهم ، كانوا إخوه ولدوا فِي بطن واحد /10 جَعْفَر بْن مُحَمَّد بْن عَلِيّ /10 /10 وعَبْد اللَّهِ بْن أبي مليكة د ق /10 /10 وعبد الملك بْن عمير /10 /10 وعبيد اللَّه بْن غلاب /10",
      "sanad_ar": "ويقال اسمه عباد بْن يَحْيَى, ويقال عباد بْن يَحْيَى ولد هُوَ وأخ لَهُ فِي بطن واحد فقيل لَهُ التوءم وقيل إنهم",
      "matn_ar": "كانوا إخوه ولدوا فِي بطن واحد /10 جَعْفَر بْن مُحَمَّد بْن عَلِيّ /10 /10 وعَبْد اللَّهِ بْن أبي مليكة د ق /10 /10 وعبد الملك بْن عمير /10 /10 وعبيد اللَّه بْن غلاب /10",
