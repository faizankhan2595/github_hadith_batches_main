      "hadith_id": 1018810,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 28256,
      "text_ar": "ويقال الأسدي أَبُو مُحَمَّد الشامي الحمصي ، ويقال إنه دمشقي ، والصحيح أَنَّهُ حمصي /10 حريز ق ويقال : ابْن أَبِي حريز مولى مُعَاوِيَة /10 /10 وعطاء بْن أَبِي رباح /10 /10 وعمر بْن عَبْد الْعَزِيز /10 /10 وكثير بْن العلاء صاحب لأبي هُرَيْرَة /10 /10 ومُحَمَّد بْن مُسْلِم بْن شهاب الزُّهْرِي /10 /10 ومكحول الشامي /10 /10 ونَافِع مولى ابْن عُمَر /10 /10 وأبي عَامِر الشرعبي /10 /10 وأبي مَالِك الدمشقي",
      "sanad_ar": "ويقال الأسدي أَبُو مُحَمَّد الشامي الحمصي",
      "matn_ar": "ويقال إنه دمشقي ، والصحيح أَنَّهُ حمصي /10 حريز ق ويقال : ابْن أَبِي حريز مولى مُعَاوِيَة /10 /10 وعطاء بْن أَبِي رباح /10 /10 وعمر بْن عَبْد الْعَزِيز /10 /10 وكثير بْن العلاء صاحب لأبي هُرَيْرَة /10 /10 ومُحَمَّد بْن مُسْلِم بْن شهاب الزُّهْرِي /10 /10 ومكحول الشامي /10 /10 ونَافِع مولى ابْن عُمَر /10 /10 وأبي عَامِر الشرعبي /10 /10 وأبي مَالِك الدمشقي",
