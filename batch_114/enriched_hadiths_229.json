    {
      "hadith_id": 1020431,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 29877,
      "text_ar": "2 ++ قال أَبُو عَبْدِ الْمَلِكِ البسري عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ العلاء بن زبر : توفي عَبْد اللَّهِ بن العلاء سنة أربع وستين ومائة ++ وقال أَبُو سليمان بن زبر عَنْ أَبِيهِ عن جده عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ العلاء بن زبر : توفي أبي سنة أربع وستين ومائة وهو ابن تسع وثمانين سنة وصلى عَلَيْهِ سعيد بن عَبْدِ الْعَزِيزِ ++ وقال أَبُو زرعة الدمشقي عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ العلاء بن زبر :   ولد أبي سنة خمس وسبعين ومات سنة خمس وستين ومائة وصلى عَلَيْهِ سعيد بن عَبْدِ الْعَزِيزِ ++ روى له الجماعة سوى مسلم   @ 4216 [ 3472 ] م ق\u001dE2621",
      "sanad_ar": "2 ++ قال أَبُو عَبْدِ الْمَلِكِ البسري عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ العلاء بن زبر",
      "matn_ar": "توفي عَبْد اللَّهِ بن العلاء سنة أربع وستين ومائة ++ وقال أَبُو سليمان بن زبر عَنْ أَبِيهِ عن جده عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ العلاء بن زبر : توفي أبي سنة أربع وستين ومائة وهو ابن تسع وثمانين سنة وصلى عَلَيْهِ سعيد بن عَبْدِ الْعَزِيزِ ++ وقال أَبُو زرعة الدمشقي عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ العلاء بن زبر :   ولد أبي سنة خمس وسبعين ومات سنة خمس وستين ومائة وصلى عَلَيْهِ سعيد بن عَبْدِ الْعَزِيزِ ++ روى له الجماعة سوى مسلم   @ 4216 [ 3472 ] م ق\u001dE2621",
