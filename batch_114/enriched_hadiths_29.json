      "hadith_id": 1017429,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 26875,
      "text_ar": "من الأبناء ، سكن بغداد /10 إِبْرَاهِيم بْن جَعْفَر بْن محمود بْن مُحَمَّد بْن مسلمة الأَنْصَارِي /10 /10 وإبراهيم بْن سَعْد الزُّهْرِي م د /10 /10 وأبي إِسْمَاعِيل إِبْرَاهِيم بْن سُلَيْمَان المؤدب /10 /10 وإسماعيل بْن جَعْفَر بْن أَبِي كثير خ د س /10 /10 وإسماعيل ابْن علية ت /10 /10 وإسماعيل بْن عياش /10 /10 وخازم بْن جبلة بْن أَبِي نضرة العبدي /10 /10 وخلف بْن خليفة مد /10 /10 وسُفْيَان بْن عُيَيْنَة /10 /10 وطلحة بْن يَحْيَى الزرقي الأَنْصَارِي م مد س /10 /10 وعباد بْن العوام مد /10 /10 وعَبْد الرَّحْمَنِ بْن ثابت بْن ثوبان /10 /10 وعلي بْن ثابت الجزري /10 /10 والقاسم بْن مَالِك المزني /10 /10 وقران بْن تمام الأسدي /10 /10 وأبي مُعَاوِيَة مُحَمَّد بْن خازم الضرير /10 /10 ومروان بْن مُعَاوِيَة الفزاري /10 /10 وهشيم بْن بشير د /10",
      "sanad_ar": "من الأبناء",
      "matn_ar": "سكن بغداد /10 إِبْرَاهِيم بْن جَعْفَر بْن محمود بْن مُحَمَّد بْن مسلمة الأَنْصَارِي /10 /10 وإبراهيم بْن سَعْد الزُّهْرِي م د /10 /10 وأبي إِسْمَاعِيل إِبْرَاهِيم بْن سُلَيْمَان المؤدب /10 /10 وإسماعيل بْن جَعْفَر بْن أَبِي كثير خ د س /10 /10 وإسماعيل ابْن علية ت /10 /10 وإسماعيل بْن عياش /10 /10 وخازم بْن جبلة بْن أَبِي نضرة العبدي /10 /10 وخلف بْن خليفة مد /10 /10 وسُفْيَان بْن عُيَيْنَة /10 /10 وطلحة بْن يَحْيَى الزرقي الأَنْصَارِي م مد س /10 /10 وعباد بْن العوام مد /10 /10 وعَبْد الرَّحْمَنِ بْن ثابت بْن ثوبان /10 /10 وعلي بْن ثابت الجزري /10 /10 والقاسم بْن مَالِك المزني /10 /10 وقران بْن تمام الأسدي /10 /10 وأبي مُعَاوِيَة مُحَمَّد بْن خازم الضرير /10 /10 ومروان بْن مُعَاوِيَة الفزاري /10 /10 وهشيم بْن بشير د /10",
