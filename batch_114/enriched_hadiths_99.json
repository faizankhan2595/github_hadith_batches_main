    {
      "hadith_id": 1018480,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 27926,
      "text_ar": "0 /11 الأزرق بْن قَيْس /11 /11 وابنه إِسْحَاق بْن عَبْد اللَّهِ بْن الْحَارِث بْن نوفل د /11 /11 وحنظلة السدوسي   /11 /11 وراشد أَبُو مُحَمَّد الحماني بخ /11 /11 وسليمان بْن يسار م /11 /11 وصالح أَبُو الخليل ع /11 /11 وابنه عَبْد اللَّهِ بْن عَبْد اللَّهِ بْن الْحَارِث بْن نوفل م س /11 /11 وعبد الأعلى بْن عَبْد اللَّهِ بْن عَامِر بْن كريز الخزاعي قَدْ /11 /11 وعبد الحميد بْن عَبْد الرحمن بْن زَيْد بْن الْخَطَّاب /11 /11 وعَبْد الرَّحْمَنِ بْن زِيَاد ص ويقال : ابْن أَبِي زِيَاد /11 /11 وعبد الكريم أَبُو أمية البصري ت /11 /11 وعبد الْمَلِك بْن عمير خ م /11 /11 وابنه عبيد اللَّه بْن عَبْد اللَّهِ بْن الْحَارِث بْن نوفل /11 /11 وابن أخته عتبة بْن مُحَمَّد بْن الْحَارِث بْن نوفل /11 /11 وعلقمة بْن مرثد /11 /11 وعمر بْن عَبْد الْعَزِيز /11 /11 وأَبُو إِسْحَاق عَمْرو بْن عَبْد اللَّهِ السبيعي س /11 /11 ومُحَمَّد بْن زِيَاد الجمحي /11 /11 ومُحَمَّد بْن مُسْلِم بْن شهاب الزُّهْرِي م د ت س /11 /11 وأَبُو التياح يَزِيد بْن حميد الضبعي خ م /11 /11 ومولاه يَزِيد بْن أَبِي زِيَاد بخ 4 /11 /11 وأَبُو جناب الكلبي /11 /11 وأَبُو سلمة بْن عَبْد الرحمن /11   # قال",
      "sanad_ar": "0 /11 الأزرق بْن قَيْس /11 /11 وابنه إِسْحَاق بْن عَبْد اللَّهِ بْن الْحَارِث بْن نوفل د /11 /11 وحنظلة السدوسي   /11 /11 وراشد أَبُو مُحَمَّد الحماني بخ /11 /11 وسليمان بْن يسار م /11 /11 وصالح أَبُو الخليل ع /11 /11 وابنه عَبْد اللَّهِ بْن عَبْد اللَّهِ بْن الْحَارِث بْن نوفل م س /11 /11 وعبد الأعلى بْن عَبْد اللَّهِ بْن عَامِر بْن كريز الخزاعي قَدْ /11 /11 وعبد الحميد بْن عَبْد الرحمن بْن زَيْد بْن الْخَطَّاب /11 /11 وعَبْد الرَّحْمَنِ بْن زِيَاد ص ويقال",
      "matn_ar": "ابْن أَبِي زِيَاد /11 /11 وعبد الكريم أَبُو أمية البصري ت /11 /11 وعبد الْمَلِك بْن عمير خ م /11 /11 وابنه عبيد اللَّه بْن عَبْد اللَّهِ بْن الْحَارِث بْن نوفل /11 /11 وابن أخته عتبة بْن مُحَمَّد بْن الْحَارِث بْن نوفل /11 /11 وعلقمة بْن مرثد /11 /11 وعمر بْن عَبْد الْعَزِيز /11 /11 وأَبُو إِسْحَاق عَمْرو بْن عَبْد اللَّهِ السبيعي س /11 /11 ومُحَمَّد بْن زِيَاد الجمحي /11 /11 ومُحَمَّد بْن مُسْلِم بْن شهاب الزُّهْرِي م د ت س /11 /11 وأَبُو التياح يَزِيد بْن حميد الضبعي خ م /11 /11 ومولاه يَزِيد بْن أَبِي زِيَاد بخ 4 /11 /11 وأَبُو جناب الكلبي /11 /11 وأَبُو سلمة بْن عَبْد الرحمن /11   # قال",
