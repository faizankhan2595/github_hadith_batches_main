    {
      "hadith_id": 1025496,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 34942,
      "text_ar": "0 /11 ابنه إِبْرَاهِيم بْن عُبَيْد اللَّه بْن أَبِي رافع /11 /11 وبسر بْن سَعِيد م /11 /11 وبكر بْن سوادة /11 /11 وجَعْفَر بْن مُحَمَّد بْن عَلِي بْن الْحُسَيْن ت /11 /11 والحسن بْن مُحَمَّد بْن الحنفية خ م د ت س /11 /11 والحكم بْن عتيبة د ت س /11 /11 وزيد بْن عَلِي بْن الْحُسَيْن /11 /11 وسالم أَبُو النضر د ت ق /11 /11 وعَاصِم بْن عُبَيْد اللَّه د ت /11 /11 وابنه عَبْد اللَّهِ بْن عُبَيْد اللَّه بْن أَبِي رافع /11 /11 وعبد اللَّه بْن الفضل الهاشمي دعس /11 /11 وعَبْد الرَّحْمَنِ بْن هرمز الأعرج م 4 /11 /11 وعَبْد الرَّحْمَنِ بْن يسار عم مُحَمَّد بْن إِسْحَاق بْن يسار /11 /11 وعطاء بْن يسار /11 /11 وعلي بْن الْحُسَيْن بْن عَلِي زين العابدين د ت عس ق /11 /11 وعمرو بْن أَبِي عَمْرو مولى المطلب /11 /11 وابنه مُحَمَّد بْن عُبَيْد اللَّه بْن أَبِي رافع ق /11 /11 وأَبُو جَعْفَر مُحَمَّد بْن عَلِي بْن الْحُسَيْن م 4 /11 /11 ومحمد بْن مُسْلِم بْن شهاب الزهري ر /11 /11 ومحمد بْن المنكدر ت /11 /11 ومعاوية بْن عَبْد اللَّهِ بْن جَعْفَر بْن أَبِي طَالِب /11 /11 وابنه المعتمر بْن عُبَيْد اللَّه بْن أَبِي رافع /11 /11 وموسى بْن عَبْد اللَّهِ بْن قَيْس /11 /11 وأم بَكْر بنت المسور بنت مخرمة /11 ++ ذكره   مُحَمَّد بْن سَعْد فِي الطبقة الثَّانِيَة من أَهل الْمَدِينَة ، وقال : روى عن عَلِي وكتب لَهُ . # وقال",
      "sanad_ar": "0 /11 ابنه إِبْرَاهِيم بْن عُبَيْد اللَّه بْن أَبِي رافع /11 /11 وبسر بْن سَعِيد م /11 /11 وبكر بْن سوادة /11 /11 وجَعْفَر بْن مُحَمَّد بْن عَلِي بْن الْحُسَيْن ت /11 /11 والحسن بْن مُحَمَّد بْن الحنفية خ م د ت س /11 /11 والحكم بْن عتيبة د ت س /11 /11 وزيد بْن عَلِي بْن الْحُسَيْن /11 /11 وسالم أَبُو النضر د ت ق /11 /11 وعَاصِم بْن عُبَيْد اللَّه د ت /11 /11 وابنه عَبْد اللَّهِ بْن عُبَيْد اللَّه بْن أَبِي رافع /11 /11 وعبد اللَّه بْن الفضل الهاشمي دعس /11 /11 وعَبْد الرَّحْمَنِ بْن هرمز الأعرج م 4 /11 /11 وعَبْد الرَّحْمَنِ بْن يسار عم مُحَمَّد بْن إِسْحَاق بْن يسار /11 /11 وعطاء بْن يسار /11 /11 وعلي بْن الْحُسَيْن بْن عَلِي زين العابدين د ت عس ق /11 /11 وعمرو بْن أَبِي عَمْرو مولى المطلب /11 /11 وابنه مُحَمَّد بْن عُبَيْد اللَّه بْن أَبِي رافع ق /11 /11 وأَبُو جَعْفَر مُحَمَّد بْن عَلِي بْن الْحُسَيْن م 4 /11 /11 ومحمد بْن مُسْلِم بْن شهاب الزهري ر /11 /11 ومحمد بْن المنكدر ت /11 /11 ومعاوية بْن عَبْد اللَّهِ بْن جَعْفَر بْن أَبِي طَالِب /11 /11 وابنه المعتمر بْن عُبَيْد اللَّه بْن أَبِي رافع /11 /11 وموسى بْن عَبْد اللَّهِ بْن قَيْس /11 /11 وأم بَكْر بنت المسور بنت مخرمة /11 ++ ذكره   مُحَمَّد بْن سَعْد فِي الطبقة الثَّانِيَة من أَهل الْمَدِينَة",
      "matn_ar": "وقال : روى عن عَلِي وكتب لَهُ . # وقال",
