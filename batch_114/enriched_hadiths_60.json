    {
      "hadith_id": 1017888,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 27334,
      "text_ar": "0 /11 ابْن ماجه /11 /11 وإبراهيم بْن أورمة الأصبهاني   /11 /11 وإبراهيم بْن حماد بْن إِسْحَاق بْن إِسْمَاعِيل بْن حماد بْن زَيْد الْقَاضِي /11 /11 وأَحْمَد بْن اللَّيْث بْن مَنْصُور الأنماطي /11 /11 وإسماعيل بْن الْعَبَّاس الوراق /11 /11 والحسن بْن عَلِي بْن أَبِي الحناء التميمي الهمذاني /11 /11 والحسين بْن إِسْمَاعِيل المحاملي /11 /11 وأَبُو عَلِي شيخ بْن عميرة بْن عَبْد اللَّهِ بْن صَالِح بْن شيخ بْن عميرة الأسدي /11 /11 وعبد اللَّه بْن مُحَمَّد بْن أَبِي الدنيا /11 /11 وعبد اللَّه بْن مُحَمَّد بْن وهب الدينوري /11 /11 وعَبْد الرَّحْمَنِ بْن أَحْمَد بْن عباد الهمداني عبدوس /11 /11 وعَبْد الرَّحْمَنِ بْن أَبِي حاتم الرازي /11 /11 وعَبْد الرَّحْمَنِ بْن مُحَمَّد بْن حماد الطهراني /11 /11 وعلي بْن أَحْمَد بْن سَعِيد /11 /11 وعلي بْن الْحَسَن بْن سَعْد البزاز /11 /11 والفتح بْن شخرف /11 /11 والقاسم بْن موسى بْن الْحَسَن بْن موسى الأشيب /11 /11 وأَبُو بَكْر مُحَمَّد بْن أَحْمَد بْن راشد بْن معدان الأصبهاني /11 /11 ومُحَمَّد بْن إِسْحَاق المسوحي الأصبهاني الْحَافِظ /11 /11 ومُحَمَّد بْن حامد بْن السري البغدادي المعروف بخال ولد السني /11 /11 ومُحَمَّد بْن الْحَسَن بْن مُحَمَّد بْن عَبْد الْمَلِك بْن أَبِي الشوارب /11 /11 ومُحَمَّد بْن مُحَمَّد بْن سُلَيْمَان الباغندي /11 /11 ومُحَمَّد بْن مخلد العطار /11 /11 والهيثم بْن خلف الدوري /11 /11 ويَحْيَى بْن مُحَمَّد بْن صاعد /11   # قال",
