      "chapter_id": null,
      "hadith_number": 27333,
      "text_ar": "لقبه عباسويه ، ويعرف بالعبدي وكَانَ قَاضِي همدان /10 إِبْرَاهِيم بْن صدقة البصري /10 /10 وإبراهيم بْن يَزِيد بْن مردانبة /10 /10 وإسحاق بْن إدريس /10 /10 وإسحاق بْن عيسى ابْن بنت دَاوُد بْن أَبِي هند /10 /10 وإسماعيل ابْن علية /10 /10 وبشر بْن السري /10 /10 وبشر بْن المفضل /10 /10 وحبان بْن موسى المروزي /10 /10 وحماد بْن واقد /10 /10 وخالد بْن الْحَارِث /10 /10 ودرست بْن زِيَاد /10 /10 ورباح بْن خَالِد /10 /10 وزهير بْن هنيد العدوي /10 /10 وزِيَاد بْن الرَّبِيع اليحمدي /10 /10 وزِيَاد بْن عَبْد اللَّهِ البكائي ق /10 /10 وسُفْيَان بْن حبيب /10 /10 وسُفْيَان بْن عُيَيْنَة /10 /10 وأبي دَاوُد سُلَيْمَان بْن دَاوُد الطيالسي /10 /10 وأبي بدر شجاع بْن الْوَلِيد بْن قَيْس السكوني /10 /10 وصفوان بْن عيسى /10 /10 وعَاصِم بْن هلال /10 /10 وعبد اللَّه بْن إدريس /10 /10 وعبد الأعلى بْن عَبْد الأعلى /10 /10 وعبد الخالق بْن أَبِي المخارق /10 /10 وعبد الرزاق بْن همام /10 /10 وأبي عَامِر عَبْد الْمَلِك بْن عَمْرو العقدي /10 /10 وعبد الْوَهَّاب بْن عَبْد المجيد الثقفي /10 /10 وعثمان بْن عَبْد الرحمن خال أَبِي عُبَيْدَة القوي /10 /10 وعثمان بْن عُثْمَان الغطفاني /10 /10 وعيسى بْن شُعَيْب /10 /10 وغسان بْن مضر /10 /10 ومُحَمَّد بْن جَعْفَر غندر ق /10 /10 وأبي مُعَاوِيَة مُحَمَّد بْن خازم الضرير /10 /10 ومُحَمَّد بْن فضيل بْن غزوان /10 /10 ومروان بْن مُعَاوِيَة الفزاري /10 /10 ومعاذ بْن هِشَام الدستوائي /10 /10 ومعتمر بْن سُلَيْمَان /10 /10 ونعيم بْن المورع /10 /10 ونوح بْن قَيْس الحداني /10 /10 ووكيع بْن محرز الناجي ق /10 /10 ويَحْيَى بْن حماد /10 /10 ويَحْيَى بْن سَعِيد الْقَطَّان /10 /10 ويزيد بْن زريع /10 /10 ويزيد بْن هَارُون /10 /10 ويعلى بْن عَبْد الرحمن العنبري /10",
      "sanad_ar": "لقبه عباسويه",
      "matn_ar": "ويعرف بالعبدي وكَانَ قَاضِي همدان /10 إِبْرَاهِيم بْن صدقة البصري /10 /10 وإبراهيم بْن يَزِيد بْن مردانبة /10 /10 وإسحاق بْن إدريس /10 /10 وإسحاق بْن عيسى ابْن بنت دَاوُد بْن أَبِي هند /10 /10 وإسماعيل ابْن علية /10 /10 وبشر بْن السري /10 /10 وبشر بْن المفضل /10 /10 وحبان بْن موسى المروزي /10 /10 وحماد بْن واقد /10 /10 وخالد بْن الْحَارِث /10 /10 ودرست بْن زِيَاد /10 /10 ورباح بْن خَالِد /10 /10 وزهير بْن هنيد العدوي /10 /10 وزِيَاد بْن الرَّبِيع اليحمدي /10 /10 وزِيَاد بْن عَبْد اللَّهِ البكائي ق /10 /10 وسُفْيَان بْن حبيب /10 /10 وسُفْيَان بْن عُيَيْنَة /10 /10 وأبي دَاوُد سُلَيْمَان بْن دَاوُد الطيالسي /10 /10 وأبي بدر شجاع بْن الْوَلِيد بْن قَيْس السكوني /10 /10 وصفوان بْن عيسى /10 /10 وعَاصِم بْن هلال /10 /10 وعبد اللَّه بْن إدريس /10 /10 وعبد الأعلى بْن عَبْد الأعلى /10 /10 وعبد الخالق بْن أَبِي المخارق /10 /10 وعبد الرزاق بْن همام /10 /10 وأبي عَامِر عَبْد الْمَلِك بْن عَمْرو العقدي /10 /10 وعبد الْوَهَّاب بْن عَبْد المجيد الثقفي /10 /10 وعثمان بْن عَبْد الرحمن خال أَبِي عُبَيْدَة القوي /10 /10 وعثمان بْن عُثْمَان الغطفاني /10 /10 وعيسى بْن شُعَيْب /10 /10 وغسان بْن مضر /10 /10 ومُحَمَّد بْن جَعْفَر غندر ق /10 /10 وأبي مُعَاوِيَة مُحَمَّد بْن خازم الضرير /10 /10 ومُحَمَّد بْن فضيل بْن غزوان /10 /10 ومروان بْن مُعَاوِيَة الفزاري /10 /10 ومعاذ بْن هِشَام الدستوائي /10 /10 ومعتمر بْن سُلَيْمَان /10 /10 ونعيم بْن المورع /10 /10 ونوح بْن قَيْس الحداني /10 /10 ووكيع بْن محرز الناجي ق /10 /10 ويَحْيَى بْن حماد /10 /10 ويَحْيَى بْن سَعِيد الْقَطَّان /10 /10 ويزيد بْن زريع /10 /10 ويزيد بْن هَارُون /10 /10 ويعلى بْن عَبْد الرحمن العنبري /10",
