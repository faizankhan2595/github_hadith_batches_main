    {
      "hadith_id": 1017683,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 27129,
      "text_ar": "واسمه ازداد بنداذ الواسطي الباكسائي أَبُو مُحَمَّد ، ويقال أَبُو الفضل الترقفي نزيل بغداد /10 حفص بْن عُمَر العدني /10 /10 ورواد بْن الجراح العسقلاني /10 /10 وزيد بْن يَحْيَى بْن عبيد الدمشقي /10 /10 وسعيد بْن عَبْد اللَّهِ بْن دِينَار /10 /10 وسلم بْن ميمون الخواص /10 /10 وأبي عَاصِم الضحاك بْن مخلد /10 /10 وعبد اللَّه بْن غالب العباداني ق /10 /10 وأبي عَبْد الرحمن عَبْد اللَّهِ بْن يَزِيد الْمُقْرِئ /10 /10 وأبي مسهر عَبْد الأعلى بْن مسهر الغساني /10 /10 وأبي الْمُغِيرَة عَبْد القدوس بْن الْحَجَّاج الخولاني /10 /10 وعثمان بْن سَعِيد بْن كثير بْن دِينَار الحمصي /10 /10 ومُحَمَّد بْن عيسى بْن الطباع /10 /10 ومُحَمَّد بْن كثير المصيصي /10 /10 ومُحَمَّد بْن المبارك الصوري /10 /10 ومُحَمَّد بْن يَحْيَى بْن أَبِي حاتم الأزدي /10 /10 ومُحَمَّد بْن يُوسُف الفريابي /10 /10 ومروان بْن مُحَمَّد الطاطري /10 /10 وأبي حذيفة موسى بْن مَسْعُود النهدي /10 /10 ويَحْيَى بْن يعلى المحاربي /10 /10 وبسرة بْن صفوان اللخمي /10",
      "sanad_ar": "واسمه ازداد بنداذ الواسطي الباكسائي أَبُو مُحَمَّد",
      "matn_ar": "ويقال أَبُو الفضل الترقفي نزيل بغداد /10 حفص بْن عُمَر العدني /10 /10 ورواد بْن الجراح العسقلاني /10 /10 وزيد بْن يَحْيَى بْن عبيد الدمشقي /10 /10 وسعيد بْن عَبْد اللَّهِ بْن دِينَار /10 /10 وسلم بْن ميمون الخواص /10 /10 وأبي عَاصِم الضحاك بْن مخلد /10 /10 وعبد اللَّه بْن غالب العباداني ق /10 /10 وأبي عَبْد الرحمن عَبْد اللَّهِ بْن يَزِيد الْمُقْرِئ /10 /10 وأبي مسهر عَبْد الأعلى بْن مسهر الغساني /10 /10 وأبي الْمُغِيرَة عَبْد القدوس بْن الْحَجَّاج الخولاني /10 /10 وعثمان بْن سَعِيد بْن كثير بْن دِينَار الحمصي /10 /10 ومُحَمَّد بْن عيسى بْن الطباع /10 /10 ومُحَمَّد بْن كثير المصيصي /10 /10 ومُحَمَّد بْن المبارك الصوري /10 /10 ومُحَمَّد بْن يَحْيَى بْن أَبِي حاتم الأزدي /10 /10 ومُحَمَّد بْن يُوسُف الفريابي /10 /10 ومروان بْن مُحَمَّد الطاطري /10 /10 وأبي حذيفة موسى بْن مَسْعُود النهدي /10 /10 ويَحْيَى بْن يعلى المحاربي /10 /10 وبسرة بْن صفوان اللخمي /10",
