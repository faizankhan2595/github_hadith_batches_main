      "hadith_id": 1021040,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 30486,
      "text_ar": "0 /11 إِبْرَاهِيم بْن الأشعث الْبُخَارِيّ خادم الفضيل بْن عياض /11 /11 وإِبْرَاهِيم بْن المنذر الحزامي ق /11 /11 وأَحْمَد بْن الحارث بْن أبي مسرة المكي /11 /11 وأَبُو الفضل أَحْمَد بْن الْحُسَيْن بْن جَعْفَر اللهبي /11 /11 وأَحْمَد بْن مُحَمَّد بْن الوليد الأزرقي /11 /11 وأَبُو معمر إِسْمَاعِيل بْن إِبْرَاهِيمَ القطيعي /11 /11 والزبير بْن بكار الزبيري /11 /11 وأَبُو خيثمة زهير بْن حرب /11 /11 وعَبْد اللَّهِ بْن معاوية الجمحي /11 /11 وعَبْد الرَّحْمَنِ بْن سلام الجمحي /11 /11 وعبد العزيز بْن يَحْيَى الكناني المكي /11 /11 ومُحَمَّد بْن عَبَّاد المكي /11 /11 ومُحَمَّد بْن عبيد بْن ميمون التبان /11 /11 ومُحَمَّد بْن يَحْيَى بْن أبي عمر العدني ت ق /11 /11 ومُحَمَّد بْن يَعْقُوب الزبيري /11 /11 ومهدي بْن أبي المهدي /11 /11 وموسى بْن المساور الضبي الأصبهاني /11 /11 وهارون بْن مُوسَى الفروي /11 /11 ويعقوب بْن حميد بْن كاسب /11 /11 وأَبُو عبيدة بْن فضيل بْن عياض /11 ++ قال أَبُو زرعة : قال يَحْيَى بْن معين : كَانَ عَبْد الرَّزَّاقِ يكذبه . # وقال هِشَام بْن يُوسُفَ : هُوَ صدوق . # وقال",
      "sanad_ar": "0 /11 إِبْرَاهِيم بْن الأشعث الْبُخَارِيّ خادم الفضيل بْن عياض /11 /11 وإِبْرَاهِيم بْن المنذر الحزامي ق /11 /11 وأَحْمَد بْن الحارث بْن أبي مسرة المكي /11 /11 وأَبُو الفضل أَحْمَد بْن الْحُسَيْن بْن جَعْفَر اللهبي /11 /11 وأَحْمَد بْن مُحَمَّد بْن الوليد الأزرقي /11 /11 وأَبُو معمر إِسْمَاعِيل بْن إِبْرَاهِيمَ القطيعي /11 /11 والزبير بْن بكار الزبيري /11 /11 وأَبُو خيثمة زهير بْن حرب /11 /11 وعَبْد اللَّهِ بْن معاوية الجمحي /11 /11 وعَبْد الرَّحْمَنِ بْن سلام الجمحي /11 /11 وعبد العزيز بْن يَحْيَى الكناني المكي /11 /11 ومُحَمَّد بْن عَبَّاد المكي /11 /11 ومُحَمَّد بْن عبيد بْن ميمون التبان /11 /11 ومُحَمَّد بْن يَحْيَى بْن أبي عمر العدني ت ق /11 /11 ومُحَمَّد بْن يَعْقُوب الزبيري /11 /11 ومهدي بْن أبي المهدي /11 /11 وموسى بْن المساور الضبي الأصبهاني /11 /11 وهارون بْن مُوسَى الفروي /11 /11 ويعقوب بْن حميد بْن كاسب /11 /11 وأَبُو عبيدة بْن فضيل بْن عياض /11 ++ قال أَبُو زرعة",
      "matn_ar": "قال يَحْيَى بْن معين : كَانَ عَبْد الرَّزَّاقِ يكذبه . # وقال هِشَام بْن يُوسُفَ : هُوَ صدوق . # وقال",
