    {
      "hadith_id": 1020968,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 30414,
      "text_ar": "2 ++ وقال أَحْمَد بْن صالح الْمِصْرِيّ هُوَ يروى عن الزهري , والزهري يروى عنه . ++ وقال خليفة بْن خياط : توفي قبل أخيه مُحَمَّد بْن مسلم . # وقال مُحَمَّد بْن سعد : أخبرنا مُحَمَّد بْن عمر ، قال : حدثنا مُحَمَّد بْن عَبْدِ اللَّهِ الزهري ، أن أباه كَانَ أسن من الزهري ،   ومات قبل الزهري ، وكَانَ ثقة كثير الْحَدِيث استشهد بِهِ الْبُخَارِيّ . ++ وروى له الباقون سوى ابْن مَاجَهْ . @ 4325 [ 3567 ] بخ ق\u001eE2695",
      "sanad_ar": "2 ++ وقال أَحْمَد بْن صالح الْمِصْرِيّ هُوَ يروى عن الزهري , والزهري يروى عنه . ++ وقال خليفة بْن خياط",
      "matn_ar": "توفي قبل أخيه مُحَمَّد بْن مسلم . # وقال مُحَمَّد بْن سعد : أخبرنا مُحَمَّد بْن عمر ، قال : حدثنا مُحَمَّد بْن عَبْدِ اللَّهِ الزهري ، أن أباه كَانَ أسن من الزهري ،   ومات قبل الزهري ، وكَانَ ثقة كثير الْحَدِيث استشهد بِهِ الْبُخَارِيّ . ++ وروى له الباقون سوى ابْن مَاجَهْ . @ 4325 [ 3567 ] بخ ق\u001eE2695",
