      "chapter_id": null,
      "hadith_number": 27999,
      "text_ar": "0 /11 إِسْحَاق بْن راشد س /11 /11 وإسماعيل بْن عَبْد الرحمن السدي /11 /11 وإسماعيل ابْن علية ت /11 /11 وجهم بْن عُثْمَان /11 /11 وحسين بْن حسن الأشقر /11 /11 وحسين بْن زَيْد بْن عَلِي بْن الْحُسَيْن /11 /11 ومولاه حفص بْن عُمَر /11 /11 وحفص بْن عُمَر الرقاشي /11 /11 ورجاء بْن أَبِي سلمة /11 /11 وروح بْن القاسم /11 /11 وأَبُو الجارود زِيَاد بْن المنذر /11 /11 وزيد أَبُو أُسَامَة الْحَجَّاج /11 /11 وسعير بْن الخمس س /11 /11 وسُفْيَان الثَّوْرِي د ت س /11 /11 وأَبُو خَالِد سُلَيْمَان بْن حيان الأحمر /11 /11 وسليمان بْن قرم /11 /11 وصالح بْن موسى الطلحي /11 /11 وعبد اللَّه بْن إِسْحَاق الجعفري /11 /11 وعبد اللَّه بْن زِيَاد بْن سمعان /11 /11 وعبد الحميد بْن جَعْفَر الأَنْصَارِي /11 /11 وعَبْد الرَّحْمَنِ بْن أَبِي الموال /11 /11 وعبد الْعَزِيز بْن مُحَمَّد الدراوردي /11 /11 وعبد الْعَزِيز بْن المطلب بْن عَبْد اللَّهِ بْن حنطب ت ق /11 /11 وعبيد اللَّه بْن الْوَلِيد الوصافي /11 /11 وعمار بْن زريق الضبي /11 /11 وعمار بْن سَيْف الضبي /11 /11 وعنبسة بْن عَبْد الرحمن الْقُرَشِي /11 /11 وفضيل بْن مرزوق /11 /11 وقيس   بْن الرَّبِيع /11 /11 وليث بْن أَبِي سليم ت ق /11 /11 ومَالِك بْن أَنَس /11 /11 ومُحَمَّد بْن القاسم الأسدي /11 /11 وأَبُو حماد المفضل بْن صدقة الحنفي /11 /11 والمنذر بْن زِيَاد الطائي /11 /11 وابنه موسى بْن عَبْد اللَّهِ بْن حسن بْن حسن /11 /11 ونَافِع بْن عَبْد الرحمن بْن أَبِي نعيم القارىء /11 /11 وهِشَام بْن حسان /11 /11 وابنه يَحْيَى بْن عَبْد اللَّهِ بْن حسن بْن حسن /11 /11 ويزيد بْن عَبْد اللَّهِ بْن الهاد /11 /11 وأَبُو بَكْر بْن حفص بْن عُمَر بْن سَعْد بْن أَبِي وقاص س /11   # قال",
