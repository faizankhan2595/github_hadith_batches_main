    {
      "hadith_id": 1022721,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 32167,
      "text_ar": "ويقال أَبُو جَعْفَر ويقال أَبُو مُحَمَّد بْن أَبِي سعيد الخدري المدني والد ربيح بْن عَبْد الرَّحْمَن ، وسعيد بْن عَبْد الرَّحْمَن . /10 أبيه أَبِي سعيد سعد بْن مَالِك الخدري خت م 4 /10 /10 وعمارة بْن حارثة الضمري /10 /10 وأبي حميد الساعدي /10",
      "sanad_ar": "ويقال أَبُو جَعْفَر ويقال أَبُو مُحَمَّد بْن أَبِي سعيد الخدري المدني والد ربيح بْن عَبْد الرَّحْمَن",
      "matn_ar": "وسعيد بْن عَبْد الرَّحْمَن . /10 أبيه أَبِي سعيد سعد بْن مَالِك الخدري خت م 4 /10 /10 وعمارة بْن حارثة الضمري /10 /10 وأبي حميد الساعدي /10",
