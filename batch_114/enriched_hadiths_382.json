      "hadith_id": 1022728,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 32174,
      "text_ar": "مولى الأسود بْن سفيان المخزومي ويقال مولى أَبِي سفيان ويقال مولى آل أَبِي سفيان رأى عمر بْن الخطاب ، وعثمان بْن عفان . /10 أَبِي سعيد بْن سعد بْن مَالِك الخدري م د /10 /10 وأبيه سعد المدني /10 /10 وعبد اللَّه بْن عمر بْن الخطاب /10 /10 وابن كعب بْن مَالِك عَبْد اللَّه أو عَبْد الرَّحْمَن م د /10 /10 وعمر بْن أَبِي سلمة بْن عَبْد الأسد المخزومي ربيب النبي صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ /10 /10 وعمرو بْن خزيمة المزني /10 /10 وأبي هريرة د ق /10",
      "sanad_ar": "مولى الأسود بْن سفيان المخزومي ويقال مولى أَبِي سفيان ويقال مولى آل أَبِي سفيان رأى عمر بْن الخطاب",
      "matn_ar": "وعثمان بْن عفان . /10 أَبِي سعيد بْن سعد بْن مَالِك الخدري م د /10 /10 وأبيه سعد المدني /10 /10 وعبد اللَّه بْن عمر بْن الخطاب /10 /10 وابن كعب بْن مَالِك عَبْد اللَّه أو عَبْد الرَّحْمَن م د /10 /10 وعمر بْن أَبِي سلمة بْن عَبْد الأسد المخزومي ربيب النبي صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ /10 /10 وعمرو بْن خزيمة المزني /10 /10 وأبي هريرة د ق /10",
      "grade": null,
