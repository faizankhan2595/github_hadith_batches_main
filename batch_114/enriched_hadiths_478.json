      "hadith_id": 1024167,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 33613,
      "text_ar": "أخبرنا بِهِ /94 أَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلٌ L62448 /26 ، قال : أخبرنا /26 ابْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 ابْنُ الْمُذَهِّبِ L14991 /26 ، قال : أخبرنا /26 الْقَطِيعِيُّ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ L1003 /26 ، قال : حدثنا /26 سَعِيدُ بْنُ يَزِيدَ يَعْنِي أَبَا مَسْلَمَةَ L3417 /26 ، قال : حدثنا /26 عَبْدُ الْعَزِيزِ بْنُ أَسِيدٍ L4558 /26 ، قال : /27 سمعت رَجُلا قال /93 لابْنِ الزُّبَيْرِ L4697 /93 : افْتِنَا فِي /20 نَبِيذِ الْجَرِّ ؟ فَقَالَ : \" سمعت رَسُولَ اللَّهِ صلى الله عليه وسلم نَهَى عَنْهُ \" /27 . رَوَاهُ عَنْ مُحَمَّدِ بْنِ عَبْدِ الأَعْلَي ، عن خالد بن الحارث ، عن شعبة ، عن أبي مسلمة ، فوقع لنا عاليا بدرجتين * \r\n@ 4933 [ 3436 ] قد",
      "sanad_ar": "أخبرنا بِهِ /94 أَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94",
      "matn_ar": "/94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلٌ L62448 /26 ، قال : أخبرنا /26 ابْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 ابْنُ الْمُذَهِّبِ L14991 /26 ، قال : أخبرنا /26 الْقَطِيعِيُّ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ L1003 /26 ، قال : حدثنا /26 سَعِيدُ بْنُ يَزِيدَ يَعْنِي أَبَا مَسْلَمَةَ L3417 /26 ، قال : حدثنا /26 عَبْدُ الْعَزِيزِ بْنُ أَسِيدٍ L4558 /26 ، قال : /27 سمعت رَجُلا قال /93 لابْنِ الزُّبَيْرِ L4697 /93 : افْتِنَا فِي /20 نَبِيذِ الْجَرِّ ؟ فَقَالَ : \" سمعت رَسُولَ اللَّهِ صلى الله عليه وسلم نَهَى عَنْهُ \" /27 . رَوَاهُ عَنْ مُحَمَّدِ بْنِ عَبْدِ الأَعْلَي ، عن خالد بن الحارث ، عن شعبة ، عن أبي مسلمة ، فوقع لنا عاليا بدرجتين * \r\n@ 4933 [ 3436 ] قد",
