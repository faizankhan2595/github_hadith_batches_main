    {
      "hadith_id": 1018616,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 28062,
      "text_ar": "واسم أَبِي زِيَاد سُلَيْمَان /10 أَبِي الجواب الأحوص بْن جواب ت /10 /10 وإسحاق بْن الرَّبِيع العصفري /10 /10 وإسحاق بْن عيسى القشيري ابْن بنت دَاوُد بْن أَبِي هند /10 /10 وزيد بْن الحباب د ت /10 /10 وأبي زَيْد سَعِيد بْن أوس الأَنْصَارِي النحوي ت /10 /10 وسُفْيَان بْن عُيَيْنَة ت /10 /10 وأبي دَاوُد سُلَيْمَان بْن دَاوُد الطيالسي ت /10 /10 وسيار بْن حاتم العنزي ت ق /10 /10 وشبابة بْن سوار ت /10 /10 وعبد اللَّه بْن بَكْر السهمي ت /10 /10 وعبد اللَّه بْن يعقوب بْن إِسْحَاق المدني ت /10 /10 وعبد الْعَزِيز بْن عَبْد اللَّهِ الأويسي ت /10 /10 وعبيد اللَّه بْن موسى د ت /10 /10 ومعاذ بْن هِشَام الدستوائي /10 /10 ومعاوية بْن هِشَام القصار /10 /10 ومكي بْن إِبْرَاهِيم البلخي /10 /10 وهِشَام بْن عبيد اللَّه الرازي /10 /10 ووكيع بْن الجراح /10 /10 والوليد بْن القاسم بْن الْوَلِيد الهمداني /10 /10 ووهب بْن جَرِير بْن حازم /10 /10 ويعقوب بْن إِبْرَاهِيم بْن سَعْد ت ق /10 /10 ويعقوب بْن مُحَمَّد الزُّهْرِي /10 /10 وأبي نباتة يُونُس بْن يَحْيَى المدني ت /10",
