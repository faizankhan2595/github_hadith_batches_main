    {
      "hadith_id": 1017862,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 27308,
      "text_ar": "2 قال الْعَبَّاس : سمعت من أَبِي ، وعرضت عَلَيْهِ ، والعرض أصح .\u0012E2389 ++ قال أَبُو دَاوُد : كَانَ صاحب ليل ++ وقال فِي موضع آخر : سمع ، ثُمَّ عرض بَعْد السماع ++ وقال فِي موضع آخر كتبت ، عَنْ عَبَّاس بْن الْوَلِيد بْن مزيد سنة سبع وعشرين ، ومعنا بْن أَبِي سمينة ، سمع فِي كتابي ،",
      "sanad_ar": "2 قال الْعَبَّاس",
      "matn_ar": "سمعت من أَبِي ، وعرضت عَلَيْهِ ، والعرض أصح .\u0012E2389 ++ قال أَبُو دَاوُد : كَانَ صاحب ليل ++ وقال فِي موضع آخر : سمع ، ثُمَّ عرض بَعْد السماع ++ وقال فِي موضع آخر كتبت ، عَنْ عَبَّاس بْن الْوَلِيد بْن مزيد سنة سبع وعشرين ، ومعنا بْن أَبِي سمينة ، سمع فِي كتابي ،",
