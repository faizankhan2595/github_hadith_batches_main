    {
      "hadith_id": 1021345,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 30791,
      "text_ar": "مولى بني حمان ويقال مولى بني تميم خراساني الأصل فإنه /10 إِبْرَاهِيم بْن مُحَمَّد بْن أبي يَحْيَى المدني /10 /10 وحرملة بْن عمران التجيبي /10 /10 وحنظلة بْن أبي سفيان الجمحي /10 /10 وحيوة بْن شريح الْمِصْرِيّ /10 /10 وخالد بْن عَبْدِ الرَّحْمَنِ السلمي /10 /10 وسَعِيد بْن أبي عروبة /10 /10 وسفيان الثوري /10 /10 وشريك بْن عَبْدِ اللَّهِ /10 /10 وشعبة بْن الحجاج /10 /10 وصفوان بْن عمرو الحمصي /10 /10 وعَبْد اللَّهِ بْن المؤمل المخزومي /10 /10 وعبد الملك بن جريج /10 /10 وعثمان بْن مقسم /10 /10 وعكرمة بْن عمار /10 /10 وعمر بْن الصبح /10 /10 وعمر النهائي /10 /10 وأبي الورقاء فائد بْن عَبْدِ الرَّحْمَنِ /10 /10 ومسعر بْن كدام /10 /10 وأبي بكر بْن عَبْدِ اللَّهِ بْن أبي سبرة /10 /10 وأبي بكر بْن عَبْدِ اللَّهِ بْن أبي مريم /10",
