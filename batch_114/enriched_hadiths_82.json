    {
      "hadith_id": 1018229,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 27675,
      "text_ar": "0 /11 إِبْرَاهِيم بْن مروزق البصري /11 /11 وإبراهيم بْن يعقوب الجوزجاني /11 /11 وأَحْمَد بْن حَنْبَل /11 /11 وأَبُو جَعْفَر أَحْمَد بْن الخليل البغدادي /11 /11 وأَحْمَد بْن سَعِيد الجمال /11 /11 وأَحْمَد بْن ملاعب بْن حيان البغدادي /11 /11 وإسحاق بْن مَنْصُور الكوسج ت /11 /11 وإسحاق غَيْر منسوب خ قيل : إنه ابْن مَنْصُور /11, /11 وبشر بْن آدم البصري د , ابْن بنت أزهر بْن سَعْد السمان /11 /11 والحارث بْن مُحَمَّد بْن أَبِي أُسَامَة /11 /11 والحسن بْن عرفة /11 /11 والحسن بْن مُحَمَّد الزعفراني /11 /11 والحسن بْن مكرم البزاز /11 /11 والحسين بْن الْحَسَن المروزي /11 /11 وحميد بْن الرَّبِيع اللخمي /11 /11 وخشيش بْن أصرم س /11 /11 وأَبُو خيثمة زهير بْن حرب /11 /11 وسعدان بْن نصر بْن مَنْصُور البزاز /11 /11 وعباس بْن مُحَمَّد الدوري /11 /11 وعبد اللَّه بْن الجراح القهستاني د /11 /11 وعبد اللَّه بْن أَبِي   زِيَاد القطواني ت /11 /11 وأَبُو بَكْر عَبْد اللَّهِ بْن مُحَمَّد بْن أَبِي شيبة ق /11 /11 وعبد اللَّه بْن مُحَمَّد المستعمل /11 /11 وعبد اللَّه بْن منير المروزي خ ت /11 /11 وعثمان بْن صَالِح الحربي الخلقاني /11 /11 وعلي بْن الْحَسَن بْن عبدويه الخزاز /11 /11 وعلي بْن الْحُسَيْن بْن إشكاب /11 /11 وعلي بْن سَعِيد بْن جَرِير النَّسَائِي /11 /11 وعلي بْن عيسى بْن يَزِيد الكراجكي ت /11 /11 وعلي بْن المديني /11 /11 وقتيبة بْن سَعِيد /11 /11 ومُحَمَّد بْن أَحْمَد بْن أَبِي العوام الرياحي /11 /11 ومُحَمَّد بْن إِسْحَاق الصاغاني /11 /11 ومُحَمَّد بْن إِسْمَاعِيل ابْن علية س /11 /11 ومُحَمَّد بْن حاتم بْن ميمون م /11 /11 ومُحَمَّد بْن الْحُسَيْن البرجلاني /11 /11 ومُحَمَّد بْن عبدك القزاز /11 /11 ومُحَمَّد بْن الفرج الأزرق /11 /11 ومُحَمَّد بْن يُونُس الكديمي /11 /11 ومحمود بْن غيلان ت /11 /11 والمنذر بْن الْوَلِيد الجارودي د /11 /11 وهارون بْن عَبْد اللَّهِ الحمال س /11 /11 وأَبُو همام الْوَلِيد بْن شجاع /11 /11 ويَحْيَى بْن جَعْفَر بْن الزبرقان /11 /11 ويَحْيَى بْن حَكِيم المقوم /11 /11 ويعقوب بْن إِبْرَاهِيم الدورقي /11   # قال",
      "sanad_ar": "0 /11 إِبْرَاهِيم بْن مروزق البصري /11 /11 وإبراهيم بْن يعقوب الجوزجاني /11 /11 وأَحْمَد بْن حَنْبَل /11 /11 وأَبُو جَعْفَر أَحْمَد بْن الخليل البغدادي /11 /11 وأَحْمَد بْن سَعِيد الجمال /11 /11 وأَحْمَد بْن ملاعب بْن حيان البغدادي /11 /11 وإسحاق بْن مَنْصُور الكوسج ت /11 /11 وإسحاق غَيْر منسوب خ قيل",
