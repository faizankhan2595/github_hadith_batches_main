    {
      "hadith_id": 1020025,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 29471,
      "text_ar": "مولى بني عامر بن لؤي من قريش أخو مُوسَى بن عبيدة ومحمد بن عبيدة قال البخاري : ينتسبون فِي حمير /10 جابر بن عَبْدِ اللَّهِ وقِيلَ : لم يسمع منه /10 /10 وحصين بن عوف الخثعمي /10 /10 وسهل بن سعد الساعدي /10 /10 وعبيد الله بن عَبْدِ اللَّهِ بْنِ عتبة خ /10 /10 وعقبة بن عامر الجهني /10 /10 وعلي بن الحسين بن علي بن أبي طالب /10 /10 وعمر بن عَبْدِ الْعَزِيزِ /10 /10 وموسى بن وردان /10 /10 ويحيى بن عَبْدِ اللَّهِ بْنِ كعب بن مَالِكٍ /10",
      "sanad_ar": "مولى بني عامر بن لؤي من قريش أخو مُوسَى بن عبيدة ومحمد بن عبيدة قال البخاري",
      "matn_ar": "ينتسبون فِي حمير /10 جابر بن عَبْدِ اللَّهِ وقِيلَ : لم يسمع منه /10 /10 وحصين بن عوف الخثعمي /10 /10 وسهل بن سعد الساعدي /10 /10 وعبيد الله بن عَبْدِ اللَّهِ بْنِ عتبة خ /10 /10 وعقبة بن عامر الجهني /10 /10 وعلي بن الحسين بن علي بن أبي طالب /10 /10 وعمر بن عَبْدِ الْعَزِيزِ /10 /10 وموسى بن وردان /10 /10 ويحيى بن عَبْدِ اللَّهِ بْنِ كعب بن مَالِكٍ /10",
      "grade": null,
      "page_number": null,
