    {
      "hadith_id": 1025953,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 35399,
      "text_ar": "قال الْبُخَارِي : هُوَ من ولد الوصاف بْن عامر العجلي ، واسم الوصاف مَالِك . وقال غيره : هُوَ عُبَيْد اللَّه بْن الْوَلِيد بْن عَبْد الرحمن بْن قَيْس بْن يسار بْن جَابِر بْن سلمة بْن مَالِك بْن عامر بْن كعب بْن سَعْد بْن ضبيعة بْن عجل بْن لجيم . /10 إِبْرَاهِيم بْن عُبَيْد اللَّه بْن عُبَادَة بْن الصامت /10 /10 وأبي معشر زِيَاد بْن كليب /10 /10 وطاوس بْن كيسان /10 /10 وعبد اللَّه بْن حسن بْن حسن /10 /10 وعبد اللَّه بْن عُبَيْد بْن عمير /10 /10 وعطاء بْن أَبِي رباح /10 /10 وعطية العوفي ت ق /10 /10 والعوام بْن جويرية /10 /10 والفضيل بْن مُسْلِم بخ /10 /10 ومحارب بْن دثار بخ ق /10 /10 ومحمد بْن سوقة /10 /10 وأبي جَعْفَر مُحَمَّد بْن عَلِي بْن الْحُسَيْن /10 /10 والمنهال بْن عَمْرو /10 /10 ويَحْيَى بْن هانئ بْن عروة /10",
      "sanad_ar": "قال الْبُخَارِي",
      "matn_ar": "هُوَ من ولد الوصاف بْن عامر العجلي ، واسم الوصاف مَالِك . وقال غيره : هُوَ عُبَيْد اللَّه بْن الْوَلِيد بْن عَبْد الرحمن بْن قَيْس بْن يسار بْن جَابِر بْن سلمة بْن مَالِك بْن عامر بْن كعب بْن سَعْد بْن ضبيعة بْن عجل بْن لجيم . /10 إِبْرَاهِيم بْن عُبَيْد اللَّه بْن عُبَادَة بْن الصامت /10 /10 وأبي معشر زِيَاد بْن كليب /10 /10 وطاوس بْن كيسان /10 /10 وعبد اللَّه بْن حسن بْن حسن /10 /10 وعبد اللَّه بْن عُبَيْد بْن عمير /10 /10 وعطاء بْن أَبِي رباح /10 /10 وعطية العوفي ت ق /10 /10 والعوام بْن جويرية /10 /10 والفضيل بْن مُسْلِم بخ /10 /10 ومحارب بْن دثار بخ ق /10 /10 ومحمد بْن سوقة /10 /10 وأبي جَعْفَر مُحَمَّد بْن عَلِي بْن الْحُسَيْن /10 /10 والمنهال بْن عَمْرو /10 /10 ويَحْيَى بْن هانئ بْن عروة /10",
