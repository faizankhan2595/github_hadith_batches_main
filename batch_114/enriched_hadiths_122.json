    {
      "hadith_id": 1018822,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 28268,
      "text_ar": "2 . /10 أبان بْن عُثْمَان بْن عَفَّان بخ ت سي ق /10 /10 وأبي أمامة أسعد بْن سهل بْن حنيف س /10 /10 وأنس بْن مَالِك ق /10 /10 وخارجة بْن زَيْد بْن ثابت 4 /10 /10 وسعيد بْن الْمُسَيِّب سي /10 /10 وسليمان بْن يسار /10 /10 وطلحة بْن عَبْد اللَّهِ بْن عوف /10 /10 وعامر الشَّعْبِي م ق /10 /10 وعبد اللَّه بْن جَعْفَر /10 /10 وشهد مَعَهُ جنازة , يقال : مرسل /10 /10 وعبد اللَّه بْن نيار بْن مكرم /10 /10 وعَبْد الرَّحْمَنِ بْن جرهد /10 /10 وعَبْد الرَّحْمَنِ بْن هرمز الأعرج ع وهُوَ راويته /10 /10 وعبيد اللَّه بْن عَبْد اللَّهِ بْن عتبة د ت ق /10 /10 وعبيد بْن حنين د س /10 /10 وعروة بْن الزُّبَيْر م د ت /10 /10 وعلي بْن الْحُسَيْن بْن عَلِي بْن أَبِي طَالِب م س ق /10 /10 وعمر بْن أَبِي سلمة , يقال : مرسل /10 /10 وعَمْرو بْن عَامِر الأَنْصَارِي /10 /10 وعَمْرو بْن عُثْمَان بْن عَفَّان /10 /10 والقاسم بْن مُحَمَّد بْن أَبِي بَكْر الصديق م /10 /10 ومجالد بْن عوف د س /10 /10 ومُحَمَّد   بْن حمزة بْن عَمْرو الأسلمي خت د /10 /10 والمرقع بْن صيفي س /10 /10 ونبيه بْن وهب /10 /10 وأبي بَكْر بْن عَبْد الرحمن بْن الْحَارِث بْن هِشَام /10 /10 وأبي سلمة بْن عَبْد الرحمن بْن عوف بخ م س ق /10 /10 وعائشة بنت سَعْد بْن أَبِي وقاص د /10",
      "sanad_ar": "2 . /10 أبان بْن عُثْمَان بْن عَفَّان بخ ت سي ق /10 /10 وأبي أمامة أسعد بْن سهل بْن حنيف س /10 /10 وأنس بْن مَالِك ق /10 /10 وخارجة بْن زَيْد بْن ثابت 4 /10 /10 وسعيد بْن الْمُسَيِّب سي /10 /10 وسليمان بْن يسار /10 /10 وطلحة بْن عَبْد اللَّهِ بْن عوف /10 /10 وعامر الشَّعْبِي م ق /10 /10 وعبد اللَّه بْن جَعْفَر /10 /10 وشهد مَعَهُ جنازة , يقال",
      "matn_ar": "مرسل /10 /10 وعبد اللَّه بْن نيار بْن مكرم /10 /10 وعَبْد الرَّحْمَنِ بْن جرهد /10 /10 وعَبْد الرَّحْمَنِ بْن هرمز الأعرج ع وهُوَ راويته /10 /10 وعبيد اللَّه بْن عَبْد اللَّهِ بْن عتبة د ت ق /10 /10 وعبيد بْن حنين د س /10 /10 وعروة بْن الزُّبَيْر م د ت /10 /10 وعلي بْن الْحُسَيْن بْن عَلِي بْن أَبِي طَالِب م س ق /10 /10 وعمر بْن أَبِي سلمة , يقال : مرسل /10 /10 وعَمْرو بْن عَامِر الأَنْصَارِي /10 /10 وعَمْرو بْن عُثْمَان بْن عَفَّان /10 /10 والقاسم بْن مُحَمَّد بْن أَبِي بَكْر الصديق م /10 /10 ومجالد بْن عوف د س /10 /10 ومُحَمَّد   بْن حمزة بْن عَمْرو الأسلمي خت د /10 /10 والمرقع بْن صيفي س /10 /10 ونبيه بْن وهب /10 /10 وأبي بَكْر بْن عَبْد الرحمن بْن الْحَارِث بْن هِشَام /10 /10 وأبي سلمة بْن عَبْد الرحمن بْن عوف بخ م س ق /10 /10 وعائشة بنت سَعْد بْن أَبِي وقاص د /10",
