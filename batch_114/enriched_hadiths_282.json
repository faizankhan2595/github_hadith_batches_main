    {
      "hadith_id": 1021218,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 30664,
      "text_ar": "0 /11 إِبْرَاهِيم بْن نافع المكي ع /11 /11 وإِسْمَاعِيل ابْن علية خ م ت س /11 /11 وروح بْن الْقَاسِم س /11 /11 وسفيان الثوري خ م /11 /11 وسفيان بْن عيينة ع /11 /11 وسيف بْن سليمان المكي /11 /11 وشبل بْن عَبَّاد المكي خ د فق /11 /11 وشعبة بْن الحجاج خ س /11 /11 وعباد بْن العوام حديثا واحدا /11 /11 وعبد الوارث بْن سَعِيد م /11 /11 وعمر بْن أبي سليمان فق /11 /11 وعمرو بْن شعيب وهُوَ أكبر منه /11 /11 وعيسى بْن ميمون الجرشي خد /11 /11 ومُحَمَّد بْن إِسْحَاق خت د ق /11 /11 ومُحَمَّد بْن مسلم الطائفي خت /11 /11 وهشام الدستوائي م /11 /11 وورقاء بْن عمر اليشكري خ قد س فق /11 ++ قال عَبْد الرَّحْمَنِ بْن الحكم بْن بشير بْن سليمان ، عَنْ وكيع : كَانَ سفيان يصحح تفسير بْن أبي نجيح . # وقال",
      "sanad_ar": "0 /11 إِبْرَاهِيم بْن نافع المكي ع /11 /11 وإِسْمَاعِيل ابْن علية خ م ت س /11 /11 وروح بْن الْقَاسِم س /11 /11 وسفيان الثوري خ م /11 /11 وسفيان بْن عيينة ع /11 /11 وسيف بْن سليمان المكي /11 /11 وشبل بْن عَبَّاد المكي خ د فق /11 /11 وشعبة بْن الحجاج خ س /11 /11 وعباد بْن العوام حديثا واحدا /11 /11 وعبد الوارث بْن سَعِيد م /11 /11 وعمر بْن أبي سليمان فق /11 /11 وعمرو بْن شعيب وهُوَ أكبر منه /11 /11 وعيسى بْن ميمون الجرشي خد /11 /11 ومُحَمَّد بْن إِسْحَاق خت د ق /11 /11 ومُحَمَّد بْن مسلم الطائفي خت /11 /11 وهشام الدستوائي م /11 /11 وورقاء بْن عمر اليشكري خ قد س فق /11 ++ قال عَبْد الرَّحْمَنِ بْن الحكم بْن بشير بْن سليمان",
      "matn_ar": "عَنْ وكيع : كَانَ سفيان يصحح تفسير بْن أبي نجيح . # وقال",
      "grade": null,
