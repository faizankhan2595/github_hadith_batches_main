    {
      "hadith_id": 1021222,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 30668,
      "text_ar": "2 . # وقال عَبْد الرَّحْمَنِ بْن أبي حَاتِم : سألت أبى عَنِ ابْن أبي نجيح ، عَنْ مُجَاهِد أحب إليك أَوْ خصيف ، عَنْ مُجَاهِد ، فَقَالَ : ابْن أبي نجيح أحب إلي ، إنما يقال فِي ابْن أبي نجيح القدر ، وهُوَ صالح الْحَدِيث . ++ وقال مُحَمَّد بْن حميد الرازي ، عَنْ جرير : رأيت ابْن أبي نجيح أبيض الرأس واللحية . ++ قال سفيان بْن عيينة : مات سنة إحدى وثلاثين ومئة . ++ وقال عَلِيّ بْن المديني : مات سنة اثنتين وثلاثين ومئة . ++ قال الحافظ أَبُو بَكْر الخطيب : حدث عنه عمرو بْن شعيب ، وسفيان بْن عيينة ، وبين وفاتيهما ثمانون سنة . ++ روى له الجماعة . @ 4387 [ 3613 ] بخ E2722",
      "sanad_ar": "2 . # وقال عَبْد الرَّحْمَنِ بْن أبي حَاتِم",
      "matn_ar": "سألت أبى عَنِ ابْن أبي نجيح ، عَنْ مُجَاهِد أحب إليك أَوْ خصيف ، عَنْ مُجَاهِد ، فَقَالَ : ابْن أبي نجيح أحب إلي ، إنما يقال فِي ابْن أبي نجيح القدر ، وهُوَ صالح الْحَدِيث . ++ وقال مُحَمَّد بْن حميد الرازي ، عَنْ جرير : رأيت ابْن أبي نجيح أبيض الرأس واللحية . ++ قال سفيان بْن عيينة : مات سنة إحدى وثلاثين ومئة . ++ وقال عَلِيّ بْن المديني : مات سنة اثنتين وثلاثين ومئة . ++ قال الحافظ أَبُو بَكْر الخطيب : حدث عنه عمرو بْن شعيب ، وسفيان بْن عيينة ، وبين وفاتيهما ثمانون سنة . ++ روى له الجماعة . @ 4387 [ 3613 ] بخ E2722",
