    {
      "hadith_id": 1024669,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 34115,
      "text_ar": "2 . ++ روى له أبو داود حديثا ، والترمذي ، والنسائي ، وابن ماجه آخر ، وقد وقع لنا كل واحد منهما بعلو . \r\n$2006  -10 /2 /141 أخبرنا /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلٌ L62448 /26 ، قال : أخبرنا /26 ابْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 ابْنُ الْمُذَهِّبِ L14991 /26 ، قال : أخبرنا /26 الْقَطِيعِيُّ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 وكِيعٌ L8160 /26 ، قال : حَدَّثَنِي /26 عَبْدُ الْمَجِيدِ أَبُو عَمْرٍو L5182 /26 ، قال : /27 حَدَّثَنِي /93 الْعَدَّاءُ بْنُ خَالِدِ بْنِ هَوْذَةَ L1506 /93 ، قال : \" رَأَيْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم /20 يَخْطُبُ النَّاسَ يَوْمَ عَرَفَةَ عَلَى بَعِيرٍ قَائِمًا فِي الرِّكَابَيْنِ \" /27 . رواه أبو داود من حديث وكيع ، ومن حديث عثمان بن عمر عنه ، فوقع لنا بدلا عاليا ، والحديث الآخر كتبناه في ترجمة عباد بن ليث صاحب الكرابيس * \r\n@ 5023 [ 3512 ] م د س",
      "sanad_ar": "2 . ++ روى له أبو داود حديثا",
      "matn_ar": "والترمذي ، والنسائي ، وابن ماجه آخر ، وقد وقع لنا كل واحد منهما بعلو . \r\n$2006  -10 /2 /141 أخبرنا /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلٌ L62448 /26 ، قال : أخبرنا /26 ابْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 ابْنُ الْمُذَهِّبِ L14991 /26 ، قال : أخبرنا /26 الْقَطِيعِيُّ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 وكِيعٌ L8160 /26 ، قال : حَدَّثَنِي /26 عَبْدُ الْمَجِيدِ أَبُو عَمْرٍو L5182 /26 ، قال : /27 حَدَّثَنِي /93 الْعَدَّاءُ بْنُ خَالِدِ بْنِ هَوْذَةَ L1506 /93 ، قال : \" رَأَيْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم /20 يَخْطُبُ النَّاسَ يَوْمَ عَرَفَةَ عَلَى بَعِيرٍ قَائِمًا فِي الرِّكَابَيْنِ \" /27 . رواه أبو داود من حديث وكيع ، ومن حديث عثمان بن عمر عنه ، فوقع لنا بدلا عاليا ، والحديث الآخر كتبناه في ترجمة عباد بن ليث صاحب الكرابيس * \r\n@ 5023 [ 3512 ] م د س",
