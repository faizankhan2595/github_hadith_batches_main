      "hadith_id": 108791,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 8417,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، قَالَ : /20 \" يَشْهَدُ الْجُمُعَةَ ، وَيَعُودُ الْمَرِيضَ ، وَيَحْضُرُ الْجِنَازَةَ \" ، وَقَالَ مَرَّةً : \" وَيُجِيبُ الْإِمَامَ \" /27 * \r\n$9429  /2 /141 حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ L8488 /94 ، قَالَ : أَنَا /26 سُفْيَانُ بْنُ حُسَيْنٍ L3431 /26 ، عَنِ /26 الزُّهْرِيِّ L7272 /26 ، عَنْ /26 عُرْوَةَ L5594 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 إذَا كَانَ مُعْتَكِفًا لَمْ يَدْخُلِ الْبَيْتَ إلَّا لِحَاجَةٍ \" /27 * \r\n@ 2 : 501 @ \r\n$9430  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ /26 ، عَنْ /26 عَمْرَةَ /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 : \" أَنَّهَا كَانَتْ /20 تَمُرُّ بِالْمَرِيضِ مِنْ أَهْلِهَا وَهِيَ مُعْتَكِفَةٌ ، فَلا تَعْرِضُ لَهُ \" /27 * \r\n$9431  /8",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ /94",
      "matn_ar": "عَنْ /26 سُفْيَانَ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، قَالَ : /20 \" يَشْهَدُ الْجُمُعَةَ ، وَيَعُودُ الْمَرِيضَ ، وَيَحْضُرُ الْجِنَازَةَ \" ، وَقَالَ مَرَّةً : \" وَيُجِيبُ الْإِمَامَ \" /27 * \r\n$9429  /2 /141 حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ L8488 /94 ، قَالَ : أَنَا /26 سُفْيَانُ بْنُ حُسَيْنٍ L3431 /26 ، عَنِ /26 الزُّهْرِيِّ L7272 /26 ، عَنْ /26 عُرْوَةَ L5594 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 إذَا كَانَ مُعْتَكِفًا لَمْ يَدْخُلِ الْبَيْتَ إلَّا لِحَاجَةٍ \" /27 * \r\n@ 2 : 501 @ \r\n$9430  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ /26 ، عَنْ /26 عَمْرَةَ /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 : \" أَنَّهَا كَانَتْ /20 تَمُرُّ بِالْمَرِيضِ مِنْ أَهْلِهَا وَهِيَ مُعْتَكِفَةٌ ، فَلا تَعْرِضُ لَهُ \" /27 * \r\n$9431  /8",
