      "chapter_id": null,
      "hadith_number": 12368,
      "text_ar": "حَدَّثَنَا /94 يَعْلَى /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 مُزَاحِمِ بْنِ زُفَرَ /26 ، /27 عَنِ /26 الضَّحَّاكِ /26 ، قَالَ : /20 \" لَوْ دَخَلْتُ عَلَى أُمِّي لَقُلْتُ : أَيَّتُهَا الْعَجُوزُ غَطِّي رَأْسَكِ \" /27 * \r\n$13153  /8 /141 حَدَّثَنَا /94 عَبْدُ الرَّحِيمِ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 سَالِمِ بْنِ أَبِي حَفْصَةَ /26 ، عَنْ /26 مُنْذِرٍ /26 ، /27 عَنِ /26 ابْنِ الْحَنَفِيَّةِ /26 : \" أَنَّهُ كَانَ /20 يُذَوِّبُ أُمَّهُ \" /27 * \r\n$13154  /8",
      "sanad_ar": "حَدَّثَنَا /94 يَعْلَى /94",
      "matn_ar": "عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 مُزَاحِمِ بْنِ زُفَرَ /26 ، /27 عَنِ /26 الضَّحَّاكِ /26 ، قَالَ : /20 \" لَوْ دَخَلْتُ عَلَى أُمِّي لَقُلْتُ : أَيَّتُهَا الْعَجُوزُ غَطِّي رَأْسَكِ \" /27 * \r\n$13153  /8 /141 حَدَّثَنَا /94 عَبْدُ الرَّحِيمِ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 سَالِمِ بْنِ أَبِي حَفْصَةَ /26 ، عَنْ /26 مُنْذِرٍ /26 ، /27 عَنِ /26 ابْنِ الْحَنَفِيَّةِ /26 : \" أَنَّهُ كَانَ /20 يُذَوِّبُ أُمَّهُ \" /27 * \r\n$13154  /8",
