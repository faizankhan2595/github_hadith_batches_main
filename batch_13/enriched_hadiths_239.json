      "hadith_number": 11201,
      "text_ar": "حَدَّثَنَا /94 هُشَيْمٌ /94 ، قال : نَا /26 يُونُسُ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، أَنَّهُ قَالَ : /20 \" فِي صَدَاقِ السِّرِّ ، إذَا أَعْلَنَ أَكْثَرَ مِنْهُ ؛ يُؤْخَذُ بِالسِّرِّ وَتَبْطُلُ الْعَلَانِيَةُ \" /27 . حَدَّثَنَا /94 هُشَيْمٌ /94 ، عَنْ /26 خَالِدٍ /26 ، عَنِ /26 ابْنِ سِيرِينَ /26 ، عَنْ /26 شُرَيْحٍ /26 ، قَالَ : \" يُؤْخَذُ بِالسِّرِّ وَتَبْطُلُ الْعَلَانِيَةُ \" . حَدَّثَنَا /94 مُعْتَمِرٌ /94 ، عَنْ /26 مَعْمَرٍ /26 ، عَنِ /26 الزُّهْرِيِّ /26 ، قَالَ : \" الْأَمْرُ عَلَى السِّرِّ \" * \r\n$12082  /8",
      "sanad_ar": "حَدَّثَنَا /94 هُشَيْمٌ /94",
      "matn_ar": "قال : نَا /26 يُونُسُ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، أَنَّهُ قَالَ : /20 \" فِي صَدَاقِ السِّرِّ ، إذَا أَعْلَنَ أَكْثَرَ مِنْهُ ؛ يُؤْخَذُ بِالسِّرِّ وَتَبْطُلُ الْعَلَانِيَةُ \" /27 . حَدَّثَنَا /94 هُشَيْمٌ /94 ، عَنْ /26 خَالِدٍ /26 ، عَنِ /26 ابْنِ سِيرِينَ /26 ، عَنْ /26 شُرَيْحٍ /26 ، قَالَ : \" يُؤْخَذُ بِالسِّرِّ وَتَبْطُلُ الْعَلَانِيَةُ \" . حَدَّثَنَا /94 مُعْتَمِرٌ /94 ، عَنْ /26 مَعْمَرٍ /26 ، عَنِ /26 الزُّهْرِيِّ /26 ، قَالَ : \" الْأَمْرُ عَلَى السِّرِّ \" * \r\n$12082  /8",
