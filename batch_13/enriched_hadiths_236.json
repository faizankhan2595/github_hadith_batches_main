      "hadith_id": 111531,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 11157,
      "text_ar": "حَدَّثَنَا /94 ابْنُ إدْرِيسَ /94 ، عَنْ /26 لَيْثِ بْنِ سَعْدٍ /26 ، عَنْ /26 سَعِيدِ بْنِ الْمُسَيِّبِ /26 ، قَالَ : /27 قَالَ /93 عُمَرُ L5913 /93 : /20 \" أَيُّمَا عَبْدٍ نَكَحَ حُرَّةً فَقَدْ أُعْتِقَ نِصْفُهُ , وَأَيُّمَا حُرٍّ نَكَحَ أَمَةً فَقَدْ أَرِقَ نِصْفَهُ \" /27 * \r\n$12046  /8",
      "sanad_ar": "حَدَّثَنَا /94 ابْنُ إدْرِيسَ /94",
      "matn_ar": "عَنْ /26 لَيْثِ بْنِ سَعْدٍ /26 ، عَنْ /26 سَعِيدِ بْنِ الْمُسَيِّبِ /26 ، قَالَ : /27 قَالَ /93 عُمَرُ L5913 /93 : /20 \" أَيُّمَا عَبْدٍ نَكَحَ حُرَّةً فَقَدْ أُعْتِقَ نِصْفُهُ , وَأَيُّمَا حُرٍّ نَكَحَ أَمَةً فَقَدْ أَرِقَ نِصْفَهُ \" /27 * \r\n$12046  /8",
