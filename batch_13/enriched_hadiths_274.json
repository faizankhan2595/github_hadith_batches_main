      "hadith_id": 112098,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 11724,
      "text_ar": "حَدَّثَنَا وَكِيعٌ عَنْ شُعْبَةَ عَنِ الْحَكَمِ عَنْ إِبْرَاهِيمَ قَالَ : \" بِثَلاثَةِ أَشْهُر . حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 مِسْعَرٍ /26 ، /26 وَسُفْيَانَ /26 ، عَنْ /26 عَبْدِ الْكَرِيمِ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : \" بِثَلَاثَةِ أَشْهُرٍ \" . حَدَّثَنَا /94 مُعْتَمِرُ بْنُ سُلَيْمَانَ /94 ، عَنْ /26 مَعْمَرٍ /26 ، عَنْ /26 صَدَقَةَ بْنِ يَسَارٍ /26 ، عَنْ /26 عُمَرَ بْنِ عَبْدِ الْعَزِيزِ /26 ، قَالَ : \" ثَلَاثَةُ أَشْهُرٍ ٍ \" *",
      "sanad_ar": "حَدَّثَنَا وَكِيعٌ عَنْ شُعْبَةَ عَنِ الْحَكَمِ عَنْ إِبْرَاهِيمَ قَالَ",
      "matn_ar": "\" بِثَلاثَةِ أَشْهُر . حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 مِسْعَرٍ /26 ، /26 وَسُفْيَانَ /26 ، عَنْ /26 عَبْدِ الْكَرِيمِ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : \" بِثَلَاثَةِ أَشْهُرٍ \" . حَدَّثَنَا /94 مُعْتَمِرُ بْنُ سُلَيْمَانَ /94 ، عَنْ /26 مَعْمَرٍ /26 ، عَنْ /26 صَدَقَةَ بْنِ يَسَارٍ /26 ، عَنْ /26 عُمَرَ بْنِ عَبْدِ الْعَزِيزِ /26 ، قَالَ : \" ثَلَاثَةُ أَشْهُرٍ ٍ \" *",
      "grade": null,
