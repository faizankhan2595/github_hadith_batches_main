    {
      "hadith_id": 108847,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 8473,
      "text_ar": "حَدَّثَنَا /94 عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ /94 ، عَنْ /26 حَمَّادِ بْنِ سَلَمَةَ /26 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ /26 : /27 \" أَنَّ /20 أُمَّهُ نَذَرَتْ أَنْ تَعْتَكِفَ عَشْرَةَ أَيَّامٍ فَمَاتَتْ وَلَمْ تَعْتَكِفْ ، فقَالَ /93 ابْنُ عَبَّاسٍ L4883 /93 : اعْتَكِفْ عَنْ أُمِّكَ \" /27 * \r\n$9482  /3 /141 حَدَّثَنَا /94 أَبُو الْأَحْوَصِ /94 ، عَنْ /26 إبْرَاهِيمَ بْنِ الْمُهَاجِرِ /26 ، عَنْ /26 عَامِرِ بْنِ مُصْعَبٍ /26 , /27 أَنَّ /93 عَائِشَةَ L4049 /93 /20 اعْتَكَفَتْ عَنْ أَخِيهَا بَعْدَ مَا مَاتَ \" /27 * \r\n%E1339",
      "sanad_ar": "حَدَّثَنَا /94 عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ /94",
      "matn_ar": "عَنْ /26 حَمَّادِ بْنِ سَلَمَةَ /26 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ /26 : /27 \" أَنَّ /20 أُمَّهُ نَذَرَتْ أَنْ تَعْتَكِفَ عَشْرَةَ أَيَّامٍ فَمَاتَتْ وَلَمْ تَعْتَكِفْ ، فقَالَ /93 ابْنُ عَبَّاسٍ L4883 /93 : اعْتَكِفْ عَنْ أُمِّكَ \" /27 * \r\n$9482  /3 /141 حَدَّثَنَا /94 أَبُو الْأَحْوَصِ /94 ، عَنْ /26 إبْرَاهِيمَ بْنِ الْمُهَاجِرِ /26 ، عَنْ /26 عَامِرِ بْنِ مُصْعَبٍ /26 , /27 أَنَّ /93 عَائِشَةَ L4049 /93 /20 اعْتَكَفَتْ عَنْ أَخِيهَا بَعْدَ مَا مَاتَ \" /27 * \r\n%E1339",
