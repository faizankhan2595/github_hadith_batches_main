      "hadith_id": 108853,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 8479,
      "text_ar": "حَدَّثَنَا /94 جَرِيرٌ /94 ، عَنْ /26 مَنْصُورٍ /26 ، /27 عَنْ /26 إبْرَاهِيمَ /26 ، قَالَ : /20 \" إذَا حَاضَتِ الْمُعْتَكِفَةُ ضَرَبَتْ فِي دَارِهَا سِتْرًا فَكَانَتْ فِيهِ \" /27 * \r\n$9486  /8",
