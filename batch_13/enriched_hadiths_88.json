    {
      "hadith_id": 109307,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 8933,
      "text_ar": "حَدَّثَنَا /94 ابْنُ مُبَارَكٍ /94 ، عَنِ /26 ابْنِ لَهِيعَةَ /26 ، قَالَ : حَدَّثَنِي /26 عَبْدُ اللَّهِ بْنُ أَبِي جَعْفَرٍ /26 ، /27 أَنَّ /26 عُمَرَ بْنَ عَبْدِ الْعَزِيزِ /26 ، كَتَبَ : /20 \" إذَا أُخِذَ مِنَ الزَّرْعِ الْعُشْرُ فَلَيْسَ فِيهِ زَكَاةٌ وَإنْ مَكَثَ عَشْرَ سِنِينَ \" /27 * \r\n$9892  /8",
      "sanad_ar": "حَدَّثَنَا /94 ابْنُ مُبَارَكٍ /94",
      "matn_ar": "عَنِ /26 ابْنِ لَهِيعَةَ /26 ، قَالَ : حَدَّثَنِي /26 عَبْدُ اللَّهِ بْنُ أَبِي جَعْفَرٍ /26 ، /27 أَنَّ /26 عُمَرَ بْنَ عَبْدِ الْعَزِيزِ /26 ، كَتَبَ : /20 \" إذَا أُخِذَ مِنَ الزَّرْعِ الْعُشْرُ فَلَيْسَ فِيهِ زَكَاةٌ وَإنْ مَكَثَ عَشْرَ سِنِينَ \" /27 * \r\n$9892  /8",
