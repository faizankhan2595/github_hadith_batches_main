      "hadith_id": 109248,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 8874,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 عُبَيْدِ اللَّهِ /26 ، عَنْ /26 نَافِعٍ /26 ، قَالَ : /27 /20 \" بَعَثَنِي /26 عُمَرُ بْنُ عَبْدِ الْعَزِيزِ /26 عَلَى الْيَمَنِ ، فَأَرَدْتُ أَنْ آخُذَ مِنَ الْعَسَلِ الْعُشْرَ ، قَالَ مُغِيرَةُ بْنُ حَكِيمٍ الصَّنْعَانِيُّ : \" لَيْسَ فِيهِ شَيْءٌ \" فَكَتَبْتُ إلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، فَقَالَ : صَدَقَ وَهُوَ عَدْلٌ رَضِيٍّ \" /27 * \r\n$9840  /8",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ /94",
      "matn_ar": "عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 عُبَيْدِ اللَّهِ /26 ، عَنْ /26 نَافِعٍ /26 ، قَالَ : /27 /20 \" بَعَثَنِي /26 عُمَرُ بْنُ عَبْدِ الْعَزِيزِ /26 عَلَى الْيَمَنِ ، فَأَرَدْتُ أَنْ آخُذَ مِنَ الْعَسَلِ الْعُشْرَ ، قَالَ مُغِيرَةُ بْنُ حَكِيمٍ الصَّنْعَانِيُّ : \" لَيْسَ فِيهِ شَيْءٌ \" فَكَتَبْتُ إلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، فَقَالَ : صَدَقَ وَهُوَ عَدْلٌ رَضِيٍّ \" /27 * \r\n$9840  /8",
      "grade": null,
      "page_number": null,
