    {
      "hadith_id": 110738,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 10364,
      "text_ar": "$11263  /3 /141 حَدَّثَنَا /94 عَلِيُّ بْنُ مُسْهِرٍ /94 ، عَنْ /26 عُبَيْدِ اللَّهِ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، أَنَّهُ كَانَ \" /20 إذَا صَلَّى عَلَى الْجِنَازَةِ رَفَعَ يَدَيْهِ فَكَبَّرَ ، فَإِذَا فَرَغَ سَلَّمَ عَلَى يَمِينِهِ وَاحِدَةً \" /27 * \r\n$11264  /3 /141 حَدَّثَنَا /94 حَفْصُ بْنُ غِيَاثٍ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 عُمَيْرِ بْنِ سَعِيدٍ /26 ، قَالَ : /27 /20 \" صَلَّى /93 عَلِيٌّ L5722 /93 عَلَى يَزِيدَ بْنِ الْمُكَفِّفِ ، فَكَبَّرَ عَلَيْهِ أَرْبَعًا وَسَلَّمَ تَسْلِيمَةً خَفِيَّةً عَنْ يَمِينِهِ \" /27 * \r\n$11265  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، /94 وَالْفَضْلُ بْنُ دُكَيْنٍ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 إبْرَاهِيمَ بْنِ الْمُهَاجِرِ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، أَنَّهُ كَانَ /20 \" يُسَلِّمُ عَلَى الْجِنَازَةِ تَسْلِيمَةً \" /27 * \r\n$11266  /3 /141 حَدَّثَنَا /94 أَبُو الْأَحْوَصِ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنِ /26 الْحَارِثِ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ خَلْفَهُ عَلَى جِنَازَةٍ فَسَلَّمَ عَنْ يَمِينِهِ حِينَ فَرَغَ السَّلَامُ عَلَيْكُمْ \" /27 * \r\n\u001cE1583 \r\n$11267  /8 /141 حَدَّثَنَا /94 ابْنُ نُمَيْرٍ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، /27 عَنْ /26 إبْرَاهِيمَ /26 ، أَنَّهُ كَانَ /20 \" يُسَلِّمُ عَلَى الْجِنَازَةِ تَسْلِيمَةً \" /27 * \r\n$11268  /8",
      "sanad_ar": "$11263  /3 /141 حَدَّثَنَا /94 عَلِيُّ بْنُ مُسْهِرٍ /94",
      "matn_ar": "عَنْ /26 عُبَيْدِ اللَّهِ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، أَنَّهُ كَانَ \" /20 إذَا صَلَّى عَلَى الْجِنَازَةِ رَفَعَ يَدَيْهِ فَكَبَّرَ ، فَإِذَا فَرَغَ سَلَّمَ عَلَى يَمِينِهِ وَاحِدَةً \" /27 * \r\n$11264  /3 /141 حَدَّثَنَا /94 حَفْصُ بْنُ غِيَاثٍ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 عُمَيْرِ بْنِ سَعِيدٍ /26 ، قَالَ : /27 /20 \" صَلَّى /93 عَلِيٌّ L5722 /93 عَلَى يَزِيدَ بْنِ الْمُكَفِّفِ ، فَكَبَّرَ عَلَيْهِ أَرْبَعًا وَسَلَّمَ تَسْلِيمَةً خَفِيَّةً عَنْ يَمِينِهِ \" /27 * \r\n$11265  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، /94 وَالْفَضْلُ بْنُ دُكَيْنٍ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 إبْرَاهِيمَ بْنِ الْمُهَاجِرِ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، أَنَّهُ كَانَ /20 \" يُسَلِّمُ عَلَى الْجِنَازَةِ تَسْلِيمَةً \" /27 * \r\n$11266  /3 /141 حَدَّثَنَا /94 أَبُو الْأَحْوَصِ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنِ /26 الْحَارِثِ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ خَلْفَهُ عَلَى جِنَازَةٍ فَسَلَّمَ عَنْ يَمِينِهِ حِينَ فَرَغَ السَّلَامُ عَلَيْكُمْ \" /27 * \r\n\u001cE1583 \r\n$11267  /8 /141 حَدَّثَنَا /94 ابْنُ نُمَيْرٍ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، /27 عَنْ /26 إبْرَاهِيمَ /26 ، أَنَّهُ كَانَ /20 \" يُسَلِّمُ عَلَى الْجِنَازَةِ تَسْلِيمَةً \" /27 * \r\n$11268  /8",
