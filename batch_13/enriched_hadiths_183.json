      "chapter_id": null,
      "hadith_number": 10357,
      "text_ar": "حَدَّثَنَا /94 أَبُو أَحْمَدَ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ /94 ، عَنْ /26 مُبَارَكٍ /26 ، عَنْ /26 يَعْقُوبَ /26 ، عَنْ /26 مَطَرٍ /26 ، /27 عَنْ /26 حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ /26 ، قَالَ : /20 \" يَقْضِي مَا فَاتَهُ مِنَ التَّكْبِيرِ عَلَى الْجِنَازَةِ \" /27 * \r\n@ 3 : 190 @\u001aE1582",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو أَحْمَدَ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ /94",
      "matn_ar": "عَنْ /26 مُبَارَكٍ /26 ، عَنْ /26 يَعْقُوبَ /26 ، عَنْ /26 مَطَرٍ /26 ، /27 عَنْ /26 حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ /26 ، قَالَ : /20 \" يَقْضِي مَا فَاتَهُ مِنَ التَّكْبِيرِ عَلَى الْجِنَازَةِ \" /27 * \r\n@ 3 : 190 @\u001aE1582",
