      "hadith_id": 110472,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 10098,
      "text_ar": "$10958  /3 /141 حَدَّثَنَا /94 هُشَيْمُ بْنُ بَشِيرٍ /94 ، عَنْ /26 أَبِي بِشْرٍ /26 ، عَنْ /26 يُوسُفَ بْنِ مَاهَكَ /26 ، قَالَ : /27 \" رَأَيْتُ /93 ابْنَ عُمَرَ L4967 /93 /20 فِي جِنَازَةٍ وَاضِعًا السَّرِيرَ كَاهِلَهُ بَيْنَ الْعَمُودَيْنِ \" /27 * \r\n$10959  /8 /141 حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنْ /26 خَالِدِ بْنِ أَبِي بَكْرٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَالِمَ بْنَ عَبْدِ اللَّهِ /26 /20 بَيْنَ عَمُودَيْ سَرِيرِ أُمِّهِ حَتَّى خَرَجَ بِهَا مِنَ الدَّارِ ، /26 وَحَمْزَةُ /26 , /26 وَعُبَيْدُ اللَّهِ /26 أَحَدُهُمَا آخِذٌ بِعِضَادَاتِ السَّرِيرِ الْيُمْنَى وَالْآخَرُ بِالْيُسْرَى \" /27 * \r\n$10960  /8 /141 حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنْ /26 مَعْرُوفٍ /26 مَوْلًى لِقُرَيْشٍ ، قَالَ : /27 \" رَأَيْتُ /26 الْمُطَّلِبَ بْنَ عَبْدِ اللَّهِ بْنِ حَنْطَبٍ /26 /20 بَيْنَ عَمُودَيْ سَرِيرِ ابْنِهِ الْحَارِثِ \" /27 * \r\n$10961  /3",
      "sanad_ar": "$10958  /3 /141 حَدَّثَنَا /94 هُشَيْمُ بْنُ بَشِيرٍ /94",
      "matn_ar": "عَنْ /26 أَبِي بِشْرٍ /26 ، عَنْ /26 يُوسُفَ بْنِ مَاهَكَ /26 ، قَالَ : /27 \" رَأَيْتُ /93 ابْنَ عُمَرَ L4967 /93 /20 فِي جِنَازَةٍ وَاضِعًا السَّرِيرَ كَاهِلَهُ بَيْنَ الْعَمُودَيْنِ \" /27 * \r\n$10959  /8 /141 حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنْ /26 خَالِدِ بْنِ أَبِي بَكْرٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَالِمَ بْنَ عَبْدِ اللَّهِ /26 /20 بَيْنَ عَمُودَيْ سَرِيرِ أُمِّهِ حَتَّى خَرَجَ بِهَا مِنَ الدَّارِ ، /26 وَحَمْزَةُ /26 , /26 وَعُبَيْدُ اللَّهِ /26 أَحَدُهُمَا آخِذٌ بِعِضَادَاتِ السَّرِيرِ الْيُمْنَى وَالْآخَرُ بِالْيُسْرَى \" /27 * \r\n$10960  /8 /141 حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنْ /26 مَعْرُوفٍ /26 مَوْلًى لِقُرَيْشٍ ، قَالَ : /27 \" رَأَيْتُ /26 الْمُطَّلِبَ بْنَ عَبْدِ اللَّهِ بْنِ حَنْطَبٍ /26 /20 بَيْنَ عَمُودَيْ سَرِيرِ ابْنِهِ الْحَارِثِ \" /27 * \r\n$10961  /3",
