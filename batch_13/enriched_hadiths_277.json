      "chapter_id": null,
      "hadith_number": 11769,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، عَنْ /26 حُسَيْنِ بْنِ عَلِيٍّ /26 ، عَنْ /26 زَائِدَةَ /26 ، عَنْ /26 عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ /26 ، /27 عَنِ /26 ابْن أَبِي مُلَيْكَةَ /26 ، قَالَ : /20 \" نزلت هَذِهِ الْآيَةُ : /4 وَلَنْ تَسْتَطِيعُوا أَنْ تَعْدِلُوا بَيْنَ النِّسَاءِ وَلَوْ حَرَصْتُمْ سورة النساء آية 129 /4 فِي عَائِشَةَ \" /27 . حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 أَشْعَثَ /26 ، عَنْ /26 مُحَمَّدٍ /26 ، عَنْ /26 عُبَيْدَةَ /26 ، قَالَ : \" الْحُبُّ وَالْجِمَاعُ \" * \r\n$12602  /8",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "عَنْ /26 حُسَيْنِ بْنِ عَلِيٍّ /26 ، عَنْ /26 زَائِدَةَ /26 ، عَنْ /26 عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ /26 ، /27 عَنِ /26 ابْن أَبِي مُلَيْكَةَ /26 ، قَالَ : /20 \" نزلت هَذِهِ الْآيَةُ : /4 وَلَنْ تَسْتَطِيعُوا أَنْ تَعْدِلُوا بَيْنَ النِّسَاءِ وَلَوْ حَرَصْتُمْ سورة النساء آية 129 /4 فِي عَائِشَةَ \" /27 . حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 أَشْعَثَ /26 ، عَنْ /26 مُحَمَّدٍ /26 ، عَنْ /26 عُبَيْدَةَ /26 ، قَالَ : \" الْحُبُّ وَالْجِمَاعُ \" * \r\n$12602  /8",
