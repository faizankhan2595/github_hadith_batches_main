      "chapter_id": null,
      "hadith_number": 11673,
      "text_ar": "حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، عَنْ /26 عَمْرٍو /26 ، عَنْ /26 عَطَاءٍ /26 ، /27 عَنْ /93 جَابِرٍ L2069 /93 ، قَالَ : \" كُنَّا /20 نَعْزِلُ وَالْقُرْآنُ يَنْزِلُ \" /27 * \r\n$12505  /8 /141 حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، عَنْ أَبِي الزِّنَادِ ، عَنْ /26 خَارِجَةَ بْنِ زَيْدٍ /26 ، /27 أَنَّ /26 زَيْدًا /26 ، \" كَانَ /20 يَعْزِلُ عَنْ جَارِيَةٍ لَهُ \" /27 . حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، عَنْ /26 عَمْرٍو /26 ، عَنْ /26 عِكْرِمَةَ /26 ، أَنَّ /26 زَيْدًا /26 ، /26 وَسَعْدًا /26 : \" كَانَا يَعْزِلَانِ \" * \r\n$12506  /3 /141 حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، عَنْ /26 عَمْرٍو /26 ، عَنْ /26 إسْمَاعِيلَ الشَّيْبَانِيِّ /26 ، أَنَّهُ /27 حَلَفَ عَلَى امْرَأَةِ /93 رَافِعِ بْنِ خَدِيجٍ L2865 /93 ، فَأَخْبَرَتْهُ أَنَّهُ \" كَانَ /20 يَعْزِلُ أَوْ يَعْزِلُ مِنْ قُرُوحٍ بِهَا كَيْ لَا يَغْتَسِلَ \" /27 * \r\n$12507  /3",
      "sanad_ar": "حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94",
      "matn_ar": "عَنْ /26 عَمْرٍو /26 ، عَنْ /26 عَطَاءٍ /26 ، /27 عَنْ /93 جَابِرٍ L2069 /93 ، قَالَ : \" كُنَّا /20 نَعْزِلُ وَالْقُرْآنُ يَنْزِلُ \" /27 * \r\n$12505  /8 /141 حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، عَنْ أَبِي الزِّنَادِ ، عَنْ /26 خَارِجَةَ بْنِ زَيْدٍ /26 ، /27 أَنَّ /26 زَيْدًا /26 ، \" كَانَ /20 يَعْزِلُ عَنْ جَارِيَةٍ لَهُ \" /27 . حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، عَنْ /26 عَمْرٍو /26 ، عَنْ /26 عِكْرِمَةَ /26 ، أَنَّ /26 زَيْدًا /26 ، /26 وَسَعْدًا /26 : \" كَانَا يَعْزِلَانِ \" * \r\n$12506  /3 /141 حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، عَنْ /26 عَمْرٍو /26 ، عَنْ /26 إسْمَاعِيلَ الشَّيْبَانِيِّ /26 ، أَنَّهُ /27 حَلَفَ عَلَى امْرَأَةِ /93 رَافِعِ بْنِ خَدِيجٍ L2865 /93 ، فَأَخْبَرَتْهُ أَنَّهُ \" كَانَ /20 يَعْزِلُ أَوْ يَعْزِلُ مِنْ قُرُوحٍ بِهَا كَيْ لَا يَغْتَسِلَ \" /27 * \r\n$12507  /3",
