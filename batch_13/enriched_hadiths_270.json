      "hadith_id": 112048,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 11674,
      "text_ar": "حَدَّثَنَا /94 أَبُو بَكْرِ بْنُ عَيَّاشٍ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنْ /26 زَائِدَةَ /26 ، عَنْ /26 عُمَرَ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، فِي قَوْلِهِ : /20 /4 نِسَاؤُكُمْ حَرْثٌ لَكُمْ سورة البقرة آية 223 /4 ، قَالَ : \" مَنْ شَاءَ أَنْ يَعْزِلَ فَلْيَعْزِلْ وَمَنْ شَاءَ أَنْ لَا يَعْزِلَ فَلَا يَعْزِلْ \" /27 * \r\n\u0018E1768 \r\n$12508  /8 /141 حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94 ، عَنِ /26 التَّيْمِيِّ /26 ، عَنْ /26 يَحْيَى بْنِ عَبَّادٍ /26 ، /27 أَنَّ /26 خَبَّابًا /26 \" كَانَ /20 يَعْزِلُ عَنْ سَرَارِيهِ \" /27 * \r\n$12509  /3 /141 حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94 ، عَنْ /26 يَحْيَى L8345 /26 ، /26 بْنِ أَبِي إِسْحَاقَ /26 ، عَنِ /26 ابْنِ سَعْدٍ /26 ، يَعني عَامِرًا ، /27 أَنَّ /93 سَعْدًا L3232 /93 ، /20 \" كَانَ يَعْزِلُ \" /27 * \r\n@ 3 : 340 @ \r\n$12510  /3 /141 حَدَّثَنَا /94 عَبْدُ الْأَعْلَى /94 ، عَنْ /26 يُونُسَ /26 ، عَنِ /26 الْحَسَنِ /26 ، فِي الْعَزْلِ : اخْتَلَفَ فِيهِ أَصْحَابُ النَّبِيِّ عَلَيْهِ السَّلامُ ، قَالَ : \" فَكَانَ /27 /93 زَيْدًا L3131 /93 ، /93 وَأَنَسُ بْنُ مَالِكٍ L720 /93 /20 يَعْزِلَانِ \" /27 * \r\n$12511  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 عَلِيِّ بْنِ مُبَارَكٍ /26 ، عَنْ /26 يَحْيَى /26 ، عَنْ /26 أَبِي سَلَمَةَ /26 ، /27 أَنَّ /93 زَيْدًا L3131 /93 ، /93 وَسَعْدًا L3232 /93 \" /20 كَانَا يَعْزِلَانِ \" /27 * \r\n$12512  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الضَّحَّاكِ /26 ، عَنْ /26 عُثْمَانَ /26 ، عَنْ /26 سَالِمٍ أَبِي النَّضْرِ /26 ، عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ أَفْلَحَ /26 ، قَالَ : /27 \" نَكَحْتُ أُمَّ وَلَدِ أَبِي أَيُّوبَ ، فَأَخْبَرَتْنِي أَنَّ /93 أَبَا أَيُّوبَ L2650 /93 /20 كَانَ يَعْزِلُ /27 ، وَأَخْبَرَتْنِي أُمُّ وَلَدِ /93 زَيْدِ بْنِ ثَابِتٍ L3131 /93 أَنَّهُ كَانَ يَعْزِلُ عنهَا \" . وَقَالَ سَالِمٌ : عَنْ /26 عَائِشَةَ ابْنَةِ سَعْدٍ /26 , \" أَنَّ /93 سَعْدًا L3232 /93 كَانَ يَعْزِلُ عَنْ أُمَّهَاتِ أَوْلَادِهِ \" * \r\n$12513  /3",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو بَكْرِ بْنُ عَيَّاشٍ /94",
      "matn_ar": "عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنْ /26 زَائِدَةَ /26 ، عَنْ /26 عُمَرَ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، فِي قَوْلِهِ : /20 /4 نِسَاؤُكُمْ حَرْثٌ لَكُمْ سورة البقرة آية 223 /4 ، قَالَ : \" مَنْ شَاءَ أَنْ يَعْزِلَ فَلْيَعْزِلْ وَمَنْ شَاءَ أَنْ لَا يَعْزِلَ فَلَا يَعْزِلْ \" /27 * \r\n\u0018E1768 \r\n$12508  /8 /141 حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94 ، عَنِ /26 التَّيْمِيِّ /26 ، عَنْ /26 يَحْيَى بْنِ عَبَّادٍ /26 ، /27 أَنَّ /26 خَبَّابًا /26 \" كَانَ /20 يَعْزِلُ عَنْ سَرَارِيهِ \" /27 * \r\n$12509  /3 /141 حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94 ، عَنْ /26 يَحْيَى L8345 /26 ، /26 بْنِ أَبِي إِسْحَاقَ /26 ، عَنِ /26 ابْنِ سَعْدٍ /26 ، يَعني عَامِرًا ، /27 أَنَّ /93 سَعْدًا L3232 /93 ، /20 \" كَانَ يَعْزِلُ \" /27 * \r\n@ 3 : 340 @ \r\n$12510  /3 /141 حَدَّثَنَا /94 عَبْدُ الْأَعْلَى /94 ، عَنْ /26 يُونُسَ /26 ، عَنِ /26 الْحَسَنِ /26 ، فِي الْعَزْلِ : اخْتَلَفَ فِيهِ أَصْحَابُ النَّبِيِّ عَلَيْهِ السَّلامُ ، قَالَ : \" فَكَانَ /27 /93 زَيْدًا L3131 /93 ، /93 وَأَنَسُ بْنُ مَالِكٍ L720 /93 /20 يَعْزِلَانِ \" /27 * \r\n$12511  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 عَلِيِّ بْنِ مُبَارَكٍ /26 ، عَنْ /26 يَحْيَى /26 ، عَنْ /26 أَبِي سَلَمَةَ /26 ، /27 أَنَّ /93 زَيْدًا L3131 /93 ، /93 وَسَعْدًا L3232 /93 \" /20 كَانَا يَعْزِلَانِ \" /27 * \r\n$12512  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الضَّحَّاكِ /26 ، عَنْ /26 عُثْمَانَ /26 ، عَنْ /26 سَالِمٍ أَبِي النَّضْرِ /26 ، عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ أَفْلَحَ /26 ، قَالَ : /27 \" نَكَحْتُ أُمَّ وَلَدِ أَبِي أَيُّوبَ ، فَأَخْبَرَتْنِي أَنَّ /93 أَبَا أَيُّوبَ L2650 /93 /20 كَانَ يَعْزِلُ /27 ، وَأَخْبَرَتْنِي أُمُّ وَلَدِ /93 زَيْدِ بْنِ ثَابِتٍ L3131 /93 أَنَّهُ كَانَ يَعْزِلُ عنهَا \" . وَقَالَ سَالِمٌ : عَنْ /26 عَائِشَةَ ابْنَةِ سَعْدٍ /26 , \" أَنَّ /93 سَعْدًا L3232 /93 كَانَ يَعْزِلُ عَنْ أُمَّهَاتِ أَوْلَادِهِ \" * \r\n$12513  /3",
