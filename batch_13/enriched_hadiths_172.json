    {
      "hadith_id": 110567,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 10193,
      "text_ar": "حَدَّثَنَا /94 جَرِيرٌ /94 ، عَنْ /26 مَنْصُورٍ /26 ، /27 عَنْ /26 إبْرَاهِيمَ /26 ، قَالَ : \" كَانُوا /20 إذَا أَخْرَجُوا الْجِنَازَةَ , أَغْلَقُوا الْبَابَ عَلَى النِّسَاءِ \" /27 * \r\n$11065  /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قال : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 مُثَنَّى بْنِ سَعِيدٍ /26 ، عَنْ /26 مُحَمَّدِ بْنِ الْمُنْتَشِرِ /26 ، قَالَ : /27 \" كَانَ /26 مَسْرُوقٌ /26 /20 لَا يُصَلِّي عَلَى جِنَازَةٍ مَعَهَا امْرَأَةٌ \" /27 * \r\n$11066  /8",
      "sanad_ar": "حَدَّثَنَا /94 جَرِيرٌ /94",
      "matn_ar": "عَنْ /26 مَنْصُورٍ /26 ، /27 عَنْ /26 إبْرَاهِيمَ /26 ، قَالَ : \" كَانُوا /20 إذَا أَخْرَجُوا الْجِنَازَةَ , أَغْلَقُوا الْبَابَ عَلَى النِّسَاءِ \" /27 * \r\n$11065  /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قال : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 مُثَنَّى بْنِ سَعِيدٍ /26 ، عَنْ /26 مُحَمَّدِ بْنِ الْمُنْتَشِرِ /26 ، قَالَ : /27 \" كَانَ /26 مَسْرُوقٌ /26 /20 لَا يُصَلِّي عَلَى جِنَازَةٍ مَعَهَا امْرَأَةٌ \" /27 * \r\n$11066  /8",
