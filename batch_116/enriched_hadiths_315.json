    {
      "hadith_id": 1039720,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 49166,
      "text_ar": "أخبرنا به /94 أبو الحسن بن البخاري L75025 /94 ، قال : أَنْبَأَنَا /26 أبو جعفر الصيدلاني L46610 /26 ، قال : أخبرنا /26 أَبُو عَلِيٍّ الْحَدَّادُ L14761 /26 ، قال : أخبرنا /26 أَبُو نعيم الحافظ L9927 /26 ، قال : أخبرنا /26 أبو القاسم الطبراني L18570 /26 ، قال : حَدَّثَنَا /26 علي بن عَبْد الْعَزِيزِ L24433 /26 ، قال : حَدَّثَنَا /26 أَبُو نعيم L1548 /26 ، قال : حَدَّثَنَا /26 مُحَمَّدُ بْنُ مروان الذهلي L30635 /26 ، قال : حَدَّثَنِي /26 أَبُو حازم L3483 /26 ، قال : /27 حَدَّثَنِي /93 أَبُو هريرة L4396 /93 ، أن رَسُول اللَّهِ صَلَّى اللَّهُ عليه وسلم ، قال : \" إن /20 ملكا من السماء ، لم يكن زارني ، فاستأذن الله في زيارتي ، فبشرني أن فاطمة سيدة نساء أمتي ، وأن الحسن والحسين سيدا شباب أهل الجنة \" . /27 رَوَاهُ عن أَحْمَد بن عثمان بن حكيم عن أبي نعيم ، فَوَقَعَ لَنَا بَدَلا عَالِيًا بدرجتين . أخرجه في الخصائص من رواية أبي أَحْمَد الزبيري عَنْهُ ، فوقع لنا عاليا بدرجتين . وذكر في أوله قصة . * \r\n@ 7614 ولهم شيخ آخر . يقال له @ 7615 [ 5597 ] تمييز",
      "sanad_ar": "أخبرنا به /94 أبو الحسن بن البخاري L75025 /94",
      "matn_ar": "قال : أَنْبَأَنَا /26 أبو جعفر الصيدلاني L46610 /26 ، قال : أخبرنا /26 أَبُو عَلِيٍّ الْحَدَّادُ L14761 /26 ، قال : أخبرنا /26 أَبُو نعيم الحافظ L9927 /26 ، قال : أخبرنا /26 أبو القاسم الطبراني L18570 /26 ، قال : حَدَّثَنَا /26 علي بن عَبْد الْعَزِيزِ L24433 /26 ، قال : حَدَّثَنَا /26 أَبُو نعيم L1548 /26 ، قال : حَدَّثَنَا /26 مُحَمَّدُ بْنُ مروان الذهلي L30635 /26 ، قال : حَدَّثَنِي /26 أَبُو حازم L3483 /26 ، قال : /27 حَدَّثَنِي /93 أَبُو هريرة L4396 /93 ، أن رَسُول اللَّهِ صَلَّى اللَّهُ عليه وسلم ، قال : \" إن /20 ملكا من السماء ، لم يكن زارني ، فاستأذن الله في زيارتي ، فبشرني أن فاطمة سيدة نساء أمتي ، وأن الحسن والحسين سيدا شباب أهل الجنة \" . /27 رَوَاهُ عن أَحْمَد بن عثمان بن حكيم عن أبي نعيم ، فَوَقَعَ لَنَا بَدَلا عَالِيًا بدرجتين . أخرجه في الخصائص من رواية أبي أَحْمَد الزبيري عَنْهُ ، فوقع لنا عاليا بدرجتين . وذكر في أوله قصة . * \r\n@ 7614 ولهم شيخ آخر . يقال له @ 7615 [ 5597 ] تمييز",
