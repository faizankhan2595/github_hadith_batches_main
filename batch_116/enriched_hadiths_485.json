    {
      "hadith_id": 1042270,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 51716,
      "text_ar": "عم الزبير بْن بكار سكن بغداد قال الزبير بْن بكار : أمه أمة الجبار بنت إِبْرَاهِيم بْن جعفر بْن مصعب بْن الزبير . /10 إِبْرَاهِيم بْن سعد /10 /10 وبشر بْن السري /10 /10 وحماد بْن عطيل بْن فضالة بْن رداد الليثي قال : وكان قد بلغ مائة سنة وسنتين /10 /10 والضحاك بْن عثمان بْن الضحاك بْن عثمان الحزامي /10 /10 وأبيه عَبْد اللَّهِ بْن مصعب بْن ثابت /10 /10 وعبد العزيز بْن أَبِي حازم /10 /10 وعبد العزيز بْن مُحَمَّد الدراوردي س /10 /10 ومالك بْن أنس ق كَانَ عنده عنه الموطأ /10 /10 والمغيرة بْن عَبْد الرحمن بْن الحارث المخزومي /10 /10 والمنذر بْن عَبْد اللَّهِ الحزامي /10",
      "sanad_ar": "عم الزبير بْن بكار سكن بغداد قال الزبير بْن بكار",
      "matn_ar": "أمه أمة الجبار بنت إِبْرَاهِيم بْن جعفر بْن مصعب بْن الزبير . /10 إِبْرَاهِيم بْن سعد /10 /10 وبشر بْن السري /10 /10 وحماد بْن عطيل بْن فضالة بْن رداد الليثي قال : وكان قد بلغ مائة سنة وسنتين /10 /10 والضحاك بْن عثمان بْن الضحاك بْن عثمان الحزامي /10 /10 وأبيه عَبْد اللَّهِ بْن مصعب بْن ثابت /10 /10 وعبد العزيز بْن أَبِي حازم /10 /10 وعبد العزيز بْن مُحَمَّد الدراوردي س /10 /10 ومالك بْن أنس ق كَانَ عنده عنه الموطأ /10 /10 والمغيرة بْن عَبْد الرحمن بْن الحارث المخزومي /10 /10 والمنذر بْن عَبْد اللَّهِ الحزامي /10",
