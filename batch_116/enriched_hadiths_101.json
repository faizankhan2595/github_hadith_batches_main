    {
      "hadith_id": 1036502,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 45948,
      "text_ar": "مولاهم المدني أخو إِسْمَاعِيل بْن جَعْفَر ، وكثير بْن جَعْفَر ، ويحيى بْن جَعْفَر ، ويعقوب بْن جَعْفَر /10 إِبْرَاهِيم بْن طهمان عس وهُوَ من أقرانه /10 /10 وإبراهيم بْن عقبة م /10 /10 وإِسْمَاعِيل بْن صخر الأيلي /10 /10 وحرام بْن عُثْمَان الأَنْصَارِيّ /10 /10 وحميد بْن أَبِي زينب /10 /10 وحميد الطويل خ /10 /10 وداود بْن الْحُصَيْن /10 /10 وزيد بْن أسلم خ م ت /10 /10 وسعد بْن إِسْحَاق بْن كَعْب بْن عجرة /10 /10 وأَبِي حازم سلمة بْن دينار المدني خ م /10 /10 وسهيل بْن أَبِي صَالِح /10 /10 وشريك بْن عَبْد اللَّهِ بْن أَبِي نمر خ م /10 /10 والضحاك بْن عُثْمَان الحزامي /10 /10 وعبد الله بْن سَعِيد بْن أَبِي سَعِيد المقبري /10 /10 وعبد الله بْن شبرمة س /10 /10 وأَبِي طوالة عَبْد اللَّهِ بْن عَبْد الرَّحْمَنِ بْن مَعْمَر الأَنْصَارِيّ خ /10 /10 وعتبة بْن مُسْلِم /10 /10 وعَمْرو بْن أَبِي عَمْرو مولى المطلب خ /10 /10 والعلاء بْن عَبْد الرَّحْمَنِ م /10 /10 ومُحَمَّد بْن طحلاء /10 /10 ومعاوية بْن أَبِي مزرد /10 /10 وموسى بْن عقبة د س ق /10 /10 وأَبِي سهيل نافع بْن مَالِك بْن أَبِي عَامِر /10 /10 وهشام بْن عروة خ م /10 /10 ويحيى بْن سَعِيد الأَنْصَارِيّ خ /10 /10 ويزيد بْن خصيفة /10 /10 ويزيد بْن الهاد /10 /10 ويعقوب بْن زَيْد بْن طَلْحَة التَّيْمِيّ /10 /10 وأَبِي جزرة يَعْقُوب بْن مجاهد /10 /10 ويونس بْن يَزِيد الأيلي /10",
      "sanad_ar": "مولاهم المدني أخو إِسْمَاعِيل بْن جَعْفَر",
      "matn_ar": "وكثير بْن جَعْفَر ، ويحيى بْن جَعْفَر ، ويعقوب بْن جَعْفَر /10 إِبْرَاهِيم بْن طهمان عس وهُوَ من أقرانه /10 /10 وإبراهيم بْن عقبة م /10 /10 وإِسْمَاعِيل بْن صخر الأيلي /10 /10 وحرام بْن عُثْمَان الأَنْصَارِيّ /10 /10 وحميد بْن أَبِي زينب /10 /10 وحميد الطويل خ /10 /10 وداود بْن الْحُصَيْن /10 /10 وزيد بْن أسلم خ م ت /10 /10 وسعد بْن إِسْحَاق بْن كَعْب بْن عجرة /10 /10 وأَبِي حازم سلمة بْن دينار المدني خ م /10 /10 وسهيل بْن أَبِي صَالِح /10 /10 وشريك بْن عَبْد اللَّهِ بْن أَبِي نمر خ م /10 /10 والضحاك بْن عُثْمَان الحزامي /10 /10 وعبد الله بْن سَعِيد بْن أَبِي سَعِيد المقبري /10 /10 وعبد الله بْن شبرمة س /10 /10 وأَبِي طوالة عَبْد اللَّهِ بْن عَبْد الرَّحْمَنِ بْن مَعْمَر الأَنْصَارِيّ خ /10 /10 وعتبة بْن مُسْلِم /10 /10 وعَمْرو بْن أَبِي عَمْرو مولى المطلب خ /10 /10 والعلاء بْن عَبْد الرَّحْمَنِ م /10 /10 ومُحَمَّد بْن طحلاء /10 /10 ومعاوية بْن أَبِي مزرد /10 /10 وموسى بْن عقبة د س ق /10 /10 وأَبِي سهيل نافع بْن مَالِك بْن أَبِي عَامِر /10 /10 وهشام بْن عروة خ م /10 /10 ويحيى بْن سَعِيد الأَنْصَارِيّ خ /10 /10 ويزيد بْن خصيفة /10 /10 ويزيد بْن الهاد /10 /10 ويعقوب بْن زَيْد بْن طَلْحَة التَّيْمِيّ /10 /10 وأَبِي جزرة يَعْقُوب بْن مجاهد /10 /10 ويونس بْن يَزِيد الأيلي /10",
