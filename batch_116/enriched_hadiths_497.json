      "hadith_id": 1042442,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 51888,
      "text_ar": "أخبرنا به /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ L62448 /26 ، قال : أخبرنا /26 ابْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 ابْنُ الْمُذْهِبِ L14991 /26 ، قال : أخبرنا /26 الْقَطِيعِيُّ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 حَسَنُ بْنُ مُوسَى L1304 /26 ، قال : حدثنا /26 مُطِيعُ بْنُ مَيْمُونَ الْعَنْبَرِيُّ يُكَنَّى أَبَا سَعِيدٍ L7540 /26 ، قال : حَدَّثَتْنِي /26 صَفِيَّةُ ابْنَةُ عِصْمَةَ L3955 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 أُمِّ الْمُؤْمِنِينَ ، قال : مَدَّتِ امْرَأَةٌ مِنْ ورَاءِ السِّتْرِ يَدَهَا بِكِتَابٍ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، فَقَبَضَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ يَدَهُ ، وقال : /20 \" مَا أَدْرِي أَيَدُ رَجُلٍ أَوْ يَدُ امْرَأَةٍ \" ، فَقَالَتْ : بَلِ امْرِأَةٍ ، فَقَالَ : \" لَوْ كُنْتِ امْرَأَةً غَيَّرْتِ أَظْفَارَكِ بِالْحِنَّاءِ \" /27 . رَوَاهُ أَبُو دَاوُدَ ، عَنْ مُحَمَّدِ بْنِ مُحَمَّدٍ الصُّورِيِّ ، عَنْ خَالِدِ بْنِ عَبْدِ الرَّحْمَنِ . ورَوَاهُ النَّسَائِيُّ ، عَنْ عَمْرِو بْنِ مَنْصُورٍ ، عَنْ مُعَلَّى بْنِ أَسَدٍ ، جَمِيعًا عَنْهُ * \r\n@ 8152 من اسمه مظاهر ومظفر @ 8153 [ 6016 ] د ت ق\u0019E4930",
      "sanad_ar": "أخبرنا به /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94",
      "matn_ar": "/94 وأَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ L62448 /26 ، قال : أخبرنا /26 ابْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 ابْنُ الْمُذْهِبِ L14991 /26 ، قال : أخبرنا /26 الْقَطِيعِيُّ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 حَسَنُ بْنُ مُوسَى L1304 /26 ، قال : حدثنا /26 مُطِيعُ بْنُ مَيْمُونَ الْعَنْبَرِيُّ يُكَنَّى أَبَا سَعِيدٍ L7540 /26 ، قال : حَدَّثَتْنِي /26 صَفِيَّةُ ابْنَةُ عِصْمَةَ L3955 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 أُمِّ الْمُؤْمِنِينَ ، قال : مَدَّتِ امْرَأَةٌ مِنْ ورَاءِ السِّتْرِ يَدَهَا بِكِتَابٍ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، فَقَبَضَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ يَدَهُ ، وقال : /20 \" مَا أَدْرِي أَيَدُ رَجُلٍ أَوْ يَدُ امْرَأَةٍ \" ، فَقَالَتْ : بَلِ امْرِأَةٍ ، فَقَالَ : \" لَوْ كُنْتِ امْرَأَةً غَيَّرْتِ أَظْفَارَكِ بِالْحِنَّاءِ \" /27 . رَوَاهُ أَبُو دَاوُدَ ، عَنْ مُحَمَّدِ بْنِ مُحَمَّدٍ الصُّورِيِّ ، عَنْ خَالِدِ بْنِ عَبْدِ الرَّحْمَنِ . ورَوَاهُ النَّسَائِيُّ ، عَنْ عَمْرِو بْنِ مَنْصُورٍ ، عَنْ مُعَلَّى بْنِ أَسَدٍ ، جَمِيعًا عَنْهُ * \r\n@ 8152 من اسمه مظاهر ومظفر @ 8153 [ 6016 ] د ت ق\u0019E4930",
