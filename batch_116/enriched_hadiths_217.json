    {
      "hadith_id": 1038243,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 47689,
      "text_ar": "من شميهين قرية من قرى مرو /10 أبي إِسْحَاق إِبْرَاهِيم بْن إِسْحَاق الطالقاني مق /10 /10 وجعفر بْن عون /10 /10 وحاتم بْن يوسف الجلاب /10 /10 وحبيب بْن أبي حبيب المروزي /10 /10 والْحَسَن بْن بشر البجلي /10 /10 والْحَسَن بْن الربيع البوراني /10 /10 والْحَسَن بْن عيسى الماسرجسي /10 /10 وحفص بْن حميد الأكاف /10 /10 وسلمة بْن سليمان المروزي م /10 /10 والعباس بْن رزمة مق /10 /10 وعبد اللَّه بْن عثمان عبدان م /10 /10 وعبد العزيز بْن أبي رزمة /10 /10 وعبد الملك بْن إِبْرَاهِيم الجدي /10 /10 وعلي بْن الْحَسَن بْن شقيق م /10 /10 وعلي بْن الْحُسَيْن بْن واقد مق /10 /10 وأبي الوزير مُحَمَّد بْن أعين /10 /10 ومُحَمَّد بْن معاوية السمرقندي خال عبد اللَّه بْن عبد الرحمن الدارمي /10 /10 ونصر بْن حاجب المروزي /10 /10 والنضر بْن شميل /10 /10 ووهب بْن زمعة المروزي مق /10 /10 ويَحْيَى بْن إِسْحَاق الكاشغري /10 /10 ويَحْيَى بْن نصر بْن حاجب القرشي /10 /10 ويزيد بْن أبي حكيم العدني /10 /10 ويعلى بْن عبيد الطنافسي /10",
