    {
      "hadith_id": 1043782,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 53228,
      "text_ar": "0 /11 أَبُو داود /11 /11 وإبراهيم بْن إسحاق الحربي /11 /11 والحسن بْن المفضل بْن السمح البوصرائي /11 /11 وعباس بْن أَبِي طالب /11 /11 وعباس بْن مُحَمَّد الدوري /11 /11 وأبو بكر عَبْد اللَّهِ بْن مُحَمَّد بْن أَبِي الدنيا /11 /11 ومحمد بْن الحسين البرجلاني /11 /11 ومحمد بْن سليمان بْن سهل بْن زريق البغدادي /11 /11 ومحمد بْن الفضل بْن جابر السقطي /11 ++ قال البخاري : مهدي بْن حفص كَانَ ببغداد . # وقال",
      "sanad_ar": "0 /11 أَبُو داود /11 /11 وإبراهيم بْن إسحاق الحربي /11 /11 والحسن بْن المفضل بْن السمح البوصرائي /11 /11 وعباس بْن أَبِي طالب /11 /11 وعباس بْن مُحَمَّد الدوري /11 /11 وأبو بكر عَبْد اللَّهِ بْن مُحَمَّد بْن أَبِي الدنيا /11 /11 ومحمد بْن الحسين البرجلاني /11 /11 ومحمد بْن سليمان بْن سهل بْن زريق البغدادي /11 /11 ومحمد بْن الفضل بْن جابر السقطي /11 ++ قال البخاري",
