    {
      "hadith_id": 1040848,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 50294,
      "text_ar": "أَخْبَرَنَا به /94 أبو الفرج بن قدامة L46136 /94 ، /94 وأَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، /94 وأبو الغنائم بن علان L46139 /94 ، /94 وأحمد بن شيبان L75042 /94 ، /94 وزينب بنت مكي L75040 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ الْمُذْهَبِ L14991 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مَالِكٍ L8994 /26 ، قال : حَدَّثَنَا /26 عبد الله بن أحمد L4657 /26 ، قال : حَدَّثَنِي /26 أبي L488 /26 ، قال : حَدَّثَنَا /26 زَيْدُ بْنُ الْحُبَابِ L3124 /26 ، قال : حَدَّثَنَا /26 مُعَاوِيَةُ بْنُ صَالِحٍ L7584 /26 ، قال : حَدَّثَنِي /26 حَاتِمُ بْنُ حُرَيْثٍ L2211 /26 ، عَنْ /26 مَالِكِ بْنِ أَبِي مَرْيَمَ L6658 /26 ، قال : كُنَّا جُلُوسًا مَعَ رَبِيعَةَ الْجُرَشِيِّ ، فَتَذَاكَرْنَا الطِّلاءَ فِي خِلافَةِ الضَّحَّاكِ بْنِ قَيْسٍ ، فَإِنَّا لَكَذَلِكَ إِذْ دَخَلَ عَلَيْنَا عَبْدُ الرَّحْمَنِ بْنُ غَنْمٍ صَاحِبُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، فَقُلْنَا : اذْكُرُوا الطِّلاءَ فَتَذَاكَرْنَا الطِّلاءَ ، قال عَبْدُ اللَّهِ : قال أَبِي : كَذَا قال زَيْدُ بْنُ الْحُبَابِ ، قال : /27 حَدَّثَنِي /93 أَبُو مَالِكٍ الأَشْعَرِيُّ L322 /93 أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، يَقُولُ : \" /20 لَيَشْرَبَنَّ نَاسٌ مِنْ أُمَّتِي الْخَمْرَ يُسَمُّونَهَا بِغَيْرِ اسْمِهَا \" /27 . والَّذِي حَدَّثَنِي أَصْدَقُ مِنِّي ومِنْكَ ، والَّذِي حَدَّثَ به أَصْدَقُ مِنْهُ ومِنِّي ومِنْكَ ، فَقَالَ : واللَّهِ الَّذِي لا إِلهَ إِلا هُوَ لَقَدْ سَمِعْتُهُ مِنْ أَبِي مَالِكٍ الأَشْعَرِيِّ ، سَمِعَهُ مِنَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، فَرَدَّدَ عَلَيْهِ ثَلاثًا ، فَقَالَ الضَّحَّاكُ : أُفٍّ لَهُ مِنْ شَرَابِ آخِرِ الدَّهْرِ ، رَوَاهُ أَبُو دَاوُدَ ، عَنْ أَحْمَدَ بْنِ حَنْبَلٍ ، فَوَافَقْنَاهُ فِيهِ بِعُلُوٍ ، ولَمْ يَذْكُرِ الْقِصَّةَ بِتَمَامِهَا ، ورَوَاهُ ابنُ مَاجَهْ ، عَنْ عَبْدِ اللَّهِ بْنِ سَعِيدٍ الأَشَجِّ ، عَنْ مَعَنِ بْنِ عِيسَى ، عَنْ مُعَاوِيَةَ بْنِ صَالِحٍ ، نَحْوَهُ * \r\n@ 7816 [ 5752 ] ت(E4801",
      "sanad_ar": "أَخْبَرَنَا به /94 أبو الفرج بن قدامة L46136 /94",
      "matn_ar": "/94 وأَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، /94 وأبو الغنائم بن علان L46139 /94 ، /94 وأحمد بن شيبان L75042 /94 ، /94 وزينب بنت مكي L75040 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ الْمُذْهَبِ L14991 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مَالِكٍ L8994 /26 ، قال : حَدَّثَنَا /26 عبد الله بن أحمد L4657 /26 ، قال : حَدَّثَنِي /26 أبي L488 /26 ، قال : حَدَّثَنَا /26 زَيْدُ بْنُ الْحُبَابِ L3124 /26 ، قال : حَدَّثَنَا /26 مُعَاوِيَةُ بْنُ صَالِحٍ L7584 /26 ، قال : حَدَّثَنِي /26 حَاتِمُ بْنُ حُرَيْثٍ L2211 /26 ، عَنْ /26 مَالِكِ بْنِ أَبِي مَرْيَمَ L6658 /26 ، قال : كُنَّا جُلُوسًا مَعَ رَبِيعَةَ الْجُرَشِيِّ ، فَتَذَاكَرْنَا الطِّلاءَ فِي خِلافَةِ الضَّحَّاكِ بْنِ قَيْسٍ ، فَإِنَّا لَكَذَلِكَ إِذْ دَخَلَ عَلَيْنَا عَبْدُ الرَّحْمَنِ بْنُ غَنْمٍ صَاحِبُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، فَقُلْنَا : اذْكُرُوا الطِّلاءَ فَتَذَاكَرْنَا الطِّلاءَ ، قال عَبْدُ اللَّهِ : قال أَبِي : كَذَا قال زَيْدُ بْنُ الْحُبَابِ ، قال : /27 حَدَّثَنِي /93 أَبُو مَالِكٍ الأَشْعَرِيُّ L322 /93 أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، يَقُولُ : \" /20 لَيَشْرَبَنَّ نَاسٌ مِنْ أُمَّتِي الْخَمْرَ يُسَمُّونَهَا بِغَيْرِ اسْمِهَا \" /27 . والَّذِي حَدَّثَنِي أَصْدَقُ مِنِّي ومِنْكَ ، والَّذِي حَدَّثَ به أَصْدَقُ مِنْهُ ومِنِّي ومِنْكَ ، فَقَالَ : واللَّهِ الَّذِي لا إِلهَ إِلا هُوَ لَقَدْ سَمِعْتُهُ مِنْ أَبِي مَالِكٍ الأَشْعَرِيِّ ، سَمِعَهُ مِنَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، فَرَدَّدَ عَلَيْهِ ثَلاثًا ، فَقَالَ الضَّحَّاكُ : أُفٍّ لَهُ مِنْ شَرَابِ آخِرِ الدَّهْرِ ، رَوَاهُ أَبُو دَاوُدَ ، عَنْ أَحْمَدَ بْنِ حَنْبَلٍ ، فَوَافَقْنَاهُ فِيهِ بِعُلُوٍ ، ولَمْ يَذْكُرِ الْقِصَّةَ بِتَمَامِهَا ، ورَوَاهُ ابنُ مَاجَهْ ، عَنْ عَبْدِ اللَّهِ بْنِ سَعِيدٍ الأَشَجِّ ، عَنْ مَعَنِ بْنِ عِيسَى ، عَنْ مُعَاوِيَةَ بْنِ صَالِحٍ ، نَحْوَهُ * \r\n@ 7816 [ 5752 ] ت(E4801",
