      "hadith_id": 1036418,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 45864,
      "text_ar": "ويقال ابْن خضر الهباري أَبُو عَبْد اللَّهِ الكوفي /10 إِبْرَاهِيم بْن هراسة /10 /10 وأسباط بْن مُحَمَّد القرشي /10 /10 وإِسْمَاعِيل بْن حَمَّاد بْن أَبِي حنيفة /10 /10 وجعفر بْن عون /10 /10 والحسين بْن عَبْد الرَّحْمَنِ /10 /10 وأَبِي جنادة حصين بْن مخارق /10 /10 وأَبِي أُسَامَة حَمَّاد بْن أُسَامَة /10 /10 وحنان بْن سدير الصَّيْرَفِيّ /10 /10 وزيد بْن الحباب /10 /10 وشبابة بْن سَوَّار /10 /10 وعبد الله بْن نُمَيْر فق /10 /10 وعبد الحميد بْن عَبْد الرَّحْمَنِ الحماني /10 /10 وأَبِي نُعَيْم عَبْد الرَّحْمَنِ بْن هاني النخعي ق /10 /10 وعثمان بْن عَبْد الرَّحْمَنِ الطرائفي /10 /10 وعلي بْن بكار المصيصي /10 /10 وأَبِي دَاوُد عُمَر بْن سَعْد الحفري /10 /10 ومُحَمَّد بْن الْقَاسِم الأسدي /10 /10 ومصعب بْن المقدام /10 /10 ومعاوية بْن هشام /10 /10 والوليد بْن الْقَاسِم الهمداني /10 /10 ويعلى بْن عبيد /10 /10 ويونس بْن بكير /10",
