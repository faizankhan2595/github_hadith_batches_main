    {
      "hadith_id": 1041535,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 50981,
      "text_ar": "المعروف بمرة الطيب ، ومرة الخير لقب بذلك لعبادته /10 حذيفة بْن اليمان عخ /10 /10 وزيد بْن أرقم عَبْد الله بْن مسعود ع /10 /10 وعلقمة بْن قيس /10 /10 وعلي بْن أبي طالب /10 /10 وعمر بْن الخطاب ق /10 /10 وأبي بكر الصديق ت ق /10 /10 وأبي ذر الغفاري /10 /10 وأبي موسى الأشعري خ م ت س ق /10",
      "sanad_ar": "المعروف بمرة الطيب",
      "matn_ar": "ومرة الخير لقب بذلك لعبادته /10 حذيفة بْن اليمان عخ /10 /10 وزيد بْن أرقم عَبْد الله بْن مسعود ع /10 /10 وعلقمة بْن قيس /10 /10 وعلي بْن أبي طالب /10 /10 وعمر بْن الخطاب ق /10 /10 وأبي بكر الصديق ت ق /10 /10 وأبي ذر الغفاري /10 /10 وأبي موسى الأشعري خ م ت س ق /10",
