    {
      "hadith_id": 1041447,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 50893,
      "text_ar": "ويقال : ابن أبي سعد الفزاري أَبُو سعد الدمشقي /10 إسماعيل بْن عبيد الله بْن أبي المهاجر /10 /10 وحيان أبي النضر /10 /10 وأبي إدريس عَبْد الرحمن بْن عراك العذري /10 /10 وعروة بْن رويم اللخمي /10 /10 وعلي بْن يزيد الألهاني /10 /10 ويحيى بْن الحارث الذماري ، وقرأ عليه القرآن بحرف بْن عامر /10 /10 ويزيد بْن عبيدة /10 /10 ويونس بْن ميسرة بْن حلبس د /10",
      "sanad_ar": "ويقال",
      "matn_ar": "ابن أبي سعد الفزاري أَبُو سعد الدمشقي /10 إسماعيل بْن عبيد الله بْن أبي المهاجر /10 /10 وحيان أبي النضر /10 /10 وأبي إدريس عَبْد الرحمن بْن عراك العذري /10 /10 وعروة بْن رويم اللخمي /10 /10 وعلي بْن يزيد الألهاني /10 /10 ويحيى بْن الحارث الذماري ، وقرأ عليه القرآن بحرف بْن عامر /10 /10 ويزيد بْن عبيدة /10 /10 ويونس بْن ميسرة بْن حلبس د /10",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10",
