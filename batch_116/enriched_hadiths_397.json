    {
      "hadith_id": 1040951,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 50397,
      "text_ar": "2 ++ وقال مُحَمَّد بْن عمر بْن علي بْن مقدم عَنْ مُحَمَّد بْن عرعرة : جاء شعبة إلى المبارك بْن فضالة فسأله عَنْ حديث نصر بْن راشد عَنْ جابر أن النبي صَلَّى اللَّهُ عليه وسلم \" نهى أن يجصص القبر أو يبنى عليه \" ++ وقال عمرو بْن العباس الباهلي عَنْ عَبْد الرحمن بْن مهدي : حللنا عَنْ حبوة الثوري لما أردنا غسله فإذا في حبوته رقاع يسأل المبارك بْن فضالة عَنْ حديث كذا ++ وقال نعيم بْن حماد عَنْ عَبْد الرحمن بْن مهدي : لم نكتب للمبارك شيئا الا شيئا يقول فيه : سمعت الْحَسَن # وقال",
      "sanad_ar": "2 ++ وقال مُحَمَّد بْن عمر بْن علي بْن مقدم عَنْ مُحَمَّد بْن عرعرة",
      "matn_ar": "جاء شعبة إلى المبارك بْن فضالة فسأله عَنْ حديث نصر بْن راشد عَنْ جابر أن النبي صَلَّى اللَّهُ عليه وسلم \" نهى أن يجصص القبر أو يبنى عليه \" ++ وقال عمرو بْن العباس الباهلي عَنْ عَبْد الرحمن بْن مهدي : حللنا عَنْ حبوة الثوري لما أردنا غسله فإذا في حبوته رقاع يسأل المبارك بْن فضالة عَنْ حديث كذا ++ وقال نعيم بْن حماد عَنْ عَبْد الرحمن بْن مهدي : لم نكتب للمبارك شيئا الا شيئا يقول فيه : سمعت الْحَسَن # وقال",
      "grade": null,
