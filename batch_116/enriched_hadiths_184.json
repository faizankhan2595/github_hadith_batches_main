      "hadith_id": 1037757,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 47203,
      "text_ar": "مولى الأنصار أخو داود بْن صالح وخطاب بْن صالح رأى سعيد بْن المسيب /10 حميد بْن نافع /10 /10 وسَعْد بْن إِبْرَاهِيم س /10 /10 وسُفْيَان بْن عاصم بْن عبد العزيز بْن مروان بْن الحكم /10 /10 وأبي حازم سلمان الأشجعي /10 /10 وصفوان بْن سليم /10 /10 وعاصم بْن عمر بْن قتادة /10 /10 وعثمان بْن عبد اللَّه بْن سراقة /10 /10 وعمر بْن عبد العزيز /10 /10 والْقَاسِمِ بْن مُحَمَّد بْن أبي بكر الصديق /10 /10 ومُحَمَّد بْن مسلم بْن شهاب الزهري د ت ق /10 /10 ومُحَمَّد بْن المنكدر /10 /10 ويزيد بْن رومان /10 /10 ويزيد بْن زيد مولى بني ساعدة /10 /10 ويعقوب بْن عمر بْن قتادة /10",
