    {
      "hadith_id": 1037936,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 47382,
      "text_ar": "0 /11 الْبُخَارِي /11 /11 ومسلم /11 /11 وإِبْرَاهِيم بْن هاشم البغوي /11 /11 وأَحْمَد بْن الخطاب التستري /11 /11 وأَحْمَد بْن سعيد الدارمي ت /11 /11 وأَبُو بكر أَحْمَد بْن علي بْن سعيد القاضي المروزي س /11 /11 وأَبُو يعلى أَحْمَد بْن علي بْن المثنى الموصلي /11 /11 وأَحْمَد بْن علي الخزاز المقرئ /11 /11 وأَبُو الْحَسَن أَحْمَد بْن الْقَاسِمِ بْن مُحَمَّد بْن سليمان الطائي البرتي /11 /11 وجعفر بْن مُحَمَّد الفريابي /11 /11 والْحَسَن بْن علي بْن شبيب المعمري /11 /11 والْحَسَن بْن علي بْن ياسر البغدادي /11 /11 وأَبُو عبد اللَّه الْحُسَيْن بْن أَحْمَد بْن منصور سجادة /11 /11 وسليمان بْن توبة النهرواني ق /11 /11 وعبد اللَّه بْن أَحْمَد بْن زياد الهمذاني الدحيمي /11 /11 وعبد اللَّه بْن أَحْمَد بْن مُحَمَّد بْن حَنْبَل /11 /11 وعبد اللَّه بْن مُحَمَّد بْن أبي الدنيا /11 /11 وعبد اللَّه بْن مُحَمَّد البغوي /11 /11 وعبد اللَّه بْن مُحَمَّد السمري /11 /11 وعثمان بْن خرزاذ الأنطاكي س /11 /11 والْقَاسِمِ بْن زكريا المطرز /11 /11 ومُحَمَّد بْن   إِسْحَاق الصاغاني /11 /11 ومُحَمَّد بْن السري بْن مهران الناقد /11 /11 ومُحَمَّد بْن عبد اللَّه بْن بكر السراج العسكري /11 /11 ومُحَمَّد بْن علي بْن داود ابْن أخت غزال /11 /11 ومُحَمَّد بْن علي المديني فستقة /11 /11 ومُحَمَّد بْن يَحْيَى بْن مندة الأصبهاني /11 /11 ومُحَمَّد بْن يَحْيَى الذهلي /11 /11 ومعاذ بْن المثنى بْن معاذ العنبري /11 /11 وموسى بْن هارون الحافظ /11 /11 ويعقوب بْن سُفْيَان الفارسي /11 # قال",
