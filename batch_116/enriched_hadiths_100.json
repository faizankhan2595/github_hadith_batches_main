    {
      "hadith_id": 1036494,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 45940,
      "text_ar": "0 /11 مُسْلِم /11 /11 وأَبُو دَاوُد /11 /11 وإبراهيم بْن عَبْد اللَّهِ بْن الجنيد الختلي /11 /11 وأَحْمَد بْن بَشِير الطيالسي /11 /11 وأَحْمَد بْن أَبِي خَيْثَمَة /11 /11 وأَبُو بَكْر أَحْمَد بْن علي بْن سَعِيد الْمَرْوَزِيّ الْقَاضِي س /11 /11 وأَبُو يَعْلَى أَحْمَد بْن علي بْن المثنى الْمَوْصِلِيّ /11 /11 وأَحْمَد بْن علي الأبار /11 /11 وأَبُو الْعَبَّاس أَحْمَد بْن مُحَمَّد بْن عِيسَى البرتي الْقَاضِي /11 /11 وأَبُو بَكْر أَحْمَد بْن مُحَمَّد بْن مَنْصُور الحاسب /11 /11 والحارث بْن مُحَمَّد بْن أَبِي أُسَامَة /11 /11 وحرب بْن إِسْمَاعِيل الكرماني /11 /11 والحسن بْن سُفْيَان النسائي /11 /11 والحسن بْن علي بْن شَبِيب المعمري /11 /11 وعباس بْن مُحَمَّد الدوري /11 /11 وعبد الله بْن أَحْمَد بْن حَنْبَل /11 /11 وعبد الله بْن مُحَمَّد بْن أَبِي الدنيا /11 /11 وعبد الله بْن مُحَمَّد بْن عبد العزيز الْبَغَوِيّ /11 /11 ومُحَمَّد بْن حزابة العابد /11 /11 ومُحَمَّد بْن عبدوس بْن كَامِل السراج /11 /11 ومُحَمَّد بْن واصل المقرئ /11 /11 ومُحَمَّد بْن يوسف بْن التركي /11 /11 ومحمود   بْن عَلْقَمَة بْن مقاتل الأسدي /11 /11 وموسى بْن هارون الْحَافِظ /11 /11 ويحيى بْن معين وهو من أقرانه /11 ++ قال أَبُو دَاوُد : رأيت أَحْمَد بْن حَنْبَل يكتب عنه # وقال",
      "sanad_ar": "0 /11 مُسْلِم /11 /11 وأَبُو دَاوُد /11 /11 وإبراهيم بْن عَبْد اللَّهِ بْن الجنيد الختلي /11 /11 وأَحْمَد بْن بَشِير الطيالسي /11 /11 وأَحْمَد بْن أَبِي خَيْثَمَة /11 /11 وأَبُو بَكْر أَحْمَد بْن علي بْن سَعِيد الْمَرْوَزِيّ الْقَاضِي س /11 /11 وأَبُو يَعْلَى أَحْمَد بْن علي بْن المثنى الْمَوْصِلِيّ /11 /11 وأَحْمَد بْن علي الأبار /11 /11 وأَبُو الْعَبَّاس أَحْمَد بْن مُحَمَّد بْن عِيسَى البرتي الْقَاضِي /11 /11 وأَبُو بَكْر أَحْمَد بْن مُحَمَّد بْن مَنْصُور الحاسب /11 /11 والحارث بْن مُحَمَّد بْن أَبِي أُسَامَة /11 /11 وحرب بْن إِسْمَاعِيل الكرماني /11 /11 والحسن بْن سُفْيَان النسائي /11 /11 والحسن بْن علي بْن شَبِيب المعمري /11 /11 وعباس بْن مُحَمَّد الدوري /11 /11 وعبد الله بْن أَحْمَد بْن حَنْبَل /11 /11 وعبد الله بْن مُحَمَّد بْن أَبِي الدنيا /11 /11 وعبد الله بْن مُحَمَّد بْن عبد العزيز الْبَغَوِيّ /11 /11 ومُحَمَّد بْن حزابة العابد /11 /11 ومُحَمَّد بْن عبدوس بْن كَامِل السراج /11 /11 ومُحَمَّد بْن واصل المقرئ /11 /11 ومُحَمَّد بْن يوسف بْن التركي /11 /11 ومحمود   بْن عَلْقَمَة بْن مقاتل الأسدي /11 /11 وموسى بْن هارون الْحَافِظ /11 /11 ويحيى بْن معين وهو من أقرانه /11 ++ قال أَبُو دَاوُد",
      "matn_ar": "رأيت أَحْمَد بْن حَنْبَل يكتب عنه # وقال",
