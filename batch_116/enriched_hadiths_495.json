      "hadith_id": 1042414,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 51860,
      "text_ar": "0 /11 ابنه جعفر بْن المطلب بْن أَبِي وداعة س /11 /11 والسائب بْن يزيد م كد ت س /11 /11 وعبد اللَّهِ بْن الحارث بْن نوفل ت على خلاف فيه /11 /11 وابنه عَبْد الرحمن بْن المطلب بْن أَبِي وداعة /11 /11 وعكرمة بْن خالد المخزومي /11 /11 وابنه كثير بْن المطلب بْن أَبِي وداعة د س ق /11 /11 وابن ابنه أَبُو سفيان بْن عَبْد الرحمن بْن المطلب بْن أَبِي وداعة /11 ++ روى له الجماعة ، سوى البخاري . ++ \r\n$3239  -10 /2 /141 أخبرنا /94 أَحْمَدُ بْنُ أَبِي الْخَيْرِ L63250 /94 ، قال : أَنْبَأَنَا /26 أَبُو الْحَسَنِ الْجَمَّالُ L65937 /26 ، قال : أخبرنا /26 أَبُو عَلِيٍّ الْحَدَّادُ L14761 /26 ، قال : أخبرنا /26 أَبُو نُعَيْمٍ الْحَافِظُ L9927 /26 ، قال : حدثنا /26 أَحْمَدُ بْنُ يُوسُفَ بْنِ خَلادٍ L10765 /26 ، قال : حدثنا /26 مُحَمَّدُ بْنُ غَالِبٍ L30386 /26 . ح قال أَبُو نُعَيْمٍ ، وأخبرنا /26 سُلَيْمَانُ بْنُ أَحْمَدَ L18570 /26 ، قال : حدثنا /26 عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ L24433 /26 ، قَالا : حدثنا /26 الْقَعْنَبِيُّ L5085 /26 ، عَنْ /26 مَالِكٍ L6659 /26 ، عَنِ /26 ابْنِ شِهَابٍ L7272 /26 ، عَنِ /26 السَّائِبِ بْنِ يَزِيدَ L1450 /26 ، عَنِ /26 الْمُطَّلِبِ بْنِ أَبِي ودَاعَةَ السَّهْمِيِّ L1640 /26 ، /27 عَنْ /93 حَفْصَةَ L2457 /93 زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ أَنَّهَا ، قَالَتْ : /20 \" مَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ فِي سُبْحَتِهِ قَاعِدًا حَتَّى كَانَ قَبْلَ وفَاتِهِ بِعَامٍ ، فَكَانَ يُصَلِّي سُبْحَتَهُ قَاعِدًا ، ويَقْرَأُ بِالسُّورَةِ ، فَيُرَتِّلُهَا حَتَّى تَكُونَ أَطْوَلَ مِنْ أَطْوَلِ مِنْهَا \" /27 . أَخْرَجُوهُ سِوَى ابْنِ مَاجَهْ مِنْ حَدِيثِ مَالِكٍ ، وقَدْ وقَعَ لَنَا بِعُلُوٍّ عَنْهُ ، ولَيْسَ لَهُ عِنْدَ مُسْلِمٍ غَيْرُهُ . وقال التِّرْمِذِيُّ : حَسَنٌ صَحِيحٌ * \r\n@ 8142 من اسمه مطهر ومطوس ومطير ومطيع @ 8143 [ 6009 ] ق\u001bE4928",
      "sanad_ar": "0 /11 ابنه جعفر بْن المطلب بْن أَبِي وداعة س /11 /11 والسائب بْن يزيد م كد ت س /11 /11 وعبد اللَّهِ بْن الحارث بْن نوفل ت على خلاف فيه /11 /11 وابنه عَبْد الرحمن بْن المطلب بْن أَبِي وداعة /11 /11 وعكرمة بْن خالد المخزومي /11 /11 وابنه كثير بْن المطلب بْن أَبِي وداعة د س ق /11 /11 وابن ابنه أَبُو سفيان بْن عَبْد الرحمن بْن المطلب بْن أَبِي وداعة /11 ++ روى له الجماعة",
      "matn_ar": "سوى البخاري . ++ \r\n$3239  -10 /2 /141 أخبرنا /94 أَحْمَدُ بْنُ أَبِي الْخَيْرِ L63250 /94 ، قال : أَنْبَأَنَا /26 أَبُو الْحَسَنِ الْجَمَّالُ L65937 /26 ، قال : أخبرنا /26 أَبُو عَلِيٍّ الْحَدَّادُ L14761 /26 ، قال : أخبرنا /26 أَبُو نُعَيْمٍ الْحَافِظُ L9927 /26 ، قال : حدثنا /26 أَحْمَدُ بْنُ يُوسُفَ بْنِ خَلادٍ L10765 /26 ، قال : حدثنا /26 مُحَمَّدُ بْنُ غَالِبٍ L30386 /26 . ح قال أَبُو نُعَيْمٍ ، وأخبرنا /26 سُلَيْمَانُ بْنُ أَحْمَدَ L18570 /26 ، قال : حدثنا /26 عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ L24433 /26 ، قَالا : حدثنا /26 الْقَعْنَبِيُّ L5085 /26 ، عَنْ /26 مَالِكٍ L6659 /26 ، عَنِ /26 ابْنِ شِهَابٍ L7272 /26 ، عَنِ /26 السَّائِبِ بْنِ يَزِيدَ L1450 /26 ، عَنِ /26 الْمُطَّلِبِ بْنِ أَبِي ودَاعَةَ السَّهْمِيِّ L1640 /26 ، /27 عَنْ /93 حَفْصَةَ L2457 /93 زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ أَنَّهَا ، قَالَتْ : /20 \" مَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ فِي سُبْحَتِهِ قَاعِدًا حَتَّى كَانَ قَبْلَ وفَاتِهِ بِعَامٍ ، فَكَانَ يُصَلِّي سُبْحَتَهُ قَاعِدًا ، ويَقْرَأُ بِالسُّورَةِ ، فَيُرَتِّلُهَا حَتَّى تَكُونَ أَطْوَلَ مِنْ أَطْوَلِ مِنْهَا \" /27 . أَخْرَجُوهُ سِوَى ابْنِ مَاجَهْ مِنْ حَدِيثِ مَالِكٍ ، وقَدْ وقَعَ لَنَا بِعُلُوٍّ عَنْهُ ، ولَيْسَ لَهُ عِنْدَ مُسْلِمٍ غَيْرُهُ . وقال التِّرْمِذِيُّ : حَسَنٌ صَحِيحٌ * \r\n@ 8142 من اسمه مطهر ومطوس ومطير ومطيع @ 8143 [ 6009 ] ق\u001bE4928",
