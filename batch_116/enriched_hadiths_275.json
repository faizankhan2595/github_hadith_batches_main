      "hadith_id": 1039119,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 48565,
      "text_ar": "مؤذن مسجد رَسُول اللَّهِ صَلَّى اللَّهُ عليه وسلم يقال له كشاكش وهو مولى الأنصار ، ويقال مولى عمار بن ياسر /10 أسيد بن أبي أسيد البراد ت /10 /10 وسعيد بن أبي سعيد المقبري /10 /10 وشريك بن عَبْدِ اللَّهِ بن أبي نمر /10 /10 وصالح مولى التوءمة ت /10 /10 وأبي أمية عمار بن سعد المدني المؤذن /10 /10 ومحمد بن عَبْدِ الرَّحْمَنِ المدني /10 /10 وجده لأمه مُحَمَّد بن عمار بن سعد المؤذن ت /10",
      "sanad_ar": "مؤذن مسجد رَسُول اللَّهِ صَلَّى اللَّهُ عليه وسلم يقال له كشاكش وهو مولى الأنصار",
      "matn_ar": "ويقال مولى عمار بن ياسر /10 أسيد بن أبي أسيد البراد ت /10 /10 وسعيد بن أبي سعيد المقبري /10 /10 وشريك بن عَبْدِ اللَّهِ بن أبي نمر /10 /10 وصالح مولى التوءمة ت /10 /10 وأبي أمية عمار بن سعد المدني المؤذن /10 /10 ومحمد بن عَبْدِ الرَّحْمَنِ المدني /10 /10 وجده لأمه مُحَمَّد بن عمار بن سعد المؤذن ت /10",
