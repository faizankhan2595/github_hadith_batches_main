      "chapter_id": null,
      "hadith_number": 47610,
      "text_ar": "/10 إِبْرَاهِيم بْن سليمان الدباس /10 /10 وإِسْمَاعِيل بْن أبان الوراق /10 /10 وبشر بْن ثابت البزار ق /10 /10 وبشر بْن عمر الزهراني /10 /10 وحجاج بْن نصير الفساطيطي /10 /10 والْحَسَن بْن كثير بْن فائد /10 /10 وأبي عاصم الضحاك بْن مخلد /10 /10 وعاصم بْن علي بْن عاصم الواسطي /10 /10 وعبد اللَّه بْن عثمان بْن إِسْحَاق بْن سَعْد بْن أبي وقاص /10 /10 وعبد اللَّه بْن غياث الجشمي /10 /10 وعبد الرحيم بْن حماد /10 /10 وعبد السلام بْن راشد الرفاء /10 /10 وعبد العزيز بْن الخطاب /10 /10 وجده عبيد بْن عقيل المقرئ د س /10 /10 وعثمان بْن عمر بْن فارس /10 /10 وعَمْرو بْن الحصين العقيلي /10 /10 وعَمْرو بْن عاصم الكلابي ق /10 /10 ومحبوب بْن مُحَمَّد الوراق /10 /10 ومُحَمَّد بْن جهضم /10 /10 ومُحَمَّد بْن خالد بْن عثمة ق /10 /10 ومُحَمَّد بْن عَمْرو الباهلي /10 /10 وهارون بْن إِسْمَاعِيل الخزاز /10 /10 ويَحْيَى بْن غيلان /10 /10 ويَحْيَى بْن مُحَمَّد السوسي /10 /10 ويعقوب بْن مُحَمَّد الزهري /10",
      "sanad_ar": "",
      "matn_ar": "",
