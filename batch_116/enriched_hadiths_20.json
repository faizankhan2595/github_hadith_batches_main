    {
      "hadith_id": 1035287,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 44733,
      "text_ar": "ثُمَّ السهمي أَبُو مُحَمَّد المدني مولى بني سهم من أسلم يقال له ابْن مافنه وهي أمه /10 إِسْحَاق بْن عَبْد اللَّهِ بْن جَعْفَر بْن أَبِي طَالِب ق /10 /10 والحارث بْن أَبِي يَزِيد مولى الحكم /10 /10 وخارجة بْن زَيْد بْن ثَابِت /10 /10 وربيح بْن عَبْد الرَّحْمَنِ بْن أَبِي سَعِيد الْخُدْرِيّ ق /10 /10 وسالم بْن عَبْد اللَّهِ بْن عُمَر بخ ت /10 /10 وسعيد بْن أَبِي سَعِيد المقبري /10 /10 والطفيل بْن مُدْرِك /10 /10 وعبد الله بْن تَمَّام مولى أم حبيبة /10 /10 وعبد الله بْن عَبْد الرَّحْمَنِ بْن كَعْب بْن مَالِك /10 /10 وعبد الرحمن بْن كَعْب بْن مَالِك بخ /10 /10 وعثمان بْن ربيعة بْن الهدير ت /10 /10 وعثمان بْن سَعِيد بْن نوفل /10 /10 وعثمان بْن عَبْد اللَّهِ بْن سراقة /10 /10 وعُمَر بْن عبد العزيز /10 /10 وعَمْرو بْن تَمِيم مولى ابْن رمانة /10 /10 ومُحَمَّد بْن حَمْزَة بْن عَمْرو الأسلمي /10 /10 والمطلب بْن عَبْد اللَّهِ بْن حنطب ر د ق /10 /10 والمغيرة بْن سَعِيد بْن نوفل /10 /10 ونافع مولى ابْن عُمَر /10 /10 والوليد بْن كَثِير بخ د ت ق /10 /10 وزَيْنَب بِنْت نبيط ق امرأة أنس بْن مَالِك /10",
