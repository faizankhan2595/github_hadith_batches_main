    {
      "hadith_id": 1042096,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 51542,
      "text_ar": "، كان يسكن البلاط قرية من قرى دمشق على نحو فرسخ منها /10 إبراهيم بْن أبي عبلة /10 /10 وثعلبة بْن مسلم الخثعمي /10 /10 وحرام بْن سليمان /10 /10 وحريز بْن عثمان الرحبي /10 /10 ورزيق أبي عَبْد الله الألهاني /10 /10 وزرعة الزبيدي /10 /10 وزيد بْن واقد /10 /10 وسعيد بْن أبي أيوب ق /10 /10 وسعيد بْن بشير /10 /10 وأبي مهدي سعيد بْن سنان الحمصي /10 /10 وسليمان الأعمش /10 /10 وعَبْد الله بْن لهيعة /10 /10 وعَبْد الرحمن بْن عمرو الأوزاعي ق /10 /10 وعَبْد الرحمن بْن يزيد بْن تميم /10 /10 وعَبْد الرحمن بْن يزيد بْن جابر /10 /10 وعَبْد الملك بْن جريج ق /10 /10 وعبيد الله بْن عمر العمري /10 /10 وعتبة بْن أبي حكيم /10 /10 وعفير بْن معدان /10 /10 وعمر بْن الصبح /10 /10 والمثنى بْن الصباح /10 /10 ومحمد بْن عجلان /10 /10 ومحمد بْن الوليد الزبيدي /10 /10 ومروان بْن سالم القرقساني /10 /10 ومروان بْن معاوية الفزاري /10 /10 ومعان بْن رفاعة السلامي /10 /10 ومعاوية بْن سلمة النصري /10 /10 ومعاوية بْن يحيى الصدفي /10 /10 ومقاتل بْن حيان /10 /10 وهشام بْن حسان /10 /10 وهشام بْن الغاز /10 /10 ويحيى بْن الحارث الذماري /10 /10 ويحيى بْن سعيد الأنصاري /10 /10 وأبي بكر العَنْسي /10 /10 وأبي سعيد الأسدي /10",
      "sanad_ar": "",
      "matn_ar": "كان يسكن البلاط قرية من قرى دمشق على نحو فرسخ منها /10 إبراهيم بْن أبي عبلة /10 /10 وثعلبة بْن مسلم الخثعمي /10 /10 وحرام بْن سليمان /10 /10 وحريز بْن عثمان الرحبي /10 /10 ورزيق أبي عَبْد الله الألهاني /10 /10 وزرعة الزبيدي /10 /10 وزيد بْن واقد /10 /10 وسعيد بْن أبي أيوب ق /10 /10 وسعيد بْن بشير /10 /10 وأبي مهدي سعيد بْن سنان الحمصي /10 /10 وسليمان الأعمش /10 /10 وعَبْد الله بْن لهيعة /10 /10 وعَبْد الرحمن بْن عمرو الأوزاعي ق /10 /10 وعَبْد الرحمن بْن يزيد بْن تميم /10 /10 وعَبْد الرحمن بْن يزيد بْن جابر /10 /10 وعَبْد الملك بْن جريج ق /10 /10 وعبيد الله بْن عمر العمري /10 /10 وعتبة بْن أبي حكيم /10 /10 وعفير بْن معدان /10 /10 وعمر بْن الصبح /10 /10 والمثنى بْن الصباح /10 /10 ومحمد بْن عجلان /10 /10 ومحمد بْن الوليد الزبيدي /10 /10 ومروان بْن سالم القرقساني /10 /10 ومروان بْن معاوية الفزاري /10 /10 ومعان بْن رفاعة السلامي /10 /10 ومعاوية بْن سلمة النصري /10 /10 ومعاوية بْن يحيى الصدفي /10 /10 ومقاتل بْن حيان /10 /10 وهشام بْن حسان /10 /10 وهشام بْن الغاز /10 /10 ويحيى بْن الحارث الذماري /10 /10 ويحيى بْن سعيد الأنصاري /10 /10 وأبي بكر العَنْسي /10 /10 وأبي سعيد الأسدي /10",
