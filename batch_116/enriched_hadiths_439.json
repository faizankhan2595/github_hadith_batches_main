    {
      "hadith_id": 1041585,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 51031,
      "text_ar": "مولى مُحَمَّد بْن مروان بْن الحكم ، نزل بغداد ، وهم عم الخضر بْن مُحَمَّد بْن شجاع الجزري ، ويقال : له : الخصيفي لكثرة روايته عَنْ خصيف /10 ابراهيم بْن أبي عبلة /10 /10 وخصيف بْن عَبْد الرحمن الجزري د ت /10 /10 وسالم بْن عجلان الأفطس خ ق /10 /10 وعَبْد الكريم بْن مالك الجزري /10 /10 ومغيرة بْن مقسم الضبي /10",
      "sanad_ar": "مولى مُحَمَّد بْن مروان بْن الحكم",
      "matn_ar": "نزل بغداد ، وهم عم الخضر بْن مُحَمَّد بْن شجاع الجزري ، ويقال : له : الخصيفي لكثرة روايته عَنْ خصيف /10 ابراهيم بْن أبي عبلة /10 /10 وخصيف بْن عَبْد الرحمن الجزري د ت /10 /10 وسالم بْن عجلان الأفطس خ ق /10 /10 وعَبْد الكريم بْن مالك الجزري /10 /10 ومغيرة بْن مقسم الضبي /10",
      "grade": null,
