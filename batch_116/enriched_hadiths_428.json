    {
      "hadith_id": 1041418,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 50864,
      "text_ar": "نزيل نيسابور /10 حجاج بْن مُحَمَّد المصيصي بخ /10 /10 وحكام بْن سلم الرازي /10 /10 وأبي أسامة حماد بْن أسامة /10 /10 وحماد بْن خالد الخياط /10 /10 وسفيان بْن عيينة /10 /10 وعَبْد الله بْن نمير /10 /10 وعَبْد الرحمن بْن عَبْد الله بْن سعد الدشتكي /10 /10 وأبي زهير عَبْد الرحمن بْن مغراء بخ /10 /10 وعَبْد الرحمن بْن مهدي /10 /10 وعَبْد العزيز بْن مُحَمَّد الدراوردي /10 /10 وعبدان بْن عثمان المروزي /10 /10 وعلي بْن أبي بكر الرازي /10 /10 ومبشر بْن إسماعيل الحلبي بخ /10 /10 ومحمد بْن الْحَسَن بْن أبي يزيد الهمداني /10 /10 ومحمد بْن أبي الْحَسَن النوفلي /10 /10 ومخلد بْن الحسين الأزدي /10 /10 ومعاذ بْن معاذ العَنْبري /10 /10 والنضر بْن شميل /10 /10 وأبي النضر هاشم بْن الْقَاسِم بخ /10 /10 ووكيع بْن الجراح /10 /10 والوليد بْن مسلم /10 /10 ويحيى بْن سعيد الأموي خ /10 /10 وأبي سفيان المعمري /10 /10 وأبي عوانة /10",
      "sanad_ar": "",
      "matn_ar": "",
