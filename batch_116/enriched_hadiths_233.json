    {
      "hadith_id": 1038482,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 47928,
      "text_ar": "ابْن أخي عمرة بنت عبد الرحمن وهو مُحَمَّد بْن عبد الرحمن بْن عبد اللَّه بْن عبد الرحمن بْن سَعْد بْن زرارة ويقال ابن مُحَمَّد بدل عبد اللَّه ويقال مُحَمَّد بْن عبد الرحمن بْن أسَعْد بْن زرارة فمن قال مُحَمَّد بْن عبد الرحمن بْن سَعْد بْن زرارة نسبه إلى جده لأبيه ومن قال مُحَمَّد بْن عبد الرحمن بْن أسَعْد بْن زرارة نسبه إلى جده لأمه وكان عامل عمر بْن عبد العزيز على المدينة فيما قال يَحْيَى بْن أبي كثير , وغيره . /10 سالم بْن عبد اللَّه بْن عمر /10 /10 وعبد اللَّه بْن عامر بْن ربيعة /10 /10 وعبد الرحمن بْن هرمز الأعرج ر /10 /10 وعَمْرو بْن شرحبيل سي ويقال : مُحَمَّد بْن شرحبيل ق /10 /10 وعياش السلمي سي /10 /10 وقيس بْن سَعْد بْن عبادة د سي على خلاف فيه /10 /10 ومُحَمَّد بْن عَمْرو بْن الْحَسَن بْن علي بْن أبي طالب خ م د س /10 /10 ويَحْيَى بْن أسَعْد بْن زرارة ق /10 /10 وابن كعب بْن مالك ت س /10 /10 وعمته عمرة بنت عبد الرحمن خ د س /10 /10 وأختها لأمها أم هشام بنت حارثة بْن النعمان ق /10",
      "sanad_ar": "ابْن أخي عمرة بنت عبد الرحمن وهو مُحَمَّد بْن عبد الرحمن بْن عبد اللَّه بْن عبد الرحمن بْن سَعْد بْن زرارة ويقال ابن مُحَمَّد بدل عبد اللَّه ويقال مُحَمَّد بْن عبد الرحمن بْن أسَعْد بْن زرارة فمن قال مُحَمَّد بْن عبد الرحمن بْن سَعْد بْن زرارة نسبه إلى جده لأبيه ومن قال مُحَمَّد بْن عبد الرحمن بْن أسَعْد بْن زرارة نسبه إلى جده لأمه وكان عامل عمر بْن عبد العزيز على المدينة فيما قال يَحْيَى بْن أبي كثير , وغيره . /10 سالم بْن عبد اللَّه بْن عمر /10 /10 وعبد اللَّه بْن عامر بْن ربيعة /10 /10 وعبد الرحمن بْن هرمز الأعرج ر /10 /10 وعَمْرو بْن شرحبيل سي ويقال",
      "matn_ar": "مُحَمَّد بْن شرحبيل ق /10 /10 وعياش السلمي سي /10 /10 وقيس بْن سَعْد بْن عبادة د سي على خلاف فيه /10 /10 ومُحَمَّد بْن عَمْرو بْن الْحَسَن بْن علي بْن أبي طالب خ م د س /10 /10 ويَحْيَى بْن أسَعْد بْن زرارة ق /10 /10 وابن كعب بْن مالك ت س /10 /10 وعمته عمرة بنت عبد الرحمن خ د س /10 /10 وأختها لأمها أم هشام بنت حارثة بْن النعمان ق /10",
      "grade": null,
