    {
      "hadith_id": 1041480,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 50926,
      "text_ar": "2 ++ قال سهل الأسود : كنا إذا خرجنا من عَنْد شعبة دخلنا على مرجى بْن رجاء قال أَبُو داود : وهو خال الحوضي ++ استشهد له البخاري بحديث واحد وقد وقع لنا بعلو عَنْه ++ \r\n$3195  -10 /2 /141 أَخْبَرَنَا به /94 أبو الحسن بن البخاري L75025 /94 ، /94 وأبو الغنائم بن علان L46139 /94 ، /94 وأحمد بن شيبان L75042 /94 ، قَالُوا : أخبرنا /26 حنبل L62448 /26 ، قال : أخبرنا /26 ابن الحصين L46125 /26 ، قال : أخبرنا /26 ابن المذهب L14991 /26 ، قال : أخبرنا /26 القطيعي L8994 /26 ، قال : حَدَّثَنَا /26 عبد الله بن أحمد L4657 /26 ، قال : حَدَّثَنِي /26 أبي L488 /26 ، قال : حَدَّثَنَا /26 حَرَمِيُّ بْنُ عُمَارَةَ L2349 /26 ، قال : حَدَّثَنِي /26 مُرَجَّى بْنُ رَجَاءٍ L7388 /26 ، عَنْ /26 عُبَيْدِ اللَّهِ بْنِ أَبِي بَكْرٍ L5360 /26 ، /27 عَنْ /93 أَنَسِ بْنِ مَالِكٍ L720 /93 ، قال : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ \" إِذَا كَانَ /20 يَوْمُ الْفِطْرِ لَمْ يَخْرُجْ حَتَّى يَأْكُلَ تَمْرَاتٍ يَأْكُلُهُّنَّ أَفْرَادًا \" /27 ، قال الْبُخَارِيُّ : فِي الْعِيدَيْنِ ، وقال مُرَجَّى بْنُ رَجَاءٍ : فذكره * \r\n@ 7945 [ 5854 ] د :AE4856",
      "sanad_ar": "2 ++ قال سهل الأسود",
      "matn_ar": "كنا إذا خرجنا من عَنْد شعبة دخلنا على مرجى بْن رجاء قال أَبُو داود : وهو خال الحوضي ++ استشهد له البخاري بحديث واحد وقد وقع لنا بعلو عَنْه ++ \r\n$3195  -10 /2 /141 أَخْبَرَنَا به /94 أبو الحسن بن البخاري L75025 /94 ، /94 وأبو الغنائم بن علان L46139 /94 ، /94 وأحمد بن شيبان L75042 /94 ، قَالُوا : أخبرنا /26 حنبل L62448 /26 ، قال : أخبرنا /26 ابن الحصين L46125 /26 ، قال : أخبرنا /26 ابن المذهب L14991 /26 ، قال : أخبرنا /26 القطيعي L8994 /26 ، قال : حَدَّثَنَا /26 عبد الله بن أحمد L4657 /26 ، قال : حَدَّثَنِي /26 أبي L488 /26 ، قال : حَدَّثَنَا /26 حَرَمِيُّ بْنُ عُمَارَةَ L2349 /26 ، قال : حَدَّثَنِي /26 مُرَجَّى بْنُ رَجَاءٍ L7388 /26 ، عَنْ /26 عُبَيْدِ اللَّهِ بْنِ أَبِي بَكْرٍ L5360 /26 ، /27 عَنْ /93 أَنَسِ بْنِ مَالِكٍ L720 /93 ، قال : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ \" إِذَا كَانَ /20 يَوْمُ الْفِطْرِ لَمْ يَخْرُجْ حَتَّى يَأْكُلَ تَمْرَاتٍ يَأْكُلُهُّنَّ أَفْرَادًا \" /27 ، قال الْبُخَارِيُّ : فِي الْعِيدَيْنِ ، وقال مُرَجَّى بْنُ رَجَاءٍ : فذكره * \r\n@ 7945 [ 5854 ] د :AE4856",
