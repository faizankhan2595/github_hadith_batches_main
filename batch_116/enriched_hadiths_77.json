    {
      "hadith_id": 1036153,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 45599,
      "text_ar": "الصَّائِغ الكبير البغدادي نزيل مكة /10 أَحْمَد بْن إِسْحَاق الحضرمي /10 /10 وأَحْمَد بْن حَنْبَل /10 /10 وإسحاق بْن سُلَيْمَان الرازي /10 /10 وأبيه إِسْمَاعِيل بْن سالم الصَّائِغ /10 /10 وثابت بْن مُحَمَّد الشيباني العابد /10 /10 وحجاج بْن مُحَمَّد الأعور /10 /10 والحسن بْن علي الخلال /10 /10 والحسين بْن مُحَمَّد المروذي /10 /10 وأَبِي أُسَامَة حَمَّاد بْن أُسَامَة /10 /10 وداود بْن المحبر /10 /10 وروح بْن عُبَادَة /10 /10 وأَبِي خَيْثَمَة زُهَيْر بْن حَرْب /10 /10 وسعيد بْن سُلَيْمَان الواسطي /10 /10 وسعيد بْن أَبِي مريم /10 /10 وسعيد بْن مَنْصُور /10 /10 وسليمان بْن عُبَيْد اللَّهِ الرقي /10 /10 وشاذ بْن فياض /10 /10 وشبابة بْن سَوَّار /10 /10 وأَبِي عَاصِم الضحاك بْن مخلد /10 /10 وطالوت بْن عباد /10 /10 والعباس بْن عبد العظيم الْعَنْبَرِيّ /10 /10 وعبد الله بْن بَكْر السهمي /10 /10 وعبد الله بْن الزبير الحميدي /10 /10 وعبد الله بْن صَالِح العجلي /10 /10 وعبد الله بْن مسلمة القعنبي /10 /10 وأَبِي عَبْد الرَّحْمَنِ عَبْد اللَّهِ بْن يَزِيد المقرئ /10 /10 وأَبِي نُعَيْم عَبْد الرَّحْمَنِ بْن هانئ النخعي /10 /10 وعبد العزيز بْن أبان القرشي /10 /10 وعفان بْن مُسْلِم /10 /10 وعلي بْن المديني /10 /10 وأَبِي دَاوُد عُمَر بْن سَعْد الحفري /10 /10 وعَمْرو بْن مرزوق /10 /10 وأَبِي نُعَيْم الْفَضْل بْن دكين /10 /10 والقاسم بْن أمية الحذاء /10 /10 وقبيصة بْن عقبة /10 /10 ومُحَمَّد بْن عبد الأعلى /10 /10 ومحمود بْن غيلان /10 /10 ومسدد بْن مسرهد /10 /10 ومسلم بْن إِبْرَاهِيم /10 /10 والمنهال بْن بحر /10 /10 وأَبِي سلمة مُوسَى بْن إِسْمَاعِيل /10 /10 وأَبِي النضر هاشم بْن الْقَاسِم /10 /10 وهدبة بْن خَالِد /10 /10 وهدية بْن عبد الوهاب الْمَرْوَزِيّ /10 /10 وأَبِي الْوَلِيد هشام بْن عَبْد الْمَلِكِ الطيالسي /10 /10 ويحيى بْن أَبِي بكير الكرماني /10 /10 ويحيى بْن معين /10 /10 ويعلى بْن عبيد /10 /10 ويونس بْن مُحَمَّد   المؤدب /10",
