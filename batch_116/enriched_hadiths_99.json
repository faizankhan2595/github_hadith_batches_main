      "hadith_id": 1036475,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 45921,
      "text_ar": "2 . ++ وقال خليفة بْن خياط ، وأَبُو حاتم الرازي ، والزبير بْن بكار ، وغَيْر واحِد : مات في خلافة عُمَر بْن عبد العزيز . ++ \r\n$2999 /8 /141 وقال /26 مُحَمَّد بْن سَعْد /26 ، أخبرنا /26 مُحَمَّد بْن عُمَر /26 ، قال : حدثنا /26 ابْن أَبِي سبرة /26 ، عَنْ /26 أَبِي مَالِك الحميري /26 ، قال : /27 رأيت /26 نافع بْن جُبَيْر /26 يَوْم مات أخوه مُحَمَّد بْن جُبَيْر ، قد /20 ألقى رداءه عَنْ ظهره وهُوَ يمشي ، وهذا يدل على أن محمدا لم يبق إِلَى خلافة عُمَر بْن عبد العزيز ، فإن أخاه نافعا بقي ، ولم يدركها /27 ، والله أعلم * \r\n. ++ روى له : الجماعة . @ 7021 [ 5114 ] ع*E4386",
      "sanad_ar": "2 . ++ وقال خليفة بْن خياط",
      "matn_ar": "وأَبُو حاتم الرازي ، والزبير بْن بكار ، وغَيْر واحِد : مات في خلافة عُمَر بْن عبد العزيز . ++ \r\n$2999 /8 /141 وقال /26 مُحَمَّد بْن سَعْد /26 ، أخبرنا /26 مُحَمَّد بْن عُمَر /26 ، قال : حدثنا /26 ابْن أَبِي سبرة /26 ، عَنْ /26 أَبِي مَالِك الحميري /26 ، قال : /27 رأيت /26 نافع بْن جُبَيْر /26 يَوْم مات أخوه مُحَمَّد بْن جُبَيْر ، قد /20 ألقى رداءه عَنْ ظهره وهُوَ يمشي ، وهذا يدل على أن محمدا لم يبق إِلَى خلافة عُمَر بْن عبد العزيز ، فإن أخاه نافعا بقي ، ولم يدركها /27 ، والله أعلم * \r\n. ++ روى له : الجماعة . @ 7021 [ 5114 ] ع*E4386",
