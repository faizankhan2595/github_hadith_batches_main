    {
      "hadith_id": 1041797,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 51243,
      "text_ar": "2 ++ وقال أَبُو عبيد الآجري ، عَنِ أبي داود : مسعر صاحب شيوخ ، روى مسعر ، عَنْ مائة لم يرو عَنْهم سفيان ++ وقال مُحَمَّد بْن عمار بْن الحارث الرازي : سمعت أبا نعيم ، يقول : سمعت سفيان الثوري ، يقول : الإيمان يزيد وينقص ، قلت : ما تقول أنت يا أبا نعيم ؟ فنظر إلي نظرا منكرا ، ثم قال : أقول بقول سفيان ، ولقد مات مسعر بْن كدام وكان من خيارهم ، وسفيان ، وشريك شاهدان ، فما حضرا جنازته ++ قال عمرو بْن علي : مات سنة ثلاث وخمسين ومائة ++ وقال أَبُو نعيم : مات سنة خمس وخمسين ومائة ++ وقال أَحْمَد بْن مُحَمَّد بْن بلال ، عَنْ مصعب بْن المقدام : رأيت النبي صَلَّى اللَّهُ عليه وسلم في المنام ، وسفيان آخذ بيده وهما يطوفان فقال له سفيان يا رسول الله ، مات مسعر ؟ قال : \" نعم ، واستبشر بموته أهل السماء \" ++ روى له الجماعة . @ 8014 [ 5907 ] ق :$E4879",
      "sanad_ar": "2 ++ وقال أَبُو عبيد الآجري",
      "matn_ar": "عَنِ أبي داود : مسعر صاحب شيوخ ، روى مسعر ، عَنْ مائة لم يرو عَنْهم سفيان ++ وقال مُحَمَّد بْن عمار بْن الحارث الرازي : سمعت أبا نعيم ، يقول : سمعت سفيان الثوري ، يقول : الإيمان يزيد وينقص ، قلت : ما تقول أنت يا أبا نعيم ؟ فنظر إلي نظرا منكرا ، ثم قال : أقول بقول سفيان ، ولقد مات مسعر بْن كدام وكان من خيارهم ، وسفيان ، وشريك شاهدان ، فما حضرا جنازته ++ قال عمرو بْن علي : مات سنة ثلاث وخمسين ومائة ++ وقال أَبُو نعيم : مات سنة خمس وخمسين ومائة ++ وقال أَحْمَد بْن مُحَمَّد بْن بلال ، عَنْ مصعب بْن المقدام : رأيت النبي صَلَّى اللَّهُ عليه وسلم في المنام ، وسفيان آخذ بيده وهما يطوفان فقال له سفيان يا رسول الله ، مات مسعر ؟ قال : \" نعم ، واستبشر بموته أهل السماء \" ++ روى له الجماعة . @ 8014 [ 5907 ] ق :$E4879",
