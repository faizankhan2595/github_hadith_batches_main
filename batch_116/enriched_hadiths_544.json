    {
      "hadith_id": 1043154,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 52600,
      "text_ar": "ويقال المغيرة بْن عَبْد اللَّهِ بْن أَبِي بردة من بني عَبْد الدار حجازي ويقال عَبْد اللَّهِ بْن المغيرة بْن أَبِي بردة الكناني /10 زياد بْن نعيم الحضرمي ، وعن أَبِي هريرة 4 حديث : \" البحر هو الطهور ماؤه الحل ميتته \" . وقيل ، عَن أبيه ، عَن أَبِي هريرة ، وقيل ، عَن رجل من بني مدلج ، عَن النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ . وقيل غير ذلك /10 .",
      "sanad_ar": "ويقال المغيرة بْن عَبْد اللَّهِ بْن أَبِي بردة من بني عَبْد الدار حجازي ويقال عَبْد اللَّهِ بْن المغيرة بْن أَبِي بردة الكناني /10 زياد بْن نعيم الحضرمي",
      "matn_ar": "وعن أَبِي هريرة 4 حديث : \" البحر هو الطهور ماؤه الحل ميتته \" . وقيل ، عَن أبيه ، عَن أَبِي هريرة ، وقيل ، عَن رجل من بني مدلج ، عَن النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ . وقيل غير ذلك /10 .",
      "grade": null,
