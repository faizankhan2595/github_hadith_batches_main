    {
      "hadith_id": 1042032,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 51478,
      "text_ar": "أخبرنا /94 أبو الحسن بن البخاري L75025 /94 ، /94 وأحمد بن شيبان L75042 /94 ، /94 وإِسْمَاعِيلُ بْنُ الْعَسْقَلانِيِّ L63233 /94 ، /94 وزينب بنت مكي L75040 /94 ، قَالُوا : أخبرنا /26 أبو حفص بن طبرزد L25365 /26 ، قال : أخبرنا /26 أَبُو غَالِبِ بْنُ الْبَنَّاءِ L46377 /26 ، قال : أخبرنا /26 أَبُو مُحَمَّدٍ الْجَوْهَرِيُّ L14939 /26 ، قال : أخبرنا /26 أَبُو بَكْرٍ الْقَطِيعِيُّ L8994 /26 ، قال : حَدَّثَنَا /26 بِشْرُ بْنُ مُوسَى L12862 /26 ، قال : حَدَّثَنَا /26 أَبُو نُعَيْمٍ L1548 /26 ، قال : حَدَّثَنَا /26 سُفْيَانُ L3436 /26 عَنْ /26 أَبِي إِسْحَاقَ L6155 /26 ، عَنْ /26 مُسْلِمِ بْنِ نَذِيرٍ L7485 /26 ، /27 عَنْ /93 حُذَيْفَةَ L2324 /93 ، قال : أَخَذَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ /20 بِعَضَلَةِ سَاقِي ، فَقَالَ : \" هَذَا مَوْضِعُ الإِزَارِ ، فَإِنْ أَبَيْتَ فَأَسْفَلُ مِنْ ذَلِكَ ، فَإِنْ أَبَيْتَ فَلا حَقَّ لِلإِزَارِ فِي الْكَعْبَيْنِ \" /27 ، أَخْرَجَهُ التِّرْمِذِيُّ ، والنِّسَائِيُّ ، وابْنُ مَاجَهْ مِنْ حَدِيثِ أَبِي الأَحْوَصِ ، وغَيْرُهُ ، عَنْ أَبِي إِسْحَاقَ ، فَوَقَعَ لَنَا عَالِيًا ، وقال التِّرْمِذِيُّ : حَسَنٌ صَحِيحٌ ، ولَيْسَ لَهُ عِنْدَ التِّرْمِذِيِّ ، وابْنِ مَاجَهْ غَيْرُهُ واللهُ أَعْلَمُ * \r\n@ 8063 [ 5947 ] م د س ق :",
      "sanad_ar": "أخبرنا /94 أبو الحسن بن البخاري L75025 /94",
      "matn_ar": "/94 وأحمد بن شيبان L75042 /94 ، /94 وإِسْمَاعِيلُ بْنُ الْعَسْقَلانِيِّ L63233 /94 ، /94 وزينب بنت مكي L75040 /94 ، قَالُوا : أخبرنا /26 أبو حفص بن طبرزد L25365 /26 ، قال : أخبرنا /26 أَبُو غَالِبِ بْنُ الْبَنَّاءِ L46377 /26 ، قال : أخبرنا /26 أَبُو مُحَمَّدٍ الْجَوْهَرِيُّ L14939 /26 ، قال : أخبرنا /26 أَبُو بَكْرٍ الْقَطِيعِيُّ L8994 /26 ، قال : حَدَّثَنَا /26 بِشْرُ بْنُ مُوسَى L12862 /26 ، قال : حَدَّثَنَا /26 أَبُو نُعَيْمٍ L1548 /26 ، قال : حَدَّثَنَا /26 سُفْيَانُ L3436 /26 عَنْ /26 أَبِي إِسْحَاقَ L6155 /26 ، عَنْ /26 مُسْلِمِ بْنِ نَذِيرٍ L7485 /26 ، /27 عَنْ /93 حُذَيْفَةَ L2324 /93 ، قال : أَخَذَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ /20 بِعَضَلَةِ سَاقِي ، فَقَالَ : \" هَذَا مَوْضِعُ الإِزَارِ ، فَإِنْ أَبَيْتَ فَأَسْفَلُ مِنْ ذَلِكَ ، فَإِنْ أَبَيْتَ فَلا حَقَّ لِلإِزَارِ فِي الْكَعْبَيْنِ \" /27 ، أَخْرَجَهُ التِّرْمِذِيُّ ، والنِّسَائِيُّ ، وابْنُ مَاجَهْ مِنْ حَدِيثِ أَبِي الأَحْوَصِ ، وغَيْرُهُ ، عَنْ أَبِي إِسْحَاقَ ، فَوَقَعَ لَنَا عَالِيًا ، وقال التِّرْمِذِيُّ : حَسَنٌ صَحِيحٌ ، ولَيْسَ لَهُ عِنْدَ التِّرْمِذِيِّ ، وابْنِ مَاجَهْ غَيْرُهُ واللهُ أَعْلَمُ * \r\n@ 8063 [ 5947 ] م د س ق :",
