    {
      "hadith_id": 1042872,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 52318,
      "text_ar": "أخبرنا /94 أَحْمَدُ بْنُ أَبِي الْخَيْرِ L63250 /94 ، قال : أَنْبَأَنَا /26 مَسْعُودُ بْنُ أَبِي مَنْصُورٍ الْجَمَّالُ L65937 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ غَانِمُ بْنُ مُحَمَّدِ بْنِ عُبَيْدِ اللَّهِ بْنِ عُمَرَ بْنِ أَيُّوبَ بْنِ زِيَادٍ الْبُرْجِيُّ L26231 /26 ، قِرَاءَةً عَلَيْهِ وأَنَا حَاضِرٌ فِي ذِي الْحِجَّةِ سَنَةَ ثَمَانٍ وخَمْسِمِائَةٍ ، قال : أخبرنا /26 أَبُو نُعَيْمٍ الْحَافِظُ L9927 /26 ، قال : حدثنا /26 أَبُو بَكْرِ بْنُ خَلادٍ L10765 /26 ، قال : حدثنا /26 مُحَمَّدُ بْنُ غَالِبِ بْنِ حَرْبٍ L30386 /26 ، قال : حدثنا /26 الْقَعْنَبِيُّ L5085 /26 ، عَنْ /26 مَالِكِ بْنِ أَنَسٍ L6659 /26 . ح أخبرنا /94 أَحْمَدُ بْنُ أَبِي الْخَيْرِ L63250 /94 ، قال : أَنْبَأَنَا /26 أَبُو الْحَسَنِ الْجَمَّالُ L65937 /26 ، قال : أخبرنا /26 أَبُو عَلِيٍّ الْحَدَّادُ L14761 /26 ، قال : أخبرنا /26 أَبُو نُعَيْمٍ الْحَافِظُ L9927 /26 ، قال : حدثنا /26 مَخْلَدُ بْنُ جَعْفَرٍ الدَّقِيقِيُّ L31227 /26 ، قال : حدثنا /26 جَعْفَرُ الْفِرْيَابِيُّ L13810 /26 ، قال : حدثنا /26 قُتَيْبَةُ L6460 /26 ، قال : حدثنا /26 مَالِكٌ L6659 /26 ، عَنْ /26 مُحَمَّدِ بْنِ عَمْرِو بْنِ حَلْحَلَةَ L7221 /26 ، عَنْ /26 مَعْدِ بْنِ كَعْبٍ L7253 /26 ، /27 عَنْ /93 أَبِي قَتَادَةَ بْنِ رِبْعِيٍّ L1190 /93 ، قال : مَرَّ عَلَى النَّبِيِّ صَلّى اللَّهُ عَلَيهِ وسَلَّمَ بِجِنَازَةٍ ، فَقَالَ : \" مُسْتَرِيحٌ ، ومُسْتَرَاحٌ مِنْهُ \" . قَالُوا : يَا رَسُولَ اللَّهِ ، مَا الْمُسْتَرِيحُ ، والْمُسْتَرَاحُ مِنْهُ ؟ قال : /20 \" الْعَبْدُ الْمُؤْمِنُ يَسْتَرِيحُ مِنْ نَصَبِ الدُّنْيَا وأَذَاهَا إِلَى رَحْمَةِ اللَّهِ ، والْعَبْدُ الْكَافِرُ ، أَوِ الْفَاجِرُ يَسْتَرِيحُ مِنْهُ الْعِبَادُ ، والْبِلادُ ، والشَّجَرُ ، والدَّوَابُّ \" /27 . لَفْظُهُمَا سَوَاءٌ ، إِلا أَنَّ الْقَعْنَبِيَّ لَمْ يَقُلْ : \" أَوِ الْفَاجِرُ \" . رَوَاهُ الْبُخَارِيُّ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي أُوَيْسٍ ، عَنْ مَالِكٍ ، فَوَقَعَ لَنَا بَدَلا عَالِيًا ، ولَيْسَ لَهُ عِنْدَهُ غَيْرُهُ . ورَوَاهُ مُسْلِمٌ ، والنَّسَائِيُّ ، عَنْ قُتَيْبَةَ ، فَوَافَقْنَاهُمَا فِيهِ بِعُلُوٍّ ، وأَخْرَجُوهُ مِنْ حَدِيثِ عَبْدِ اللَّهِ بْنِ سَعِيدِ بْنِ أَبِي هِنْدٍ ، عَنِ ابْنِ حَلْحَلَةَ أَيْضًا * \r\n@ 8229 [ 6076 ] د\u001cE4975",
      "sanad_ar": "أخبرنا /94 أَحْمَدُ بْنُ أَبِي الْخَيْرِ L63250 /94",
      "matn_ar": "قال : أَنْبَأَنَا /26 مَسْعُودُ بْنُ أَبِي مَنْصُورٍ الْجَمَّالُ L65937 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ غَانِمُ بْنُ مُحَمَّدِ بْنِ عُبَيْدِ اللَّهِ بْنِ عُمَرَ بْنِ أَيُّوبَ بْنِ زِيَادٍ الْبُرْجِيُّ L26231 /26 ، قِرَاءَةً عَلَيْهِ وأَنَا حَاضِرٌ فِي ذِي الْحِجَّةِ سَنَةَ ثَمَانٍ وخَمْسِمِائَةٍ ، قال : أخبرنا /26 أَبُو نُعَيْمٍ الْحَافِظُ L9927 /26 ، قال : حدثنا /26 أَبُو بَكْرِ بْنُ خَلادٍ L10765 /26 ، قال : حدثنا /26 مُحَمَّدُ بْنُ غَالِبِ بْنِ حَرْبٍ L30386 /26 ، قال : حدثنا /26 الْقَعْنَبِيُّ L5085 /26 ، عَنْ /26 مَالِكِ بْنِ أَنَسٍ L6659 /26 . ح أخبرنا /94 أَحْمَدُ بْنُ أَبِي الْخَيْرِ L63250 /94 ، قال : أَنْبَأَنَا /26 أَبُو الْحَسَنِ الْجَمَّالُ L65937 /26 ، قال : أخبرنا /26 أَبُو عَلِيٍّ الْحَدَّادُ L14761 /26 ، قال : أخبرنا /26 أَبُو نُعَيْمٍ الْحَافِظُ L9927 /26 ، قال : حدثنا /26 مَخْلَدُ بْنُ جَعْفَرٍ الدَّقِيقِيُّ L31227 /26 ، قال : حدثنا /26 جَعْفَرُ الْفِرْيَابِيُّ L13810 /26 ، قال : حدثنا /26 قُتَيْبَةُ L6460 /26 ، قال : حدثنا /26 مَالِكٌ L6659 /26 ، عَنْ /26 مُحَمَّدِ بْنِ عَمْرِو بْنِ حَلْحَلَةَ L7221 /26 ، عَنْ /26 مَعْدِ بْنِ كَعْبٍ L7253 /26 ، /27 عَنْ /93 أَبِي قَتَادَةَ بْنِ رِبْعِيٍّ L1190 /93 ، قال : مَرَّ عَلَى النَّبِيِّ صَلّى اللَّهُ عَلَيهِ وسَلَّمَ بِجِنَازَةٍ ، فَقَالَ : \" مُسْتَرِيحٌ ، ومُسْتَرَاحٌ مِنْهُ \" . قَالُوا : يَا رَسُولَ اللَّهِ ، مَا الْمُسْتَرِيحُ ، والْمُسْتَرَاحُ مِنْهُ ؟ قال : /20 \" الْعَبْدُ الْمُؤْمِنُ يَسْتَرِيحُ مِنْ نَصَبِ الدُّنْيَا وأَذَاهَا إِلَى رَحْمَةِ اللَّهِ ، والْعَبْدُ الْكَافِرُ ، أَوِ الْفَاجِرُ يَسْتَرِيحُ مِنْهُ الْعِبَادُ ، والْبِلادُ ، والشَّجَرُ ، والدَّوَابُّ \" /27 . لَفْظُهُمَا سَوَاءٌ ، إِلا أَنَّ الْقَعْنَبِيَّ لَمْ يَقُلْ : \" أَوِ الْفَاجِرُ \" . رَوَاهُ الْبُخَارِيُّ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي أُوَيْسٍ ، عَنْ مَالِكٍ ، فَوَقَعَ لَنَا بَدَلا عَالِيًا ، ولَيْسَ لَهُ عِنْدَهُ غَيْرُهُ . ورَوَاهُ مُسْلِمٌ ، والنَّسَائِيُّ ، عَنْ قُتَيْبَةَ ، فَوَافَقْنَاهُمَا فِيهِ بِعُلُوٍّ ، وأَخْرَجُوهُ مِنْ حَدِيثِ عَبْدِ اللَّهِ بْنِ سَعِيدِ بْنِ أَبِي هِنْدٍ ، عَنِ ابْنِ حَلْحَلَةَ أَيْضًا * \r\n@ 8229 [ 6076 ] د\u001cE4975",
