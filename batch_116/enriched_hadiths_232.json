    {
      "hadith_id": 1038471,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 47917,
      "text_ar": "0 /11 مسلم /11 /11 وإِبْرَاهِيم بْن أسباط بْن السكن الزيات البغدادي /11 /11 وإِبْرَاهِيم بْن عبد اللَّه بْن الجنيد /11 /11 وأَبُو جعفر أَحْمَد بْن علي بْن الفضيل الخزاز المقرىء /11 /11 وأَبُو يعلى أَحْمَد بْن علي بْن المثنى الموصلي /11 /11 وأَبُو بكر أَحْمَد بْن الْقَاسِمِ بْن عطية الرازي /11 /11 وأَبُو الْحَسَن أَحْمَد بْن الْقَاسِمِ بْن مُحَمَّد بْن سليمان الطائي البرتي /11 /11 وأَبُو الْحَسَن أَحْمَد بْن مُحَمَّد بْن الْحَسَن بْن السكن العامري /11 /11 وأَحْمَد بْن مُحَمَّد بْن أبي موسى الأنطاكي /11 /11 وأَبُو بكر أَحْمَد بْن هاشم الأنطاكي /11 /11 وأَحْمَد بْن يَحْيَى بْن جابر البلاذري الكاتب /11 /11 وأَحْمَد بْن يونس الضبي الأصبهاني /11 /11 وأَبُو علي الْحُسَيْن بْن أَحْمَد المالكي الآمدي /11 /11 والْحُسَيْن بْن إِسْحَاق التستري /11 /11 وعبد اللَّه بْن أَحْمَد بْن حَنْبَل /11 /11 وأَبُو بكر عبد اللَّه بْن مُحَمَّد بْن أبي الدنيا /11 /11 وأَبُو الْقَاسِمِ عبد اللَّه بْن مُحَمَّد بْن عبد العزيز البغوي /11 /11 وأَبُو مُحَمَّد عبد اللَّه بْن مُحَمَّد بْن الوليد الحراني , ثم الأنطاكي المعروف بابن قراب /11 /11 وعثمان بْن خرزاذ الأنطاكي /11 /11 وعلي بْن أَحْمَد بْن النضر الأزدي /11 /11 وعمر بْن سعيد بْن سنان الطائي المنبجي /11 /11 والفضل بْن مُحَمَّد بْن عبد اللَّه العطار الأحدب /11 /11 ومُحَمَّد بْن أَحْمَد بْن مسافر الأنطاكي /11 /11 ومُحَمَّد بْن عبد الرحيم البزاز /11 /11 ومُحَمَّد بْن الفضل بْن جابر السقطي /11 /11 وموسى بْن هارون الحافظ /11 /11 وأَبُو جعفر هارون   بْن عيسى المنصوري /11 /11 ويَحْيَى بْن ظالم الطرسوسي /11 #",
