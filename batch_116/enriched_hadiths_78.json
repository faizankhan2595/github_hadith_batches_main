    {
      "hadith_id": 1036168,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 45614,
      "text_ar": "مولى بني هاشم /10 إِبْرَاهِيم بْن عُمَر بْن أَبِي الوزير /10 /10 وإِسْمَاعِيل ابْن علية /10 /10 وجرير بْن عبد الحميد /10 /10 والحارث بْن عطية الْبَصْرِيّ نزيل المصيصة /10 /10 وحفص بْن غياث /10 /10 وأَبِي أُسَامَة حَمَّاد بْن أُسَامَة /10 /10 وحماد بْن خَالِد الخياط /10 /10 وسفيان بْن عُيَيْنَة /10 /10 وعبد الله بْن دَاوُد الخريبي /10 /10 وعبد الله بْن رَجَاء المكي /10 /10 وعبد الرحمن بْن مُحَمَّد المحاربي /10 /10 وعبد الوهاب بْن عبد المجيد الثقفي د /10 /10 وعبد الوهاب بْن نجدة الحوطي /10 /10 وعثمان بْن عُثْمَان الغطفاني د /10 /10 وفهد بْن حيان /10 /10 ومبشر بْن إِسْمَاعِيل الحلبي /10 /10 ومُحَمَّد بْن خَالِد بْن عثمة الحنفي /10 /10 ومُحَمَّد بْن أَبِي عدي /10 /10 ومُحَمَّد بْن كَثِير المصيصي /10 /10 ومُحَمَّد بْن مصعب القرقساني /10 /10 ومعاذ بْن هشام الدستوائي د /10 /10 والمعافى بْن عِمْرَان الْمَوْصِلِيّ /10 /10 ومعتمر بْن سُلَيْمَان خ /10 /10 ومكي بْن إِبْرَاهِيم البلخي /10 /10 ويحيى بْن حَمَّاد /10 /10 ويزيد بْن زريع /10 /10 وأَبِي بَكْر بْن عياش /10 /10 وأَبِي خَالِد الأحمر /10 /10 وأَبِي عَامِر العقدي /10",
      "sanad_ar": "",
      "matn_ar": "",
