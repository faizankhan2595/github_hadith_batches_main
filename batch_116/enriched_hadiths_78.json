      "hadith_id": 1036161,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 45607,
      "text_ar": "/10 إِبْرَاهِيم بْن عُيَيْنَة /10 /10 وأسباط بْن مُحَمَّد القرشي ت س ق /10 /10 وإِسْمَاعِيل بْن مُحَمَّد بْن جحادة /10 /10 وجعفر بْن عون س /10 /10 والحسن بْن علي الرزاز /10 /10 وحفص بْن غياث /10 /10 والحكم بْن جميع السدوسي /10 /10 وأَبِي أُسَامَة حَمَّاد بْن أُسَامَة ق /10 /10 وزيد بْن الحباب ق /10 /10 وسفيان بْن عُيَيْنَة /10 /10 وعبد الرحمن بْن مُحَمَّد المحاربي س ق /10 /10 وأَبِي الصلت عبد السلام بْن صَالِح الْهَرَوِيّ ق /10 /10 وعبيد الله بْن مُوسَى /10 /10 وعثمان بْن عَبْد الرَّحْمَنِ الطرائفي ق /10 /10 ومُحَمَّد بْن الْحَسَن المزني الواسطي ق /10 /10 وأَبِي مُعَاوِيَة مُحَمَّد بْن خازم الضرير ت /10 /10 ومُحَمَّد بْن فُضَيْل بْن غزوان س /10 /10 ومُحَمَّد بْن يَعْلَى السُّلَمِيّ ولقبه زُنْبُور ق /10 /10 ومصعب بْن المقدام /10 /10 ومفضل بْن صَالِح الأسدي /10 /10 ووكيع بْن الجراح س ق /10 /10 ووهب بْن إِسْمَاعِيل الأسدي ق /10 /10 ويونس بْن بكير الشيباني /10 /10 وأَبِي بَكْر بْن عياش /10",
