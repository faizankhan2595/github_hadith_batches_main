      "hadith_id": 707601,
      "book_id": 705,
      "chapter_id": null,
      "hadith_number": 89,
      "text_ar": "وَأخْبَرَنَا /94 مُحَمَّدُ بْنُ عَلِيٍّ الْأَصْبَهَانِيُّ /94 التَّاجِرُ ، حَدَّثَنَا /26 أَحْمَدُ بْنُ مَحْمُودٍ الْقَاضِي /26 بِالْأَهْوَازِ ، حَدَّثَنَا /26 مُحَمَّدُ بْنُ زَكَرِيَّا /26 ، حَدَّثَنَا /26 ابْنُ عَائِشَةَ /26 ، قَالَ : /27 سُئِلَ /26 عَلِيُّ بْنُ الْحُسَيْنِ /26 عَنْ /20 صِفَةِ الزَّاهِدِ فِي الدُّنْيَا ، فَقَالَ : \" يَتَبلَّغُ    @ 1 : 84 @   بِدُونِ قُوتِهِ ، وَيَسْتَعِدُّ لِيَوْمِ مَوْتِهِ ، وَيَتَبَرَّمُ بِحَيَاتِهِ \" /27 * \r\n#E14",
      "sanad_ar": "وَأخْبَرَنَا /94 مُحَمَّدُ بْنُ عَلِيٍّ الْأَصْبَهَانِيُّ /94 التَّاجِرُ",
      "matn_ar": "حَدَّثَنَا /26 أَحْمَدُ بْنُ مَحْمُودٍ الْقَاضِي /26 بِالْأَهْوَازِ ، حَدَّثَنَا /26 مُحَمَّدُ بْنُ زَكَرِيَّا /26 ، حَدَّثَنَا /26 ابْنُ عَائِشَةَ /26 ، قَالَ : /27 سُئِلَ /26 عَلِيُّ بْنُ الْحُسَيْنِ /26 عَنْ /20 صِفَةِ الزَّاهِدِ فِي الدُّنْيَا ، فَقَالَ : \" يَتَبلَّغُ    @ 1 : 84 @   بِدُونِ قُوتِهِ ، وَيَسْتَعِدُّ لِيَوْمِ مَوْتِهِ ، وَيَتَبَرَّمُ بِحَيَاتِهِ \" /27 * \r\n#E14",
