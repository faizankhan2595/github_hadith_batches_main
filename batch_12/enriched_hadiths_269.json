      "chapter_id": null,
      "hadith_number": 2660,
      "text_ar": "$2980  /2 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، عَنِ /26 الرَّبِيعِ L1412 /26 ، /27 عَنِ /26 الْحَسَنِ L1239 /26 , \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَبَا بَكْرٍ وَعُمَرَ كَانُوا /20 يُسَلِّمُونَ تَسْلِيمَةً وَاحِدَةً \" /27 * \r\n$2981  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ الْأَحْمَرُ /94 ، عَنْ /26 حُمَيْدٍ /26 ، قَالَ : /27 كَانَ /93 أَنَسٌ L720 /93 /20 \" يُسَلِّمُ وَاحِدَةً \" /27 * \r\n@ 1 : 335 @ \r\n$2982  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ /94 ، عَنْ /26 سَعِيدِ بْنِ مَرْزُبَانَ /26 ، قَالَ : صَلَّيْتُ خَلْفَ ابْنِ أَبِي لَيْلَى \" فَسَلَّمَ وَاحِدَةً \" ثُمَّ قَالَ : /27 صَلَّيْتُ خَلْفَ /93 عَلِيٍّ /93 /20 \" فَسَلَّمَ وَاحِدَةً \" /27 * \r\n$2983  /8 /141 حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنِ /26 الزِّبْرِقَانِ /26 , /27 أَنَّ /26 أَبَا وَائِلٍ /26 \" كَانَ /20 يُسَلِّمُ تَسْلِيمَةً وَاحِدَةً \" /27 * \r\n$2984  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، /27 عَنْ /26 يَحْيَى بْنِ وَثَّابٍ /26 أَنَّهُ \" كَانَ /20 يُسَلِّمُ تَسْلِيمَةً \" /27 * \r\n$2985  /8 /141 حَدَّثَنَا /94 سَهْلُ بْنُ يُوسُفَ /94 ، عَنْ /26 حُمَيْدٍ /26 ، قَالَ : /27 صَلَّيْتُ خَلْفَ /26 عُمَرَ بْنِ عَبْدِ الْعَزِيزِ /26 /20 \" فَسَلَّمَ وَاحِدَةً \" /27 * \r\n$2986  /8 /141 حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 ، /27 عَنِ /26 الْحَسَنِ /26 , /26 وَابْنِ سِيرِينَ /26 أَنَّهُمَا \" كَانَا /20 يُسَلِّمَانِ تَسْلِيمَةً عَنْ أَيْمَانِهِمَا /27 , وَصَلَّيْتُ خَلْفَ الْقَاسِمِ فَلَا أَعْلَمُهُ خَالَفَهُمَا \" * \r\n$2987  /3 /141 حَدَّثَنَا /94 عَبْدُ الْأَعْلَى /94 ، عَنْ /26 خَالِدٍ /26 ، عَنْ /26 أَنَسِ بْنِ سِيرِينَ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، أَنَّهُ \" كَانَ /20 يُسَلِّمُ تَسْلِيمَةً \" /27 * \r\n$2988  /2 /141 حَدَّثَنَا /94 يُونُسُ بْنُ مُحَمَّدٍ L8617 /94 ، قَالَ : حَدَّثَنَا /26 جَرِيرُ بْنُ حَازِمٍ L2119 /26 ، عَنْ /26 أَيُّوبَ L746 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 سَلَّمَ تَسْلِيمَةً \" /27 * \r\n$2989  /3 /141 حَدَّثَنَا أَبُو بَكْرٍ /26 بَلَغَنِي /26 ، عَنْ /26 يَحْيَى بْنِ سَعِيدٍ /26 ، عَنْ /26 عُبَيْدِ اللَّهِ /26 ، عَنِ /26 الْقَاسِمِ /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 أَنَّهَا : \" كَانَتْ /20 تُسَلِّمُ تَسْلِيمَةً \" /27 * \r\n$2990  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 يَزِيدَ بْنِ دِرْهَمٍ /26 ، قَالَ : /27 رَأَيْتُ /26 أَنَسًا /26 , /26 وَالْحَسَنَ /26 وَأَبَا الْعَالِيَةِ /26 وَأَبَا رَجَاءٍ /26 /20 \" يُسَلِّمُونَ تَسْلِيمَةً \" /27 * \r\n$2991  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُلَيْمَانَ بْنِ زَيْدٍ /26 ، قَالَ : /27 رَأَيْتُ /93 ابْنَ أَبِي أَوْفَى L4622 /93 /20 \" يُسَلِّمُ تَسْلِيمَةً \" /27 * \r\n$2992  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 مَالِكِ بْنِ دِينَارٍ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، أَنَّهُ \" كَانَ /20 يُسَلِّمُ تَسْلِيمَةً \" /27 * \r\n$2993  /8 /141 حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ /94 ، عَنْ /26 وِقَاءٍ /26 ، /27 أَنَّ /26 سَعِيدَ بْنَ جُبَيْرٍ /26 \" كَانَ /20 يُسَلِّمُ تَسْلِيمَةً \" /27 * \r\n$2994  /8 /141 حَدَّثَنَا /94 مُصْعَبُ بْنُ الْمِقْدَامِ /94 ، قَالَ : نا /26 إِسْرَائِيلُ /26 ، عَنْ /26 عِمْرَانَ بْنِ مُسْلِمٍ /26 ، /27 عَنْ /26 سُوَيْدٍ /26 أَنَّهُ \" كَانَ /20 يُسَلِّمُ تَسْلِيمَةً وَاحِدَةً \" /27 * \r\n$2995  /8 /141 حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنْ /26 إِسْمَاعِيلَ /26 ، /27 عَنْ /26 قَيْسٍ /26 أَنَّهُ \" كَانَ /20 يُسَلِّمُ تَسْلِيمَةً \" /27 * \r\n@ 1 : 336 @1E419",
      "sanad_ar": "$2980  /2 /141 حَدَّثَنَا أَبُو بَكْرٍ",
