      "chapter_id": null,
      "hadith_number": 4497,
      "text_ar": "حَدَّثّنَا /94 ابْنُ عُيَيْنَةَ /94 ، عَنْ /26 عَمْرٍو /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قَالَ : /20 \" إذَا نَعَسْتَ يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ فَتَحَوَّلْ \" /27 * \r\n$5112  /8 /141 حَدَّثَنَا /94 الثَّقَفِيُّ /94 ، عَنْ /26 أَيُّوبَ /26 ، قَالَ : /27 \" كَانَ /26 مُحَمَّدٌ /26 /20 يُوقِظُ النَّائِمَ يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ \" /27 * \r\n$5113  /8 /141 حَدَّثَنَا /94 الثَّقَفِيُّ /94 ، عَنْ /26 أَيُّوبَ /26 ، /27 عَنِ /26 ابْنِ سِيرِينَ /26 : \" أَنَّهُ كَانَ /20 إذَا خَشِيَ أَنْ يَنْعَسَ فِي الْجُمُعَةِ تَحَوَّلَ \" /27 * \r\n$5114  /8",
      "sanad_ar": "حَدَّثّنَا /94 ابْنُ عُيَيْنَةَ /94",
      "matn_ar": "عَنْ /26 عَمْرٍو /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قَالَ : /20 \" إذَا نَعَسْتَ يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ فَتَحَوَّلْ \" /27 * \r\n$5112  /8 /141 حَدَّثَنَا /94 الثَّقَفِيُّ /94 ، عَنْ /26 أَيُّوبَ /26 ، قَالَ : /27 \" كَانَ /26 مُحَمَّدٌ /26 /20 يُوقِظُ النَّائِمَ يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ \" /27 * \r\n$5113  /8 /141 حَدَّثَنَا /94 الثَّقَفِيُّ /94 ، عَنْ /26 أَيُّوبَ /26 ، /27 عَنِ /26 ابْنِ سِيرِينَ /26 : \" أَنَّهُ كَانَ /20 إذَا خَشِيَ أَنْ يَنْعَسَ فِي الْجُمُعَةِ تَحَوَّلَ \" /27 * \r\n$5114  /8",
