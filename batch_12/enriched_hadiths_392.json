      "chapter_id": null,
      "hadith_number": 4493,
      "text_ar": "$5101  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ الْأَحْمَرُ /94 ، عَنْ /26 مُحَمَّدِ بْنِ عَجْلَانَ /26 ، عَنْ /26 نَافِعٍ /26 : /27 عَنِ /93 ابْنِ عُمَرَ /93 , أَنَّهُ كَانَ /20 يَحْتَبِي وَالْإِمَامُ يَخْطُبُ \" /27 * \r\n$5102  /8 /141 حَدَّثَنَا /94 عَبْدُ الْأَعْلَى /94 ، عَنْ /26 مَعْمَرٍ /26 ، عَنِ /26 الزُّهْرِيِّ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ الْمُسَيِّبِ /26 : أَنَّهُ كَانَ /20 مُحْتَبِيًا يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ \" /27 * \r\n$5103  /8 /141 حَدَّثَنَا /94 أَبُو أُسَامَةَ /94 ، عَنْ /26 عُبَيْدِ اللَّهِ بْنِ عُمَرَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَالِمًا /26 ، /26 وَالْقَاسِمَ /26 /20 يَحْتَبِيَانِ يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ \" /27 * \r\n$5104  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 فِطْرٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 عَطَاءً /26 /20 مُحْتَبِيًا يَوْمَ الْجُمُعَةِ \" /27 * \r\n$5105  /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ أَبِي عَدِيٍّ /94 ، عَنْ /26 أَشْعَثَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْحَسَنَ /26 /20 يَحْتَبِي وَالْإِمَامُ يَخْطُبُ يَوْمَ الْجُمُعَةِ \" /27 * \r\n$5106  /8 /141 حَدَّثَنَا /94 الضَّحَّاكُ بْنُ مَخْلَدٍ /94 ، عَنْ /26 سَالِمٍ الْخَيَّاطِ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْحَسَنَ /26 , /26 وَمُحَمَّدًا /26 ، /26 وَعِكْرِمَةَ بْنَ خَالِدٍ الْمَخْزُومِيَّ /26 ، /26 وَعَمْرَو بْنَ دِينَارٍ /26 ، /26 وَأَبَا الزُّبَيْرِ /26 ، /26 وَعَطَاءً /26 /20 يَحْتَبُونَ يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ \" /27 * \r\n$5107  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الْعُمَرِيِّ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ /93 : \" أَنَّهُ كَانَ /20 يَحْتَبِي وَالْإِمَامُ يَخْطُبُ يَوْمَ الْجُمُعَةِ \" /27 * \r\n$5108  /3 /141 حَدَّثَنَا /94 أَبُو أُسَامَةَ /94 ، قَالَ : حَدَّثَنَا /26 عُبَيْدُ اللَّهِ /26 ، عَنْ /26 نَافِعٍ /26 ، قَالَ : /27 \" كَانَ /93 ابْنُ عُمَرَ /93 /20 يَحْتَبِي يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ \" /27 *",
      "sanad_ar": "$5101  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ الْأَحْمَرُ /94",
      "matn_ar": "عَنْ /26 مُحَمَّدِ بْنِ عَجْلَانَ /26 ، عَنْ /26 نَافِعٍ /26 : /27 عَنِ /93 ابْنِ عُمَرَ /93 , أَنَّهُ كَانَ /20 يَحْتَبِي وَالْإِمَامُ يَخْطُبُ \" /27 * \r\n$5102  /8 /141 حَدَّثَنَا /94 عَبْدُ الْأَعْلَى /94 ، عَنْ /26 مَعْمَرٍ /26 ، عَنِ /26 الزُّهْرِيِّ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ الْمُسَيِّبِ /26 : أَنَّهُ كَانَ /20 مُحْتَبِيًا يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ \" /27 * \r\n$5103  /8 /141 حَدَّثَنَا /94 أَبُو أُسَامَةَ /94 ، عَنْ /26 عُبَيْدِ اللَّهِ بْنِ عُمَرَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَالِمًا /26 ، /26 وَالْقَاسِمَ /26 /20 يَحْتَبِيَانِ يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ \" /27 * \r\n$5104  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 فِطْرٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 عَطَاءً /26 /20 مُحْتَبِيًا يَوْمَ الْجُمُعَةِ \" /27 * \r\n$5105  /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ أَبِي عَدِيٍّ /94 ، عَنْ /26 أَشْعَثَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْحَسَنَ /26 /20 يَحْتَبِي وَالْإِمَامُ يَخْطُبُ يَوْمَ الْجُمُعَةِ \" /27 * \r\n$5106  /8 /141 حَدَّثَنَا /94 الضَّحَّاكُ بْنُ مَخْلَدٍ /94 ، عَنْ /26 سَالِمٍ الْخَيَّاطِ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْحَسَنَ /26 , /26 وَمُحَمَّدًا /26 ، /26 وَعِكْرِمَةَ بْنَ خَالِدٍ الْمَخْزُومِيَّ /26 ، /26 وَعَمْرَو بْنَ دِينَارٍ /26 ، /26 وَأَبَا الزُّبَيْرِ /26 ، /26 وَعَطَاءً /26 /20 يَحْتَبُونَ يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ \" /27 * \r\n$5107  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الْعُمَرِيِّ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ /93 : \" أَنَّهُ كَانَ /20 يَحْتَبِي وَالْإِمَامُ يَخْطُبُ يَوْمَ الْجُمُعَةِ \" /27 * \r\n$5108  /3 /141 حَدَّثَنَا /94 أَبُو أُسَامَةَ /94 ، قَالَ : حَدَّثَنَا /26 عُبَيْدُ اللَّهِ /26 ، عَنْ /26 نَافِعٍ /26 ، قَالَ : /27 \" كَانَ /93 ابْنُ عُمَرَ /93 /20 يَحْتَبِي يَوْمَ الْجُمُعَةِ وَالْإِمَامُ يَخْطُبُ \" /27 *",
