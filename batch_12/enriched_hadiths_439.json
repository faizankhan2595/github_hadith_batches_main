      "chapter_id": null,
      "hadith_number": 5199,
      "text_ar": "حَدَّثَنَا /94 عَبْدَةُ /94 ، عَنْ /26 هِشَامِ بْنِ عُرْوَةَ /26 ، /27 عَنِ /26 ابْنٍ لَعُمَيْرٍ /26 ، عَنْ /26 أَبِيهِ /26 : \" أَنَّ /20 رَجُلًا أَعْمَى كَانَ يَؤُمُّ بَنِي خَطْمَةَ فِي زَمَنِ عُمَرَ \" /27 * \r\n$5915  /3 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ الْحَسَنِ /94 ، قَالَ : حَدَّثَنَا /26 شَرِيكٌ /26 ، عَنْ /26 مُهَاجِرٍ /26 ، قَالَ : /27 \" كَانَ /93 الْبَرَاءُ L1157 /93 /20 يُصَلِّي بِنَا وَهُوَ أَعْمَى \" /27 * \r\n$5916  /3 /141 حَدَّثَنَا /94 عَبْدُ الْأَعْلَى /94 ، عَنْ /26 مَعْمَرٍ /26 ، عَنِ /26 الزُّهْرِيِّ /26 ، عَنْ /26 مَحْمُودِ بْنِ الرَّبِيعِ /26 ، /27 عَنْ /93 عِتْبَانَ بْنِ مَالِكٍ L5459 /93 : \" أَنَّهُ كَانَ /20 يَؤُمُّ قَوْمَهُ وَهُوَ أَعْمَى \" /27 * \r\n\u0011E821 \r\n$5917  /3 /141 حَدَّثَنَا /94 خَالِدُ بْنُ مَخْلَدٍ /94 ، قَالَ : حَدَّثَنَا /26 مَالِكُ بْنُ أَنَسٍ /26 ، عَنِ /26 ابْنِ شِهَابٍ /26 ، عَنْ /26 مَحْمُودِ بْنِ الرَّبِيعِ /26 ، /27 عَنْ /93 عِتْبَانَ بْنِ مَالِكٍ L5459 /93 : \" أَنَّهُ كَانَ /20 يَؤُمُّ قَوْمَهُ وَهُوَ أَعْمَى \" /27 * \r\n$5918  /8",
      "sanad_ar": "حَدَّثَنَا /94 عَبْدَةُ /94",
      "matn_ar": "عَنْ /26 هِشَامِ بْنِ عُرْوَةَ /26 ، /27 عَنِ /26 ابْنٍ لَعُمَيْرٍ /26 ، عَنْ /26 أَبِيهِ /26 : \" أَنَّ /20 رَجُلًا أَعْمَى كَانَ يَؤُمُّ بَنِي خَطْمَةَ فِي زَمَنِ عُمَرَ \" /27 * \r\n$5915  /3 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ الْحَسَنِ /94 ، قَالَ : حَدَّثَنَا /26 شَرِيكٌ /26 ، عَنْ /26 مُهَاجِرٍ /26 ، قَالَ : /27 \" كَانَ /93 الْبَرَاءُ L1157 /93 /20 يُصَلِّي بِنَا وَهُوَ أَعْمَى \" /27 * \r\n$5916  /3 /141 حَدَّثَنَا /94 عَبْدُ الْأَعْلَى /94 ، عَنْ /26 مَعْمَرٍ /26 ، عَنِ /26 الزُّهْرِيِّ /26 ، عَنْ /26 مَحْمُودِ بْنِ الرَّبِيعِ /26 ، /27 عَنْ /93 عِتْبَانَ بْنِ مَالِكٍ L5459 /93 : \" أَنَّهُ كَانَ /20 يَؤُمُّ قَوْمَهُ وَهُوَ أَعْمَى \" /27 * \r\n\u0011E821 \r\n$5917  /3 /141 حَدَّثَنَا /94 خَالِدُ بْنُ مَخْلَدٍ /94 ، قَالَ : حَدَّثَنَا /26 مَالِكُ بْنُ أَنَسٍ /26 ، عَنِ /26 ابْنِ شِهَابٍ /26 ، عَنْ /26 مَحْمُودِ بْنِ الرَّبِيعِ /26 ، /27 عَنْ /93 عِتْبَانَ بْنِ مَالِكٍ L5459 /93 : \" أَنَّهُ كَانَ /20 يَؤُمُّ قَوْمَهُ وَهُوَ أَعْمَى \" /27 * \r\n$5918  /8",
