    {
      "hadith_id": 101192,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 818,
      "text_ar": "حَدَّثَنَا /94 ابْنُ نُمَيْرٍ /94 ، عَنْ /26 زَكَرِيَّا /26 ، عَنْ /26 فِرَاسٍ /26 قَالَ : /27 اشْتَرَيْتُ جَارِيَةً صَغِيرَةً فَكُنْتُ أُصِيبُ مِنْهَا مِنْ غَيْرِ أَنْ أُخَالِطَهَا فَسَأَلْتُ /26 الشَّعْبِيَّ /26 فَقَالَ : \" أَمَّا /20 أَنْتَ فَاغْتَسِلْ وَأَمَّا هِيَ فَيَكْفِيهَا الْوُضُوءُ \" /27 * \r\n$956  /8",
      "sanad_ar": "حَدَّثَنَا /94 ابْنُ نُمَيْرٍ /94",
      "matn_ar": "عَنْ /26 زَكَرِيَّا /26 ، عَنْ /26 فِرَاسٍ /26 قَالَ : /27 اشْتَرَيْتُ جَارِيَةً صَغِيرَةً فَكُنْتُ أُصِيبُ مِنْهَا مِنْ غَيْرِ أَنْ أُخَالِطَهَا فَسَأَلْتُ /26 الشَّعْبِيَّ /26 فَقَالَ : \" أَمَّا /20 أَنْتَ فَاغْتَسِلْ وَأَمَّا هِيَ فَيَكْفِيهَا الْوُضُوءُ \" /27 * \r\n$956  /8",
