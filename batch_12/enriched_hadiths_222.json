    {
      "hadith_id": 102323,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 1949,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، عَنْ /26 جَعْفَرِ بْنِ بُرْقَانَ L2143 /26 ، عَنْ /26 شَدَّادٍ L3762 /26 مَوْلَى عِيَاضِ بْنِ عَامِرٍ ، /27 عَنْ /93 بِلَالٍ L1963 /93 ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : /20 \" لَا تُؤَذِّنْ حَتَّى تَرَى الْفَجْرَ هَكَذَا وَمَدَّ يَدَيْهِ \" /27 * \r\n$2160  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 طَلْحَةَ /26 ، عَنْ /26 سُوَيْدٍ /26 ، /27 عَنْ /93 بِلَالٍ L1963 /93 ، قَالَ : \" كَانَ /20 لَا يُؤَذِّنُ حَتَّى يَنْشَقَّ الْفَجْرُ \" /27 * \r\n$2161  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ الْأَحْمَرُ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 عَطَاءٍ /26 ، /27 عَنْ /93 أَبِي مَحْذُورَةَ L734 /93 أَنَّهُ أَذَّنَ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَلِأَبِي بَكْرٍ وَعُمَرَ \" فَكَانَ /20 لَا يُؤَذِّنُ حَتَّى يَطْلُعَ الْفَجْرُ \" /27 * \r\n@ 1 : 243 @ \r\n$2162  /3",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ L8160 /94",
      "matn_ar": "عَنْ /26 جَعْفَرِ بْنِ بُرْقَانَ L2143 /26 ، عَنْ /26 شَدَّادٍ L3762 /26 مَوْلَى عِيَاضِ بْنِ عَامِرٍ ، /27 عَنْ /93 بِلَالٍ L1963 /93 ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : /20 \" لَا تُؤَذِّنْ حَتَّى تَرَى الْفَجْرَ هَكَذَا وَمَدَّ يَدَيْهِ \" /27 * \r\n$2160  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 طَلْحَةَ /26 ، عَنْ /26 سُوَيْدٍ /26 ، /27 عَنْ /93 بِلَالٍ L1963 /93 ، قَالَ : \" كَانَ /20 لَا يُؤَذِّنُ حَتَّى يَنْشَقَّ الْفَجْرُ \" /27 * \r\n$2161  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ الْأَحْمَرُ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 عَطَاءٍ /26 ، /27 عَنْ /93 أَبِي مَحْذُورَةَ L734 /93 أَنَّهُ أَذَّنَ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَلِأَبِي بَكْرٍ وَعُمَرَ \" فَكَانَ /20 لَا يُؤَذِّنُ حَتَّى يَطْلُعَ الْفَجْرُ \" /27 * \r\n@ 1 : 243 @ \r\n$2162  /3",
