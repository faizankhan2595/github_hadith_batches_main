      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 440,
      "text_ar": "حَدَّثَنَا /94 شَرِيكٌ /94 ، عَنْ /26 عَطَاءٍ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، قَالَ : /20 \" هُوَ طُهُورٌ وَبَرَكَةٌ \" /27 * \r\n@ 1 : 71 @ \r\n$562  /8 /141 حَدَّثَنَا /94 حَفْصُ بْنُ غِيَاثٍ /94 ، عَنْ /26 حَفْصِ بْنِ أَبِي دَاوُدَ /26 ، عَنْ /26 عَاصِمٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 أَبَا وَائِلٍ /26 /20 أَخَذَ مِنْ شَعْرِهِ ثُمَّ دَخَلَ الْمَسْجِدَ فَصَلَّى \" /27 . حَدَّثَنَا /94 الْمُحَارِبِيُّ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 أَبِي جَعْفَرٍ /26 ، /26 وَعَطَاءٍ /26 ، /26 وَالْحَكَمِ /26 ، /26 وَالزُّهْرِيِّ /26 ، قَالُوا : \" لَيْسَ عَلَيْهِ وُضُوءٌ \" * \r\n$563  /3",
