      "text_ar": "حَدَّثَنَا /94 أَبُو مُعَاوِيَةَ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، عَنْ /26 مُسْلِمٍ /26 ، /27 عَنْ /26 مَسْرُوقٍ /26 ، قَالَ : /20 \" ذكرت عِنْدَ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ فَقَالَ : /4 أُولَئِكَ الَّذِينَ هَدَى اللَّهُ فَبِهُدَاهُمُ اقْتَدِهْ سورة الأنعام آية 90 /4 \" /27 * \r\n$4163  /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ بَكْرٍ /94 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، قَالَ : /27 \" كَانَ /26 طَاوُسٌ /26 /20 يَسْجُدُ فِي /65 ص /65 \" /27 * \r\n$4164  /8 /141 حَدَّثَنَا /94 عَبَّادُ بْنُ الْعَوَّامِ /94 ، عَنْ /26 سُفْيَانَ بْنِ حُسَيْنٍ /26 ، قَالَ : /27 \" شَهِدْتُ /26 الْحَسَنَ /26 /20 وَقَرَأَ السَّجْدَةَ الَّتِي فِي \" ص \" فَسَجَدَ \" /27 * \r\n$4165  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، عَنْ /26 أَبِي الضُّحَى /26 ، /27 عَنْ /26 مَسْرُوقٍ /26 أَنَّهُ \" كَانَ /20 يَسْجُدُ فِي /65 ص /65 \" /27 * \r\n$4166  /8",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو مُعَاوِيَةَ /94",
      "matn_ar": "عَنِ /26 الْأَعْمَشِ /26 ، عَنْ /26 مُسْلِمٍ /26 ، /27 عَنْ /26 مَسْرُوقٍ /26 ، قَالَ : /20 \" ذكرت عِنْدَ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ فَقَالَ : /4 أُولَئِكَ الَّذِينَ هَدَى اللَّهُ فَبِهُدَاهُمُ اقْتَدِهْ سورة الأنعام آية 90 /4 \" /27 * \r\n$4163  /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ بَكْرٍ /94 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، قَالَ : /27 \" كَانَ /26 طَاوُسٌ /26 /20 يَسْجُدُ فِي /65 ص /65 \" /27 * \r\n$4164  /8 /141 حَدَّثَنَا /94 عَبَّادُ بْنُ الْعَوَّامِ /94 ، عَنْ /26 سُفْيَانَ بْنِ حُسَيْنٍ /26 ، قَالَ : /27 \" شَهِدْتُ /26 الْحَسَنَ /26 /20 وَقَرَأَ السَّجْدَةَ الَّتِي فِي \" ص \" فَسَجَدَ \" /27 * \r\n$4165  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، عَنْ /26 أَبِي الضُّحَى /26 ، /27 عَنْ /26 مَسْرُوقٍ /26 أَنَّهُ \" كَانَ /20 يَسْجُدُ فِي /65 ص /65 \" /27 * \r\n$4166  /8",
