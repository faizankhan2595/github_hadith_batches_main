    {
      "hadith_id": 107484,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 7110,
      "text_ar": "حَدَّثَنَا /94 عَبْدُ اللَّهِ بْنُ مُبَارَكٍ /94 ، عَنْ /26 يَعْقُوبَ /26 ، عَنْ /26 عَطَاءٍ /26 ، وَعَنْ /26 جُوَيْبِرٍ /26 ، /27 عَنِ /26 الضَّحَّاكِ /26 : \" فِي /20 الْمَرِيضِ يُصَلِّي ، قَالَا : إِنْ شَاءَ جَمَعَ بَيْنَ الصَّلَاتَيْنِ \" /27 * \r\n$8076  /8",
