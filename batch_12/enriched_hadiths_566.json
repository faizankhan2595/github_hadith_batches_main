    {
      "hadith_id": 107479,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 7105,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : ثَنَا /26 عُبَيْدُ اللَّهِ بن عَبْدِ الرَّحْمَنِ بْنُ مَوْهَبٍ /26 ، قَالَ : /27 \" أَتَيْتُ /26 سَالِمًا /26 فَقُلْتُ : يَا أَبَا عُمَرَ /20 تَجْمَعُ بَيْنَ الصَّلَاتَيْنِ فِي السَّفَرِ ؟ فَقَالَ : لَا إِلَّا أَنْ يُعَجِّلَنِي سَيْرٌ \" /27 * \r\n$8072  /8",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ /94",
      "matn_ar": "قَالَ : ثَنَا /26 عُبَيْدُ اللَّهِ بن عَبْدِ الرَّحْمَنِ بْنُ مَوْهَبٍ /26 ، قَالَ : /27 \" أَتَيْتُ /26 سَالِمًا /26 فَقُلْتُ : يَا أَبَا عُمَرَ /20 تَجْمَعُ بَيْنَ الصَّلَاتَيْنِ فِي السَّفَرِ ؟ فَقَالَ : لَا إِلَّا أَنْ يُعَجِّلَنِي سَيْرٌ \" /27 * \r\n$8072  /8",
