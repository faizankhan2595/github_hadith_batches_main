      "hadith_id": 100579,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 205,
      "text_ar": "حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنْ /26 مَسْعُودِ بْنِ عَلِيٍّ /26 ، عَنْ /26 عِكْرِمَةَ /26 ، قَالَ : /27 قَالَ /93 سَعْدٌ L3232 /93 : /20 \" إِذَا تَوَضَّأْتَ فَصَلِّ بِوُضُوئِكَ ذَلِكَ مَا لَمْ تُحْدِثْ \" /27 * \r\n$283  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 يَزِيدَ /26 مَوْلَى سَلَمَةَ ، /27 عَنْ /26 سَلَمَةَ /26 ، أَنَّهُ كَانَ /20 \" يُصَلِّي الصَّلَوَاتِ بِوُضُوءٍ وَاحِدٍ \" /27 * \r\n$284  /8 /141 حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : /27 رَأَيْتُ /26 الشَّعْبِيَّ /26 /20 \" يُصَلِّي الصَّلَوَاتِ بِوُضُوءٍ وَاحِدٍ \" /27 * \r\n$285  /8",
      "sanad_ar": "حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94",
      "matn_ar": "عَنْ /26 مَسْعُودِ بْنِ عَلِيٍّ /26 ، عَنْ /26 عِكْرِمَةَ /26 ، قَالَ : /27 قَالَ /93 سَعْدٌ L3232 /93 : /20 \" إِذَا تَوَضَّأْتَ فَصَلِّ بِوُضُوئِكَ ذَلِكَ مَا لَمْ تُحْدِثْ \" /27 * \r\n$283  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 يَزِيدَ /26 مَوْلَى سَلَمَةَ ، /27 عَنْ /26 سَلَمَةَ /26 ، أَنَّهُ كَانَ /20 \" يُصَلِّي الصَّلَوَاتِ بِوُضُوءٍ وَاحِدٍ \" /27 * \r\n$284  /8 /141 حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : /27 رَأَيْتُ /26 الشَّعْبِيَّ /26 /20 \" يُصَلِّي الصَّلَوَاتِ بِوُضُوءٍ وَاحِدٍ \" /27 * \r\n$285  /8",
