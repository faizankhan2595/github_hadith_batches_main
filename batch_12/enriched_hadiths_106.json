      "chapter_id": null,
      "hadith_number": 204,
      "text_ar": "$280  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 لَيْثٍ /26 ، /27 عَنْ /26 عَطَاءٍ /26 ، /26 وَطَاوُسٍ /26 ، /26 وَمُجَاهِدٍ /26 : أَنَّهُمْ كَانُوا /20 \" يُصَلُّونَ الصَّلَوَاتِ كُلَّهَا بِوُضُوءٍ وَاحِدٍ \" /27 * \r\n$281  /8 /141 حَدَّثَنَا /94 أَبُو مُعَاوِيَةَ /94 ، /94 وَوَكِيعٌ /94 , عَنِ /26 الْأَعْمَشِ /26 ، عَنْ /26 عُمَارَةَ /26 ، /27 عَنِ /26 الْأَسْوَدِ /26 ، قَالَ : \" كَانَ /20 لَهُ قَعْبٌ يَتَوَضَّأُ بِهِ ثُمَّ يُصَلِّي بِوُضُوئِهِ ذَلِكَ الصَّلَوَاتِ كُلَّهَا \" /27 * \r\n$282  /3",
      "sanad_ar": "$280  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94",
      "matn_ar": "عَنْ /26 لَيْثٍ /26 ، /27 عَنْ /26 عَطَاءٍ /26 ، /26 وَطَاوُسٍ /26 ، /26 وَمُجَاهِدٍ /26 : أَنَّهُمْ كَانُوا /20 \" يُصَلُّونَ الصَّلَوَاتِ كُلَّهَا بِوُضُوءٍ وَاحِدٍ \" /27 * \r\n$281  /8 /141 حَدَّثَنَا /94 أَبُو مُعَاوِيَةَ /94 ، /94 وَوَكِيعٌ /94 , عَنِ /26 الْأَعْمَشِ /26 ، عَنْ /26 عُمَارَةَ /26 ، /27 عَنِ /26 الْأَسْوَدِ /26 ، قَالَ : \" كَانَ /20 لَهُ قَعْبٌ يَتَوَضَّأُ بِهِ ثُمَّ يُصَلِّي بِوُضُوئِهِ ذَلِكَ الصَّلَوَاتِ كُلَّهَا \" /27 * \r\n$282  /3",
