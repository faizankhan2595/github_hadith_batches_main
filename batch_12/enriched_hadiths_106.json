      "hadith_id": 100581,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 207,
      "text_ar": "حَدَّثَنَا /94 عَبْدُ اللَّهِ بْنُ إِدْرِيسَ /94 ، عَنْ /26 هِشَامٍ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، قَالَ : /20 \" يُصَلِّي الرَّجُلُ الصَّلَوَاتِ كُلَّهَا بِوُضُوءٍ وَاحِدٍ مَا لَمْ يُحْدِثْ وَكَذَلِكَ التَّيَمُّمُ \" /27 * \r\n@ 1 : 42 @ \r\n$287  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ الْأَحْمَرُ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 عَطِيَّةَ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قَالَ : \" كَانَ /20 يَجْلِسُ فَيُصَلِّي الظُّهْرَ وَالْعَصْرَ وَالْمَغْرِبَ بِوُضُوءٍ وَاحِدٍ \" /27 * \r\n$288  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنْ /26 جَابِرٍ /26 ، عَنْ رَجُلٍ ، يُقَالُ لَهُ : /26 سُلَيْمَانُ الْبَصْرِيُّ /26 ، /18 /26 عَمَّنْ /26 /18 /27 رَأَى /93 عُمَرَ L5913 /93 /20 \" يُصَلِّي الظُّهْرَ وَالْعَصْرَ وَالْمَغْرِبَ بِوُضُوءٍ وَاحِدٍ \" /27 * \r\n\u001cE41 \r\n$289  /8 /141 حَدَّثَنَا /94 أَزْهَرُ السَّمَّانُ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 ، /27 عَنْ /26 مُحَمَّدٍ /26 ، قَالَ : \" كَانَ رُبَّمَا /20 صَلَّى الظُّهْرَ ثُمَّ يَجْلِسُ حَتَّى يُصَلِّيَ الْعَصْرَ \" /27 , يَعْنِي : بِوُضُوءٍ وَاحِدٍ * \r\n$290  /8",
      "sanad_ar": "حَدَّثَنَا /94 عَبْدُ اللَّهِ بْنُ إِدْرِيسَ /94",
      "matn_ar": "عَنْ /26 هِشَامٍ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، قَالَ : /20 \" يُصَلِّي الرَّجُلُ الصَّلَوَاتِ كُلَّهَا بِوُضُوءٍ وَاحِدٍ مَا لَمْ يُحْدِثْ وَكَذَلِكَ التَّيَمُّمُ \" /27 * \r\n@ 1 : 42 @ \r\n$287  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ الْأَحْمَرُ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 عَطِيَّةَ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قَالَ : \" كَانَ /20 يَجْلِسُ فَيُصَلِّي الظُّهْرَ وَالْعَصْرَ وَالْمَغْرِبَ بِوُضُوءٍ وَاحِدٍ \" /27 * \r\n$288  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنْ /26 جَابِرٍ /26 ، عَنْ رَجُلٍ ، يُقَالُ لَهُ : /26 سُلَيْمَانُ الْبَصْرِيُّ /26 ، /18 /26 عَمَّنْ /26 /18 /27 رَأَى /93 عُمَرَ L5913 /93 /20 \" يُصَلِّي الظُّهْرَ وَالْعَصْرَ وَالْمَغْرِبَ بِوُضُوءٍ وَاحِدٍ \" /27 * \r\n\u001cE41 \r\n$289  /8 /141 حَدَّثَنَا /94 أَزْهَرُ السَّمَّانُ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 ، /27 عَنْ /26 مُحَمَّدٍ /26 ، قَالَ : \" كَانَ رُبَّمَا /20 صَلَّى الظُّهْرَ ثُمَّ يَجْلِسُ حَتَّى يُصَلِّيَ الْعَصْرَ \" /27 , يَعْنِي : بِوُضُوءٍ وَاحِدٍ * \r\n$290  /8",
