    {
      "hadith_id": 104989,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 4615,
      "text_ar": "حَدَّثَنَا /94 هُشَيْمُ بْنُ بَشِيرٍ /94 ، قَالَ : حَدَّثَنَا /26 يُونُسُ بْنُ عُبَيْدٍ /26 ، عَنْ /26 حُمَيْدِ بْنِ هِلَالٍ /26 ، /27 عَنْ /93 عِمْرَانَ بْنِ حُصَيْنٍ L6036 /93 : \" , أَنَّهُ كَانَ /20 يُصَلِّي بَعْدَ الْجُمُعَةِ رَكْعَتَيْنِ فَقِيلَ لَهُ : يَا أَبَا نُجَيْدٍ مَا يَقُولُ النَّاسُ ؟ قَالَ : وَمَا يَقُولُونَ ؟ ، قَالَ يَقُولُونَ : إنَّكَ تُصَلِّي رَكْعَتَيْنِ إلَى الْجُمُعَةِ فَتَكُونُ أَرْبَعًا ، قَالَ : فَقَالَ عِمْرَانُ : لَأَنْ تَخْتَلِفَ النَّيَازِكُ بَيْنَ أَضْلَاعِي أَحَبُّ إلَيَّ مِنْ أَنْ أَفْعَلَ ذَلِكَ ، فَلَمَّا كَانَتِ الْجُمُعَةُ الْمُقْبِلَةُ صَلَّى الْجُمُعَةَ ، ثُمَّ احْتَبَى فَلَمْ يُصَلِّ شَيْئًا حَتَّى أُقِيمَتْ صَلَاةُ الْعَصْرِ \" /27 * \r\n\u0015E724 @ 2 : 41 @ \r\n$5226  /3",
      "sanad_ar": "حَدَّثَنَا /94 هُشَيْمُ بْنُ بَشِيرٍ /94",
      "matn_ar": "قَالَ : حَدَّثَنَا /26 يُونُسُ بْنُ عُبَيْدٍ /26 ، عَنْ /26 حُمَيْدِ بْنِ هِلَالٍ /26 ، /27 عَنْ /93 عِمْرَانَ بْنِ حُصَيْنٍ L6036 /93 : \" , أَنَّهُ كَانَ /20 يُصَلِّي بَعْدَ الْجُمُعَةِ رَكْعَتَيْنِ فَقِيلَ لَهُ : يَا أَبَا نُجَيْدٍ مَا يَقُولُ النَّاسُ ؟ قَالَ : وَمَا يَقُولُونَ ؟ ، قَالَ يَقُولُونَ : إنَّكَ تُصَلِّي رَكْعَتَيْنِ إلَى الْجُمُعَةِ فَتَكُونُ أَرْبَعًا ، قَالَ : فَقَالَ عِمْرَانُ : لَأَنْ تَخْتَلِفَ النَّيَازِكُ بَيْنَ أَضْلَاعِي أَحَبُّ إلَيَّ مِنْ أَنْ أَفْعَلَ ذَلِكَ ، فَلَمَّا كَانَتِ الْجُمُعَةُ الْمُقْبِلَةُ صَلَّى الْجُمُعَةَ ، ثُمَّ احْتَبَى فَلَمْ يُصَلِّ شَيْئًا حَتَّى أُقِيمَتْ صَلَاةُ الْعَصْرِ \" /27 * \r\n\u0015E724 @ 2 : 41 @ \r\n$5226  /3",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/94,/94,/26,/26,/26,/26,/27,/93,/93,/20,/27,/3",
