      "chapter_id": null,
      "hadith_number": 4619,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 ابْنُ إدْرِيسَ L4667 /94 ، عَنْ أَبِيهِ ، عَنْ /26 سُهَيْلٍ L3687 /26 ، عَنْ /26 أَبِيهِ L2840 /26 ، /27 عَنْ /93 أَبِي هُرَيْرَةَ L4396 /93 ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : /20 \" مَنْ كَانَ مِنْكُمْ مُصَلِّيًا بَعْدَ الْجُمُعَةِ فَلْيُصَلِّ أَرْبَعًا \" /27 * \r\n$5233  /3 /141 حَدَّثَنَا /94 شَرِيكٌ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ حَبِيبٍ /26 ، /27 عَنْ /93 عَبْدِ اللَّهِ /93 قَالَ : \" كَانَ /20 يُصَلِّي بَعْدَ الْجُمُعَةِ أَرْبَعًا \" /27 * \r\n$5234  /3 /141 حَدَّثَنَا /94 ابْنُ فُضَيْلٍ /94 ، عَنْ /26 خُصَيْفٍ /26 ، عَنْ /26 أَبِي عُبَيْدَةَ /26 ، /27 عَنْ /93 عَبْدِ اللَّهِ /93 : \" أَنَّهُ كَانَ /20 يُصَلِّي بَعْدَ الْجُمُعَةِ أَرْبَعًا /27 * \r\n$5235  /3 /141 حَدَّثَنَا /94 مَرْوَانُ بْنُ مُعَاوِيَةَ /94 ، عَنِ /26 الْعَلَاءِ بْنِ الْمُسَيِّبِ /26 ، عَنْ /26 أَبِيهِ /26 ، قَالَ : /27 \" كَانَ /93 عَبْدُ اللَّهِ /93 /20 يُصَلِّي بَعْدَ الْجُمُعَةِ أَرْبَعًا \" /27 * \r\n$5236  /8 /141 حَدَّثَنَا /94 ابْنُ نُمَيْرٍ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 حَمَّادٍ /26 ، عَنْ /26 إبْرَاهِيمَ /26 ، /27 عَنْ /26 عَلْقَمَةَ /26 : \" أَنَّهُ كَانَ /20 يُصَلِّي أَرْبَعًا بَعْدَ الْجُمُعَةِ لَا يَفْصِلُ بَيْنَهُنَّ \" /27 * \r\n@ 2 : 42 @ \r\n$5237  /8 /141 حَدَّثَنَا /94 أَبُو دَاوُدَ /94 ، عَنْ /26 شُعْبَةَ /26 ، عَنْ /26 أَبِي حُصَيْنٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْأَسْوَدَ بْنَ يَزِيدَ /26 /20 صَلَّى بَعْدَ الْجُمُعَةِ أَرْبَعًا \" /27 * \r\n$5238  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، /27 عَنْ /26 إبْرَاهِيمَ /26 ، قَالَ : \" كَانُوا /20 يُصَلُّونَ بَعْدَهَا أَرْبَعًا \" /27 * \r\n$5239  /8",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 ابْنُ إدْرِيسَ L4667 /94 ، عَنْ أَبِيهِ ، عَنْ /26 سُهَيْلٍ L3687 /26 ، عَنْ /26 أَبِيهِ L2840 /26 ، /27 عَنْ /93 أَبِي هُرَيْرَةَ L4396 /93 ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : /20 \" مَنْ كَانَ مِنْكُمْ مُصَلِّيًا بَعْدَ الْجُمُعَةِ فَلْيُصَلِّ أَرْبَعًا \" /27 * \r\n$5233  /3 /141 حَدَّثَنَا /94 شَرِيكٌ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ حَبِيبٍ /26 ، /27 عَنْ /93 عَبْدِ اللَّهِ /93 قَالَ : \" كَانَ /20 يُصَلِّي بَعْدَ الْجُمُعَةِ أَرْبَعًا \" /27 * \r\n$5234  /3 /141 حَدَّثَنَا /94 ابْنُ فُضَيْلٍ /94 ، عَنْ /26 خُصَيْفٍ /26 ، عَنْ /26 أَبِي عُبَيْدَةَ /26 ، /27 عَنْ /93 عَبْدِ اللَّهِ /93 : \" أَنَّهُ كَانَ /20 يُصَلِّي بَعْدَ الْجُمُعَةِ أَرْبَعًا /27 * \r\n$5235  /3 /141 حَدَّثَنَا /94 مَرْوَانُ بْنُ مُعَاوِيَةَ /94 ، عَنِ /26 الْعَلَاءِ بْنِ الْمُسَيِّبِ /26 ، عَنْ /26 أَبِيهِ /26 ، قَالَ : /27 \" كَانَ /93 عَبْدُ اللَّهِ /93 /20 يُصَلِّي بَعْدَ الْجُمُعَةِ أَرْبَعًا \" /27 * \r\n$5236  /8 /141 حَدَّثَنَا /94 ابْنُ نُمَيْرٍ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 حَمَّادٍ /26 ، عَنْ /26 إبْرَاهِيمَ /26 ، /27 عَنْ /26 عَلْقَمَةَ /26 : \" أَنَّهُ كَانَ /20 يُصَلِّي أَرْبَعًا بَعْدَ الْجُمُعَةِ لَا يَفْصِلُ بَيْنَهُنَّ \" /27 * \r\n@ 2 : 42 @ \r\n$5237  /8 /141 حَدَّثَنَا /94 أَبُو دَاوُدَ /94 ، عَنْ /26 شُعْبَةَ /26 ، عَنْ /26 أَبِي حُصَيْنٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْأَسْوَدَ بْنَ يَزِيدَ /26 /20 صَلَّى بَعْدَ الْجُمُعَةِ أَرْبَعًا \" /27 * \r\n$5238  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، /27 عَنْ /26 إبْرَاهِيمَ /26 ، قَالَ : \" كَانُوا /20 يُصَلُّونَ بَعْدَهَا أَرْبَعًا \" /27 * \r\n$5239  /8",
