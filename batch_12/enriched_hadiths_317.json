      "hadith_id": 103742,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 3368,
      "text_ar": "حَدَّثَنَا /94 عَبْدَةُ /94 ، عَنْ /26 هِشَامِ بْنِ عُرْوَةَ /26 ، قَالَ : حَدَّثَنِي رَجُلٌ /27 سَأَلَ /93 عَبْدَ اللَّهِ بْنَ عُمَرَ L4967 /93 عَنِ /20 الصَّلَاةِ فِي أَعْطَانِ الْإِبِلِ ، قَالَ : فَنَهَاهُ ، وَقَالَ : \" صَلِّ فِي مُرَاحِ الْغَنَمِ \" /27 * \r\n@ 1 : 421 @ \r\n$3780  /2 /141 حَدَّثَنَا /94 أَبُو أُسَامَةَ L2484 /94 ، عَنْ /26 شُعْبَةَ L3795 /26 ، عَنْ /26 أَبِي التَّيَّاحِ L8408 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 يُصَلِّي فِي مَرَابِضِ الْغَنَمِ قَبْلَ أَنْ يُبْنَى الْمَسْجِدُ \" /27 * \r\n$3781  /3 /141 حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، عَنِ /26 ابْنِ أَبِي نَجِيحٍ /26 ، عَنْ /26 إِسْمَاعِيلَ بْنِ عَبْدِ الرَّحْمَنِ /26 : /27 \" أَنَّ /93 عُمَرَ L5913 /93 /20 صَلَّى فِي مَكَانٍ فِيهِ دِمْنٌ \" /27 * \r\n$3782  /3 /141 حَدَّثَنَا /94 عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ /94 ، عَنْ /26 صَخْرِ بْنِ جُوَيْرِيَةَ /26 ، عَنْ /26 عَاصِمِ بْنِ الْمُنْذِرِ /26 ، قَالَ : /27 \" خَرَجَ /93 ابْنُ الزُّبَيْرِ L4697 /93 إِلَى الْمُزْدَلِفَةِ فِي غَيْرِ أَشْهُرِ الْحَجِّ /20 فَصَلَّى بِنَا فِي مُرَاحِ الْغَنَمِ وَهُوَ يَجِدُ أَمْكِنَةً سِوَاهَا لَوْ شَاءَ لَصَلَّى فِيهَا وَمَا رَأَيْتُهُ فَعَلَ ذَلِكَ إِلَّا لِيُرِيَنَا \" /27 * \r\n$3783  /8",
      "sanad_ar": "حَدَّثَنَا /94 عَبْدَةُ /94",
      "matn_ar": "عَنْ /26 هِشَامِ بْنِ عُرْوَةَ /26 ، قَالَ : حَدَّثَنِي رَجُلٌ /27 سَأَلَ /93 عَبْدَ اللَّهِ بْنَ عُمَرَ L4967 /93 عَنِ /20 الصَّلَاةِ فِي أَعْطَانِ الْإِبِلِ ، قَالَ : فَنَهَاهُ ، وَقَالَ : \" صَلِّ فِي مُرَاحِ الْغَنَمِ \" /27 * \r\n@ 1 : 421 @ \r\n$3780  /2 /141 حَدَّثَنَا /94 أَبُو أُسَامَةَ L2484 /94 ، عَنْ /26 شُعْبَةَ L3795 /26 ، عَنْ /26 أَبِي التَّيَّاحِ L8408 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 يُصَلِّي فِي مَرَابِضِ الْغَنَمِ قَبْلَ أَنْ يُبْنَى الْمَسْجِدُ \" /27 * \r\n$3781  /3 /141 حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، عَنِ /26 ابْنِ أَبِي نَجِيحٍ /26 ، عَنْ /26 إِسْمَاعِيلَ بْنِ عَبْدِ الرَّحْمَنِ /26 : /27 \" أَنَّ /93 عُمَرَ L5913 /93 /20 صَلَّى فِي مَكَانٍ فِيهِ دِمْنٌ \" /27 * \r\n$3782  /3 /141 حَدَّثَنَا /94 عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ /94 ، عَنْ /26 صَخْرِ بْنِ جُوَيْرِيَةَ /26 ، عَنْ /26 عَاصِمِ بْنِ الْمُنْذِرِ /26 ، قَالَ : /27 \" خَرَجَ /93 ابْنُ الزُّبَيْرِ L4697 /93 إِلَى الْمُزْدَلِفَةِ فِي غَيْرِ أَشْهُرِ الْحَجِّ /20 فَصَلَّى بِنَا فِي مُرَاحِ الْغَنَمِ وَهُوَ يَجِدُ أَمْكِنَةً سِوَاهَا لَوْ شَاءَ لَصَلَّى فِيهَا وَمَا رَأَيْتُهُ فَعَلَ ذَلِكَ إِلَّا لِيُرِيَنَا \" /27 * \r\n$3783  /8",
