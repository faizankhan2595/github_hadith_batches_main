    {
      "hadith_id": 105933,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 5559,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 شُعْبَةَ /26 ، عَنِ /26 الْحَكَمِ /26 ، عَنْ /26 يَحْيَى بْنِ الْجَزَّارِ /26 ، قَالَ : /27 كَانَ /26 أَصْحَابُ عَبْدِ اللَّهِ /26 , يَقُولُونَ : /20 \" الصَّفُّ الْمُقَدَّمُ الَّذِي يَلِي الْمَقْصُورَةَ \" /27 * \r\n$6307  /3",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 شُعْبَةَ /26 ، عَنِ /26 الْحَكَمِ /26 ، عَنْ /26 يَحْيَى بْنِ الْجَزَّارِ /26 ، قَالَ : /27 كَانَ /26 أَصْحَابُ عَبْدِ اللَّهِ /26 , يَقُولُونَ : /20 \" الصَّفُّ الْمُقَدَّمُ الَّذِي يَلِي الْمَقْصُورَةَ \" /27 * \r\n$6307  /3",
