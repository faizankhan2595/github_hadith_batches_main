    {
      "hadith_id": 105934,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 5560,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الْمَسْعُودِيِّ /26 ، عَنْ /26 ثَابِتِ بْنِ عُبَيْدٍ /26 ، قَالَ : /27 سَمِعْتُ /26 أَبَا عُبَيْدَةَ /26 , يَقُولُ : /20 \" الصَّفُّ الْأَوَّلُ الَّذِي يَلِي الْمَقْصُورَةَ \" /27 * \r\n$6308  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنِ /26 الشَّيْبَانِيِّ /26 ، قَالَ : /27 رَأَيْتُ /26 أَبَا عَبْدِ الرَّحْمَنِ /26 ، /26 وَزِرَّ بْنَ حُبَيْشٍ /26 ، /26 وَعَمْرَو بْنَ مَيْمُونٍ /26 : /20 \" يُصَلُّونَ عَنْ يَمِينِ الْمَقْصُورَةِ \" /27 ، وَقَالَ حَفْصٌ مَرَّةً : \" مَا بَيْنَ الْأُسْطُوَانَةِ إِلَى الْحَائِطِ \" * \r\n$6309  /8",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ /94",
      "matn_ar": "عَنِ /26 الْمَسْعُودِيِّ /26 ، عَنْ /26 ثَابِتِ بْنِ عُبَيْدٍ /26 ، قَالَ : /27 سَمِعْتُ /26 أَبَا عُبَيْدَةَ /26 , يَقُولُ : /20 \" الصَّفُّ الْأَوَّلُ الَّذِي يَلِي الْمَقْصُورَةَ \" /27 * \r\n$6308  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنِ /26 الشَّيْبَانِيِّ /26 ، قَالَ : /27 رَأَيْتُ /26 أَبَا عَبْدِ الرَّحْمَنِ /26 ، /26 وَزِرَّ بْنَ حُبَيْشٍ /26 ، /26 وَعَمْرَو بْنَ مَيْمُونٍ /26 : /20 \" يُصَلُّونَ عَنْ يَمِينِ الْمَقْصُورَةِ \" /27 ، وَقَالَ حَفْصٌ مَرَّةً : \" مَا بَيْنَ الْأُسْطُوَانَةِ إِلَى الْحَائِطِ \" * \r\n$6309  /8",
