    {
      "hadith_id": 104594,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 4220,
      "text_ar": "حَدَّثَنَا عَبْدَةُ وَوَكِيعٌ ، عَنْ هِشَامٍ \" أَنَّ أَبَاهُ كَانَ يَعُدُّ الآيَ فِي الصَّلاةِ \" . * \r\n$4763  /8 /141 حَدَّثَنَا /94 أَبُو مُعَاوِيَةَ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، قَالَ : /27 كَانَ /26 يَحْيَى بْنُ وَثَّابٍ /26 /20 \" يَعُدُّ الْآيَ فِي الصَّلَاةِ \" /27 * \r\n$4764  /8 /141 حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94 ، عَنْ /26 أَيُّوبَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 طَاوُسًا /26 /26 وَنَافِعًا /26 /20 يَعُدَّانِ الْآيَ فِي الصَّلَاةِ \" /27 * \r\n$4765  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 خَالِدٍ /26 ، /27 عَنِ /26 ابْنِ سِيرِينَ /26 ، أَنَّهُ كَانَ /20 \" يَعُدُّ الْآيَ بِشِمَالِهِ فِي الصَّلَاةِ \" /27 * \r\n$4766  /8",
