    {
      "hadith_id": 102877,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 2503,
      "text_ar": "حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنْ /26 هِشَامٍ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، قَالَ : /20 \" الرَّجُلُ يَسْتُرُ الْمُصَلِّيَ فِي الصَّلَاةِ \" /27 ، وَقَالَ : \" ابْنُ سِيرِينَ لَا يَسْتُرُ الرَّجُلُ الْمُصَلِّيَ \" * \r\n$2803  /3 /141 حَدَّثَنَا /94 عَبْدُ الْوَهَّابِ الثَّقَفِيُّ /94 ، عَنْ /26 عُبَيْدِ اللَّهِ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 أَنَّ /93 ابْنَ عُمَرَ L4967 /93 \" كَانَ /20 يُقْعِدُ رَجُلًا فَيُصَلِّي خَلْفَهُ وَالنَّاسُ يَمُرُّونَ بَيْنَ يَدَيْ ذَلِكَ الرَّجُلِ \" /27 * \r\n$2804  /8",
      "sanad_ar": "حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94",
      "matn_ar": "عَنْ /26 هِشَامٍ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، قَالَ : /20 \" الرَّجُلُ يَسْتُرُ الْمُصَلِّيَ فِي الصَّلَاةِ \" /27 ، وَقَالَ : \" ابْنُ سِيرِينَ لَا يَسْتُرُ الرَّجُلُ الْمُصَلِّيَ \" * \r\n$2803  /3 /141 حَدَّثَنَا /94 عَبْدُ الْوَهَّابِ الثَّقَفِيُّ /94 ، عَنْ /26 عُبَيْدِ اللَّهِ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 أَنَّ /93 ابْنَ عُمَرَ L4967 /93 \" كَانَ /20 يُقْعِدُ رَجُلًا فَيُصَلِّي خَلْفَهُ وَالنَّاسُ يَمُرُّونَ بَيْنَ يَدَيْ ذَلِكَ الرَّجُلِ \" /27 * \r\n$2804  /8",
