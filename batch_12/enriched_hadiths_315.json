      "hadith_number": 3343,
      "text_ar": "حَدَّثَنَا /94 هُشَيْمٌ /94 ، عَنْ /26 يُونُسَ /26 ، عَنِ /26 الْحَسَنِ /26 ، وَعَنْ /26 مُغِيرَةَ /26 , /27 عَنْ /26 إِبْرَاهِيمَ /26 أَنَّهُمَا /20 \" لَمْ يَكُونَا يَرَيَانِ بَأْسًا بِالتَّطَوُّعِ فِي السَّفَرِ قَبْلَ الصَّلَاةِ وَلَا بَعْدَهَا \" /27 * \r\n$3739  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 أَفْلَحَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْقَاسِمَ /26 /20 يَتَطَوَّعُ فِي السَّفَرِ \" /27 * \r\n$3740  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنْ /26 عِيسَى بْنِ أَبِي عَزَّةَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الشَّعْبِيَّ /26 /20 يَتَطَوَّعُ فِي السَّفَرِ \" /27 * \r\n@ 1 : 417 @ \r\n$3741  /3 /141 حَدَّثَنَا /94 حَفْصُ بْنُ غِيَاثٍ /94 ، عَنْ /26 لَيْثٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، /27 أَنَّ /93 أَبَا ذَرٍّ L2187 /93 ، /93 وَعُمَرَ L5913 /93 \" كَانَا /20 يَتَطَوَّعَانِ فِي السَّفَرِ \" /27 * \r\n$3742  /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ عُبَيْدٍ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، قَالَ : /27 \" كَانَ /18 /26 أَصْحَابُ عَبْدِ اللَّهِ /26 /18 /20 يَتَطَوَّعُونَ فِي السَّفَرِ \" /27 * \r\n$3743  /8 /141 حَدَّثَنَا /94 حَاتِمُ بْنُ إِسْمَاعِيلَ /94 ، /27 عَنْ /26 هِشَامِ بْنِ عُرْوَةَ /26 ، قَالَ : \" كَانَ /26 أَبِي /26 /20 يُصَلِّي عَلَى إِثْرِ الْمَكْتُوبَةِ فِي السَّفَرِ \" /27 * \r\n\u0011E534 \r\n$3744  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الرَّبِيعِ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، قَالَ : \" وَافَقَنَا /93 أَصْحَابُ مُحَمَّدٍ L1131 /93 فَكَانُوا /20 يُصَلُّونَ قَبْلَ الْفَرِيضَةِ وَبَعْدَهَا \" /27 , يَعْنِي فِي السَّفَرِ * \r\n$3745  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، عَنْ /26 حُصَيْنٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : /27 \" صَحِبْتُ /93 ابْنَ عُمَرَ L4967 /93 مِنَ الْمَدِينَةِ إِلَى /60 مَكَّةَ /60 فَكَانَ /20 يُصَلِّي تَطَوُّعًا عَلَى دَابَّتِهِ حَيْثُ مَا تَوَجَّهَتْ بِهِ فَإِذَا كَانَتِ الْفَرِيضَةُ نزل فَصَلَّى \" /27 * \r\n$3746  /8 /141 حَدَّثَنَا /94 غُنْدَرٌ /94 ، عَنْ /26 شُعْبَةَ /26 ، /27 عَنْ /26 أَشْعَثَ /26 ، قَالَ : صَحِبْتُ /26 أَبِي /26 ، /26 وَالْأَسْوَدَ بْنَ يَزِيدَ /26 ، /26 وَعَمْرَو بْنَ مَيْمُونٍ /26 ، /26 وَأَبَا وَائِلٍ /26 \" فَكَانُوا /20 يُصَلُّونَ رَكْعَتَيْنِ ثُمَّ يُصَلُّونَ بَعْدَهَا رَكْعَتَيْنِ \" /27 * \r\n$3747  /2 /141 حَدَّثَنَا /94 حَفْصٌ L2448 /94 عَنِ /26 ابْنِ أَبِي لَيْلَى L7057 /26 ، /26 وَأَشْعَثُ L576 /26 ، /26 وَحَجَّاجٌ L2288 /26 ، عَنْ /26 عَطِيَّةَ L5647 /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ كَانَ /20 يَتَطَوَّعُ فِي السَّفَرِ \" /27 * \r\n$3748  /2 /141 حَدَّثَنَا /94 شَرِيكٌ L3792 /94 ، عَنْ /26 جَابِرٍ L2075 /26 ، /27 عَنْ /26 سَالِمٍ L3194 /26 , \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَعُمَرَ كَانَا /20 يَتَطَوَّعَانِ فِي السَّفَرِ \" /27 * \r\n#E535",
      "sanad_ar": "حَدَّثَنَا /94 هُشَيْمٌ /94",
      "matn_ar": "عَنْ /26 يُونُسَ /26 ، عَنِ /26 الْحَسَنِ /26 ، وَعَنْ /26 مُغِيرَةَ /26 , /27 عَنْ /26 إِبْرَاهِيمَ /26 أَنَّهُمَا /20 \" لَمْ يَكُونَا يَرَيَانِ بَأْسًا بِالتَّطَوُّعِ فِي السَّفَرِ قَبْلَ الصَّلَاةِ وَلَا بَعْدَهَا \" /27 * \r\n$3739  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 أَفْلَحَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْقَاسِمَ /26 /20 يَتَطَوَّعُ فِي السَّفَرِ \" /27 * \r\n$3740  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنْ /26 عِيسَى بْنِ أَبِي عَزَّةَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الشَّعْبِيَّ /26 /20 يَتَطَوَّعُ فِي السَّفَرِ \" /27 * \r\n@ 1 : 417 @ \r\n$3741  /3 /141 حَدَّثَنَا /94 حَفْصُ بْنُ غِيَاثٍ /94 ، عَنْ /26 لَيْثٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، /27 أَنَّ /93 أَبَا ذَرٍّ L2187 /93 ، /93 وَعُمَرَ L5913 /93 \" كَانَا /20 يَتَطَوَّعَانِ فِي السَّفَرِ \" /27 * \r\n$3742  /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ عُبَيْدٍ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، قَالَ : /27 \" كَانَ /18 /26 أَصْحَابُ عَبْدِ اللَّهِ /26 /18 /20 يَتَطَوَّعُونَ فِي السَّفَرِ \" /27 * \r\n$3743  /8 /141 حَدَّثَنَا /94 حَاتِمُ بْنُ إِسْمَاعِيلَ /94 ، /27 عَنْ /26 هِشَامِ بْنِ عُرْوَةَ /26 ، قَالَ : \" كَانَ /26 أَبِي /26 /20 يُصَلِّي عَلَى إِثْرِ الْمَكْتُوبَةِ فِي السَّفَرِ \" /27 * \r\n\u0011E534 \r\n$3744  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الرَّبِيعِ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، قَالَ : \" وَافَقَنَا /93 أَصْحَابُ مُحَمَّدٍ L1131 /93 فَكَانُوا /20 يُصَلُّونَ قَبْلَ الْفَرِيضَةِ وَبَعْدَهَا \" /27 , يَعْنِي فِي السَّفَرِ * \r\n$3745  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، عَنْ /26 حُصَيْنٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : /27 \" صَحِبْتُ /93 ابْنَ عُمَرَ L4967 /93 مِنَ الْمَدِينَةِ إِلَى /60 مَكَّةَ /60 فَكَانَ /20 يُصَلِّي تَطَوُّعًا عَلَى دَابَّتِهِ حَيْثُ مَا تَوَجَّهَتْ بِهِ فَإِذَا كَانَتِ الْفَرِيضَةُ نزل فَصَلَّى \" /27 * \r\n$3746  /8 /141 حَدَّثَنَا /94 غُنْدَرٌ /94 ، عَنْ /26 شُعْبَةَ /26 ، /27 عَنْ /26 أَشْعَثَ /26 ، قَالَ : صَحِبْتُ /26 أَبِي /26 ، /26 وَالْأَسْوَدَ بْنَ يَزِيدَ /26 ، /26 وَعَمْرَو ب