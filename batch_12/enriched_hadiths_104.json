      "chapter_id": null,
      "hadith_number": 176,
      "text_ar": "حَدَّثَنَا /94 مُعْتَمِرُ بْنُ سُلَيْمَانَ /94 ، عَنْ /26 إِسْحَاقَ بْنِ سُوَيْدٍ /26 ، /27 عَنْ /26 يَحْيَى بْنِ يَعْمُرَ /26 ، قَالَ : /20 \" يُتَطَهَّرُ بِمَاءٍ يُطْبَخُ بِالنَّارِ وَإِذَا تَوَضَّأْتُ بِالْمَاءِ الْمُسَخَّنِ مَزَجْتُهُ \" /27 * \r\n$254  /3",
      "sanad_ar": "حَدَّثَنَا /94 مُعْتَمِرُ بْنُ سُلَيْمَانَ /94",
      "matn_ar": "عَنْ /26 إِسْحَاقَ بْنِ سُوَيْدٍ /26 ، /27 عَنْ /26 يَحْيَى بْنِ يَعْمُرَ /26 ، قَالَ : /20 \" يُتَطَهَّرُ بِمَاءٍ يُطْبَخُ بِالنَّارِ وَإِذَا تَوَضَّأْتُ بِالْمَاءِ الْمُسَخَّنِ مَزَجْتُهُ \" /27 * \r\n$254  /3",
