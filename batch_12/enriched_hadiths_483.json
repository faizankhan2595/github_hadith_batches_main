    {
      "hadith_id": 106243,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 5869,
      "text_ar": "حَدَّثَنَا /94 جَرِيرٌ /94 ، عَنْ /26 مَنْصُورٍ /26 ، /27 عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : \" كَانَ يُقَالَ : /20 لَيَمَسُّ الرَّجُلُ لِحْيَتَهُ مَرَّةً فِي الصَّلَاةِ أَوْ لِيَدَعْ \" /27 * \r\n$6621  /8 /141 حَدَّثَنَا /94 أَبُو بَحْرٍ الْبَكْرَاوِيُّ /94 ، عَنْ /26 يُونُسَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَعِيدَ بْنَ جُبَيْرٍ /26 /20 يَمَسُّ لِحْيَتَهُ وَهُوَ يُصَلِّي \" /27 * \r\n$6622  /8 /141 حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنْ /26 مُخْتَارِ بْنِ سَعْدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْقَاسِمَ بْنَ مُحَمَّدٍ /26 يَوْمًا وَهُوَ يُصَلِّي /20 قَبَضَ عَلَى لِحْيَتِهِ ، وَهُوَ يُصَلِّي \" /27 * \r\n$6623  /8 /141 حَدَّثَنَا /94 أَزْهَرُ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 ، قَالَ : \" قُلْتُ لَهُ : /27 رَأَيْتُ /26 مُحَمَّدَ بْنَ سِيرِينَ /26 /20 يَمَسُّ لِحْيَتَهُ وَهُوَ فِي الصَّلَاةِ ، قَالَ : مَا أَكْثَرَ مَا رَأَيْتُهُ يَمَسُّ لِحْيَتَهُ فِي الصَّلَاةِ \" /27 * \r\n$6624  /2 /141 حَدَّثَنَا /94 هُشَيْمٌ L8062 /94 ، عَنْ /26 حُصَيْنٍ L2395 /26 ، /27 عَنْ /26 عَبْدِ الْمَلِكِ بْنِ عَمْرِو بْنِ حُوَيْرِثٍ L25747 /26 : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ رُبَّمَا /20 مَسَّ لِحْيَتَهُ وَهُوَ يُصَلِّي \" /27 * \r\n$6625  /8",
      "sanad_ar": "حَدَّثَنَا /94 جَرِيرٌ /94",
      "matn_ar": "عَنْ /26 مَنْصُورٍ /26 ، /27 عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : \" كَانَ يُقَالَ : /20 لَيَمَسُّ الرَّجُلُ لِحْيَتَهُ مَرَّةً فِي الصَّلَاةِ أَوْ لِيَدَعْ \" /27 * \r\n$6621  /8 /141 حَدَّثَنَا /94 أَبُو بَحْرٍ الْبَكْرَاوِيُّ /94 ، عَنْ /26 يُونُسَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَعِيدَ بْنَ جُبَيْرٍ /26 /20 يَمَسُّ لِحْيَتَهُ وَهُوَ يُصَلِّي \" /27 * \r\n$6622  /8 /141 حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنْ /26 مُخْتَارِ بْنِ سَعْدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْقَاسِمَ بْنَ مُحَمَّدٍ /26 يَوْمًا وَهُوَ يُصَلِّي /20 قَبَضَ عَلَى لِحْيَتِهِ ، وَهُوَ يُصَلِّي \" /27 * \r\n$6623  /8 /141 حَدَّثَنَا /94 أَزْهَرُ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 ، قَالَ : \" قُلْتُ لَهُ : /27 رَأَيْتُ /26 مُحَمَّدَ بْنَ سِيرِينَ /26 /20 يَمَسُّ لِحْيَتَهُ وَهُوَ فِي الصَّلَاةِ ، قَالَ : مَا أَكْثَرَ مَا رَأَيْتُهُ يَمَسُّ لِحْيَتَهُ فِي الصَّلَاةِ \" /27 * \r\n$6624  /2 /141 حَدَّثَنَا /94 هُشَيْمٌ L8062 /94 ، عَنْ /26 حُصَيْنٍ L2395 /26 ، /27 عَنْ /26 عَبْدِ الْمَلِكِ بْنِ عَمْرِو بْنِ حُوَيْرِثٍ L25747 /26 : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ رُبَّمَا /20 مَسَّ لِحْيَتَهُ وَهُوَ يُصَلِّي \" /27 * \r\n$6625  /8",
