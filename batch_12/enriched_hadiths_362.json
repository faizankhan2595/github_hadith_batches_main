      "hadith_number": 4043,
      "text_ar": "$4584  /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ أَخْبَرَنَا /26 إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ /26 ، /27 عَنْ /26 قَيْسِ بْنِ أَبِي حَازِمٍ /26 ، قَالَ : \" كَانَ /20 يُصَلِّي بِنَا فِي الطَّاقِ \" /27 * \r\n$4585  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 مُوسَى بْنُ نَافِعٍ /26 ، قَالَ : /27 رَأَيْتُ /26 سَعِيدَ بْنَ جُبَيْرٍ /26 /20 \" يُصَلِّي فِي الطَّاقِ \" /27 * \r\n@ 1 : 510 @ \r\n$4586  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 نفاعةُ بْنُ مُسْلِمٍ /26 ، قَالَ : /27 رَأَيْتُ /26 سُوَيْدَ بْنَ غَفَلَةَ /26 /20 \" يُصَلِّي فِي الطَّاقِ \" /27 * \r\n$4587  /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 إِسْحَاقُ بْنُ مَنْصُورٍ /94 ، قَالَ : حَدَّثَنَا /26 هُرَيْمٌ /26 ، عَنْ /26 أُمِّ عَمْرٍو الْمُرَادِيَّةِ /26 ، قَالَتْ : /27 \" رَأَيْتُ /93 الْبَرَاءَ بْنَ عَازِبٍ L1157 /93 /20 يُصَلِّي فِي الطَّاقِ \" /27 * \r\n$4588  /8 /141 حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنْ /26 وِقَاءِ بْنِ إِيَاسٍ /26 ، قَالَ : /27 رَأَيْتُ /26 سَعِيدَ بْنَ جُبَيْرٍ /26 /20 \" يُصَلِّي فِي الطَّاقِ \" /27 * \r\n$4589  /8 /141 حَدَّثَنَا /94 زَيْدُ بْنُ الْحُبَابِ /94 ، عَنْ /26 قَطَنٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 أَبَا رَجَاءٍ /26 /20 يُصَلِّي فِي الْمِحْرَابِ \" /27 *",
      "sanad_ar": "$4584  /8 /141 حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ أَخْبَرَنَا /26 إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ /26 ، /27 عَنْ /26 قَيْسِ بْنِ أَبِي حَازِمٍ /26 ، قَالَ : \" كَانَ /20 يُصَلِّي بِنَا فِي الطَّاقِ \" /27 * \r\n$4585  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 مُوسَى بْنُ نَافِعٍ /26 ، قَالَ : /27 رَأَيْتُ /26 سَعِيدَ بْنَ جُبَيْرٍ /26 /20 \" يُصَلِّي فِي الطَّاقِ \" /27 * \r\n@ 1 : 510 @ \r\n$4586  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 نفاعةُ بْنُ مُسْلِمٍ /26 ، قَالَ : /27 رَأَيْتُ /26 سُوَيْدَ بْنَ غَفَلَةَ /26 /20 \" يُصَلِّي فِي الطَّاقِ \" /27 * \r\n$4587  /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 إِسْحَاقُ بْنُ مَنْصُورٍ /94 ، قَالَ : حَدَّثَنَا /26 هُرَيْمٌ /26 ، عَنْ /26 أُمِّ عَمْرٍو الْمُرَادِيَّةِ /26 ، قَالَتْ : /27 \" رَأَيْتُ /93 الْبَرَاءَ بْنَ عَازِبٍ L1157 /93 /20 يُصَلِّي فِي الطَّاقِ \" /27 * \r\n$4588  /8 /141 حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنْ /26 وِقَاءِ بْنِ إِيَاسٍ /26 ، قَالَ : /27 رَأَيْتُ /26 سَعِيدَ بْنَ جُبَيْرٍ /26 /20 \" يُصَلِّي فِي الطَّاقِ \" /27 * \r\n$4589  /8 /141 حَدَّثَنَا /94 زَيْدُ بْنُ الْحُبَابِ /94 ، عَنْ /26 قَطَنٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 أَبَا رَجَاءٍ /26 /20 يُصَلِّي فِي الْمِحْرَابِ \" /27 *",
