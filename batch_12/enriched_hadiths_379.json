    {
      "hadith_id": 104674,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 4300,
      "text_ar": "حَدَّثَنَا /94 هُشَيْمٌ /94 ، عَنْ /26 يَحْيَى بْنِ سَعِيدٍ /26 ، عَنْ /26 عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 ، قَالَتْ : /20 \" كَانَ النَّاسُ يَخْدُمُونَ أَنْفُسَهُمْ ، فَكَانَ أَحَدُهُمْ يَرُوحُ بِهَيْئَتِهِ إلَى الْجُمُعَةِ ، فَقِيلَ لَهُمْ : لَوِ اغْتَسَلْتُمْ \" /27 * \r\n$4870  /2",
      "sanad_ar": "حَدَّثَنَا /94 هُشَيْمٌ /94",
      "matn_ar": "عَنْ /26 يَحْيَى بْنِ سَعِيدٍ /26 ، عَنْ /26 عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 ، قَالَتْ : /20 \" كَانَ النَّاسُ يَخْدُمُونَ أَنْفُسَهُمْ ، فَكَانَ أَحَدُهُمْ يَرُوحُ بِهَيْئَتِهِ إلَى الْجُمُعَةِ ، فَقِيلَ لَهُمْ : لَوِ اغْتَسَلْتُمْ \" /27 * \r\n$4870  /2",
