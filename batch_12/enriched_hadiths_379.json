    {
      "hadith_id": 104673,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 4299,
      "text_ar": "حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 أَبُو بِشْرٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، قَالَ : /27 قَالَ /26 كَعْبٌ /26 : /20 \" يَفْزَعُ لِيَوْمِ الْجُمُعَةِ كُلُّ شَيْءٍ إلَّا الثَّقَلَيْنِ ، وَعَلَى كُلِّ حَالِمٍ فِيهِ الْغُسْلُ \" /27 * \r\n$4869  /3",
