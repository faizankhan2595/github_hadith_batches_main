    {
      "hadith_id": 103180,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 2806,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 حَمَّادٍ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 ، قَالَ : /20 \" مَا أَجْمَعَ أَصْحَابُ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى شَيْءٍ مَا أَجْمَعُوا عَلَى التَّنْوِيرِ بِالْفَجْرِ \" /27 * \r\n$3173  /8 /141 حَدَّثَنَا /94 عُبَيْدُ اللَّهِ بْنُ مُوسَى /94 ، عَنْ /26 نُفَاعَةَ بْنِ مُسْلِمٍ /26 ، قَالَ : /27 \" كَانَ /26 سُوَيْدُ بْنُ غَفَلَةَ /26 /20 يُسْفِرُ بِالْفَجْرِ \" /27 * \r\n\u0013E445 \r\n$3174  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 وِقَاءِ بْنِ حَبِيبٍ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 أَنَّهُ \" كَانَ /20 يُنَوِّرُ بِالْفَجْرِ \" /27 * \r\n$3175  /8 /141 حَدَّثَنَا /94 غُنْدَرٌ /94 ، عَنْ /26 شُعْبَةَ /26 ، /27 عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنْ /18 /26 رَجُلٍ /26 /18 أَنَّ أُنَاسًا مِنْ أَصْحَابِ عَبْدِ اللَّهِ \" كَانُوا /20 يُسْفِرُونَ بِصَلَاةِ الْفَجْرِ \" /27 * \r\n$3176  /3 /141 حَدَّثَنَا /94 حُسَيْنُ بْنُ عَلِيٍّ /94 ، عَنْ /26 زَائِدَةَ /26 ، عَنْ /26 أَبِي حُصَيْنٍ /26 ، عَنْ /26 خَرَشَةَ /26 ، قَالَ : /27 /20 \" صَلَّى /93 عُمَرُ L1665 /93 بِالنَّاسِ فَغَلَّسَ وَنَوَّرَ وَصَلَّى بِهِمْ فِيمَا بَيْنَ ذَلِكَ \" /27 * \r\n$3177  /3 /141 حَدَّثَنَا /94 حُسَيْنُ بْنُ عَلِيٍّ /94 ، عَنْ /26 زَائِدَةَ /26 ، عَنْ /26 عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ /26 ، قَالَ : /27 /20 \" صَلَّى /93 الْمُغِيرَةُ بْنُ شُعْبَةَ L1665 /93 الصُّبْحَ فَغَلَّسَ وَنَوَّرَ حَتَّى قُلْتُ : قَدْ طَلَعَتِ الشَّمْسُ أَوْ لَمْ تَطْلُعْ وَصَلَّى فِيمَا بَيْنَ ذَلِكَ وَكَانَ مُؤَذِّنُهُ ابْنَ النَّبَّاحِ وَلَمْ يَكُنْ لَهُ مُؤَذِّنٌ غَيْرُهُ \" /27 * \r\n$3178  /8",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ /94",
      "matn_ar": "عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 حَمَّادٍ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 ، قَالَ : /20 \" مَا أَجْمَعَ أَصْحَابُ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى شَيْءٍ مَا أَجْمَعُوا عَلَى التَّنْوِيرِ بِالْفَجْرِ \" /27 * \r\n$3173  /8 /141 حَدَّثَنَا /94 عُبَيْدُ اللَّهِ بْنُ مُوسَى /94 ، عَنْ /26 نُفَاعَةَ بْنِ مُسْلِمٍ /26 ، قَالَ : /27 \" كَانَ /26 سُوَيْدُ بْنُ غَفَلَةَ /26 /20 يُسْفِرُ بِالْفَجْرِ \" /27 * \r\n\u0013E445 \r\n$3174  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 وِقَاءِ بْنِ حَبِيبٍ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 أَنَّهُ \" كَانَ /20 يُنَوِّرُ بِالْفَجْرِ \" /27 * \r\n$3175  /8 /141 حَدَّثَنَا /94 غُنْدَرٌ /94 ، عَنْ /26 شُعْبَةَ /26 ، /27 عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنْ /18 /26 رَجُلٍ /26 /18 أَنَّ أُنَاسًا مِنْ أَصْحَابِ عَبْدِ اللَّهِ \" كَانُوا /20 يُسْفِرُونَ بِصَلَاةِ الْفَجْرِ \" /27 * \r\n$3176  /3 /141 حَدَّثَنَا /94 حُسَيْنُ بْنُ عَلِيٍّ /94 ، عَنْ /26 زَائِدَةَ /26 ، عَنْ /26 أَبِي حُصَيْنٍ /26 ، عَنْ /26 خَرَشَةَ /26 ، قَالَ : /27 /20 \" صَلَّى /93 عُمَرُ L1665 /93 بِالنَّاسِ فَغَلَّسَ وَنَوَّرَ وَصَلَّى بِهِمْ فِيمَا بَيْنَ ذَلِكَ \" /27 * \r\n$3177  /3 /141 حَدَّثَنَا /94 حُسَيْنُ بْنُ عَلِيٍّ /94 ، عَنْ /26 زَائِدَةَ /26 ، عَنْ /26 عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ /26 ، قَالَ : /27 /20 \" صَلَّى /93 الْمُغِيرَةُ بْنُ شُعْبَةَ L1665 /93 الصُّبْحَ فَغَلَّسَ وَنَوَّرَ حَتَّى قُلْتُ : قَدْ طَلَعَتِ الشَّمْسُ أَوْ لَمْ تَطْلُعْ وَصَلَّى فِيمَا بَيْنَ ذَلِكَ وَكَانَ مُؤَذِّنُهُ ابْنَ النَّبَّاحِ وَلَمْ يَكُنْ لَهُ مُؤَذِّنٌ غَيْرُهُ \" /27 * \r\n$3178  /8",
