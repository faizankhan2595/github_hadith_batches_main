    {
      "hadith_id": 103176,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 2802,
      "text_ar": "حَدَّثَنَا /94 ابْنُ فُضَيْلٍ /94 ، عَنْ /26 رَضِيِّ بْنِ أَبِي عَقِيلٍ /26 ، عَنْ /26 أَبِيهِ /26 ، قَالَ : /27 كَانَ /26 رَبِيعُ بْنُ جُبَيْرٍ /26 ، يَقُولُ لَهُ ، وَكَانَ مُؤَذِّنُهُ : \" يَا أَبَا عَقِيلٍ , /20 نَوِّرْ نَوِّرْ \" /27 * \r\n\u0019E444 \r\n$3165  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ /26 ، قَالَ : /27 \" كَانَ /93 ابْنُ مَسْعُودٍ L5079 /93 /20 يُنَوِّرُ بِالْفَجْرِ \" /27 * \r\n$3166  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 عُثْمَانَ بْنِ أَبِي هِنْدٍ /26 ، /27 أَنَّ /26 عُمَرَ بْنَ عَبْدِ الْعَزِيزِ /26 \" كَانَ /20 يُسْفِرُ بِالْفَجْرِ \" /27 * \r\n$3167  /8",
      "sanad_ar": "حَدَّثَنَا /94 ابْنُ فُضَيْلٍ /94",
