    {
      "hadith_id": 100866,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 492,
      "text_ar": "حَدَّثَنَا /94 خَالِدُ بْنُ مَخْلَدٍ L2680 /94 ، عَنْ /26 مُوسَى بْنِ يَعْقُوبَ الزَّمْعِيِّ L7782 /26 قَالَ : أَنْبَأَنِي /26 أَبُو عُبَيْدَةَ ابْنُ عَبْدِ اللَّهِ بْنِ زَمْعَةَ L264 /26    @ 1 : 77 @    ، عَنْ /26 أَبِيهِ L5146 /26 ، /27 عَنْ /93 أُمِّ سَلَمَةَ L8101 /93 زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَتْ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : /20 \" وَإِذَا شَرِبْتُمُ اللَّبَنَ فَمَضْمِضُوا مِنْهُ فَإِنَّ لَهُ دَسَمًا \" /27 * \r\n$614  /3 /141 حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، /94 وَإِسْمَاعِيلُ ابْنُ عُلَيَّةَ /94 ، عَنْ /26 أَيُّوبَ /26 ، عَنْ /26 مُحَمَّدِ بْنِ سِيرِينَ /26 /27 أَنَّ /93 أَنَسَ بْنَ مَالِكٍ L720 /93 , /26 وَالْحَارِثَ الْهَمْدَانِيَّ /26 : \" كَانَا /20 يُمَضْمِضَانِ مِنَ اللَّبَنِ ثَلَاثًا \" /27 * \r\n\u001cE79 \r\n$615  /8 /141 حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 , عَنْ /26 أَبِي جَعْفَرٍ الْخَطْمِيِّ /26 , عَنْ /26 مُحَمَّدِ بْنِ كَعْبٍ /26 ، /27 عَنْ /26 عَبْدِ اللَّهِ بْنِ يَزِيدَ /26 ، قَالَ : \" كَانَ /20 يَشْرَبُ اللَّبَنَ فَيُمَضْمِضُ \" /27 * \r\n$616  /3",
      "sanad_ar": "حَدَّثَنَا /94 خَالِدُ بْنُ مَخْلَدٍ L2680 /94",
      "matn_ar": "عَنْ /26 مُوسَى بْنِ يَعْقُوبَ الزَّمْعِيِّ L7782 /26 قَالَ : أَنْبَأَنِي /26 أَبُو عُبَيْدَةَ ابْنُ عَبْدِ اللَّهِ بْنِ زَمْعَةَ L264 /26    @ 1 : 77 @    ، عَنْ /26 أَبِيهِ L5146 /26 ، /27 عَنْ /93 أُمِّ سَلَمَةَ L8101 /93 زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَتْ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : /20 \" وَإِذَا شَرِبْتُمُ اللَّبَنَ فَمَضْمِضُوا مِنْهُ فَإِنَّ لَهُ دَسَمًا \" /27 * \r\n$614  /3 /141 حَدَّثَنَا /94 ابْنُ عُيَيْنَةَ /94 ، /94 وَإِسْمَاعِيلُ ابْنُ عُلَيَّةَ /94 ، عَنْ /26 أَيُّوبَ /26 ، عَنْ /26 مُحَمَّدِ بْنِ سِيرِينَ /26 /27 أَنَّ /93 أَنَسَ بْنَ مَالِكٍ L720 /93 , /26 وَالْحَارِثَ الْهَمْدَانِيَّ /26 : \" كَانَا /20 يُمَضْمِضَانِ مِنَ اللَّبَنِ ثَلَاثًا \" /27 * \r\n\u001cE79 \r\n$615  /8 /141 حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 , عَنْ /26 أَبِي جَعْفَرٍ الْخَطْمِيِّ /26 , عَنْ /26 مُحَمَّدِ بْنِ كَعْبٍ /26 ، /27 عَنْ /26 عَبْدِ اللَّهِ بْنِ يَزِيدَ /26 ، قَالَ : \" كَانَ /20 يَشْرَبُ اللَّبَنَ فَيُمَضْمِضُ \" /27 * \r\n$616  /3",
