    {
      "hadith_id": 106773,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 6399,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 عَلِيِّ بْنِ صَالِحٍ /26 ، /27 عَنْ /26 غَالِبٍ أَبِي الْهُذَيْلِ /26 ، قَالَ : /20 \" أَمَرَنِي أَبُو رَزِينٍ أَنْ أَفْتَحَ الْمُصْحَفَ عَلَى غَيْرِ وُضُوءٍ ، فَسَأَلْتُ إِبْرَاهِيمَ ؟ فَكَرِهَهُ \" /27 * \r\n$7256  /3 /141 حَدَّثَنَا /94 ابْنُ نُمَيْرٍ /94 ، قَالَ : نَا /26 عُبَيْدُ اللَّهِ بْنُ عُمَرَ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 : \" أَنَّهُ كَانَ /20 لَا يَمَسُّ الْمُصْحَفَ إِلَّا وَهُوَ طَاهِرٌ \" /27 * \r\n$7257  /8",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ /94",
      "matn_ar": "عَنْ /26 عَلِيِّ بْنِ صَالِحٍ /26 ، /27 عَنْ /26 غَالِبٍ أَبِي الْهُذَيْلِ /26 ، قَالَ : /20 \" أَمَرَنِي أَبُو رَزِينٍ أَنْ أَفْتَحَ الْمُصْحَفَ عَلَى غَيْرِ وُضُوءٍ ، فَسَأَلْتُ إِبْرَاهِيمَ ؟ فَكَرِهَهُ \" /27 * \r\n$7256  /3 /141 حَدَّثَنَا /94 ابْنُ نُمَيْرٍ /94 ، قَالَ : نَا /26 عُبَيْدُ اللَّهِ بْنُ عُمَرَ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 : \" أَنَّهُ كَانَ /20 لَا يَمَسُّ الْمُصْحَفَ إِلَّا وَهُوَ طَاهِرٌ \" /27 * \r\n$7257  /8",
