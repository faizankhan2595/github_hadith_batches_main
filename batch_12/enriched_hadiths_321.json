      "hadith_id": 103806,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 3432,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 شُعْبَةَ /26 ، قَالَ : /27 سَأَلْتُ /26 الْحَكَمَ /26 ، /26 وَحَمَّادًا /26 ، فَقَالَ الْحَكَمُ : /20 \" إِذَا كَانَ مِقْدَارَ الدِّرْهَمِ \" ، وَقَالَ حَمَّادٌ : \" إِذَا كَانَ مِقْدَارَ الْمِثْقَالِ ، ثُمَّ قَالَ : أَوِ الدِّرْهَمِ \" /27 * \r\n$3854  /8 /141 حَدَّثَنَا /94 ابْنُ فُضَيْلٍ /94 ، عَنْ /26 أَبِي الرَّبِيعِ /26 ، قَالَ : /27 \" رَأَيْتُ /26 مُجَاهِدًا /26 /20 فِي ثَوْبِهِ دَمٌ يُصَلِّي فِيهِ أَيَّامًا \" /27 * \r\n$3855  /8",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ /94",
      "matn_ar": "عَنْ /26 شُعْبَةَ /26 ، قَالَ : /27 سَأَلْتُ /26 الْحَكَمَ /26 ، /26 وَحَمَّادًا /26 ، فَقَالَ الْحَكَمُ : /20 \" إِذَا كَانَ مِقْدَارَ الدِّرْهَمِ \" ، وَقَالَ حَمَّادٌ : \" إِذَا كَانَ مِقْدَارَ الْمِثْقَالِ ، ثُمَّ قَالَ : أَوِ الدِّرْهَمِ \" /27 * \r\n$3854  /8 /141 حَدَّثَنَا /94 ابْنُ فُضَيْلٍ /94 ، عَنْ /26 أَبِي الرَّبِيعِ /26 ، قَالَ : /27 \" رَأَيْتُ /26 مُجَاهِدًا /26 /20 فِي ثَوْبِهِ دَمٌ يُصَلِّي فِيهِ أَيَّامًا \" /27 * \r\n$3855  /8",
