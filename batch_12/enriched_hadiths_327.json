    {
      "hadith_id": 103893,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 3519,
      "text_ar": "$3974  /2 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، عَنْ /26 يُونُسَ بْنِ الْحَارِثِ L8604 /26 ، /27 عَنْ /26 أَبِي عَوْنٍ L7159 /26 : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 صَلَّى عَلَى فَرْوَةٍ مَدْبُوغَةٍ \" /27 * \r\n$3975  /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 مُجَالِدٍ /26 ، عَنِ /26 الشَّعْبِيِّ /26 ، /27 عَنْ /26 مَسْرُوقٍ /26 أَنَّهُ \" كَانَ /20 يَدْبُغُ جِلْدَ أُضْحِيَّتِهِ فَيَتَّخِذُهُ مُصَلًّى يُصَلِّي عَلَيْهِ \" /27 * \r\n$3976  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 هِشَامِ بْنِ يَزِيدَ /26 ، عَنْ /26 إِسْمَاعِيلَ بْنِ رَجَاءٍ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، /27 عَنْ /26 عَلْقَمَةَ /26 أَنَّهُ \" كَانَ /20 يَدْبُغُ جِلْدَ أُضْحِيَّتِهِ فَيَتَّخِذُهُ مُصَلًّى يُصَلِّي عَلَيْهِ \" /27 * \r\n@ 1 : 442 @ \r\n$3977  /8",
      "sanad_ar": "$3974  /2 /141 حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، عَنْ /26 يُونُسَ بْنِ الْحَارِثِ L8604 /26 ، /27 عَنْ /26 أَبِي عَوْنٍ L7159 /26 : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 صَلَّى عَلَى فَرْوَةٍ مَدْبُوغَةٍ \" /27 * \r\n$3975  /8 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 مُجَالِدٍ /26 ، عَنِ /26 الشَّعْبِيِّ /26 ، /27 عَنْ /26 مَسْرُوقٍ /26 أَنَّهُ \" كَانَ /20 يَدْبُغُ جِلْدَ أُضْحِيَّتِهِ فَيَتَّخِذُهُ مُصَلًّى يُصَلِّي عَلَيْهِ \" /27 * \r\n$3976  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 هِشَامِ بْنِ يَزِيدَ /26 ، عَنْ /26 إِسْمَاعِيلَ بْنِ رَجَاءٍ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، /27 عَنْ /26 عَلْقَمَةَ /26 أَنَّهُ \" كَانَ /20 يَدْبُغُ جِلْدَ أُضْحِيَّتِهِ فَيَتَّخِذُهُ مُصَلًّى يُصَلِّي عَلَيْهِ \" /27 * \r\n@ 1 : 442 @ \r\n$3977  /8",
      "grade": null,
