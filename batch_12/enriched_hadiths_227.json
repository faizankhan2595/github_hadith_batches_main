      "chapter_id": null,
      "hadith_number": 2023,
      "text_ar": "حَدَّثَنَا /94 أَبُو أُسَامَةَ /94 ، عَنْ أَبِي الضُّحَى /26 /26 ، /27 عَنِ /26 الشَّعْبِيِّ /26 ، قَالَ : /20 \" تُجْزِئُهُ إِقَامَةُ الْمِصْرِ \" /27 * \r\n@ 1 : 250 @ \r\n$2232  /2 /141 حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، عَنْ /26 دَلْهَمِ بْنِ صَالِحٍ L2821 /26 ، /27 عَنْ /26 عَوْنِ بْنِ عَبْدِ اللَّهِ L6266 /26 : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ /20 فِي سَفَرٍ فَسَمِعَ إِقَامَةَ مُؤَذِّنٍ فَصَلَّى بِأَصْحَابِهِ \" /27 * \r\n$2233  /8 /141 حَدَّثَنَا /94 ابْنُ مَهْدِيٍّ /94 ، عَنْ /26 حَمَّادِ بْنِ سَلَمَةَ /26 ، عَنْ /26 حَجَّاجٍ /26 ، /27 عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ /26 ، \" أَنْ /26 أَبَاهُ /26 /20 صَلَّى فِي بَيْتِهِ مِنْ عُذْرٍ بِإِقَامَةِ النَّاسِ \" /27 * \r\n$2234  /8",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو أُسَامَةَ /94",
      "matn_ar": "عَنْ أَبِي الضُّحَى /26 /26 ، /27 عَنِ /26 الشَّعْبِيِّ /26 ، قَالَ : /20 \" تُجْزِئُهُ إِقَامَةُ الْمِصْرِ \" /27 * \r\n@ 1 : 250 @ \r\n$2232  /2 /141 حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، عَنْ /26 دَلْهَمِ بْنِ صَالِحٍ L2821 /26 ، /27 عَنْ /26 عَوْنِ بْنِ عَبْدِ اللَّهِ L6266 /26 : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ /20 فِي سَفَرٍ فَسَمِعَ إِقَامَةَ مُؤَذِّنٍ فَصَلَّى بِأَصْحَابِهِ \" /27 * \r\n$2233  /8 /141 حَدَّثَنَا /94 ابْنُ مَهْدِيٍّ /94 ، عَنْ /26 حَمَّادِ بْنِ سَلَمَةَ /26 ، عَنْ /26 حَجَّاجٍ /26 ، /27 عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ /26 ، \" أَنْ /26 أَبَاهُ /26 /20 صَلَّى فِي بَيْتِهِ مِنْ عُذْرٍ بِإِقَامَةِ النَّاسِ \" /27 * \r\n$2234  /8",
