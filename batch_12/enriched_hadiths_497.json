      "hadith_id": 106449,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 6075,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ /94 ، /27 عَنْ /26 عُيَيْنَةَ بْنِ عَبْدِ الرَّحْمَنِ /26 ، قَالَ : \" كُنْتُ مَعَ /26 أَبِي /26 فِي الْمَسْجِدِ ، فَرَأَى /20 رَجُلًا صَافًّا بَيْنَ قَدَمَيْهِ ، فَقَالَ : أَلْزِقْ إِحْدَاهُمَا بِالْأُخْرَى ؛ لَقَدْ رَأَيْتُ فِي هَذَا الْمَسْجِدِ ثَمَانِيَةَ عَشَرَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَا رَأَيْتُ أَحَدًا مِنْهُمْ فَعَلَ هَذَا قَطُّ \" ! /27 * \r\n@ 2 : 218 @ \r\n$6899  /8 /141 حَدَّثَنَا /94 شَرِيكٌ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 عَمْرَو بْنَ مَيْمُونٍ /26 /20 يُرَاوِحُ بَيْنَ قَدَمَيْهِ فِي الصَّلَاةِ \" /27 * \r\n$6900  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 إِسْمَاعِيلَ /26 ، بْنِ /26 أَبِي خَالِدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 عَمْرَو بْنَ مَيْمُونٍ /26 /20 يُرَاوِحُ بَيْنَ قَدَمَيْهِ ؛ يَضَعُ هَذِهِ عَلَى هَذِهِ ، وَهَذِهِ عَلَى هَذِهِ \" /27 * \r\n$6901  /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ أَبِي عَدِيٍّ /94 ، عَنْ /26 يُوسُفَ بْنِ عَبْدَةَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 ابْنَ سِيرِينَ /26 /20 يُصَلِّي وَهُوَ هَكَذَا \" يَعْنِي : يُقَدِّمُ رِجْلًا وَيُؤَخِّرُ أُخْرَى \" /27 * \r\n$6902  /8 /141 حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنْ /26 هِشَامٍ /26 ، قَالَ : /27 \" كَانَ /26 ابْنُ سِيرِينَ /26 /20 يُرَاوِحُ بَيْنَ قَدَمَيْهِ فِي الصَّلَاةِ \" /27 * \r\n$6903  /8 /141 حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ رَاشِدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 مَكْحُولًا /26 /20 يَتَّكِئُ عَلَى قَدَمَيْهِ ، عَلَى هَذِهِ مَرَّةً ، وَعَلَى هَذِهِ مَرَّةً فِي الصَّلَاةِ \" /27 * \r\n$6904  /8 /141 حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنْ /26 خَالِدِ بْنِ أَبِي بَكْرٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَالِمًا /26 /20 لَا يَصُفُّ قَدَمَيْهِ فِي الصَّلَاةِ ، وَيُحَرِّكُهَا وَهُوَ يُصَلِّي \" /27 * \r\n\u001bE952",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ /94",
      "matn_ar": "/27 عَنْ /26 عُيَيْنَةَ بْنِ عَبْدِ الرَّحْمَنِ /26 ، قَالَ : \" كُنْتُ مَعَ /26 أَبِي /26 فِي الْمَسْجِدِ ، فَرَأَى /20 رَجُلًا صَافًّا بَيْنَ قَدَمَيْهِ ، فَقَالَ : أَلْزِقْ إِحْدَاهُمَا بِالْأُخْرَى ؛ لَقَدْ رَأَيْتُ فِي هَذَا الْمَسْجِدِ ثَمَانِيَةَ عَشَرَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَا رَأَيْتُ أَحَدًا مِنْهُمْ فَعَلَ هَذَا قَطُّ \" ! /27 * \r\n@ 2 : 218 @ \r\n$6899  /8 /141 حَدَّثَنَا /94 شَرِيكٌ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 عَمْرَو بْنَ مَيْمُونٍ /26 /20 يُرَاوِحُ بَيْنَ قَدَمَيْهِ فِي الصَّلَاةِ \" /27 * \r\n$6900  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 إِسْمَاعِيلَ /26 ، بْنِ /26 أَبِي خَالِدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 عَمْرَو بْنَ مَيْمُونٍ /26 /20 يُرَاوِحُ بَيْنَ قَدَمَيْهِ ؛ يَضَعُ هَذِهِ عَلَى هَذِهِ ، وَهَذِهِ عَلَى هَذِهِ \" /27 * \r\n$6901  /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ أَبِي عَدِيٍّ /94 ، عَنْ /26 يُوسُفَ بْنِ عَبْدَةَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 ابْنَ سِيرِينَ /26 /20 يُصَلِّي وَهُوَ هَكَذَا \" يَعْنِي : يُقَدِّمُ رِجْلًا وَيُؤَخِّرُ أُخْرَى \" /27 * \r\n$6902  /8 /141 حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنْ /26 هِشَامٍ /26 ، قَالَ : /27 \" كَانَ /26 ابْنُ سِيرِينَ /26 /20 يُرَاوِحُ بَيْنَ قَدَمَيْهِ فِي الصَّلَاةِ \" /27 * \r\n$6903  /8 /141 حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ رَاشِدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 مَكْحُولًا /26 /20 يَتَّكِئُ عَلَى قَدَمَيْهِ ، عَلَى هَذِهِ مَرَّةً ، وَعَلَى هَذِهِ مَرَّةً فِي الصَّلَاةِ \" /27 * \r\n$6904  /8 /141 حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنْ /26 خَالِدِ بْنِ أَبِي بَكْرٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَالِمًا /26 /20 لَا يَصُفُّ قَدَمَيْهِ فِي الصَّلَاةِ ، وَيُحَرِّكُهَا وَهُوَ يُصَلِّي \" /27 * \r\n\u001bE952",
