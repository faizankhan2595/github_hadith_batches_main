    {
      "hadith_id": 100615,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 241,
      "text_ar": "حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94 ، عَنْ /26 أَيُّوبَ /26 ، عَنْ /26 أَبِي قِلَابَةَ /26 ، قَالَ : /27 كَانَ /93 أَبُو قَتَادَةَ L1190 /93 : /20 \" يُدْنِي الْإِنَاءَ مِنَ السِّنَّوْرِ فَيَلَغُ فِيهِ فَيَتَوَضَّأُ بِسُؤْرِهِ ، وَيَقُولُ : إِنَّمَا هُوَ مِنْ مَتَاعِ الْبَيْتِ \" /27 * \r\n$322  /2",
      "sanad_ar": "حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94",
      "matn_ar": "عَنْ /26 أَيُّوبَ /26 ، عَنْ /26 أَبِي قِلَابَةَ /26 ، قَالَ : /27 كَانَ /93 أَبُو قَتَادَةَ L1190 /93 : /20 \" يُدْنِي الْإِنَاءَ مِنَ السِّنَّوْرِ فَيَلَغُ فِيهِ فَيَتَوَضَّأُ بِسُؤْرِهِ ، وَيَقُولُ : إِنَّمَا هُوَ مِنْ مَتَاعِ الْبَيْتِ \" /27 * \r\n$322  /2",
