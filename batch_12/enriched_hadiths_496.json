      "hadith_id": 106428,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 6054,
      "text_ar": "$6876  /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنْ /26 جَعْفَرِ بْنِ مَيْمُونٍ /26 ، عَنْ /26 أَبِي عُثْمَانَ /26 ، قَالَ : /27 \" كَانَ /93 عُمَرُ L5913 /93 /20 يَقْنُتُ بِنَا بَعْدَ الرُّكُوعِ ، وَيَرْفَعُ يَدَيْهِ حَتَّى يَبْدُوَ ضَبْعَاهُ ، وَيُسْمَعَ صَوْتُهُ مِنْ وَرَاءِ الْمَسْجِدِ \" /27 * \r\n$6877  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 جَعْفَرٍ /26 صَاحِبِ الْأَنْمَاطِ ، عَنْ /26 أَبِي عُثْمَانَ /26 : /27 \" أَنَّ /93 عُمَرَ L5913 /93 /20 رَفَعَ يَدَيْهِ فِي قُنُوتِ الْفَجْرِ \" /27 * \r\n$6878  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنْ /26 عَوْفٍ /26 ، عَنْ /26 خلاسِ بْنِ عَمْرٍو الْهَجَرِيِّ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 : \" أَنَّهُ /20 صَلَّى فَقَنَتَ بِهِمْ فِي الْفَجْرِ بِالْبَصْرَةِ ، فَرَفَعَ يَدَيْهِ حَتَّى مَدَّ ضَبْعَيْهِ \" /27 * \r\n$6879  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، عَنْ /26 عَوْفٍ /26 ، عَنْ /26 أَبِي رَجَاءٍ /26 ، قَالَ : /27 \" رَأَيْتُ /93 ابْنَ عَبَّاسٍ L4883 /93 /20 يَمُدُّ بِضَبْعَيْهِ فِي قُنُوتِ صَلَاةِ الْغَدَاةِ \" /27 * \r\n$6880  /8",
      "sanad_ar": "$6876  /3 /141 حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنْ /26 جَعْفَرِ بْنِ مَيْمُونٍ /26 ، عَنْ /26 أَبِي عُثْمَانَ /26 ، قَالَ : /27 \" كَانَ /93 عُمَرُ L5913 /93 /20 يَقْنُتُ بِنَا بَعْدَ الرُّكُوعِ ، وَيَرْفَعُ يَدَيْهِ حَتَّى يَبْدُوَ ضَبْعَاهُ ، وَيُسْمَعَ صَوْتُهُ مِنْ وَرَاءِ الْمَسْجِدِ \" /27 * \r\n$6877  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 جَعْفَرٍ /26 صَاحِبِ الْأَنْمَاطِ ، عَنْ /26 أَبِي عُثْمَانَ /26 : /27 \" أَنَّ /93 عُمَرَ L5913 /93 /20 رَفَعَ يَدَيْهِ فِي قُنُوتِ الْفَجْرِ \" /27 * \r\n$6878  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنْ /26 عَوْفٍ /26 ، عَنْ /26 خلاسِ بْنِ عَمْرٍو الْهَجَرِيِّ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 : \" أَنَّهُ /20 صَلَّى فَقَنَتَ بِهِمْ فِي الْفَجْرِ بِالْبَصْرَةِ ، فَرَفَعَ يَدَيْهِ حَتَّى مَدَّ ضَبْعَيْهِ \" /27 * \r\n$6879  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، عَنْ /26 عَوْفٍ /26 ، عَنْ /26 أَبِي رَجَاءٍ /26 ، قَالَ : /27 \" رَأَيْتُ /93 ابْنَ عَبَّاسٍ L4883 /93 /20 يَمُدُّ بِضَبْعَيْهِ فِي قُنُوتِ صَلَاةِ الْغَدَاةِ \" /27 * \r\n$6880  /8",
