      "chapter_id": null,
      "hadith_number": 968,
      "text_ar": "حَدَّثَنَا /94 هُشَيْمٌ /94 ، عَنْ /26 مُغِيرَةَ /26 ، /27 عَنِ /26 الشَّعْبِيِّ /26 أَنَّهُ كَانَ يَدْخُلُ وَيَغْتَسِلُ فِيهِ وَيَقُولُ : /20 \" لَوِ اغْتَسَلْتُ مِنْهُ مَا دَخَلْتُهُ \" /27 * \r\n$1105  /8 /141 حَدَّثَنَا /94 إِسْحَاقُ بْنُ مَنْصُورٍ /94 ، قَالَ : حَدَّثَنَا /26 هُرَيْمٌ /26 ، عَنْ /26 يَزِيدَ بْنِ أَبِي زِيَادٍ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، قَالَ : /27 \" كَانَ /26 عَلْقَمَةُ /26 ، /26 وَالْأَسْوَدُ /26 /20 يَغْتَسِلَانِ مِنْ مَاءِ الْحَمَّامِ وَلَا يُعْلِيَانِهِ بِغُسْلٍ \" /27 * \r\n$1106  /8",
      "sanad_ar": "حَدَّثَنَا /94 هُشَيْمٌ /94",
      "matn_ar": "عَنْ /26 مُغِيرَةَ /26 ، /27 عَنِ /26 الشَّعْبِيِّ /26 أَنَّهُ كَانَ يَدْخُلُ وَيَغْتَسِلُ فِيهِ وَيَقُولُ : /20 \" لَوِ اغْتَسَلْتُ مِنْهُ مَا دَخَلْتُهُ \" /27 * \r\n$1105  /8 /141 حَدَّثَنَا /94 إِسْحَاقُ بْنُ مَنْصُورٍ /94 ، قَالَ : حَدَّثَنَا /26 هُرَيْمٌ /26 ، عَنْ /26 يَزِيدَ بْنِ أَبِي زِيَادٍ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، قَالَ : /27 \" كَانَ /26 عَلْقَمَةُ /26 ، /26 وَالْأَسْوَدُ /26 /20 يَغْتَسِلَانِ مِنْ مَاءِ الْحَمَّامِ وَلَا يُعْلِيَانِهِ بِغُسْلٍ \" /27 * \r\n$1106  /8",
