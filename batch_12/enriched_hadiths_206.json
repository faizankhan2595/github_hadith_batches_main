    {
      "hadith_id": 102085,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 1711,
      "text_ar": "$1911  /3 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : نا /94 ابْنُ نُمَيْرٍ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، عَنْ /26 هَمَّامٍ /26 ، /27 أَنَّ /93 أبَا مَسْعُودٍ L5680 /93 \" كَانَ /20 يَمْسَحُ عَلَى الْجَوْرَبَيْنِ \" /27 * \r\n$1912  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 مَنْصُورٍ /26 ، عَنْ /26 خَالِدِ بْنِ سَعْدٍ /26 ، /27 عَنْ /93 عُقْبَةَ بْنِ عَمْرٍو L5680 /93 \" أَنَّهُ /20 مَسَحَ عَلَى جَوْرَبَيْنِ مِنْ شَعْرٍ \" /27 * \r\n$1913  /2 /141 حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، عَنْ /26 سُفْيَانَ L3436 /26 ، عَنْ /26 أَبِي قَيْسٍ L4329 /26 ، عَنْ /26 هُزَيْلٍ L8033 /26 ، /27 عَنْ /93 مغِيرَةَ بْنِ شُعْبَةَ L1665 /93 , \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 مَسَحَ عَلَى الْجَوْرَبَيْنِ وَالنَّعْلَيْنِ \" /27 * \r\n@ 1 : 216 @ \r\n$1914  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 أَبِي جَنَابٍ /26 ، عَنْ /26 أَبِيهِ /26 ، عَنْ /26 جِلَاسِ بْنِ عَمْرٍو /26 , /27 أَنَّ /93 عُمَرَ L5913 /93 : \" تَوَضَّأَ يَوْمَ جُمُعَةٍ /20 وَمَسَحَ عَلَى جَوْرَبَيْهِ وَنَعْلَيْهِ \" /27 * \r\n$1915  /8",
