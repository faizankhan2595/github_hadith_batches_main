      "hadith_id": 100950,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 576,
      "text_ar": "حَدَّثَنَا /94 أَبُو الْأَحْوَصِ /94 ، عَنْ /26 أَبِي حَمْزَةَ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، عَنْ /26 عَلْقَمَةَ /26 ، قَالَ : /27 قَالَ /93 عَبْدُ اللَّهِ L5079 /93 : /20 \" الْمَاءُ عَلَى أَثَرِ الْمَاءِ يُجْزِئُ وَلَيْسَ بَعْدَ الثَّلَاثِ شَيْءٌ \" /27 * \r\n$714  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سَوَادَةَ بْنِ أَبِي الْأَسْوَدِ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، أَنَّهُ /20 \" تَوَضَّأَ بِكُوزٍ \" /27 * \r\n$715  /2 /141 حَدَّثَنَا /94 الْفَضْلُ بْنُ دُكَيْنٍ L1548 /94 ، عَنْ /26 مُحَمَّدِ بْنِ أَبِي حَفْصَةَ L6765 /26 ، عَنِ /26 السُّدِّيِّ L1031 /26 ، عَنِ /26 الْبَهِيِّ L4615 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 تَوَضَّأَ بِكُوزٍ \" /27 * \r\n$716  /2 /141 حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، قَالَ : حَدَّثَنَا /26 شَرِيكٌ L3792 /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ عِيسَى L5001 /26 ، عَنِ /26 ابْنِ جَبْرٍ L3307 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 تَوَضَّأَ بِرِطْلَيْنِ مِنْ مَاءٍ \" /27 * \r\n@ 1 : 88 @\u001aE92",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو الْأَحْوَصِ /94",
      "matn_ar": "عَنْ /26 أَبِي حَمْزَةَ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، عَنْ /26 عَلْقَمَةَ /26 ، قَالَ : /27 قَالَ /93 عَبْدُ اللَّهِ L5079 /93 : /20 \" الْمَاءُ عَلَى أَثَرِ الْمَاءِ يُجْزِئُ وَلَيْسَ بَعْدَ الثَّلَاثِ شَيْءٌ \" /27 * \r\n$714  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سَوَادَةَ بْنِ أَبِي الْأَسْوَدِ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، أَنَّهُ /20 \" تَوَضَّأَ بِكُوزٍ \" /27 * \r\n$715  /2 /141 حَدَّثَنَا /94 الْفَضْلُ بْنُ دُكَيْنٍ L1548 /94 ، عَنْ /26 مُحَمَّدِ بْنِ أَبِي حَفْصَةَ L6765 /26 ، عَنِ /26 السُّدِّيِّ L1031 /26 ، عَنِ /26 الْبَهِيِّ L4615 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 تَوَضَّأَ بِكُوزٍ \" /27 * \r\n$716  /2 /141 حَدَّثَنَا /94 وَكِيعٌ L8160 /94 ، قَالَ : حَدَّثَنَا /26 شَرِيكٌ L3792 /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ عِيسَى L5001 /26 ، عَنِ /26 ابْنِ جَبْرٍ L3307 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 تَوَضَّأَ بِرِطْلَيْنِ مِنْ مَاءٍ \" /27 * \r\n@ 1 : 88 @\u001aE92",
