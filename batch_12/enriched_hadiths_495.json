      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنِ /26 الْعَوَّامِ بْنِ حَمْزَةَ /26 ، قَالَ : /27 سَأَلْتُ أَبَا عُثْمَانَ عَنِ /20 الْقُنُوتِ ؟ فَقَالَ : بَعْدَ الرُّكُوعِ ، فَقُلْتُ : عَمَّنْ ؟ فَقَالَ : عَنْ /93 أَبِي بَكْرٍ L4945 /93 ، /15 /93 وَعُثْمَانَ L5543 /93 /15 \" /27 * \r\n$6851  /3 /141 حَدَّثَنَا /94 مَرْوَانُ بْنُ مُعَاوِيَةَ /94 ، عَنْ /26 عَوْفٍ /26 ، عَنْ /26 أَبِي رَجَاءٍ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ مَعَ /93 ابْنِ عَبَّاسٍ L4883 /93 فِي مَسْجِدِ الْبَصْرَةِ صَلَاةَ الْغَدَاةِ ، فَقَنَتَ بِنَا قَبْلَ الرُّكُوعِ \" /27 حَدَّثَنَا /94 مَرْوَانُ بْنُ مُعَاوِيَةَ /94 ، عَنْ /26 عَوْفٍ /26 ، قَالَ : \" ذَكَرْتُ ذَلِكَ /26 لِأَبِي الْمِنْهَالِ /26 فَحَدَّثَنِي ، عَنْ /26 أَبِي الْعَالِيَةِ /26 ، عَنِ /93 ابْنِ عَبَّاسٍ : L4883 /93 بِمِثْلِهِ * \r\n$6852  /2 /141 حَدَّثَنَا /94 هُشَيْمٌ L8062 /94 ، عَنْ /26 يَحْيَى بْنِ سَعِيدٍ L8272 /26 ، /27 عَنْ /26 مُحَمَّدِ بْنِ يَحْيَى بْنِ حِبَّانَ L7319 /26 ، قَالَ : /20 \" قَنَتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَرْبَعِينَ صَبَاحًا فِي صَلَاةِ الصُّبْحِ بَعْدَ الرُّكُوعِ \" /27 * \r\n$6853  /3 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ فُضَيْلٍ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 عَيَّاشٍ الْعَامِرِيِّ /26 ، عَنِ /26 ابْنِ مَعْقِلٍ /26 : \" /27 أَنَّ /93 عُمَرَ /93 ، /15 /93 وَعَلِيًّا /93 /15 , /15 /93 وَأَبَا مُوسَى /93 /15 /20 قَنَتُوا فِي الْفَجْرِ قَبْلَ الرُّكُوعِ \" /27 * \r\n$6854  /3 /141 حَدَّثَنَا /94 ابْنُ فُضَيْلٍ /94 ، عَنْ /26 مُطَرِّفٍ /26 ، عَنْ /26 أَبِي الْجَهْمِ /26 ، /27 عَنِ /93 الْبَرَاءِ L1157 /93 : \" أَنَّهُ كَانَ /20 يَقْنُتُ قَبْلَ الرَّكْعَةِ \" /27 * \r\n$6855  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 يَزِيدُ بْنُ أَبِي زِيَادٍ /26 ، قَالَ : حَدَّثَنَا /26 زَيْدُ بْنُ وَهْبٍ /26 : /27 \" أَنَّ /93 عُمَرَ بْنَ الْخَطَّابِ L5913 /93 /20 قَنَتَ فِي صَلَاةِ الصُّبْحِ قَبْلَ الرُّكُوع \" /27 * \r\n$6856  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 عَلِيُّ بْنُ زَيْدٍ /26 ، قَالَ : أَخْبَرَنَا /26 أَبُو عُثْمَانَ النَّهْدِيُّ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ خَلْفَ /93 عُمَرَ بْنِ الْخَطَّابِ L5913 /93 صَلَاةَ الصُّبْحِ ، فَقَنَتَ قَبْلَ الرُّكُوعِ \" /27 * \r\n$6857  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 عَطَاءُ بْنُ السَّائِبِ /26 ، عَنْ /26 أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ /26 : /27 \" أَنَّ /93 عَلِيًّا L5722 /93 كَانَ /20 يَقْنُتُ فِي صَلَاةِ الصُّبْحِ قَبْلَ الرُّكُوعِ \" /27 * \r\n$6858  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 ابْنُ أَبِي لَيْلَى /26 ، عَنْ /26 عَطَاءٍ /26 ، عَنْ /26 عُبَيْدِ بْنِ عُمَيْرٍ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ خَلْفَ /93 عُمَرَ L5913 /93 الْغَدَاةَ ، قَالَ : فَقَنَتَ فِيهَا قَبْلَ الرُّكُوعِ \" /27 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 ابْنُ أَبِي لَيْلَى /26 ، عَنْ /26 عَطَاءٍ /26 ، عَنْ /26 عُبَيْدِ بْنِ عُمَيْرٍ /26 ، عَنْ /93 عُمَرَ /93 بِمِثْلِهِ * \r\n$6859  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنْ /26 نُسَيْرِ بْنِ ذُعْلُوقٍ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ خَلْفَ /26 رَبِيعِ بْنِ خُثَيْمٍ /26 فَقَنَتَ قَبْلَ الرَّكْعَةِ \" /27 * \r\n@ 2 : 213 @ \r\n$6860  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنِ /26 النُّعْمَانِ بْنِ قَيْسٍ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ خَلْفَ /26 عَبِيدَةَ /26 الْفَجْرَ ، فَقَنَتَ قَبْلَ الرَّكْعَةِ \" /27 * \r\n$6861  /8 /141 حَدَّثَنَا : /26 حُسَيْنُ بْنُ عَلِيٍّ /26 ، عَنْ /26 زَائِدَةَ /26 ، عَنْ /26 أَبِي فَرْوَةَ /26 ، قَالَ : كَانَ /27 \" /26 ابْنَ أَبِي لَيْلَى /26 /20 يَقْنُتُ فِي الْفَجْرِ قَبْلَ الرَّكْعَةِ \" /27 * \r\n$6862  /8 /141 حَدَّثَنَا /94 أَحْمَدُ بْنُ إِسْحَاقَ /94 ، عَنْ /26 وَهْبٍ /26 ، /27 عَنِ /26 ابْنِ طَاوُسٍ /26 ، عَنْ /26 أَبِيهِ /26 ، قَالَ : \" كَانَ /20 يَدْعُو بِدُعَاءٍ كَثِيرٍ فِي صَلَاةِ الصُّبْحِ قَبْلَ الرُّكُوعِ \" /27 * \r\n0E946",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنِ /26 الْعَوَّامِ بْنِ حَمْزَةَ /26 ، قَالَ : /27 سَأَلْتُ أَبَا عُثْمَانَ عَنِ /20 الْقُنُوتِ ؟ فَقَالَ : بَعْدَ الرُّكُوعِ ، فَقُلْتُ : عَمَّنْ ؟ فَقَالَ : عَنْ /93 أَبِي بَكْرٍ L4945 /93 ، /15 /93 وَعُثْمَانَ L5543 /93 /15 \" /27 * \r\n$6851  /3 /141 حَدَّثَنَا /94 مَرْوَانُ بْنُ مُعَاوِيَةَ /94 ، عَنْ /26 عَوْفٍ /26 ، عَنْ /26 أَبِي رَجَاءٍ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ مَعَ /93 ابْنِ عَبَّاسٍ L4883 /93 فِي مَسْجِدِ الْبَصْرَةِ صَلَاةَ الْغَدَاةِ ، فَقَنَتَ بِنَا قَبْلَ الرُّكُوعِ \" /27 حَدَّثَنَا /94 مَرْوَانُ بْنُ مُعَاوِيَةَ /94 ، عَنْ /26 عَوْفٍ /26 ، قَالَ : \" ذَكَرْتُ ذَلِكَ /26 لِأَبِي الْمِنْهَالِ /26 فَحَدَّثَنِي ، عَنْ /26 أَبِي الْعَالِيَةِ /26 ، عَنِ /93 ابْنِ عَبَّاسٍ : L4883 /93 بِمِثْلِهِ * \r\n$6852  /2 /141 حَدَّثَنَا /94 هُشَيْمٌ L8062 /94 ، عَنْ /26 يَحْيَى بْنِ سَعِيدٍ L8272 /26 ، /27 عَنْ /26 مُحَمَّدِ بْنِ يَحْيَى بْنِ حِبَّانَ L7319 /26 ، قَالَ : /20 \" قَنَتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَرْبَعِينَ صَبَاحًا فِي صَلَاةِ الصُّبْحِ بَعْدَ الرُّكُوعِ \" /27 * \r\n$6853  /3 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ فُضَيْلٍ /94 ، عَنْ /26 حَجَّاجٍ /26 ، عَنْ /26 عَيَّاشٍ الْعَامِرِيِّ /26 ، عَنِ /26 ابْنِ مَعْقِلٍ /26 : \" /27 أَنَّ /93 عُمَرَ /93 ، /15 /93 وَعَلِيًّا /93 /15 , /15 /93 وَأَبَا مُوسَى /93 /15 /20 قَنَتُوا فِي الْفَجْرِ قَبْلَ الرُّكُوعِ \" /27 * \r\n$6854  /3 /141 حَدَّثَنَا /94 ابْنُ فُضَيْلٍ /94 ، عَنْ /26 مُطَرِّفٍ /26 ، عَنْ /26 أَبِي الْجَهْمِ /26 ، /27 عَنِ /93 الْبَرَاءِ L1157 /93 : \" أَنَّهُ كَانَ /20 يَقْنُتُ قَبْلَ الرَّكْعَةِ \" /27 * \r\n$6855  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 يَزِيدُ بْنُ أَبِي زِيَادٍ /26 ، قَالَ : حَدَّثَنَا /26 زَيْدُ بْنُ وَهْبٍ /26 : /27 \" أَنَّ /93 عُمَرَ بْنَ الْخَطَّابِ L5913 /93 /20 قَنَتَ فِي صَلَاةِ الصُّبْحِ قَبْلَ الرُّكُوع \" /27 * \r\n$6856  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 عَلِيُّ بْنُ زَيْدٍ /26 ، قَالَ : أَخْبَرَنَا /26 أَبُو عُثْمَانَ النَّهْدِيُّ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ خَلْفَ /93 عُمَرَ بْنِ الْخَطَّابِ L5913 /93 صَلَاةَ الصُّبْحِ ، فَقَنَتَ قَبْلَ الرُّكُوعِ \" /27 * \r\n$6857  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 عَطَاءُ بْنُ السَّائِبِ /26 ، عَنْ /26 أَبِي عَبْدِ الرَّحْمَنِ السُّلَمِيِّ /26 : /27 \" أَنَّ /93 عَلِيًّا L5722 /93 كَانَ /20 يَقْنُتُ فِي صَلَاةِ الصُّبْحِ قَبْلَ الرُّكُوعِ \" /27 * \r\n$6858  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 ابْنُ أَبِي لَيْلَى /26 ، عَنْ /26 عَطَاءٍ /26 ، عَنْ /26 عُبَيْدِ بْنِ عُمَيْرٍ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ خَلْفَ /93 عُمَرَ L5913 /93 الْغَدَاةَ ، قَالَ : فَقَنَتَ فِيهَا قَبْلَ الرُّكُوعِ \" /27 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 ابْنُ أَبِي لَيْلَى /26 ، عَنْ /26 عَطَاءٍ /26 ، عَنْ /26 عُبَيْدِ بْنِ عُمَيْرٍ /26 ، عَنْ /93 عُمَرَ /93 بِمِثْلِهِ * \r\n$6859  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنْ /26 نُسَيْرِ بْنِ ذُعْلُوقٍ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ خَلْفَ /26 رَبِيعِ بْنِ خُثَيْمٍ /26 فَقَنَتَ قَبْلَ الرَّكْعَةِ \" /27 * \r\n@ 2 : 213 @ \r\n$6860  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنِ /26 النُّعْمَانِ بْنِ قَيْسٍ /26 ، قَالَ : /27 /20 \" صَلَّيْتُ خَلْفَ /26 عَبِيدَةَ /26 الْفَجْرَ ، فَقَنَتَ قَبْلَ الرَّكْعَةِ \" /27 * \r\n$6861  /8 /141 حَدَّثَنَا : /26 حُسَيْنُ بْنُ عَلِيٍّ /26 ، عَنْ /26 زَائِدَةَ /26 ، عَنْ /26 أَبِي فَرْوَةَ /26 ، قَالَ : كَانَ /27 \" /26 ابْنَ أَبِي لَيْلَى /26 /20 يَقْنُتُ فِي الْفَجْرِ قَبْلَ الرَّكْعَةِ \" /27 * \r\n$6862  /8 /141 حَدَّثَنَا /94 أَحْمَدُ بْنُ إِسْحَاقَ /94 ، عَنْ /26 وَهْبٍ /26 ، /27 عَنِ /26 ابْنِ طَاوُسٍ /26 ، عَنْ /26 أَبِيهِ /26 ، قَالَ : \" كَانَ /20 يَدْعُو بِدُعَاءٍ كَثِيرٍ فِي صَلَاةِ الصُّبْحِ قَبْلَ الرُّكُوعِ \" /27 * \r\n0E946",
