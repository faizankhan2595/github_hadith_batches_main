      "chapter_id": null,
      "hadith_number": 6234,
      "text_ar": "حَدَّثَنَا /94 أَبُو مُعَاوِيَةَ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، عَنْ /26 مُسْلِمٍ /26 ، عَنْ /26 مَسْرُوقٍ /26 ، قَالَ : /27 قَالَ /93 عَبْدُ اللَّهِ L5079 /93 : /20 \" قَارُّوا الصَّلَاةَ \" يَعْنِي : اسْكُنُوا فِيهَا \" /27 * \r\n$7079  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ رَجُلٍ قَدْ سَمَّاهُ /26 حَسَنٌ /26 أَوْ /26 سُفْيَانُ /26 ، عَنْ /26 زُبَيْدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 زَاذَانَ /26 /20 يُصَلِّي كَأَنَّهُ خَشَبَةٌ \" /27 * \r\n$7080  /8 /141 حَدَّثَنَا /94 مُعَاذٌ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 مُسْلِمَ بْنَ يَسَارٍ /26 /20 يُصَلِّي كَأَنَّهُ ودٌّ \" /27 * \r\n$7081  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، قَالَ : /27 \" كَانَ /93 عَبْدُ اللَّهِ L5079 /93 /20 إِذَا قَامَ إِلَى الصَّلَاةِ ، كَأَنَّهُ ثَوْبٌ مُلْقًى \" /27 * \r\n$7082  /3",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو مُعَاوِيَةَ /94",
      "matn_ar": "عَنِ /26 الْأَعْمَشِ /26 ، عَنْ /26 مُسْلِمٍ /26 ، عَنْ /26 مَسْرُوقٍ /26 ، قَالَ : /27 قَالَ /93 عَبْدُ اللَّهِ L5079 /93 : /20 \" قَارُّوا الصَّلَاةَ \" يَعْنِي : اسْكُنُوا فِيهَا \" /27 * \r\n$7079  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ رَجُلٍ قَدْ سَمَّاهُ /26 حَسَنٌ /26 أَوْ /26 سُفْيَانُ /26 ، عَنْ /26 زُبَيْدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 زَاذَانَ /26 /20 يُصَلِّي كَأَنَّهُ خَشَبَةٌ \" /27 * \r\n$7080  /8 /141 حَدَّثَنَا /94 مُعَاذٌ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 مُسْلِمَ بْنَ يَسَارٍ /26 /20 يُصَلِّي كَأَنَّهُ ودٌّ \" /27 * \r\n$7081  /3 /141 حَدَّثَنَا /94 أَبُو خَالِدٍ /94 ، عَنِ /26 الْأَعْمَشِ /26 ، قَالَ : /27 \" كَانَ /93 عَبْدُ اللَّهِ L5079 /93 /20 إِذَا قَامَ إِلَى الصَّلَاةِ ، كَأَنَّهُ ثَوْبٌ مُلْقًى \" /27 * \r\n$7082  /3",
