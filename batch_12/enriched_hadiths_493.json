    {
      "hadith_id": 106395,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 6021,
      "text_ar": "$6799  /2 /141 حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 حَفْصُ بْنُ غِيَاثٍ L2448 /94 ، /27 عَنْ /26 أَبِي مَالِكٍ الْأَشْجَعِيِّ L3248 /26 ، قَالَ : \" قُلْتُ /93 لِأَبِي : L3988 /93 يَا أَبَتِ /20 صَلَّيْتَ خَلْفَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَخَلْفَ أَبِي بَكْرٍ ، وَعُمَرَ ، وَعُثْمَانَ : فَهَلْ رَأَيْتَ أَحَدًا مِنْهُمْ يَقْنُتُ ؟ فَقَالَ : يَا بُنَيَّ هِيَ مُحْدَثَةٌ \" /27 * \r\n$6800  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 مِسْعَرٌ /26 ، عَنْ /26 يَحْيَى بْنِ غَسَّانَ الْمُرَادِيِّ /26 ، عَنْ /26 عَمْرِو بْنِ مَيْمُونٍ /26 : /27 \" أَنَّ /93 عُمَرَ بْنَ الْخَطَّابِ L5913 /93 /20 لَمْ يَقْنُتْ فِي الْفَجْرِ \" /27 * \r\n$6801  /2 /141 حَدَّثَنَا /94 ابْنُ إِدْرِيسَ L4667 /94 ، /27 عَنْ /26 أَبِي مَالِكٍ L3248 /26 ، عَنْ /93 أَبِيهِ L3988 /93 ، قَالَ : \" قُلْتُ لَهُ /20 صَلَّيْتَ خَلْفَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَأَبِي بَكْرٍ ، وَعُمَرَ ، وَعُثْمَانَ : أَفَكَانُوا يَقْنُتُونَ ؟ فَقَالَ : لَا يَا بُنَيَّ ، هِيَ مُحْدَثَةٌ \" /27 * \r\n@ 2 : 208 @ \r\n$6802  /3 /141 حَدَّثَنَا /94 ابْنُ إِدْرِيسَ /94 ، عَنِ /26 الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 أَنَّ /26 الْأَسْوَدَ /26 ، /26 وَعَمْرَو بْنَ مَيْمُونٍ /26 , \" /27 /20 صَلَّيَا خَلْفَ /93 عُمَرَ L5913 /93 الْفَجْرَ فَلَمْ يَقْنُتْ \" /27 * \r\n$6803  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 مَنْصُورٍ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، عَنِ /26 الْأَسْوَدِ بْنِ يَزِيدَ /26 ، /26 وَعَمْرِو بْنِ مَيْمُونٍ /26 , أَنَّهُمَا /27 /20 صَلَّيَا خَلْفَ /93 عُمَرَ L5913 /93 الْفَجْرَ فَلَمْ يَقْنُتَ \" /27 * \r\n$6804  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 مِسْعَرٌ /26 ، عَنْ /26 عُثْمَانَ الثَّقَفِيِّ /26 ، عَنْ /26 عَرْفَجَةَ /26 : /27 \" أَنَّ /93 ابْنَ مَسْعُودٍ L5079 /93 كَانَ /20 لَا يَقْنُتُ فِي الْفَجْرِ \" /27 * \r\n$6805  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنْ /26 عَلْقَمَةَ بْنِ قَيْسٍ /26 : /27 \" أَنَّ /93 ابْنَ مَسْعُودٍ L5079 /93 /20 لَمْ يَكُنْ يَقْنُتُ فِي الْفَجْرِ \" /27 * \r\n\u0019E940 \r\n$6806  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 مُغِيرَةُ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، قَالَ : /27 \" كَانَ /93 عَبْدُ اللَّهِ L5079 /93 /20 لَا يَقْنُتُ فِي صَلَاةِ الصُّبْحِ \" /27 * \r\n$6807  /3",
      "sanad_ar": "$6799  /2 /141 حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 حَفْصُ بْنُ غِيَاثٍ L2448 /94 ، /27 عَنْ /26 أَبِي مَالِكٍ الْأَشْجَعِيِّ L3248 /26 ، قَالَ : \" قُلْتُ /93 لِأَبِي : L3988 /93 يَا أَبَتِ /20 صَلَّيْتَ خَلْفَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَخَلْفَ أَبِي بَكْرٍ ، وَعُمَرَ ، وَعُثْمَانَ : فَهَلْ رَأَيْتَ أَحَدًا مِنْهُمْ يَقْنُتُ ؟ فَقَالَ : يَا بُنَيَّ هِيَ مُحْدَثَةٌ \" /27 * \r\n$6800  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 مِسْعَرٌ /26 ، عَنْ /26 يَحْيَى بْنِ غَسَّانَ الْمُرَادِيِّ /26 ، عَنْ /26 عَمْرِو بْنِ مَيْمُونٍ /26 : /27 \" أَنَّ /93 عُمَرَ بْنَ الْخَطَّابِ L5913 /93 /20 لَمْ يَقْنُتْ فِي الْفَجْرِ \" /27 * \r\n$6801  /2 /141 حَدَّثَنَا /94 ابْنُ إِدْرِيسَ L4667 /94 ، /27 عَنْ /26 أَبِي مَالِكٍ L3248 /26 ، عَنْ /93 أَبِيهِ L3988 /93 ، قَالَ : \" قُلْتُ لَهُ /20 صَلَّيْتَ خَلْفَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَأَبِي بَكْرٍ ، وَعُمَرَ ، وَعُثْمَانَ : أَفَكَانُوا يَقْنُتُونَ ؟ فَقَالَ : لَا يَا بُنَيَّ ، هِيَ مُحْدَثَةٌ \" /27 * \r\n@ 2 : 208 @ \r\n$6802  /3 /141 حَدَّثَنَا /94 ابْنُ إِدْرِيسَ /94 ، عَنِ /26 الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 أَنَّ /26 الْأَسْوَدَ /26 ، /26 وَعَمْرَو بْنَ مَيْمُونٍ /26 , \" /27 /20 صَلَّيَا خَلْفَ /93 عُمَرَ L5913 /93 الْفَجْرَ فَلَمْ يَقْنُتْ \" /27 * \r\n$6803  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 مَنْصُورٍ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، عَنِ /26 الْأَسْوَدِ بْنِ يَزِيدَ /26 ، /26 وَعَمْرِو بْنِ مَيْمُونٍ /26 , أَنَّهُمَا /27 /20 صَلَّيَا خَلْفَ /93 عُمَرَ L5913 /93 الْفَجْرَ فَلَمْ يَقْنُتَ \" /27 * \r\n$6804  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 مِسْعَرٌ /26 ، عَنْ /26 عُثْمَانَ الثَّقَفِيِّ /26 ، عَنْ /26 عَرْفَجَةَ /26 : /27 \" أَنَّ /93 ابْنَ مَسْعُودٍ L5079 /93 كَانَ /20 لَا يَقْنُتُ فِي الْفَجْرِ \" /27 * \r\n$6805  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنْ /26 عَلْقَمَةَ بْنِ قَيْسٍ /26 : /27 \" أَنَّ /93 ابْنَ مَسْعُودٍ L5079 /93 /20 لَمْ يَكُنْ يَقْنُتُ فِي الْفَجْرِ \" /27 * \r\n\u0019E940 \r\n$6806  /3 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 مُغِيرَةُ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، قَالَ : /27 \" كَانَ /93 عَبْدُ اللَّهِ L5079 /93 /20 لَا يَقْنُتُ فِي صَلَاةِ الصُّبْحِ \" /27 * \r\n$6807  /3",
