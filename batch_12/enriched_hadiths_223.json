      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 1960,
      "text_ar": "حَدَّثَنَا /94 يَحْيَى بْنُ سَعِيدٍ /94 ، عَنْ /26 هِشَامٍ /26 ، /27 عَنِ /26 الْحَسَنِ /26 , /26 وَمُحَمَّدٍ /26 أَنَّهُ \" كَانَ /20 يُعْجِبُهُمَا إِذَا أَذَّنَ الْمُؤَذِّنُ أَنْ يَسْتَقْبِلَ الْقِبْلَةَ \" /27 * \r\n$2172  /8",
