    {
      "hadith_id": 99037,
      "book_id": 93,
      "chapter_id": null,
      "hadith_number": 386,
      "text_ar": "حَدَّثَنَا /94 أَبُو بَكْرِ بْنُ عَيَّاشٍ /94 ، عَنْ /26 عَاصِمٍ /26 ، /27 عَنْ /26 أَبِي وَائِلٍ /26 ، قَالَ : /20 \" إِذَا عَطَسْتَ وَأَنْتَ وَحْدَكَ ، فَرُدَّ عَلَى مَنْ مَعَكَ مِنَ الْمَلائِكَةِ \" /27 * \r\n@ 1 : 327 @",
