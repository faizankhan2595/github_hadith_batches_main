      "chapter_id": null,
      "hadith_number": 309,
      "text_ar": "$402  /3 /141 حَدَّثَنَا /94 عَبَّادُ بْنُ الْعَوَّامِ /94 ، عَنْ /26 جَمِيلِ بْنِ زَيْدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /93 ابْنَ عُمَرَ L5913 /93 /20 تَمَضْمَضَ وَاسْتَنْشَقَ مِنْ كَفٍّ وَاحِدَةٍ \" /27 * \r\n$403  /2 /141 حَدَّثَنَا /94 شَرِيكٌ L3792 /94 ، عَنْ /26 خَالِدِ بْنِ عَلْقَمَةَ L2672 /26 ، عَنْ /26 عَبْدِ خَيْرٍ L4199 /26 ، /27 عَنْ /93 عَلِيٍّ L5722 /93 ، قَالَ : /20 \" تَوَضَّأَ فَمَضْمَضَ ثَلَاثًا وَاسْتَنْشَقَ ثَلَاثًا مِنْ كَفٍّ وَاحِدَةٍ \" قَالَ : \" هَكَذَا وُضُوءُ نَبِيِّكُمْ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" /27 * \r\n$404  /2 /141 حَدَّثَنَا /94 ابْنُ إِدْرِيسَ L4667 /94 ، عَنْ /26 مُحَمَّدِ بْنِ عَجْلَانَ L7172 /26 ، عَنْ /26 زَيْدِ بْنِ أَسْلَمَ L3122 /26 ، عَنْ /26 عَطَاءِ بْنِ يَسَارٍ L5640 /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 \" تَوَضَّأَ فَغَرَفَ غَرْفَةً تَمَضْمَضَ مِنْهَا وَاسْتَنْشَقَ \" /27 * \r\n@ 1 : 54 @ \r\n$405  /3 /141 حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنْ /26 رَاشِدِ بْنِ مَعْبَدٍ /26 ، قَالَ : /27 رَأَيْتُ /93 أَنَسَ بْنَ مَالِكٍ L720 /93 /20 \" يُمَضْمِضُ وَيَسْتَنْشِقُ مِنْ كَفٍّ وَاحِدَةٍ \" /27 * \r\n$406  /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ أَبِي عَدِيٍّ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 ، /27 عَنْ /26 مُحَمَّدٍ /26 ، قَالَ : \" كَانَ /20 يُمَضْمِضُ وَيَسْتَنْشِقُ بِمَاءٍ وَاحِدٍ كُلَّ مَرَّةٍ \" /27 * \r\n$407  /8 /141 /26 حَدَّثْتُ /26 عَنْ /26 هُشَيْمٍ /26 ، عَنِ /26 الْعَوَّامِ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ التَّيْمِيِّ /26 أَنَّهُ \" كَانَ /20 يُمَضْمِضُ وَيَسْتَنْشِقُ مِنْ كَفٍّ وَاحِدَةٍ \" /27 * \r\n$408  /8",
      "sanad_ar": "$402  /3 /141 حَدَّثَنَا /94 عَبَّادُ بْنُ الْعَوَّامِ /94",
      "matn_ar": "عَنْ /26 جَمِيلِ بْنِ زَيْدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /93 ابْنَ عُمَرَ L5913 /93 /20 تَمَضْمَضَ وَاسْتَنْشَقَ مِنْ كَفٍّ وَاحِدَةٍ \" /27 * \r\n$403  /2 /141 حَدَّثَنَا /94 شَرِيكٌ L3792 /94 ، عَنْ /26 خَالِدِ بْنِ عَلْقَمَةَ L2672 /26 ، عَنْ /26 عَبْدِ خَيْرٍ L4199 /26 ، /27 عَنْ /93 عَلِيٍّ L5722 /93 ، قَالَ : /20 \" تَوَضَّأَ فَمَضْمَضَ ثَلَاثًا وَاسْتَنْشَقَ ثَلَاثًا مِنْ كَفٍّ وَاحِدَةٍ \" قَالَ : \" هَكَذَا وُضُوءُ نَبِيِّكُمْ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" /27 * \r\n$404  /2 /141 حَدَّثَنَا /94 ابْنُ إِدْرِيسَ L4667 /94 ، عَنْ /26 مُحَمَّدِ بْنِ عَجْلَانَ L7172 /26 ، عَنْ /26 زَيْدِ بْنِ أَسْلَمَ L3122 /26 ، عَنْ /26 عَطَاءِ بْنِ يَسَارٍ L5640 /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 : أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 \" تَوَضَّأَ فَغَرَفَ غَرْفَةً تَمَضْمَضَ مِنْهَا وَاسْتَنْشَقَ \" /27 * \r\n@ 1 : 54 @ \r\n$405  /3 /141 حَدَّثَنَا /94 يَزِيدُ بْنُ هَارُونَ /94 ، عَنْ /26 رَاشِدِ بْنِ مَعْبَدٍ /26 ، قَالَ : /27 رَأَيْتُ /93 أَنَسَ بْنَ مَالِكٍ L720 /93 /20 \" يُمَضْمِضُ وَيَسْتَنْشِقُ مِنْ كَفٍّ وَاحِدَةٍ \" /27 * \r\n$406  /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ أَبِي عَدِيٍّ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 ، /27 عَنْ /26 مُحَمَّدٍ /26 ، قَالَ : \" كَانَ /20 يُمَضْمِضُ وَيَسْتَنْشِقُ بِمَاءٍ وَاحِدٍ كُلَّ مَرَّةٍ \" /27 * \r\n$407  /8 /141 /26 حَدَّثْتُ /26 عَنْ /26 هُشَيْمٍ /26 ، عَنِ /26 الْعَوَّامِ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ التَّيْمِيِّ /26 أَنَّهُ \" كَانَ /20 يُمَضْمِضُ وَيَسْتَنْشِقُ مِنْ كَفٍّ وَاحِدَةٍ \" /27 * \r\n$408  /8",
