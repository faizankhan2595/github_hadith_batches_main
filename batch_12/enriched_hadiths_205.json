    {
      "hadith_id": 102064,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 1690,
      "text_ar": "حَدَّثَنَا /94 ابْنُ فُضَيْلٍ /94 ، عَنْ /26 ضِرَارِ بْنِ مُرَّةَ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، قَالَ : /27 قَالَ /93 ابْنُ عَبَّاسٍ L4883 /93 : /20 \" مَا أُبَالِي مَسَحْتُ عَلَى الْخُفَّيْنِ أَوْ مَسَحْتُ عَلَى ظَهْرِ بُختيي هَذَا \" /27 * \r\n$1891  /8",
