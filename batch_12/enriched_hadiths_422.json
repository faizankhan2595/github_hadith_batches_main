    {
      "hadith_id": 105319,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 4945,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 شُعْبَةَ /26 ، عَنْ /26 عَمْرِو بْنِ مُرَّةَ /26 ، عَنْ /26 زَاذَانَ /26 ، /27 أَنَّ رَجُلًا سَأَلَ /93 عَلِيًّا L5722 /93 عَنِ الْغُسْلِ ، فَقَالَ : \" /20 الْغُسْلُ يَوْمَ الْأَضْحَى وَيَوْمَ الْفِطْرِ \" /27 * \r\n$5627  /3 /141 حَدَّثَنَا /94 عَبْدُ اللَّهِ بْنُ نُمَيْرٍ /94 ، قَالَ : حَدَّثَنَا /26 عُبَيْدُ اللَّهِ بْنُ عُمَرَ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنَ عُمَرَ L4967 /93 \" أَنَّهُ كَانَ /20 يَغْتَسِلُ لِلْعِيدَيْنِ \" /27 * \r\n$5628  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سَعِيدِ بْنِ سِنَانٍ /26 ، عَنْ /18 /26 رَجُلٍ /26 /18 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، قَالَ : /20 \" اغْتَسَلَ فِي الْعِيدَيْنِ \" /27 * \r\n$5629  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الْعُمَرِيِّ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 \" أَنَّهُ كَانَ /20 يَغْتَسِلُ فِي الْعِيدَيْنِ \" /27 * \r\n$5630  /8 /141 حَدَّثَنَا /94 عَبْدُ الْأَعْلَى /94 ، عَنْ /26 يُونُسَ /26 ، /27 عَنِ /26 الْحَسَنِ /26 : \" أَنَّهُ كَانَ /20 يَغْتَسِلُ يَوْمَ الْفِطْرِ ، وَيَوْمَ النَّحْرِ \" /27 * \r\n$5631  /8 /141 حَدَّثَنَا /94 أَبُو أُسَامَةَ /94 ، عَنْ /26 هِشَامٍ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، /26 وَمُحَمَّدٍ /26 \" أَنَّهُمَا كَانَا /20 يَغْتَسِلانِ يَوْمَ الْفِطْرِ ، وَيَوْمَ النَّحْرِ \" /27 * \r\n$5632  /8",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ /94",
      "matn_ar": "عَنْ /26 شُعْبَةَ /26 ، عَنْ /26 عَمْرِو بْنِ مُرَّةَ /26 ، عَنْ /26 زَاذَانَ /26 ، /27 أَنَّ رَجُلًا سَأَلَ /93 عَلِيًّا L5722 /93 عَنِ الْغُسْلِ ، فَقَالَ : \" /20 الْغُسْلُ يَوْمَ الْأَضْحَى وَيَوْمَ الْفِطْرِ \" /27 * \r\n$5627  /3 /141 حَدَّثَنَا /94 عَبْدُ اللَّهِ بْنُ نُمَيْرٍ /94 ، قَالَ : حَدَّثَنَا /26 عُبَيْدُ اللَّهِ بْنُ عُمَرَ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنَ عُمَرَ L4967 /93 \" أَنَّهُ كَانَ /20 يَغْتَسِلُ لِلْعِيدَيْنِ \" /27 * \r\n$5628  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 سَعِيدِ بْنِ سِنَانٍ /26 ، عَنْ /18 /26 رَجُلٍ /26 /18 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، قَالَ : /20 \" اغْتَسَلَ فِي الْعِيدَيْنِ \" /27 * \r\n$5629  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنِ /26 الْعُمَرِيِّ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 \" أَنَّهُ كَانَ /20 يَغْتَسِلُ فِي الْعِيدَيْنِ \" /27 * \r\n$5630  /8 /141 حَدَّثَنَا /94 عَبْدُ الْأَعْلَى /94 ، عَنْ /26 يُونُسَ /26 ، /27 عَنِ /26 الْحَسَنِ /26 : \" أَنَّهُ كَانَ /20 يَغْتَسِلُ يَوْمَ الْفِطْرِ ، وَيَوْمَ النَّحْرِ \" /27 * \r\n$5631  /8 /141 حَدَّثَنَا /94 أَبُو أُسَامَةَ /94 ، عَنْ /26 هِشَامٍ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، /26 وَمُحَمَّدٍ /26 \" أَنَّهُمَا كَانَا /20 يَغْتَسِلانِ يَوْمَ الْفِطْرِ ، وَيَوْمَ النَّحْرِ \" /27 * \r\n$5632  /8",
