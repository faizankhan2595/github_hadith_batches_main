    {
      "hadith_id": 107359,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 6985,
      "text_ar": "حَدَّثَنَا /94 جَرِيرٌ /94 ، عَنْ /26 مَنْصُورٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، قَالَ : /20 \" إِذَا كَانَ سَفَرُكَ يَوْمًا إِلَى الْعَتَمَةِ ؛ فَلَا تَقْصُرِ الصَّلَاةَ ، فَإِنْ جَاوَزْتَ ذَلِكَ ، فَاقْصُرْ \" /27 * \r\n@ 2 : 329 @",
