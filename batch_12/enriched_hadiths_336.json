    {
      "hadith_id": 104026,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 3652,
      "text_ar": "حَدَّثَنَا وَكِيعٌ ، عَنْ إِسْرَائِيلَ ، عَنْ ثُوَيْرٍ ، عَنْ أَبِيهِ ، عَنْ عَلِيٍّ : \" أَنَّهُ كَانَ يَقْرَأُ السَّجْدَةَ وَهُوَ عَلَى رَاحِلَتِهِ فَيُومِئُ \" . * \r\n$4107  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنْ /26 جَابِرٍ /26 ، عَنْ /26 عَامِرٍ /26 ، عَنْ /26 أَبِي عُبَيْدَةَ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ زَيْدٍ /26 ، قَالَ : \" كَانَ /20 يَقْرَأُ السَّجْدَةَ عَلَى رَاحِلَتِهِ فَيُومِئُ \" /27 * \r\n$4108  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنْ /26 ثُوَيْرٍ /26 ، قَالَ : /27 رَأَيْتُ /93 ابْنُ الزُّبَيْرِ L4697 /93 /20 يَقْرَأُ السَّجْدَةَ عَلَى رَاحِلَتِهِ فَيُومِئُ \" /27 * \r\n$4109  /8",
      "sanad_ar": "حَدَّثَنَا وَكِيعٌ",
      "matn_ar": "عَنْ إِسْرَائِيلَ ، عَنْ ثُوَيْرٍ ، عَنْ أَبِيهِ ، عَنْ عَلِيٍّ : \" أَنَّهُ كَانَ يَقْرَأُ السَّجْدَةَ وَهُوَ عَلَى رَاحِلَتِهِ فَيُومِئُ \" . * \r\n$4107  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنْ /26 جَابِرٍ /26 ، عَنْ /26 عَامِرٍ /26 ، عَنْ /26 أَبِي عُبَيْدَةَ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ زَيْدٍ /26 ، قَالَ : \" كَانَ /20 يَقْرَأُ السَّجْدَةَ عَلَى رَاحِلَتِهِ فَيُومِئُ \" /27 * \r\n$4108  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنْ /26 ثُوَيْرٍ /26 ، قَالَ : /27 رَأَيْتُ /93 ابْنُ الزُّبَيْرِ L4697 /93 /20 يَقْرَأُ السَّجْدَةَ عَلَى رَاحِلَتِهِ فَيُومِئُ \" /27 * \r\n$4109  /8",
