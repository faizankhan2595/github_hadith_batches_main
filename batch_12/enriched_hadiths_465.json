    {
      "hadith_id": 105963,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 5589,
      "text_ar": "حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94 ، عَنِ /26 ابْنِ أَبِي عَرُوبَةَ /26 ، عَنْ /26 أَبِي مَعْشَرٍ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 : \" أَنَّهُ كَانَ /20 لَا يَرَى بِهِ بَأْسًا إِذَا كَانَ عَلَيْهِ قَمِيصٌ \" /27 * \r\n$6336  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنْ /26 عَطَاءِ بْنِ السَّائِبِ /26 ، عَنْ /26 مُحَارِبٍ /26 ، قَالَ : /27 \" رَأَيْتُ /93 ابْنَ عُمَرَ L4967 /93 /20 يَسْدُلُ فِي الصَّلَاةِ \" /27 * \r\n$6337  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 أَبُو شِهَابٍ مُوسَى بْنُ ثَابِتٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَعِيدَ بْنَ جُبَيْرٍ /26 /20 يَسْدُلُ فِي التَّطَوُّعِ وَعَلَيْهِ مُسْتُقَةٌ مُكَفَّفَةٌ \" /27 * \r\n$6338  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، /27 عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ /26 : \" أَنَّهُ كَانَ /20 يَسْدُلُ فِي الصَّلَاةِ \" /27 * \r\n$6339  /8 /141 حَدَّثَنَا /94 سَهْلُ بْنُ يُوسُفَ /94 ، عَنْ /26 حُمَيْدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْحَسَنَ /26 /20 مَا لَا أُحْصِي فِي الصَّلَاةِ يَسْدُلُ وَأَنَا أَرَى ظَهْرَهُ \" /27 * \r\n@ 2 : 162 @ \r\n$6340  /8",
      "sanad_ar": "حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94",
      "matn_ar": "عَنِ /26 ابْنِ أَبِي عَرُوبَةَ /26 ، عَنْ /26 أَبِي مَعْشَرٍ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 : \" أَنَّهُ كَانَ /20 لَا يَرَى بِهِ بَأْسًا إِذَا كَانَ عَلَيْهِ قَمِيصٌ \" /27 * \r\n$6336  /3 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنْ /26 عَطَاءِ بْنِ السَّائِبِ /26 ، عَنْ /26 مُحَارِبٍ /26 ، قَالَ : /27 \" رَأَيْتُ /93 ابْنَ عُمَرَ L4967 /93 /20 يَسْدُلُ فِي الصَّلَاةِ \" /27 * \r\n$6337  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 أَبُو شِهَابٍ مُوسَى بْنُ ثَابِتٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَعِيدَ بْنَ جُبَيْرٍ /26 /20 يَسْدُلُ فِي التَّطَوُّعِ وَعَلَيْهِ مُسْتُقَةٌ مُكَفَّفَةٌ \" /27 * \r\n$6338  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 سُفْيَانُ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، /27 عَنْ /26 عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ /26 : \" أَنَّهُ كَانَ /20 يَسْدُلُ فِي الصَّلَاةِ \" /27 * \r\n$6339  /8 /141 حَدَّثَنَا /94 سَهْلُ بْنُ يُوسُفَ /94 ، عَنْ /26 حُمَيْدٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْحَسَنَ /26 /20 مَا لَا أُحْصِي فِي الصَّلَاةِ يَسْدُلُ وَأَنَا أَرَى ظَهْرَهُ \" /27 * \r\n@ 2 : 162 @ \r\n$6340  /8",
