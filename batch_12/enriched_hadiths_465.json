      "hadith_id": 105974,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 5600,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ /94 ، عَنْ /26 بُرْدِ بْنِ أَبِي زِيَادٍ /26 ، عَنْ /26 أَبِي فَاخِتَةَ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قَالَ : /20 \" شُدَّ حَقْوَكَ فِي الصَّلَاةِ وَلَوْ بعقال \" /27 * \r\n$6352  /3 /141 حَدَّثَنَا /94 عَبْدَةُ /94 ، عَنْ /26 عُبَيْدِ اللَّهِ بْنِ عُمَرَ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 : \" أَنَّهُ كَانَ /20 لَا يُصَلَّى إِلَّا وَهُوَ مُؤْتَزِرٌ \" /27 * \r\n\u0019E879 \r\n$6353  /8 /141 حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94 ، عَنْ /26 أَيُّوبَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَالِمَ بْنَ عَبْدِ اللَّهِ /26 /20 يُصَلِّي وَهُوَ مُؤْتَزِرٌ فَوْقَ قَمِيصِهِ أَوْ قَالَ : جُبَّتِهِ \" /27 * \r\n$6354  /8 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 حُصَيْنٌ /26 ، /27 عَنْ /26 أَبِي مَالِكٍ /26 : \" أَنَّهُ كَانَ /20 يَشُدُّ حَقْوَهُ فِي الصَّلَاةِ بِخَيْطٍ أَوْ بِشَيْءٍ \" /27 * \r\n$6355  /8",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ /94 ، عَنْ /26 بُرْدِ بْنِ أَبِي زِيَادٍ /26 ، عَنْ /26 أَبِي فَاخِتَةَ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قَالَ : /20 \" شُدَّ حَقْوَكَ فِي الصَّلَاةِ وَلَوْ بعقال \" /27 * \r\n$6352  /3 /141 حَدَّثَنَا /94 عَبْدَةُ /94 ، عَنْ /26 عُبَيْدِ اللَّهِ بْنِ عُمَرَ /26 ، عَنْ /26 نَافِعٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 : \" أَنَّهُ كَانَ /20 لَا يُصَلَّى إِلَّا وَهُوَ مُؤْتَزِرٌ \" /27 * \r\n\u0019E879 \r\n$6353  /8 /141 حَدَّثَنَا /94 ابْنُ عُلَيَّةَ /94 ، عَنْ /26 أَيُّوبَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سَالِمَ بْنَ عَبْدِ اللَّهِ /26 /20 يُصَلِّي وَهُوَ مُؤْتَزِرٌ فَوْقَ قَمِيصِهِ أَوْ قَالَ : جُبَّتِهِ \" /27 * \r\n$6354  /8 /141 حَدَّثَنَا /94 هُشَيْمٌ /94 ، قَالَ : أَخْبَرَنَا /26 حُصَيْنٌ /26 ، /27 عَنْ /26 أَبِي مَالِكٍ /26 : \" أَنَّهُ كَانَ /20 يَشُدُّ حَقْوَهُ فِي الصَّلَاةِ بِخَيْطٍ أَوْ بِشَيْءٍ \" /27 * \r\n$6355  /8",
