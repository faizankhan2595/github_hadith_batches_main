      "hadith_id": 105964,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 5590,
      "text_ar": "حَدَّثَنَا /94 وَكِيعٌ /94 ، قَالَ : حَدَّثَنَا /26 يَزِيدُ بْنُ إِبْرَاهِيمَ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، قَالَ : /20 \" لَا بَأْسَ بِالسَّدْلِ فِي الصَّلَاةِ \" /27 * \r\n$6341  /8 /141 حَدَّثَنَا /94 مُعَاذٌ /94 ، قَالَ : حَدَّثَنَا /26 ابْنُ عَوْنٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 مُحَمَّدًا /26 /20 يُصَلِّي وَقَدْ سَدَلَ ثَوْبَهُ ، فَلَا أَدْرِي عَلَى الْإِزَارِ كَانَ أَوْ عَلَى الْقَمِيصِ \" /27 * \r\n$6342  /8 /141 حَدَّثَنَا /94 عَبْدَةُ /94 ، عَنِ /26 ابْنِ أَبِي عَرُوبَةَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 ابْنَ سِيرِينَ /26 /20 يَسْدُلُ فِي الصَّلَاةِ \" /27 * \r\n$6343  /8 /141 حَدَّثَنَا /94 عِيسَى بْنُ يُونُسَ /94 ، عَنِ /26 الْأَوْزَاعِيِّ /26 ، قَالَ : /27 \" رَأَيْتُ /26 مَكْحُولًا /26 /20 يَسْدُلُ طَيْلَسَانَةً عَلَيْهِ فِي الصَّلَاةِ \" /27 , حَدَّثَنَا /94 سَهْلُ بْنُ يُوسُفَ /94 ، عَنْ /26 شُعْبَةَ /26 ، عَنِ /26 الْحَكَمِ /26 : \" أَنَّهُ كَانَ لَا يَرَى بِهِ بَأْسًا \" * \r\n$6344  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 مَهْدِيِّ بْنِ مَيْمُونٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْحَسَنَ /26 /20 يَسْدُلُ عَلَى الْقِبَاءِ \" /27 * \r\n\u001cE878",
      "sanad_ar": "حَدَّثَنَا /94 وَكِيعٌ /94",
      "matn_ar": "قَالَ : حَدَّثَنَا /26 يَزِيدُ بْنُ إِبْرَاهِيمَ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، قَالَ : /20 \" لَا بَأْسَ بِالسَّدْلِ فِي الصَّلَاةِ \" /27 * \r\n$6341  /8 /141 حَدَّثَنَا /94 مُعَاذٌ /94 ، قَالَ : حَدَّثَنَا /26 ابْنُ عَوْنٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 مُحَمَّدًا /26 /20 يُصَلِّي وَقَدْ سَدَلَ ثَوْبَهُ ، فَلَا أَدْرِي عَلَى الْإِزَارِ كَانَ أَوْ عَلَى الْقَمِيصِ \" /27 * \r\n$6342  /8 /141 حَدَّثَنَا /94 عَبْدَةُ /94 ، عَنِ /26 ابْنِ أَبِي عَرُوبَةَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 ابْنَ سِيرِينَ /26 /20 يَسْدُلُ فِي الصَّلَاةِ \" /27 * \r\n$6343  /8 /141 حَدَّثَنَا /94 عِيسَى بْنُ يُونُسَ /94 ، عَنِ /26 الْأَوْزَاعِيِّ /26 ، قَالَ : /27 \" رَأَيْتُ /26 مَكْحُولًا /26 /20 يَسْدُلُ طَيْلَسَانَةً عَلَيْهِ فِي الصَّلَاةِ \" /27 , حَدَّثَنَا /94 سَهْلُ بْنُ يُوسُفَ /94 ، عَنْ /26 شُعْبَةَ /26 ، عَنِ /26 الْحَكَمِ /26 : \" أَنَّهُ كَانَ لَا يَرَى بِهِ بَأْسًا \" * \r\n$6344  /8 /141 حَدَّثَنَا /94 وَكِيعٌ /94 ، عَنْ /26 مَهْدِيِّ بْنِ مَيْمُونٍ /26 ، قَالَ : /27 \" رَأَيْتُ /26 الْحَسَنَ /26 /20 يَسْدُلُ عَلَى الْقِبَاءِ \" /27 * \r\n\u001cE878",
