    {
      "hadith_id": 105043,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 4669,
      "text_ar": "حَدَّثّنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 وَكِيعُ بْنُ الْجَرَّاحِ /94 ، عَنْ /26 ثَوْرٍ /26 ، عَنْ /26 سُلَيْمَانَ بْنِ مُوسَى /26 ، /27 عَنْ /93 عَمْرِو بْنِ الْعَاصِ L6086 /93 ، قَالَ : \" كَانَ /20 يُكْرَهُ الصَّلَاةُ نِصْفَ النَّهَارِ إلَّا يَوْمَ الْجُمُعَةِ \" /27 * \r\n$5286  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 لَيْثٍ /26 ، /27 عَنْ /26 طَاوُسٍ /26 ، قَالَ : /20 \" يَوْمُ الْجُمُعَةِ صَلَاةٌ كُلُّهُ \" /27 * \r\n$5287  /8",
      "sanad_ar": "حَدَّثّنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 وَكِيعُ بْنُ الْجَرَّاحِ /94 ، عَنْ /26 ثَوْرٍ /26 ، عَنْ /26 سُلَيْمَانَ بْنِ مُوسَى /26 ، /27 عَنْ /93 عَمْرِو بْنِ الْعَاصِ L6086 /93 ، قَالَ : \" كَانَ /20 يُكْرَهُ الصَّلَاةُ نِصْفَ النَّهَارِ إلَّا يَوْمَ الْجُمُعَةِ \" /27 * \r\n$5286  /8 /141 حَدَّثَنَا /94 حَفْصٌ /94 ، عَنْ /26 لَيْثٍ /26 ، /27 عَنْ /26 طَاوُسٍ /26 ، قَالَ : /20 \" يَوْمُ الْجُمُعَةِ صَلَاةٌ كُلُّهُ \" /27 * \r\n$5287  /8",
