    {
      "hadith_id": 100623,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 249,
      "text_ar": "حَدَّثَنَا /94 عَبْدُ الرَّحِيمِ /94 ، عَنْ /26 أَشْعَثَ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، أَنَّهُ كَانَ /20 \" لَا يَرَى بَأْسًا بِسُؤْرِ السِّنَّوْرِ \" /27 * \r\n$331  /3 /141 حَدَّثَنَا /94 عُبَيْدُ اللَّهِ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنِ /26 السُّدِّيِّ /26 ، عَنْ /26 عِكْرِمَةَ /26 ، قَالَ : /27 \" كَانَ /93 الْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ L4180 /93 يُوضَعُ لَهُ الْوَضُوءُ فَيَشْغَلُهُ الشَّيْءُ /20 فَيَجِيءُ الْهِرُّ فَيَشْرَبُ مِنْهُ فَيَتَوَضَّأُ مِنْهُ وَيُصَلِّي \" /27 * \r\n$332  /8",
      "sanad_ar": "حَدَّثَنَا /94 عَبْدُ الرَّحِيمِ /94",
      "matn_ar": "عَنْ /26 أَشْعَثَ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، أَنَّهُ كَانَ /20 \" لَا يَرَى بَأْسًا بِسُؤْرِ السِّنَّوْرِ \" /27 * \r\n$331  /3 /141 حَدَّثَنَا /94 عُبَيْدُ اللَّهِ /94 ، عَنْ /26 إِسْرَائِيلَ /26 ، عَنِ /26 السُّدِّيِّ /26 ، عَنْ /26 عِكْرِمَةَ /26 ، قَالَ : /27 \" كَانَ /93 الْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ L4180 /93 يُوضَعُ لَهُ الْوَضُوءُ فَيَشْغَلُهُ الشَّيْءُ /20 فَيَجِيءُ الْهِرُّ فَيَشْرَبُ مِنْهُ فَيَتَوَضَّأُ مِنْهُ وَيُصَلِّي \" /27 * \r\n$332  /8",
