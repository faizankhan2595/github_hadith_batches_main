    {
      "hadith_id": 100622,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 248,
      "text_ar": "حَدَّثَنَا /94 رَوْحُ بْنُ عُبَادَةَ /94 ، عَنْ /26 مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْعَدَنِيِّ /26 ، قَالَ : /27 سَمِعْتُ /26 مُحَمَّدَ بْنَ عَلِيٍّ /26 ، يَقُولُ : /20 \" لَا بَأْسَ أَنْ يُتَوَضَّأَ بِفَضْلِ الْهِرِّ . وَيَقُولُ : هِيَ مِنْ مَتَاعِ الْبَيْتِ \" /27 * \r\n$329  /8 /141 حَدَّثَنَا /94 أَبُو بَحْرٍ الْبَكْرَاوِيُّ /94 ، عَنِ /26 الْجُرَيْرِيِّ /26 ، أَوْ /26 خَالِدٍ /26 ، قَالَ : /27 \" /20 وَلَغَتْ هِرَّةٌ فِي إِنَاءٍ /26 لِأَبِي الْعَلَاءِ /26 فَتَوَضَّأَ بِفَضْلِهَا \" /27 * \r\n$330  /8",
      "sanad_ar": "حَدَّثَنَا /94 رَوْحُ بْنُ عُبَادَةَ /94",
      "matn_ar": "عَنْ /26 مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْعَدَنِيِّ /26 ، قَالَ : /27 سَمِعْتُ /26 مُحَمَّدَ بْنَ عَلِيٍّ /26 ، يَقُولُ : /20 \" لَا بَأْسَ أَنْ يُتَوَضَّأَ بِفَضْلِ الْهِرِّ . وَيَقُولُ : هِيَ مِنْ مَتَاعِ الْبَيْتِ \" /27 * \r\n$329  /8 /141 حَدَّثَنَا /94 أَبُو بَحْرٍ الْبَكْرَاوِيُّ /94 ، عَنِ /26 الْجُرَيْرِيِّ /26 ، أَوْ /26 خَالِدٍ /26 ، قَالَ : /27 \" /20 وَلَغَتْ هِرَّةٌ فِي إِنَاءٍ /26 لِأَبِي الْعَلَاءِ /26 فَتَوَضَّأَ بِفَضْلِهَا \" /27 * \r\n$330  /8",
      "grade": null,
      "page_number": null,
