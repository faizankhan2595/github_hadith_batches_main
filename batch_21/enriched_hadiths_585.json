    {
      "hadith_id": 188773,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 10005,
      "text_ar": "يعد فِي أهل الحجاز ، لَهُ صحبة ، قَالَ عَبْد اللَّه : حَدَّثَنِي الليث ، قَالَ : حَدَّثَنِي خَالِد بْن يزيد ، عَنْ سَعِيد بْن أَبِي هلال ، عَنْ يزيد بْن خصيفة ، عَنْ عَبْد اللَّه بْن رافع مولى أم سلمة ، عَنْ غزية بْن الحارث أَنَّهُ أخبره ، عَنِ النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" لا هجرة بعد الْفَتْح إنما هو الجهاد ، والنية \"",
      "sanad_ar": "يعد فِي أهل الحجاز",
      "matn_ar": "لَهُ صحبة ، قَالَ عَبْد اللَّه : حَدَّثَنِي الليث ، قَالَ : حَدَّثَنِي خَالِد بْن يزيد ، عَنْ سَعِيد بْن أَبِي هلال ، عَنْ يزيد بْن خصيفة ، عَنْ عَبْد اللَّه بْن رافع مولى أم سلمة ، عَنْ غزية بْن الحارث أَنَّهُ أخبره ، عَنِ النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" لا هجرة بعد الْفَتْح إنما هو الجهاد ، والنية \"",
