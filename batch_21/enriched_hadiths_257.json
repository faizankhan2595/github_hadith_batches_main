    {
      "hadith_id": 183852,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 5084,
      "text_ar": "قَالَ ابْن المثنى : أَبُو عَبْد اللَّه ، حَدَّثَنَا /94 الفضل بْن مُوسَى /94 ، عَنْ /26 مهاجر بْن عُبَيْد اللَّه العتكي /26 ، عَنْ /26 سيف /26 \" رأى عُمَر توضأ ومسح بأصبعيه \" .",
