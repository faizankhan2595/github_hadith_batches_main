      "chapter_id": null,
      "hadith_number": 3893,
      "text_ar": "قَالَ ابْن عثمان عَنْ بْن المبارك ، أخبرنا يحيى بْن حسان ، عَنْ ربيعة بْن عامر ، سَمِعَ النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، \" ألظوا بياذا الجلال والإكرام \"\u001eE535",
      "sanad_ar": "قَالَ ابْن عثمان عَنْ بْن المبارك",
      "matn_ar": "أخبرنا يحيى بْن حسان ، عَنْ ربيعة بْن عامر ، سَمِعَ النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، \" ألظوا بياذا الجلال والإكرام \"\u001eE535",
