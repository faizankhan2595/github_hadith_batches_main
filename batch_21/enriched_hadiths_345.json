    {
      "hadith_id": 185172,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 6404,
      "text_ar": "أخو عَبْد الرَّحْمَن الْقُرَشِيّ قَالَه : مُحَمَّد بْن إِسْحَاق ، عَنْ عَبْد الرَّحْمَن ، عَنْ أخيه عَبْد اللَّه ، وَقَالَ سَعِيد بْن رجاء : حَدَّثَنَا /26 ابْن سَلَمَةَ /26 ، حَدَّثَنِي /94 عَبْد الرَّحْمَن بْن الحارث /94 ، عَنْ أخيه عَبْد اللَّه بْن الحارث \" رأى عَبْد اللَّه بْن عَبَّاس ، وابْن عُمَر \" . الأويسي ، حَدَّثَنَا /94 عطاف /94 ، رأيت على عَبْد اللَّه بْن الحارث بْن عياش بْن أَبِي ربيعة جبة خز .\u001dE819",
      "sanad_ar": "أخو عَبْد الرَّحْمَن الْقُرَشِيّ قَالَه",
      "matn_ar": "مُحَمَّد بْن إِسْحَاق ، عَنْ عَبْد الرَّحْمَن ، عَنْ أخيه عَبْد اللَّه ، وَقَالَ سَعِيد بْن رجاء : حَدَّثَنَا /26 ابْن سَلَمَةَ /26 ، حَدَّثَنِي /94 عَبْد الرَّحْمَن بْن الحارث /94 ، عَنْ أخيه عَبْد اللَّه بْن الحارث \" رأى عَبْد اللَّه بْن عَبَّاس ، وابْن عُمَر \" . الأويسي ، حَدَّثَنَا /94 عطاف /94 ، رأيت على عَبْد اللَّه بْن الحارث بْن عياش بْن أَبِي ربيعة جبة خز .\u001dE819",
