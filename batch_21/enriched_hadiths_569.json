    {
      "hadith_id": 188535,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 9767,
      "text_ar": "سَمِعَ جده رافعا ، وابْن عُمَر ، روى عَنْهُ : أَبُو حيان ، وسَعِيد بْن مسروق . وَقَالَ مُحَمَّد بْن حميد : نا يَحْيَى بْن ضريس ، قَالَ : نا أَبُو حمزة السكري ، عَنْ عاصم بْن كليب ، سَمِعَ عباية كَانَ رافع يأمر بنيه بالغسل يوم الجمَعَة .",
      "sanad_ar": "سَمِعَ جده رافعا",
