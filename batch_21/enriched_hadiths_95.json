      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 2646,
      "text_ar": "سَمِعَ واثلة ، وجنادة ، روى عنهُ مدرك بْن سعد ، والوليد بْن سُلَيْمَان ، حدثني مُحَمَّد بْن عَبْد اللَّه بْن عُبَيْد ، قَالَ : حدثني جدي ، قَالَ : حدثنا هشام بْن الغاز ، قَالَ : حدثني حيان رجل من قومي .",
      "sanad_ar": "سَمِعَ واثلة",
      "matn_ar": "وجنادة ، روى عنهُ مدرك بْن سعد ، والوليد بْن سُلَيْمَان ، حدثني مُحَمَّد بْن عَبْد اللَّه بْن عُبَيْد ، قَالَ : حدثني جدي ، قَالَ : حدثنا هشام بْن الغاز ، قَالَ : حدثني حيان رجل من قومي .",
