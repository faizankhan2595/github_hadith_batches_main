    {
      "hadith_id": 184842,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 6074,
      "text_ar": "لَهُ صحبة ، حَدَّثَنِي أَحْمَد بْن أَبِي رجاء ، نا سَلَمَةُ ، عَنِ ابْن المبارك ، عَنْ كهمس بْن الْحَسَن ، عَنْ هارون بْن الأصم ، قَالَ : \" جاءني كتاب عُمَر وقد توفِي ضرار بْن الأزور فقَالَ ، يَعْنِي خَالِد بْن الوليد مَا كَانَ ليخزي ضرار بْن الأزور \" . وهذا يقَالَ : إنه وهم إنما هو ضرار بْن الْخَطَّاب . \r\n$876  875 /2",
      "sanad_ar": "لَهُ صحبة",
      "matn_ar": "حَدَّثَنِي أَحْمَد بْن أَبِي رجاء ، نا سَلَمَةُ ، عَنِ ابْن المبارك ، عَنْ كهمس بْن الْحَسَن ، عَنْ هارون بْن الأصم ، قَالَ : \" جاءني كتاب عُمَر وقد توفِي ضرار بْن الأزور فقَالَ ، يَعْنِي خَالِد بْن الوليد مَا كَانَ ليخزي ضرار بْن الأزور \" . وهذا يقَالَ : إنه وهم إنما هو ضرار بْن الْخَطَّاب . \r\n$876  875 /2",
