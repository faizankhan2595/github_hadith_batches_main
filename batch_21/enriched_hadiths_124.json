    {
      "hadith_id": 181856,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 3088,
      "text_ar": "مَوْلَى هَزِيلَةَ امْرَأَةٌ مِنْ بَنِي دِينَارٍ وُلِدَتْ فِي بَنِي سَلَمَةَ ، قَالَ إِسْمَاعِيلُ عَنْ يَعْقُوبَ بْنِ مُحَمَّدِ بْنِ طَحْلاءَ ، عَنْ خَالِدٍ ، سَمِعَ جَابِرًا ، سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \" مَنْ تَوَلَّى غَيْرَ مَوَالِيهِ خَلَعَ اللَّهُ رِبْقَةَ الإِسْلامِ مِنْ عُنُقِهِ \"",
      "sanad_ar": "مَوْلَى هَزِيلَةَ امْرَأَةٌ مِنْ بَنِي دِينَارٍ وُلِدَتْ فِي بَنِي سَلَمَةَ",
      "matn_ar": "قَالَ إِسْمَاعِيلُ عَنْ يَعْقُوبَ بْنِ مُحَمَّدِ بْنِ طَحْلاءَ ، عَنْ خَالِدٍ ، سَمِعَ جَابِرًا ، سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : \" مَنْ تَوَلَّى غَيْرَ مَوَالِيهِ خَلَعَ اللَّهُ رِبْقَةَ الإِسْلامِ مِنْ عُنُقِهِ \"",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:47:45",
