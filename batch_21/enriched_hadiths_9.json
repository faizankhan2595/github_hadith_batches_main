      "hadith_id": 180125,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 1357,
      "text_ar": ". كوفِي . كناه لِي عُبَيْد بْن يعيش . قَالَ لنا مسدد عَنْ أَبِي الأحوص ، عَنْ مغيرة ، عَنْ إِبْرَاهِيم ، قَالَ تميم بْن حذيم الضبي قرأت على عَبْد اللَّه . وَقَالَ لنا أَحْمَد بْن يونس ، قَالَ : ثنا مُحَمَّد بْن عَبْد العزيز ، عَنْ مغيرة ، عَنْ إِبْرَاهِيم ، قَالَ : قرأ تميم بْن حذيم على عَبْد اللَّه ، فقرأ السجدة . وَقَالَ ابْن طهمان عَنِ المغيرة ، عَنِ الزُّهْرِيّ ، عَنْ تميم بْن حذيم ، قرأت على عَبْد اللَّه .\u001bE322",
      "sanad_ar": ". كوفِي . كناه لِي عُبَيْد بْن يعيش . قَالَ لنا مسدد عَنْ أَبِي الأحوص",
      "matn_ar": "عَنْ مغيرة ، عَنْ إِبْرَاهِيم ، قَالَ تميم بْن حذيم الضبي قرأت على عَبْد اللَّه . وَقَالَ لنا أَحْمَد بْن يونس ، قَالَ : ثنا مُحَمَّد بْن عَبْد العزيز ، عَنْ مغيرة ، عَنْ إِبْرَاهِيم ، قَالَ : قرأ تميم بْن حذيم على عَبْد اللَّه ، فقرأ السجدة . وَقَالَ ابْن طهمان عَنِ المغيرة ، عَنِ الزُّهْرِيّ ، عَنْ تميم بْن حذيم ، قرأت على عَبْد اللَّه .\u001bE322",
