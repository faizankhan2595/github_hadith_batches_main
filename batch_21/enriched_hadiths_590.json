    {
      "hadith_id": 188849,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 10081,
      "text_ar": "سَمِعَ مُعَاوِيَةَ ، سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" مَنْ زَادَ فِي شَعْرِهِ شَيْئًا لَيْسَ مِنْهُ فَإِنَّهُ زُورٌ \" ، قَالَه عَبْد اللَّه بْن صالح ، عَنِ الليث ، عَنْ عُبَيْد اللَّه بْن أَبِي جَعْفَر ، عَنْ صفوان ، عَنْ فضيل",
      "sanad_ar": "سَمِعَ مُعَاوِيَةَ",
      "matn_ar": "سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" مَنْ زَادَ فِي شَعْرِهِ شَيْئًا لَيْسَ مِنْهُ فَإِنَّهُ زُورٌ \" ، قَالَه عَبْد اللَّه بْن صالح ، عَنِ الليث ، عَنْ عُبَيْد اللَّه بْن أَبِي جَعْفَر ، عَنْ صفوان ، عَنْ فضيل",
