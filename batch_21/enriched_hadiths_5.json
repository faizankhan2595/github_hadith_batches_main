      "hadith_id": 180068,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 1300,
      "text_ar": "مولى أم هانئ الَهاشمي . كوفِي . قَالَ لِي مُحَمَّد بْن   @ 2 : 128 @    بشار : ترك ابْن مهدي حديث أَبِي صالح . وَقَالَ لِي مُحَمَّد عَنْ حكم بْن بشير ، عَنْ عَمْرو بْن قيس الملائي : قَالَ : \" كَانَ مجاهد ينهى عَنْ تفسير أَبِي صالح \" ، ويقال : باذان . قَالَ لِي أَحْمَد بْن سُلَيْمَان : حَدَّثَنَا ابْن عيينة ، عَنْ مُحَمَّد بْن قيس ، عَنْ حبيب بْن أَبِي ثابت ، قَالَ : كنا نسمي أبا صالح باذام : دروغزن . حَدَّثَنِي إِسْحَاق ، قَالَ : حَدَّثَنَا حسين ، عَنْ زائدة ، عَنْ منصور ، حَدَّثَنِي أَبُو صالح مولى أم هانئ ، عَنِ ابْن عَبَّاس ، فِي التهلكة .\u001fE318",
      "sanad_ar": "مولى أم هانئ الَهاشمي . كوفِي . قَالَ لِي مُحَمَّد بْن   @ 2",
