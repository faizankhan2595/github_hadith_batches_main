      "hadith_id": 185397,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 6629,
      "text_ar": "عَنْ أَبِي المتوكل في الصرف ، قَالَه ابْن   @ 5 : 8 @    منصور ، حَدَّثَنَا عَبْد الصمد ، حَدَّثَنَا شُعْبَة . وقَالَ مَحْمُود : حَدَّثَنَا أَبُو دَاوُد ، حَدَّثَنَا شُعْبَة ، عَنْ أَبِي عَبْد اللَّه الزعفراني ، سمع أبا المتوكل ، وقَالَ مُسْلِم حَدَّثَنَا شُعْبَة ، عَنْ عَبْد اللَّه الزعفراني ، عَنْ أَبِي المتوكل مثله\"E832",
      "sanad_ar": "عَنْ أَبِي المتوكل في الصرف",
      "matn_ar": "قَالَه ابْن   @ 5 : 8 @    منصور ، حَدَّثَنَا عَبْد الصمد ، حَدَّثَنَا شُعْبَة . وقَالَ مَحْمُود : حَدَّثَنَا أَبُو دَاوُد ، حَدَّثَنَا شُعْبَة ، عَنْ أَبِي عَبْد اللَّه الزعفراني ، سمع أبا المتوكل ، وقَالَ مُسْلِم حَدَّثَنَا شُعْبَة ، عَنْ عَبْد اللَّه الزعفراني ، عَنْ أَبِي المتوكل مثله\"E832",
