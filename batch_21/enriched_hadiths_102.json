    {
      "hadith_id": 181529,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 2761,
      "text_ar": "يعد فِي الْبَصْرِيّين ، اللحام ، سَمِعَ الْحَسَن فِي رجل قذف أهل مجلس جماعة ، الجلد لهم جميعا ؟ قَالَ : نعم . وسمع عطاء ، وابْن سيرين ، سَمِعَ منه مُوسَى بْن إِسْمَاعِيل .",
      "sanad_ar": "يعد فِي الْبَصْرِيّين",
