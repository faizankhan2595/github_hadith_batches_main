    {
      "hadith_id": 184962,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 6194,
      "text_ar": "مولى عُمَر بْن عَبْد العزيز \" أغمي على عُمَر بْن عَبْد العزيز فسكت طويلا ثم أفاق ، فقِيلَ لَهُ : توصي بشَيْئ ، قَالَ : /4 تِلْكَ الدَّارُ الآخِرَةُ نَجْعَلُهَا سورة القصص آية 83 /4 الآية حتى فارق الدنيا \" . قَالَه لنا : مُوسَى بْن إِسْمَاعِيل ، عَنْ سَعْد أَبِي عاصم . قَالَ : سَمِعت مات عُمَر وهو ابْن ثلاث وثلاثين سنة .",
      "sanad_ar": "مولى عُمَر بْن عَبْد العزيز \" أغمي على عُمَر بْن عَبْد العزيز فسكت طويلا ثم أفاق",
      "matn_ar": "فقِيلَ لَهُ : توصي بشَيْئ ، قَالَ : /4 تِلْكَ الدَّارُ الآخِرَةُ نَجْعَلُهَا سورة القصص آية 83 /4 الآية حتى فارق الدنيا \" . قَالَه لنا : مُوسَى بْن إِسْمَاعِيل ، عَنْ سَعْد أَبِي عاصم . قَالَ : سَمِعت مات عُمَر وهو ابْن ثلاث وثلاثين سنة .",
