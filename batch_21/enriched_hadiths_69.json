    {
      "hadith_id": 181031,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 2263,
      "text_ar": ". عَنْ عمران بْن مُسْلِم ، عَنْ خيثمة ، كنت عند ابْن عَبَّاس ، فِي النذر ، قاله مُحَمَّد بْن عقبة ، قَالَ : ثنا روح بْن عطاء ، قَالَ : ثنا حسين بْن عمران . وروى عمران القطان ، عَنْ حسين ، عَنِ الشيباني ، فلا أدري هو هذا أم لا ، وَلا يتابع فِي حديثه . وَقَالَ أَبُو ضمرة ، قَالَ : حَدَّثَنَا حسين بْن عمران ، عَنِ الزُّهْرِيّ مناكير .\u001bE430",
      "sanad_ar": ". عَنْ عمران بْن مُسْلِم",
