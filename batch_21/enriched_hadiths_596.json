      "hadith_id": 188940,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 10172,
      "text_ar": "مولى عُبَيْد اللَّه بْن علي بْن أَبِي رافع مولى النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَمِعَ عُبَيْد اللَّه بْن علي بْن أَبِي رافع ، قَالَه مُحَمَّد بْن أَبِي بكر ، عَنْ فضيل بْن سُلَيْمَان ، وروى   @ 7 : 23 @    عنه معن بْن عيسى ، وقَالَ مُحَمَّد بْن عباد ، عَنِ الدراوردي ، عَنْ فائد مولى عبادل ، عَنْ عُبَيْد اللَّه بْن أَبِي رافع",
      "sanad_ar": "مولى عُبَيْد اللَّه بْن علي بْن أَبِي رافع مولى النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سَمِعَ عُبَيْد اللَّه بْن علي بْن أَبِي رافع",
      "matn_ar": "قَالَه مُحَمَّد بْن أَبِي بكر ، عَنْ فضيل بْن سُلَيْمَان ، وروى   @ 7 : 23 @    عنه معن بْن عيسى ، وقَالَ مُحَمَّد بْن عباد ، عَنِ الدراوردي ، عَنْ فائد مولى عبادل ، عَنْ عُبَيْد اللَّه بْن أَبِي رافع",
