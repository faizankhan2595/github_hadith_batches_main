    {
      "hadith_id": 184977,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 6209,
      "text_ar": "وَقَالَ أَبُو مُعَاوِيَة : طريف بْن سَعْد وَقَالَ /26 جَعْفَر بْن حيان /26 عَنِ /26 ابْن شهاب /26 ، أَبُو سُفْيَان . يَرْوِي عَنِ /26 الْحَسَن /26 ، /26 وَأَبِي نضرة /26 ، ليس بالقوي عندهم . وقال ابن فضيل عَنْ /26 أَبِي سُفْيَانَ /26 ، عَنْ /26 أَبِي نَضْرَةَ /26 ، عَنْ /93 أَبِي سَعِيدٍ /93 \" أَمَرَنَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ نَقْرَأَ فَاتِحَةَ الْكِتَابِ وَمَا تَيَسَّرَ \" \r\n$887  886 /3",
      "sanad_ar": "وَقَالَ أَبُو مُعَاوِيَة",
      "matn_ar": "طريف بْن سَعْد وَقَالَ /26 جَعْفَر بْن حيان /26 عَنِ /26 ابْن شهاب /26 ، أَبُو سُفْيَان . يَرْوِي عَنِ /26 الْحَسَن /26 ، /26 وَأَبِي نضرة /26 ، ليس بالقوي عندهم . وقال ابن فضيل عَنْ /26 أَبِي سُفْيَانَ /26 ، عَنْ /26 أَبِي نَضْرَةَ /26 ، عَنْ /93 أَبِي سَعِيدٍ /93 \" أَمَرَنَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ نَقْرَأَ فَاتِحَةَ الْكِتَابِ وَمَا تَيَسَّرَ \" \r\n$887  886 /3",
      "grade": null,
      "page_number": null,
