      "chapter_id": null,
      "hadith_number": 3186,
      "text_ar": "وكَانَ عالم بني عامر بْن صعصعة ، أن ربيعة بْن عامر بْن مالك مرسل ، قاله إِسْمَاعِيل ، عَنْ أَبِيه ، عَنْ بْن إِسْحَاق ، عَنِ الزُّهْرِيّ ، عَنْ خَالِد .",
      "sanad_ar": "وكَانَ عالم بني عامر بْن صعصعة",
      "matn_ar": "أن ربيعة بْن عامر بْن مالك مرسل ، قاله إِسْمَاعِيل ، عَنْ أَبِيه ، عَنْ بْن إِسْحَاق ، عَنِ الزُّهْرِيّ ، عَنْ خَالِد .",
