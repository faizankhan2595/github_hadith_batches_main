    {
      "hadith_id": 182112,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 3344,
      "text_ar": "عَنْ سَعِيد بْن المسيب ، وعن شقيق بْن ثور ، روى عنهُ مَعمَر ، وقاسم بْن فياض ، قَالَ أَحْمَد عَنْ عَبْد الرزاق ، عَنْ مَعمَر : ما رأيت أحدا بصنعاء إلا هو يثبج إلا خلاد بْن عَبْد الرَّحْمَن . وقال عَبْد الرزاق : هو من الأبْناء .",
      "sanad_ar": "عَنْ سَعِيد بْن المسيب",
      "matn_ar": "وعن شقيق بْن ثور ، روى عنهُ مَعمَر ، وقاسم بْن فياض ، قَالَ أَحْمَد عَنْ عَبْد الرزاق ، عَنْ مَعمَر : ما رأيت أحدا بصنعاء إلا هو يثبج إلا خلاد بْن عَبْد الرَّحْمَن . وقال عَبْد الرزاق : هو من الأبْناء .",
      "grade": null,
