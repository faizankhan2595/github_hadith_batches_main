    {
      "hadith_id": 182713,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 3945,
      "text_ar": "حجازي ، قَالَ إِبْرَاهِيم بْن المنذر : حدثنا خالي مُحَمَّد بْن إِبْرَاهِيم ، عَنْ راشد بْن حفص بْن عُمَر بْن عَبْد الرَّحْمَن بْن عوف ، كَانَ جدي من قبل أمي يدعني فِي الجاهلية ظالما ، فقال النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اسمك راشد ، قَالَ راشد بْن حفص : سمتني أمي ، باسم جدها",
      "sanad_ar": "حجازي",
      "matn_ar": "قَالَ إِبْرَاهِيم بْن المنذر : حدثنا خالي مُحَمَّد بْن إِبْرَاهِيم ، عَنْ راشد بْن حفص بْن عُمَر بْن عَبْد الرَّحْمَن بْن عوف ، كَانَ جدي من قبل أمي يدعني فِي الجاهلية ظالما ، فقال النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اسمك راشد ، قَالَ راشد بْن حفص : سمتني أمي ، باسم جدها",
