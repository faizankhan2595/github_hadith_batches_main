    {
      "hadith_id": 181237,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 2469,
      "text_ar": "@ 3 : 28 @   سمِعَ ثابتا ، وأيوب . قَالَ ابْن أَبِي الأسود : مات سنة تسع وسبعين ومائة . قَالَ عارم : قَالَ ابْن المبارك : أيها الطالب علما ائت حماد بْن زيد فاقتبس علما بحلم ثم قيده بقيد وقال سُلَيْمَان بْن حرب قَالَ أَبُو النعمان قالت أم حماد بْن زيد وعمته قالت إحداهما : إِنَّهُ ولد فِي زمان سُلَيْمَان بْن عَبْد الملك . وقالت الأخرى : فِي زمان عُمَر بْن عَبْد العزيز . وقال سُلَيْمَان : بين حماد ، وبين مالك بْن أنس سنة أو سنتان . وروى إِبْرَاهِيم بْن طهمان ، عَنْ حماد ، عَنِ النعمان ، عَنِ الزُّهْرِيّ ، عَنِ النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فِي صدقة الفطر\u001bE442",
      "sanad_ar": "@ 3",
      "matn_ar": "28 @   سمِعَ ثابتا ، وأيوب . قَالَ ابْن أَبِي الأسود : مات سنة تسع وسبعين ومائة . قَالَ عارم : قَالَ ابْن المبارك : أيها الطالب علما ائت حماد بْن زيد فاقتبس علما بحلم ثم قيده بقيد وقال سُلَيْمَان بْن حرب قَالَ أَبُو النعمان قالت أم حماد بْن زيد وعمته قالت إحداهما : إِنَّهُ ولد فِي زمان سُلَيْمَان بْن عَبْد الملك . وقالت الأخرى : فِي زمان عُمَر بْن عَبْد العزيز . وقال سُلَيْمَان : بين حماد ، وبين مالك بْن أنس سنة أو سنتان . وروى إِبْرَاهِيم بْن طهمان ، عَنْ حماد ، عَنِ النعمان ، عَنِ الزُّهْرِيّ ، عَنِ النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فِي صدقة الفطر\u001bE442",
