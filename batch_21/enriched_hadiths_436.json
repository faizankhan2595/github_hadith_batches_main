    {
      "hadith_id": 186540,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 7772,
      "text_ar": "عَنْ عَبْد الرَّحْمَن بْن أَبِي أمية . روى عَنْهُ حيوة . وقَالَ حرملة : هو السليحي ، وهم إلى قضاعة . سَمِعَ أباه . وروى سَعِيد بْن أَبِي أيوب ، عَنْ عَبْد العزيز بْن عَبْد الملك ، عَنْ نبيه بْن صؤاب ، في الْمِصْرِيّين .\u001bE990",
      "sanad_ar": "عَنْ عَبْد الرَّحْمَن بْن أَبِي أمية . روى عَنْهُ حيوة . وقَالَ حرملة",
      "matn_ar": "هو السليحي ، وهم إلى قضاعة . سَمِعَ أباه . وروى سَعِيد بْن أَبِي أيوب ، عَنْ عَبْد العزيز بْن عَبْد الملك ، عَنْ نبيه بْن صؤاب ، في الْمِصْرِيّين .\u001bE990",
