    {
      "hadith_id": 182170,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 3402,
      "text_ar": "مولى أَبِي الدرداء قَالَ أَبُو عاصم : عَنِ الأوزاعي ، عَنْ عثمان بْن أَبِي سودة ، عَنْ خَالِد ، عَنْ أم الدرداء : ما أبالي لو صليت على خمس طنافس . وقال ابْن المبارك : عَنِ الأوزاعي ، عَنْ عثمان ، حدثني خليد ، أن أبا الدرداء . وقال هشام بْن عمار : حدثنا يحيى بْن حمزة ، قَالَ : نا عطاء الخراساني ، عَنْ خليد السلامي ، عَنْ أم الدرداء ، فِي المغرب ، وروى عنهُ طلحة بْن نافع قوله ، هو الْأَنْصَارِيّ ، يعد فِي الشاميين .",
      "sanad_ar": "مولى أَبِي الدرداء قَالَ أَبُو عاصم",
      "matn_ar": "عَنِ الأوزاعي ، عَنْ عثمان بْن أَبِي سودة ، عَنْ خَالِد ، عَنْ أم الدرداء : ما أبالي لو صليت على خمس طنافس . وقال ابْن المبارك : عَنِ الأوزاعي ، عَنْ عثمان ، حدثني خليد ، أن أبا الدرداء . وقال هشام بْن عمار : حدثنا يحيى بْن حمزة ، قَالَ : نا عطاء الخراساني ، عَنْ خليد السلامي ، عَنْ أم الدرداء ، فِي المغرب ، وروى عنهُ طلحة بْن نافع قوله ، هو الْأَنْصَارِيّ ، يعد فِي الشاميين .",
