    {
      "hadith_id": 183869,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 5101,
      "text_ar": "قَالَه : مُحَمَّد بْن صباح ، نا سيف بْن مُحَمَّد بْن أخت سُفْيَان الثَّوْرِيّ ، عَنْ عاصم ، عَنْ أَبِي عثمان \" كنت مَعَ جرير بْن عَبْد اللَّه \" . فذكر حديثا فِي دلجة وصراة لا يتابع عليه ، وهو أخو عمار بْن مُحَمَّد ضعفه أَحْمَد .",
      "sanad_ar": "قَالَه",
      "matn_ar": "مُحَمَّد بْن صباح ، نا سيف بْن مُحَمَّد بْن أخت سُفْيَان الثَّوْرِيّ ، عَنْ عاصم ، عَنْ أَبِي عثمان \" كنت مَعَ جرير بْن عَبْد اللَّه \" . فذكر حديثا فِي دلجة وصراة لا يتابع عليه ، وهو أخو عمار بْن مُحَمَّد ضعفه أَحْمَد .",
