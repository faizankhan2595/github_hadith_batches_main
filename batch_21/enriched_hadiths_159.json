    {
      "hadith_id": 182380,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 3612,
      "text_ar": "، عَنْ عكرمة ، روى عنهُ شريك ، قَالَ عَبْد اللَّه العبسي : حدثنا ابْن نمير عَنْ سفيان ، قَالَ : حدثنا أَبُو الجحاف ، وكَانَ مرضيا ، وقال عَبْد اللَّه بْن سعد الأشج : سألت أبا نعيم عنهُ ، فقال : مولى لبْني تميم .",
      "sanad_ar": "",
      "matn_ar": "عَنْ عكرمة ، روى عنهُ شريك ، قَالَ عَبْد اللَّه العبسي : حدثنا ابْن نمير عَنْ سفيان ، قَالَ : حدثنا أَبُو الجحاف ، وكَانَ مرضيا ، وقال عَبْد اللَّه بْن سعد الأشج : سألت أبا نعيم عنهُ ، فقال : مولى لبْني تميم .",
