      "hadith_id": 181296,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 2528,
      "text_ar": "أراه الشيباني ، عَنْ سَعِيد بْن جُبَيْر ، روى عنه جَابِر بْن يزيد بْن رفاعة ، قَالَ حسين ، حدثنا أَبُو قدامة ، قَالَ : حدثنا عَبْد الرَّحْمَن ، قَالَ : حدثنا جَابِر بْن يزيد ، عَنْ حسان بْن مخارق أَبِي العوام ، حدثنا عبدة ، قَالَ : حدثنا عَبْد الصمد ، قَالَ : حدثنا حرب بْن شداد ، عَنْ حصين ، عَنْ حسان بْن أَبِي المخارق ، عَنْ أَبِي عَبْد اللَّه .",
      "sanad_ar": "أراه الشيباني",
      "matn_ar": "عَنْ سَعِيد بْن جُبَيْر ، روى عنه جَابِر بْن يزيد بْن رفاعة ، قَالَ حسين ، حدثنا أَبُو قدامة ، قَالَ : حدثنا عَبْد الرَّحْمَن ، قَالَ : حدثنا جَابِر بْن يزيد ، عَنْ حسان بْن مخارق أَبِي العوام ، حدثنا عبدة ، قَالَ : حدثنا عَبْد الصمد ، قَالَ : حدثنا حرب بْن شداد ، عَنْ حصين ، عَنْ حسان بْن أَبِي المخارق ، عَنْ أَبِي عَبْد اللَّه .",
