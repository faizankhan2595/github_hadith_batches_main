    {
      "hadith_id": 180809,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 2041,
      "text_ar": ". قَالَ مُحَمَّد بْن معمَر حَدَّثَنَا حميد بْن حماد بْن أَبِي الخوار ، وَقَالَ مَحْمُود ثنا حميد بْن حماد ، قَالَ : ثنا الأعمش ، عَنْ أَبِي وائل ، قَالَ : قدم علينا مصدق النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فأخرجنا لَهُ شاة ، فَقَالَ : لم يأمرني النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أن آخذ فحل شاة مُسْلِم . وسمع حمزة الزيات ، وتغلب بنت الخوار ، وعائذ بْن شريح ، والأعمش . كنيته : أَبُو الجهم الكوفي .\u001cE417",
      "sanad_ar": ". قَالَ مُحَمَّد بْن معمَر حَدَّثَنَا حميد بْن حماد بْن أَبِي الخوار",
