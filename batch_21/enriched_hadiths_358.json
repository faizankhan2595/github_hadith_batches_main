    {
      "hadith_id": 185368,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 6600,
      "text_ar": "مولى عَبْد اللَّه بْن عُمَر بْن الْخَطَّاب العدوي الْقُرَشِيّ الْمَدَنِيّ . سمع أباه . سمع منه : ابْن المبارك ، والوليد بْن مُسْلِم ، وقتيبة هو أخو أسامة ، وعبد الرَّحْمَن ، ولا يصح حديث عَبْد الرَّحْمَن .",
      "sanad_ar": "مولى عَبْد اللَّه بْن عُمَر بْن الْخَطَّاب العدوي الْقُرَشِيّ الْمَدَنِيّ . سمع أباه . سمع منه",
      "matn_ar": "ابْن المبارك ، والوليد بْن مُسْلِم ، وقتيبة هو أخو أسامة ، وعبد الرَّحْمَن ، ولا يصح حديث عَبْد الرَّحْمَن .",
