    {
      "hadith_id": 182821,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 4053,
      "text_ar": "الكندي الشامي الفلسطيني قَالَ ابْن المثنى : عَنْ معاذ ، عَنْ بْن عون ، قَالَ رجاء : نحدث كما نسمع ، سَمِعَ مَحْمُود بْن الربيع ومعاوية ، وقال ابْن المثنى : حدثنا قريش بْن أنس ، عَنْ بْن عون ، عَنْ رجاء أَبِي المقدام ، قِيلَ لرجاء بْن حيوة : مالك لا تأتي السلطان ؟ وكَانَ يقعد عنهُم ، قَالَ : يكفيني الَّذِي تركتهم لَهُ ، وقال ابْن أَبِي الأسود : حدثنا ابْن مهدي ، عَنْ شُعْبَة ، عَنِ الحكم ، كَانَ   @ 3 : 267 @    رجاء بْن حيوة قاصا ، وقال عَمْرو بْن خَالِد ، حدثنا عُبَيْد اللَّه بْن عَمْرو ، عَنْ عَبْد الملك ابْن عمير ، أتاني رجاء بْن حيوة ، فقال : إن الأمير أمرني أن أصلي بالناس فما تأمرني ؟ قلت : أحدثك بما حدثني أصحاب عِنْدَ اللَّه ، قَالَ : حسبي ، فأخبرته ، قَالَ عَبْد الملك : فلقيني الشَّعْبِيّ ، فأخذ بيدي فحلف باللَّه أَنَّهُ لفعل عَبْد اللَّه ، وأصحابه بالتكبير ، وقدم الكوفة .",
      "sanad_ar": "الكندي الشامي الفلسطيني قَالَ ابْن المثنى",
      "matn_ar": "عَنْ معاذ ، عَنْ بْن عون ، قَالَ رجاء : نحدث كما نسمع ، سَمِعَ مَحْمُود بْن الربيع ومعاوية ، وقال ابْن المثنى : حدثنا قريش بْن أنس ، عَنْ بْن عون ، عَنْ رجاء أَبِي المقدام ، قِيلَ لرجاء بْن حيوة : مالك لا تأتي السلطان ؟ وكَانَ يقعد عنهُم ، قَالَ : يكفيني الَّذِي تركتهم لَهُ ، وقال ابْن أَبِي الأسود : حدثنا ابْن مهدي ، عَنْ شُعْبَة ، عَنِ الحكم ، كَانَ   @ 3 : 267 @    رجاء بْن حيوة قاصا ، وقال عَمْرو بْن خَالِد ، حدثنا عُبَيْد اللَّه بْن عَمْرو ، عَنْ عَبْد الملك ابْن عمير ، أتاني رجاء بْن حيوة ، فقال : إن الأمير أمرني أن أصلي بالناس فما تأمرني ؟ قلت : أحدثك بما حدثني أصحاب عِنْدَ اللَّه ، قَالَ : حسبي ، فأخبرته ، قَالَ عَبْد الملك : فلقيني الشَّعْبِيّ ، فأخذ بيدي فحلف باللَّه أَنَّهُ لفعل عَبْد اللَّه ، وأصحابه بالتكبير ، وقدم الكوفة .",
