      "hadith_id": 184793,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 6025,
      "text_ar": "سَمِعَ أبا مُوسَى ، وعبد الرَّحْمَن بْن غنم ، روى عَنْهُ مكحول ، ويقَالَ : ابْن عرزم . حَدَّثَنَا /93 إِسْمَاعِيل /93 ، عَنْ /26 أخيه /26 ، عَنْ /26 سُلَيْمَان /26 ، عَنْ /26 يَحْيَى بْن سَعِيد /26 ، /26 وصالح بْن عجلان /26 \" هذا نسخة كتاب عُمَر بْن عَبْد العزيز أَنَّ الضحاك بْن عثمان بْن عرزم عامل دمشق \" . \r\n$874  873 /2",
      "sanad_ar": "سَمِعَ أبا مُوسَى",
      "matn_ar": "وعبد الرَّحْمَن بْن غنم ، روى عَنْهُ مكحول ، ويقَالَ : ابْن عرزم . حَدَّثَنَا /93 إِسْمَاعِيل /93 ، عَنْ /26 أخيه /26 ، عَنْ /26 سُلَيْمَان /26 ، عَنْ /26 يَحْيَى بْن سَعِيد /26 ، /26 وصالح بْن عجلان /26 \" هذا نسخة كتاب عُمَر بْن عَبْد العزيز أَنَّ الضحاك بْن عثمان بْن عرزم عامل دمشق \" . \r\n$874  873 /2",
