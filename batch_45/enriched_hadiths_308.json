    {
      "hadith_id": 400610,
      "book_id": 362,
      "chapter_id": null,
      "hadith_number": 214,
      "text_ar": "، حَدَّثَنَا /94 أَحْمَدُ بْنُ عِصَامٍ /94 ، حَدَّثَنَا /26 أَبُو بَكْرٍ الْحَنَفِيُّ /26 ، حَدَّثَنَا /26 سُفْيَانُ /26 ، حَدَّثَنَا /26 أَبُو إِسْحَاقَ /26 ، عَنْ /26 عَمْرِو بْنِ حَزْمٍ /26 ، قَالَ : /27 سَمِعْتُ /93 ابْنَ عَبَّاسٍ L4883 /93 يَقْرَءُوهَا :   @ 1 : 354 @   /20 \" /90 فَمَا اسْتَمْتَعْتُمْ بِهِ مِنْهُنَّ إِلَى أَجَلٍ مُسَمًّى /90 \" /27 قَالَ عَبْدُ اللَّهِ بْنُ أَبِي دَاوُدَ : أَخْطَأَ أَبُو بَكْرٍ الْحَنَفِيُّ فِي قَوْلِهِ : عَمْرُو بْنُ حَزْمٍ ، إِنَّمَا هُوَ # عَمْرُو # بْنُ يَرِيمَ ، مَكَانُ حَزْمٍ \" * \r\n@ 1 : 355 @   @ 1 : 356 @   @ 1 : 357 @ \r\n$189  189 /3",
      "sanad_ar": "",
      "matn_ar": "حَدَّثَنَا /94 أَحْمَدُ بْنُ عِصَامٍ /94 ، حَدَّثَنَا /26 أَبُو بَكْرٍ الْحَنَفِيُّ /26 ، حَدَّثَنَا /26 سُفْيَانُ /26 ، حَدَّثَنَا /26 أَبُو إِسْحَاقَ /26 ، عَنْ /26 عَمْرِو بْنِ حَزْمٍ /26 ، قَالَ : /27 سَمِعْتُ /93 ابْنَ عَبَّاسٍ L4883 /93 يَقْرَءُوهَا :   @ 1 : 354 @   /20 \" /90 فَمَا اسْتَمْتَعْتُمْ بِهِ مِنْهُنَّ إِلَى أَجَلٍ مُسَمًّى /90 \" /27 قَالَ عَبْدُ اللَّهِ بْنُ أَبِي دَاوُدَ : أَخْطَأَ أَبُو بَكْرٍ الْحَنَفِيُّ فِي قَوْلِهِ : عَمْرُو بْنُ حَزْمٍ ، إِنَّمَا هُوَ # عَمْرُو # بْنُ يَرِيمَ ، مَكَانُ حَزْمٍ \" * \r\n@ 1 : 355 @   @ 1 : 356 @   @ 1 : 357 @ \r\n$189  189 /3",
