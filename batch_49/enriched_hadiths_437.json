    {
      "hadith_id": 438543,
      "book_id": 388,
      "chapter_id": null,
      "hadith_number": 656,
      "text_ar": "حَدَّثَنَا /94 عَلِيُّ بْنُ الْحَسَنِ /94 ، ثنا /26 أَحْمَدُ بْنُ سَعِيدٍ الدَّارِمِيُّ /26 ، نا /26 النَّضْرُ /26 ، نا /26 شُعْبَةُ /26 ، عَنِ /26 الْحَكَمِ /26 ، /27 عَنْ /26 ابْنِ أَبِي لَيْلَى /26 ، قَالَ : /20 \" وُلِدْتُ لَسَتٍّ بَقَيْنَ مِنْ خِلَافَةِ عُمَرَ رَضِيَ اللَّهُ عَنْهُ \" /27 *",
      "sanad_ar": "حَدَّثَنَا /94 عَلِيُّ بْنُ الْحَسَنِ /94",
      "matn_ar": "ثنا /26 أَحْمَدُ بْنُ سَعِيدٍ الدَّارِمِيُّ /26 ، نا /26 النَّضْرُ /26 ، نا /26 شُعْبَةُ /26 ، عَنِ /26 الْحَكَمِ /26 ، /27 عَنْ /26 ابْنِ أَبِي لَيْلَى /26 ، قَالَ : /20 \" وُلِدْتُ لَسَتٍّ بَقَيْنَ مِنْ خِلَافَةِ عُمَرَ رَضِيَ اللَّهُ عَنْهُ \" /27 *",
      "grade": null,
