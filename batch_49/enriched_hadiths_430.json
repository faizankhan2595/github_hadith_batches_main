      "hadith_id": 438437,
      "book_id": 388,
      "chapter_id": null,
      "hadith_number": 550,
      "text_ar": "أَخْبَرَنَا /94 عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ /94 فِيمَا كَتَبَ إِلَيَّ حَدَّثَنِي /26 أَبِي /26 ، نا /26 مُحَمَّدُ بْنُ عَبْدِ اللَّهِ الْأَنْصَارِيِّ /26 ، نا /26 عَوْفُ بْنُ أَبِي جَمِيلَةَ الْأَعْرَابِيِّ /26 ، حَدَّثَنِي /26 عَبْدُ اللَّهِ بْنُ عَمْرٍو بْنِ هِنْدَ الْجَمَلِيُّ /26 , /27 أَنَّ /26 عَلِيًا /26 قَالَ : /20 \" عَوْفٌ وَلَمْ يَسْمَعْهُ ، يَعْنِي عَبْدَ اللَّهِ بْنَ عَمْرٍو بْنِ هِنْدَ الْجَمَلِيَّ مِنْ عَلِيٍّ رَضِيَ اللَّهُ عَنْهُ \" /27 *",
      "sanad_ar": "أَخْبَرَنَا /94 عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ /94 فِيمَا كَتَبَ إِلَيَّ حَدَّثَنِي /26 أَبِي /26",
      "matn_ar": "نا /26 مُحَمَّدُ بْنُ عَبْدِ اللَّهِ الْأَنْصَارِيِّ /26 ، نا /26 عَوْفُ بْنُ أَبِي جَمِيلَةَ الْأَعْرَابِيِّ /26 ، حَدَّثَنِي /26 عَبْدُ اللَّهِ بْنُ عَمْرٍو بْنِ هِنْدَ الْجَمَلِيُّ /26 , /27 أَنَّ /26 عَلِيًا /26 قَالَ : /20 \" عَوْفٌ وَلَمْ يَسْمَعْهُ ، يَعْنِي عَبْدَ اللَّهِ بْنَ عَمْرٍو بْنِ هِنْدَ الْجَمَلِيَّ مِنْ عَلِيٍّ رَضِيَ اللَّهُ عَنْهُ \" /27 *",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/94,/94,/26,/26,/26,/26,/26,/26,/26,/26,/27,/26,/26,/20,/27",
