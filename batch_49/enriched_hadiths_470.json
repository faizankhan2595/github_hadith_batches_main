      "book_id": 388,
      "chapter_id": null,
      "hadith_number": 1150,
      "text_ar": "حَدَّثَنَا /94 مُحَمَّدُ بْنُ حَمَوَيْهَ /94 ، قَالَ : سَمِعْتُ /26 أَبَا طَالِبٍ /26 ، قَالَ : /27 قَالَ /26 أَحْمَدُ بْنُ حَنْبَلٍ /26 : /20 \" مَكْحُولٌ لَمْ يَسْمَعْ مِنْ زَيْدٍ شَيْئًا إِنَّمَا هُوَ بَلَغَهُ \" /27 * \r\n$794  794 /8",
      "sanad_ar": "حَدَّثَنَا /94 مُحَمَّدُ بْنُ حَمَوَيْهَ /94",
      "matn_ar": "قَالَ : سَمِعْتُ /26 أَبَا طَالِبٍ /26 ، قَالَ : /27 قَالَ /26 أَحْمَدُ بْنُ حَنْبَلٍ /26 : /20 \" مَكْحُولٌ لَمْ يَسْمَعْ مِنْ زَيْدٍ شَيْئًا إِنَّمَا هُوَ بَلَغَهُ \" /27 * \r\n$794  794 /8",
