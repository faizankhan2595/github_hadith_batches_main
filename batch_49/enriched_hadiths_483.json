    {
      "hadith_id": 439240,
      "book_id": 388,
      "chapter_id": null,
      "hadith_number": 1353,
      "text_ar": "/27 سَأَلْتُ /94 أَبِي /94 : عَنْ /20 يَحْيَى بْنِ رَاشِدٍ عَنِ الْحَسَنِ هَلْ سَمِعَ مِنَ الْحَسَنِ ؟ قَالَ : \" لَا إِنَّمَا يَرْوِي عَنْ يُونُسَ عَنِ الْحَسَنِ \" ، قَالَ أَبِي : \" لَمْ يُدْرِكِ الْحَسَنَ \" /27 *",
