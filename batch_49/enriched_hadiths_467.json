    {
      "hadith_id": 438993,
      "book_id": 388,
      "chapter_id": null,
      "hadith_number": 1106,
      "text_ar": "قُرِئَ عَلَى /94 الْعَبَّاسِ بْنِ مُحَمَّدٍ الدُّورِيِّ /94 ، قَالَ : /27 قِيلَ /26 لِيَحْيَى بْنِ مَعِينٍ /26 : /20 يُرْوَي عَنْ مُجَاهِدٍ أَنَّهُ قَالَ : \" خَرَجَ عَلَيْنَا عَلِيٌّ رَضِيَ اللَّهُ عَنْهُ , فَقَالَ : لَيْسَ هَذَا بِشَيءٍ \" /27 * \r\n$759  759 /8",
      "sanad_ar": "قُرِئَ عَلَى /94 الْعَبَّاسِ بْنِ مُحَمَّدٍ الدُّورِيِّ /94",
      "matn_ar": "قَالَ : /27 قِيلَ /26 لِيَحْيَى بْنِ مَعِينٍ /26 : /20 يُرْوَي عَنْ مُجَاهِدٍ أَنَّهُ قَالَ : \" خَرَجَ عَلَيْنَا عَلِيٌّ رَضِيَ اللَّهُ عَنْهُ , فَقَالَ : لَيْسَ هَذَا بِشَيءٍ \" /27 * \r\n$759  759 /8",
