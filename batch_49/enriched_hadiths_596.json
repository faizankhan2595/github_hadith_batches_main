      "hadith_id": 440927,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 1204,
      "text_ar": "حَدَّثَنَا /94 مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ يَزِيدَ الْمُقْرِئُ /94 ، ثنا /26 سُفْيَانُ /26 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، /27 عَنْ /26 عَطَاءٍ /26 ، قَالَ : \" /20 الذَّبْحُ وَالنَّحْرُ فِي الْبَقَرِ سَوَاءٌ ، لأَنَّ اللَّهَ عَزَّ وَجَلَّ يَقُولُ : /4 فَذَبَحُوهَا سورة البقرة آية 71 /4 \" /27 ، وَرُوِيَ عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ نَحْوُ ذَلِكَ * \r\n$740  740 /8",
      "sanad_ar": "حَدَّثَنَا /94 مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ يَزِيدَ الْمُقْرِئُ /94",
      "matn_ar": "ثنا /26 سُفْيَانُ /26 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، /27 عَنْ /26 عَطَاءٍ /26 ، قَالَ : \" /20 الذَّبْحُ وَالنَّحْرُ فِي الْبَقَرِ سَوَاءٌ ، لأَنَّ اللَّهَ عَزَّ وَجَلَّ يَقُولُ : /4 فَذَبَحُوهَا سورة البقرة آية 71 /4 \" /27 ، وَرُوِيَ عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ نَحْوُ ذَلِكَ * \r\n$740  740 /8",
      "grade": null,
