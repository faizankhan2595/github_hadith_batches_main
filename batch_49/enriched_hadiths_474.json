      "chapter_id": null,
      "hadith_number": 1217,
      "text_ar": "أَخْبَرَنَا /94 عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ /94 ، فِيمَا كَتَبَ إِلَيَّ بِهِ نا /26 أَبِي /26 ، نا /26 وَكِيعٌ /26 ، عَنْ /26 مَالِكِ بْنِ أَنَسٍ /26 ، /27 عَنْ /26 بُكَيْرِ بْنِ عَبْدِ اللَّهِ بْنِ الْأَشْجِّ /26 قَالَ /26 أَبِي /26 : /20 \" لَمْ يَسْمَعْ مَالِكُ مِنْ بُكَيْرِ بْنِ عَبْدِ اللَّهِ بْنِ الْأَشَجِّ \" /27 * \r\n\u001cE103",
      "sanad_ar": "أَخْبَرَنَا /94 عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ /94",
      "matn_ar": "فِيمَا كَتَبَ إِلَيَّ بِهِ نا /26 أَبِي /26 ، نا /26 وَكِيعٌ /26 ، عَنْ /26 مَالِكِ بْنِ أَنَسٍ /26 ، /27 عَنْ /26 بُكَيْرِ بْنِ عَبْدِ اللَّهِ بْنِ الْأَشْجِّ /26 قَالَ /26 أَبِي /26 : /20 \" لَمْ يَسْمَعْ مَالِكُ مِنْ بُكَيْرِ بْنِ عَبْدِ اللَّهِ بْنِ الْأَشَجِّ \" /27 * \r\n\u001cE103",
