    {
      "hadith_id": 438356,
      "book_id": 388,
      "chapter_id": null,
      "hadith_number": 469,
      "text_ar": "/27 سُئِلَ /94 أَبُو زُرْعَةَ /94 عَنْ الْحَدِيثِ الَّذِي رَوَاهُ إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ الْجُدْعَانِيِّ ، عَنْ سُلَيْمَانَ بْنِ مُرْقَاعٍ الْجُنَدِيِّ ، عَنْ هِلَالٍ ، عَنْ الصَّلْتِ ، عَنْ أَبِي بَكْرٍ الصِّدِّيقِ ؟ فَقَالَ أَبُو زُرْعَةَ : /20 \" الصَّلْتُ ، عَنْ أَبِي بَكْرٍ ُمْرَسٌل \" /27 *",
      "sanad_ar": "/27 سُئِلَ /94 أَبُو زُرْعَةَ /94 عَنْ الْحَدِيثِ الَّذِي رَوَاهُ إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ",
      "matn_ar": "عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ الْجُدْعَانِيِّ ، عَنْ سُلَيْمَانَ بْنِ مُرْقَاعٍ الْجُنَدِيِّ ، عَنْ هِلَالٍ ، عَنْ الصَّلْتِ ، عَنْ أَبِي بَكْرٍ الصِّدِّيقِ ؟ فَقَالَ أَبُو زُرْعَةَ : /20 \" الصَّلْتُ ، عَنْ أَبِي بَكْرٍ ُمْرَسٌل \" /27 *",
