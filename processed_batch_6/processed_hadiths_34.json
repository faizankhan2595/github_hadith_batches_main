      "plainChains": [
        "ابْنُ التَّيْمِيِّ -> : أَخْبَرَنِي خَلِيلُ بْنُ أَحْمَدَ -> : حَدَّثَنِي عُثْمَانُ بْنُ أَبِي حَاضِرٍ -> لِي ابْنُ عَبَّاسٍ -> : \" حَامِيَةٍ \" -> : \" أَنْتُمْ أَعْلَمُ بِالْعَرَبِيَّةِ مِنِّي -> : \" فِي حَمَأَةٍ \" -> خَلِيلٌ الَّذِي شَكَّ -> : أَلا أُنْشِدُكَ قَصِيدَةَ تُبَّعٍ"
      ],
      "potential_issues": [],
      "IISGrade": "Questionable But Might Be Acceptable",
      "Topics": [
        "Exegesis of Surah al-Kahf"
      ],
      "arabicText": "أرنا ابْنُ التَّيْمِيِّ , قَالَ : أَخْبَرَنِي خَلِيلُ بْنُ أَحْمَدَ , قَالَ : حَدَّثَنِي عُثْمَانُ بْنُ أَبِي حَاضِرٍ , قَالَ لِي ابْنُ عَبَّاسٍ : \" لَوْ رَأَيْتَ إِلَيَّ ، وَإِلَى مُعَاوِيَةَ , وَقَرَأْتُ : فِي عَيْنٍ حَمِئَةٍ سورة الكهف آية 86 ، فَقَالَ : \" حَامِيَةٍ \" ، فَدَخَلَ كَعْبٌ , فَسَأَلَهُ ، فَقَالَ : \" أَنْتُمْ أَعْلَمُ بِالْعَرَبِيَّةِ مِنِّي ، وَلَكِنَّهَا تَغْرُبُ فِي عَيْنٍ سَوْدَاءَ \" ، أَوْ قَالَ : \" فِي حَمَأَةٍ \" ، لا أَدْرِي أَيَّ ذَلِكَ , قَالَ خَلِيلٌ الَّذِي شَكَّ , فَقَالَ : أَلا أُنْشِدُكَ قَصِيدَةَ تُبَّعٍ : قَدْ كَانَ ذُو الْقَرْنَيْنِ عَمِّي مُسْلِمًا مَلِكًا تَدِينُ لَهُ الْمُلُوكُ وَتَفْتَدِي فَأَتَى الْمَشَارِقَ وَالْمَغَارِبَ يَبْتَغِي أْسَبَابَ مُلْكٍ مِنْ حَكِيمٍ مُرْشِدِ فَرَأَى مَغِيبَ الشَّمْسِ عِنْدَ مَغَابِهَا فِي عَيْنِ ذِي خُلْبٍ وَثَأْطٍ حَرْمَدِ *",
      "collection": "كتاب رقم 59",
      "reference_number": 1655,
      "original_grade": null
