      "plainChains": [
        "ابْنُ الْمُبَارَكِ -> عَمْرِو بْنِ مَيْمُونِ بْنِ مِهْرَانَ -> عُثْمَانَ بْنِ أَبِي حَاضِرٍ نَحْوًا مِنْ هَذَا -> : فَ -> لَهُ ابْنُ عَبَّاسٍ -> : \" الطِّينُ بِلِسَانِهِمْ \" -> : \" فَمَا الثَّأْطُ ؟ \" -> : \" الْحَمَأَةُ \" -> : \" فَمَا الْحَرْمَدُ ؟ \" -> : \" الشَّدِيدُ السَّوَادِ \" -> : \" يَا غُلامُ ائْتِنِي بِالدَّوَاةِ \""
      ],
      "potential_issues": [],
      "IISGrade": "Questionable But Might Be Acceptable",
      "Topics": [
