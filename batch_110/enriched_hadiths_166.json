      "chapter_id": null,
      "hadith_number": 267,
      "text_ar": "/27 /20 ظُلْمٌ دُونَ ظُلْمٍ /27 : تَرْجَمَ بِهِ الْبُخَارِيُّ ، فَقَالَ : بَابُ ظُلْمٍ دُونَ ظُلْمٍ ، وَلَمْ يُورِدْهُ حَدِيثًا , لَكِنْ جَاءَ عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ فِي قَوْلِهِ ، تَعَالَى : /4 وَمَنْ لَمْ يَحْكُمْ بِمَا أَنْزَلَ اللَّهُ سورة المائدة آية 44 /4 ، قَالَ : كُفْرٌ دُونَ كُفْرٍ ، وَظُلْمٌ دُونَ ظُلْمٍ ، وَفِسْقٌ دُونَ فِسْقٍ * \r\n$261  -10 /2",
      "sanad_ar": "/27 /20 ظُلْمٌ دُونَ ظُلْمٍ /27",
      "matn_ar": "تَرْجَمَ بِهِ الْبُخَارِيُّ ، فَقَالَ : بَابُ ظُلْمٍ دُونَ ظُلْمٍ ، وَلَمْ يُورِدْهُ حَدِيثًا , لَكِنْ جَاءَ عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ فِي قَوْلِهِ ، تَعَالَى : /4 وَمَنْ لَمْ يَحْكُمْ بِمَا أَنْزَلَ اللَّهُ سورة المائدة آية 44 /4 ، قَالَ : كُفْرٌ دُونَ كُفْرٍ ، وَظُلْمٌ دُونَ ظُلْمٍ ، وَفِسْقٌ دُونَ فِسْقٍ * \r\n$261  -10 /2",
