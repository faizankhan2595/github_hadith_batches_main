    {
      "hadith_id": 1003693,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 13139,
      "text_ar": "0 /11 إبراهيم بن طهمان /11 /11 وإسماعيل ابن علية /11 /11 وجرير بن خازم ق /11 /11 والحارث بن نبهان /11 /11 وحماد بن زيد /11 /11 وحماد بن سلمة /11 /11 وخالد بن عَبْد اللَّهِ الواسطي /11 /11 وسعيد بن أبي عروبة /11 /11 وشعبة بن الحجاج /11 /11 وعباد بن العوام /11 /11 وعَبْد اللَّهِ بن المبارك ت /11 /11 وعبد الملك بن الخطاب بن عبيد الله بن أبي بكرة /11 /11 وعبد الوارث بن سعيد /11 /11 وعثمان بن مطر الشيباني /11 /11 وعلي بن عاصم /11 /11 ومُحَمَّد بن مروان العقيلي /11 /11 ومرجى بن رجاء /11 /11 ومروان بن معاوية الفزاري /11 /11 والمعلي بن زياد /11 /11 وهارون النحوي /11 /11 وهشام بن حسان /11 /11 ويوسف بن خالد السمتي /11 /11 وأَبُو إسحاق الفزاري /11 /11 وأَبُو بحر البكراوي /11 /11 وأَبُو بكر بن شعيب بن الحبحاب /11 /11 وأَبُو معاوية الضرير /11 /11 وأَبُو معشر البراء /11 /11 وأَبُو هلال الراسبي /11 ++ قال علي بن المديني : سمعت يحيى بن سعيد ، وذكر حنظلة السدوسي ، فَقَالَ : قد رأيته ، وتركته على عمد ، قلت ليحيى : كان قد اختلط ؟ قال : نعم # وقال",
      "sanad_ar": "0 /11 إبراهيم بن طهمان /11 /11 وإسماعيل ابن علية /11 /11 وجرير بن خازم ق /11 /11 والحارث بن نبهان /11 /11 وحماد بن زيد /11 /11 وحماد بن سلمة /11 /11 وخالد بن عَبْد اللَّهِ الواسطي /11 /11 وسعيد بن أبي عروبة /11 /11 وشعبة بن الحجاج /11 /11 وعباد بن العوام /11 /11 وعَبْد اللَّهِ بن المبارك ت /11 /11 وعبد الملك بن الخطاب بن عبيد الله بن أبي بكرة /11 /11 وعبد الوارث بن سعيد /11 /11 وعثمان بن مطر الشيباني /11 /11 وعلي بن عاصم /11 /11 ومُحَمَّد بن مروان العقيلي /11 /11 ومرجى بن رجاء /11 /11 ومروان بن معاوية الفزاري /11 /11 والمعلي بن زياد /11 /11 وهارون النحوي /11 /11 وهشام بن حسان /11 /11 ويوسف بن خالد السمتي /11 /11 وأَبُو إسحاق الفزاري /11 /11 وأَبُو بحر البكراوي /11 /11 وأَبُو بكر بن شعيب بن الحبحاب /11 /11 وأَبُو معاوية الضرير /11 /11 وأَبُو معشر البراء /11 /11 وأَبُو هلال الراسبي /11 ++ قال علي بن المديني",
      "matn_ar": "سمعت يحيى بن سعيد ، وذكر حنظلة السدوسي ، فَقَالَ : قد رأيته ، وتركته على عمد ، قلت ليحيى : كان قد اختلط ؟ قال : نعم # وقال",
      "grade": null,
