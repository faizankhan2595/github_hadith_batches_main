    {
      "hadith_id": 1000223,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 9669,
      "text_ar": "واسمه مُحَمَّد بْن عَبْدِ الرَّحْمَنِ بْن عَبْدِ اللَّهِ بْنِ حارثة بْن النعمان الأنصاري النجاري المدني . أخو عَبْد الرَّحْمَنِ بْن أبي الرجال ، ومالك بْن أبي الرجال ، وكَانَ جده حارثة بْن النعمان من أهل بدر . /10 عبيد اللَّه بْن أبي رافع /10 /10 وأبيه أبي الرجال /10 /10 وجدته أم أبيه عمرة بنت عَبْد الرَّحْمَنِ ت ق /10",
      "sanad_ar": "واسمه مُحَمَّد بْن عَبْدِ الرَّحْمَنِ بْن عَبْدِ اللَّهِ بْنِ حارثة بْن النعمان الأنصاري النجاري المدني . أخو عَبْد الرَّحْمَنِ بْن أبي الرجال",
      "matn_ar": "ومالك بْن أبي الرجال ، وكَانَ جده حارثة بْن النعمان من أهل بدر . /10 عبيد اللَّه بْن أبي رافع /10 /10 وأبيه أبي الرجال /10 /10 وجدته أم أبيه عمرة بنت عَبْد الرَّحْمَنِ ت ق /10",
