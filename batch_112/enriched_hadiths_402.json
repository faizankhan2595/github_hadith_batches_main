    {
      "hadith_id": 1005022,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 14468,
      "text_ar": "/10 إِبْرَاهِيم بْن ميمون الصائع /10 /10 وأبي هاشم إِسْمَاعِيل بْن كثير المكي بخ /10 /10 وداود بْن شابور /10 /10 وسليم بْن مسلم الخشاب المكي /10 /10 وطلحة بْن عَمْرٍو المكي /10 /10 وعَبْد اللَّهِ بْن عُثْمَانَ بْن خثيم د س /10 /10 وعَبْد اللَّهِ بْن المبارك وهو من أقرانه /10 /10 وعبد الملك بْن عبد العزيز بْن جريج د س /10 /10 وعبيد اللَّه بْن أبي يزيد /10 /10 وعثمان بْن عروة بْن الزبير /10 /10 وعمارة بْن عمر صاحب أيوب السختياني /10 /10 وعمرو بْن دينار ع /10 /10 وعمرو بْن يَحْيَى بْن عمارة د سي /10 /10 والقاسم بْن أبي بزة /10 /10 والقاسم بْن عبد الواحد /10 /10 ومحمد بْن طلحة بْن عَبْد اللَّهِ بْن عَبْد الرَّحْمَنِ بْن أَبِي بَكْرٍ الصديق /10 /10 ومزاحم بْن أبي مزاحم مولى طلحة /10 /10 ومعمر بْن راشد ت /10 /10 ومنصور بْن عَبْد الرَّحْمَنِ م وهو ابن صفية الحجبي /10 /10 وهشام بْن عروة د /10",
