    {
      "hadith_id": 1005774,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 15220,
      "text_ar": "سكن طرسوس . /10 إبراهيم بْن سعد د /10 /10 وأبي إسحاق إبراهيم بْن مُحَمَّد الفزاري د /10 /10 وإسماعيل بْن عياش د /10 /10 وبشير بْن طلحة الخشني /10 /10 وأبي المليح الحسن بْن عمر الرقي د /10 /10 والحسين بْن طلحة قد /10 /10 والحكم بْن ظهير /10 /10 وأبي أسامة حماد بْن أسامة /10 /10 والربيع بْن بدر السعدي /10 /10 وسعيد بْن عبد الرحمن الجمحي د /10 /10 وسفيان بْن عيينة /10 /10 وسليمان بْن حيان أبي خالد الأحمر د /10 /10 وشهاب بْن خراش /10 /10 وعبد الله بْن بكير الغنوي /10 /10 وعبد الله بْن المبارك د /10 /10 وعبد العزيز بْن عبد الملك القرشي د /10 /10 وعبيد الله بْن عمرو الرقي د /10 /10 وعطاء بْن مسلم الحلبي /10 /10 وعلي بْن حوشب /10 /10 وعلي بْن سليمان الكيساني /10 /10 وعيسى بْن يونس د /10 /10 ومُحَمَّد بْن عمر الطائي /10 /10 ومُحَمَّد بْن الفرات الجرمي /10 /10 ومُحَمَّد بْن المهاجر الدمشقي د /10 /10 ومسلمة بْن علي الخشني /10 /10 ومصعب بْن ماهان مد /10 /10 ومعاوية بْن سلام خ م د س ق /10 /10 ومعتمر بْن سليمان /10 /10 وهشام بْن يحيى بْن يحيى الغساني /10 /10 والهيثم بْن حميد د سي /10 /10 والوليد بْن مسلم د /10 /10 ويحيى بْن حمزة الحضرمي القاضي /10 /10 ويزيد بْن ربيعة الرحبي /10 /10 ويزيد بْن المقدام بْن شريح بْن هانئ د /10",
