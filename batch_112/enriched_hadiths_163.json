      "chapter_id": null,
      "hadith_number": 10880,
      "text_ar": "2 . روى له أَبُو دَاوُدَ حَدِيثًا واحِدًا ، ++ \r\n$508  -10 /2 /141 أخبرنا به /94 أَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ الْمُذْهِبِ L14991 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مَالِكٍ L8994 /26 ، قال : حدثنا /26عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657/26 ، قال : حَدَّثَنِي/26 أَبِي L488/26 ، قال : حدثنا /26 مُحَمَّدُ بْنُ رَبِيعَةَ L6965 /26 ، قال : حدثنا /26 مُحَمَّدُ بْنُ الْحَسَنِ بْنِ عَطِيَّةَ الْعَوْفِيُّ L6834 /26 ، عن /26 أَبِيهِ L1277 /26 ، عن /26 جَدِّهِ L5647/26 ، /27 عن /93 أَبِي سَعِيدٍ L3260 /93 ، قال : /20 \" لَعَنَ رَسُولُ اللَّهِ صلى الله عليه وسلم النَّائِحَةَ والْمُسْتَمِعَةَ \" /27 ، رواه عن إِبْرَاهِيم بْن موسى الفراء ، عن مُحَمَّد بْن ربيعة الكلاعي ، فوقع لنا بدلا عاليا * \r\n@ 1474 [ 1245 ] ت",
      "sanad_ar": "2 . روى له أَبُو دَاوُدَ حَدِيثًا واحِدًا",
      "matn_ar": "++ \r\n$508  -10 /2 /141 أخبرنا به /94 أَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ الْمُذْهِبِ L14991 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مَالِكٍ L8994 /26 ، قال : حدثنا /26عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657/26 ، قال : حَدَّثَنِي/26 أَبِي L488/26 ، قال : حدثنا /26 مُحَمَّدُ بْنُ رَبِيعَةَ L6965 /26 ، قال : حدثنا /26 مُحَمَّدُ بْنُ الْحَسَنِ بْنِ عَطِيَّةَ الْعَوْفِيُّ L6834 /26 ، عن /26 أَبِيهِ L1277 /26 ، عن /26 جَدِّهِ L5647/26 ، /27 عن /93 أَبِي سَعِيدٍ L3260 /93 ، قال : /20 \" لَعَنَ رَسُولُ اللَّهِ صلى الله عليه وسلم النَّائِحَةَ والْمُسْتَمِعَةَ \" /27 ، رواه عن إِبْرَاهِيم بْن موسى الفراء ، عن مُحَمَّد بْن ربيعة الكلاعي ، فوقع لنا بدلا عاليا * \r\n@ 1474 [ 1245 ] ت",
