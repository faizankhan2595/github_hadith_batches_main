    {
      "hadith_id": 1007333,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 16779,
      "text_ar": "2 ++ روى له أبو داود حديثا واحدا ، وقد وقع لنا عاليا عنه . ++ \r\n$940  -10 /2 /141 أخبرنا بِهِ /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 الْمَقْدِسِيَّانِ ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 هِبَةُ اللَّهِ بْنُ مُحَمَّدٍ L46125 /26 ، قال : أخبرنا /26 الْحَسَنُ بْنُ عَلِيٍّ التَّمِيمِيُّ L14991 /26 ، قال : أخبرنا /26 أَحْمَدُ بْنُ جَعْفَرٍ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ حَبِيبٍ لُوَيْنٍ الأَسَدِيُّ L7005 /26 ، قال : حدثنا /26 يَحْيَى بْنُ أَبِي زَائِدَةَ L8264 /26 ، قال : حدثنا /26 عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ L4294 /26 ، عَنْ /26 زِيَادِ بْنِ زَيْدٍ السَّوَائِيُّ L3084 /26 ، عَنْ /26 أَبِي جُحَيْفَةَ L8175 /26 ، /27 عَنْ /93 عَلِيٍّ L5722 /93 رَضِيَ اللَّهُ تَعَالَى عَنْهُ ، قال : “ إِنَّ /20 مِنَ السُّنَّةِ فِي الصَّلاةِ ، وضْعُ الأَكُّفِّ عَلَى الأَكُّفِّ تَحْتَ السُّرَّةِ “ /27 . رَوَاهُ عَنْ مُحَمَّدِ بْنِ مَحْبُوبٍ ، عَنْ حَفْصِ بْنِ غِيَاثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ * \r\n@ 2471 [ 2047 ] د\u001aE1526",
      "sanad_ar": "2 ++ روى له أبو داود حديثا واحدا",
      "matn_ar": "وقد وقع لنا عاليا عنه . ++ \r\n$940  -10 /2 /141 أخبرنا بِهِ /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 الْمَقْدِسِيَّانِ ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 هِبَةُ اللَّهِ بْنُ مُحَمَّدٍ L46125 /26 ، قال : أخبرنا /26 الْحَسَنُ بْنُ عَلِيٍّ التَّمِيمِيُّ L14991 /26 ، قال : أخبرنا /26 أَحْمَدُ بْنُ جَعْفَرٍ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ حَبِيبٍ لُوَيْنٍ الأَسَدِيُّ L7005 /26 ، قال : حدثنا /26 يَحْيَى بْنُ أَبِي زَائِدَةَ L8264 /26 ، قال : حدثنا /26 عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ L4294 /26 ، عَنْ /26 زِيَادِ بْنِ زَيْدٍ السَّوَائِيُّ L3084 /26 ، عَنْ /26 أَبِي جُحَيْفَةَ L8175 /26 ، /27 عَنْ /93 عَلِيٍّ L5722 /93 رَضِيَ اللَّهُ تَعَالَى عَنْهُ ، قال : “ إِنَّ /20 مِنَ السُّنَّةِ فِي الصَّلاةِ ، وضْعُ الأَكُّفِّ عَلَى الأَكُّفِّ تَحْتَ السُّرَّةِ “ /27 . رَوَاهُ عَنْ مُحَمَّدِ بْنِ مَحْبُوبٍ ، عَنْ حَفْصِ بْنِ غِيَاثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ * \r\n@ 2471 [ 2047 ] د\u001aE1526",
