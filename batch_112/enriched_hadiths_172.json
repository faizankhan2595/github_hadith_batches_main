    {
      "hadith_id": 1001577,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 11023,
      "text_ar": "مولاهم الكوفي أخو أبي بكر بْن عياش وكان وصي سفيان الثوري /10 إِسْمَاعِيل بْن أبي خالد /10 /10 وجعفر بْن مُحَمَّد بْن عَلِيّ الصادق م س /10 /10 وزائدة بْن قدامة /10 /10 وسفيان الثوري /10 /10 وسليمان الأعمش س /10 /10 وعمرو بْن ميمون بْن مهران /10 /10 ومحمد بْن إسحاق بْن يسار /10 /10 ومحمد بْن عجلان /10 /10 ومغيرة بْن مقسم الضبي /10 /10 ويحيى بْن سعيد الأنصاري /10 /10 وأبي إسحاق الشيباني ت /10",
