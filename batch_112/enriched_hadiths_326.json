    {
      "hadith_id": 1003885,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 13331,
      "text_ar": "أخبرنا /94 أَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، قال : أَنْبَأَنَا /26 أَبُو الْمَكَارِمِ اللَّبَّانُ L75583 /26 ، /26 وأَبُو جَعْفَرٍ الصَّيْدَلانِيُّ L46610 /26 ، قَالا : أخبرنا /26 أَبُو عَلِيٍّ الْحَدَّادُ L14761 /26 ، قال : أخبرنا /26 أَبُو نُعَيْمٍ الْحَافِظُ L9927 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ جَعْفَرٍ L22058 /26 ، قال : حدثنا /26 يُونُسُ بْنُ حَبِيبٍ L34440 /26 ، قال : حدثنا /26 أَبُو دَاوُدَ L3585 /26 ، قال : حدثنا /26 خَارِجَةُ بْنُ مُصْعَبٍ L2609 /26 ، قال : حدثنا /26 يُونُسُ بْنُ عُبَيْدٍ L8616 /26 ، عَنِ /26 الْحَسَنِ L1239 /26 ، عَنْ /26 عُتَيٍّ السَّعْدِيِّ L5478 /26 ، /27 عَنْ /93 أُبَيِّ بْنِ كَعْبٍ L396 /93 ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، قال : \" إِنَّ /20 لِلْوُضُوءِ شَيْطَانًا يُقَالَ لَهُ : الْوَلْهَانُ ، فَاحْذَرُوهُ \" /27 ، أَوْ قال : \" فَاتَّقُوهُ \" . روياه عَنْ بندار ، عَنْ أبي دَاوُد ، فوقع لنا بدلا عاليا بدرجتين ، وقال الترمذي : غريب ، وليس إسناده بالقوي ، لا نعلم أحدا أسنده غير خارجة ، وقد روي من غير وجه عَنِ الْحَسَن قوله ، لا أعلم لَهُ عند الترمذي غير هذا الحديث الواحد ، وقد وقع لنا عاليا جدا من روايته * \r\n@ 1912 من اسمه خازم @ 1913 [ 1593 ] ر\u001aE1196",
      "sanad_ar": "أخبرنا /94 أَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94",
      "matn_ar": "قال : أَنْبَأَنَا /26 أَبُو الْمَكَارِمِ اللَّبَّانُ L75583 /26 ، /26 وأَبُو جَعْفَرٍ الصَّيْدَلانِيُّ L46610 /26 ، قَالا : أخبرنا /26 أَبُو عَلِيٍّ الْحَدَّادُ L14761 /26 ، قال : أخبرنا /26 أَبُو نُعَيْمٍ الْحَافِظُ L9927 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ جَعْفَرٍ L22058 /26 ، قال : حدثنا /26 يُونُسُ بْنُ حَبِيبٍ L34440 /26 ، قال : حدثنا /26 أَبُو دَاوُدَ L3585 /26 ، قال : حدثنا /26 خَارِجَةُ بْنُ مُصْعَبٍ L2609 /26 ، قال : حدثنا /26 يُونُسُ بْنُ عُبَيْدٍ L8616 /26 ، عَنِ /26 الْحَسَنِ L1239 /26 ، عَنْ /26 عُتَيٍّ السَّعْدِيِّ L5478 /26 ، /27 عَنْ /93 أُبَيِّ بْنِ كَعْبٍ L396 /93 ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، قال : \" إِنَّ /20 لِلْوُضُوءِ شَيْطَانًا يُقَالَ لَهُ : الْوَلْهَانُ ، فَاحْذَرُوهُ \" /27 ، أَوْ قال : \" فَاتَّقُوهُ \" . روياه عَنْ بندار ، عَنْ أبي دَاوُد ، فوقع لنا بدلا عاليا بدرجتين ، وقال الترمذي : غريب ، وليس إسناده بالقوي ، لا نعلم أحدا أسنده غير خارجة ، وقد روي من غير وجه عَنِ الْحَسَن قوله ، لا أعلم لَهُ عند الترمذي غير هذا الحديث الواحد ، وقد وقع لنا عاليا جدا من روايته * \r\n@ 1912 من اسمه خازم @ 1913 [ 1593 ] ر\u001aE1196",
