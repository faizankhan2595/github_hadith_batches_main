    {
      "hadith_id": 999476,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 8922,
      "text_ar": "الصادق وأمه أم فروة بنت القاسم بْن مُحَمَّدِ بْنِ أبي بكر الصديق وأمها أسماء بنت عَبْد الرَّحْمَنِ بْن أبي بكر الصديق ولذلك كَانَ يقول : ولدني أَبُو بكر مرتين /10 عبيد اللَّه بْن أبي رافع كاتب على ت /10 /10 وعروة بْن الزبير /10 /10 وعطاء بْن أبي رباح م /10 /10 وجده لأمه القاسم بْن مُحَمَّدِ بْنِ أبي بكر الصديق /10 /10 وأبيه أبي جعفر مُحَمَّد بْن عَلِيٍّ الباقر بخ 4 /10 /10 ومحمد بْن مسلم بْن شهاب الزهري /10 /10 ومحمد بْن المنكدر عخ م س /10 /10 ومسلم بْن أبي مريم /10 /10 ونافع مولى ابن عمر /10",
      "sanad_ar": "الصادق وأمه أم فروة بنت القاسم بْن مُحَمَّدِ بْنِ أبي بكر الصديق وأمها أسماء بنت عَبْد الرَّحْمَنِ بْن أبي بكر الصديق ولذلك كَانَ يقول",
      "matn_ar": "ولدني أَبُو بكر مرتين /10 عبيد اللَّه بْن أبي رافع كاتب على ت /10 /10 وعروة بْن الزبير /10 /10 وعطاء بْن أبي رباح م /10 /10 وجده لأمه القاسم بْن مُحَمَّدِ بْنِ أبي بكر الصديق /10 /10 وأبيه أبي جعفر مُحَمَّد بْن عَلِيٍّ الباقر بخ 4 /10 /10 ومحمد بْن مسلم بْن شهاب الزهري /10 /10 ومحمد بْن المنكدر عخ م س /10 /10 ومسلم بْن أبي مريم /10 /10 ونافع مولى ابن عمر /10",
