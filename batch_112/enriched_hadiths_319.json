      "hadith_id": 1003780,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 13226,
      "text_ar": "2 ++ روى له مسلم ، وأَبُو داود ، والنسائي حديثا واحدا ، وقد وقع لنا بعلو من روايته . ++ \r\n$674  -10 /2 /141 أخبرنا بِهِ /94 أَبُو الْفَرَجِ بْنُ أَبِي عُمَرَ بْنِ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ الْمُذْهِبِ L14991 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مَالِكٍ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ L1003 /26 ، قال : حدثنا /26 الْجُرَيْرِيُّ L3290 /26 ، عَنْ /26 حَيَّانَ بْنِ عُمَيْرٍ L2591 /26 ، قال : /27 حدثنا /93 عَبْدُ الرَّحْمَنِ بْنُ سَمُرَةَ L4387 /93 ، قال : \" بَيْنَمَا أَنَا أَتَرَامَى بِأَسْهُمِي فِي حَيَاةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ إِذْ كُسِفَتِ الشَّمْسُ ، فَنَبَذْتُهُنَّ وسَعَيْتُ أَنْظُرُ مَا حَدَثَ بِكُسُوفِ الشَّمْسِ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، فَإِذَا هُوَ /20 رَافِعٌ يَدَيْهِ يُسَبِّحُ ويَحْمَدُ ويُهَلِّلُ ويُكَبِّرُ ويَدْعُو ، فَلَمْ يَزَلْ كَذَلِكَ حَتَّى حُسِرَ عَنِ الشَّمْسِ ، فَقَرَأَ سُورَتَيْنِ ، ورَكَعَ رَكْعَتَيْنِ \" /27 . رَوَاهُ مُسْلِمٌ ، عَنِ الْقَوَارِيرِيِّ ، عَنْ بِشْرِ بْنِ الْمُفَضَّلِ ، وعَنْ أَبِي بَكْرِ بْنِ أَبِي شَيْبَةَ ، عَنْ عَبْدِ الأَعْلَى ، وعَنْ مُحَمَّدِ بْنِ مُثَنًّى ، عَنْ سَالِمِ بْنِ نُوحٍ . ورَوَاهُ أَبُو دَاوُدَ ، عَنْ مُسَدَّدٍ ، عَنْ بِشْرِ بْنِ الْمُفَضَّلِ . ورَوَاهُ النَّسَائِيُّ ، عَنِ الْمُخَرِّمِيِّ ، عَنْ أَبِي هِشَامٍ الْمَخْزُومِيِّ ، عَنْ وهَيْبٍ ، أَرْبَعَتُهُمْ عَنْ سَعِيدٍ الْجُرَيْرِيِّ ، نَحْوَهُ * \r\n@ 1892 [ 1577 ] د س\u001fE1184",
      "sanad_ar": "2 ++ روى له مسلم",
      "matn_ar": "وأَبُو داود ، والنسائي حديثا واحدا ، وقد وقع لنا بعلو من روايته . ++ \r\n$674  -10 /2 /141 أخبرنا بِهِ /94 أَبُو الْفَرَجِ بْنُ أَبِي عُمَرَ بْنِ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ الْمُذْهِبِ L14991 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مَالِكٍ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ L1003 /26 ، قال : حدثنا /26 الْجُرَيْرِيُّ L3290 /26 ، عَنْ /26 حَيَّانَ بْنِ عُمَيْرٍ L2591 /26 ، قال : /27 حدثنا /93 عَبْدُ الرَّحْمَنِ بْنُ سَمُرَةَ L4387 /93 ، قال : \" بَيْنَمَا أَنَا أَتَرَامَى بِأَسْهُمِي فِي حَيَاةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ إِذْ كُسِفَتِ الشَّمْسُ ، فَنَبَذْتُهُنَّ وسَعَيْتُ أَنْظُرُ مَا حَدَثَ بِكُسُوفِ الشَّمْسِ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، فَإِذَا هُوَ /20 رَافِعٌ يَدَيْهِ يُسَبِّحُ ويَحْمَدُ ويُهَلِّلُ ويُكَبِّرُ ويَدْعُو ، فَلَمْ يَزَلْ كَذَلِكَ حَتَّى حُسِرَ عَنِ الشَّمْسِ ، فَقَرَأَ سُورَتَيْنِ ، ورَكَعَ رَكْعَتَيْنِ \" /27 . رَوَاهُ مُسْلِمٌ ، عَنِ الْقَوَارِيرِيِّ ، عَنْ بِشْرِ بْنِ الْمُفَضَّلِ ، وعَنْ أَبِي بَكْرِ بْنِ أَبِي شَيْبَةَ ، عَنْ عَبْدِ الأَعْلَى ، وعَنْ مُحَمَّدِ بْنِ مُثَنًّى ، عَنْ سَالِمِ بْنِ نُوحٍ . ورَوَاهُ أَبُو دَاوُدَ ، عَنْ مُسَدَّدٍ ، عَنْ بِشْرِ بْنِ الْمُفَضَّلِ . ورَوَاهُ النَّسَائِيُّ ، عَنِ الْمُخَرِّمِيِّ ، عَنْ أَبِي هِشَامٍ الْمَخْزُومِيِّ ، عَنْ وهَيْبٍ ، أَرْبَعَتُهُمْ عَنْ سَعِيدٍ الْجُرَيْرِيِّ ، نَحْوَهُ * \r\n@ 1892 [ 1577 ] د س\u001fE1184",
