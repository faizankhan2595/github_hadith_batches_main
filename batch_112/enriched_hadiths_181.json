    {
      "hadith_id": 1001709,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 11155,
      "text_ar": "/10 أَحْمَد بْن المنذر القزاز /10 /10 وإسحاق بْن إدريس /10 /10 وأمية بْن بسطام /10 /10 وبدل بْن المحبر /10 /10 وبشر بْن عُمَر الزهراني د /10 /10 وبكر بْن بكار /10 /10 والحسين بْن الْحَسَن الأشقر /10 /10 وخالد بْن مخلد القطواني /10 /10 وأبي زيد سعيد بْن الربيع الهروي /10 /10 وسليمان بْن حرب /10 /10 وأبي عاصم الضحاك بْن مخلد النبيل /10 /10 وعاصم بْن مهجع /10 /10 وعبد اللَّه بْن أبي أمية /10 /10 وعبد اللَّه بْن داود الخريبي /10 /10 وعبد اللَّه بْن عَبْد الرحمن بْن إِبْرَاهِيم المدني /10 /10 وعبد اللَّه بْن هارون بْن أبي عيسى /10 /10 وعبد العزيز بْن الخطاب /10 /10 وعبد الغفار بْن عبيد اللَّه الكريزي /10 /10 وأبي عَلِيّ عبيد اللَّه بْن عَبْد المجيد الحنفي /10 /10 وعبيد اللَّه بْن موسى /10 /10 وعلي بْن المديني /10 /10 ومحمد بْن بلال الكندي البصري /10 /10 ومحمد بْن جهضم /10 /10 ومحمد بْن حاتم الجرجرائي د /10 /10 ومحمد بْن الصلت الأسدي /10 /10 ومحمد بْن أبي يعقوب الكرماني /10 /10 وأبي سلمة موسى بْن إِسْمَاعِيل /10 /10 وأبي حذيفة موسى بْن مسعود النهدي /10 /10 والنضر بْن حماد /10 /10 والنضر بْن شميل /10 /10 ويحيى بْن حماد الشيباني /10 /10 ويحيى بْن عَبْد الحميد الحماني /10 /10 ويحيى بْن كثير العنبري /10 /10 ويعلى بْن عبيد الطنافسي /10",
