    {
      "hadith_id": 1002201,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 11647,
      "text_ar": "2 ++ وقال حفص بْن غياث : سمعت مالك بْن مغول ، يقول للقاسم بْن الوليد : هل رأيت بعينيك مثل طلحة بْن مصرف ؟ قال : نعم ، حصين بْن عَبْد الرحمن ++ وقال مُحَمَّد بْن حميد ، عن جرير : رأيت حصين بْن عَبْد الرحمن يخضب بالحناء ++ وقال هشيم : أتى عليه ثلاث وتسعون سنة ، وكان أكبر من الأعمش ، وقريبا من إِبْرَاهِيم . ++ وقال عَلِيّ بْن عاصم ، عن حصين : جاءنا قتل الحسين بْن عَلِيّ ، فمكثنا ثلاثا كأن وجوهنا طليت رمادا ، قلت : مثل من أنت يومئذ ؟ قال : رجل متأهل . ++ وقال مُحَمَّد بْن   عَبْد اللَّه الحضرمي : مات سنة ست وثلاثين ومائة . ++ روى له الجماعة . @ 1619 وممن يسمى حصين بْن عَبْد الرحمن أيضا من رواة العلم . @ 1620 [ 1359 ] تمييز%E1032",
      "sanad_ar": "2 ++ وقال حفص بْن غياث",
      "matn_ar": "سمعت مالك بْن مغول ، يقول للقاسم بْن الوليد : هل رأيت بعينيك مثل طلحة بْن مصرف ؟ قال : نعم ، حصين بْن عَبْد الرحمن ++ وقال مُحَمَّد بْن حميد ، عن جرير : رأيت حصين بْن عَبْد الرحمن يخضب بالحناء ++ وقال هشيم : أتى عليه ثلاث وتسعون سنة ، وكان أكبر من الأعمش ، وقريبا من إِبْرَاهِيم . ++ وقال عَلِيّ بْن عاصم ، عن حصين : جاءنا قتل الحسين بْن عَلِيّ ، فمكثنا ثلاثا كأن وجوهنا طليت رمادا ، قلت : مثل من أنت يومئذ ؟ قال : رجل متأهل . ++ وقال مُحَمَّد بْن   عَبْد اللَّه الحضرمي : مات سنة ست وثلاثين ومائة . ++ روى له الجماعة . @ 1619 وممن يسمى حصين بْن عَبْد الرحمن أيضا من رواة العلم . @ 1620 [ 1359 ] تمييز%E1032",
