      "hadith_id": 1006547,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 15993,
      "text_ar": "قاضي مكة /10 إبراهيم بْن حمزة الزبيري /10 /10 وإبراهيم بْن زيادة الليثي /10 /10 وإبراهيم بْن المنذر الحزامي /10 /10 وإسحاق بْن جعفر بْن مُحَمَّد بْن علي بْن الحسين بْن علي بْن أبي طالب /10 /10 وإسماعيل بْن أبي أويس /10 /10 وأبي ضمرة أنس بْن عياض اليثي ق /10 /10 وذؤيب بْن عمامة السهمي /10 /10 وسفيان بْن عيينة /10 /10 وعبد الله بْن نافع الصائغ ق /10 /10 وعبد الجبار بْن سعيد المساحقي قاضي المدينة /10 /10 وعبد المجيد بْن عبد العزيز بْن أبي رواد /10 /10 وعبد الملك بْن عبد العزيز بْن الماجشون /10 /10 وعتيق بْن يعقوب الزبيري /10 /10 وأبي الحسن علي بْن مُحَمَّد المدائني الأخباري /10 /10 ومُحَمَّد بْن الحسن بْن زبالة المخزومي /10 /10 ومُحَمَّد بْن الضحاك بْن عثمان الحزامي /10 /10 وأبي غزية مُحَمَّد بْن موسى الأنصاري /10 /10 وأبي غسان مُحَمَّد بْن يحيى الكناني /10 /10 وعمه مصعب بْن عبد الزبيري /10 /10 والنضر بْن شميل المازني /10 /10 وأبي نباتة يونس بْن يحيى المديني /10",
