    {
      "hadith_id": 1002358,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 11804,
      "text_ar": "ويقال له : الغاضري ، ويعرف بحفيص ، وهو حفص بن أبي داود صاحب عاصم بن أبي النجود في القراءة ، وابن امرأته ، وكان معه في دار واحدة . وقيل في نسبه : حفص بن سليمان بن المغيرة . /10 إسماعيل بن عبد الرحمن السدي /10 /10 وأيوب السختياني /10 /10 وثابت البناني /10 /10 وحماد بن أبي سليمان /10 /10 وحميد الخصاف /10 /10 وسالم الأفطس /10 /10 وسماك بن حرب /10 /10 وطلحة بن يحيى بن طلحة بن عبيد الله /10 /10 وعاصم بن أبي النجود عس /10 /10 وعاصم الأحول /10 /10 وعَبْد اللَّهِ بن يزيد النخعي /10 /10 وعبد الملك عمير /10 /10 وأبي حصين عثمان بن عاصم /10 /10 وعلقمة بن مرثد /10 /10 وقيس بن مسلم /10 /10 وكثير بن زاذان ت ق /10 /10 وكثير بن شنظير ق /10 /10 وليث بن أبي سليم /10 /10 ومحارب بن دثار /10 /10 ومُحَمَّد بن سوقة /10 /10 ومُحَمَّد بن عبد الرحمن بن أبي ليلى /10 /10 وموسى بن أبي كثير /10 /10 وموسى الصغير /10 /10 والهيثم بن حبيب الصراف /10 /10 ويزيد بن أبي زياد /10 /10 وأبي إسحاق السبيعي /10 /10 وأبي إسحاق الشيباني /10",
      "sanad_ar": "ويقال له",
      "matn_ar": "الغاضري ، ويعرف بحفيص ، وهو حفص بن أبي داود صاحب عاصم بن أبي النجود في القراءة ، وابن امرأته ، وكان معه في دار واحدة . وقيل في نسبه : حفص بن سليمان بن المغيرة . /10 إسماعيل بن عبد الرحمن السدي /10 /10 وأيوب السختياني /10 /10 وثابت البناني /10 /10 وحماد بن أبي سليمان /10 /10 وحميد الخصاف /10 /10 وسالم الأفطس /10 /10 وسماك بن حرب /10 /10 وطلحة بن يحيى بن طلحة بن عبيد الله /10 /10 وعاصم بن أبي النجود عس /10 /10 وعاصم الأحول /10 /10 وعَبْد اللَّهِ بن يزيد النخعي /10 /10 وعبد الملك عمير /10 /10 وأبي حصين عثمان بن عاصم /10 /10 وعلقمة بن مرثد /10 /10 وقيس بن مسلم /10 /10 وكثير بن زاذان ت ق /10 /10 وكثير بن شنظير ق /10 /10 وليث بن أبي سليم /10 /10 ومحارب بن دثار /10 /10 ومُحَمَّد بن سوقة /10 /10 ومُحَمَّد بن عبد الرحمن بن أبي ليلى /10 /10 وموسى بن أبي كثير /10 /10 وموسى الصغير /10 /10 والهيثم بن حبيب الصراف /10 /10 ويزيد بن أبي زياد /10 /10 وأبي إسحاق السبيعي /10 /10 وأبي إسحاق الشيباني /10",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10",
