    {
      "hadith_id": 1001719,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 11165,
      "text_ar": "ويقال أَبُو خالد الدمشقي البلاطي والبلاط قرية على نحو فرسخ من دمشق وأصله من خراسان . /10 بشر بْن حيان /10 /10 والحكم بْن عَبْد اللَّه الأيلي /10 /10 وزيد بْن واقد مد ق /10 /10 وسعيد بْن عَبْد العزيز /10 /10 وصدقة بْن عَبْد اللَّه /10 /10 وصدقة بْن ميمون /10 /10 وعبد اللَّه بْن زياد بْن سمعان /10 /10 وعبد الرحمن بْن ثابت بْن ثوبان /10 /10 وعبد الرحمن بْن عمرو الأوزاعي /10 /10 وعبد العزيز بْن أبي رواد /10 /10 وعبد الملك بْن عَبْد العزيز بْن جريج /10 /10 وعثمان بْن أبي العاتكة /10 /10 وعمر بْن عَبْد اللَّه مولى غفرة /10 /10 وعمر بْن قيس سندل ق /10 /10 والقاسم بْن هزان الخولاني الداراني /10 /10 وكلثوم بْن زياد /10 /10 ومالك بْن أنس /10 /10 وناصح أبي عَبْد اللَّه مولى بني أمية /10 /10 ونصر بْن علقمة الحضرمي /10 /10 وهشام بْن عروة /10",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
