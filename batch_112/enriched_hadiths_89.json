      "hadith_number": 9767,
      "text_ar": "0 /11 البخاري /11 /11 ومسلم /11 /11 وأحمد بْن إبراهيم الدورقي /11 /11 وأحمد بْن الخليل /11 /11 وأحمد بْن عبدة الآملي ت /11 /11 وأحمد بْن عزيز النسفي /11 /11 وأحمد بْن نصر النيسابوري /11 /11 وأحمد بْن يونس الضبي /11 /11 وأَبُو بكر جعفر بْن مُحَمَّدِ بْنِ الحسن الفريابي /11 /11 وجعفر بْن مُحَمَّدِ بْنِ شاكر الصائغ /11 /11 والحسن بْن سفيان الشيباني /11 /11 وسعيد بْن إسرائيل القطيعي /11 /11 وعباس بْن مُحَمَّد الدوري /11 /11 وعبد اللَّه بْن محمود السعدي /11 /11 وأَبُو زرعة عبيد اللَّه بْن عَبْدِ الكريم الرازي /11 /11 والقاسم بْن مُحَمَّدِ بْنِ الحارث المروزي /11 /11 ومحمد بْن حاتم بْن نعيم المروزي س /11 /11 ومحمد بْن سهل بْن عسكر التميمي البخاري /11 /11 وأَبُو بَكْرٍ مُحَمَّدُ بْنُ عَبْد بْن عامر السمرقندي /11 /11 ومحمد بْن علي بْن الحسن بْن شقيق ت /11 /11 ومحمد بْن علي بْن حمزة /11 /11 وأَبُو بَكْرٍ مُحَمَّدُ بْنُ علي بْن السكن /11 /11 ومحمد بْن مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ المروزيون /11 /11 ومحمد بْن مسلم بْن وراة الرازي /11 /11 ومحمد بْن منصور بْن الحسن بْن منصور أَبُو سعد بْن أبي نصر الهروي الزاهد /11 /11 وهارون بْن أبي هارون /11 /11 وهبيرة بْن الحسن بْن علي بْن المنذر البغوي /11 /11 ويعقوب بْن إِسْمَاعِيلَ بْن حماد بْن زيد /11 /11 ويوسف بْن عدي الكوفي وهو من أقرانه ومات   قبله /11 # قال",
