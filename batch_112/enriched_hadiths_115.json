      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 10163,
      "text_ar": "/10 إسماعيل بْن عياش /10 /10 وإياس بْن أبي تميمة /10 /10 والبراء بْن عَبْدِ اللَّهِ الغنوي /10 /10 وحسان بْن إبراهيم الكرماني /10 /10 وحفص بْن جميع /10 /10 وأبي خلدة خالد بْن دينار /10 /10 وزياد بْن أبي حسان النبطي /10 /10 والسكن بْن المغيرة /10 /10 وسويد بْن الخطاب القريعي /10 /10 وأبي طلحة شداد بْن سعيد الراسبي /10 /10 وشعبة بْن حجاج /10 /10 وعباد بْن كثير /10 /10 وعبد اللَّه بْن القاسم الكليبي /10 /10 وعبد الرحمن بْن عَبْدِ اللَّهِ المسعودي /10 /10 وعبد القدوس بْن حبيب الشامي /10 /10 وعثمان بْن عَبْدِ الرَّحْمَنِ الزهري الوقاصي /10 /10 وعلي بْن المبارك /10 /10 وأبي هاشم عمار بْن عمارة الزعفراني /10 /10 وعيسى بْن ميمون الواسطي /10 /10 وفطر بْن خليفة /10 /10 وقرة بْن خالد السدوسي /10 /10 ومالك بْن مغول /10 /10 ومبارك بْن فضالة /10 /10 ومحمد بْن ذكوان الجهضمي /10 /10 ومحمد بْن عَبْدِ الرَّحْمَنِ بْن المحبر /10 /10 ومعارك بْن عباد ت /10 /10 والمنذر بْن زياد البصري /10 /10 وهشام بْن أَبِي عَبْدِ اللَّهِ الدستوائي /10 /10 وهلال بْن عَبْدِ الرَّحْمَنِ الحنفي /10 /10 وورقاء بْن عمر اليشكري /10 /10 ووهب بْن جرير بْن حازم /10 /10 واليمان بْن المغيرة /10 /10 وأبي بكر الهذلي /10 /10 وأبي عبيدة الناجي /10",
