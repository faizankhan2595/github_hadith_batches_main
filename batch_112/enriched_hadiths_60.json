      "hadith_id": 999892,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 9338,
      "text_ar": "0 /11 النسائي /11 /11 وإبراهيم بْن حفص العسكري /11 /11 وأحمد بْن عَبْدِ اللَّهِ بْنِ نصر بْن بجير الذهلي /11 /11 وأحمد بْن مُحَمَّدِ بْنِ إسماعيل بْن أبي إدريس الحلبي /11 /11 وأحمد بْن يوسف المنبجي /11 /11 وأَبُو عروبة الحسين بْن مُحَمَّد الحراني /11 /11 وزيد بْن عَبْدِ اللَّهِ المقرئ /11 /11 وأَبُو أيوب سليمان بْن مُحَمَّدِ بْنِ إدريس بْن رويط /11 /11 وصالح بْن الأصبغ بْن عامر المنبجي /11 /11 والعباس بْن الحسن بْن خشيش العنبري الحلبي /11 /11 وعبد اللَّه بْن زياد بْن أبي سفيان الموصلي /11 /11 وأَبُو بكر عَبْد اللَّهِ بْن مُحَمَّدِ بْنِ زياد النيسابوري /11 /11 وعبد اللَّه بْن مُحَمَّدِ بْنِ مسلم الإسفراييني /11 /11 وعَبْد الرَّحْمَنِ بْن إِسْمَاعِيلَ بْن عَلِيٍّ الكوفي /11 /11 وأَبُو مُحَمَّد عَبْد الرَّحْمَنِ بْن عبيد اللَّه بْن أَحْمَدَ الحلبي المعروف بابن أخي الإمام /11 /11 وعبد الرحمن بْن عبيد اللَّه بْن عَبْدِ الْعَزِيزِ الهاشمي الحلبي المعروف بابن أخي الإمام ، أيضا /11 /11 وعمر بْن سعيد بْن سنان المنبجي /11 /11 ويحيى بْن عَبْدِ الْبَاقِي الأذني /11 # قال",
      "sanad_ar": "0 /11 النسائي /11 /11 وإبراهيم بْن حفص العسكري /11 /11 وأحمد بْن عَبْدِ اللَّهِ بْنِ نصر بْن بجير الذهلي /11 /11 وأحمد بْن مُحَمَّدِ بْنِ إسماعيل بْن أبي إدريس الحلبي /11 /11 وأحمد بْن يوسف المنبجي /11 /11 وأَبُو عروبة الحسين بْن مُحَمَّد الحراني /11 /11 وزيد بْن عَبْدِ اللَّهِ المقرئ /11 /11 وأَبُو أيوب سليمان بْن مُحَمَّدِ بْنِ إدريس بْن رويط /11 /11 وصالح بْن الأصبغ بْن عامر المنبجي /11 /11 والعباس بْن الحسن بْن خشيش العنبري الحلبي /11 /11 وعبد اللَّه بْن زياد بْن أبي سفيان الموصلي /11 /11 وأَبُو بكر عَبْد اللَّهِ بْن مُحَمَّدِ بْنِ زياد النيسابوري /11 /11 وعبد اللَّه بْن مُحَمَّدِ بْنِ مسلم الإسفراييني /11 /11 وعَبْد الرَّحْمَنِ بْن إِسْمَاعِيلَ بْن عَلِيٍّ الكوفي /11 /11 وأَبُو مُحَمَّد عَبْد الرَّحْمَنِ بْن عبيد اللَّه بْن أَحْمَدَ الحلبي المعروف بابن أخي الإمام /11 /11 وعبد الرحمن بْن عبيد اللَّه بْن عَبْدِ الْعَزِيزِ الهاشمي الحلبي المعروف بابن أخي الإمام",
      "matn_ar": "أيضا /11 /11 وعمر بْن سعيد بْن سنان المنبجي /11 /11 ويحيى بْن عَبْدِ الْبَاقِي الأذني /11 # قال",
