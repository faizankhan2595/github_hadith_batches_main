    {
      "hadith_id": 999887,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 9333,
      "text_ar": "0 /11 أَحْمَد بْن عبدة الآملي ل /11 /11 وأحمد بْن مصعب /11 /11 وعبد الرحمن بْن الحكم بْن بشير بْن سلمان /11 /11 ومحمد بْن عَبْدِ اللَّهِ بْنِ قهزاذ /11 /11 ومحمد بْن مُوسَى بْن حاتم المروزيون /11 ++ قال عَبْد الرَّحْمَنِ بْن أبي حاتم الرازي : حاتم بْن إبراهيم الجلاب . روى عن : عَبْد اللَّهِ بْن المبارك الكثير . ++ وقال مُحَمَّد بْن عَبْدِ اللَّهِ بْنِ قهزاذ : حاتم بْن العلاء الجلاب من أصحاب عَبْد اللَّهِ من الكبار كتب عن المروازة وغيرهم صحيح الكتاب مات سنة ثلاث عشرة ومائتين ودفن هو وأَبُو الوزير في يوم واحد صلينا عليهما جميعا . ++ روى له أَبُو دَاوُدَ في كتاب المسائل @ 1171 [ 1001 ] بخ",
      "sanad_ar": "0 /11 أَحْمَد بْن عبدة الآملي ل /11 /11 وأحمد بْن مصعب /11 /11 وعبد الرحمن بْن الحكم بْن بشير بْن سلمان /11 /11 ومحمد بْن عَبْدِ اللَّهِ بْنِ قهزاذ /11 /11 ومحمد بْن مُوسَى بْن حاتم المروزيون /11 ++ قال عَبْد الرَّحْمَنِ بْن أبي حاتم الرازي",
