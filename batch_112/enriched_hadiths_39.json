    {
      "hadith_id": 999574,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 9020,
      "text_ar": "كنيته أَبُو الفضل ، ويقال له : الراسي أيضا وهو أخو يزيد بْن مُحَمَّدِ بْنِ الفضيل . /10 إسحاق بْن إبراهيم الحنيني /10 /10 وإسماعيل بْن مسلمة بْن قعنب القعنبي /10 /10 والحسن بْن بشر بْن سلم البجلي /10 /10 وسعيد بْن الحكم بْن أبي مريم المصري /10 /10 وسليمان بْن عَبْدِ الرَّحْمَنِ الدمشقي /10 /10 وصفوان بْن صالح المؤذن ت /10 /10 وعاصم بْن يوسف اليربوعي /10 /10 وعبد اللَّه بْن مُحَمَّدِ بْنِ حجر الرسعني /10 /10 وعبد اللَّه بْن يوسف التنيسي /10 /10 وأبي صالح عَبْد الغفار بْن داود الحراني /10 /10 وأبي المغيرة عَبْد القدوس بْن الحجاج الخولاني /10 /10 وعبد المجيد بْن عَبْدِ الْعَزِيزِ بْن أبي رواد /10 /10 وأبي الحسن عَبْد الملك بْن عَبْدِ الحميد الميموني وهو من أقرانه /10 /10 وعبد الملك بْن عَبْدِ الْعَزِيزِ بْن الماجشون /10 /10 وعثمان بْن صالح السهمي المصري /10 /10 وعلي بْن عياش الحمصي /10 /10 وعمرو بْن عثمان الكلابي الرقي /10 /10 ومحمد بْن حمير الحمصي /10 /10 ومحمد بْن سُلَيْمَانَ بْن أبي داود الحراني /10 /10 ومحمد بْن الصلت الأسدي /10 /10 وأبي الجماهر مُحَمَّد بْن عثمان التنوخي /10 /10 ومحمد بْن عمرو السلمي /10 /10 ومحمد بْن كثير المصيصي /10 /10 ومحمد بْن مُوسَى بْن أعين /10 /10 ومؤمل بْن إِسْمَاعِيلَ /10 /10 والوليد بْن الوليد القلانسي /10",
      "sanad_ar": "كنيته أَبُو الفضل",
      "matn_ar": "ويقال له : الراسي أيضا وهو أخو يزيد بْن مُحَمَّدِ بْنِ الفضيل . /10 إسحاق بْن إبراهيم الحنيني /10 /10 وإسماعيل بْن مسلمة بْن قعنب القعنبي /10 /10 والحسن بْن بشر بْن سلم البجلي /10 /10 وسعيد بْن الحكم بْن أبي مريم المصري /10 /10 وسليمان بْن عَبْدِ الرَّحْمَنِ الدمشقي /10 /10 وصفوان بْن صالح المؤذن ت /10 /10 وعاصم بْن يوسف اليربوعي /10 /10 وعبد اللَّه بْن مُحَمَّدِ بْنِ حجر الرسعني /10 /10 وعبد اللَّه بْن يوسف التنيسي /10 /10 وأبي صالح عَبْد الغفار بْن داود الحراني /10 /10 وأبي المغيرة عَبْد القدوس بْن الحجاج الخولاني /10 /10 وعبد المجيد بْن عَبْدِ الْعَزِيزِ بْن أبي رواد /10 /10 وأبي الحسن عَبْد الملك بْن عَبْدِ الحميد الميموني وهو من أقرانه /10 /10 وعبد الملك بْن عَبْدِ الْعَزِيزِ بْن الماجشون /10 /10 وعثمان بْن صالح السهمي المصري /10 /10 وعلي بْن عياش الحمصي /10 /10 وعمرو بْن عثمان الكلابي الرقي /10 /10 ومحمد بْن حمير الحمصي /10 /10 ومحمد بْن سُلَيْمَانَ بْن أبي داود الحراني /10 /10 ومحمد بْن الصلت الأسدي /10 /10 وأبي الجماهر مُحَمَّد بْن عثمان التنوخي /10 /10 ومحمد بْن عمرو السلمي /10 /10 ومحمد بْن كثير المصيصي /10 /10 ومحمد بْن مُوسَى بْن أعين /10 /10 ومؤمل بْن إِسْمَاعِيلَ /10 /10 والوليد بْن الوليد القلانسي /10",
