    {
      "hadith_id": 1004827,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 14273,
      "text_ar": "سكن مكة /10 إِبْرَاهِيم بْن نافع المكي خ /10 /10 وإسماعيل بْن عبد الملك بْن أبي الصفيراء /10 /10 وبسام الصَّيْرَفِيّ /10 /10 وبشير بْن ربيعة البجلي /10 /10 وبشير بْن المهاجر د ت /10 /10 وحبيب بْن حسان بْن أبي الأشرس /10 /10 والحسن بْن عمارة /10 /10 وحسين بْن عقيل /10 /10 وحماد بْن شعيب الحماني /10 /10 وحنش بْن الحارث /10 /10 وداود بْن يَزِيدَ الأودي /10 /10 ودلهم بْن صالح /10 /10 وسعدان الجهني /10 /10 وسفيان الثوري خ /10 /10 وعبد الأعلى بْن أبي المساور /10 /10 وعَبْد الرَّحْمَنِ بْن مُحَمَّد المحاربي /10 /10 وعبد العزيز بْن أبي رواد بخ /10 /10 وعبد الواحد بْن أيمن خ /10 /10 وعمر بْن ذر خ /10 /10 وعيسى بْن طهمان خ /10 /10 وعيسى بْن عمر الهمداني /10 /10 وغالب بْن عبيد اللَّه الجزري /10 /10 وفطر بْن خليفة /10 /10 وقيس بْن الربيع /10 /10 ومالك بْن مغول خ /10 /10 ومحل بْن محرز الضبي /10 /10 ومحمد بْن زياد اليشكري /10 /10 ومسعر بْن كدام خ /10 /10 ومعرف بْن واصل /10 /10 وموسى بْن إِبْرَاهِيمَ الأنصاري /10 /10 ونافع بْن عمر الجمحي خ /10 /10 وهارون بْن أبي إِبْرَاهِيم البربري /10 /10 وهشام بْن سعد المدني /10 /10 ووهب بْن عقبة العجلي /10 /10 وأبي عقيل يَحْيَى بْن المتوكل /10 /10 وأبي عبدة يوسف بْن عبدة /10 /10 ويوسف بْن ميمون الصباغ /10 /10 ويونس بْن أبي إِسْحَاق /10",
