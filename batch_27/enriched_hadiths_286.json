    {
      "hadith_id": 238289,
      "book_id": 195,
      "chapter_id": null,
      "hadith_number": 3092,
      "text_ar": "حَدَّثَنَا /94 قُتَيْبَةُ L6460 /94 ، حَدَّثَنَا /26 سُفْيَانُ بْنُ عُيَيْنَةَ L3443 /26 ، عَنْ /26 عَمْرِو بْنِ دِينَارٍ L6123 /26 ، عَنْ /26 عَمْرِو بْنِ عَبْدِ اللَّهِ بْنِ صَفْوَانَ L6154 /26 ، عَنْ /26 يَزِيدَ بْنِ شَيْبَانَ L8431 /26 ، قَالَ : /27 أَتَانَا /93 ابْنُ مِرْبَعٍ الْأَنْصَارِيُّ L1119 /93 وَنَحْنُ وُقُوفٌ بِالْمَوْقِفِ مَكَانًا يُبَاعِدُهُ عَمْرٌو ، فَقَالَ : إِنِّي رَسُولُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَيْكُمْ ، يَقُولُ : /20 \" كُونُوا عَلَى مَشَاعِرِكُمْ ، فَإِنَّكُمْ عَلَى إِرْثٍ مِنْ إِرْثِ /56 إِبْرَاهِيمَ /56 \" /27 . قَالَ : /10 وَفِي الْبَاب عَنْ عَلِيٍّ ، /64 وَعَائِشَةَ /64 ، وَجُبَيْرِ بْنِ مُطْعِمٍ ، وَالشَّرِيدِ بْنِ سُوَيْدٍ الثَّقَفِيِّ /10 . قَالَ /12 أَبُو عِيسَى /12 : /10 حَدِيثُ ابْنِ مِرْبَعٍ الْأَنْصَارِيِّ",
      "sanad_ar": "حَدَّثَنَا /94 قُتَيْبَةُ L6460 /94",
      "matn_ar": "حَدَّثَنَا /26 سُفْيَانُ بْنُ عُيَيْنَةَ L3443 /26 ، عَنْ /26 عَمْرِو بْنِ دِينَارٍ L6123 /26 ، عَنْ /26 عَمْرِو بْنِ عَبْدِ اللَّهِ بْنِ صَفْوَانَ L6154 /26 ، عَنْ /26 يَزِيدَ بْنِ شَيْبَانَ L8431 /26 ، قَالَ : /27 أَتَانَا /93 ابْنُ مِرْبَعٍ الْأَنْصَارِيُّ L1119 /93 وَنَحْنُ وُقُوفٌ بِالْمَوْقِفِ مَكَانًا يُبَاعِدُهُ عَمْرٌو ، فَقَالَ : إِنِّي رَسُولُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَيْكُمْ ، يَقُولُ : /20 \" كُونُوا عَلَى مَشَاعِرِكُمْ ، فَإِنَّكُمْ عَلَى إِرْثٍ مِنْ إِرْثِ /56 إِبْرَاهِيمَ /56 \" /27 . قَالَ : /10 وَفِي الْبَاب عَنْ عَلِيٍّ ، /64 وَعَائِشَةَ /64 ، وَجُبَيْرِ بْنِ مُطْعِمٍ ، وَالشَّرِيدِ بْنِ سُوَيْدٍ الثَّقَفِيِّ /10 . قَالَ /12 أَبُو عِيسَى /12 : /10 حَدِيثُ ابْنِ مِرْبَعٍ الْأَنْصَارِيِّ",
