      "hadith_id": 22717,
      "book_id": 30,
      "chapter_id": null,
      "hadith_number": 875,
      "text_ar": "عَنْ /94 أَبِي حَنِيفَةَ L1734 /94 ، عَنْ /26 زَيْدِ بْنِ أَبِي أُنَيْسَةَ L3115 /26 ، عَنْ /26 رَجُلٍ L1131 /26 ، مِنْ أَهْلِ مِصْرَ ، قَالَ : /27 خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ وَقَدْ /20 أَخَذَ الْحَرِيرَ بِيَدٍ وَالذَّهَبَ بِيَدٍ فَقَالَ : \" هَذَانِ مُحَرَّمَانِ عَلَى الذُّكُورِ مِنْ أُمَّتِي ، حَلالٌ لإِنَاثِهِمْ \" /27 * \r\n@ 1 : 231 @ \r\n$992  992 1011 /3 /141 عَنْ /94 أَبِي حَنِيفَةَ /94 ، عَنْ /26 عَمْرِو بْنِ دِينَارٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 رَضِيَ اللَّهُ عَنْهُمَا ، أَنَّهُ \" كَانَ /20 يُزَوِّجُ بَنَاتَهُ عَلَى أَلْفِ دِينَارٍ يُحَلِّيهِنَّ مِنْ ذَلِكَ بِأَرْبَعِمِائَةِ دِينَارٍ ، وَكَانَ يُحَلِّي بَنَاتَهُ الذَّهَبَ \" /27 * \r\n$993  993 /3 /141 عَنْ /18 /94 أَبِي حَنِيفَةَ /94 /18 ، قَالَ : بَلَغَنِي /27 عَنْ /93 عُثْمَانَ بْنِ عَفَّانَ L5543 /93 ، /93 وَعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ L4461 /93 ، /93 وَعِمْرَانَ بْنِ حُصَيْنٍ L6036 /93 ، /93 وأبي هريرة L4396 /93 ، /93 وأنس بن مالك L720 /93 ، /93 وحسين بن علي L1336 /93 ، /93 وابن الزبير L4697 /93 ، /93 وشريح /93 رضي الله عنهم \" أَنَّهُمْ كَانُوا /20 يَلْبَسُونَ الْخَزَّ \" /27 * \r\n$994  994 1013 /8 /141 عَنْ /94 أَبِي حَنِيفَةَ /94 , عَنْ /26 حَمَّادٍ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 ، \" أَنَّهُ كَانَ /20 يَلْبَسُ الْمُصَبَّغَ بِالْعُصْفُرِ \" /27 * \r\n$995  995 1014 /8 /141 عَنْ /94 أَبِي حَنِيفَةَ /94 , عَنْ /26 حَمَّادٍ /26 ، قَالَ : /27 \" كَانَ /26 إِبْرَاهِيمُ /26 /20 يَخْرُجُ فَيَؤُمُّنَا فِي مِلْحَفَةٍ حَمْرَاءَ مُشْبَعَةٍ \" /27 * \r\n$996  996 1015 /8 /141 عَنْ /94 أَبِي حَنِيفَةَ /94 , عَنْ /26 حَمَّادٍ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 ، أَنَّهُ \" كَانَ /20 يَلْبَسُ قَلَنْسُوَةَ الثَّعَالِبِ \" /27 * \r\n\u0015E186 \r\n$997  997 1016 /8",
      "sanad_ar": "عَنْ /94 أَبِي حَنِيفَةَ L1734 /94",
      "matn_ar": "عَنْ /26 زَيْدِ بْنِ أَبِي أُنَيْسَةَ L3115 /26 ، عَنْ /26 رَجُلٍ L1131 /26 ، مِنْ أَهْلِ مِصْرَ ، قَالَ : /27 خَرَجَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ وَقَدْ /20 أَخَذَ الْحَرِيرَ بِيَدٍ وَالذَّهَبَ بِيَدٍ فَقَالَ : \" هَذَانِ مُحَرَّمَانِ عَلَى الذُّكُورِ مِنْ أُمَّتِي ، حَلالٌ لإِنَاثِهِمْ \" /27 * \r\n@ 1 : 231 @ \r\n$992  992 1011 /3 /141 عَنْ /94 أَبِي حَنِيفَةَ /94 ، عَنْ /26 عَمْرِو بْنِ دِينَارٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 رَضِيَ اللَّهُ عَنْهُمَا ، أَنَّهُ \" كَانَ /20 يُزَوِّجُ بَنَاتَهُ عَلَى أَلْفِ دِينَارٍ يُحَلِّيهِنَّ مِنْ ذَلِكَ بِأَرْبَعِمِائَةِ دِينَارٍ ، وَكَانَ يُحَلِّي بَنَاتَهُ الذَّهَبَ \" /27 * \r\n$993  993 /3 /141 عَنْ /18 /94 أَبِي حَنِيفَةَ /94 /18 ، قَالَ : بَلَغَنِي /27 عَنْ /93 عُثْمَانَ بْنِ عَفَّانَ L5543 /93 ، /93 وَعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ L4461 /93 ، /93 وَعِمْرَانَ بْنِ حُصَيْنٍ L6036 /93 ، /93 وأبي هريرة L4396 /93 ، /93 وأنس بن مالك L720 /93 ، /93 وحسين بن علي L1336 /93 ، /93 وابن الزبير L4697 /93 ، /93 وشريح /93 رضي الله عنهم \" أَنَّهُمْ كَانُوا /20 يَلْبَسُونَ الْخَزَّ \" /27 * \r\n$994  994 1013 /8 /141 عَنْ /94 أَبِي حَنِيفَةَ /94 , عَنْ /26 حَمَّادٍ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 ، \" أَنَّهُ كَانَ /20 يَلْبَسُ الْمُصَبَّغَ بِالْعُصْفُرِ \" /27 * \r\n$995  995 1014 /8 /141 عَنْ /94 أَبِي حَنِيفَةَ /94 , عَنْ /26 حَمَّادٍ /26 ، قَالَ : /27 \" كَانَ /26 إِبْرَاهِيمُ /26 /20 يَخْرُجُ فَيَؤُمُّنَا فِي مِلْحَفَةٍ حَمْرَاءَ مُشْبَعَةٍ \" /27 * \r\n$996  996 1015 /8 /141 عَنْ /94 أَبِي حَنِيفَةَ /94 , عَنْ /26 حَمَّادٍ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 ، أَنَّهُ \" كَانَ /20 يَلْبَسُ قَلَنْسُوَةَ الثَّعَالِبِ \" /27 * \r\n\u0015E186 \r\n$997  997 1016 /8",
