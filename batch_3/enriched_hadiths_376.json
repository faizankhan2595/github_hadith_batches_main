      "hadith_id": 23629,
      "book_id": 35,
      "chapter_id": null,
      "hadith_number": 250,
      "text_ar": "حَدَّثَنَا /94 قَيْسُ بْنُ الرَّبِيعِ L6514 /94 ، عَنْ /26 عَمْرِو بْنِ مَيْمُونِ بْنِ مِهْرَانَ L6208 /26 ، عَنْ /26 أَبِيهِ L7822 /26 ، قَالَ : /27 مَرَّ عَلَى /93 عُمَرَ بْنِ الْخَطَّابِ L5913 /93 رَجُلٌ مَعَهُ لَحْمٌ ، فَقَالَ \" مَا هَذَا ؟ \" قَالَ : لَحَمْتُ أَهْلِي ، قَالَ : \" حَسَنٌ \" ، ثُمَّ مَرَّ عَلَيْهِ مَرَّتَيْنِ ، كُلُّ ذَلِكَ يَقُولُ : \" حَسَنٌ \" ، فَمَرَّ عَلَيْهِ الثَّالِثَةَ فَعَلاهُ بِالدِّرَّةَ ، ثُمَّ قَالَ : /20 \" إِيَّاكُمْ وَالأَحْمَرَيْنِ ، فَإِنَّهُ مَمْرَقَةٌ لِلدِّينِ ، مَفْسَدَةٌ لِلْمَالِ \" /27 * \r\n@ 1 : 324 @ \r\n$254  254 /8",
      "sanad_ar": "حَدَّثَنَا /94 قَيْسُ بْنُ الرَّبِيعِ L6514 /94",
      "matn_ar": "عَنْ /26 عَمْرِو بْنِ مَيْمُونِ بْنِ مِهْرَانَ L6208 /26 ، عَنْ /26 أَبِيهِ L7822 /26 ، قَالَ : /27 مَرَّ عَلَى /93 عُمَرَ بْنِ الْخَطَّابِ L5913 /93 رَجُلٌ مَعَهُ لَحْمٌ ، فَقَالَ \" مَا هَذَا ؟ \" قَالَ : لَحَمْتُ أَهْلِي ، قَالَ : \" حَسَنٌ \" ، ثُمَّ مَرَّ عَلَيْهِ مَرَّتَيْنِ ، كُلُّ ذَلِكَ يَقُولُ : \" حَسَنٌ \" ، فَمَرَّ عَلَيْهِ الثَّالِثَةَ فَعَلاهُ بِالدِّرَّةَ ، ثُمَّ قَالَ : /20 \" إِيَّاكُمْ وَالأَحْمَرَيْنِ ، فَإِنَّهُ مَمْرَقَةٌ لِلدِّينِ ، مَفْسَدَةٌ لِلْمَالِ \" /27 * \r\n@ 1 : 324 @ \r\n$254  254 /8",
