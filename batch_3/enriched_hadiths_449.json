    {
      "hadith_id": 24728,
      "book_id": 42,
      "chapter_id": null,
      "hadith_number": 229,
      "text_ar": "حَدَّثَنَا /94 جَعْفَرُ بْنُ بُرْقَانَ L2143 /94 ، عَنْ /26 مَيْمُونِ بْنِ مِهْرَانَ L7822 /26 ، قَالَ : /27 قَالَ /93 أَبُو الدَّرْدَاءِ L6271 /93 : /20 \" وَيْلٌ للَّذِي لا يَعْلَمُ مَرَّةً ، وَوَيْلٌ للَّذِي يَعْلَمُ وَلا يَعْمَلُ سَبْعَ مَرَّاتٍ \" /27 * \r\n$212  212 /3",
