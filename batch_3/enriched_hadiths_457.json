    {
      "hadith_id": 24847,
      "book_id": 42,
      "chapter_id": null,
      "hadith_number": 348,
      "text_ar": "حَدَّثَنَا /94 قَيْسٌ L6514 /94 ، عَنْ /26 لَيْثٍ L6638 /26 ، عَنْ /18 /26 رَجُلٍ L1131 /26 /18 ، /27 عَنْ /93 عَبْدِ اللَّهِ بْنِ مَسْعُودٍ L5079 /93 ، قَالَ : /20 \" لا يشبه الزِّيُّ الزِّيَّ حَتَّى تشبه الْقُلُوبُ الْقُلُوبَ \" /27 * \r\n$319  319 /8",
