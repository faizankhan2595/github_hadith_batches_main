    {
      "hadith_id": 920720,
      "book_id": 1411,
      "chapter_id": null,
      "hadith_number": 1821,
      "text_ar": "سَمِعَ ببغداد من شهدة ، وغيرها ، وسمع بأصبهان الحافظ أبا مُوسَى المديني ، وكتبت عَنْهُ بأربل \r\n$9  9 /2 /141 أَخْبَرَتْكُمْ شُهْدَةُ ، أَنْبَأَنَا  /26  النِّعَالِيُّ L57060  /26  ، أَنْبَأَنَا  /26  ابْنُ بِشْرَانَ L24752  /26  ، أَنْبَأَنَا الصَّقَّارُ ، حَدَّثنا  /26  عَبْدُ اللَّهِ بْنُ شَاكِرٍ L23036  /26  ، حَدَّثنا  /26  أَبُو أُسَامَةَ L2484  /26  ، حَدَّثنا  /26  سَعِيدُ بْنُ أَبِي عَرُوبَةَ L3281  /26  ، عَنْ  /26  قَتَادَةَ L6458  /26  ، /27 عَنْ  /93  أَنَسّ L720  /93  ، قَالَ : /20 كَانَ رَسُولُ اللَّهِ أَخَفَّ النَّاسِ صَلاةً فِي تَمَامٍ /27  * \r\nقَالَ لي : ولدت فِي شوال ، سنة خمس وخمسين وخمس مائة ، قلت : توفي فِي محرم ، سنة أربع وثلاثين وست مائة بدمشق ، وحدث عَنْهُ : الحافظ الضياء والبرزالي ، ومن المتأخرين حَدَّثنا عَنْهُ : عليّ بْن بقاء ، وأحمد بْن مؤمن ، ومحمد بْن أَبِي العز ، وجماعة .\u001dE163",
      "sanad_ar": "سَمِعَ ببغداد من شهدة",
      "matn_ar": "وغيرها ، وسمع بأصبهان الحافظ أبا مُوسَى المديني ، وكتبت عَنْهُ بأربل \r\n$9  9 /2 /141 أَخْبَرَتْكُمْ شُهْدَةُ ، أَنْبَأَنَا  /26  النِّعَالِيُّ L57060  /26  ، أَنْبَأَنَا  /26  ابْنُ بِشْرَانَ L24752  /26  ، أَنْبَأَنَا الصَّقَّارُ ، حَدَّثنا  /26  عَبْدُ اللَّهِ بْنُ شَاكِرٍ L23036  /26  ، حَدَّثنا  /26  أَبُو أُسَامَةَ L2484  /26  ، حَدَّثنا  /26  سَعِيدُ بْنُ أَبِي عَرُوبَةَ L3281  /26  ، عَنْ  /26  قَتَادَةَ L6458  /26  ، /27 عَنْ  /93  أَنَسّ L720  /93  ، قَالَ : /20 كَانَ رَسُولُ اللَّهِ أَخَفَّ النَّاسِ صَلاةً فِي تَمَامٍ /27  * \r\nقَالَ لي : ولدت فِي شوال ، سنة خمس وخمسين وخمس مائة ، قلت : توفي فِي محرم ، سنة أربع وثلاثين وست مائة بدمشق ، وحدث عَنْهُ : الحافظ الضياء والبرزالي ، ومن المتأخرين حَدَّثنا عَنْهُ : عليّ بْن بقاء ، وأحمد بْن مؤمن ، ومحمد بْن أَبِي العز ، وجماعة .\u001dE163",
