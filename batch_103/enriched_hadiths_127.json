    {
      "hadith_id": 919904,
      "book_id": 1411,
      "chapter_id": null,
      "hadith_number": 1005,
      "text_ar": "أخو الحافظ يُوْسٌف ، وإسماعيل أسن ، كَانَ صوفيًا برباط الأرجواني ، سَمِعَ : أبا بَكْر الْأَنْصَارِيّ ، وإسماعيل بْن السَّمَرْقَنْدِيّ ، وأبا مُحَمَّد بْن الطراح ، وأبا سعد البغدادي ، ولد سنة أربع وعشرين وخمس مائة ، وتوفي فِي رمضان ، سنة ست مائة ، روى عَنْهُ حديثًا ، روى عَنْهُ ابْنُ النجار ، وقَالَ : كَانَ ظريفًا ، كيسًا ، متوددًا ، جميل الطريقة .\u001cE91",
      "sanad_ar": "أخو الحافظ يُوْسٌف",
      "matn_ar": "وإسماعيل أسن ، كَانَ صوفيًا برباط الأرجواني ، سَمِعَ : أبا بَكْر الْأَنْصَارِيّ ، وإسماعيل بْن السَّمَرْقَنْدِيّ ، وأبا مُحَمَّد بْن الطراح ، وأبا سعد البغدادي ، ولد سنة أربع وعشرين وخمس مائة ، وتوفي فِي رمضان ، سنة ست مائة ، روى عَنْهُ حديثًا ، روى عَنْهُ ابْنُ النجار ، وقَالَ : كَانَ ظريفًا ، كيسًا ، متوددًا ، جميل الطريقة .\u001cE91",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
