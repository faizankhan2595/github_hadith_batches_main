    {
      "hadith_id": 78863,
      "book_id": 80,
      "chapter_id": null,
      "hadith_number": 478,
      "text_ar": "/27 حَدَّثَنَا /94 عَبْدُ اللَّهِ بْنُ أَحْمَدَ /94 ، قَالَ : سَأَلْتُ /26 أَبِي /26 عَنْ /20 أَبِي قَيْسٍ عَبْدِ الرَّحْمَنِ بْنِ ثَرْوَانَ ؟ فقَالَ : \" هُوَ كَذَا وَكَذَا ، أَوْ قَالَ : يُخَالِفُ فِي حَدِيثِهِ ، رَوَى عَنْهُ الأَعْمَشُ ، وَشُعْبَةُ ، وَسُفْيَانُ \" /27 * \r\n$459  459 /8",
      "sanad_ar": "/27 حَدَّثَنَا /94 عَبْدُ اللَّهِ بْنُ أَحْمَدَ /94",
      "matn_ar": "قَالَ : سَأَلْتُ /26 أَبِي /26 عَنْ /20 أَبِي قَيْسٍ عَبْدِ الرَّحْمَنِ بْنِ ثَرْوَانَ ؟ فقَالَ : \" هُوَ كَذَا وَكَذَا ، أَوْ قَالَ : يُخَالِفُ فِي حَدِيثِهِ ، رَوَى عَنْهُ الأَعْمَشُ ، وَشُعْبَةُ ، وَسُفْيَانُ \" /27 * \r\n$459  459 /8",
