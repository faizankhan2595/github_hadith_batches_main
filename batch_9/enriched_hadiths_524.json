      "chapter_id": null,
      "hadith_number": 1466,
      "text_ar": "حَدَّثَنَا /94 إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ /94 ، نَا /26 ابْنُ عُيَيْنَةَ /26 ، /27 عَنِ /26 ابْنِ الْمُنْكَدِرِ /26 ، قَالَ : قَالَتْ لِي أُمِّي : /20 \" لا تُمَازِحِ الصِّبْيَانَ فَتَهُونَ عَلَيْهِمْ \" /27 * \r\n$1448  1448 /8 /141 حَدَّثَنَا /94 أَبُو إِبْرَاهِيمَ التَّرْجُمَانِيُّ /94 ، نَا /26 عَبْدُ الْعَزِيزِ بْنُ الْمَاجِشُونِ /26 ، قَالَ : /27 رَأَيْتُ /26 مُحَمَّدَ بْنَ الْمُنْكَدِرِ /26 ، /20 وَعَلَيْهِ ثَوْبَانِ مَتِينَانٍ إِزَارٌ وَرِدَاءٌ ، وَرَأَيْتُهُ يُصَفِّرُ لِحْيَتِهِ وَرَأْسَهُ بِالْحِنَّاءِ \" /27 * \r\n$1449  1449 /8",
      "sanad_ar": "حَدَّثَنَا /94 إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ /94",
      "matn_ar": "نَا /26 ابْنُ عُيَيْنَةَ /26 ، /27 عَنِ /26 ابْنِ الْمُنْكَدِرِ /26 ، قَالَ : قَالَتْ لِي أُمِّي : /20 \" لا تُمَازِحِ الصِّبْيَانَ فَتَهُونَ عَلَيْهِمْ \" /27 * \r\n$1448  1448 /8 /141 حَدَّثَنَا /94 أَبُو إِبْرَاهِيمَ التَّرْجُمَانِيُّ /94 ، نَا /26 عَبْدُ الْعَزِيزِ بْنُ الْمَاجِشُونِ /26 ، قَالَ : /27 رَأَيْتُ /26 مُحَمَّدَ بْنَ الْمُنْكَدِرِ /26 ، /20 وَعَلَيْهِ ثَوْبَانِ مَتِينَانٍ إِزَارٌ وَرِدَاءٌ ، وَرَأَيْتُهُ يُصَفِّرُ لِحْيَتِهِ وَرَأْسَهُ بِالْحِنَّاءِ \" /27 * \r\n$1449  1449 /8",
