    {
      "hadith_id": 79607,
      "book_id": 80,
      "chapter_id": null,
      "hadith_number": 1222,
      "text_ar": "/34 وَبِإِسْنَادِهِ ، /27 عَنْ /26 مُحَمَّدِ بْنِ ثَابِتٍ الْبُنَانِيِّ /26 ، قَالَ : /20 \" ذَهَبْتُ أُلَقِّنُ أَبِي وَهُوَ فِي الْمَوْتِ ، قَالَ : قُلْتُ : يَا أَبَهْ ، قُلْ : لا إِلَهَ إِلا اللَّهُ ، قَالَ : يَا بُنَيَّ ، خَلِّ عَنِّي ، فَإِنِّي فِي وِرْدِي السَّادِسِ ، أَوِ السَّابِعِ \" /27 * \r\n$1211  1211 /8",
      "sanad_ar": "/34 وَبِإِسْنَادِهِ",
      "matn_ar": "/27 عَنْ /26 مُحَمَّدِ بْنِ ثَابِتٍ الْبُنَانِيِّ /26 ، قَالَ : /20 \" ذَهَبْتُ أُلَقِّنُ أَبِي وَهُوَ فِي الْمَوْتِ ، قَالَ : قُلْتُ : يَا أَبَهْ ، قُلْ : لا إِلَهَ إِلا اللَّهُ ، قَالَ : يَا بُنَيَّ ، خَلِّ عَنِّي ، فَإِنِّي فِي وِرْدِي السَّادِسِ ، أَوِ السَّابِعِ \" /27 * \r\n$1211  1211 /8",
