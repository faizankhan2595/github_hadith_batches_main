      "hadith_id": 79608,
      "book_id": 80,
      "chapter_id": null,
      "hadith_number": 1223,
      "text_ar": "قَالَ /26 جَعْفَرٌ /26 , /27 وَقَالَ لِي /26 مُحَمَّدُ بْنُ ثَابِتٍ /26 : يَا أَبَا سُلَيْمَانَ ، إِنْ /20 كُنْتَ لَمِنْ حَصَى مَسْجِدِ أَبِي /27 ، قَالَ /26 جَعْفَرٌ /26 : \" وَاخْتَلَفْتُ إِلَى ثَابِتٍ عَشْرَ سِنِينَ ، وَإِلَى مَالِكِ بْنِ دِينَارٍ عَشْرَ سِنِينَ \" * \r\n$1212  1212 /8",
      "sanad_ar": "قَالَ /26 جَعْفَرٌ /26 , /27 وَقَالَ لِي /26 مُحَمَّدُ بْنُ ثَابِتٍ /26",
      "matn_ar": "يَا أَبَا سُلَيْمَانَ ، إِنْ /20 كُنْتَ لَمِنْ حَصَى مَسْجِدِ أَبِي /27 ، قَالَ /26 جَعْفَرٌ /26 : \" وَاخْتَلَفْتُ إِلَى ثَابِتٍ عَشْرَ سِنِينَ ، وَإِلَى مَالِكِ بْنِ دِينَارٍ عَشْرَ سِنِينَ \" * \r\n$1212  1212 /8",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/26,/26,/27,/26,/26,/20,/27,/26,/26,/8",
