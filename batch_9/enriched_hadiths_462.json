    {
      "hadith_id": 78925,
      "book_id": 80,
      "chapter_id": null,
      "hadith_number": 540,
      "text_ar": "حَدَّثَنَا /94 عَلِيٌّ /94 ، أنا /26 شُعْبَةُ /26 ، عَنْ /26 أَبِي حُصَيْنٍ /26 ، قَالَ : سَمِعْتُ /26 أَبَا عَبْدِ الرَّحْمَنِ السُّلَمِيَّ L2069 /26 ، يَقُولُ : /27 قَالَ /93 عُمَرُ L5913 /93 رَضِيَ اللَّهُ عَنْهُ : /20 \" أَمْسَوْا فَقَدْ سُنَّتْ لَكُمُ الرَّكْبُ \" /27 * \r\n$513  513 /3 /141 حَدَّثَنَا /94 عَلِيٌّ /94 ، أنا /26 شُعْبَةُ /26 ، عَنْ /26 أَبِي حُصَيْنٍ L5526 /26 ، عَنِ /26 الشَّعْبِيِّ L4099 /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 : أَنَّهُ /20 \" صَلَّى عَلَى أَخِيهِ وَأُمِّهِ أُمِّ كُلْثُومٍ بِنْتِ عَلِيٍّ ، فَجَعَلَ الْغُلامَ مِمَّا يَلِي الإِمَامَ وَالْمَرْأَةَ فَوْقَ ذَلِكَ \" /27 * \r\n\u001aE91 \r\n$514  514 /8",
      "sanad_ar": "حَدَّثَنَا /94 عَلِيٌّ /94",
      "matn_ar": "أنا /26 شُعْبَةُ /26 ، عَنْ /26 أَبِي حُصَيْنٍ /26 ، قَالَ : سَمِعْتُ /26 أَبَا عَبْدِ الرَّحْمَنِ السُّلَمِيَّ L2069 /26 ، يَقُولُ : /27 قَالَ /93 عُمَرُ L5913 /93 رَضِيَ اللَّهُ عَنْهُ : /20 \" أَمْسَوْا فَقَدْ سُنَّتْ لَكُمُ الرَّكْبُ \" /27 * \r\n$513  513 /3 /141 حَدَّثَنَا /94 عَلِيٌّ /94 ، أنا /26 شُعْبَةُ /26 ، عَنْ /26 أَبِي حُصَيْنٍ L5526 /26 ، عَنِ /26 الشَّعْبِيِّ L4099 /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 : أَنَّهُ /20 \" صَلَّى عَلَى أَخِيهِ وَأُمِّهِ أُمِّ كُلْثُومٍ بِنْتِ عَلِيٍّ ، فَجَعَلَ الْغُلامَ مِمَّا يَلِي الإِمَامَ وَالْمَرْأَةَ فَوْقَ ذَلِكَ \" /27 * \r\n\u001aE91 \r\n$514  514 /8",
