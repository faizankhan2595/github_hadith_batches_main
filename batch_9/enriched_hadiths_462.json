      "hadith_id": 78917,
      "book_id": 80,
      "chapter_id": null,
      "hadith_number": 532,
      "text_ar": "حَدَّثَنَا /94 مَحْمُودٌ /94 ، نا /26 مُؤَمَّلُ /26 ، عَنْ /26 حَمَّادِ بْنِ سَلَمَةَ /26 ، /27 عَنْ /26 سِمَاكِ بْنِ حَرْبٍ /26 ، قَالَ : /20 \" أَدْرَكْتُ ثَمَانِينَ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" /27 ، وَكَانَ سِمَاكٌ يُكْنَى بِأَبِي الْمُغِيرَةِ ، حَدَّثَنِي بِذَلِكَ /94 ابْنُ زَنْجُوَيْهِ /94 ، عَنْ /26 أَبِي حُذَيْفَةَ /26 ، عَنْ /26 سَعِيدِ بْنِ سِمَاكٍ /26 ، حَدَّثَنِي /26 أَحْمَدُ بْنُ زُهَيْرٍ /26 ، قَالَ : سَمِعْتُ /26 يَحْيَى بْنَ مَعِينٍ /26 ، سُئِلَ عَنْ سِمَاكِ بْنِ حَرْبٍ : \" مَا الَّذِي عَابَهُ ؟ قَالَ : أَسْنَدَ أَحَادِيثَ لَمْ يُسْنِدْهَا غَيْرُهُ \" ، قَالَ يَحْيَى : وَسِمَاكٌ ثِقَةٌ * \r\n$508  508 /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ حُمَيْدٍ /94 ، نا /26 جَرِيرٌ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سِمَاكًا /26 /20 يَبُولُ قَائِمًا \" /27 * \r\n\u001bE90",
      "sanad_ar": "حَدَّثَنَا /94 مَحْمُودٌ /94",
      "matn_ar": "نا /26 مُؤَمَّلُ /26 ، عَنْ /26 حَمَّادِ بْنِ سَلَمَةَ /26 ، /27 عَنْ /26 سِمَاكِ بْنِ حَرْبٍ /26 ، قَالَ : /20 \" أَدْرَكْتُ ثَمَانِينَ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" /27 ، وَكَانَ سِمَاكٌ يُكْنَى بِأَبِي الْمُغِيرَةِ ، حَدَّثَنِي بِذَلِكَ /94 ابْنُ زَنْجُوَيْهِ /94 ، عَنْ /26 أَبِي حُذَيْفَةَ /26 ، عَنْ /26 سَعِيدِ بْنِ سِمَاكٍ /26 ، حَدَّثَنِي /26 أَحْمَدُ بْنُ زُهَيْرٍ /26 ، قَالَ : سَمِعْتُ /26 يَحْيَى بْنَ مَعِينٍ /26 ، سُئِلَ عَنْ سِمَاكِ بْنِ حَرْبٍ : \" مَا الَّذِي عَابَهُ ؟ قَالَ : أَسْنَدَ أَحَادِيثَ لَمْ يُسْنِدْهَا غَيْرُهُ \" ، قَالَ يَحْيَى : وَسِمَاكٌ ثِقَةٌ * \r\n$508  508 /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ حُمَيْدٍ /94 ، نا /26 جَرِيرٌ /26 ، قَالَ : /27 \" رَأَيْتُ /26 سِمَاكًا /26 /20 يَبُولُ قَائِمًا \" /27 * \r\n\u001bE90",
      "grade": null,
