    {
      "hadith_id": 72287,
      "book_id": 70,
      "chapter_id": null,
      "hadith_number": 2003,
      "text_ar": "نا /94 سُفْيَانُ /94 ، نا /26 هُشَيْمٌ /26 ، عَنْ /26 يَحْيَى بْنِ سَعِيدٍ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ الْمُسَيِّبِ /26 ،  @ 2 : 56 @    فِي /20 الرَّجُلِ يَعْجِزُ عَنْ نَفَقَةِ امْرَأَتِهِ ، قَالَ : \" يُنْفِقُ عَلَيْهَا ، أَوْ يُفَرَّقُ بَيْنَهُمَا \" /27 . نا هُشَيْمٌ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : \" إِنْ وَجَدَ أَنْفَقَ ، وَإِنْ لَمْ يَجِدْ لَمْ يُكَلَّفْ إِلا مَا يُطِيقُ \" . نا /94 هُشَيْمٌ /94 ، أنا /26 أَشْعَثُ /26 ، عَنِ /26 الشَّعْبِيِّ /26 ، أَنَّهُ قَالَ : \" يُنْفِقُ عَلَيْهَا أَوْ يُطَلِّقُهَا \" . حَدَّثَنَا /94 هُشَيْمٌ /94 ، أنا /26 يُونُسُ /26 ، عَنِ /26 الْحَسَنِ /26 ، قَالَ : \" يُنْفِقُ عَلَيْهَا ، أَوْ يُطَلِّقُهَا \" . نا هُشَيْمٌ ، عَنِ ابْنِ شُبْرُمَةَ ، قَالَ : \" إِنْ وَجَدَ أَنْفَقَ ، وَإِنْ لَمْ يَجِدْ لَمْ يُكَلَّفْ مَا لا يُطِيقُ \" * \r\n$1893  1891 /3",
      "sanad_ar": "نا /94 سُفْيَانُ /94",
      "matn_ar": "نا /26 هُشَيْمٌ /26 ، عَنْ /26 يَحْيَى بْنِ سَعِيدٍ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ الْمُسَيِّبِ /26 ،  @ 2 : 56 @    فِي /20 الرَّجُلِ يَعْجِزُ عَنْ نَفَقَةِ امْرَأَتِهِ ، قَالَ : \" يُنْفِقُ عَلَيْهَا ، أَوْ يُفَرَّقُ بَيْنَهُمَا \" /27 . نا هُشَيْمٌ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِيِّ ، قَالَ : \" إِنْ وَجَدَ أَنْفَقَ ، وَإِنْ لَمْ يَجِدْ لَمْ يُكَلَّفْ إِلا مَا يُطِيقُ \" . نا /94 هُشَيْمٌ /94 ، أنا /26 أَشْعَثُ /26 ، عَنِ /26 الشَّعْبِيِّ /26 ، أَنَّهُ قَالَ : \" يُنْفِقُ عَلَيْهَا أَوْ يُطَلِّقُهَا \" . حَدَّثَنَا /94 هُشَيْمٌ /94 ، أنا /26 يُونُسُ /26 ، عَنِ /26 الْحَسَنِ /26 ، قَالَ : \" يُنْفِقُ عَلَيْهَا ، أَوْ يُطَلِّقُهَا \" . نا هُشَيْمٌ ، عَنِ ابْنِ شُبْرُمَةَ ، قَالَ : \" إِنْ وَجَدَ أَنْفَقَ ، وَإِنْ لَمْ يَجِدْ لَمْ يُكَلَّفْ مَا لا يُطِيقُ \" * \r\n$1893  1891 /3",
