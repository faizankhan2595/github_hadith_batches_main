      "hadith_id": 72319,
      "book_id": 70,
      "chapter_id": null,
      "hadith_number": 2035,
      "text_ar": "نا /94 هُشَيْمٌ /94 ، أنا /26 دَاوُدُ /26 ، قَالَ : /27 سَمِعْتُ /26 الشَّعْبِيَّ /26 ، يَقُولُ : /20 \" إِذَا نَكَسَ فِي الْخَلْقِ الرَّابِعِ فَكَانَ مُخَلَّقًا انْقَضَتْ عِدَّةُ الْحُرَّةِ وَأُعْتِقَتْ بِهِ الأَمَةُ \" /27 * \r\n$1922  1920 /8",
      "sanad_ar": "نا /94 هُشَيْمٌ /94",
      "matn_ar": "أنا /26 دَاوُدُ /26 ، قَالَ : /27 سَمِعْتُ /26 الشَّعْبِيَّ /26 ، يَقُولُ : /20 \" إِذَا نَكَسَ فِي الْخَلْقِ الرَّابِعِ فَكَانَ مُخَلَّقًا انْقَضَتْ عِدَّةُ الْحُرَّةِ وَأُعْتِقَتْ بِهِ الأَمَةُ \" /27 * \r\n$1922  1920 /8",
