    {
      "hadith_id": 72476,
      "book_id": 70,
      "chapter_id": null,
      "hadith_number": 2192,
      "text_ar": "نا /94 حَمَّادُ بْنُ زَيْدٍ /94 ، عَنْ /26 عَاصِمِ بْنِ أَبِي النَّجُودِ /26 ، عَنْ /26 زِرِّ بْنِ حُبَيْشٍ /26 ، /27 عَنْ /93 عَلِيٍّ L5722 /93 رَضِيَ اللَّهُ عَنْهُ ، أَنَّهُ قَالَ فِي /20 الْعَزْلِ : \" ذَلِكَ الْوَأْدُ الْخَفِيُّ \" /27 * \r\n$2069  2067 /8 /141 نا /94 الْمُعْتَمِرُ بْنُ سُلَيْمَانَ /94 ، حَدَّثَنِي /26 أَبِي /26 ، عَنْ /26 يَحْيَى بْنِ عَبَّادٍ /26 ، /27 أَنَّ /26 هُبَيْرَةَ بْنَ خَباب بْنِ الأَرَتِّ /26 \" كَانَ /20 يَعْزِلُ عَنْ سَرَارِيهِ \" /27 * \r\n$2070  2068 /3 /141 نا /94 إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ /94 ، عَنْ /26 سُلَيْمَانَ التَّيْمِيِّ /26 ، قَالَ : حَدَّثَتْنِي /26 أُمُّ عَطَاءٍ /26 ، عَنْ /26 أُمِّ وَلَدٍ لِخَباب /26 ، /27 أَنَّ /93 خَبَّابًا L2698 /93 \" كَانَ /20 يَعْزِلُ عَنْهَا \" /27 * \r\n$2071  2069 /3",
      "sanad_ar": "نا /94 حَمَّادُ بْنُ زَيْدٍ /94",
