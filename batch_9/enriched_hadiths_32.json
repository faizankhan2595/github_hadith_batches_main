    {
      "hadith_id": 72467,
      "book_id": 70,
      "chapter_id": null,
      "hadith_number": 2183,
      "text_ar": "نا /94 فُضَيْلُ بْنُ عِيَاضٍ /94 ، عَنْ /26 هِشَامٍ /26 ، /27 عَنِ /26 ابْنِ سِيرِينَ /26 فِي /20 الرَّجُلِ يَشْتَرِي الْجَارِيَةَ ، قَالَ : \" لا يَمَسَّهَا وَلا يَضَعْ يَدَهُ عَلَيْهَا حَتَّى يَسْتَبْرِئَهَا \" /27 . نا فُضَيْلٌ ، عَنْ هِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : \" يُصِيبُ مِنْهَا مَا شَاءَ مَا لَمْ يَمَسَّ فَرْجَهَا \" * \r\n@ 2 : 97 @ \r\n$2060  2058 /8",
      "sanad_ar": "نا /94 فُضَيْلُ بْنُ عِيَاضٍ /94",
