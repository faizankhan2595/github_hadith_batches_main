      "chapter_id": null,
      "hadith_number": 1898,
      "text_ar": "نا /94 سُفْيَانُ /94 ، عَنْ /26 أَبِي إِسْحَاقَ الشَّيْبَانِيِّ /26 ، عَنِ /26 الشَّعْبِيِّ /26 ، عَنْ /26 عَمْرِو بْنِ سَلَمَةَ /26 ، قَالَ : /27 قَالَ /93 عَلِيٌّ L5722 /93 رَضِيَ اللَّهُ عَنْهُ : /20 \" إِذَا آلَى الرَّجُلُ مِنِ امْرَأَتِهِ فَإِنَّهُ يُوقَفُ حَتَّى يَفِيءَ أَوْ يُطَلِّقَ \" /27 . نا /94 سُفْيَانُ /94 ، عَنْ /26 لَيْثٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، عَنْ /26 مَرْوَانَ /26 ، عَنْ /93 عَلِيٍّ L5722 /93 ، مِثْلَهُ * \r\n$1795  1793 /3",
      "sanad_ar": "نا /94 سُفْيَانُ /94",
      "matn_ar": "عَنْ /26 أَبِي إِسْحَاقَ الشَّيْبَانِيِّ /26 ، عَنِ /26 الشَّعْبِيِّ /26 ، عَنْ /26 عَمْرِو بْنِ سَلَمَةَ /26 ، قَالَ : /27 قَالَ /93 عَلِيٌّ L5722 /93 رَضِيَ اللَّهُ عَنْهُ : /20 \" إِذَا آلَى الرَّجُلُ مِنِ امْرَأَتِهِ فَإِنَّهُ يُوقَفُ حَتَّى يَفِيءَ أَوْ يُطَلِّقَ \" /27 . نا /94 سُفْيَانُ /94 ، عَنْ /26 لَيْثٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، عَنْ /26 مَرْوَانَ /26 ، عَنْ /93 عَلِيٍّ L5722 /93 ، مِثْلَهُ * \r\n$1795  1793 /3",
