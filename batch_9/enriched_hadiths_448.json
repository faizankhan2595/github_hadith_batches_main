      "hadith_id": 78712,
      "book_id": 80,
      "chapter_id": null,
      "hadith_number": 327,
      "text_ar": "حَدَّثَنَا /94 جَدِّي /94 ، نا /26 مُوسَى بْنُ دَاوُدَ /26 ، عَنْ /26 شَرِيكٍ /26 ، عَنْ /26 جَامِعِ أَبِي صَخْرَةَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 حَمَّادًا /26 يَكْتُبُ عِنْدَ إِبْرَاهِيمَ ، وَيَقُولُ : إِنَّا /20 لا نُرِيدُ بِهِ دُنْيَا \" /27 * \r\n$307  307 /8",
      "sanad_ar": "حَدَّثَنَا /94 جَدِّي /94",
      "matn_ar": "نا /26 مُوسَى بْنُ دَاوُدَ /26 ، عَنْ /26 شَرِيكٍ /26 ، عَنْ /26 جَامِعِ أَبِي صَخْرَةَ /26 ، قَالَ : /27 \" رَأَيْتُ /26 حَمَّادًا /26 يَكْتُبُ عِنْدَ إِبْرَاهِيمَ ، وَيَقُولُ : إِنَّا /20 لا نُرِيدُ بِهِ دُنْيَا \" /27 * \r\n$307  307 /8",
