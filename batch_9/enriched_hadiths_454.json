    {
      "hadith_id": 78797,
      "book_id": 80,
      "chapter_id": null,
      "hadith_number": 412,
      "text_ar": "حَدَّثَنَا /94 عَلِيٌّ /94 ، أنا /26 شُعْبَةُ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، قَالَ : /27 سَمِعْتُ /26 مَسْرُوقًا /26 : /20 \" يَكْرَهُ صَاعَ الْبُسْرِ بِالصَّاعِ الرُّطَبِ \" /27 * \r\n$396  396 /8 /141 حَدَّثَنَا /94 عَلِيٌّ /94 ، أنا /26 شُعْبَةُ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، قَالَ : سَمِعْتُ /26 أَبَا وَائِلٍ /26 ، قال : /27 \" كُنْتُ مَعَ /26 مَسْرُوقٍ /26 فِي السِّلْسِلَةِ ، فَمَا رَأَيْتُ أَمِيرًا وَلا عَامِلا أَعَفَّ مِنْهُ ، /20 مَا كَانَ يُصِيبُ شَيْئًا إِلا مَاءَ دِجْلَةَ \" /27 * \r\n$397  397 /3",
      "sanad_ar": "حَدَّثَنَا /94 عَلِيٌّ /94",
      "matn_ar": "أنا /26 شُعْبَةُ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، قَالَ : /27 سَمِعْتُ /26 مَسْرُوقًا /26 : /20 \" يَكْرَهُ صَاعَ الْبُسْرِ بِالصَّاعِ الرُّطَبِ \" /27 * \r\n$396  396 /8 /141 حَدَّثَنَا /94 عَلِيٌّ /94 ، أنا /26 شُعْبَةُ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، قَالَ : سَمِعْتُ /26 أَبَا وَائِلٍ /26 ، قال : /27 \" كُنْتُ مَعَ /26 مَسْرُوقٍ /26 فِي السِّلْسِلَةِ ، فَمَا رَأَيْتُ أَمِيرًا وَلا عَامِلا أَعَفَّ مِنْهُ ، /20 مَا كَانَ يُصِيبُ شَيْئًا إِلا مَاءَ دِجْلَةَ \" /27 * \r\n$397  397 /3",
