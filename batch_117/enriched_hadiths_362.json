    {
      "hadith_id": 1049422,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 58868,
      "text_ar": "2 .   وقال /26 أَبُو أَحْمَدَ بْنُ عَدِيٍّ /26 : حدثنا /26 عَبْدُ اللَّهِ بْنُ سُلَيْمَانَ بْنِ الأَشْعَثِ /26 ، قال : أخبرنا /26 أَبُو عُبَيْدِ اللَّهِ الْبَزَّارُ يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ /26 ، قال : حدثنا /26 يَحْيَى بْنُ كَثِيرٍ /26 ، قال : حدثنا /26 شُعْبَةُ /26 ، عَنْ /26 أَبِي فَرْوَةَ /26 ، عَنْ /26 مَيْمُونَ بْنِ مِهْرَانَ /26 ، عَنِ /93 ابْنِ عُمَرَ /93 ، عَنِ النَّبِيِّ صلى الله عليه وسلم ، قال : \" مَنْ أُتِيَ فَقَاتَلَ فَقُتِلَ دُونَ مَالِهِ فَهُوَ شَهِيدٌ \" ، قال أَبُو أَحْمَدَ بْنُ عَدِيٍّ ، قال لَنَا عَبْدُ اللَّهِ بْنُ سُلَيْمَانَ : لَمْ يَرْوِ شُعْبَةُ عَنْ أَبِي فَرْوَةَ هَذَا غَيْرَ هَذَا الْحَدِيثِ ، وهُوَ أَبُو فَرْوَةَ يَزِيدُ بْنُ سِنَانٍ الْجَزَرِيُّ ، وفِي حَدِيثِهِ لِينٌ   وقَدْ رَوَى شُعْبَةُ عَنِ اثْنَيْنِ ، يُكَنَّيَانِ أَبَا فَرْوَةَ ، غَيْرَ هَذَا : أَبُو فَرْوَةَ مُسْلِمُ بْنُ سَالِمٍ الْجُهَنِيُّ كُوفِيٌّ ، يَرْوِي عَنْ : عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، وأَبُو فَرْوَةَ الْمُرَادِيُّ عُرْوَةُ بْنُ الْحَارِثِ ، كُوفِيٌّ أَيْضًا ، يَرْوِي عَنْ جَمَاعَةٍ ، وهُمَا ثِقَتَانِ ++ قال أَبُو أحمد : ولأبي فروة الرهاوي هذا حديث صالح ، وروى عن زيد بْن أَبِي أنيسة نسخة ينفرد بها عنه بأحاديث وله عَن غير زيد أحاديث مسروقة عَن الشيوخ وعامة حديثه غير محفوظ ++ قال أَبُو عروبة الحراني : حَدَّثَنِي أَبُو فروة يعني يزيد بْن مُحَمَّد بْن يزيد بْن سنان الرهاوي قال : سمعت أَبِي يقول : مات يزيد بْن سنان سنة خمس وخمسين ومائة قال أَبِي : ومولد يزيد بْن سنان سنة تسع وسبعين ++ روى له : الترمذي ، وابن ماجه . @ 9379 يزيد بْن الشخير هو ابْن عَبْد اللَّهِ بْن الشخير يأتي @ 9380 [ 7002 ] بخ د ت ق\u001bE5656",
      "sanad_ar": "2 .   وقال /26 أَبُو أَحْمَدَ بْنُ عَدِيٍّ /26",
      "matn_ar": "حدثنا /26 عَبْدُ اللَّهِ بْنُ سُلَيْمَانَ بْنِ الأَشْعَثِ /26 ، قال : أخبرنا /26 أَبُو عُبَيْدِ اللَّهِ الْبَزَّارُ يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ /26 ، قال : حدثنا /26 يَحْيَى بْنُ كَثِيرٍ /26 ، قال : حدثنا /26 شُعْبَةُ /26 ، عَنْ /26 أَبِي فَرْوَةَ /26 ، عَنْ /26 مَيْمُونَ بْنِ مِهْرَانَ /26 ، عَنِ /93 ابْنِ عُمَرَ /93 ، عَنِ النَّبِيِّ صلى الله عليه وسلم ، قال : \" مَنْ أُتِيَ فَقَاتَلَ فَقُتِلَ دُونَ مَالِهِ فَهُوَ شَهِيدٌ \" ، قال أَبُو أَحْمَدَ بْنُ عَدِيٍّ ، قال لَنَا عَبْدُ اللَّهِ بْنُ سُلَيْمَانَ : لَمْ يَرْوِ شُعْبَةُ عَنْ أَبِي فَرْوَةَ هَذَا غَيْرَ هَذَا الْحَدِيثِ ، وهُوَ أَبُو فَرْوَةَ يَزِيدُ بْنُ سِنَانٍ الْجَزَرِيُّ ، وفِي حَدِيثِهِ لِينٌ   وقَدْ رَوَى شُعْبَةُ عَنِ اثْنَيْنِ ، يُكَنَّيَانِ أَبَا فَرْوَةَ ، غَيْرَ هَذَا : أَبُو فَرْوَةَ مُسْلِمُ بْنُ سَالِمٍ الْجُهَنِيُّ كُوفِيٌّ ، يَرْوِي عَنْ : عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، وأَبُو فَرْوَةَ الْمُرَادِيُّ عُرْوَةُ بْنُ الْحَارِثِ ، كُوفِيٌّ أَيْضًا ، يَرْوِي عَنْ جَمَاعَةٍ ، وهُمَا ثِقَتَانِ ++ قال أَبُو أحمد : ولأبي فروة الرهاوي هذا حديث صالح ، وروى عن زيد بْن أَبِي أنيسة نسخة ينفرد بها عنه بأحاديث وله عَن غير زيد أحاديث مسروقة عَن الشيوخ وعامة حديثه غير محفوظ ++ قال أَبُو عروبة الحراني : حَدَّثَنِي أَبُو فروة يعني يزيد بْن مُحَمَّد بْن يزيد بْن سنان الرهاوي قال : سمعت أَبِي يقول : مات يزيد بْن سنان سنة خمس وخمسين ومائة قال أَبِي : ومولد يزيد بْن سنان سنة تسع وسبعين ++ روى له : الترمذي ، وابن ماجه . @ 9379 يزيد بْن الشخير هو ابْن عَبْد اللَّهِ بْن الشخير يأتي @ 9380 [ 7002 ] بخ د ت ق\u001bE5656",
