    {
      "hadith_id": 1047254,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 56700,
      "text_ar": "ثُمَّ الخبذعي الكوفي وخبذع هُوَ ابْن مَالِك بْن ذي بارق قبيل من همدان /10 أبان بْن إِسْحَاق الأسدي /10 /10 والأحوص بْن حكيم بْن عُمَيْر الشامي ق /10 /10 وإِسْمَاعِيل بْن أَبِي خَالِد /10 /10 وجويبر بْن سَعِيد /10 /10 وداود بْن يَزِيد الأودي /10 /10 وربيعة الكناني /10 /10 وزكريا بْن أَبِي زائدة /10 /10 وأبي الفيض سَالِم بْن عَبْد الأَعْلَى القرشي /10 /10 وسليمان الأعمش /10 /10 وسنان بْن الْحَارِث بْن مصرف ابْن أخي طلحة بْن مصرف /10 /10 والصباح بْن مُوسَى /10 /10 وعبد العزيز بْن أَبِي رواد /10 /10 وأبي مَرْيَم عبد الغفار بْن الْقَاسِم /10 /10 وعُمَر بْن ذر الهمداني /10 /10 وعُمَر بْن مُوسَى بْن وجيه الوجيهي /10 /10 وفضيل بْن غزوان الضبي /10 /10 وأبيه الْقَاسِم بْن الْوَلِيد الهمداني /10 /10 ومجالد بْن سَعِيد /10 /10 ومُحَمَّد بْن عَبْد الرَّحْمَنِ بْن أَبِي ليلى /10 /10 وموسى بْن مسلم الطحان /10 /10 وموسى بْن مطير /10 /10 وهانئ بْن أيوب الحنفي /10 /10 ويزيد بْن كيسان ت سي /10 /10 ويونس بْن أَبِي إِسْحَاق /10 /10 وأبي حيان التيمي /10",
