    {
      "hadith_id": 1045343,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 54789,
      "text_ar": "0 /11 إبراهيم بن عبيد الطنافسي /11 /11 وأحمد بن عُبَيْد اللَّهِ الغداني /11 /11 وبشر بن معاذ العقدي /11 /11 وسهل بن عثمان العسكري /11 /11 وسهل بن عمار /11 /11 وأَبُو سعيد عَبْد اللَّهِ بن سعيد الأشج ت /11 /11 وعبد الله بن عُمَرَ بن أبان الجعفي /11 /11 والعلاء بن عمرو الحنفي /11 /11 ومحمد بن أبان العنبري الكوفي /11 /11 ومحمد بن أبي معشر المدني /11 /11 وأَبُو كريب الهمداني /11 /11 وأَبُو هشام الرفاعي /11 ++ قال عثمان بن سعيد : قلت ليحيى بن معين : فالنضر بن مَنْصُور تعرفه ، يروي عَنْهُ ابن أبي معشر ، عَنْ أَبِي الجنوب ، عن علي ، من هؤلاء ؟ قال هؤلاء حمالة الحطب . # وقال",
      "sanad_ar": "0 /11 إبراهيم بن عبيد الطنافسي /11 /11 وأحمد بن عُبَيْد اللَّهِ الغداني /11 /11 وبشر بن معاذ العقدي /11 /11 وسهل بن عثمان العسكري /11 /11 وسهل بن عمار /11 /11 وأَبُو سعيد عَبْد اللَّهِ بن سعيد الأشج ت /11 /11 وعبد الله بن عُمَرَ بن أبان الجعفي /11 /11 والعلاء بن عمرو الحنفي /11 /11 ومحمد بن أبان العنبري الكوفي /11 /11 ومحمد بن أبي معشر المدني /11 /11 وأَبُو كريب الهمداني /11 /11 وأَبُو هشام الرفاعي /11 ++ قال عثمان بن سعيد",
      "matn_ar": "قلت ليحيى بن معين : فالنضر بن مَنْصُور تعرفه ، يروي عَنْهُ ابن أبي معشر ، عَنْ أَبِي الجنوب ، عن علي ، من هؤلاء ؟ قال هؤلاء حمالة الحطب . # وقال",
