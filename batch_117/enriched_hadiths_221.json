      "hadith_id": 1047307,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 56753,
      "text_ar": "0 /11 حاجب بْن الْوَلِيد المنبجي /11 /11 والحكم بْن مُوسَى /11 /11 وخالد بْن نجيح /11 /11 وسليمان بْن عَبْد الرَّحْمَنِ /11 /11 وسويد بْن سَعِيد /11 /11 وأَبُو جَعْفَر عَبْد اللَّهِ بْن خَالِد بْن حازم الرملي /11 /11 وعبد الله بْن عُثْمَان بْن عَطَاء الخراساني /11 /11 وعبد الله بْن مُحَمَّد بْن يَزِيد الهذلي /11 /11 وعبد الله بْن يُوسُف التنيسي /11 /11 وأَبُو مسهر عَبْد الأَعْلَى بْن مسهر الغساني /11 /11 وعبد الرحمن بْن واقد الواقدي /11 /11 وعبد الرحمن بْن يَحْيَى بْن إِسْمَاعِيل بْن عُبَيْد اللَّهِ بْن أَبِي المهاجر /11 /11 وأَبُو صَالِح عبد الغفار بْن داود الْحَرَّانِيّ /11 /11 وأَبُو نُعَيْم عُبَيْد بْن هِشَام الحلبي /11 /11 وعتبة بْن سَعِيد بْن الرخص /11 /11 وعلي بْن حجر السعدي ت /11 /11 ومُحَمَّد بْن إِبْرَاهِيم بْن أَبِي سكينة /11 /11 ومُحَمَّد بْن حازم الرملي /11 /11 ومُحَمَّد بْن عائذ القرشي الدمشقي /11 /11 ومُحَمَّد بْن عَبْد الْعَزِيزِ القسطلي /11 /11 ومُحَمَّد بْن يُوسُف بْن بِشْر القرشي /11 /11 والمسيب بْن واضح /11 /11 وأَبُو الطاهر مُوسَى بْن مُحَمَّد بْن عَطَاء البلقاوي الْمَقْدِسِيّ /11 /11 والهيثم بْن حَبِيب بْن غزوان الْجُرْجَانِيّ /11 /11 ووساج بْن عُقْبَة الْمَقْدِسِيّ ق /11 /11 والوليد بْن مسلم /11 ++ قال عَبْد الرَّحْمَنِ بْن أَبِي حاتم : أخبرنا عَبْد اللَّهِ بْن أَحْمَد بْن حَنْبَل ، فيما كتب إلي قال : قلت : لأبي الموقري يروي عَنِ الزُّهْرِيّ عجائب . قال : آه ليس ذاك بشيء . ++ وقال أَبُو جَعْفَر   العقيلي : حدثنا عَبْد اللَّهِ بْن أَحْمَد ، قال : سألت أَبِي عَنِ الموقري ، فَقَالَ : مَا أظنه ثقة ، ولم يحمده . ++ وقال حَنْبَل بْن إِسْحَاق : سألت أَبَا عَبْد اللَّهِ أَحْمَد عَنِ الموقري ، قال : مَا رأيت أحدا يحدث عنه ، قلت : له كيف حديثه ، قال : لا أدري ، قلت : فهو فِي بدنه ، قال : لا أدري ، إلا أن رجلا قدم عليه ، فغير كتبه وهُوَ لا يعلم ، فمن ذَلِكَ . ++ وقال أَبُو بَكْر الأثرم : سمعت أَبَا عَبْد اللَّهِ سئل عَنِ الْوَلِيد بْن مُحَمَّد الموقري ، فَقَالَ : مَا أخبره ، إلا أنهم زعموا أن العسكر لما دخل الشام أتاه قوم ، فأفسدوا حديثه ، فهو يروي أحاديث كأنه يريد مناكير .&E5442 قلت لأبي عَبْد اللَّهِ الموقري : يكتب حديثه ؟ فَقَالَ : مَا أدري أخبرك ، إلا أن له أحاديث مناكير ، وما أخبره . ++ وقال عُثْمَان بْن سَعِيد الدارمي ، وعبد الله بْن أَحْمَد بْن إِبْرَاهِيم الدورقي ، وإبراهيم بْن عَبْد اللَّهِ بْن الجنيد ، عَنْ يَحْيَى بْن معين الموقري : ليس بشيء . # وقال",
      "sanad_ar": "0 /11 حاجب بْن الْوَلِيد المنبجي /11 /11 والحكم بْن مُوسَى /11 /11 وخالد بْن نجيح /11 /11 وسليمان بْن عَبْد الرَّحْمَنِ /11 /11 وسويد بْن سَعِيد /11 /11 وأَبُو جَعْفَر عَبْد اللَّهِ بْن خَالِد بْن حازم الرملي /11 /11 وعبد الله بْن عُثْمَان بْن عَطَاء الخراساني /11 /11 وعبد الله بْن مُحَمَّد بْن يَزِيد الهذلي /11 /11 وعبد الله بْن يُوسُف التنيسي /11 /11 وأَبُو مسهر عَبْد الأَعْلَى بْن مسهر الغساني /11 /11 وعبد الرحمن بْن واقد الواقدي /11 /11 وعبد الرحمن بْن يَحْيَى بْن إِسْمَاعِيل بْن عُبَيْد اللَّهِ بْن أَبِي المهاجر /11 /11 وأَبُو صَالِح عبد الغفار بْن داود الْحَرَّانِيّ /11 /11 وأَبُو نُعَيْم عُبَيْد بْن هِشَام الحلبي /11 /11 وعتبة بْن سَعِيد بْن الرخص /11 /11 وعلي بْن حجر السعدي ت /11 /11 ومُحَمَّد بْن إِبْرَاهِيم بْن أَبِي سكينة /11 /11 ومُحَمَّد بْن حازم الرملي /11 /11 ومُحَمَّد بْن عائذ القرشي الدمشقي /11 /11 ومُحَمَّد بْن عَبْد الْعَزِيزِ القسطلي /11 /11 ومُحَمَّد بْن يُوسُف بْن بِشْر القرشي /11 /11 والمسيب بْن واضح /11 /11 وأَبُو الطاهر مُوسَى بْن مُحَمَّد بْن عَطَاء البلقاوي الْمَقْدِسِيّ /11 /11 والهيثم بْن حَبِيب بْن غزوان الْجُرْجَانِيّ /11 /11 ووساج بْن عُقْبَة الْمَقْدِسِيّ ق /11 /11 والوليد بْن مسلم /11 ++ قال عَبْد الرَّحْمَنِ بْن أَبِي حاتم",
      "matn_ar": "أخبرنا عَبْد اللَّهِ بْن أَحْمَد بْن حَنْبَل ، فيما كتب إلي قال : قلت : لأبي الموقري يروي عَنِ الزُّهْرِيّ عجائب . قال : آه ليس ذاك بشيء . ++ وقال أَبُو جَعْفَر   العقيلي : حدثنا عَبْد اللَّهِ بْن أَحْمَد ، قال : سألت أَبِي عَنِ الموقري ، فَقَالَ : مَا أظنه ثقة ، ولم يحمده . ++ وقال حَنْبَل بْن إِسْحَاق : سألت أَبَا عَبْد اللَّهِ أَحْمَد عَنِ الموقري ، قال : مَا رأيت أحدا يحدث عنه ، قلت : له كيف حديثه ، قال : لا أدري ، قلت : فهو فِي بدنه ، قال : لا أدري ، إلا أن رجلا قدم عليه ، فغير كتبه وهُوَ لا يعلم ، فمن ذَلِكَ . ++ وقال أَبُو بَكْر الأثرم : سمعت أَبَا عَبْد اللَّهِ سئل عَنِ الْوَلِيد بْن مُحَمَّد الموقري ، فَقَالَ : مَا أخبره ، إلا أنهم زعموا أن العسكر لما دخل الشام أتاه قوم ، فأفسدوا حديثه ، فهو يروي أحاديث كأنه يريد مناكير .&E5442 قلت لأبي عَبْد اللَّهِ الموقري : يكتب حديثه ؟ فَقَالَ : مَا أدري أخبرك ، إلا أن له أحاديث مناكير ، وما أخبره . ++ وقال عُثْمَان بْن سَعِيد الدارمي ، وعبد الله بْن أَحْمَد بْن إِبْرَاهِيم الدورقي ، وإبراهيم بْن عَبْد اللَّهِ بْن الجنيد ، عَنْ يَحْيَى بْن معين الموقري : ليس بشيء . # وقال",
