      "chapter_id": null,
      "hadith_number": 57875,
      "text_ar": "0 /11 أَبُو صَالِح عَبْد اللَّهِ بْن صَالِح المصري /11 /11 وهشيم بْن بشير /11 /11 والوليد بْن مسلم ق إلا أن هشيما سماه عَبْد الرَّحْمَنِ بْن يَحْيَى /11 ++ قال أَبُو زرعة : روى عنه : هشيم ، وكَانَ يَقُول : عَبْد الرَّحْمَنِ بْن يَحْيَى . # وقال خليفة بْن خياط فِي الطبقة الرابعة من أهل الشَّامات يَحْيَى بْن عَبْد الرَّحْمَنِ دمشقي . ++ وقال الْبُخَارِيّ : يَحْيَى بْن عَبْد الرَّحْمَنِ أَبُو شيبة ، وكَانَ هشيم يغلط ، يَقُول : عَبْد الرَّحْمَنِ بْن يَحْيَى . ++ وقال أَبُو حاتم : قال هشيم : عَبْد الرَّحْمَنِ بْن يَحْيَى بْن عَبْد الرَّحْمَنِ . # وقال",
      "sanad_ar": "0 /11 أَبُو صَالِح عَبْد اللَّهِ بْن صَالِح المصري /11 /11 وهشيم بْن بشير /11 /11 والوليد بْن مسلم ق إلا أن هشيما سماه عَبْد الرَّحْمَنِ بْن يَحْيَى /11 ++ قال أَبُو زرعة",
      "matn_ar": "روى عنه : هشيم ، وكَانَ يَقُول : عَبْد الرَّحْمَنِ بْن يَحْيَى . # وقال خليفة بْن خياط فِي الطبقة الرابعة من أهل الشَّامات يَحْيَى بْن عَبْد الرَّحْمَنِ دمشقي . ++ وقال الْبُخَارِيّ : يَحْيَى بْن عَبْد الرَّحْمَنِ أَبُو شيبة ، وكَانَ هشيم يغلط ، يَقُول : عَبْد الرَّحْمَنِ بْن يَحْيَى . ++ وقال أَبُو حاتم : قال هشيم : عَبْد الرَّحْمَنِ بْن يَحْيَى بْن عَبْد الرَّحْمَنِ . # وقال",
