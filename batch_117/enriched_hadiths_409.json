    {
      "hadith_id": 1050127,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 59573,
      "text_ar": "القاص مولى بني مخزوم يقال كنيته أَبُو يوسف وأبو حزرة لقب /10 الحسن بْن عثمان بْن عَبْد الرحمن بْن عوف ابْن أخي أَبِي سلمة بْن عَبْد الرحمن بْن عوف /10 /10 وسلمة بْن أَبِي سلمة بْن عَبْد الرحمن بْن عوف /10 /10 وعبادة بْن الوليد بْن عبادة بْن الصامت بخ م د /10 /10 وعبد اللَّهِ بْن أَبِي عتيق مُحَمَّد بْن عَبْد الرحمن بْن أَبِي بكر الصديق م /10 /10 وأبي عتيق عَبْد اللَّهِ بْن مُحَمَّد بْن أَبِي بكر الصديق د إن كَانَ محفوظا /10 /10 وعبد الرحمن بْن جابر بْن عَبْد اللَّهِ /10 /10 وعبد الرحمن بْن عَبْد اللَّهِ بْن أَبِي عتيق /10 /10 والقاسم بْن مُحَمَّد بْن أَبِي بكر الصديق /10 /10 ومحمد بْن كعب القرظي /10",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
