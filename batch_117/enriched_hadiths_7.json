    {
      "hadith_id": 1044098,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 53544,
      "text_ar": "0 /11 عَبْد الرَّحْمَنِ بن عُمَرَ الأوزاعي مد /11 /11 ومعاوية بن صالح الحضرمي /11 ++ قال عَبْد الرَّحْمَنِ بن أبي حاتم : سمعت أبي ، وأبا زرعة وقيل لهما : مُوسَى بن سليمان الذي يحدث عَنْهُ الأوزاعي فقالا : شيخ للأوزاعي لا يعلم . روى عنه غيره ، قلت لهما : فما حاله ؟ قال أبي : هو شيخ ، وسكت أَبُو زرعة ++ روى له أَبُو دَاوُدَ فِي المراسيل حديثا واحدا ، وقد وقع لنا بِعُلُوٍّ عَنْهُ . \r\n$3334  -10 /2",
      "sanad_ar": "0 /11 عَبْد الرَّحْمَنِ بن عُمَرَ الأوزاعي مد /11 /11 ومعاوية بن صالح الحضرمي /11 ++ قال عَبْد الرَّحْمَنِ بن أبي حاتم",
      "matn_ar": "سمعت أبي ، وأبا زرعة وقيل لهما : مُوسَى بن سليمان الذي يحدث عَنْهُ الأوزاعي فقالا : شيخ للأوزاعي لا يعلم . روى عنه غيره ، قلت لهما : فما حاله ؟ قال أبي : هو شيخ ، وسكت أَبُو زرعة ++ روى له أَبُو دَاوُدَ فِي المراسيل حديثا واحدا ، وقد وقع لنا بِعُلُوٍّ عَنْهُ . \r\n$3334  -10 /2",
