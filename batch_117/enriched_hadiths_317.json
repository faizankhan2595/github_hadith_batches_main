      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 58194,
      "text_ar": "2 . ++ وذَكَرَ لَهُ الْعُقَيْلِيُّ حَدِيثَهُ ، عَنْ هِشَامِ بْنِ عُرْوَةَ س ق ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ، قال رَسُولُ اللَّهِ صلى الله عليه وسلم : \" كُلُوا الْبَلَحَ بِالتَّمْرِ . . . \" الحديث وحديثه عَنْ عَمْرو بْن أَبِي عَمْرو بخ ، عَنْ أَنَس ، أن النَّبِيّ صلى الله عليه وسلم قال : \" لست من دد ، ولا دد مني \" . وقال : أما حديث هِشَام بْن عروة ، فلا يعرف إلا بِهِ ، وأما حديث أَنَس ، فقد تابعه عليه من هُوَ دونه . ++ وذكر له أَبُو أَحْمَد بْن عدي هذين الحديثين ، وحديثين آخرين . وقال : فِي حديث هِشَام بْن عروة ، وهذا الحديث يعرف بيحيى بْن مُحَمَّد بْن قيس لا نعلم رواه عَنْ هِشَام غيره . وقال فِي حديث عَمْرو بْن   أَبِي عَمْرو : وهذا الحديث إنما يعرف بيحيى بْن مُحَمَّد بْن قيس ، عَنْ عَمْرو بْن أَبِي عَمْرو ، ثُمَّ قال : ويحيى بْن مُحَمَّد له أحاديث غير مَا ذكرت ، وعامة أحاديثه مستقيمة ، إلا هذه الأحاديث التي بينتها . ++ روى له الْبُخَارِيّ فِي الأدب ، ومسلم متابعة ، وأَبُو داود فِي المراسيل ، والباقون . @ 9282 [ 6915 ] م0E5595",
      "sanad_ar": "2 . ++ وذَكَرَ لَهُ الْعُقَيْلِيُّ حَدِيثَهُ",
      "matn_ar": "عَنْ هِشَامِ بْنِ عُرْوَةَ س ق ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ ، قال رَسُولُ اللَّهِ صلى الله عليه وسلم : \" كُلُوا الْبَلَحَ بِالتَّمْرِ . . . \" الحديث وحديثه عَنْ عَمْرو بْن أَبِي عَمْرو بخ ، عَنْ أَنَس ، أن النَّبِيّ صلى الله عليه وسلم قال : \" لست من دد ، ولا دد مني \" . وقال : أما حديث هِشَام بْن عروة ، فلا يعرف إلا بِهِ ، وأما حديث أَنَس ، فقد تابعه عليه من هُوَ دونه . ++ وذكر له أَبُو أَحْمَد بْن عدي هذين الحديثين ، وحديثين آخرين . وقال : فِي حديث هِشَام بْن عروة ، وهذا الحديث يعرف بيحيى بْن مُحَمَّد بْن قيس لا نعلم رواه عَنْ هِشَام غيره . وقال فِي حديث عَمْرو بْن   أَبِي عَمْرو : وهذا الحديث إنما يعرف بيحيى بْن مُحَمَّد بْن قيس ، عَنْ عَمْرو بْن أَبِي عَمْرو ، ثُمَّ قال : ويحيى بْن مُحَمَّد له أحاديث غير مَا ذكرت ، وعامة أحاديثه مستقيمة ، إلا هذه الأحاديث التي بينتها . ++ روى له الْبُخَارِيّ فِي الأدب ، ومسلم متابعة ، وأَبُو داود فِي المراسيل ، والباقون . @ 9282 [ 6915 ] م0E5595",
