    {
      "hadith_id": 1044110,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 53556,
      "text_ar": "أخبرنا /94 عَبْدُ الرَّحِيمِ بْنُ عَبْدِ الْمَلِكِ الْمَقْدِسِيُّ L75035 /94 ، قال : أَنْبَأَنَا /26 أَبُو الْمَجْدِ زَاهِرُ بْنُ أَبِي طَاهِرٍ الثَّقَفِيُّ L62535 /26 ، قال : أخبرنا /26 عَبْدُ الْمُنْعِمِ بْنُ أَبِي نَصْرِ بْنِ يَعْقُوبَ الْمُقْرِئُ L65314 /26 ، قال : أخبرنا /26 أَبُو طَاهِرِ بْنُ مَحْمُودٍ الثَّقَفِيُّ L10564 /26 ، قال : أخبرنا /26 أَبُو بكرٍ مُحَمَّدُ بْنُ عُبَيْدِ اللَّهِ بْنِ الْحَسَنِ الأَصْبَهَانِيُّ L52153 /26 ، قال : حَدَّثَنَا /26 أَبُو الْقَاسِمِ عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْكَرِيمِ الرَّازِيُّ L23055 /26 ، قال : حَدَّثَنَا /26 يُونُسُ بْنُ عَبْدِ الأَعْلَى L8613 /26 ، قال : حَدَّثَنَا /26 عَبْدُ اللَّهِ بْنُ وهْبٍ L5147 /26 ، قال : أَخْبَرَنِي /26 مُوسَى بْنُ شَيْبَةَ L7742 /26 ، عَنِ /26 الأَوْزَاعِيِّ L4457 /26 ، عَنْ /26 إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ L952 /26 ، قال : أَخْبَرَنِي /26 جَعْفَرُ بْنُ عِيَاضٍ L2159 /26 ، /27 أَنَّ /93 أَبَا هُرَيْرَةَ L4396 /93 ، حَدَّثَهُ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ أَنَّهُ قال : /20 \" تَعَوَّذُوا بِاللَّهِ مِنَ الْفَقْرِ والْقِلَّةِ والذِّلَّةِ ، وأَنْ تَظْلِمُ أَوْ تُظْلَمَ \" /27 ، رَوَاهُ النَّسَائِيُّ عَنْ يُونُسَ بْنِ عَبْدِ الأَعْلَى ، فَوَافَقْنَاهُ فِيهِ بِعُلُوٍّ . قال أَبُو سَعِيدِ بْنُ يُونُسَ : فِي هَذَا الْحَدِيثِ لَمْ يَرْوِهِ عَنْ مُوسَى بْنِ شَيْبَةَ إِلا ابْنُ وهْبٍ ، ولا حَدَّثَ عَنْ مُوسَى بْنِ شَيْبَةَ إِلا ابْنُ وهْبٍ وحْدَهُ * \r\n@ 8468 [ 6266 ] مد",
      "sanad_ar": "أخبرنا /94 عَبْدُ الرَّحِيمِ بْنُ عَبْدِ الْمَلِكِ الْمَقْدِسِيُّ L75035 /94",
      "matn_ar": "قال : أَنْبَأَنَا /26 أَبُو الْمَجْدِ زَاهِرُ بْنُ أَبِي طَاهِرٍ الثَّقَفِيُّ L62535 /26 ، قال : أخبرنا /26 عَبْدُ الْمُنْعِمِ بْنُ أَبِي نَصْرِ بْنِ يَعْقُوبَ الْمُقْرِئُ L65314 /26 ، قال : أخبرنا /26 أَبُو طَاهِرِ بْنُ مَحْمُودٍ الثَّقَفِيُّ L10564 /26 ، قال : أخبرنا /26 أَبُو بكرٍ مُحَمَّدُ بْنُ عُبَيْدِ اللَّهِ بْنِ الْحَسَنِ الأَصْبَهَانِيُّ L52153 /26 ، قال : حَدَّثَنَا /26 أَبُو الْقَاسِمِ عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْكَرِيمِ الرَّازِيُّ L23055 /26 ، قال : حَدَّثَنَا /26 يُونُسُ بْنُ عَبْدِ الأَعْلَى L8613 /26 ، قال : حَدَّثَنَا /26 عَبْدُ اللَّهِ بْنُ وهْبٍ L5147 /26 ، قال : أَخْبَرَنِي /26 مُوسَى بْنُ شَيْبَةَ L7742 /26 ، عَنِ /26 الأَوْزَاعِيِّ L4457 /26 ، عَنْ /26 إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ L952 /26 ، قال : أَخْبَرَنِي /26 جَعْفَرُ بْنُ عِيَاضٍ L2159 /26 ، /27 أَنَّ /93 أَبَا هُرَيْرَةَ L4396 /93 ، حَدَّثَهُ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ أَنَّهُ قال : /20 \" تَعَوَّذُوا بِاللَّهِ مِنَ الْفَقْرِ والْقِلَّةِ والذِّلَّةِ ، وأَنْ تَظْلِمُ أَوْ تُظْلَمَ \" /27 ، رَوَاهُ النَّسَائِيُّ عَنْ يُونُسَ بْنِ عَبْدِ الأَعْلَى ، فَوَافَقْنَاهُ فِيهِ بِعُلُوٍّ . قال أَبُو سَعِيدِ بْنُ يُونُسَ : فِي هَذَا الْحَدِيثِ لَمْ يَرْوِهِ عَنْ مُوسَى بْنِ شَيْبَةَ إِلا ابْنُ وهْبٍ ، ولا حَدَّثَ عَنْ مُوسَى بْنِ شَيْبَةَ إِلا ابْنُ وهْبٍ وحْدَهُ * \r\n@ 8468 [ 6266 ] مد",
