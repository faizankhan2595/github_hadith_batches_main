    {
      "hadith_id": 1048340,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 57786,
      "text_ar": "2 . ++ روى له مسلم ، وأَبُو داود . ++ \r\n$3536  -10 /2 /141 أخبرنا /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ الْمُذْهِبِ L14991 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مَالِكٍ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 يَعْقُوبُ L8513 /26 ، قال : حدثنا /26 أَبِي L823 /26 ، عَنِ /26 ابْنِ إِسْحَاقَ L6811 /26 ، قال : حَدَّثَنِي /26 عَبْدُ اللَّهِ بْنُ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ L4632 /26 ، عَنْ /26 يَحْيَى بْنِ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ سَعْدِ بْنِ زُرَارَةَ L8300 /26 ، /27 عَنْ /93 أُمِّ هِشَامٍ بِنْتِ حَارِثَةَ L686 /93 ، قَالَتْ : \" لَقَدْ كَانَ تَنُّورُنَا ، وتَنُّورُ رَسُولِ اللَّهِ صلى الله عليه وسلم واحِدًا سَنَتَيْنِ ، أَوْ سَنَةً وبَعْضَ سَنَةٍ ، مَا أَخَذْتُ /20 /4 ق والْقُرْآنِ الْمَجِيدِ /4 إِلا عَلَى لِسَانِ رَسُولِ اللَّهِ صلى الله عليه وسلم ، كَانَ يَقْرَأُ بِهَا كُلَّ يَوْمِ جُمُعَةٍ عَلَى الْمِنْبَرِ إِذَا خَطَبَ النَّاسَ \" /27 . ++ رواه مسلم ، عَنْ عَمْرو بْن مُحَمَّد الناقد ، عَنْ يَعْقُوب بْن إِبْرَاهِيم بْن سَعْد ، فوقع لنا بدلا عاليا ، وليس له عنده غيره * \r\n@ 9223 [ 6864 ] قد ق%E5561",
      "sanad_ar": "2 . ++ روى له مسلم",
      "matn_ar": "وأَبُو داود . ++ \r\n$3536  -10 /2 /141 أخبرنا /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو عَلِيِّ بْنُ الْمُذْهِبِ L14991 /26 ، قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مَالِكٍ L8994 /26 ، قال : حدثنا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حدثنا /26 يَعْقُوبُ L8513 /26 ، قال : حدثنا /26 أَبِي L823 /26 ، عَنِ /26 ابْنِ إِسْحَاقَ L6811 /26 ، قال : حَدَّثَنِي /26 عَبْدُ اللَّهِ بْنُ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ L4632 /26 ، عَنْ /26 يَحْيَى بْنِ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ سَعْدِ بْنِ زُرَارَةَ L8300 /26 ، /27 عَنْ /93 أُمِّ هِشَامٍ بِنْتِ حَارِثَةَ L686 /93 ، قَالَتْ : \" لَقَدْ كَانَ تَنُّورُنَا ، وتَنُّورُ رَسُولِ اللَّهِ صلى الله عليه وسلم واحِدًا سَنَتَيْنِ ، أَوْ سَنَةً وبَعْضَ سَنَةٍ ، مَا أَخَذْتُ /20 /4 ق والْقُرْآنِ الْمَجِيدِ /4 إِلا عَلَى لِسَانِ رَسُولِ اللَّهِ صلى الله عليه وسلم ، كَانَ يَقْرَأُ بِهَا كُلَّ يَوْمِ جُمُعَةٍ عَلَى الْمِنْبَرِ إِذَا خَطَبَ النَّاسَ \" /27 . ++ رواه مسلم ، عَنْ عَمْرو بْن مُحَمَّد الناقد ، عَنْ يَعْقُوب بْن إِبْرَاهِيم بْن سَعْد ، فوقع لنا بدلا عاليا ، وليس له عنده غيره * \r\n@ 9223 [ 6864 ] قد ق%E5561",
