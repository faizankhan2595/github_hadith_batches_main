      "chapter_id": null,
      "hadith_number": 57784,
      "text_ar": "0 /11 إِبْرَاهِيم بْن مُحَمَّد بْن سَعْد بْن زرارة /11 /11 وصالح بْن إِبْرَاهِيم بْن عَبْد الرَّحْمَنِ بْن عوف /11 /11 وعبد الله بْن أَبِي بَكْر بْن حَزْم م د /11 /11 ويحيى بْن سَعِيد الأَنْصَارِيّ /11 ++ قال عَبْد الرَّحْمَنِ بْن أَبِي حاتم : جعل الْبُخَارِيّ اسمين ، وهُوَ اسم واحد ، جعل رواية أحدهما عَنْ أَبِي هُرَيْرَةَ ، والآخر عَنْ أم هِشَام . #",
      "sanad_ar": "0 /11 إِبْرَاهِيم بْن مُحَمَّد بْن سَعْد بْن زرارة /11 /11 وصالح بْن إِبْرَاهِيم بْن عَبْد الرَّحْمَنِ بْن عوف /11 /11 وعبد الله بْن أَبِي بَكْر بْن حَزْم م د /11 /11 ويحيى بْن سَعِيد الأَنْصَارِيّ /11 ++ قال عَبْد الرَّحْمَنِ بْن أَبِي حاتم",
      "matn_ar": "جعل الْبُخَارِيّ اسمين ، وهُوَ اسم واحد ، جعل رواية أحدهما عَنْ أَبِي هُرَيْرَةَ ، والآخر عَنْ أم هِشَام . #",
