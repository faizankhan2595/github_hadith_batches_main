      "hadith_id": 1051190,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 60636,
      "text_ar": "2 . ++ وقال : روى عنه عمران بْن حدير ، وليس ممن يحتج بحديثه . ++ قال الترمذي عقيب حديث نافع عَنِ ابن عمر : كنا نأكل على عهد رَسُول اللَّه ونحن نمشي ، ونشرب ونحن قيام ، روى هذا الحديث عمران بْن جدير ، عَنِ ابن البزري ، عَنِ ابن عمر ، وأبو البزري اسمه يزيد بْن عطارد . ++ وقد وقع لنا حديثه بعلو . ++ \r\n$3704  -10 /2 /142 أَخْبَرَنَا بِهِ /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أَخْبَرَنَا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أَخْبَرَنَا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أَخْبَرَنَا /26 أَبُو عَلِيِّ بْنُ الْمُذْهِبِ L14991 /26 ، قال : أَخْبَرَنَا /26 أَبُو بَكْرِ بْنُ مَالِكٍ الْقَطِيعِيُّ L8994 /26 ، قال : حَدَّثَنَا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حَدَّثَنَا /26 وكِيعٌ L8160 /26 ، قال : حَدَّثَنِي /26 عِمْرَانُ بْنُ حُدَيْرٍ L6034 /26 ، عَنْ /26 يَزِيدَ بْنِ عَطَارِدٍ أَبِي الْبَزَرِيِّ السَّدُوسِيِّ L8464 /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قال : \" كُنَّا /20 نَشْرَبُ ونَحْنُ قِيَامٌ ، ونَأْكُلُ ونَحْنُ نَسْعَى عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ \" /27 * \r\n@ 9730 [ 7223 ] د ت\u001bE5824",
      "sanad_ar": "2 . ++ وقال",
      "matn_ar": "روى عنه عمران بْن حدير ، وليس ممن يحتج بحديثه . ++ قال الترمذي عقيب حديث نافع عَنِ ابن عمر : كنا نأكل على عهد رَسُول اللَّه ونحن نمشي ، ونشرب ونحن قيام ، روى هذا الحديث عمران بْن جدير ، عَنِ ابن البزري ، عَنِ ابن عمر ، وأبو البزري اسمه يزيد بْن عطارد . ++ وقد وقع لنا حديثه بعلو . ++ \r\n$3704  -10 /2 /142 أَخْبَرَنَا بِهِ /94 أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أَخْبَرَنَا /26 حَنْبَلُ بْنُ عَبْدِ اللَّهِ L62448 /26 ، قال : أَخْبَرَنَا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أَخْبَرَنَا /26 أَبُو عَلِيِّ بْنُ الْمُذْهِبِ L14991 /26 ، قال : أَخْبَرَنَا /26 أَبُو بَكْرِ بْنُ مَالِكٍ الْقَطِيعِيُّ L8994 /26 ، قال : حَدَّثَنَا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حَدَّثَنَا /26 وكِيعٌ L8160 /26 ، قال : حَدَّثَنِي /26 عِمْرَانُ بْنُ حُدَيْرٍ L6034 /26 ، عَنْ /26 يَزِيدَ بْنِ عَطَارِدٍ أَبِي الْبَزَرِيِّ السَّدُوسِيِّ L8464 /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قال : \" كُنَّا /20 نَشْرَبُ ونَحْنُ قِيَامٌ ، ونَأْكُلُ ونَحْنُ نَسْعَى عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ \" /27 * \r\n@ 9730 [ 7223 ] د ت\u001bE5824",
