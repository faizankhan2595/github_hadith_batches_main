    {
      "hadith_id": 1048603,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 58049,
      "text_ar": "0 /11 إِبْرَاهِيم بْن أَبِي معاوية الضرير /11 /11 وأَحْمَد بْن بديل اليامي /11 /11 وأَحْمَد بْن عَبْد الْعَزِيزِ الْوَاسِطِيّ /11 /11 وأَحْمَد بْن مُحَمَّد بْن يَحْيَى بْن سَعِيد القطان /11 /11 وأَحْمَد بْن مُحَمَّد الرملي زريق /11 /11 وآدم بْن أَبِي إياس /11 /11 وأسد بْن مُوسَى /11 /11 وحسن بْن حسين العرني /11 /11 والحسن بْن صابر الهاشمي /11 /11 والحسن بْن علي بْن عفان العامري /11 /11 وحميد بْن الربيع اللخمي /11 /11 وسعيد بْن أسد بْن مُوسَى /11 /11 وسعيد بْن خَالِد /11 /11 وسعيد بْن سُلَيْمَان الْوَاسِطِيّ /11 /11 وعاصم بْن عَامِر البجلي /11 /11 والعباس بْن الْوَلِيد الرملي /11 /11 وعبد الله بْن عُمَر بْن أبان /11 /11 وأَبُو بَكْر عَبْد اللَّهِ بْن مُحَمَّد بْن أَبِي شيبة بخ /11 /11 وعبد الرحمن بْن بحر الخلال /11 /11 وعبد الواحد بْن إِسْحَاق الطَّبَرَانِيّ /11 /11 وعثمان بْن مُحَمَّد بْن أَبِي شيبة /11 /11 وأَبُو الْحَسَن علي بْن الْحَسَن بْن خَالِد الضبي الكوفي /11 /11 وعلي بْن مُحَمَّد بْن أَبِي الخصيب ق /11 /11 وعلي بْن مُحَمَّد بْن مَرَوَان السدي /11 /11 وعلي بْن مُحَمَّد الطنافسي ق /11 /11 وعَمْرو بْن عُثْمَان الحمصي /11 /11 وعيسى بْن   أَحْمَد العسقلاني البلخي /11 /11 وابْن أخيه عِيسَى بْن عُثْمَان بْن عِيسَى التَّمِيمِيّ ت /11 /11 وعيسى بْن يُونُس الرملي الفاخوري /11 /11 ومُحَمَّد بْن إِبْرَاهِيم بْن العلاء الشامي /11 /11 ومُحَمَّد بْن عَبْد اللَّهِ بْن الْمُبَارَك المخرمي د /11 /11 ومُحَمَّد بْن عَبْد اللَّهِ بْن نمير ق /11 /11 ومُحَمَّد بْن عُثْمَان بْن كرامة /11 /11 ومُحَمَّد بْن فضيل بْن عياض /11 /11 ومُحَمَّد بْن مصفى الحمصي /11 /11 ومُحَمَّد بْن مَنْصُور الجواز المكي /11 /11 ومُحَمَّد بْن يَحْيَى بْن أَبِي عُمَر العدني م /11 /11 ومهدي بْن جَعْفَر الرملي /11 /11 وموسى بْن إِسْحَاق الكناني القواس /11 /11 وهارون بْن زيد بْن أَبِي الزرقاء الموصلي /11 /11 وهارون بْن سباع /11 /11 وهارون بْن مَعْرُوف /11 /11 ويحيى بْن مُوسَى البلخي د /11 # قال",
      "sanad_ar": "",
      "matn_ar": "",
