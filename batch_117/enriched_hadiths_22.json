      "hadith_id": 1044320,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 53766,
      "text_ar": "2 ، حَدَّثَنَا عَنْهُ ابن نمير ++ روى له مسلم حديثا واحدا ، وقد وقع لنا بِعُلُوٍّ عَنْهُ . \r\n$3338  -10 /2 /141 أَخْبَرَنَا به /94 أَحْمَدُ بْنُ هِبَةِ اللَّهِ بْنِ أَحْمَدَ L52134 /94 ، قال : أَنْبَأَنَا /26 أَبُو رَوْحٍ عَبْدُ الْمُعِزِّ بْنُ مُحَمَّدٍ الْهَرَوِيُّ L59514 /26 ، قال : أخبرنا /26 زَاهِرُ بْنُ طَاهِرٍ الشَّحَّامِيُّ L17167 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ الْقُشَيْرِيُّ L51442 /26 ، قال : أخبرنا /26 أَبُو الْحُسَيْنِ الْخَفَّافُ L10207 /26 ، قال : أخبرنا /26 أَبُو الْعَبَّاسِ السَّرَّاجُ L28615 /26 ، قال : حَدَّثَنَا /26 إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ L927 /26 ، قال : أخبرنا /26 مُوسَى الْقَارِئُ L7761 /26 ، قال : حَدَّثَنَا /26 زَائِدَةُ L2980 /26 ، عَنِ /26 الأَعْمَشِ L3629 /26 ، عَنْ /26 سَالِمِ بْنِ أَبِي الْجَعْدِ L3182 /26 ، عَنْ /26 كُرَيْبٍ L6588 /26 ، عَنِ /39 ابْنِ عَبَّاسٍ L4883/39 ، /27 عَنْ /93 مَيْمُونَةَ L7825 /93 ، قَالَتْ : /20 \" وضَعْتُ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ مَاءً وسَتَرْتُهُ فَاغْتَسَلَ \" . /27 وسَاقَ الْحَدِيثَ ، رَوَاهُ عَنْ إِسْحَاقَ بْنِ إِبْرَاهِيمَ ، فَوَافَقْنَاهُ فِيهِ بِعُلُوٍّ * \r\n@ 8495 [ 6290 ] خت م د ق\u001fE5141",
      "sanad_ar": "2",
      "matn_ar": "حَدَّثَنَا عَنْهُ ابن نمير ++ روى له مسلم حديثا واحدا ، وقد وقع لنا بِعُلُوٍّ عَنْهُ . \r\n$3338  -10 /2 /141 أَخْبَرَنَا به /94 أَحْمَدُ بْنُ هِبَةِ اللَّهِ بْنِ أَحْمَدَ L52134 /94 ، قال : أَنْبَأَنَا /26 أَبُو رَوْحٍ عَبْدُ الْمُعِزِّ بْنُ مُحَمَّدٍ الْهَرَوِيُّ L59514 /26 ، قال : أخبرنا /26 زَاهِرُ بْنُ طَاهِرٍ الشَّحَّامِيُّ L17167 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ الْقُشَيْرِيُّ L51442 /26 ، قال : أخبرنا /26 أَبُو الْحُسَيْنِ الْخَفَّافُ L10207 /26 ، قال : أخبرنا /26 أَبُو الْعَبَّاسِ السَّرَّاجُ L28615 /26 ، قال : حَدَّثَنَا /26 إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ L927 /26 ، قال : أخبرنا /26 مُوسَى الْقَارِئُ L7761 /26 ، قال : حَدَّثَنَا /26 زَائِدَةُ L2980 /26 ، عَنِ /26 الأَعْمَشِ L3629 /26 ، عَنْ /26 سَالِمِ بْنِ أَبِي الْجَعْدِ L3182 /26 ، عَنْ /26 كُرَيْبٍ L6588 /26 ، عَنِ /39 ابْنِ عَبَّاسٍ L4883/39 ، /27 عَنْ /93 مَيْمُونَةَ L7825 /93 ، قَالَتْ : /20 \" وضَعْتُ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ مَاءً وسَتَرْتُهُ فَاغْتَسَلَ \" . /27 وسَاقَ الْحَدِيثَ ، رَوَاهُ عَنْ إِسْحَاقَ بْنِ إِبْرَاهِيمَ ، فَوَافَقْنَاهُ فِيهِ بِعُلُوٍّ * \r\n@ 8495 [ 6290 ] خت م د ق\u001fE5141",
