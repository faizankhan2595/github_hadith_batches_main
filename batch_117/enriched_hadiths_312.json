      "hadith_id": 1048668,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 58114,
      "text_ar": "2 . ++ وقال أَبُو بَكْر بْن أَبِي الأسود ، عَنْ يَحْيَى بْن سَعِيد القطان : سمعت شُعْبَة ، يَقُول : يَحْيَى بْن أَبِي كَثِير أحسن حديثا من الزُّهْرِيّ . ++ وقال مُحَمَّد بْن سَعِيد المقرئ ، عَنْ عَبْد الرَّحْمَنِ بْن الحكم بْن بشير بْن سلمان : كَانَ شُعْبَة يقدم يَحْيَى بْن أَبِي كَثِير على الزُّهْرِيّ . ++ وقال عَبْد اللَّهِ بْن أَحْمَد بْن حَنْبَل ، عَنْ أَبِيهِ : يَحْيَى بْن أَبِي كَثِير من أثبت الناس ، إنما يعد مع الزُّهْرِيّ ، ويحيى بْن سَعِيد ، فإذا خالفه الزُّهْرِيّ ، فالقول قول يَحْيَى بْن أَبِي كَثِير . # وقال",
      "sanad_ar": "2 . ++ وقال أَبُو بَكْر بْن أَبِي الأسود",
      "matn_ar": "عَنْ يَحْيَى بْن سَعِيد القطان : سمعت شُعْبَة ، يَقُول : يَحْيَى بْن أَبِي كَثِير أحسن حديثا من الزُّهْرِيّ . ++ وقال مُحَمَّد بْن سَعِيد المقرئ ، عَنْ عَبْد الرَّحْمَنِ بْن الحكم بْن بشير بْن سلمان : كَانَ شُعْبَة يقدم يَحْيَى بْن أَبِي كَثِير على الزُّهْرِيّ . ++ وقال عَبْد اللَّهِ بْن أَحْمَد بْن حَنْبَل ، عَنْ أَبِيهِ : يَحْيَى بْن أَبِي كَثِير من أثبت الناس ، إنما يعد مع الزُّهْرِيّ ، ويحيى بْن سَعِيد ، فإذا خالفه الزُّهْرِيّ ، فالقول قول يَحْيَى بْن أَبِي كَثِير . # وقال",
