    {
      "hadith_id": 1048085,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 57531,
      "text_ar": "0 /11 أَحْمَد بْن حَنْبَل /11 /11 وإسحاق بْن راهويه /11 /11 والحسن بْن حَمَّاد سجادة ق /11 /11 والحكم بْن هِشَام الثقفي ق وهُوَ من أقرانه /11 /11 وحميد بْن الربيع اللخمي /11 /11 وداود بْن رشيد م /11 /11 وسريج بْن يُونُس عس /11 /11 وسعيد بْن مُحَمَّد الجرمي /11 /11 وابنه سَعِيد بْن يَحْيَى بْن سَعِيد الأموي خ م د ت س   /11 /11 وعبد المتعالي بْن عبد الوهاب /11 /11 وعبد الوهاب الوراق ت /11 /11 وعلي بْن حجر السعدي ت /11 /11 وعلي بْن عَمْرو الأَنْصَارِيّ ق /11 /11 وأَبُو عُبَيْد الْقَاسِم بْن سلام /11 /11 ومُحَمَّد بْن حَسَّان الأزرق /11 /11 ومخلد بْن مَالِك الحمال خ /11 /11 ويحيى بْن معين /11 /11 ويوسف بْن يَعْقُوب الصفار بخ /11 /11 وأَبُو الربيع الزهراني /11 /11 وأَبُو معمر الْقَطِيعِيّ د /11 ++ قال أَبُو بَكْر الأثرم ، عَنْ أَحْمَد بْن حَنْبَل : مَا كنت أظن عنده هذا الحديث الكثير ، فإذا هم يزعمون إن عنده عَنِ الأعمش حديثا كثيرا ، وعن غيره . وقد كتبنا عنه ، وكَانَ له أخ له قدر وعلم يقال له : عَبْد اللَّهِ بْن سَعِيد ، ولم يثبت أمر يَحْيَى فِي الحديث ، كأنه يَقُول : كَانَ يصدق وليس بصاحب حديث . # وقال",
      "sanad_ar": "0 /11 أَحْمَد بْن حَنْبَل /11 /11 وإسحاق بْن راهويه /11 /11 والحسن بْن حَمَّاد سجادة ق /11 /11 والحكم بْن هِشَام الثقفي ق وهُوَ من أقرانه /11 /11 وحميد بْن الربيع اللخمي /11 /11 وداود بْن رشيد م /11 /11 وسريج بْن يُونُس عس /11 /11 وسعيد بْن مُحَمَّد الجرمي /11 /11 وابنه سَعِيد بْن يَحْيَى بْن سَعِيد الأموي خ م د ت س   /11 /11 وعبد المتعالي بْن عبد الوهاب /11 /11 وعبد الوهاب الوراق ت /11 /11 وعلي بْن حجر السعدي ت /11 /11 وعلي بْن عَمْرو الأَنْصَارِيّ ق /11 /11 وأَبُو عُبَيْد الْقَاسِم بْن سلام /11 /11 ومُحَمَّد بْن حَسَّان الأزرق /11 /11 ومخلد بْن مَالِك الحمال خ /11 /11 ويحيى بْن معين /11 /11 ويوسف بْن يَعْقُوب الصفار بخ /11 /11 وأَبُو الربيع الزهراني /11 /11 وأَبُو معمر الْقَطِيعِيّ د /11 ++ قال أَبُو بَكْر الأثرم",
      "matn_ar": "عَنْ أَحْمَد بْن حَنْبَل : مَا كنت أظن عنده هذا الحديث الكثير ، فإذا هم يزعمون إن عنده عَنِ الأعمش حديثا كثيرا ، وعن غيره . وقد كتبنا عنه ، وكَانَ له أخ له قدر وعلم يقال له : عَبْد اللَّهِ بْن سَعِيد ، ولم يثبت أمر يَحْيَى فِي الحديث ، كأنه يَقُول : كَانَ يصدق وليس بصاحب حديث . # وقال",
