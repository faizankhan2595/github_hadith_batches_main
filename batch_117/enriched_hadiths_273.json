    {
      "hadith_id": 1048084,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 57530,
      "text_ar": "نزيل بغداد أخو عَبْد اللَّهِ بْن سَعِيد وعبيد بْن سَعِيد وعنبسة بْن سَعِيد ومُحَمَّد بْن سَعِيد ووالد سَعِيد بْن يَحْيَى بْن سَعِيد الأموي ولقبه جمل /10 إِسْمَاعِيل بْن أَبِي خَالِد /10 /10 وأبي بردة بْن عَبْد اللَّهِ بْن أَبِي بردة بْن أَبِي مُوسَى الأشعري خ م س /10 /10 وسعد بْن سَعِيد الأَنْصَارِيّ م صد /10 /10 وأبيه سَعِيد بْن أبان القرشي /10 /10 وأبي العنبس سَعِيد بْن كَثِير القرشي /10 /10 وسفيان الثوري /10 /10 وسليمان الأعمش خ /10 /10 وطلحة بْن يَحْيَى بْن طلحة بْن عُبَيْد اللَّهِ م /10 /10 وعبد الملك بْن جريج خ م ت /10 /10 وعبيد الله بْن عُمَر العمري /10 /10 وعثمان بْن حكيم بْن عباد بْن حنيف م د س /10 /10 وعثمان بْن عروة بْن الزبير /10 /10 ومجالد بْن سَعِيد /10 /10 ومُحَمَّد بْن إِسْحَاق بْن يسار /10 /10 ومُحَمَّد بْن سَعِيد الشامي ق /10 /10 ومُحَمَّد بْن عَمْرو بْن علقمة بْن وقاص الليثي /10 /10 ومُحَمَّد بْن قيس الأسدي س /10 /10 ومسعر بْن كدام خ /10 /10 وهشام بْن عروة ت /10 /10 ويحيى بْن سَعِيد الأَنْصَارِيّ م س /10 /10 وأبي فروة يَزِيد بْن سنان الجزري ق /10",
