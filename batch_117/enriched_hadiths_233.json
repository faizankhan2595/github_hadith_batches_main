      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 56940,
      "text_ar": "0 /11 الأسود بْن عَامِر شاذان ، قاله أَبُو الْحَسَن بْن حيويه ، عَنِ النسائي ، عَنْ مُحَمَّد بْن عَبْد اللَّهِ بْن الْمُبَارَك المخرمي ، عَنْ شاذان /11 ++ ورواه الْحُسَيْن بْن إِسْمَاعِيل المحاملي ، عَنِ المخرمي ، عَنْ شاذان ، عَنْ هريم بْن سُفْيَان ، عَنْ بيان على صواب . ++ وكذلك رواه أَبُو علي الأسيوطي ، عَنِ النسائي . ++ وكذلك رواه أَبُو بَكْر ، وعثمان ابنا أَبِي شيبة ، وعلي بْن حَرْب الطائي ، وغير واحد ، عَنْ شاذان على الصواب . @ 9089 [ 6759 ] عس",
      "sanad_ar": "0 /11 الأسود بْن عَامِر شاذان",
      "matn_ar": "قاله أَبُو الْحَسَن بْن حيويه ، عَنِ النسائي ، عَنْ مُحَمَّد بْن عَبْد اللَّهِ بْن الْمُبَارَك المخرمي ، عَنْ شاذان /11 ++ ورواه الْحُسَيْن بْن إِسْمَاعِيل المحاملي ، عَنِ المخرمي ، عَنْ شاذان ، عَنْ هريم بْن سُفْيَان ، عَنْ بيان على صواب . ++ وكذلك رواه أَبُو علي الأسيوطي ، عَنِ النسائي . ++ وكذلك رواه أَبُو بَكْر ، وعثمان ابنا أَبِي شيبة ، وعلي بْن حَرْب الطائي ، وغير واحد ، عَنْ شاذان على الصواب . @ 9089 [ 6759 ] عس",
