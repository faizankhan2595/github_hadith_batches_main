    {
      "hadith_id": 1044356,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 53802,
      "text_ar": "2 ++ وقال أَبُو بَكْرِ بْنُ أبي خيثمة ، عن سليمان بن أبي : شيخ ، حَدَّثَنَا أَبُو سفيان الحميري ، قال : خرج عمر بن ذر ، وموسى بن أبي كثير إِلَى عمر بن عَبْدِ العَزِيزِ ، وكَانَ معهم مزاحم بن زفر ، فقيل لعمر يعني ابن ذر : أين كَانَ مُوسَى منك ؟ قال : وأين أنا من مُوسَى ؟ يرفع مُوسَى ويقدمه عَلَى نفسه ++ روى له البخاري فِي الأدب ، والنسائي حديثا واحدا ، وقد وقع لنا بِعُلُوٍّ عَنْهُ . \r\n$3339  -10 /2 /141 أَخْبَرَنَا به /94 محمد بن عبد المؤمن L67915 /94 ، /94 وزينب بنت مكي L75040 /94 ، قَالا : أَنْبَأَنَا /26 أسعد بن سعيد بن روح L52121 /26 ، /26 وعَائِشَةُ بِنْتُ مَعْمَرِ بْنِ الْفَاخِرِ L63554 /26 ، قَالا : أَخْبَرَتْنَا /26 فاطمة بنت عبد الله L26337 /26 ، قَالَتْ : أخبرنا /26 أبو بكر بن ريذة L46623 /26 ، قال : أخبرنا /26 أبو القاسم الطبراني L18570 /26 ، قال : حَدَّثَنَا /26 إِبْرَاهِيمُ بْنُ بُنْدَارٍ الأَصْبَهَانِيُّ L65714 /26 ، قال : حَدَّثَنَا /26 مُحَمَّدُ بْنُ أَبِي عُمَرَ الْعَدَنِيُّ L7317 /26 ، قال : حَدَّثَنَا /26 سُفْيَانُ بْنُ عُيَيْنَةَ L3443 /26 ، عَنْ /26 مِسْعَرٍ L7433 /26 ، عَنْ /26 مُوسَى بْنِ أَبِي كَثِيرٍ L32280 /26 ، عَنْ /26 مُجَاهِدٍ L6715 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 ، قَالَتْ : \" كُنْتُ /20 آكُلُ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ حَيْسًا فِي قَعْبٍ ، فَمَرَّ عُمَرُ فَدَعَاهُ ، فَأَكَلَ ، فَأَصَابَ إِصْبَعُهُ إِصْبَعِي ، فَقَالَ : حَسِّ ، أَوْ أَوَّهْ ، لَوْ أُطَاعُ فِيكُنَّ مَا رَأَتْكُنَّ عَيْنٌ . فَنَزَلَتْ آيَةُ الْحِجَابِ . /27 قال الطَّبَرَانِيُّ : لَمْ يَرْوِهِ عَنْ مِسْعَرٍ إِلا سُفْيَانُ بْنُ عُيَيْنَةَ ، رَوَاهُ الْبُخَارِيُّ ، عَنِ الْحُمَيْدِيِّ ، عَنْ سُفْيَانَ ، فَوَقَعَ لَنَا بَدَلا عَالِيًا ، ورَوَاهُ النَّسَائِيُّ ، عَنْ زَكَرِيَّا بْنِ يَحْيَى السِّجْزِيِّ ، عَنِ ابْنِ أَبِي عُمَرَ ، فَوَقَعَ لَنَا بَدَلا عَالِيًا بِدَرَجَتَيْنِ * \r\n@ 8500 [ 6295 ] ق\u001aE5143",
      "sanad_ar": "2 ++ وقال أَبُو بَكْرِ بْنُ أبي خيثمة",
      "matn_ar": "عن سليمان بن أبي : شيخ ، حَدَّثَنَا أَبُو سفيان الحميري ، قال : خرج عمر بن ذر ، وموسى بن أبي كثير إِلَى عمر بن عَبْدِ العَزِيزِ ، وكَانَ معهم مزاحم بن زفر ، فقيل لعمر يعني ابن ذر : أين كَانَ مُوسَى منك ؟ قال : وأين أنا من مُوسَى ؟ يرفع مُوسَى ويقدمه عَلَى نفسه ++ روى له البخاري فِي الأدب ، والنسائي حديثا واحدا ، وقد وقع لنا بِعُلُوٍّ عَنْهُ . \r\n$3339  -10 /2 /141 أَخْبَرَنَا به /94 محمد بن عبد المؤمن L67915 /94 ، /94 وزينب بنت مكي L75040 /94 ، قَالا : أَنْبَأَنَا /26 أسعد بن سعيد بن روح L52121 /26 ، /26 وعَائِشَةُ بِنْتُ مَعْمَرِ بْنِ الْفَاخِرِ L63554 /26 ، قَالا : أَخْبَرَتْنَا /26 فاطمة بنت عبد الله L26337 /26 ، قَالَتْ : أخبرنا /26 أبو بكر بن ريذة L46623 /26 ، قال : أخبرنا /26 أبو القاسم الطبراني L18570 /26 ، قال : حَدَّثَنَا /26 إِبْرَاهِيمُ بْنُ بُنْدَارٍ الأَصْبَهَانِيُّ L65714 /26 ، قال : حَدَّثَنَا /26 مُحَمَّدُ بْنُ أَبِي عُمَرَ الْعَدَنِيُّ L7317 /26 ، قال : حَدَّثَنَا /26 سُفْيَانُ بْنُ عُيَيْنَةَ L3443 /26 ، عَنْ /26 مِسْعَرٍ L7433 /26 ، عَنْ /26 مُوسَى بْنِ أَبِي كَثِيرٍ L32280 /26 ، عَنْ /26 مُجَاهِدٍ L6715 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 ، قَالَتْ : \" كُنْتُ /20 آكُلُ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ حَيْسًا فِي قَعْبٍ ، فَمَرَّ عُمَرُ فَدَعَاهُ ، فَأَكَلَ ، فَأَصَابَ إِصْبَعُهُ إِصْبَعِي ، فَقَالَ : حَسِّ ، أَوْ أَوَّهْ ، لَوْ أُطَاعُ فِيكُنَّ مَا رَأَتْكُنَّ عَيْنٌ . فَنَزَلَتْ آيَةُ الْحِجَابِ . /27 قال الطَّبَرَانِيُّ : لَمْ يَرْوِهِ عَنْ مِسْعَرٍ إِلا سُفْيَانُ بْنُ عُيَيْنَةَ ، رَوَاهُ الْبُخَارِيُّ ، عَنِ الْحُمَيْدِيِّ ، عَنْ سُفْيَانَ ، فَوَقَعَ لَنَا بَدَلا عَالِيًا ، ورَوَاهُ النَّسَائِيُّ ، عَنْ زَكَرِيَّا بْنِ يَحْيَى السِّجْزِيِّ ، عَنِ ابْنِ أَبِي عُمَرَ ، فَوَقَعَ لَنَا بَدَلا عَالِيًا بِدَرَجَتَيْنِ * \r\n@ 8500 [ 6295 ] ق\u001aE5143",
