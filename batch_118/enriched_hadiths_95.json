    {
      "hadith_id": 1054418,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 63864,
      "text_ar": "حديثه فِي أهل البصرة . /10 ذكوان مولى عائشة /10 /10 وعبد اللَّه بْن عباس /10 /10 وعبد اللَّه بْن عُمَر بْن الخطاب /10 /10 وعكرمة خ س مولى ابْن عباس /10 /10 وأبي هريرة /10 /10 وأسماء بنت عميس ص /10 /10 وأم أيمن حاضنة النبي صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ /10 /10 وامرأة منهم يقال لها : ابنة عفيف لها صحبة /10",
      "sanad_ar": "حديثه فِي أهل البصرة . /10 ذكوان مولى عائشة /10 /10 وعبد اللَّه بْن عباس /10 /10 وعبد اللَّه بْن عُمَر بْن الخطاب /10 /10 وعكرمة خ س مولى ابْن عباس /10 /10 وأبي هريرة /10 /10 وأسماء بنت عميس ص /10 /10 وأم أيمن حاضنة النبي صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ /10 /10 وامرأة منهم يقال لها",
      "matn_ar": "ابنة عفيف لها صحبة /10",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10",
