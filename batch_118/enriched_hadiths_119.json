    {
      "hadith_id": 1054782,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 64228,
      "text_ar": "أو ضباعة ابنتي الزبير عن إحداهما ، أنها قالت : أصاب رَسُول اللَّهِ صَلَّى اللَّهُ عليه وسلم سبيا فذهبت أنا وأختي إلى فَاطِمَة بنت رَسُول اللَّهِ صَلَّى اللَّهُ عليه وسلم فشكونا ما نحن فِيهِ",
      "sanad_ar": "أو ضباعة ابنتي الزبير عن إحداهما",
      "matn_ar": "أنها قالت : أصاب رَسُول اللَّهِ صَلَّى اللَّهُ عليه وسلم سبيا فذهبت أنا وأختي إلى فَاطِمَة بنت رَسُول اللَّهِ صَلَّى اللَّهُ عليه وسلم فشكونا ما نحن فِيهِ",
