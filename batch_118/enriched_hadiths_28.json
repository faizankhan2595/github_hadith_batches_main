    {
      "hadith_id": 1053412,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 62858,
      "text_ar": "0 /11 حميد الحمصي /11 /11 وعمر بْن عبد الملك الفلسطيني /11 /11 وابنه يحيى بْن أَبِي عَمْرو السيباني بخ /11 # ذكره أَبُو الحسن بْن سميع فِي الطبقة الأولى بعد أصحاب رَسُول اللَّهِ صَلَّى اللَّهُ عليه وسلم ممن أدرك الجاهلية . ++ وقال يعقوب بْن سفيان فِي ثقات التابعين من أهل مصر : ومنهم أَبُو عَمْرو السيباني فِي عداد أهل فلسطين #",
      "sanad_ar": "0 /11 حميد الحمصي /11 /11 وعمر بْن عبد الملك الفلسطيني /11 /11 وابنه يحيى بْن أَبِي عَمْرو السيباني بخ /11 # ذكره أَبُو الحسن بْن سميع فِي الطبقة الأولى بعد أصحاب رَسُول اللَّهِ صَلَّى اللَّهُ عليه وسلم ممن أدرك الجاهلية . ++ وقال يعقوب بْن سفيان فِي ثقات التابعين من أهل مصر",
      "matn_ar": "ومنهم أَبُو عَمْرو السيباني فِي عداد أهل فلسطين #",
