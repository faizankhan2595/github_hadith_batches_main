      "chapter_id": null,
      "hadith_number": 27108,
      "text_ar": "أَخْبَرَنَا /94 مُوسَى بْنُ هَارُونَ الطُّوسِيُّ /94 فِيمَا كَتَبَ إِلَيَّ ، ثنا /26 الْحَسَنُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ /26 ، ثنا /26 شَيْبَانُ /26 ، /27 عَنْ /26 قَتَادَةَ /26 ، قَوْلُهُ : \" /20 /4 الَّذِينَ يُرِيدُونَ الْحَيَاةَ الدُّنْيَا سورة القصص آية 79 /4 أُنَاسٌ مِنْ أَهْلِ التَّوْحِيدِ ، قَالُوا : /4 يَا لَيْتَ لَنَا مِثْلَ مَا أُوتِيَ قَارُونُ سورة القصص آية 79 /4 \" /27 *",
      "sanad_ar": "أَخْبَرَنَا /94 مُوسَى بْنُ هَارُونَ الطُّوسِيُّ /94 فِيمَا كَتَبَ إِلَيَّ",
      "matn_ar": "ثنا /26 الْحَسَنُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ /26 ، ثنا /26 شَيْبَانُ /26 ، /27 عَنْ /26 قَتَادَةَ /26 ، قَوْلُهُ : \" /20 /4 الَّذِينَ يُرِيدُونَ الْحَيَاةَ الدُّنْيَا سورة القصص آية 79 /4 أُنَاسٌ مِنْ أَهْلِ التَّوْحِيدِ ، قَالُوا : /4 يَا لَيْتَ لَنَا مِثْلَ مَا أُوتِيَ قَارُونُ سورة القصص آية 79 /4 \" /27 *",
      "grade": null,
      "page_number": null,
