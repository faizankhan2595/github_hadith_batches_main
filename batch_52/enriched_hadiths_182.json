    {
      "hadith_id": 461723,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 22000,
      "text_ar": "/27 عن /26 السدي /26 ، في قوله : \" /20 /4 أَتَيَا أَهْلَ قَرْيَةٍ سورة الكهف آية 77 /4 ، قال : كانت القرية تسمى بأجروان كان أهلها لئامًا \" /27 * \r\n/10 عن محمد بن سيرين ، قال : \" أتيا الأبلة وهي أبعد أرض الله من السماء \" /10 /10 من طريق قتادة ، عن ابن عباس ، في قوله : \" /4 أَتَيَا أَهْلَ قَرْيَةٍ سورة الكهف آية 77 /4 ، قال : هي أبرقة \" ، قال : وحدثني رجل أنها : إنطاكية \" /10 /10 عن أيوب بن موسى ، قال : \" بلغني أن المسألة للمحتاج حسنة ، ألا تسمع أن موسى وصاحبه استطعما أهلها ؟ \" /10\u001cE2679",
      "sanad_ar": "/27 عن /26 السدي /26",
      "matn_ar": "في قوله : \" /20 /4 أَتَيَا أَهْلَ قَرْيَةٍ سورة الكهف آية 77 /4 ، قال : كانت القرية تسمى بأجروان كان أهلها لئامًا \" /27 * \r\n/10 عن محمد بن سيرين ، قال : \" أتيا الأبلة وهي أبعد أرض الله من السماء \" /10 /10 من طريق قتادة ، عن ابن عباس ، في قوله : \" /4 أَتَيَا أَهْلَ قَرْيَةٍ سورة الكهف آية 77 /4 ، قال : هي أبرقة \" ، قال : وحدثني رجل أنها : إنطاكية \" /10 /10 عن أيوب بن موسى ، قال : \" بلغني أن المسألة للمحتاج حسنة ، ألا تسمع أن موسى وصاحبه استطعما أهلها ؟ \" /10\u001cE2679",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/27,/26,/26,/20,/4,/4,/27,/10,/10,/10,/4,/4,/10,/10,/10",
