      "hadith_id": 459890,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 20167,
      "text_ar": "حَدَّثَنَا /94 أَبِي /94 ، ثنا /26 أَبُو كُرَيْبٍ /26 ، ثنا /26 مُعَاوِيَةُ بْنُ هِشَامٍ /26 ، عَنْ /26 شَيْبَانَ بْنِ عَبْدِ الرَّحْمَنِ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، /27 عَنْ /26 نَوْفٍ /26 ، قَالَ : \" /20 مَا كَانَ يُوسُفُ يُرِيدُ أَنْ يَذْكُرَهُ حَتَّى قَالَتِ امْرَأَةُ الْعَزِيزِ : /4 مَا جَزَاءُ مَنْ أَرَادَ بِأَهْلِكَ سُوءًا سورة يوسف آية 25 /4 ، فَغَضِبَ يُوسُفُ ، وَقَالَ : /4 هِيَ رَاوَدَتْنِي عَنْ نَفْسِي سورة يوسف آية 26 /4 \" /27 *",
      "sanad_ar": "حَدَّثَنَا /94 أَبِي /94",
      "matn_ar": "ثنا /26 أَبُو كُرَيْبٍ /26 ، ثنا /26 مُعَاوِيَةُ بْنُ هِشَامٍ /26 ، عَنْ /26 شَيْبَانَ بْنِ عَبْدِ الرَّحْمَنِ /26 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، /27 عَنْ /26 نَوْفٍ /26 ، قَالَ : \" /20 مَا كَانَ يُوسُفُ يُرِيدُ أَنْ يَذْكُرَهُ حَتَّى قَالَتِ امْرَأَةُ الْعَزِيزِ : /4 مَا جَزَاءُ مَنْ أَرَادَ بِأَهْلِكَ سُوءًا سورة يوسف آية 25 /4 ، فَغَضِبَ يُوسُفُ ، وَقَالَ : /4 هِيَ رَاوَدَتْنِي عَنْ نَفْسِي سورة يوسف آية 26 /4 \" /27 *",
      "grade": null,
