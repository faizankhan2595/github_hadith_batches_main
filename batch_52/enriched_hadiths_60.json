      "chapter_id": null,
      "hadith_number": 20163,
      "text_ar": "حَدَّثَنَا /94 أَبُو سَعِيدٍ الأَشَجُّ /94 ، ثنا /26 أَبُو أَحْمَدَ الزُّبَيْرِيُّ /26 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /18 /26 رَجُلٍ /26 /18 ، عَنْ /26 مُجَاهِدٍ /26 . ح وحَدَّثَنَا /94 أَبُو زُرْعَةَ /94 ، ثنا /26 قَبِيصَةُ /26 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 عِيسَى /26 ، /27 عَنْ /26 مُجَاهِدٍ /26 ، \" /20 /4 وَأَلْفَيَا سَيِّدَهَا لَدَى الْبَابِ سورة يوسف آية 25 /4 ، قَالَ : /4 سَيِّدَهَا سورة يوسف آية 25 /4 : زَوْجُهَا \" /27 *",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو سَعِيدٍ الأَشَجُّ /94",
      "matn_ar": "ثنا /26 أَبُو أَحْمَدَ الزُّبَيْرِيُّ /26 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /18 /26 رَجُلٍ /26 /18 ، عَنْ /26 مُجَاهِدٍ /26 . ح وحَدَّثَنَا /94 أَبُو زُرْعَةَ /94 ، ثنا /26 قَبِيصَةُ /26 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 عِيسَى /26 ، /27 عَنْ /26 مُجَاهِدٍ /26 ، \" /20 /4 وَأَلْفَيَا سَيِّدَهَا لَدَى الْبَابِ سورة يوسف آية 25 /4 ، قَالَ : /4 سَيِّدَهَا سورة يوسف آية 25 /4 : زَوْجُهَا \" /27 *",
