    {
      "hadith_id": 462439,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 22716,
      "text_ar": "أَخْبَرَنَا /94 أَبُو يَزِيدَ الْقَرَاطِيسِيُّ /94 فِيِمَا كَتَبَ إِلَيَّ ، ثنا /26 أَصْبَغُ /26 ، قال : /27 سَمِعْتُ /26 عَبْدَ الرَّحْمَنِ بْنَ زَيْدٍ /26 ، فِي قَوْلِهِ : /20 \" /4 فَاتَّخَذْتُمُوهُمْ سِخْرِيًّا سورة المؤمنون آية 110 /4 ، قَالَ : هُمَا مُخْتَلِفَانِ سِخْرِيًّا وَسُخْرِيًّا ، وَيَقُولُ اللَّهُ : /4 لِيَتَّخِذَ بَعْضُهُمْ بَعْضًا سُخْرِيًّا سورة الزخرف آية 32 /4 ، قال : يَسْخَرُونَ ، وَالآخَرُونَ الَّذِينَ يستهزئون سخريا ، والآخرون استهزءوا بأهل الإسلام هم سخريا يسخرون منهم ، فهما مختلفان \" /27 *",
      "sanad_ar": "أَخْبَرَنَا /94 أَبُو يَزِيدَ الْقَرَاطِيسِيُّ /94 فِيِمَا كَتَبَ إِلَيَّ",
      "matn_ar": "ثنا /26 أَصْبَغُ /26 ، قال : /27 سَمِعْتُ /26 عَبْدَ الرَّحْمَنِ بْنَ زَيْدٍ /26 ، فِي قَوْلِهِ : /20 \" /4 فَاتَّخَذْتُمُوهُمْ سِخْرِيًّا سورة المؤمنون آية 110 /4 ، قَالَ : هُمَا مُخْتَلِفَانِ سِخْرِيًّا وَسُخْرِيًّا ، وَيَقُولُ اللَّهُ : /4 لِيَتَّخِذَ بَعْضُهُمْ بَعْضًا سُخْرِيًّا سورة الزخرف آية 32 /4 ، قال : يَسْخَرُونَ ، وَالآخَرُونَ الَّذِينَ يستهزئون سخريا ، والآخرون استهزءوا بأهل الإسلام هم سخريا يسخرون منهم ، فهما مختلفان \" /27 *",
      "grade": null,
