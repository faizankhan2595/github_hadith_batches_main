    {
      "hadith_id": 462438,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 22715,
      "text_ar": "حَدَّثَنَا /94 أَبِي /94 ، ثنا /26 عُبَيْدٌ الْعَبْدِيُّ /26 ، ثنا /26 جَعْفَرُ بْنُ سُلَيْمَانَ /26 ، قال : /27 سَمِعْتُ /26 أَبَا   عِمْرَانَ الْجَنَدِيَّ /26 ، @ 8 : 2510 @ يَقُولُ : /20 \" إِنَّ اللَّهَ لَمْ يَنْظُرْ إِلَى شَيْءٍ قَطُّ إِلا رَحِمَه ، وَلَوْ نَظَرَ إِلَى أَهْلِ النَّارِ لَرَحِمَهُمْ ، وَلَكِنْ لا يَنْظُرُ إِلَيْهِمْ \" /27 * \r\n$13346  13343 /8",
      "sanad_ar": "حَدَّثَنَا /94 أَبِي /94",
      "matn_ar": "ثنا /26 عُبَيْدٌ الْعَبْدِيُّ /26 ، ثنا /26 جَعْفَرُ بْنُ سُلَيْمَانَ /26 ، قال : /27 سَمِعْتُ /26 أَبَا   عِمْرَانَ الْجَنَدِيَّ /26 ، @ 8 : 2510 @ يَقُولُ : /20 \" إِنَّ اللَّهَ لَمْ يَنْظُرْ إِلَى شَيْءٍ قَطُّ إِلا رَحِمَه ، وَلَوْ نَظَرَ إِلَى أَهْلِ النَّارِ لَرَحِمَهُمْ ، وَلَكِنْ لا يَنْظُرُ إِلَيْهِمْ \" /27 * \r\n$13346  13343 /8",
      "grade": null,
      "page_number": null,
