    {
      "hadith_id": 461390,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 21667,
      "text_ar": "/27 عن /26 السدى /26 رضي الله عنه ، في قوله : \" /20 /4 كُلًّا نُمِدُّ هَؤُلاءِ وَهَؤُلاءِ سورة الإسراء آية 20 /4 ، يقول : نمد الكفار والمؤمنين ، /4 مِنْ عَطَاءِ رَبِّكَ سورة الإسراء آية 20 /4 ، يقول : من الرزق \" /27 * \r\n/10 عن ابن زيد رضي الله عنه ، في قوله : \" /4 كُلًّا نُمِدُّ هَؤُلاءِ وَهَؤُلاءِ سورة الإسراء آية 20 /4 ، هؤلاء أهل الدنيا ، وهؤلاء أهل الآخرة ، /4 وَمَا كَانَ عَطَاءُ رَبِّكَ مَحْظُورًا سورة الإسراء آية 20 /4 ، قال : ممنوعًا \" /10    @ 7 : 2323 @   /10 عن الضحاك رضي الله عنه ، في قوله : \" /4 مَحْظُورًا سورة الإسراء آية 20 /4 ، قال : ممنوعًا \" /10",
      "sanad_ar": "/27 عن /26 السدى /26 رضي الله عنه",
      "matn_ar": "في قوله : \" /20 /4 كُلًّا نُمِدُّ هَؤُلاءِ وَهَؤُلاءِ سورة الإسراء آية 20 /4 ، يقول : نمد الكفار والمؤمنين ، /4 مِنْ عَطَاءِ رَبِّكَ سورة الإسراء آية 20 /4 ، يقول : من الرزق \" /27 * \r\n/10 عن ابن زيد رضي الله عنه ، في قوله : \" /4 كُلًّا نُمِدُّ هَؤُلاءِ وَهَؤُلاءِ سورة الإسراء آية 20 /4 ، هؤلاء أهل الدنيا ، وهؤلاء أهل الآخرة ، /4 وَمَا كَانَ عَطَاءُ رَبِّكَ مَحْظُورًا سورة الإسراء آية 20 /4 ، قال : ممنوعًا \" /10    @ 7 : 2323 @   /10 عن الضحاك رضي الله عنه ، في قوله : \" /4 مَحْظُورًا سورة الإسراء آية 20 /4 ، قال : ممنوعًا \" /10",
      "grade": null,
