      "hadith_id": 460072,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 20349,
      "text_ar": "قَرَأْتُ عَلَى /94 مُحَمَّدِ بْنِ الْفَضْلِ بْنِ مُوسَى /94 ، ثنا /26 مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ /26 ، ثنا /26 مُحَمَّدُ بْنُ مُزَاحِمٍ /26 ، عَنْ /26 بُكَيْرِ بْنِ مَعْرُوفٍ /26 ، /27 عَنْ /26 مُقَاتِلِ بْنِ حَيَّانٍ /26 ، \" /20 /4 ذَلِكَ الدِّينُ الْقَيِّمُ سورة يوسف آية 40 /4 ، يَقُولُ : ذَلِكَ الْحِسَابُ الْقَيِّمُ \" /27 * \r\n@ 7 : 2147 @",
      "sanad_ar": "قَرَأْتُ عَلَى /94 مُحَمَّدِ بْنِ الْفَضْلِ بْنِ مُوسَى /94",
      "matn_ar": "ثنا /26 مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ /26 ، ثنا /26 مُحَمَّدُ بْنُ مُزَاحِمٍ /26 ، عَنْ /26 بُكَيْرِ بْنِ مَعْرُوفٍ /26 ، /27 عَنْ /26 مُقَاتِلِ بْنِ حَيَّانٍ /26 ، \" /20 /4 ذَلِكَ الدِّينُ الْقَيِّمُ سورة يوسف آية 40 /4 ، يَقُولُ : ذَلِكَ الْحِسَابُ الْقَيِّمُ \" /27 * \r\n@ 7 : 2147 @",
