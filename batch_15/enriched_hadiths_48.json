    {
      "hadith_id": 126707,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 26333,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 مُحَمَّدُ بْنُ بَكْرٍ /94 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، قَالَ : أَخْبَرَنِي /26 عَبْدُ الْعَزِيزِ بْنُ عُمَرَ /26 ، /27 أَنَّ /26 عُمَرَ بْنَ عَبْدِ الْعَزِيزِ /26 كَتَبَ إلَى أُمَرَاءِ الْأَجْنَادِ \" فِي /20 شَفْرِ الْعَيْنِ الْأَعْلَى إذَا نُتِفَ : نِصْفُ الدِّيَةِ , وَفِي الشَّفْرِ الْأَسْفَلِ : ثُلُثُ دِيَةِ الْعَيْنِ \" /27 * \r\n@ 6 : 291 @\u001bE3829",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 مُحَمَّدُ بْنُ بَكْرٍ /94 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، قَالَ : أَخْبَرَنِي /26 عَبْدُ الْعَزِيزِ بْنُ عُمَرَ /26 ، /27 أَنَّ /26 عُمَرَ بْنَ عَبْدِ الْعَزِيزِ /26 كَتَبَ إلَى أُمَرَاءِ الْأَجْنَادِ \" فِي /20 شَفْرِ الْعَيْنِ الْأَعْلَى إذَا نُتِفَ : نِصْفُ الدِّيَةِ , وَفِي الشَّفْرِ الْأَسْفَلِ : ثُلُثُ دِيَةِ الْعَيْنِ \" /27 * \r\n@ 6 : 291 @\u001bE3829",
