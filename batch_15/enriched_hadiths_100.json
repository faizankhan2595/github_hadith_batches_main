      "chapter_id": null,
      "hadith_number": 27112,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنِ /26 ابْنِ أَبِي ذِئْبٍ /26 ، /27 عَنِ /26 الزُّهْرِيِّ /26 ، قَالَ : /20 \" إذَا قَبِلَ الْعَقْلَ فِي الْعَمْدِ كَانَ مِيرَاثًا تَرِثُهُ الزَّوْجَةُ وَغَيْرُهَا \" /27 * \r\n$26990  6 /3",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 مَعْنُ بْنُ عِيسَى /94 ، عَنِ /26 ابْنِ أَبِي ذِئْبٍ /26 ، /27 عَنِ /26 الزُّهْرِيِّ /26 ، قَالَ : /20 \" إذَا قَبِلَ الْعَقْلَ فِي الْعَمْدِ كَانَ مِيرَاثًا تَرِثُهُ الزَّوْجَةُ وَغَيْرُهَا \" /27 * \r\n$26990  6 /3",
      "grade": null,
      "page_number": null,
