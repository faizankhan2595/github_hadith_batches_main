    {
      "hadith_id": 126366,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 25992,
      "text_ar": "حَدَّثَنَا /94 غُنْدَرٌ L6904 /94 ، عَنْ /26 شُعْبَةَ L3795 /26 ، عَنْ /26 عَلِيِّ بْنِ مُدْرِكٍ L5813 /26 ، عَنْ /26 أَبِي زُرْعَةَ L181 /26 ، عَنْ /26 خَرَشَةَ بْنِ الْحُرِّ L2708 /26 ، /27 عَنْ /93 أَبِي ذَرٍّ L2187 /93 ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : /20 \" ثَلاثَةٌ لا يُكَلِّمُهُمُ اللَّهُ يَوْمَ الْقِيَامَةِ ، وَلا يَنْظُرُ إِلَيْهِمْ ، وَلا يُزَكِّيهِمْ ، وَلَهُمْ عَذَابٌ أَلِيمٌ \" , قَالَ : فَقَرَأَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَلاثَ مَرَّاتٍ ، فَقَالَ أَبُو ذَرٍّ : خَابُوا وَخَسِرُوا , مَنْ هُمْ يَا رَسُولَ اللَّهِ , قَالَ : \" الْمُسْبِلُ ، وَالْمَنَّانُ ، وَالْمُنْفِقُ سِلْعَتَهُ بِالْحَلِفِ الْكَاذِبِ \" /27 * \r\n$26009  4 /2",
      "sanad_ar": "حَدَّثَنَا /94 غُنْدَرٌ L6904 /94",
      "matn_ar": "عَنْ /26 شُعْبَةَ L3795 /26 ، عَنْ /26 عَلِيِّ بْنِ مُدْرِكٍ L5813 /26 ، عَنْ /26 أَبِي زُرْعَةَ L181 /26 ، عَنْ /26 خَرَشَةَ بْنِ الْحُرِّ L2708 /26 ، /27 عَنْ /93 أَبِي ذَرٍّ L2187 /93 ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : /20 \" ثَلاثَةٌ لا يُكَلِّمُهُمُ اللَّهُ يَوْمَ الْقِيَامَةِ ، وَلا يَنْظُرُ إِلَيْهِمْ ، وَلا يُزَكِّيهِمْ ، وَلَهُمْ عَذَابٌ أَلِيمٌ \" , قَالَ : فَقَرَأَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَلاثَ مَرَّاتٍ ، فَقَالَ أَبُو ذَرٍّ : خَابُوا وَخَسِرُوا , مَنْ هُمْ يَا رَسُولَ اللَّهِ , قَالَ : \" الْمُسْبِلُ ، وَالْمَنَّانُ ، وَالْمُنْفِقُ سِلْعَتَهُ بِالْحَلِفِ الْكَاذِبِ \" /27 * \r\n$26009  4 /2",
