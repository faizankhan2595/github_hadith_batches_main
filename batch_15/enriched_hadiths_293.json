    {
      "hadith_id": 130393,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 30019,
      "text_ar": "حَدَّثَنَا /94 غُنْدَرٌ /94 ، عَنْ /26 شُعْبَةَ /26 ، عَنْ /26 عَمْرِو بْنِ مُرَّةَ /26 ، قَالَ : /27 سَأَلَ رَجُلٌ /26 سَعِيدَ بْنَ الْمُسَيِّبِ /26 عَنْ آيَةٍ مِنْ الْقُرْآنِ ، فَقَالَ : /20 \" لَا تَسْأَلْنِي عَنْ الْقُرْآنِ , وَسَلْ عَنْهُ مَنْ يَزْعُمُ أَنَّهُ لَا يَخْفَى عَلَيْهِ مِنْهُ شَيْءٌ ، يَعْنِي : عِكْرِمَةَ \" /27 * \r\n$29512  /3",
      "sanad_ar": "حَدَّثَنَا /94 غُنْدَرٌ /94",
      "matn_ar": "عَنْ /26 شُعْبَةَ /26 ، عَنْ /26 عَمْرِو بْنِ مُرَّةَ /26 ، قَالَ : /27 سَأَلَ رَجُلٌ /26 سَعِيدَ بْنَ الْمُسَيِّبِ /26 عَنْ آيَةٍ مِنْ الْقُرْآنِ ، فَقَالَ : /20 \" لَا تَسْأَلْنِي عَنْ الْقُرْآنِ , وَسَلْ عَنْهُ مَنْ يَزْعُمُ أَنَّهُ لَا يَخْفَى عَلَيْهِ مِنْهُ شَيْءٌ ، يَعْنِي : عِكْرِمَةَ \" /27 * \r\n$29512  /3",
