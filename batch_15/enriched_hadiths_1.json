    {
      "hadith_id": 126002,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 25628,
      "text_ar": "حَدَّثَنَا أَبُو بَكْرٍ ، قَالَ : حَدَّثَنَا /94 ابْنُ إِدْرِيسَ /94 ، عَنْ /26 أَشْعَثَ /26 ، /27 عَنِ /26 الشَّعْبِيِّ /26 ، قَالَ : /20 \" إِذَا اخْتَلَفَ النَّاسُ فِي شَيْءٍ ، فَانْظُرْ كَيْفَ صَنَعَ فِيهِ عُمَرُ ، فَإِنَّهُ كَانَ لا يَصْنَعُ شَيْئًا حَتَّى يَسْأَلَ وَيُشَاوِرَ \" /27 * \r\n$25687  5 /8",
      "sanad_ar": "حَدَّثَنَا أَبُو بَكْرٍ",
      "matn_ar": "قَالَ : حَدَّثَنَا /94 ابْنُ إِدْرِيسَ /94 ، عَنْ /26 أَشْعَثَ /26 ، /27 عَنِ /26 الشَّعْبِيِّ /26 ، قَالَ : /20 \" إِذَا اخْتَلَفَ النَّاسُ فِي شَيْءٍ ، فَانْظُرْ كَيْفَ صَنَعَ فِيهِ عُمَرُ ، فَإِنَّهُ كَانَ لا يَصْنَعُ شَيْئًا حَتَّى يَسْأَلَ وَيُشَاوِرَ \" /27 * \r\n$25687  5 /8",
      "grade": null,
