    {
      "hadith_id": 126456,
      "book_id": 96,
      "chapter_id": null,
      "hadith_number": 26082,
      "text_ar": "حَدَّثَنَا /94 حَفْصٌ /94 ، /94 وَابْنُ نُمَيْرٍ /94 ، /94 ووكيع /94 ، عَنِ /26 الأَعْمَشِ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، قَالَ : /27 قَالَ /93 عَبْدُ اللَّهِ L5079 /93 : /20 \" اتَّقُوا \" /23 ، وَقَالَ حَفْصٌ : /23 \" إِيَّاكُمْ وَالْمَعَاذِرُ فَإِنَّ كَثِيرًا مِنْهَا كَذِبٌ \" /27 * \r\n$26086  4 /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ عَبْدِ اللَّهِ الأَسَدِيُّ /94 , عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 طَارِقٍ /26 ، عَنِ /26 الشَّعْبِيِّ /26 قَالَ : /27 /20 \" خَرَجَ إِلَيْنَا /26 شُرَيْحٌ /26 يَعْتَذِرُ \" /27 * \r\n$26087  5 /8",
      "sanad_ar": "حَدَّثَنَا /94 حَفْصٌ /94",
      "matn_ar": "/94 وَابْنُ نُمَيْرٍ /94 ، /94 ووكيع /94 ، عَنِ /26 الأَعْمَشِ /26 ، عَنْ /26 إِبْرَاهِيمَ /26 ، قَالَ : /27 قَالَ /93 عَبْدُ اللَّهِ L5079 /93 : /20 \" اتَّقُوا \" /23 ، وَقَالَ حَفْصٌ : /23 \" إِيَّاكُمْ وَالْمَعَاذِرُ فَإِنَّ كَثِيرًا مِنْهَا كَذِبٌ \" /27 * \r\n$26086  4 /8 /141 حَدَّثَنَا /94 مُحَمَّدُ بْنُ عَبْدِ اللَّهِ الأَسَدِيُّ /94 , عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 طَارِقٍ /26 ، عَنِ /26 الشَّعْبِيِّ /26 قَالَ : /27 /20 \" خَرَجَ إِلَيْنَا /26 شُرَيْحٌ /26 يَعْتَذِرُ \" /27 * \r\n$26087  5 /8",
