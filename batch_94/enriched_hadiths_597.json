    {
      "hadith_id": 845942,
      "book_id": 910,
      "chapter_id": null,
      "hadith_number": 1495,
      "text_ar": "ذَكَرَ عَبْد الملك بْن حبيب أَنَّهُ دَخَلَ الأندلس مَعَ مُوسَى بْن نصير وأصحابه ، وأنه من جملة التابعين رَضِيَ اللَّه عَنْهُمْ . قاله : ابن بشكوال فِي مجموعه المترجم بالتنبيه والتعيين لمن دَخَلَ الأندلس من التابعين ، وقد سمعته من أبي الخَطَّاب بْن واجب ، وسمعه هُوَ مِنْهُ . 776 -",
      "sanad_ar": "ذَكَرَ عَبْد الملك بْن حبيب أَنَّهُ دَخَلَ الأندلس مَعَ مُوسَى بْن نصير وأصحابه",
      "matn_ar": "وأنه من جملة التابعين رَضِيَ اللَّه عَنْهُمْ . قاله : ابن بشكوال فِي مجموعه المترجم بالتنبيه والتعيين لمن دَخَلَ الأندلس من التابعين ، وقد سمعته من أبي الخَطَّاب بْن واجب ، وسمعه هُوَ مِنْهُ . 776 -",
