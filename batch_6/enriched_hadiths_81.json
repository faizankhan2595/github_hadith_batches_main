      "chapter_id": null,
      "hadith_number": 2360,
      "text_ar": "عَنْ /26 مَعْمَرٍ L7633 /26 , عَنْ /18 /26 شَيْخٍ L1131 /26 /18 , مِنْ غِفَارٍ , عَنْ /26 سَعِيدِ بْنِ أَبِي سَعِيدِ L3334 /26 , /27 عَنْ /93 أَبِي هُرَيْرَةَ L4396 /93 , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ : /20 \" لَقَدْ أَعْذَرَ اللَّهُ إِلَى عَبْدٍ أَحْيَاهُ حَتَّى بَلَغَ سِتِّينَ أَوْ سَبْعِينَ سَنَةً , لَقَدْ أَعْذَرَ اللَّهُ إِلَيْهِ , لَقَدْ أَعْذَرَ اللَّهُ إِلَيْهِ \" /27 * \r\n@ 3 : 75 @\u001aE409",
      "sanad_ar": "عَنْ /26 مَعْمَرٍ L7633 /26 , عَنْ /18 /26 شَيْخٍ L1131 /26 /18 , مِنْ غِفَارٍ , عَنْ /26 سَعِيدِ بْنِ أَبِي سَعِيدِ L3334 /26 , /27 عَنْ /93 أَبِي هُرَيْرَةَ L4396 /93 , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ",
      "matn_ar": "/20 \" لَقَدْ أَعْذَرَ اللَّهُ إِلَى عَبْدٍ أَحْيَاهُ حَتَّى بَلَغَ سِتِّينَ أَوْ سَبْعِينَ سَنَةً , لَقَدْ أَعْذَرَ اللَّهُ إِلَيْهِ , لَقَدْ أَعْذَرَ اللَّهُ إِلَيْهِ \" /27 * \r\n@ 3 : 75 @\u001aE409",
