    {
      "hadith_id": 50688,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 3175,
      "text_ar": "عَنِ /94الثَّوْرِيِّ L3436/94 , عَنْ /26 يَحْيَى بْنِ سَعِيدٍ L8272 /26 , /27 عَنْ /93 أَنَسٍ L720 /93 , قَالَ : \" كُنَّا مَعَهُ /20 فَصَلَّى الْعَصْرَ فَتَحَرَّكَ لِلْقِيَامِ , فَسَبَّحُوا , فَسَجَدَ سَجْدَتَيِ السَّهْوِ \" /27 * \r\n$3376  3378 /3 /141 عَنِ /94 ابْنِ جُرَيْجٍ /94 , قَالَ : أَخْبَرَنِي /26 عَمْرُو بْنُ دِينَارٍ /26 , أَنَّ /26 طَاوُسًا /26 أَخْبَرَهُ : /27 \" أَنَّ /93 ابْنَ الزُّبَيْرِ L4697 /93 /20 قَامَ فِي رَكْعَتَيْنِ مِنَ الْمَغْرِبِ , أَوْ أَرَادَ الْقِيَامَ /27 , قَالَ : مَا رَأَيْتُ طَاوُسًا إِلا شَكَّ أَيَّهُمَا فَعَلَ ؟ نَهَضَ أَوْ أَرَادَ النُّهُوضَ ثُمَّ سَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ , قَالَ : فَذَكَرْتُ ذَلِكَ لابْنِ عَبَّاسٍ , قَالَ : فَقَالَ : أَصَابَ لَعَمْرِي , قُلْتُ : وَأَخْبَرَكَ أَنَّهُ سَجَدَهَا قَبْلَ التَّسْلِيمِ , أَوْ بَعْدُ ؟ قَالَ : لا أَدْرِي \" * \r\n@ 2 : 312 @%E591",
      "sanad_ar": "عَنِ /94الثَّوْرِيِّ L3436/94 , عَنْ /26 يَحْيَى بْنِ سَعِيدٍ L8272 /26 , /27 عَنْ /93 أَنَسٍ L720 /93 , قَالَ",
      "matn_ar": "\" كُنَّا مَعَهُ /20 فَصَلَّى الْعَصْرَ فَتَحَرَّكَ لِلْقِيَامِ , فَسَبَّحُوا , فَسَجَدَ سَجْدَتَيِ السَّهْوِ \" /27 * \r\n$3376  3378 /3 /141 عَنِ /94 ابْنِ جُرَيْجٍ /94 , قَالَ : أَخْبَرَنِي /26 عَمْرُو بْنُ دِينَارٍ /26 , أَنَّ /26 طَاوُسًا /26 أَخْبَرَهُ : /27 \" أَنَّ /93 ابْنَ الزُّبَيْرِ L4697 /93 /20 قَامَ فِي رَكْعَتَيْنِ مِنَ الْمَغْرِبِ , أَوْ أَرَادَ الْقِيَامَ /27 , قَالَ : مَا رَأَيْتُ طَاوُسًا إِلا شَكَّ أَيَّهُمَا فَعَلَ ؟ نَهَضَ أَوْ أَرَادَ النُّهُوضَ ثُمَّ سَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ , قَالَ : فَذَكَرْتُ ذَلِكَ لابْنِ عَبَّاسٍ , قَالَ : فَقَالَ : أَصَابَ لَعَمْرِي , قُلْتُ : وَأَخْبَرَكَ أَنَّهُ سَجَدَهَا قَبْلَ التَّسْلِيمِ , أَوْ بَعْدُ ؟ قَالَ : لا أَدْرِي \" * \r\n@ 2 : 312 @%E591",
