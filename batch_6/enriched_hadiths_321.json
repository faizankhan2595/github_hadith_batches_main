    {
      "hadith_id": 49804,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 2291,
      "text_ar": "عَنِ /94 ابْنِ جُرَيْجٍ /94 , قَالَ : أَخْبَرَنِي /26 عُبَيْدِ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ السَّائِبِ بْنِ عُمَيْرٍ /26 , قَالَ : \" /27 قُلْتُ /26 لابْنِ الْمُسَيِّبِ /26 : إِنِّي أَسْجُدُ يَوْمَ الْجُمُعَةِ , فِيَقُولُ لِي الشَّيْطَانُ : لَمْ تُكَبِّرْ تَكْبِيرَةَ الاسْتِفْتَاحِ , قَالَ ابْنُ الْمُسَيِّبِ : /20 كَبَّرْتَ قَبْلُ وَبَعْدُ \" /27 * \r\n$2458  2460 /8",
      "sanad_ar": "عَنِ /94 ابْنِ جُرَيْجٍ /94 , قَالَ",
      "matn_ar": "أَخْبَرَنِي /26 عُبَيْدِ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ السَّائِبِ بْنِ عُمَيْرٍ /26 , قَالَ : \" /27 قُلْتُ /26 لابْنِ الْمُسَيِّبِ /26 : إِنِّي أَسْجُدُ يَوْمَ الْجُمُعَةِ , فِيَقُولُ لِي الشَّيْطَانُ : لَمْ تُكَبِّرْ تَكْبِيرَةَ الاسْتِفْتَاحِ , قَالَ ابْنُ الْمُسَيِّبِ : /20 كَبَّرْتَ قَبْلُ وَبَعْدُ \" /27 * \r\n$2458  2460 /8",
