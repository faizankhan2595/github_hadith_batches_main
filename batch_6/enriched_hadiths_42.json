    {
      "hadith_id": 45625,
      "book_id": 59,
      "chapter_id": null,
      "hadith_number": 1783,
      "text_ar": "أرنا /94 ابْنُ عُيَيْنَةَ /94 , عَنْ /26 عَطَاءِ بْنِ السَّائِبِ /26 ، قَالَ : /27 قَالَ /93 ابْنُ عَبَّاسٍ L4883 /93 : /20 \" مَنْ قَرَأَ الْقُرْآنَ فَاتَّبَعَ مَا فِيهِ ، هَدَاهُ اللَّهُ مِنَ الضَّلالَةِ فِي الدُّنْيَا , وَوَقَاهُ اللَّهُ يَوْمَ الْقِيَامَةِ الْحِسَابَ \" ، قَالَ : \" فَذَلِكَ قَوْلُهُ تَعَالَى : /4 فَمَنِ اتَّبَعَ هُدَايَ فَلا يَضِلُّ وَلا يَشْقَى سورة طه آية 123 /4 /27 * \r\n@ 2 : 380 @ \r\n$1799  1799 /3",
      "sanad_ar": "أرنا /94 ابْنُ عُيَيْنَةَ /94 , عَنْ /26 عَطَاءِ بْنِ السَّائِبِ /26",
      "matn_ar": "قَالَ : /27 قَالَ /93 ابْنُ عَبَّاسٍ L4883 /93 : /20 \" مَنْ قَرَأَ الْقُرْآنَ فَاتَّبَعَ مَا فِيهِ ، هَدَاهُ اللَّهُ مِنَ الضَّلالَةِ فِي الدُّنْيَا , وَوَقَاهُ اللَّهُ يَوْمَ الْقِيَامَةِ الْحِسَابَ \" ، قَالَ : \" فَذَلِكَ قَوْلُهُ تَعَالَى : /4 فَمَنِ اتَّبَعَ هُدَايَ فَلا يَضِلُّ وَلا يَشْقَى سورة طه آية 123 /4 /27 * \r\n@ 2 : 380 @ \r\n$1799  1799 /3",
