      "hadith_id": 49897,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 2384,
      "text_ar": "عَنِ /94 ابْنِ جُرَيْجٍ /94 , قَالَ : /27 قُلْتُ /26 لِعَطَاءٍ /26 : /20 أَيَجْزِي عَنِّي فِي كُلِّ رَكْعَةٍ /65 إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ /65 , لَيْسَ مَعَهَا أُمُّ الْقُرْآنِ فِي الْمَكْتُوبَةِ ؟ , قَالَ \" لا , وَلا سُورَةُ الْبَقَرَةِ \" , قَالَ : /4 وَلَقَدْ آتَيْنَاكَ سَبْعًا مِنَ الْمَثَانِي سورة الحجر آية 87 /4 , قَالَ :    @ 2 : 95 @   \" هِيَ السَّبْعُ \" , قُلْتُ : فَأَيْنَ السَّابِعَةُ ؟ , قَالَ : \" /4 بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ سورة الفاتحة آية 1 /4 , وَهُوَ يُوجِبُ أُمَّ الْقُرْآنِ فِي كُلِّ رَكْعَةٍ \" /27 * \r\n$2542  2544 /8",
      "sanad_ar": "عَنِ /94 ابْنِ جُرَيْجٍ /94 , قَالَ",
      "matn_ar": "/27 قُلْتُ /26 لِعَطَاءٍ /26 : /20 أَيَجْزِي عَنِّي فِي كُلِّ رَكْعَةٍ /65 إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ /65 , لَيْسَ مَعَهَا أُمُّ الْقُرْآنِ فِي الْمَكْتُوبَةِ ؟ , قَالَ \" لا , وَلا سُورَةُ الْبَقَرَةِ \" , قَالَ : /4 وَلَقَدْ آتَيْنَاكَ سَبْعًا مِنَ الْمَثَانِي سورة الحجر آية 87 /4 , قَالَ :    @ 2 : 95 @   \" هِيَ السَّبْعُ \" , قُلْتُ : فَأَيْنَ السَّابِعَةُ ؟ , قَالَ : \" /4 بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ سورة الفاتحة آية 1 /4 , وَهُوَ يُوجِبُ أُمَّ الْقُرْآنِ فِي كُلِّ رَكْعَةٍ \" /27 * \r\n$2542  2544 /8",
