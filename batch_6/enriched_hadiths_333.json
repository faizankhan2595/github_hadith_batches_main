    {
      "hadith_id": 49984,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 2471,
      "text_ar": "عَنْ /94 مَعْمَرٍ /94 , عَنْ /26 عَاصِمِ بْنِ سُلَيْمَانَ /26 , عَنْ /26 أَبِي عُثْمَانَ النَّهْدِيِّ /26 , قَالَ : /27 صَلَّى بِنَا /93 عُمَرُ L5913 /93 صَلاةَ الْغَدَاةِ , فَمَا انْصَرَفَ حَتَّى عَرَفَ كُلُّ ذِي بَالٍ أَنَّ الشَّمْسَ قَدْ طَلَعَتْ , قَالَ : فَقِيلَ لَهُ : /20 مَا فَرَغْتَ حَتَّى كَادَتِ الشَّمْسُ تَطْلُعُ , فَقَالَ : \" لَوْ طَلَعَتْ لأَلْفَتْنَا غَيْرَ غَافِلِينَ \" /27 * \r\n$2628  2630 /3",
      "sanad_ar": "عَنْ /94 مَعْمَرٍ /94 , عَنْ /26 عَاصِمِ بْنِ سُلَيْمَانَ /26 , عَنْ /26 أَبِي عُثْمَانَ النَّهْدِيِّ /26 , قَالَ",
      "matn_ar": "/27 صَلَّى بِنَا /93 عُمَرُ L5913 /93 صَلاةَ الْغَدَاةِ , فَمَا انْصَرَفَ حَتَّى عَرَفَ كُلُّ ذِي بَالٍ أَنَّ الشَّمْسَ قَدْ طَلَعَتْ , قَالَ : فَقِيلَ لَهُ : /20 مَا فَرَغْتَ حَتَّى كَادَتِ الشَّمْسُ تَطْلُعُ , فَقَالَ : \" لَوْ طَلَعَتْ لأَلْفَتْنَا غَيْرَ غَافِلِينَ \" /27 * \r\n$2628  2630 /3",
