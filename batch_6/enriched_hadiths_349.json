    {
      "hadith_id": 50222,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 2709,
      "text_ar": "عَنْ /94 هُشَيْمِ بْنِ بَشِيرٍ /94 , عَنْ /26 مَنْصُورٍ /26 , /26 وَيُونُسَ /26 , /27 عَنِ /26 الْحَسَنِ /26 : \" أَنَّهُ كَانَ /20 لا يَرَى بَأْسًا , أَنْ يَعْتَمِدَ الرَّجُلُ عَلَى يَدَيْهِ إِذَا نَهَضَ فِي الصَّلاةِ \" /27 * \r\n$2880  2882 /8",
      "sanad_ar": "عَنْ /94 هُشَيْمِ بْنِ بَشِيرٍ /94 , عَنْ /26 مَنْصُورٍ /26 , /26 وَيُونُسَ /26 , /27 عَنِ /26 الْحَسَنِ /26",
