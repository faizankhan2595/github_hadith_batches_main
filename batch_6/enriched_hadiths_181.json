      "hadith_id": 47710,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 197,
      "text_ar": "عَنْ /94 حُمَيْدٍ L2528 /94 ، عَنِ /26 الْحَجَّاجِ بْنِ أَرْطَاةَ L2288 /26 , قَالَ : أَخْبَرَنِي /26 أَبُو الزُّبَيْرِ L7270 /26 ، أَنَّهُ /27 سَمِعَ /93 جَابِرَ بْنَ عَبْدِ اللَّهِ L2069 /93 , يَقُولُ : لا بَأْسَ بِجُلُودِ السِّبَاعِ إِذَا دُبِغَتْ ، وَيَقُولُ : \" قَدْ /20 رَخَّصَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي جُلُودِ الْمَيْتَةِ \" /27 , قَالَ عَبْدُ الرَّزَّاقِ : وَسَمِعْتُ أَنَا /94 إِبْرَاهِيمَ L892 /94 , وَغَيْرَهُ يَذْكُرُ , عَنْ /26 أَبِي الزُّبَيْرِ L7270 /26 ، عَنْ جَابِرٍ * \r\n$229  229 229 /8 /141 عَنْ /94 إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ أَبِي الْوَلِيدِ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 , قَالَ : /27 \" كَانَ /26 ابْنُ سِيرِينَ /26 /20 يَرْكَبُ بِسَرْجٍ عَلَيْهِ جِلْدُ نَمِرٍ \" /27 , قَالَ : \" وَكَانَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ يَرْكَبُ عَلَيْهِ \" * \r\n$230  230 230 /8",
      "sanad_ar": "عَنْ /94 حُمَيْدٍ L2528 /94",
      "matn_ar": "عَنِ /26 الْحَجَّاجِ بْنِ أَرْطَاةَ L2288 /26 , قَالَ : أَخْبَرَنِي /26 أَبُو الزُّبَيْرِ L7270 /26 ، أَنَّهُ /27 سَمِعَ /93 جَابِرَ بْنَ عَبْدِ اللَّهِ L2069 /93 , يَقُولُ : لا بَأْسَ بِجُلُودِ السِّبَاعِ إِذَا دُبِغَتْ ، وَيَقُولُ : \" قَدْ /20 رَخَّصَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي جُلُودِ الْمَيْتَةِ \" /27 , قَالَ عَبْدُ الرَّزَّاقِ : وَسَمِعْتُ أَنَا /94 إِبْرَاهِيمَ L892 /94 , وَغَيْرَهُ يَذْكُرُ , عَنْ /26 أَبِي الزُّبَيْرِ L7270 /26 ، عَنْ جَابِرٍ * \r\n$229  229 229 /8 /141 عَنْ /94 إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ أَبِي الْوَلِيدِ /94 ، عَنِ /26 ابْنِ عَوْنٍ /26 , قَالَ : /27 \" كَانَ /26 ابْنُ سِيرِينَ /26 /20 يَرْكَبُ بِسَرْجٍ عَلَيْهِ جِلْدُ نَمِرٍ \" /27 , قَالَ : \" وَكَانَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ يَرْكَبُ عَلَيْهِ \" * \r\n$230  230 230 /8",
