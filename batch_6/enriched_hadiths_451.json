      "hadith_id": 51760,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 4247,
      "text_ar": "عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ عَوْفٍ /26 ، /27 عَنِ /26 ابْنِ سِيرِينَ /26 ، قَالَ \" /20 الْوِتْرُ مِنَ اللَّيْلِ ، وَيُسْتَحَبُّ أَنْ يَكُونَ مِنْ آخِرِ اللَّيْلِ ، وَيُسْتَحَبُّ التَّكْبِيرُ عِنْدَ الْفَجْرِ بِالرَّكْعَتَيْنِ ، وَهُمَا مِنْ صَلاةِ النَّهَارِ \" /27 * \r\n\u001aE809 \r\n$4626  4628 /2 /141 عَنْ /94 عَبْدِ اللَّهِ بْنِ عُمَرَ L4968 /94 ، عَنْ /26 نَافِعٍ L7863 /26 ، عَنِ /26 ابْنِ عُمَرَ L4967 /26 ، /27 عَنْ /93 حَفْصَةَ L2457 /93 ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 إِذَا طَلَعَ الْفَجْرُ صَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ اضْطَجَعَ عَلَى شِقِّهِ الأَيْمَنِ \" /27 * \r\n$4627  4629 /2 /141 عَنْ /94 مَعْمَرٍ L7633 /94 ، عَنِ /26 الزُّهْرِيِّ L7272 /26 ، عَنْ /26 عُرْوَةَ L5594 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 يُصَلِّي إِذَا طَلَعَ الْفَجْرُ رَكْعَتَيْنِ خَفِيفَتَيْنِ ،    @ 3 : 56 @   ثُمَّ يَضْطَجِعُ عَلَى شِقِّهِ الأَيْمَنِ \" /27 * \r\n$4628  4630 /2 /141 أَخْبَرَنَا /94 مَعْمَرٌ L7633 /94 ، عَنِ /26 الزُّهْرِيِّ L7272 /26 ، عَنْ /26 سَالِمٍ L3194 /26 ، عَنِ /26 ابْنِ عُمَرَ L4967 /26 ، قَالَ : /27 أَخْبَرَتْنِي /93 حَفْصَةُ L2457 /93 \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ /20 إِذَا طَلَعَ الْفَجْرُ ، صَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ \" /27 * \r\n$4629  4631 /3 /141 عَنْ /94 إِسْرَائِيلَ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنِ /26 الْحَارِثِ /26 ، /27 عَنْ /93 عَلِيٍّ L5722 /93 ، قَالَ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 يُصَلِّي رَكْعَتَيِ الْفَجْرِ عِنْدَ الإِقَامَةِ \" /27 * \r\n$4630  4632 /2 /141 عَنْ /26 مَالِكٍ L6659 /26 ، عَنْ /26 مُحَمَّدِ بْنِ مَخْرَمَةَ بْنِ سُلَيْمَانَ L41481 /26 ، عَنْ /26 كُرَيْبٍ L6588 /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 \" أَنَّ الْمُؤَذِّنَ جَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 فَصَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ خَرَجَ فَصَلَّى الصُّبْحَ \" /27 * \r\n$4631  4633 /2 /141 عَنْ /94 مَعْمَرٍ L7633 /94 ، عَنْ /26 يَحْيَى بْنِ سَعِيدٍ L8272 /26 ، عَنْ /26 عَمْرَةَ L6058 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 ، قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 يُخَفِّفُهُمَا \" ، يَعْنِي رَكْعَتَيِ الْفَجْرِ /27 * \r\n$4632  4634 /3 /141 عَنْ /94 مَعْمَرٍ /94 ، عَنْ /26 أَبِي إِسْحَاقَ /26 ، عَنِ /26 الْحَارِثِ /26 ، /27 عَنْ /93 عَلِيٍّ L5722 /93 \" أَنَّهُ كَانَ /20 يَرْكَعُهُمَا عِنْدَ الإِقَامَةِ \" /27 * \r\n+E810",
      "sanad_ar": "عَنِ /94 الثَّوْرِيِّ /94",
