      "hadith_number": 1406,
      "text_ar": "عَنِ /94 ابْنِ عُيَيْنَةَ /94 , قَالَ : /27 قُلْتُ /26 لِعَطَاءٍ /26 : /20 \" أَرَأَيْتَ إِنْسَانًا يُصَلِّي ، وَعَلَيْهِ طَاقٌ فِي بَرْدٍ فَجَعَلَ يَسْجُدُ عَلَى طَاقِهِ ، وَلا يُخْرِجُ يَدَيْهِ , قَالَ : \" لا يَضُرُّهُ \" ، قُلْتُ : فَلِغَيْرِ بَرْدٍ , قَالَ : \" أَحَبُّ إِلَيَّ أَنْ يُسَوِّيَ بَيْنَهُمَا ، وَبَيْنَ الأَرْضِ , فَإِنْ لَمْ يَفْعَلْ فَلا حَرَجَ \" ، قُلْتُ : أَحَبُّ إِلَيْكَ أَنْ لا يُصَلِّيَ عَلَى شَيْءٍ إِلا عَلَى الأَرْضِ , وَيَدَعُ ذَلِكَ كُلَّهُ ؟ , قَالَ : \" نَعَمْ \" /27 * \r\n$1483  1483 1478 /3 /141 عَنِ /94 ابْنِ جُرَيْجٍ /94 , قَالَ : أَخْبَرَنِي /26 نَافِعٌ /26 ، /27 أَنَّ /93 ابْنَ عُمَرَ L4967 /93 \" كَانَ /20 يُصَلِّي عَلَى خُمْرَةٍ تَحْتَهَا حَصِيرُ بَيْتِهِ فِي غَيْرِ مَسْجِدٍ فَيَسْجُدُ عَلَيْهَا ، وَيَقُوَمُ عَلَيْهَا \" /27 * \r\n\u0019E253 \r\n$1484  1484 1479 /2 /141 عَنْ /94 مَعْمَرٍ L7633 /94 , قَالَ : /27 سَأَلْتُ /26 الزُّهْرِيَّ L7272 /26 ، عَنِ السُّجُودِ عَلَى الطَّنْفَسَةِ ؟ , قَالَ : لا بَأْسَ بِذَاكَ , كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 \" يُصَلِّي عَلَى الْخُمْرَةِ \" /27 * \r\n$1485  1485 1480 /2 /141 عَنْ /94 مَالِكٍ L6659 /94 ، عَنْ /26 إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ L952 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : /20 \" صَلَّى عَلَى حَصِيرٍ \" /27 * \r\n$1486  1486 1481 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 تَوْبَةَ /26 ، عَنْ /26 عِكْرِمَةَ بْنِ خَالِدٍ /26 ،    @ 1 : 395 @   عَنْ /26 عَبْدِ اللَّهِ بْنِ عَامِرٍ /26 , قَالَ : /27 رَأَيْتُ /93 عُمَرَ بْنَ الْخَطَّابِ L5913 /93 /20 \" يُصَلِّي عَلَى عَبْقَرِيٍّ \" /27 ، قُلْتُ : مَا الْعَبْقَرِيُّ ؟ , قَالَ : \" لا أَدْرِي \" * \r\n$1487  1487 1482 /3 /141 عَنْ /94 مَعْمَرٍ /94 ، عَنْ /26 يَزِيدَ بْنِ أَبِي زِيَادٍ /26 ، عَنْ /26 مِقْسَمٍ /26 , قَالَ : /27 /20 \" صَلَّى /93 ابْنُ عَبَّاسٍ L4883 /93 عَلَى طَنْفَسَةٍ أَوْ بِسَاطٍ قَدْ طَبَّقَ بَيْتَهُ \" /27 , عَنِ /94 ابْنِ عُيَيْنَةَ /94 ، عَنِ /26 الأَعْمَشِ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 , مِثْلَهُ , عَنْ /94 أَبِيهِ /94 ، عَنْ /26 خَلادِ بْنِ عَبْدِ الرَّحْمَنِ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 , مِثْلَهُ * \r\n$1488  1488 1483 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 حَمَّادٍ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ,    @ 1 : 396 @   قَالَ : /27 /20 \" صَلَّى /93 ابْنُ عَبَّاسٍ L4883 /93 عَلَى طَنْفَسَةٍ طَبَّقَ الْبَيْتَ \" /27 * \r\n$1489  1489 1484 /3 /141 أَخْبَرَنِي /94 أَبِي /94 ، عَنْ /26 خَلادِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ جُنْدَةَ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، /27 أَنَّ /93 ابْنَ عَبَّاسٍ L4883 /93 /20 \" أَمَّهُمْ فِي ثَوْبٍ وَاحِدٍ , مُخَالِفًا بَيْنَ طَرَفَيْهِ عَلَى طَنْفَسَةٍ قَدْ طَبَّقَتِ الْبَيْتَ \" /27 * \r\n$1490  1490 1485 /8",
      "sanad_ar": "عَنِ /94 ابْنِ عُيَيْنَةَ /94 , قَالَ",
      "matn_ar": "/27 قُلْتُ /26 لِعَطَاءٍ /26 : /20 \" أَرَأَيْتَ إِنْسَانًا يُصَلِّي ، وَعَلَيْهِ طَاقٌ فِي بَرْدٍ فَجَعَلَ يَسْجُدُ عَلَى طَاقِهِ ، وَلا يُخْرِجُ يَدَيْهِ , قَالَ : \" لا يَضُرُّهُ \" ، قُلْتُ : فَلِغَيْرِ بَرْدٍ , قَالَ : \" أَحَبُّ إِلَيَّ أَنْ يُسَوِّيَ بَيْنَهُمَا ، وَبَيْنَ الأَرْضِ , فَإِنْ لَمْ يَفْعَلْ فَلا حَرَجَ \" ، قُلْتُ : أَحَبُّ إِلَيْكَ أَنْ لا يُصَلِّيَ عَلَى شَيْءٍ إِلا عَلَى الأَرْضِ , وَيَدَعُ ذَلِكَ كُلَّهُ ؟ , قَالَ : \" نَعَمْ \" /27 * \r\n$1483  1483 1478 /3 /141 عَنِ /94 ابْنِ جُرَيْجٍ /94 , قَالَ : أَخْبَرَنِي /26 نَافِعٌ /26 ، /27 أَنَّ /93 ابْنَ عُمَرَ L4967 /93 \" كَانَ /20 يُصَلِّي عَلَى خُمْرَةٍ تَحْتَهَا حَصِيرُ بَيْتِهِ فِي غَيْرِ مَسْجِدٍ فَيَسْجُدُ عَلَيْهَا ، وَيَقُوَمُ عَلَيْهَا \" /27 * \r\n\u0019E253 \r\n$1484  1484 1479 /2 /141 عَنْ /94 مَعْمَرٍ L7633 /94 , قَالَ : /27 سَأَلْتُ /26 الزُّهْرِيَّ L7272 /26 ، عَنِ السُّجُودِ عَلَى الطَّنْفَسَةِ ؟ , قَالَ : لا بَأْسَ بِذَاكَ , كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 \" يُصَلِّي عَلَى الْخُمْرَةِ \" /27 * \r\n$1485  1485 1480 /2 /141 عَنْ /94 مَالِكٍ L6659 /94 ، عَنْ /26 إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ L952 /26 ، /27 عَنْ /93 أَنَسٍ L720 /93 ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : /20 \" صَلَّى عَلَى حَصِيرٍ \" /27 * \r\n$1486  1486 1481 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 تَوْبَةَ /26 ، عَنْ /26 عِكْرِمَةَ بْنِ خَالِدٍ /26 ،    @ 1 : 395 @   عَنْ /26 عَبْدِ اللَّهِ بْنِ عَامِرٍ /26 , قَالَ : /27 رَأَيْتُ /93 عُمَرَ بْنَ الْخَطَّابِ L5913 /93 /20 \" يُصَلِّي عَلَى عَبْقَرِيٍّ \" /27 ، قُلْتُ : مَا الْعَبْقَرِيُّ ؟ , قَالَ : \" لا أَدْرِي \" * \r\n$1487  1487 1482 /3 /141 عَنْ /94 مَعْمَرٍ /94 ، عَنْ /26 يَزِيدَ بْنِ أَبِي زِيَادٍ /26 ، عَنْ /26 مِقْسَمٍ /26 , قَالَ : /27 /20 \" صَلَّى /93 ابْنُ عَبَّاسٍ L4883 /93 عَلَى طَنْفَسَةٍ أَوْ بِسَاطٍ قَدْ طَبَّقَ بَيْتَهُ \" /27 , عَنِ /94 ابْنِ عُيَيْنَةَ /94 ، عَنِ /26 الأَعْمَشِ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، عَنِ /93 ابْنِ عَبَّاسٍ L4883 /9