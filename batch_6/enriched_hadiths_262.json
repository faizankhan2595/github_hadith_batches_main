      "hadith_id": 48920,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 1407,
      "text_ar": "عَنْ /94 مَعْمَرٍ /94 ، عَنْ /26 قَتَادَةَ /26 ، /27 عَنِ /26 الْحَسَنِ /26 , قَالَ : /20 \" لا بَأْسَ أَنْ يُصَلَّى عَلَى الطَّنْفَسَةِ وَالْخُمْرَةِ \" /27 * \r\n\u001aE254 \r\n$1491  1491 1486 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ دِينَارٍ /26 , قَالَ : /27 كَانَ /93 ابْنُ عُمَرَ L4967 /93 /20 \" يَغْسِلُ قَدَمَيْهِ الْحَائِضُ ، وَكَانَ يُصَلِّي عَلَى الْخُمْرَةِ \" /27 , عَنْ /94 مَالِكٍ /94 ، عَنْ /26 نَافِعٍ /26 ، عَنِ /93 ابْنِ عُمَرَ L4967 /93 , مِثْلَهُ * \r\n$1492  1492 1487 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 أَبِي وَائِلٍ /26 ، /27 أَنَّ /93 ابْنَ مَسْعُودٍ L5079 /93 /20 \" صَلَّى عَلَى مِسْحٍ \" /27 * \r\n$1493  1493 1488 /8 /141 عَنْ /94 مَعْمَرٍ /94 ، /27 عَنِ /26 ابْنِ طَاوُسٍ /26 , قَالَ : رَأَيْتُ /26 أَبِي /26 /20 \" بُسِطَ لَهُ بِسَاطٌ فَصَلَّى عَلَيْهِ ، فَظَننتُ أَنَّ ذَلِكَ لِقَذَرِ الْمَكَانِ \" /27 * \r\n$1494  1494 1489 /2 /141 عَنْ /94 مُحَمَّدِ بْنِ رَاشِدٍ L6961 /94 ، /27 عَنْ /26 جَعْفَرِ بْنِ عُمَرَ L13760 /26 ، أَوْ /26 غَيْرِهِ L1131 /26 , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : /20 \" كَانَ فِي بَيْتٍ ، وَكَفَّ عَلَيْهِ فَاجْتَذَبَ    @ 1 : 397 @   نَطْعًا فَصَلَّى عَلَيْهِ \" /27 * \r\n$1495  1495 1490 /3 /141 عَنْ /94 مُحَمَّدِ بْنِ رَاشِدٍ /94 ، عَنْ /18 /26 عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ /26 /18 , قَالَ : بَلَغَنِي /27 أَنَّ /93 أَبَا بَكْرٍ الصِّدِّيقَ L4945 /93 ، كَانَ /20 \" يَسْجُدُ ، أَوْ يُصَلِّي عَلَى الأَرْضِ مُفْضِيًا إِلَيْهَا \" /27 * \r\n$1496  1496 1491 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 عَبْدِ الْكَرِيمِ الْجَزَرِيِّ /26 ، عَنْ /26 أَبِي عُبَيْدَةَ /26 ، قَالَ : /27 كَانَ /93 ابْنُ مَسْعُودٍ L5079 /93 \" /20 لا يَسْجُدُ أَوْ قَالَ : لا يُصَلِّي إِلا عَلَى الأَرْضِ \" /27 * \r\n$1497  1497 1492 /8 /141 قَالَ /94 الثَّوْرِيُّ /94 وَأَخْبَرَنِي /26 مُحِلٌّ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 ، أَنَّهُ كَانَ /20 \" يَقُوَمُ عَلَى الْبَرْدِيِّ ، وَيَسْجُدُ عَلَى الأَرْضِ \" /27 , قُلْنَا : مَا الْبَرْدِيُّ ؟ , قَالَ : \" الْحَصِيرُ ؟ \" * \r\n$1498  1498 1493 /2 /141 عَنِ /94 ابْنِ عُيَيْنَةَ L3443 /94 ، عَنْ /26 مَالِكِ بْنِ مِغْوَلٍ L6693 /26 , /18 /26 عَمَّنْ L1131 /26 /18 ، سَمِعَ /26 ابْنَ شُرَيْحِ بْنِ هَانِئٍ L1685 /26 ، عَنْ /26 أَبِيهِ L3787 /26 يُحَدِّثُ ، /27 عَنْ /93 عَائِشَةَ L4049 /93 , قَالَتْ : مَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 مُتَّقِيًا وَجْهَهُ بِشَيْءٍ /27 , تَعْنِي فِي السُّجُودِ * \r\n@ 1 : 398 @\u001aE255",
      "sanad_ar": "عَنْ /94 مَعْمَرٍ /94",
      "matn_ar": "عَنْ /26 قَتَادَةَ /26 ، /27 عَنِ /26 الْحَسَنِ /26 , قَالَ : /20 \" لا بَأْسَ أَنْ يُصَلَّى عَلَى الطَّنْفَسَةِ وَالْخُمْرَةِ \" /27 * \r\n\u001aE254 \r\n$1491  1491 1486 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ دِينَارٍ /26 , قَالَ : /27 كَانَ /93 ابْنُ عُمَرَ L4967 /93 /20 \" يَغْسِلُ قَدَمَيْهِ الْحَائِضُ ، وَكَانَ يُصَلِّي عَلَى الْخُمْرَةِ \" /27 , عَنْ /94 مَالِكٍ /94 ، عَنْ /26 نَافِعٍ /26 ، عَنِ /93 ابْنِ عُمَرَ L4967 /93 , مِثْلَهُ * \r\n$1492  1492 1487 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 أَبِي وَائِلٍ /26 ، /27 أَنَّ /93 ابْنَ مَسْعُودٍ L5079 /93 /20 \" صَلَّى عَلَى مِسْحٍ \" /27 * \r\n$1493  1493 1488 /8 /141 عَنْ /94 مَعْمَرٍ /94 ، /27 عَنِ /26 ابْنِ طَاوُسٍ /26 , قَالَ : رَأَيْتُ /26 أَبِي /26 /20 \" بُسِطَ لَهُ بِسَاطٌ فَصَلَّى عَلَيْهِ ، فَظَننتُ أَنَّ ذَلِكَ لِقَذَرِ الْمَكَانِ \" /27 * \r\n$1494  1494 1489 /2 /141 عَنْ /94 مُحَمَّدِ بْنِ رَاشِدٍ L6961 /94 ، /27 عَنْ /26 جَعْفَرِ بْنِ عُمَرَ L13760 /26 ، أَوْ /26 غَيْرِهِ L1131 /26 , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : /20 \" كَانَ فِي بَيْتٍ ، وَكَفَّ عَلَيْهِ فَاجْتَذَبَ    @ 1 : 397 @   نَطْعًا فَصَلَّى عَلَيْهِ \" /27 * \r\n$1495  1495 1490 /3 /141 عَنْ /94 مُحَمَّدِ بْنِ رَاشِدٍ /94 ، عَنْ /18 /26 عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ /26 /18 , قَالَ : بَلَغَنِي /27 أَنَّ /93 أَبَا بَكْرٍ الصِّدِّيقَ L4945 /93 ، كَانَ /20 \" يَسْجُدُ ، أَوْ يُصَلِّي عَلَى الأَرْضِ مُفْضِيًا إِلَيْهَا \" /27 * \r\n$1496  1496 1491 /3 /141 عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 عَبْدِ الْكَرِيمِ الْجَزَرِيِّ /26 ، عَنْ /26 أَبِي عُبَيْدَةَ /26 ، قَالَ : /27 كَانَ /93 ابْنُ مَسْعُودٍ L5079 /93 \" /20 لا يَسْجُدُ أَوْ قَالَ : لا يُصَلِّي إِلا عَلَى الأَرْضِ \" /27 * \r\n$1497  1497 1492 /8 /141 قَالَ /94 الثَّوْرِيُّ /94 وَأَخْبَرَنِي /26 مُحِلٌّ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 ، أَنَّهُ كَانَ /20 \" يَقُوَمُ عَلَى الْبَرْدِيِّ ، وَيَسْجُدُ عَلَى الأَرْضِ \" /27 , قُلْنَا : مَا الْبَرْدِيُّ ؟ , قَالَ : \" الْحَصِيرُ ؟ \" * \r\n$1498  1498 1493 /2 /141 عَنِ /94 ابْنِ عُيَيْنَةَ L3443 /94 ، عَنْ /26 مَالِكِ بْنِ مِغْوَلٍ L6693 /26 , /18 /26 عَمَّنْ L1131 /26 /18 ، سَمِعَ /26 ابْنَ شُرَيْحِ بْنِ هَانِئٍ L1685 /26 ، عَنْ /26 أَبِيهِ L3787 /26 يُحَدِّثُ ، /27 عَنْ /93 عَائِشَةَ L4049 /93 , قَالَتْ : مَا رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 مُتَّقِيًا وَجْهَهُ بِشَيْءٍ /27 , تَعْنِي فِي السُّجُودِ * \r\n@ 1 : 398 @\u001aE255",
