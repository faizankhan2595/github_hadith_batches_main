    {
      "hadith_id": 358493,
      "book_id": 338,
      "chapter_id": null,
      "hadith_number": 25820,
      "text_ar": "حُدِّثْتُ عَنِ /26 الْحُسَيْنِ بْنِ الْفَرَجِ /26 ، قَالَ : سَمِعْتُ /26 أَبَا مُعَاذٍ /26 ، قَالَ : ثَنَا /26 عُبَيْدُ بْنُ سُلَيْمَانَ /26 ، قَالَ : /27 سَمِعْتُ /26 الضَّحَّاكَ /26 , يَقُولُ فِي قَوْلِهِ : /20 /4 أَضْغَاثُ أَحْلامٍ سورة يوسف آية 44 /4 : هِيَ الأَحْلامُ الْكَاذِبَةُ \" /27 * \r\nوقولُه : /4 وَمَا نَحْنُ بِتَأْوِيلِ الأَحْلامِ بِعَالِمِينَ سورة يوسف آية 44 /4 . يَقُولُ : وما نَحْنُ بما تَئُولُ إِلَيْهِ    @ 13 : 181 @   الأحلامُ الكاذبةُ بعالِمين ، والباءُ الأولى التي فِي التأويلِ مِن صلةِ العالمين ، والتي فِي العالمين الباءُ التي تَدْخُلُ فِي الخبرِ مَعَ ما التي بمعنى الجَحْدِ . ورُفعَ /4 أَضْغَاثُ أَحْلَامٍ /4 ؛ لأن معنى الكلام : ليس هذه الرؤيا بشيء ، إنما هي أضغاث أحلام .\u001dE5640",
      "sanad_ar": "حُدِّثْتُ عَنِ /26 الْحُسَيْنِ بْنِ الْفَرَجِ /26",
      "matn_ar": "قَالَ : سَمِعْتُ /26 أَبَا مُعَاذٍ /26 ، قَالَ : ثَنَا /26 عُبَيْدُ بْنُ سُلَيْمَانَ /26 ، قَالَ : /27 سَمِعْتُ /26 الضَّحَّاكَ /26 , يَقُولُ فِي قَوْلِهِ : /20 /4 أَضْغَاثُ أَحْلامٍ سورة يوسف آية 44 /4 : هِيَ الأَحْلامُ الْكَاذِبَةُ \" /27 * \r\nوقولُه : /4 وَمَا نَحْنُ بِتَأْوِيلِ الأَحْلامِ بِعَالِمِينَ سورة يوسف آية 44 /4 . يَقُولُ : وما نَحْنُ بما تَئُولُ إِلَيْهِ    @ 13 : 181 @   الأحلامُ الكاذبةُ بعالِمين ، والباءُ الأولى التي فِي التأويلِ مِن صلةِ العالمين ، والتي فِي العالمين الباءُ التي تَدْخُلُ فِي الخبرِ مَعَ ما التي بمعنى الجَحْدِ . ورُفعَ /4 أَضْغَاثُ أَحْلَامٍ /4 ؛ لأن معنى الكلام : ليس هذه الرؤيا بشيء ، إنما هي أضغاث أحلام .\u001dE5640",
