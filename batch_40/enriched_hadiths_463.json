    {
      "hadith_id": 357944,
      "book_id": 338,
      "chapter_id": null,
      "hadith_number": 25271,
      "text_ar": "حَدَّثَنِي /94 مُحَمَّدُ بْنُ عَمْرٍو /94 ، قَالَ : ثَنَا /26 أَبُو عَاصِمٍ /26 ، قَالَ : ثَنَا /26 عِيسَى /26 ، عَنِ /26 ابْنِ أَبِي نَجِيحٍ /26 ، /27 عَنْ /26 مُجَاهِدٍ /26 : \" /20 /90 نَرْتَعِ /90 ، قَالَ : يَحْفَظُ بَعْضُنَا بَعْضًا ، نَتَكَالأُ \" /27 حَدَّثَنِي /94 الْمُثَنَّى /94 ، قَالَ : ثَنَا /26 أَبُو حُذَيْفَةَ /26 ، قَالَ : ثَنَا /26 شِبْلٌ /26 ، عَنِ /26 ابْنِ أَبِي نَجِيحٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 . وحَدَّثَنِي /26 الْمُثَنَّى /26 ، قَالَ : ثَنَا /26 إِسْحَاقُ /26 ، قَالَ : ثَنَا /26 عَبْدُ اللَّهِ بْنُ أَبِي جَعْفَرٍ /26 ، عَنْ /26 وَرْقَاءَ /26 ، عَنِ /26 ابْنِ أَبِي نَجِيحٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، بِنَحْوِهِ . حَدَّثَنَا /94 الْقَاسِمُ /94 ، قَالَ : ثَنَا /26 الْحُسَيْنُ /26 ، قَالَ : ثني /26 حَجَّاجٌ /26 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، بِنَحْوِهِ . فَتَأْوِيلُ الْكَلامِ : أَرْسِلْهُ مَعَنَا غَدًا نَلْهُو ، وَنَلْعَبُ ، وَنَنْعَمُ ، وَنَنْشَطُ فِي    @ 13 : 29 @   الصَّحْرَاءِ ، وَنَحْنُ حَافِظُوهُ مِنْ أَنْ يَنَالَهُ شَيْءٌ يَكْرَهُهُ أَوْ يُؤْذِيه \" * \r\n:E5539",
      "sanad_ar": "حَدَّثَنِي /94 مُحَمَّدُ بْنُ عَمْرٍو /94",
      "matn_ar": "قَالَ : ثَنَا /26 أَبُو عَاصِمٍ /26 ، قَالَ : ثَنَا /26 عِيسَى /26 ، عَنِ /26 ابْنِ أَبِي نَجِيحٍ /26 ، /27 عَنْ /26 مُجَاهِدٍ /26 : \" /20 /90 نَرْتَعِ /90 ، قَالَ : يَحْفَظُ بَعْضُنَا بَعْضًا ، نَتَكَالأُ \" /27 حَدَّثَنِي /94 الْمُثَنَّى /94 ، قَالَ : ثَنَا /26 أَبُو حُذَيْفَةَ /26 ، قَالَ : ثَنَا /26 شِبْلٌ /26 ، عَنِ /26 ابْنِ أَبِي نَجِيحٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 . وحَدَّثَنِي /26 الْمُثَنَّى /26 ، قَالَ : ثَنَا /26 إِسْحَاقُ /26 ، قَالَ : ثَنَا /26 عَبْدُ اللَّهِ بْنُ أَبِي جَعْفَرٍ /26 ، عَنْ /26 وَرْقَاءَ /26 ، عَنِ /26 ابْنِ أَبِي نَجِيحٍ /26 ، عَنْ /26 مُجَاهِدٍ /26 ، بِنَحْوِهِ . حَدَّثَنَا /94 الْقَاسِمُ /94 ، قَالَ : ثَنَا /26 الْحُسَيْنُ /26 ، قَالَ : ثني /26 حَجَّاجٌ /26 ، عَنِ /26 ابْنِ جُرَيْجٍ /26 ، بِنَحْوِهِ . فَتَأْوِيلُ الْكَلامِ : أَرْسِلْهُ مَعَنَا غَدًا نَلْهُو ، وَنَلْعَبُ ، وَنَنْعَمُ ، وَنَنْشَطُ فِي    @ 13 : 29 @   الصَّحْرَاءِ ، وَنَحْنُ حَافِظُوهُ مِنْ أَنْ يَنَالَهُ شَيْءٌ يَكْرَهُهُ أَوْ يُؤْذِيه \" * \r\n:E5539",
