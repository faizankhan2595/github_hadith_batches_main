      "chapter_id": null,
      "hadith_number": 23234,
      "text_ar": "حَدَّثَنِي /94 الْمُثَنَّى /94 ، قَالَ : ثَنَا /26 الْحِمَّانِيُّ /26 ، قَالَ : ثَنَا /26 شَرِيكٌ /26 ، عَنْ /26 أَشْعَثَ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، قَالَ : \" /27 /20 /4 السَّائِحُونَ سورة التوبة آية 112 /4 : الصَّائِمُونَ \" /27 . حَدَّثَنَا /94 أَحْمَدُ بْنُ إِسْحَاقَ /94 ، قَالَ : ثَنَا /26 أَبُو أَحْمَدَ /26 ، قال : ثنا /26 إسرائيل /26 ، عَنْ /26 أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 مِثْلَهُ . حَدَّثَنَا /94 ابْنُ وَكِيعٍ /94 ، قَالَ : ثَنَا /26 أَبِي /26 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 عاصم /26 , عَنْ /26 زِرٍّ /26 ، عَنْ /93 عَبْدِ اللَّهِ L5079 /93 ، مِثْلَهُ * \r\n$15977  15991 /3",
      "sanad_ar": "حَدَّثَنِي /94 الْمُثَنَّى /94",
      "matn_ar": "قَالَ : ثَنَا /26 الْحِمَّانِيُّ /26 ، قَالَ : ثَنَا /26 شَرِيكٌ /26 ، عَنْ /26 أَشْعَثَ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، قَالَ : \" /27 /20 /4 السَّائِحُونَ سورة التوبة آية 112 /4 : الصَّائِمُونَ \" /27 . حَدَّثَنَا /94 أَحْمَدُ بْنُ إِسْحَاقَ /94 ، قَالَ : ثَنَا /26 أَبُو أَحْمَدَ /26 ، قال : ثنا /26 إسرائيل /26 ، عَنْ /26 أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 مِثْلَهُ . حَدَّثَنَا /94 ابْنُ وَكِيعٍ /94 ، قَالَ : ثَنَا /26 أَبِي /26 ، عَنْ /26 سُفْيَانَ /26 ، عَنْ /26 عاصم /26 , عَنْ /26 زِرٍّ /26 ، عَنْ /93 عَبْدِ اللَّهِ L5079 /93 ، مِثْلَهُ * \r\n$15977  15991 /3",
