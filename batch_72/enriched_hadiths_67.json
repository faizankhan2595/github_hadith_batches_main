      "chapter_id": null,
      "hadith_number": 232,
      "text_ar": "ثقة ، مُتَّفَق عَلَيْهِ ، أخرجه الْبُخَارِيّ في صحيحه . وأخطأ مكي بالري \r\n$24  /2 /141 فِي حَدِيثٍ حَدَّثَنِيهِ /94 الْقَاسِمُ بْنُ عَلْقَمَةَ L46149 /94 ، حَدَّثَنَا /26 ابْنُ أَبِي حَاتِمٍ L20916 /26 ، حَدَّثَنَا /26 مُحَمَّدُ بْنُ عَمَّارِ بْنِ الْحَارِثِ L30208 /26 ، حَدَّثَنَا /26 مَكِّيُّ L7660 /26 . ح وَحَدَّثَنِي /94 عَبْدُ الصَّمَدِ بْنُ أَحْمَدَ بْنِ خَنْبَشٍ الْخَوْلانِيُّ الْحِمْصِيُّ L21199 /94 ، حَدَّثَنَا /26 أَحْمَدُ بْنُ زَكَرِيَّا الْمَقْدِسِيُّ L9842 /26 ، حَدَّثَنَا /26 مُحَمَّدُ بْنُ حَمَّادٍ الطِّهْرَانِيُّ L6925 /26 ،   @ 1 : 48 @    حَدَّثَنَا /26 مَكِّيُّ بْنُ إِبْرَاهِيمَ L7660 /26 ، عَنْ /26 نَافِعٍ L7863 /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" /20 صَلَّى عَلَى النَّجَاشِيِّ ، فَكَبَّرَ عَلَيْهِ أَرْبَعًا \" /27 وَهَذَا أَخْطَأَ فِيهِ مَكِّيٌّ مِنْ حِفْظِهِ بِالرِّيِّ ، قَالَهُ أَبُو زُرْعَةَ الرَّازِيُّ ، وَصَوَابُهُ : مَالِكٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ *",
      "sanad_ar": "ثقة",
      "matn_ar": "مُتَّفَق عَلَيْهِ ، أخرجه الْبُخَارِيّ في صحيحه . وأخطأ مكي بالري \r\n$24  /2 /141 فِي حَدِيثٍ حَدَّثَنِيهِ /94 الْقَاسِمُ بْنُ عَلْقَمَةَ L46149 /94 ، حَدَّثَنَا /26 ابْنُ أَبِي حَاتِمٍ L20916 /26 ، حَدَّثَنَا /26 مُحَمَّدُ بْنُ عَمَّارِ بْنِ الْحَارِثِ L30208 /26 ، حَدَّثَنَا /26 مَكِّيُّ L7660 /26 . ح وَحَدَّثَنِي /94 عَبْدُ الصَّمَدِ بْنُ أَحْمَدَ بْنِ خَنْبَشٍ الْخَوْلانِيُّ الْحِمْصِيُّ L21199 /94 ، حَدَّثَنَا /26 أَحْمَدُ بْنُ زَكَرِيَّا الْمَقْدِسِيُّ L9842 /26 ، حَدَّثَنَا /26 مُحَمَّدُ بْنُ حَمَّادٍ الطِّهْرَانِيُّ L6925 /26 ،   @ 1 : 48 @    حَدَّثَنَا /26 مَكِّيُّ بْنُ إِبْرَاهِيمَ L7660 /26 ، عَنْ /26 نَافِعٍ L7863 /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" /20 صَلَّى عَلَى النَّجَاشِيِّ ، فَكَبَّرَ عَلَيْهِ أَرْبَعًا \" /27 وَهَذَا أَخْطَأَ فِيهِ مَكِّيٌّ مِنْ حِفْظِهِ بِالرِّيِّ ، قَالَهُ أَبُو زُرْعَةَ الرَّازِيُّ ، وَصَوَابُهُ : مَالِكٌ ، عَنِ الزُّهْرِيِّ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ *",
