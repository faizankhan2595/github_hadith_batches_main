    {
      "hadith_id": 936861,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 3806,
      "text_ar": "أخبرنا  /94  أبو جعفر L78451  /94  ، بإسناده عن  /26  يونس بن بكير L8606  /26  ، عن  /26  هشام بن سعد L8047  /26  ، عن  /26  زيد بن أسلم L3122  /26  ، عن  /93  رجل L1131  /93  حدثه ، قال : /27 مررت برسول الله صلى الله عليه وسلم ، وهو جالس على قبر وهو يدفن ، فسمعته يقول : /20 \" اللهم إني قد رضيت عنه فارض عنه \" /27 . فسألت : من هو ؟ فقيل : عبد الله ذو البجادين  * \r\n3362 وقد روى يونس ، عن ابن إسحاق ، عن محمد بن إبراهيم ، عن عبد الله بن مسعود وذكر موت ذي البجادين وقال في آخره : وقال رسول الله صلى الله عليه وسلم : \" اللهم إني أمسيت عنه راضيا فارض عنه \" . وقال ابن مسعود : فليتني كنت صاحب الحفرة . أخرجه ابن منده . @ 14726\u001cE2063",
      "sanad_ar": "أخبرنا  /94  أبو جعفر L78451  /94",
      "matn_ar": "بإسناده عن  /26  يونس بن بكير L8606  /26  ، عن  /26  هشام بن سعد L8047  /26  ، عن  /26  زيد بن أسلم L3122  /26  ، عن  /93  رجل L1131  /93  حدثه ، قال : /27 مررت برسول الله صلى الله عليه وسلم ، وهو جالس على قبر وهو يدفن ، فسمعته يقول : /20 \" اللهم إني قد رضيت عنه فارض عنه \" /27 . فسألت : من هو ؟ فقيل : عبد الله ذو البجادين  * \r\n3362 وقد روى يونس ، عن ابن إسحاق ، عن محمد بن إبراهيم ، عن عبد الله بن مسعود وذكر موت ذي البجادين وقال في آخره : وقال رسول الله صلى الله عليه وسلم : \" اللهم إني أمسيت عنه راضيا فارض عنه \" . وقال ابن مسعود : فليتني كنت صاحب الحفرة . أخرجه ابن منده . @ 14726\u001cE2063",
      "grade": null,
