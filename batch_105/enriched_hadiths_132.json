    {
      "hadith_id": 937980,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 4925,
      "text_ar": "أخبرنا  /94  يحيى بن محمود L46109  /94  ، إجازة ، بإسناده عن  /26  ابن أبي عاصم L10084  /26  ، حدثنا  /26  دحيم L4293  /26  ، حدثنا  /26  ابن أبي فديك L6822  /26  ، عن  /26  موسى بن يعقوب L7782  /26  ، عن  /26  عطاء بن مسعود الكعبي L23538  /26  ، /27 عن عمته  /93  عزة بنت خايل L50305  /93  ، أخبرته \" أنها خرجت حتى قدمت على رسول الله صلى الله عليه وسلم /20 فبايعها على أن لا تزنين ، ولا تسرقين ، ولا تؤذين فتبدين أو تخفين /27 ، قالت عزة : فأما الإيذاء فقد كانت عرفته وعلمته ، وهو قتل الولد ، وأما المخفى فلم أسأل عنه رسول الله صلى الله عليه وسلم ولم يخبرني به ، وقد وقع في نفسي أنه إفساد الولد ، فوالله لا أفسد لي ولدا أبدا ، فلم تفسد لها ولدا حتى ماتت \" . يعني : الغيل . أخرجه الثلاثة ، إلا أن أبا عمر قال : عزة بنت كامل بالكاف ، وقد ذكره مسلم : خابل بالخاء ، كما ذكره ابن منده ، وأبو نعيم ، وهو الصواب  * \r\n@ 15189\u001fE2193",
      "sanad_ar": "أخبرنا  /94  يحيى بن محمود L46109  /94",
      "matn_ar": "إجازة ، بإسناده عن  /26  ابن أبي عاصم L10084  /26  ، حدثنا  /26  دحيم L4293  /26  ، حدثنا  /26  ابن أبي فديك L6822  /26  ، عن  /26  موسى بن يعقوب L7782  /26  ، عن  /26  عطاء بن مسعود الكعبي L23538  /26  ، /27 عن عمته  /93  عزة بنت خايل L50305  /93  ، أخبرته \" أنها خرجت حتى قدمت على رسول الله صلى الله عليه وسلم /20 فبايعها على أن لا تزنين ، ولا تسرقين ، ولا تؤذين فتبدين أو تخفين /27 ، قالت عزة : فأما الإيذاء فقد كانت عرفته وعلمته ، وهو قتل الولد ، وأما المخفى فلم أسأل عنه رسول الله صلى الله عليه وسلم ولم يخبرني به ، وقد وقع في نفسي أنه إفساد الولد ، فوالله لا أفسد لي ولدا أبدا ، فلم تفسد لها ولدا حتى ماتت \" . يعني : الغيل . أخرجه الثلاثة ، إلا أن أبا عمر قال : عزة بنت كامل بالكاف ، وقد ذكره مسلم : خابل بالخاء ، كما ذكره ابن منده ، وأبو نعيم ، وهو الصواب  * \r\n@ 15189\u001fE2193",
      "grade": null,
