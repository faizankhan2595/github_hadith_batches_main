    {
      "hadith_id": 936209,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 3154,
      "text_ar": "أخبرنا  /94  عبد الوهاب بن أبي منصور الصوفي L75605  /94  ، بإسناده عن  /26  أبي داود L3567  /26  : حدثنا  /26  محمد بن عيسى L30371  /26  ، أخبرنا  /26  حارث بن مرة L1218  /26  ، /27 حدثنا  /26  كليب بن منفعة L6615  /26  ، عن  /93  جده L2102  /93  ، أنه قال : يا رسول الله /20 من أبر ؟ قال : \" أمك وأباك ، وأختك وأخاك ، ومولاك الذي يلي ذاك ، حق واجب ورحم موصولة \" /27 . أخرجه الثلاثة ، وأخرجه أبو موسى إلا أن ابن منده اختصره فقال : أبو منفعة الحنفي ، أتى النبي صلى الله عليه وسلم ، روى عنه ابنه كليب فجعله حنفيا ، ولهذا السبب استدركه أبو موسى عليه ، فإن أبا نعيم وأبا موسى جعلاه ثقفيا ، وهما واحد  * \r\n@ 14453",
      "sanad_ar": "أخبرنا  /94  عبد الوهاب بن أبي منصور الصوفي L75605  /94",
      "matn_ar": "بإسناده عن  /26  أبي داود L3567  /26  : حدثنا  /26  محمد بن عيسى L30371  /26  ، أخبرنا  /26  حارث بن مرة L1218  /26  ، /27 حدثنا  /26  كليب بن منفعة L6615  /26  ، عن  /93  جده L2102  /93  ، أنه قال : يا رسول الله /20 من أبر ؟ قال : \" أمك وأباك ، وأختك وأخاك ، ومولاك الذي يلي ذاك ، حق واجب ورحم موصولة \" /27 . أخرجه الثلاثة ، وأخرجه أبو موسى إلا أن ابن منده اختصره فقال : أبو منفعة الحنفي ، أتى النبي صلى الله عليه وسلم ، روى عنه ابنه كليب فجعله حنفيا ، ولهذا السبب استدركه أبو موسى عليه ، فإن أبا نعيم وأبا موسى جعلاه ثقفيا ، وهما واحد  * \r\n@ 14453",
      "grade": null,
