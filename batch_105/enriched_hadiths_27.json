    {
      "hadith_id": 936394,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 3339,
      "text_ar": "أخبرنا  /94  يحيى بن محمود L46109  /94  ، إجازة بإسناده عن  /26  ابن أبي عاصم L10084  /26  ، قال : حدثنا  /26  أبو بكر بن أبي شيبة L5049  /26  ، أخبرنا  /26  محمد بن الحسن L6832  /26  ، أخبرنا  /26  خالد L2663  /26  ، عن  /26  بيان L1980  /26  ، عن  /26  قيس بن أبي حازم L6508  /26  ، قال : /27 حدثني  /93  ابن سيلان L8680  /93  ، أنه سمع رسول الله صلى الله عليه وسلم ورفع طرفه إلى السماء فقال : /20 \" سبحان الله ، ترسل عليكم الفتن إرسال القطر \" /27 . وروى عن قيس فقال : أخبرني من سمع النبي صلى الله عليه وسلم . وذكره . أخرجاه أيضا ، سيلان : بكسر السين ، وبالياء تحتها نقطتان  * \r\n@ 14517\u001dE2015",
      "sanad_ar": "أخبرنا  /94  يحيى بن محمود L46109  /94",
      "matn_ar": "إجازة بإسناده عن  /26  ابن أبي عاصم L10084  /26  ، قال : حدثنا  /26  أبو بكر بن أبي شيبة L5049  /26  ، أخبرنا  /26  محمد بن الحسن L6832  /26  ، أخبرنا  /26  خالد L2663  /26  ، عن  /26  بيان L1980  /26  ، عن  /26  قيس بن أبي حازم L6508  /26  ، قال : /27 حدثني  /93  ابن سيلان L8680  /93  ، أنه سمع رسول الله صلى الله عليه وسلم ورفع طرفه إلى السماء فقال : /20 \" سبحان الله ، ترسل عليكم الفتن إرسال القطر \" /27 . وروى عن قيس فقال : أخبرني من سمع النبي صلى الله عليه وسلم . وذكره . أخرجاه أيضا ، سيلان : بكسر السين ، وبالياء تحتها نقطتان  * \r\n@ 14517\u001dE2015",
