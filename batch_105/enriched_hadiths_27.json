    {
      "hadith_id": 936405,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 3350,
      "text_ar": "أخبرنا  /94  يحيى L46109  /94  ، إجازة ، بإسناده عن  /26  ابن أبي عاصم L10084  /26  ، حدثنا  /26  أبو بكر بن أبي شيبة L5049  /26  ، حدثنا  /26  الحسن بن موسى L1304  /26  ، أخبرنا  /26  شيبان L3840  /26  ، عن  /26  يحيى بن أبي كثير L8208  /26  ، عن  /26  محمد بن إبراهيم L6796  /26  ، عن  /26  أبي عبد الله L2681  /26  ، /27 أن  /93  ابن عائش الجهني L1107  /93  ، أخبره ، أن النبي صلى الله عليه وسلم ، قال : \" يا بن عائش ، ألا /20 أخبرك بأفضل ما تعوذ به المتعوذون ؟ \" قال : بلى يا رسول الله . قال : \" /4 قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ سورة الفلق آية 1 /4 و /4 قُلْ أَعُوذُ بِرَبِّ النَّاسِ سورة الناس آية 1 /4 \" /27 . أخرجه أبو موسى  * \r\nعائش : بالياء تحتها نقطتان ، وبالشين المعجمة . @ 14522",
      "sanad_ar": "أخبرنا  /94  يحيى L46109  /94",
      "matn_ar": "إجازة ، بإسناده عن  /26  ابن أبي عاصم L10084  /26  ، حدثنا  /26  أبو بكر بن أبي شيبة L5049  /26  ، حدثنا  /26  الحسن بن موسى L1304  /26  ، أخبرنا  /26  شيبان L3840  /26  ، عن  /26  يحيى بن أبي كثير L8208  /26  ، عن  /26  محمد بن إبراهيم L6796  /26  ، عن  /26  أبي عبد الله L2681  /26  ، /27 أن  /93  ابن عائش الجهني L1107  /93  ، أخبره ، أن النبي صلى الله عليه وسلم ، قال : \" يا بن عائش ، ألا /20 أخبرك بأفضل ما تعوذ به المتعوذون ؟ \" قال : بلى يا رسول الله . قال : \" /4 قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ سورة الفلق آية 1 /4 و /4 قُلْ أَعُوذُ بِرَبِّ النَّاسِ سورة الناس آية 1 /4 \" /27 . أخرجه أبو موسى  * \r\nعائش : بالياء تحتها نقطتان ، وبالشين المعجمة . @ 14522",
