    {
      "hadith_id": 937718,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 4663,
      "text_ar": "أخبرنا  /94  أبو الفضل بن أبي الحسن الفقيه L32125  /94  ، بإسناده إلى  /26  أبي يعلى الموصلي L10025  /26  ، حدثنا  /26  هارون بن إسحاق L7971  /26  ، حدثني  /26  محمد بن عبد الوهاب القناد L7145  /26  ، عن  /26  مسعر بن كدام L7433  /26  ، عن  /26  إسماعيل بن أبي خالد L989  /26  ، عن  /26  الشعبي L4099  /26  ، عن  /26  يحيى بن طلحة L8281  /26  ، عن أمه  /26  سعدى المرية L3270  /26  ، قالت : /27 مر  /26  عمر L5913  /26   /93  بطلحة L4018  /93  بعد وفاة النبي صلى الله عليه وسلم وهو مكتئب ، فقال : أساءتك امرأة ابن عمك ؟ قال : لا ، ولكني سمعت رسول الله صلى الله عليه وسلم يقول : \" /20 إني لأعلم كلمة لا يقولها عبد عند موته إلا كانت نورا في صحيفته ، وإن جسده وروحه ليجدان لها روحا عند الموت \" . قال عمر ، أنا أعلمها ، هي التي أراد عليها عمه ، ولو علم شيئا أنجى له منها لأمره ، يعني لا إله إلا الله /27 . أخرجه الثلاثة  * \r\n@ 15081",
      "sanad_ar": "أخبرنا  /94  أبو الفضل بن أبي الحسن الفقيه L32125  /94",
      "matn_ar": "بإسناده إلى  /26  أبي يعلى الموصلي L10025  /26  ، حدثنا  /26  هارون بن إسحاق L7971  /26  ، حدثني  /26  محمد بن عبد الوهاب القناد L7145  /26  ، عن  /26  مسعر بن كدام L7433  /26  ، عن  /26  إسماعيل بن أبي خالد L989  /26  ، عن  /26  الشعبي L4099  /26  ، عن  /26  يحيى بن طلحة L8281  /26  ، عن أمه  /26  سعدى المرية L3270  /26  ، قالت : /27 مر  /26  عمر L5913  /26   /93  بطلحة L4018  /93  بعد وفاة النبي صلى الله عليه وسلم وهو مكتئب ، فقال : أساءتك امرأة ابن عمك ؟ قال : لا ، ولكني سمعت رسول الله صلى الله عليه وسلم يقول : \" /20 إني لأعلم كلمة لا يقولها عبد عند موته إلا كانت نورا في صحيفته ، وإن جسده وروحه ليجدان لها روحا عند الموت \" . قال عمر ، أنا أعلمها ، هي التي أراد عليها عمه ، ولو علم شيئا أنجى له منها لأمره ، يعني لا إله إلا الله /27 . أخرجه الثلاثة  * \r\n@ 15081",
