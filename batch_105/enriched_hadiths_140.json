    {
      "hadith_id": 938100,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 5045,
      "text_ar": "أخبرنا  /94  أبو موسى L53979  /94  ، إجازة ، أخبرنا  /26  أبو غالب L48126  /26  ، أخبرنا  /26  أبو بكر L46623  /26  . ح قال أبو موسى : وأخبرنا  /94  الحسن L14761  /94  ، أخبرنا  /26  أبو نعيم L9927  /26  ، قالا : حدثنا  /26  سليمان بن أحمد L18570  /26  ، حدثنا  /26  محمد بن عبد الله الحضرمي L29740  /26  ، حدثنا  /26  معمر بن بكار السعدي L31925  /26  ، حدثنا  /26  عثمان بن عبد الرحمن L5529  /26  ، عن  /26  محمد بن المنكدر L6864  /26  ، /27 عن  /93  جابر بن عبد الله L2069  /93  ، قال : سمعت رسول الله صلى الله عليه وسلم يقول : \" /20 وهبت خالتي فاختة بنت عمرو غلاما ، وأمرتها أن لا تجعله جازرا ولا صائغا ولا حجاما \" /27 . أخرجه أبو نعيم ، وأبو موسى  * \r\n@ 15243",
      "sanad_ar": "أخبرنا  /94  أبو موسى L53979  /94",
      "matn_ar": "إجازة ، أخبرنا  /26  أبو غالب L48126  /26  ، أخبرنا  /26  أبو بكر L46623  /26  . ح قال أبو موسى : وأخبرنا  /94  الحسن L14761  /94  ، أخبرنا  /26  أبو نعيم L9927  /26  ، قالا : حدثنا  /26  سليمان بن أحمد L18570  /26  ، حدثنا  /26  محمد بن عبد الله الحضرمي L29740  /26  ، حدثنا  /26  معمر بن بكار السعدي L31925  /26  ، حدثنا  /26  عثمان بن عبد الرحمن L5529  /26  ، عن  /26  محمد بن المنكدر L6864  /26  ، /27 عن  /93  جابر بن عبد الله L2069  /93  ، قال : سمعت رسول الله صلى الله عليه وسلم يقول : \" /20 وهبت خالتي فاختة بنت عمرو غلاما ، وأمرتها أن لا تجعله جازرا ولا صائغا ولا حجاما \" /27 . أخرجه أبو نعيم ، وأبو موسى  * \r\n@ 15243",
