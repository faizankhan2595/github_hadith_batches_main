    {
      "hadith_id": 938438,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 5383,
      "text_ar": "أخت يعلى ابن أمية التميمي . لها صحبة ورواية عن النبي صلى الله عليه وسلم . روت عنها أم سعد بنت سعد بن الربيع ، أنها قالت : ولدت خديجة للنبي صلى الله عليه وسلم القاسم ، والطاهر ، وزينب ، ورقية ، وأم كلثوم ، وفاطمة ، صلى الله عليهم أجمعين . @ 15378",
      "sanad_ar": "أخت يعلى ابن أمية التميمي . لها صحبة ورواية عن النبي صلى الله عليه وسلم . روت عنها أم سعد بنت سعد بن الربيع",
      "matn_ar": "أنها قالت : ولدت خديجة للنبي صلى الله عليه وسلم القاسم ، والطاهر ، وزينب ، ورقية ، وأم كلثوم ، وفاطمة ، صلى الله عليهم أجمعين . @ 15378",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:49",
      "book": {
        "book_id": 1591,
        "book_name_ar": "كتاب رقم 1591",
