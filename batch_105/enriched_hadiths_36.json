    {
      "hadith_id": 936532,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 3477,
      "text_ar": "أخبرنا  /94  أبو جعفر L78451  /94  ، بإسناده عن  /26  يونس بن بكير L8606  /26  ، عن  /26  إبراهيم بن إسماعيل الأنصاري L794  /26  ، عن  /26  صالح بن كيسان L3891  /26  ، /27 عن  /26  عطاء بن مروان الأسلمي L5626  /26  ، عن  /26  أبيه L333  /26  ، عن  /93  جده L50230  /93  قال : خرجنا مع رسول الله صلى الله عليه وسلم إلي خيبر ، حتى إذا كنا قريبا منها وأشرفنا عليها ، قال رسول الله صلى الله عليه وسلم للناس : \" قفوا \" . فوقف الناس ، ثم قال : /20 \" اللهم رب السموات السبع وما أظللن ، ورب الأرضين والسبع وما أقللن ، ورب الشياطين وما أضللن إنا نسألك من خيرها وخير أهلها ، ونعوذ بك من شرها وشر أهلها ، ادخلوا بسم الله \" /27 . وقد تقدم ، أخرجه أبو موسى  * \r\n@ 14581'E2027",
      "sanad_ar": "أخبرنا  /94  أبو جعفر L78451  /94",
      "matn_ar": "بإسناده عن  /26  يونس بن بكير L8606  /26  ، عن  /26  إبراهيم بن إسماعيل الأنصاري L794  /26  ، عن  /26  صالح بن كيسان L3891  /26  ، /27 عن  /26  عطاء بن مروان الأسلمي L5626  /26  ، عن  /26  أبيه L333  /26  ، عن  /93  جده L50230  /93  قال : خرجنا مع رسول الله صلى الله عليه وسلم إلي خيبر ، حتى إذا كنا قريبا منها وأشرفنا عليها ، قال رسول الله صلى الله عليه وسلم للناس : \" قفوا \" . فوقف الناس ، ثم قال : /20 \" اللهم رب السموات السبع وما أظللن ، ورب الأرضين والسبع وما أقللن ، ورب الشياطين وما أضللن إنا نسألك من خيرها وخير أهلها ، ونعوذ بك من شرها وشر أهلها ، ادخلوا بسم الله \" /27 . وقد تقدم ، أخرجه أبو موسى  * \r\n@ 14581'E2027",
      "grade": null,
