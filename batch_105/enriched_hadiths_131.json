    {
      "hadith_id": 937965,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 4910,
      "text_ar": "أخبرنا  /94  عبد الوهاب بن أبي حبة L67084  /94  ، بإسناده عن  /26  عبد الله بن أحمد L4657  /26  ، حدثني  /26  أبي L488  /26  ، حدثنا  /26  إبراهيم ابن أبي العباس L781  /26  ،  /26  ويونس L8617  /26  المعني ، قالا : حدثنا  /26  عبد الرحمن يعني : ابن عثمان بن إبراهيم بن محمد بن حاطب L4439  /26  ، قال : حدثني  /26  أبي L5491  /26  ، /27 عن أمه  /93  عائشة L4052  /93  ، قالت : كنت مع أمي رائطة بنت سفيان والنبي يبايع النساء ، ويقول : /20 أبايعكن على أن لا تشركن بالله شيئا ، ولا تسرقن ولا تزنين ، ولا تقتلن أولادكن ، ولا تأتين ببهتان تفترينه بين أيديكن وأرجلكن ، ولا تعصينني في معروف . قالت : فأطرقن ، فقال رسول الله صلى الله عليه وسلم : \" قلن نعم فيما استطعتن \" /27 فكن يقلن ، وأقول معهن ، وأمي تلقنني : قولي أي بنية له : نعم فيما استطعت . فكنت أقول كما يقلن . أخرجه الثلاثة  * \r\n@ 15183\u001dE2192",
      "sanad_ar": "أخبرنا  /94  عبد الوهاب بن أبي حبة L67084  /94",
      "matn_ar": "بإسناده عن  /26  عبد الله بن أحمد L4657  /26  ، حدثني  /26  أبي L488  /26  ، حدثنا  /26  إبراهيم ابن أبي العباس L781  /26  ،  /26  ويونس L8617  /26  المعني ، قالا : حدثنا  /26  عبد الرحمن يعني : ابن عثمان بن إبراهيم بن محمد بن حاطب L4439  /26  ، قال : حدثني  /26  أبي L5491  /26  ، /27 عن أمه  /93  عائشة L4052  /93  ، قالت : كنت مع أمي رائطة بنت سفيان والنبي يبايع النساء ، ويقول : /20 أبايعكن على أن لا تشركن بالله شيئا ، ولا تسرقن ولا تزنين ، ولا تقتلن أولادكن ، ولا تأتين ببهتان تفترينه بين أيديكن وأرجلكن ، ولا تعصينني في معروف . قالت : فأطرقن ، فقال رسول الله صلى الله عليه وسلم : \" قلن نعم فيما استطعتن \" /27 فكن يقلن ، وأقول معهن ، وأمي تلقنني : قولي أي بنية له : نعم فيما استطعت . فكنت أقول كما يقلن . أخرجه الثلاثة  * \r\n@ 15183\u001dE2192",
      "grade": null,
