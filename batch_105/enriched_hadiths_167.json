    {
      "hadith_id": 938501,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 5446,
      "text_ar": "أخبرنا  /94  أبو القاسم يعيش بن صدقة الفقيه L78287  /94  ، بإسناده عن  /26  أبي عبد الرحمن النسائي L9880  /26  : أخبرنا  /26  عبيد الله بن سعيد L5390  /26  ، حدثنا  /26  معاذ بن هشام L7563  /26  ، حدثني  /26  أبي L8035  /26  ، عن أبي  /26  يحيى بن أبي كثير L8208  /26  ، قال : حدثني  /26  زيد L3141  /26  ، عن  /26  أبي سلام L7663  /26  ، عن  /26  أبي أسماء الرحبي L6198  /26  ، /27 أن  /93  ثوبان L2055  /93  مولى رسول الله صلى الله عليه وسلم حدثه ، قال : جاءت هند بنت هبيرة إلى رسول الله صلى الله عليه وسلم وفي يدها فتخ ، أي خواتيم ضخام ، فجعل رسول الله صلى الله عليه وسلم يضرب يدها ، فدخلت على فاطمة تشكو إليها الذي صنع بها رسول الله صلى الله عليه وسلم فانتزعت فاطمة سلسلة كانت في عنقها من ذهب ، فقالت : هذه أهداها إلي أبو حسن . فدخل رسول الله صلى الله عليه وسلم والسلسلة في يدها ، فقال : \" يا فاطمة ، /20 أيغرك أن يقول الناس : ابنة رسول الله صلى الله عليه وسلم وفي يدك سلسلة من نار ؟ ! \" ثم خرج ولم يقعد . فأرسلت فاطمة السلسلة إلى السوق فباعتها ، واشترت بثمنها غلاما ، وقال مرة : عبدا فأعتقته ، فحدثت بذلك رسول الله صلى الله عليه وسلم فقال : \" الحمد الله الذي نجى فاطمة من النار \" /27 . أخرجها أبو موسى  * \r\n@ 15406",
      "sanad_ar": "أخبرنا  /94  أبو القاسم يعيش بن صدقة الفقيه L78287  /94",
      "matn_ar": "بإسناده عن  /26  أبي عبد الرحمن النسائي L9880  /26  : أخبرنا  /26  عبيد الله بن سعيد L5390  /26  ، حدثنا  /26  معاذ بن هشام L7563  /26  ، حدثني  /26  أبي L8035  /26  ، عن أبي  /26  يحيى بن أبي كثير L8208  /26  ، قال : حدثني  /26  زيد L3141  /26  ، عن  /26  أبي سلام L7663  /26  ، عن  /26  أبي أسماء الرحبي L6198  /26  ، /27 أن  /93  ثوبان L2055  /93  مولى رسول الله صلى الله عليه وسلم حدثه ، قال : جاءت هند بنت هبيرة إلى رسول الله صلى الله عليه وسلم وفي يدها فتخ ، أي خواتيم ضخام ، فجعل رسول الله صلى الله عليه وسلم يضرب يدها ، فدخلت على فاطمة تشكو إليها الذي صنع بها رسول الله صلى الله عليه وسلم فانتزعت فاطمة سلسلة كانت في عنقها من ذهب ، فقالت : هذه أهداها إلي أبو حسن . فدخل رسول الله صلى الله عليه وسلم والسلسلة في يدها ، فقال : \" يا فاطمة ، /20 أيغرك أن يقول الناس : ابنة رسول الله صلى الله عليه وسلم وفي يدك سلسلة من نار ؟ ! \" ثم خرج ولم يقعد . فأرسلت فاطمة السلسلة إلى السوق فباعتها ، واشترت بثمنها غلاما ، وقال مرة : عبدا فأعتقته ، فحدثت بذلك رسول الله صلى الله عليه وسلم فقال : \" الحمد الله الذي نجى فاطمة من النار \" /27 . أخرجها أبو موسى  * \r\n@ 15406",
      "grade": null,
