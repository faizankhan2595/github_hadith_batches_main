    {
      "hadith_id": 936370,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 3315,
      "text_ar": "أخبرنا  /94  يحيى بن محمود L46109  /94  ،  /94  وعبد الوهاب بن أبي حبة L67084  /94  ، بإسنادهما إلى  /26  مسلم بن الحجاج L7457  /26  : أخبرنا  /26  زهير بن حرب L3036  /26  ، حدثنا  /26  علي بن حفص L5760  /26  ، حدثنا  /26  ورقاء L8149  /26  ، عن  /26  أبي الزناد L4798  /26  ، عن  /26  الأعرج L4506  /26  ، /27 عن  /93  أبي هريرة L4396  /93  ، رضي الله عنه ، قال : بعث رسول الله صلى الله عليه وسلم عمر رضي الله عنه على الصدقة ، فقيل : منع ابن جميل وخالد بن الوليد والعباس عم رسول الله صلى الله عليه وسلم ، فقال رسول الله صلى الله عليه وسلم : /20 \" ما ينقم ابن جميل إلا أنه كان فقيرا فأغناه الله ، وأما خالد فإنكم تظلمون خالدا ، قد احتبس أدراعه وأعتاده في سبيل الله ، وأما العباس فهي علي ومثلها معها \" /27  * \r\n$2025  50092 /2",
      "sanad_ar": "أخبرنا  /94  يحيى بن محمود L46109  /94",
      "matn_ar": "/94  وعبد الوهاب بن أبي حبة L67084  /94  ، بإسنادهما إلى  /26  مسلم بن الحجاج L7457  /26  : أخبرنا  /26  زهير بن حرب L3036  /26  ، حدثنا  /26  علي بن حفص L5760  /26  ، حدثنا  /26  ورقاء L8149  /26  ، عن  /26  أبي الزناد L4798  /26  ، عن  /26  الأعرج L4506  /26  ، /27 عن  /93  أبي هريرة L4396  /93  ، رضي الله عنه ، قال : بعث رسول الله صلى الله عليه وسلم عمر رضي الله عنه على الصدقة ، فقيل : منع ابن جميل وخالد بن الوليد والعباس عم رسول الله صلى الله عليه وسلم ، فقال رسول الله صلى الله عليه وسلم : /20 \" ما ينقم ابن جميل إلا أنه كان فقيرا فأغناه الله ، وأما خالد فإنكم تظلمون خالدا ، قد احتبس أدراعه وأعتاده في سبيل الله ، وأما العباس فهي علي ومثلها معها \" /27  * \r\n$2025  50092 /2",
