    {
      "hadith_id": 937222,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 4167,
      "text_ar": "أخبرنا  /94  يحيى L46109  /94  ، إجازة ، بإسناده عن  /26  ابن أبي عاصم L10084  /26  : أخبرنا  /26  محمد بن غالب L6776  /26  ، أخبرنا  /26  أحمد بن جناب L433  /26  ، عن  /26  عيسى بن يونس L6343  /26  ، عن  /26  سعيد بن عثمان البلوي L3371  /26  ، /27 عن جدته  /93  أنيسة بنت عدي L11080  /93  ، أنها جاءت إلى النبي صلى الله عليه وسلم فقالت : يا رسول الله ، إن /20 ابني عبد الله بن سلمة وكان بدريا قتل يوم أحد ، فأحببت أن أنقله إلي فآنس بقربه . فأذن لها النبي صلى الله عليه وسلم في نقله ، فعدلته بالمجذر بن ذبان على ناضح لها في عباءة ، فمرت بهما ، فنظر إليهما النبي صلى الله عليه وسلم فقال : \" سوى بينهما عملهما \" /27 وكان المجذر خفيف اللحم ، وعبد الله ثقيلا جسميا . أخرجه الثلاثة  * \r\n@ 14878\u001aE2099",
      "sanad_ar": "أخبرنا  /94  يحيى L46109  /94",
      "matn_ar": "إجازة ، بإسناده عن  /26  ابن أبي عاصم L10084  /26  : أخبرنا  /26  محمد بن غالب L6776  /26  ، أخبرنا  /26  أحمد بن جناب L433  /26  ، عن  /26  عيسى بن يونس L6343  /26  ، عن  /26  سعيد بن عثمان البلوي L3371  /26  ، /27 عن جدته  /93  أنيسة بنت عدي L11080  /93  ، أنها جاءت إلى النبي صلى الله عليه وسلم فقالت : يا رسول الله ، إن /20 ابني عبد الله بن سلمة وكان بدريا قتل يوم أحد ، فأحببت أن أنقله إلي فآنس بقربه . فأذن لها النبي صلى الله عليه وسلم في نقله ، فعدلته بالمجذر بن ذبان على ناضح لها في عباءة ، فمرت بهما ، فنظر إليهما النبي صلى الله عليه وسلم فقال : \" سوى بينهما عملهما \" /27 وكان المجذر خفيف اللحم ، وعبد الله ثقيلا جسميا . أخرجه الثلاثة  * \r\n@ 14878\u001aE2099",
