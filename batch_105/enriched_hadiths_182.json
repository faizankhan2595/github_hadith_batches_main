    {
      "hadith_id": 938722,
      "book_id": 1591,
      "chapter_id": null,
      "hadith_number": 5667,
      "text_ar": "أخبرنا  /94  أبو الفضل بن أبي الحسن المخزومي L32125  /94  ، بإسناده عن  /26  أبي يعلى L10025  /26  ، قال : حدثنا  /26  القواريري L5422  /26  ، حدثنا  /26  يزيد بن زريع L8418  /26  ، حدثنا  /26  حجاج الصواف L2287  /26  ، عن  /26  أبي الزبير L7270  /26  ، /27 عن  /93  جابر L2069  /93  ، أن رسول الله صلى الله عليه وسلم دخل على أم السائب أو : أم المسيب وهي ترفرف ، فقال : \" ما لك يا أم السائب \" أو : \" يا أم المسيب ترفرفين ؟ \" قالت : الحمى ، لا بارك الله فيها ! فقال : \" /20 لا تسبي الحمى ، فإنها تذهب خطايا ابن آدم ، كما يذهب الكير خبث الحديد \" /27 . أخرجها الثلاثة  * \r\n@ 15482",
      "sanad_ar": "أخبرنا  /94  أبو الفضل بن أبي الحسن المخزومي L32125  /94",
      "matn_ar": "بإسناده عن  /26  أبي يعلى L10025  /26  ، قال : حدثنا  /26  القواريري L5422  /26  ، حدثنا  /26  يزيد بن زريع L8418  /26  ، حدثنا  /26  حجاج الصواف L2287  /26  ، عن  /26  أبي الزبير L7270  /26  ، /27 عن  /93  جابر L2069  /93  ، أن رسول الله صلى الله عليه وسلم دخل على أم السائب أو : أم المسيب وهي ترفرف ، فقال : \" ما لك يا أم السائب \" أو : \" يا أم المسيب ترفرفين ؟ \" قالت : الحمى ، لا بارك الله فيها ! فقال : \" /20 لا تسبي الحمى ، فإنها تذهب خطايا ابن آدم ، كما يذهب الكير خبث الحديد \" /27 . أخرجها الثلاثة  * \r\n@ 15482",
