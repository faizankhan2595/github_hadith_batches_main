      "hadith_id": 342358,
      "book_id": 338,
      "chapter_id": null,
      "hadith_number": 9685,
      "text_ar": "اختلفت القرأة فِي قراءة ذَلِكَ ، فقرأه قرأة الأمصار : /4 فِيهِ آيَاتٌ بَيِّنَاتٌ سورة آل عمران آية 97 /4 عَلَى جماع \" آية \" ، بمعنى : فِيهِ علامات بينات ، وقرأ ذَلِكَ ابن عَبَّاس : \" فِيهِ آية بينة \" ، يَعْني بِهَا : مقام إِبْرَاهِيم ، يراد بِهَا علامة واحدة . ثُمَّ اخْتَلَفَ أهل التأويل فِي تأويل قوله : /4 فِيهِ آيَاتٌ بَيِّنَاتٌ سورة آل عمران آية 97 /4 ، وما تِلْكَ الآيات ؟ فَقَالَ بعضهم : مقام إِبْرَاهِيم والمشعر ، ونحو ذَلِكَ .",
      "sanad_ar": "اختلفت القرأة فِي قراءة ذَلِكَ",
      "matn_ar": "فقرأه قرأة الأمصار : /4 فِيهِ آيَاتٌ بَيِّنَاتٌ سورة آل عمران آية 97 /4 عَلَى جماع \" آية \" ، بمعنى : فِيهِ علامات بينات ، وقرأ ذَلِكَ ابن عَبَّاس : \" فِيهِ آية بينة \" ، يَعْني بِهَا : مقام إِبْرَاهِيم ، يراد بِهَا علامة واحدة . ثُمَّ اخْتَلَفَ أهل التأويل فِي تأويل قوله : /4 فِيهِ آيَاتٌ بَيِّنَاتٌ سورة آل عمران آية 97 /4 ، وما تِلْكَ الآيات ؟ فَقَالَ بعضهم : مقام إِبْرَاهِيم والمشعر ، ونحو ذَلِكَ .",
