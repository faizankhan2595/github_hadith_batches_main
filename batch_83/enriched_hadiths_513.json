    {
      "hadith_id": 745693,
      "book_id": 798,
      "chapter_id": null,
      "hadith_number": 15854,
      "text_ar": "أنبأنا /94 أبو مُحَمَّد عَبْد الكريم بْن حمزة /94 ، عن /26 أبي القاسم خلف بْن أَحْمَد بْن الفضل الحوفي /26 ، أنا /26 أبو مُحَمَّد عَبْد الرحمن بْن عمر بْن النحاس /26 ، أنا /26 أبو عمر مُحَمَّد بْن يوسف بْن يعقوب الكندي /26 ، حدثني /26 عَلِيّ بْن الحسن بْن قديد /26 ، نا /26 عبيد الله بْن سعيد /26 ، عن /26 أبيه /26 ، /27 حدثني /26 عمرو بْن بحري السبائي /26 : أن /20 صالح بْن عَلِيّ الهاشمي لما خرج من مصر إلى الشام خرج بْنفر من وجوه أهل مصر ، منهم : معاوية بْن عَبْد الرحمن بْن بحرم الخولاني ، وخالد بْن حيان بْن الأعين الحضرمي ، وشرحبيل بْن مذيلفة الكلبي ، وعوف بْن سليمان الحضرمي ، وعمرو بْن الحارث الفقيه /27 . *",
      "sanad_ar": "أنبأنا /94 أبو مُحَمَّد عَبْد الكريم بْن حمزة /94",
      "matn_ar": "عن /26 أبي القاسم خلف بْن أَحْمَد بْن الفضل الحوفي /26 ، أنا /26 أبو مُحَمَّد عَبْد الرحمن بْن عمر بْن النحاس /26 ، أنا /26 أبو عمر مُحَمَّد بْن يوسف بْن يعقوب الكندي /26 ، حدثني /26 عَلِيّ بْن الحسن بْن قديد /26 ، نا /26 عبيد الله بْن سعيد /26 ، عن /26 أبيه /26 ، /27 حدثني /26 عمرو بْن بحري السبائي /26 : أن /20 صالح بْن عَلِيّ الهاشمي لما خرج من مصر إلى الشام خرج بْنفر من وجوه أهل مصر ، منهم : معاوية بْن عَبْد الرحمن بْن بحرم الخولاني ، وخالد بْن حيان بْن الأعين الحضرمي ، وشرحبيل بْن مذيلفة الكلبي ، وعوف بْن سليمان الحضرمي ، وعمرو بْن الحارث الفقيه /27 . *",
