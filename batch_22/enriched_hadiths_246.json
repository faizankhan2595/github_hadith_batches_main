    {
      "hadith_id": 192688,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 13920,
      "text_ar": "سَمِعَ أَبَا ثَعْلَبَةَ الْخُشَنِيَّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ مِنْ وَرَائِكُمْ أَيَّامُ الصَّبْرِ ، الصَّبْرُ فِيهِنَّ كَقَبْضٍ عَلَى الْجَمْرِ \" . قَالَهُ لي : عَبْد اللَّه بْن عثمان ، عَنِ ابْنِ المبارك ، عَنْ عتبة بْن أَبِي حكيم ، عَنْ عمرو بْن حارثة اللخمي ، عَنْ أَبِي أمية الشعباني .\u001eE1520",
      "sanad_ar": "سَمِعَ أَبَا ثَعْلَبَةَ الْخُشَنِيَّ",
      "matn_ar": "عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ مِنْ وَرَائِكُمْ أَيَّامُ الصَّبْرِ ، الصَّبْرُ فِيهِنَّ كَقَبْضٍ عَلَى الْجَمْرِ \" . قَالَهُ لي : عَبْد اللَّه بْن عثمان ، عَنِ ابْنِ المبارك ، عَنْ عتبة بْن أَبِي حكيم ، عَنْ عمرو بْن حارثة اللخمي ، عَنْ أَبِي أمية الشعباني .\u001eE1520",
