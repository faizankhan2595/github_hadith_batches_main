      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 11521,
      "text_ar": "عَنْ عُبَيْد اللَّه بْن عدي بْن الخيار ، عَنْ عُمَر ، روى عنه : بكير بْن الأشج ، أن العبد إذا تواضع لله رفعه اللَّه . روى الليث بْن سعد ، عَنْ مَعْمَر بْن أَبِي حبيبة ، عَنْ عُبَيْد اللَّه بْن عدي ، عَنْ عُمَر ، قَالَ : \" إذا التقي الختانان \" ، وقَالَ الليث : عَنْ يزيد بْن أَبِي حبيب ، عَنْ عُبَيْد اللَّه بْن رفاعة ، عَنْ عُمَر فِي الختانين",
      "sanad_ar": "عَنْ عُبَيْد اللَّه بْن عدي بْن الخيار",
      "matn_ar": "عَنْ عُمَر ، روى عنه : بكير بْن الأشج ، أن العبد إذا تواضع لله رفعه اللَّه . روى الليث بْن سعد ، عَنْ مَعْمَر بْن أَبِي حبيبة ، عَنْ عُبَيْد اللَّه بْن عدي ، عَنْ عُمَر ، قَالَ : \" إذا التقي الختانان \" ، وقَالَ الليث : عَنْ يزيد بْن أَبِي حبيب ، عَنْ عُبَيْد اللَّه بْن رفاعة ، عَنْ عُمَر فِي الختانين",
