    {
      "hadith_id": 191922,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 13154,
      "text_ar": "أَخُو بَنِي مُرَّةَ بْنِ عَبَّادٍ ، يُعَدُّ فِي الْبَصْرِيِّينَ ، عَنْ أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ يَسْتَغْنِ يُغْنِهِ اللَّهُ \" . روى عَنْهُ أَبُو حمزة ، وقتادة ، ويقال : إن قتادة روى أيضا ، عَنْ أَبِي حمزة .\u001bE1432",
      "sanad_ar": "أَخُو بَنِي مُرَّةَ بْنِ عَبَّادٍ",
      "matn_ar": "يُعَدُّ فِي الْبَصْرِيِّينَ ، عَنْ أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ يَسْتَغْنِ يُغْنِهِ اللَّهُ \" . روى عَنْهُ أَبُو حمزة ، وقتادة ، ويقال : إن قتادة روى أيضا ، عَنْ أَبِي حمزة .\u001bE1432",
