    {
      "hadith_id": 190403,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 11635,
      "text_ar": "قَالَ عَمْرو بْن مُحَمَّد : نا العلاء بْن هلال ، سَمِعَ عُبَيْد اللَّه بْن عَمْرو ، عَنْ زيد بْن أَبِي أنيسة ، عَنْ عياض بْن مرة ، عَنْ أَبِي الفيض ، عَنْ مَعْن بْن علي السلمي ، قَالَ : \" صلى بِنَا مُعَاوِيَة المغرب ، فقام فِي الركعتين ، فلما فرغ سجد سجدتين ، ثم قَالَ : رأيت النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فعل مثله \"",
      "sanad_ar": "قَالَ عَمْرو بْن مُحَمَّد",
      "matn_ar": "نا العلاء بْن هلال ، سَمِعَ عُبَيْد اللَّه بْن عَمْرو ، عَنْ زيد بْن أَبِي أنيسة ، عَنْ عياض بْن مرة ، عَنْ أَبِي الفيض ، عَنْ مَعْن بْن علي السلمي ، قَالَ : \" صلى بِنَا مُعَاوِيَة المغرب ، فقام فِي الركعتين ، فلما فرغ سجد سجدتين ، ثم قَالَ : رأيت النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فعل مثله \"",
