    {
      "hadith_id": 190468,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 11700,
      "text_ar": "كوفِي ، سَمِعَ الشَّعْبِيّ ، وأبا السفر ، والحكم ، روى عنه : الثوري ، وابْن عيينة ، قَالَ : عَبْد اللَّه بْن أَبِي الأسود ، عَنْ أَبِي عَبْد اللَّه البجلي ، قَالَ : مات مطرف سنة إحدى أو ثنتين وأربعين ومائة ، وقَالَ أَبُو نعيم : نا سُفْيَان ، عَنْ مطرف ، عَنِ الشَّعْبِيّ : قَالَ يرد من الحبل غرر ، وقَالَ ابْن المبارك : عَنْ سُفْيَان ، عَنْ أَبِي عَبْد الرَّحْمَن ، عَنِ الشَّعْبِيّ ، مثله .\u001dE1339",
      "sanad_ar": "كوفِي",
      "matn_ar": "سَمِعَ الشَّعْبِيّ ، وأبا السفر ، والحكم ، روى عنه : الثوري ، وابْن عيينة ، قَالَ : عَبْد اللَّه بْن أَبِي الأسود ، عَنْ أَبِي عَبْد اللَّه البجلي ، قَالَ : مات مطرف سنة إحدى أو ثنتين وأربعين ومائة ، وقَالَ أَبُو نعيم : نا سُفْيَان ، عَنْ مطرف ، عَنِ الشَّعْبِيّ : قَالَ يرد من الحبل غرر ، وقَالَ ابْن المبارك : عَنْ سُفْيَان ، عَنْ أَبِي عَبْد الرَّحْمَن ، عَنِ الشَّعْبِيّ ، مثله .\u001dE1339",
