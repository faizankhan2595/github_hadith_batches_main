    {
      "hadith_id": 189044,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 10276,
      "text_ar": "يعد فِي الكوفِيين ، عن ابن عَبَّاس ، قَالَ السائل : الَّذِي يسأل ، والمحروم المحارب الَّذِي يحارب لَيْسَ لَهُ فِي الإسلام سهم ، قَالَه سُفْيَان .",
      "sanad_ar": "يعد فِي الكوفِيين",
      "matn_ar": "عن ابن عَبَّاس ، قَالَ السائل : الَّذِي يسأل ، والمحروم المحارب الَّذِي يحارب لَيْسَ لَهُ فِي الإسلام سهم ، قَالَه سُفْيَان .",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:47:45",
      "book": {
