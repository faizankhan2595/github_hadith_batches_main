      "hadith_id": 191798,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 13030,
      "text_ar": "سَمِعَ المغيرة ، روى عَنْهُ المسيب بْن رافع ، وعبد الملك بْن عمير . \r\n$991  990 /2 /141 قَالَ لِي /94 إِبْرَاهِيمُ بْنُ مُوسَى L890 /94 ، عَنِ /26 الْوَلِيدِ L1807 /26 ، عَنْ /26 ثَوْرٍ L2058 /26 ، عَنْ /26 رَجَاءِ بْنِ حَيْوَةَ L2911 /26 ، عَنْ /26 كَاتِبِ الْمُغِيرَةِ بْن شُعْبَةَ L8148 /26 ، /27 عَنِ /93 الْمُغِيرَةِ L1665 /93 ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 \" مَسَحَ ظَاهِرَ خُفَّيْهِ وَباطِنَهُمَا \" /27 . وقَالَ /94 ابْنُ حَنْبَلٍ L488 /94 : نا /26 ابْنُ مَهْدِيٍّ L4493 /26 ، عَنِ /26 ابْنِ الْمُبَارَكِ L4716 /26 ، عَنْ /26 ثَوْرِ بْنِ يَزِيدَ L2058 /26 يُحَدِّثُ عَنْ /26 رَجَاءِ بْنِ حَيْوَةَ L2911 /26 ، عَنْ /26 كَاتِبِ الْمُغِيرَةِ بْنِ شُعْبَةَ L8148 /26 ، لَيْسَ فِيهِ الْمُغِيرَةُ نَحْوَهُ * \r\n$992  991 /2 /141 وَقَالَ لَنَا /94 مُحَمَّدُ بْنُ صَبَاحٍ L6846 /94 : نَا /26 عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ L4264 /26 ، عَنْ /26 أَبِيهِ L4798 /26 ، عَنْ /26 عُرْوَةَ بْنِ الزُّبَيْرِ L5594 /26 ، /27 عَنِ /93 الْمُغِيرَةِ بْنِ شُعْبَةَ L1665 /93 ، قَالَ : رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 \" مَسَحَ عَلَى خُفَّيْهِ عَلَى ظَاهِرِهِمَا \" /27 * \r\n\u001eE1425",
      "sanad_ar": "سَمِعَ المغيرة",
      "matn_ar": "روى عَنْهُ المسيب بْن رافع ، وعبد الملك بْن عمير . \r\n$991  990 /2 /141 قَالَ لِي /94 إِبْرَاهِيمُ بْنُ مُوسَى L890 /94 ، عَنِ /26 الْوَلِيدِ L1807 /26 ، عَنْ /26 ثَوْرٍ L2058 /26 ، عَنْ /26 رَجَاءِ بْنِ حَيْوَةَ L2911 /26 ، عَنْ /26 كَاتِبِ الْمُغِيرَةِ بْن شُعْبَةَ L8148 /26 ، /27 عَنِ /93 الْمُغِيرَةِ L1665 /93 ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 \" مَسَحَ ظَاهِرَ خُفَّيْهِ وَباطِنَهُمَا \" /27 . وقَالَ /94 ابْنُ حَنْبَلٍ L488 /94 : نا /26 ابْنُ مَهْدِيٍّ L4493 /26 ، عَنِ /26 ابْنِ الْمُبَارَكِ L4716 /26 ، عَنْ /26 ثَوْرِ بْنِ يَزِيدَ L2058 /26 يُحَدِّثُ عَنْ /26 رَجَاءِ بْنِ حَيْوَةَ L2911 /26 ، عَنْ /26 كَاتِبِ الْمُغِيرَةِ بْنِ شُعْبَةَ L8148 /26 ، لَيْسَ فِيهِ الْمُغِيرَةُ نَحْوَهُ * \r\n$992  991 /2 /141 وَقَالَ لَنَا /94 مُحَمَّدُ بْنُ صَبَاحٍ L6846 /94 : نَا /26 عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ L4264 /26 ، عَنْ /26 أَبِيهِ L4798 /26 ، عَنْ /26 عُرْوَةَ بْنِ الزُّبَيْرِ L5594 /26 ، /27 عَنِ /93 الْمُغِيرَةِ بْنِ شُعْبَةَ L1665 /93 ، قَالَ : رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 \" مَسَحَ عَلَى خُفَّيْهِ عَلَى ظَاهِرِهِمَا \" /27 * \r\n\u001eE1425",
