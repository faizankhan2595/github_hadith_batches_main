    {
      "hadith_id": 190660,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 11892,
      "text_ar": "لَهُ صحبة ، روى زهير ، ومُحَمَّد بْن سلمة ، عَنْ مُحَمَّد بْن إِسْحَاق ، عَنْ مُحَمَّد بْن طلحة بْن يزيد ، عَنْ عمته عَائِشَةَ بِنْت مَسْعُود ، عَنْ أَبِيها وقَالَ جرير بْن حازم ، عن ابن إِسْحَاق ، عَنْ مُحَمَّد ، عَنْ أمه عَائِشَةَ بِنْت مَسْعُود ، عَنْ أَبِيها وقَالَ ليث ، عَنْ يزيد بْن أَبِي حبيب ، عَنْ مُحَمَّد بْن إِسْحَاق ، عَنْ مُحَمَّد بْن طلحة أن خالته بِنْت مَسْعُود بْن العجماء حدثته ، عَنْ أَبِيها .",
      "sanad_ar": "لَهُ صحبة",
      "matn_ar": "روى زهير ، ومُحَمَّد بْن سلمة ، عَنْ مُحَمَّد بْن إِسْحَاق ، عَنْ مُحَمَّد بْن طلحة بْن يزيد ، عَنْ عمته عَائِشَةَ بِنْت مَسْعُود ، عَنْ أَبِيها وقَالَ جرير بْن حازم ، عن ابن إِسْحَاق ، عَنْ مُحَمَّد ، عَنْ أمه عَائِشَةَ بِنْت مَسْعُود ، عَنْ أَبِيها وقَالَ ليث ، عَنْ يزيد بْن أَبِي حبيب ، عَنْ مُحَمَّد بْن إِسْحَاق ، عَنْ مُحَمَّد بْن طلحة أن خالته بِنْت مَسْعُود بْن العجماء حدثته ، عَنْ أَبِيها .",
