    {
      "hadith_id": 192321,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 13553,
      "text_ar": "قَالَ لنا /94 مُوسَى L7721 /94 : نا /26 حماد بْن سلمة L2492 /26 ، قَالَ : أخبرنا /26 يوسف بْن سعد L8574 /26 ، عَنْ /26 عَبْد الملكِ بنِ جُبَيْر بْن حية L22041 /26 ، عَنْ /93 شداد بْن أوس L3764 /93 ، قَالَ : \" لما طعَنْ عُمَر دخل عليه كعب ، فقَالَ : لو دعا أمير المؤمنين أن يؤخر فِي أجلة لكَانَ خيرا \" . وعَنِ الحارث بْن حاطب ، وقَالَ أَبُو عوانة : عَنْ أَبِي بشر ، عَنْ يوسف بْن سعد مولى مُحَمَّد بْن حاطب الْقُرَشِيّ ، أن مُحَمَّدا قدم مَعَ علي رضى اللَّه تعالى عَنْهُ /60 البصرة /60 . نا /94 إِسْحَاق L927 /94 ، نا /26 خَالِد L2625 /26 ، عَنْ /26 يوسف أَبِي يعقوب /26 ، عَنْ /26 مُحَمَّد بْن حاطب أَبِي الحارث L6915 /26 فِي اللص . وقَالَ لي /94 المقدمي L6760 /94 : نا /26 معتمر بْن سُلَيْمَان L7607 /26 ، سَمِعَ /26 دَاوُد L2772 /26 ، عَنْ /26 يوسف بْن سعد L8574 /26 ، كَانَ زيد بْن ثابت عامل عثمان على بيت المال ، وقَالَ عَبْد الصمد : نا أَبِي ، عَنْ علي بْن زيد ، قَالَ : أخبرنا يوسف بْن سعد مولى قدامة بْن مظعون الْمَدَنِيّ وقَالَ أَبُو قدامة : عَنْ عَبْد الرَّحْمَن ، عَنِ الثوري ، عَنْ علي بْن زيد بْن جدعان ، عَنْ يوسف بْن سعد ، عَنْ عُمَر : وأحلوا قومهم دار البوار قَالَ : \"    هم الأفجران \" .\u001bE1497",
      "sanad_ar": "قَالَ لنا /94 مُوسَى L7721 /94",
      "matn_ar": "نا /26 حماد بْن سلمة L2492 /26 ، قَالَ : أخبرنا /26 يوسف بْن سعد L8574 /26 ، عَنْ /26 عَبْد الملكِ بنِ جُبَيْر بْن حية L22041 /26 ، عَنْ /93 شداد بْن أوس L3764 /93 ، قَالَ : \" لما طعَنْ عُمَر دخل عليه كعب ، فقَالَ : لو دعا أمير المؤمنين أن يؤخر فِي أجلة لكَانَ خيرا \" . وعَنِ الحارث بْن حاطب ، وقَالَ أَبُو عوانة : عَنْ أَبِي بشر ، عَنْ يوسف بْن سعد مولى مُحَمَّد بْن حاطب الْقُرَشِيّ ، أن مُحَمَّدا قدم مَعَ علي رضى اللَّه تعالى عَنْهُ /60 البصرة /60 . نا /94 إِسْحَاق L927 /94 ، نا /26 خَالِد L2625 /26 ، عَنْ /26 يوسف أَبِي يعقوب /26 ، عَنْ /26 مُحَمَّد بْن حاطب أَبِي الحارث L6915 /26 فِي اللص . وقَالَ لي /94 المقدمي L6760 /94 : نا /26 معتمر بْن سُلَيْمَان L7607 /26 ، سَمِعَ /26 دَاوُد L2772 /26 ، عَنْ /26 يوسف بْن سعد L8574 /26 ، كَانَ زيد بْن ثابت عامل عثمان على بيت المال ، وقَالَ عَبْد الصمد : نا أَبِي ، عَنْ علي بْن زيد ، قَالَ : أخبرنا يوسف بْن سعد مولى قدامة بْن مظعون الْمَدَنِيّ وقَالَ أَبُو قدامة : عَنْ عَبْد الرَّحْمَن ، عَنِ الثوري ، عَنْ علي بْن زيد بْن جدعان ، عَنْ يوسف بْن سعد ، عَنْ عُمَر : وأحلوا قومهم دار البوار قَالَ : \"    هم الأفجران \" .\u001bE1497",
