    {
      "hadith_id": 190821,
      "book_id": 140,
      "chapter_id": null,
      "hadith_number": 12053,
      "text_ar": "نا /94 أَبُو الْعَبَّاسِ L28615 /94 ، نا /26 أَحْمَدُ بْنُ يُوسُفَ السُّلَمِيُّ L502 /26 , قَالَ : نا /26 مُسْلِم بْنُ إِبْرَاهِيمَ L7455 /26 ، نا /26 حَمَّادُ بْنُ سَلَمَةَ L2492 /26 ، عَنْ /26 مُحَمَّدِ بْنِ إِسْحَاق L6811 /26 ، عَنْ /26 أَبِي الزِّنَادِ L4798 /26 ، عَنْ /26 مُجَالِدِ بْنِ عَوْفٍ L6713 /26 ، عَنْ /26 خَارِجَةَ بْنِ زَيْدٍ L2607 /26 ، /27 سَمِعْتُ /93 زَيْدَ بْنَ ثَابِتٍ L3131 /93 ، يَقُولُ : /20 \" نَزَلَتْ هَذِهِ الآيَةُ : /4 وَمَنْ يَقْتُلْ مُؤْمِنًا مُتَعَمِّدًا فَجَزَاؤُهُ جَهَنَّمُ خَالِدًا فِيهَا سورة النساء آية 93 /4 , بَعْدَ الَّتِي فِي /65 الْفُرْقَانِ /65 , /4 وَالَّذِينَ لا يَدْعُونَ مَعَ اللَّهِ إِلَهًا آخَرَ سورة الفرقان آية 68 /4 بِسَنَةٍ \" /27 * \r\n\u001aE1358",
      "sanad_ar": "نا /94 أَبُو الْعَبَّاسِ L28615 /94",
      "matn_ar": "نا /26 أَحْمَدُ بْنُ يُوسُفَ السُّلَمِيُّ L502 /26 , قَالَ : نا /26 مُسْلِم بْنُ إِبْرَاهِيمَ L7455 /26 ، نا /26 حَمَّادُ بْنُ سَلَمَةَ L2492 /26 ، عَنْ /26 مُحَمَّدِ بْنِ إِسْحَاق L6811 /26 ، عَنْ /26 أَبِي الزِّنَادِ L4798 /26 ، عَنْ /26 مُجَالِدِ بْنِ عَوْفٍ L6713 /26 ، عَنْ /26 خَارِجَةَ بْنِ زَيْدٍ L2607 /26 ، /27 سَمِعْتُ /93 زَيْدَ بْنَ ثَابِتٍ L3131 /93 ، يَقُولُ : /20 \" نَزَلَتْ هَذِهِ الآيَةُ : /4 وَمَنْ يَقْتُلْ مُؤْمِنًا مُتَعَمِّدًا فَجَزَاؤُهُ جَهَنَّمُ خَالِدًا فِيهَا سورة النساء آية 93 /4 , بَعْدَ الَّتِي فِي /65 الْفُرْقَانِ /65 , /4 وَالَّذِينَ لا يَدْعُونَ مَعَ اللَّهِ إِلَهًا آخَرَ سورة الفرقان آية 68 /4 بِسَنَةٍ \" /27 * \r\n\u001aE1358",
