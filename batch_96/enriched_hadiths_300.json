    {
      "hadith_id": 859499,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8054,
      "text_ar": "الحرب بين السلطان داود وعمّه مسعود",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
