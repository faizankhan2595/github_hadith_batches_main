    {
      "hadith_id": 857156,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 5711,
      "text_ar": "وورد كتاب من نصيبين أنّ ريحًا سوداء هبّت فقلعت من بساتينها أكثر من مائتي ألف شجرة . وأنّ البحر جَزَرَ في تلك النّاحية نحو ثلاثة فراسخ ، وخرج الناس يتبعون السّمك والصَّدَف ، فردّ البحر ففرّق بعضهم .",
      "sanad_ar": "وورد كتاب من نصيبين أنّ ريحًا سوداء هبّت فقلعت من بساتينها أكثر من مائتي ألف شجرة . وأنّ البحر جَزَرَ في تلك النّاحية نحو ثلاثة فراسخ",
      "matn_ar": "وخرج الناس يتبعون السّمك والصَّدَف ، فردّ البحر ففرّق بعضهم .",
      "grade": null,
      "page_number": null,
