    {
      "hadith_id": 859826,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8381,
      "text_ar": "وفيها دخل ملك خُوارَزْم أتْسِز بن محمد مدينة مَرْو , وفتك بها مُراغَمَةً للسّلطان سَنْجَر حين تمّت عليه الهزيمة , وقبض على رئيس الحنفيَّة أبي الفضل الكرمانيّ , وعلى جماعة من الفقهاء .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
