    {
      "hadith_id": 859750,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8305,
      "text_ar": "وفيها سار عسكر دمشق , وعليهم بُزْواش , فحاربوا عسكر طرابُلُس , فنُصِروا , وَقُتِلَ خلْق من الفرنج , ورجع المسلمون بالغنائم والسّبْي الكثير . وقعة بعرين وفيها وقعة بَعْرين بقُرب حماة , التقى الأتابك زنكيّ والفرنج , فنُصِر عليهم أيضًا , وأخذ قلعة بَعْرِين . وكان ذلك أول وهْنٍ أدخله الله على الفرنج .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
