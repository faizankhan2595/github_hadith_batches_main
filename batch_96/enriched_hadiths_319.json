    {
      "hadith_id": 859773,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8328,
      "text_ar": "ثمّ نازل حلب , فخرج إليه خلْقٌ من أهلها , فقاتلوه , فَقُتِلَ خلْق من الروم , وَقُتِلَ بطْريقٌ كبير , ثمّ ملكوا قلعة الأثارب .",
      "sanad_ar": "",
      "matn_ar": "",
