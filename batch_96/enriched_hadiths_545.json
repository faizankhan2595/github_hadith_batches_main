    {
      "hadith_id": 863175,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 11730,
      "text_ar": "وفي ذي القِعْدة كَانَ الصّالح عمادُ الدّين إِسْمَاعِيل قد قبضَ عَلَى جماعة من أمراء الكاملية ، فحبَسَهُم وضيَّق عليهم فماتوا ، وهم : أيبك قضيب البان ، وبَلَبان الدُّنَيْسريّ ، وأيبك الكُرديّ ، وبلَبَان المجاهديّ ، رحمهم اللَّه .",
      "sanad_ar": "وفي ذي القِعْدة كَانَ الصّالح عمادُ الدّين إِسْمَاعِيل قد قبضَ عَلَى جماعة من أمراء الكاملية",
      "matn_ar": "فحبَسَهُم وضيَّق عليهم فماتوا ، وهم : أيبك قضيب البان ، وبَلَبان الدُّنَيْسريّ ، وأيبك الكُرديّ ، وبلَبَان المجاهديّ ، رحمهم اللَّه .",
