    {
      "hadith_id": 859478,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8033,
      "text_ar": "وعدّى زنكيّ الفُرات , فنازل بعض ديار بكر , فحشد صاحب ماردين لقتاله , ونَجَده ابن عمُّه , داود بن سُقْمان من حصن كَيْفا , وصاحب آمِد , حتى صاروا في عشرين ألفًا , فهزمهم زنكيّ , وأخذ بعض بلادهم .\u001eE6365",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
