      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8034,
      "text_ar": "وفيها مات الآمر بأحكام الله , صاحب مصر , وولي بعده الحافظ .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
