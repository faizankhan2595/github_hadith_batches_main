      "chapter_id": null,
      "hadith_number": 8029,
      "text_ar": "انكسار الإفرنج أمام زنكيّ عند الأثارب",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
