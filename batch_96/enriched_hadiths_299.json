    },
    {
      "hadith_id": 859475,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8030,
      "text_ar": "وأمّا أهل حلب فكانوا مع الفرنج الّذين استولوا على حصن الأثارب في ضُرٍّ شديد لقربهم منهم . والأثارب على ثلاثة فراسخ من غربيّ حلب , فجاء عماد الدّين زنكيّ في هذا العام وحاصره , فسارت ملوك الفرنج لنجدته , وللكشف عنه , فالتقاهم زنكيّ , واشتدّ الحرب , وثبت الفريقان ثباتًا كُلّيًا , ثمّ وقعت الكسرة على الملاعين , ووُضع السّيف فيهم , وأُسِر فيهم خلْق . وكان يومًا عظيمًا . وافتتح زنكيّ الحصن عَنْوةً , وجعله دكًّا .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
      "book": {
        "book_id": 936,
        "book_name_ar": "كتاب رقم 936",
        "author_name": "مؤلف غير معروف",
        "author_death_year": null,
        "category_type": null,
        "book_type": null,
        "sequence_number": null,
        "category_name": null,
        "publisher_code": null,
        "publisher_name": null,
        "city": null,
        "edition": null,
        "editor": null,
        "publication_year": null,
        "citation_format": null,
        "hadith_count": null
      },
      "narrators_in_isnad": [],
      "narrator_count": 0,
      "chain_of_transmission": null
    },
    {
      "hadith_id": 859476,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8031,
      "text_ar": "ثمّ نزل على حارِم , وهي بالقرب من أنطاكيَّة , فحاصرها , وصالحهم على نصف دَخْلها . ومنها ذلَّت الفرنج , وعلموا عجزهم عن زنكيّ , واشتدّ أزْر المسلمين .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
