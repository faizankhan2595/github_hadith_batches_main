    {
      "hadith_id": 863590,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 12145,
      "text_ar": "ثُمَّ مسكوا أمراء الأكراد : سيف الدّين القَيمريّ ، وجمال الدين هارون ، والشّرف الشَّيْزَرِيّ ، والعزّ القَيْمُريّ ، وعلاء الدّين بْن الشّهاب ، والحسام بْن القَيْسيّ ، وقُطْب الدّين صاحب آمِد ، وقُطْب الدّين صاحب السُّوَيْدا ، وناصر الدّين التَّبْنينيّ ، وشرف الدّين بْن المعتمد الَّذِي كَانَ والي قلعة دمشق ، وشمس الدّين بْن بكا الَّذِي كَانَ ولي دمشق ، والشّجاع الحاجب .",
      "sanad_ar": "ثُمَّ مسكوا أمراء الأكراد",
      "matn_ar": "سيف الدّين القَيمريّ ، وجمال الدين هارون ، والشّرف الشَّيْزَرِيّ ، والعزّ القَيْمُريّ ، وعلاء الدّين بْن الشّهاب ، والحسام بْن القَيْسيّ ، وقُطْب الدّين صاحب آمِد ، وقُطْب الدّين صاحب السُّوَيْدا ، وناصر الدّين التَّبْنينيّ ، وشرف الدّين بْن المعتمد الَّذِي كَانَ والي قلعة دمشق ، وشمس الدّين بْن بكا الَّذِي كَانَ ولي دمشق ، والشّجاع الحاجب .",
