    {
      "hadith_id": 857565,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 6120,
      "text_ar": "ثم سار إلى مَرْو ، فزوَّج ولده مُلْكشاه ببنت خاقان صاحب ما وراء النّهر ، ودخل بها ، وزوّج ولده رسلان شاه ببنت سلطان غَزْنَة ، واتّفقت الكلمة بينهما ، ووقع الصُّلح والحمد لله .",
      "sanad_ar": "ثم سار إلى مَرْو",
      "matn_ar": "فزوَّج ولده مُلْكشاه ببنت خاقان صاحب ما وراء النّهر ، ودخل بها ، وزوّج ولده رسلان شاه ببنت سلطان غَزْنَة ، واتّفقت الكلمة بينهما ، ووقع الصُّلح والحمد لله .",
      "grade": null,
      "page_number": null,
