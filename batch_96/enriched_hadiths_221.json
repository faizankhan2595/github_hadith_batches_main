      "chapter_id": null,
      "hadith_number": 6857,
      "text_ar": "وفيها تُوُفّي المعتمد بن عَبَّاد مسجونًا بأغْمات ، وكان من محاسِن الدّنيا جُودًا ، وشجاعةً ، وسُؤْدُدًا ، وفصاحةً ، وأدبًا ، وما أحسن قوله : /50 /51 سلَّت عليَّ يدُ الخُطُوبِ سُيوفَها /51 /51 فَجَذَذْنَ من جَسَدي الخصيب الأفتنا /51 /50 /50 /51 ضرَبَتْ بها أيدي الخطوبِ ، وإنّما /51 /51 ضَرَبَتْ رقابَ الآمِلينَ بنا المُنى /51 /50 /50 /51 يا آملي العاداتِ من نَفَحاتنا /51 /51 كُفُّوا ، فإنّ الدّهرَ كفَّ أكُفَّنا . /51 /50",
      "sanad_ar": "وفيها تُوُفّي المعتمد بن عَبَّاد مسجونًا بأغْمات",
      "matn_ar": "وكان من محاسِن الدّنيا جُودًا ، وشجاعةً ، وسُؤْدُدًا ، وفصاحةً ، وأدبًا ، وما أحسن قوله : /50 /51 سلَّت عليَّ يدُ الخُطُوبِ سُيوفَها /51 /51 فَجَذَذْنَ من جَسَدي الخصيب الأفتنا /51 /50 /50 /51 ضرَبَتْ بها أيدي الخطوبِ ، وإنّما /51 /51 ضَرَبَتْ رقابَ الآمِلينَ بنا المُنى /51 /50 /50 /51 يا آملي العاداتِ من نَفَحاتنا /51 /51 كُفُّوا ، فإنّ الدّهرَ كفَّ أكُفَّنا . /51 /50",
      "grade": null,
