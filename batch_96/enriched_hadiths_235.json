    {
      "hadith_id": 858521,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 7076,
      "text_ar": "ووزر للخليفة أبو المحاسن عَبْد الجليل بْن عليّ الدهستانيّ جلال الدولة ، فجاء كتاب بَركيَارُوق يحثه عَلَى اللحاق بِهِ ، فاستوزر الخليفة المستظهر باللَّه سديد الملك أبا المعالي الفضل بْن عَبْد الرازق الأصفهانيّ . قاله صاحب المرآة .",
      "sanad_ar": "ووزر للخليفة أبو المحاسن عَبْد الجليل بْن عليّ الدهستانيّ جلال الدولة",
      "matn_ar": "فجاء كتاب بَركيَارُوق يحثه عَلَى اللحاق بِهِ ، فاستوزر الخليفة المستظهر باللَّه سديد الملك أبا المعالي الفضل بْن عَبْد الرازق الأصفهانيّ . قاله صاحب المرآة .",
