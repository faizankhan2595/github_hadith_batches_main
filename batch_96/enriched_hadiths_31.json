    {
      "hadith_id": 855464,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 4019,
      "text_ar": "وخرج الرَّكْبُ العراقيّ ومعهم لؤلؤ يَخْفُرُهم ، فاعترضهم أبو طاهر القَرْمَطِيّ ، فانهزم لؤلؤ وبه ضربات . فقتل القَرْمَطِيّ الحاجّ وسبى الحُرَم ، والتجأ الباقون إلى القادسيّة ، وتسلّلوا إلى الكوفة .",
