    {
      "hadith_id": 858633,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 7188,
      "text_ar": "وأحضر السلطان سَنْجَر محمد بْن سليمان بْن بُغْراخان ، نائب مَرْو ، وملّكه سَمَرْقَنْد ، وبعثه إليها ، وهو من أولاد الخانيّة بما وراء النّهر ، وأُمُّه ابنة السلطان ملكشاه ، وسنجر خاله ، فدفع عَنْ مملكة آبائه ، فقصد مَرْو ، وأقام بها إلى الآن ، فعظم شأنُه ، وكثرت جموعه ، إلّا أَنَّهُ انتصب لَهُ هاغوا بك ، وزاحمه في المُلْك ، وجرت لَهُ معه حروب .",
      "sanad_ar": "وأحضر السلطان سَنْجَر محمد بْن سليمان بْن بُغْراخان",
      "matn_ar": "نائب مَرْو ، وملّكه سَمَرْقَنْد ، وبعثه إليها ، وهو من أولاد الخانيّة بما وراء النّهر ، وأُمُّه ابنة السلطان ملكشاه ، وسنجر خاله ، فدفع عَنْ مملكة آبائه ، فقصد مَرْو ، وأقام بها إلى الآن ، فعظم شأنُه ، وكثرت جموعه ، إلّا أَنَّهُ انتصب لَهُ هاغوا بك ، وزاحمه في المُلْك ، وجرت لَهُ معه حروب .",
