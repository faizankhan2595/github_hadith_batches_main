    {
      "hadith_id": 857389,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 5944,
      "text_ar": "وفيها حاصر طغرلبك إصبهان ، وضيّق على أميرها قرامرز بن علاء الدّولة ، ثمّ هادنه على مالٍ يُحمل إليه ، وأن يُخطب له بأصبهان .",
      "sanad_ar": "وفيها حاصر طغرلبك إصبهان",
      "matn_ar": "وضيّق على أميرها قرامرز بن علاء الدّولة ، ثمّ هادنه على مالٍ يُحمل إليه ، وأن يُخطب له بأصبهان .",
