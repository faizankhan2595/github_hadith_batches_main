      "hadith_number": 6760,
      "text_ar": "ووصل للنظاميّة مُدرّسان ، كلّ واحدٍ معه منشورٌ بها من نظام المُلْك ، وهما أبو محمد عبد الوهّاب الشّيرازيّ ، وأبو عبد الله الطَّبَريّ ، ثمّ تقررّ الأمرُ أنّ كلّ واحدٍ يدرِّس يومًا .",
      "sanad_ar": "ووصل للنظاميّة مُدرّسان",
      "matn_ar": "كلّ واحدٍ معه منشورٌ بها من نظام المُلْك ، وهما أبو محمد عبد الوهّاب الشّيرازيّ ، وأبو عبد الله الطَّبَريّ ، ثمّ تقررّ الأمرُ أنّ كلّ واحدٍ يدرِّس يومًا .",
