    {
      "hadith_id": 859839,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8394,
      "text_ar": "وفيها تُوُفّي محمد بن الدّانشمنْد , صاحب مَلَطْيَة , فاستولى على بلاده الملك مسعود بن قلج أرسلان سليمان بن قُتُلْمش السَّلْجُوقيّ , صاحب قونية .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
