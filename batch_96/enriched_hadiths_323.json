    {
      "hadith_id": 859837,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8392,
      "text_ar": "أرسل سَنْجَر إلى السّلطان مسعود أنّ يجمع الجيش وينزل الرَّيّ , بحيث إن احتاجه طَلَبه لأجل النّكبة الماضية من التُرْك . ووصل إلى مسعود عبّاس شِحْنة الرَّيّ بعسكرٍ كثير وخدمه . ووصل إليه جماعة من الأمراء .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
