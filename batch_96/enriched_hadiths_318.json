    {
      "hadith_id": 859764,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8319,
      "text_ar": "وتزوج السّلطان بسفرى بنت دُبَيْس الأسَديّ . وسببه أنّ أولاد دُبَيْس أُقطِعت أماكنهم واحتاجوا , فجاءت بنت دُبَيْس , وأمها بنت عميد الدّولة جَهِير , وكانت بديعة الحُسن , فدخلت على خاتون زوجة المستظهر لتشفع لها إلى السّلطان , ليُعيد عليها بعض ما أُخِذ منها , فوُصِفت له , فتزوجها , وأُغلقت بغداد سبعة أيام للفرح , وضُرِبت الطُّبول , وشُرِبت الخمور ظاهرًا , وكثر الفساد .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
