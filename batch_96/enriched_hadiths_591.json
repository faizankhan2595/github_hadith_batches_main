      "chapter_id": null,
      "hadith_number": 12417,
      "text_ar": "توقُّف الخليفة عن ردّ وديعة للملك النّاصر",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
      "book": {
