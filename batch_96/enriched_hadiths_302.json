    },
    {
      "hadith_id": 859524,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8079,
      "text_ar": "وفيها وقع الخُلْف بين الفرنج بالشّام , وتحاربوا وقُتِلَ منهم , ولم يجر لهم بذلك سابقة .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
