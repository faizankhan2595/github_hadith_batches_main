    {
      "hadith_id": 859519,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8074,
      "text_ar": "خُطِب لمسعود بن محمد , بالسّلطنة ببغداد في صَفر , ومِن بعده لداود , وخُلِع عليهما وعلى الأمير آقْسُنْقُر الأحمديليّ , مقدَّم جيوش السّلطان محمود , وهو المقيم داود بعده في الملك . واستقرّ مسعود بهمذان .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
