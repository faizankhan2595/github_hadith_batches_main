    {
      "hadith_id": 860802,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 9357,
      "text_ar": "وفي رجب وصل ابن الشّهْرُزُوريُّ بتُحَفٍ وتقادُم للخليفة من نور الدّين ، وفيها حمار مخَطَّط كثوب عتابيّ ، وخرج الخلْق للفُرْجة عَلَيْهِ ، وكان فيهم رَجُل عَتّابيّ كثير الدّعَاوَى ، وهو بليد ، ناقص الفضيلة ، فقال رَجُل : إنْ كَانَ بُعِث إلينا حمارٌ عتّابيّ ، فنحن عندنا عتّابيّ حمار .",
      "sanad_ar": "وفي رجب وصل ابن الشّهْرُزُوريُّ بتُحَفٍ وتقادُم للخليفة من نور الدّين",
      "matn_ar": "وفيها حمار مخَطَّط كثوب عتابيّ ، وخرج الخلْق للفُرْجة عَلَيْهِ ، وكان فيهم رَجُل عَتّابيّ كثير الدّعَاوَى ، وهو بليد ، ناقص الفضيلة ، فقال رَجُل : إنْ كَانَ بُعِث إلينا حمارٌ عتّابيّ ، فنحن عندنا عتّابيّ حمار .",
