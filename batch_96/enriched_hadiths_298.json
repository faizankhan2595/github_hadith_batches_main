    {
      "hadith_id": 859469,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8024,
      "text_ar": "وفيها راسل زنكيّ بن آقْسُنْقُر , صاحب حلب , تاج الملوك بوري يلتمس منه إنقاذ عسكره ليحارب الفرنج , فتوثّق منه بأيْمانٍ وعُهُود , ونفّذ إلى زنكيّ خمس مائة فارس , وأرسل ولده سونج وهو على حماة أن يسير إلى زنكيّ , فأحسن ملتقاهم وأكرمهم , ثمّ عمل عليهم , وغدر بهم , وقبض على سونج وجماعة أمراء , ونهب خيامهم , وهرب الباقون .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
