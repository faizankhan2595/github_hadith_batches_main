    },
    {
      "hadith_id": 859460,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8015,
      "text_ar": "وجاءت الفرنج ونازلت دمشق , فجاء إلى بغداد في النّفير عبد الوهّاب الواعظ الحنبليّ , ومعه جماعة من التّجّار , وَهَمُّوا بكسر المنبر فوُعِدوا بأن ينفّذ إلى السّلطان في ذلك . وتناخى عسكر دمشق , والعرب , والتُّركُمان , فكبسوا الفرنج , وثبت الفريقان , ونصر الله دينه فقُتل من الفرنج خلْق , وأُسِر منهم ثلاث مائة , وراحوا بشَرّ خَيْبَة , ولله الحمد .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
