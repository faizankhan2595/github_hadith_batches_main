    {
      "hadith_id": 863103,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 11658,
      "text_ar": "وفيها وقع بين الكامل والأشرف ، لأنَّ الأشرف طَلَبَ من أخيه الرَّقَّة فامتنع ، وأرسلَ إِلَيْهِ عشرة آلاف دينارٍ عِوَضها ، فردَّها . فغضبَ الكاملُ وقال : يكفيه عِشْرَتُه للمغاني ، فتنمَّر الأشرفُ ، وبعثَ إلى حلب والشّرق ، فاتفَّقوا معه . وأمّا الكاملُ فإنّه خافَ ومضى إلى مصر ، فلمّا دخل باسَ الأرض شكرًا ، وقال : رأيتُ روحي فِي قلعتي . أنبأني بذلك سعدُ الدّين : أنّ ابن عمّه فخر الدّين حكي لَهُ ذَلِكَ .",
      "sanad_ar": "وفيها وقع بين الكامل والأشرف",
      "matn_ar": "لأنَّ الأشرف طَلَبَ من أخيه الرَّقَّة فامتنع ، وأرسلَ إِلَيْهِ عشرة آلاف دينارٍ عِوَضها ، فردَّها . فغضبَ الكاملُ وقال : يكفيه عِشْرَتُه للمغاني ، فتنمَّر الأشرفُ ، وبعثَ إلى حلب والشّرق ، فاتفَّقوا معه . وأمّا الكاملُ فإنّه خافَ ومضى إلى مصر ، فلمّا دخل باسَ الأرض شكرًا ، وقال : رأيتُ روحي فِي قلعتي . أنبأني بذلك سعدُ الدّين : أنّ ابن عمّه فخر الدّين حكي لَهُ ذَلِكَ .",
