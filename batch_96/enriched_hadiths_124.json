    {
      "hadith_id": 856857,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 5412,
      "text_ar": "ثمّ إنّ الْجُنْد عدلوا إلى المُلْك أَبِي كاليجار ونوّهوا باسمه ، وكان وليّ عصر أَبِيهِ سلطان الدّولة الّذي استخلفه بهاء الدّولة عليهم فخُطب لهذا ببغداد ، وكُوتب جلال الدّولة بِذَلِك ، فأصعد مِن واسط .",
      "sanad_ar": "ثمّ إنّ الْجُنْد عدلوا إلى المُلْك أَبِي كاليجار ونوّهوا باسمه",
      "matn_ar": "وكان وليّ عصر أَبِيهِ سلطان الدّولة الّذي استخلفه بهاء الدّولة عليهم فخُطب لهذا ببغداد ، وكُوتب جلال الدّولة بِذَلِك ، فأصعد مِن واسط .",
