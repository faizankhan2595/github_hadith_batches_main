      "hadith_number": 8066,
      "text_ar": "وفيها وَزَر أنُوشُرْوان بن خالد , للمسترشد بعد تمنُّع , واستعفى .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
