    {
      "hadith_id": 859512,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8067,
      "text_ar": "وعاد دُبَيْس بعد الهزيمة يلوذ ببلاده , فجمع وحشد . وكانت الحِلَّة وأعمالها في يد إقبال المسترشديّ وأُمِدَّ بعسكرٍ من بغداد , فهزم دُبَيْس , وحصل دُبَيْس في أَجَمة فيها ماء وقصب ثلاثة أيّام , لَا يأكل شيئًا , حتّى أخرجه جمّاس على ظهره وخلّصه .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
