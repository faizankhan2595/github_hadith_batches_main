    {
      "hadith_id": 859509,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8064,
      "text_ar": "وتملّك دمشق شمس الملوك بعد أبيه تاج الملوك بوري بن طُغتِكين , فقام بالأمر , وخافَتْه الفرنج , ومهّد الأمور , وأبطل بعض المظالم , وفرح النّاس بشهامته , وفَرْط شجاعته , واحتملوا ظُلْمه .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
