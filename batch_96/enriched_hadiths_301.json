      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 8065,
      "text_ar": "وفيها كانت وقعة بهَمَذان , بين طُغْرُل بن محمد , وبين داود بن محمود بن محمد , فانتصر طُغْرُل .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
