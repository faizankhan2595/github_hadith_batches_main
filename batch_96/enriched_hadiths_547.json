    {
      "hadith_id": 863198,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 11753,
      "text_ar": "وفيها جاء الملكُ الجواد والصالح بْن شيرْكُوه صاحبُ حمص ومعهم جيش من الخُوارزميّة ، وقصدوا حلب ، فنازلوا بُزاعة فِي خمسَة آلاف فارس ، فخرج إليهم عسكرُ حلب فِي ألفٍ وخمس مائة فارس ، فكسروا عسكر حلب ، وقتلوا ، وأسروا ، وقربوا إلى حَيْلان وقطعوا الماء عن حلب . ثمّ ردُّوا فنهبوا مَنْبِجَ ، وقتلوا أهلَها ، ولهذا عُمل المَصافُّ عَلَى حرَّان .",
      "sanad_ar": "وفيها جاء الملكُ الجواد والصالح بْن شيرْكُوه صاحبُ حمص ومعهم جيش من الخُوارزميّة",
      "matn_ar": "وقصدوا حلب ، فنازلوا بُزاعة فِي خمسَة آلاف فارس ، فخرج إليهم عسكرُ حلب فِي ألفٍ وخمس مائة فارس ، فكسروا عسكر حلب ، وقتلوا ، وأسروا ، وقربوا إلى حَيْلان وقطعوا الماء عن حلب . ثمّ ردُّوا فنهبوا مَنْبِجَ ، وقتلوا أهلَها ، ولهذا عُمل المَصافُّ عَلَى حرَّان .",
