    {
      "hadith_id": 861614,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 10169,
      "text_ar": "وتُوُفّي السّلطان صلاح الدّين ، فوصل إلى بغداد فِي رمضان الرَّسُول وَفِي صُحبته لأْمَة الحرب التي لصلاح الدّين وفَرَسه ودينار واحد وستة وثلاثون درهمًا ، لَمْ يخلف منَ المال سواها ، وصُحبة ذَلِكَ صليب منَ الذهب الأحمر كَانَ قَدْ أخذه منَ القدس .",
      "sanad_ar": "وتُوُفّي السّلطان صلاح الدّين",
      "matn_ar": "فوصل إلى بغداد فِي رمضان الرَّسُول وَفِي صُحبته لأْمَة الحرب التي لصلاح الدّين وفَرَسه ودينار واحد وستة وثلاثون درهمًا ، لَمْ يخلف منَ المال سواها ، وصُحبة ذَلِكَ صليب منَ الذهب الأحمر كَانَ قَدْ أخذه منَ القدس .",
