    {
      "hadith_id": 857601,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 6156,
      "text_ar": "في ذي القعدة فرغت المدرسة النّظاميّة ، وقُرّر لتدريسها الشّيخ أبو إسحاق ، فاجتمع النّاس ، فلم يحضر ، وسببه أنّه لقيه صبيٌّ ، فقال : كيف تُدرِّس في مكان مغصوب ؟ فتشكّك ، واختفى ، فلما أيِسُوا من حضوره درَّس ابن الصبَّاغ مصنَّف الشَّامل ، فلما بلغ نظامَ المُلْك الخبر أقام القيامة على العميد أبي سعْد ، فلم يزل أبو سعد يرفق بالشّيخ أبي إسحاق حتَّى درَّس ، فكانت مدّة تدريسه ، أي ابن الصّباغ ، عشرين يومًا .",
      "sanad_ar": "في ذي القعدة فرغت المدرسة النّظاميّة",
      "matn_ar": "وقُرّر لتدريسها الشّيخ أبو إسحاق ، فاجتمع النّاس ، فلم يحضر ، وسببه أنّه لقيه صبيٌّ ، فقال : كيف تُدرِّس في مكان مغصوب ؟ فتشكّك ، واختفى ، فلما أيِسُوا من حضوره درَّس ابن الصبَّاغ مصنَّف الشَّامل ، فلما بلغ نظامَ المُلْك الخبر أقام القيامة على العميد أبي سعْد ، فلم يزل أبو سعد يرفق بالشّيخ أبي إسحاق حتَّى درَّس ، فكانت مدّة تدريسه ، أي ابن الصّباغ ، عشرين يومًا .",
