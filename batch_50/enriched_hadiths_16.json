      "hadith_id": 441230,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 1507,
      "text_ar": "قَرَأْتُ عَلَى /94 مُحَمَّدِ بْنِ الْفَضْلِ /94 ، ثنا /26 مُحَمَّدُ بْنُ عَلِيٍّ /26 ، ثنا /26 مُحَمَّدُ بْنُ مُزَاحِمٍ /26 ، عَنْ /26 بُكَيْرِ بْنِ مَعْرُوفٍ /26 ، /27 عَنْ /26 مُقَاتِلِ بْنِ حَيَّانَ /26 ، \" قَوْلُهُ : /20 /4 عَذَابٌ مُهِينٌ سورة البقرة آية 90 /4 يَعْنِي بِالْمُهِينَ الْهَوَانَ \" /27 *",
      "sanad_ar": "قَرَأْتُ عَلَى /94 مُحَمَّدِ بْنِ الْفَضْلِ /94",
      "matn_ar": "ثنا /26 مُحَمَّدُ بْنُ عَلِيٍّ /26 ، ثنا /26 مُحَمَّدُ بْنُ مُزَاحِمٍ /26 ، عَنْ /26 بُكَيْرِ بْنِ مَعْرُوفٍ /26 ، /27 عَنْ /26 مُقَاتِلِ بْنِ حَيَّانَ /26 ، \" قَوْلُهُ : /20 /4 عَذَابٌ مُهِينٌ سورة البقرة آية 90 /4 يَعْنِي بِالْمُهِينَ الْهَوَانَ \" /27 *",
