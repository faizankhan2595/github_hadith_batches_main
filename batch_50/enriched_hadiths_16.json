      "hadith_id": 441228,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 1505,
      "text_ar": "حَدَّثَنَا /94 أَبُو زُرْعَةَ /94 ، ثنا /26 عَمْرُو بْنُ حَمَّادٍ /26 ، ثنا /26 أَسْبَاطٌ /26 ، /27 عَنِ /26 السُّدِّيِّ /26 : \" /20 /4 فَبَاءُوا بِغَضَبٍ عَلَى غَضَبٍ سورة البقرة آية 90 /4 أَمَّا الْغَضَبُ الأَوَّلُ : فَهُوَ حِينَ غَضِبَ عَلَيْهِمْ فِي الْعِجْلِ ، وَأَمَّا الْغَضَبُ الثَّانِي : فَغَضِبَ عَلَيْهِمْ حِينَ كَفَرُوا بِمُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" /27 *",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو زُرْعَةَ /94",
      "matn_ar": "ثنا /26 عَمْرُو بْنُ حَمَّادٍ /26 ، ثنا /26 أَسْبَاطٌ /26 ، /27 عَنِ /26 السُّدِّيِّ /26 : \" /20 /4 فَبَاءُوا بِغَضَبٍ عَلَى غَضَبٍ سورة البقرة آية 90 /4 أَمَّا الْغَضَبُ الأَوَّلُ : فَهُوَ حِينَ غَضِبَ عَلَيْهِمْ فِي الْعِجْلِ ، وَأَمَّا الْغَضَبُ الثَّانِي : فَغَضِبَ عَلَيْهِمْ حِينَ كَفَرُوا بِمُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" /27 *",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/94,/94,/26,/26,/26,/26,/27,/26,/26,/20,/4,/4,/27",
