      "chapter_id": null,
      "hadith_number": 1503,
      "text_ar": "حَدَّثَنَا /94 أَبُو زُرْعَةَ /94 ، ثنا /26 يَحْيَى بْنُ عَبْدِ اللَّهِ بْنِ بُكَيْرٍ /26 ، حَدَّثَنِي /26 عَبْدُ اللَّهِ بْنُ لَهِيعَةَ /26 ، حَدَّثَنِي /26 عَطَاءُ بْنُ دِينَارٍ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، \" فِي قَوْلِ اللَّهِ : /20 /4 فَبَاءُوا بِغَضَبٍ عَلَى غَضَبٍ سورة البقرة آية 90 /4 ، يَقُولُ : اسْتَوْجَبُوا سُخْطاً عَلَى سُخْطٍ \" /27 * \r\n\u001fE178",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو زُرْعَةَ /94",
      "matn_ar": "ثنا /26 يَحْيَى بْنُ عَبْدِ اللَّهِ بْنِ بُكَيْرٍ /26 ، حَدَّثَنِي /26 عَبْدُ اللَّهِ بْنُ لَهِيعَةَ /26 ، حَدَّثَنِي /26 عَطَاءُ بْنُ دِينَارٍ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، \" فِي قَوْلِ اللَّهِ : /20 /4 فَبَاءُوا بِغَضَبٍ عَلَى غَضَبٍ سورة البقرة آية 90 /4 ، يَقُولُ : اسْتَوْجَبُوا سُخْطاً عَلَى سُخْطٍ \" /27 * \r\n\u001fE178",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/94,/94,/26,/26,/26,/26,/26,/26,/27,/26,/26,/20,/4,/4,/27",
