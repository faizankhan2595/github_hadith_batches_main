      "hadith_id": 448323,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 8600,
      "text_ar": "حَدَّثَنَا /94 أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ الأَوْدِيُّ /94 ، ثنا /26 أَحْمَدُ بْنُ مُفَضَّلٍ /26 ، ثنا /26 أَسْبَاطٌ /26 ، /27 عَنِ /26 السُّدِّيِّ /26 قَوْلَهُ : \" /20 /4 فَانْكِحُوهُنَّ بِإِذْنِ أَهْلِهِنَّ سورة النساء آية 25 /4 قَالَ : فَلْتُنْكَحِ الأَمَةُ بِإِذْنِ أَهْلِهَا \" /27 . وَرُوِيَ عَنِ مُقَاتِلِ بْنِ حَيَّانَ نَحْوُ ذَلِكَ *",
      "sanad_ar": "حَدَّثَنَا /94 أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ الأَوْدِيُّ /94",
      "matn_ar": "ثنا /26 أَحْمَدُ بْنُ مُفَضَّلٍ /26 ، ثنا /26 أَسْبَاطٌ /26 ، /27 عَنِ /26 السُّدِّيِّ /26 قَوْلَهُ : \" /20 /4 فَانْكِحُوهُنَّ بِإِذْنِ أَهْلِهِنَّ سورة النساء آية 25 /4 قَالَ : فَلْتُنْكَحِ الأَمَةُ بِإِذْنِ أَهْلِهَا \" /27 . وَرُوِيَ عَنِ مُقَاتِلِ بْنِ حَيَّانَ نَحْوُ ذَلِكَ *",
      "grade": null,
