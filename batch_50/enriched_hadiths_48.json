      "chapter_id": null,
      "hadith_number": 1986,
      "text_ar": "حَدَّثَنَا /94 أَبُو سَعِيدٍ الأَشَجُّ /94 ، ثنا /26 ابْنُ نُمَيْرٍ /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ مُسْلِمِ بْنِ هُرْمُزَ /26 ، /27 عَنْ /26 مُجَاهِدٍ /26 ، /26 وَسَعِيدِ بْنِ جُبَيْرٍ /26 \" /20 /4 طَهِّرَا بَيْتِيَ لِلطَّائِفِينَ سورة البقرة آية 125 /4 ، أَنَّ ذَلِكَ مِنَ الأَوْثَانِ وَالرِّيَبِ ، وَقَوْلِ الزُّورِ وَالرِّجْسِ \" /27 * \r\n@ 1 : 228 @ \r\n$1203  1203 /8",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو سَعِيدٍ الأَشَجُّ /94",
      "matn_ar": "ثنا /26 ابْنُ نُمَيْرٍ /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ مُسْلِمِ بْنِ هُرْمُزَ /26 ، /27 عَنْ /26 مُجَاهِدٍ /26 ، /26 وَسَعِيدِ بْنِ جُبَيْرٍ /26 \" /20 /4 طَهِّرَا بَيْتِيَ لِلطَّائِفِينَ سورة البقرة آية 125 /4 ، أَنَّ ذَلِكَ مِنَ الأَوْثَانِ وَالرِّيَبِ ، وَقَوْلِ الزُّورِ وَالرِّجْسِ \" /27 * \r\n@ 1 : 228 @ \r\n$1203  1203 /8",
      "grade": null,
