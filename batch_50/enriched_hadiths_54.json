      "hadith_id": 441797,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 2074,
      "text_ar": "حَدَّثَنَا /94 أَبُو سَعِيدٍ الأَشَجُّ /94 ، /94 وَالْحَسَنُ بْنُ مُحَمَّدِ بْنِ الصَّبَّاحِ /94 ، قَالا : ثنا /26 أَسْبَاطُ بْنُ مُحَمَّدٍ /26 ، عَنِ /26 الْهُذَلِيِّ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، \" فِي قَوْلِهِ : /20 /4 وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ سورة البقرة آية 129 /4 ، قَالَ : الْحِكْمَةُ حِكْمَةُ السُّنَّةِ \" /27 ، وَرُوِيَ عَنْ أَبِي مَالِكٍ ، وَمُقَاتِلِ بْنِ حَيَّانَ ، وَقَتَادَةَ ، وَيَحْيَى بْنِ أَبِي كَثِيرٍ نَحْوُ ذَلِكَ *",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو سَعِيدٍ الأَشَجُّ /94",
      "matn_ar": "/94 وَالْحَسَنُ بْنُ مُحَمَّدِ بْنِ الصَّبَّاحِ /94 ، قَالا : ثنا /26 أَسْبَاطُ بْنُ مُحَمَّدٍ /26 ، عَنِ /26 الْهُذَلِيِّ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، \" فِي قَوْلِهِ : /20 /4 وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ سورة البقرة آية 129 /4 ، قَالَ : الْحِكْمَةُ حِكْمَةُ السُّنَّةِ \" /27 ، وَرُوِيَ عَنْ أَبِي مَالِكٍ ، وَمُقَاتِلِ بْنِ حَيَّانَ ، وَقَتَادَةَ ، وَيَحْيَى بْنِ أَبِي كَثِيرٍ نَحْوُ ذَلِكَ *",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/94,/94,/94,/94,/26,/26,/26,/26,/27,/26,/26,/20,/4,/4,/27",
