      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 4375,
      "text_ar": "أَخْبَرَنَا /94 مُحَمَّدُ بْنُ سَعْدِ بْنِ عَطِيَّةَ /94 ، فِيمَا كَتَبَ إِلَيَّ ، حَدَّثَنِي /26 أَبِي /26 ، حَدَّثَنِي /26 عَمِّي /26 ، حَدَّثَنِي /26 أَبِي /26 ، عَنْ /26 أَبِيهِ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 : \" /20 /4 يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ سورة البقرة آية 255 /4 يقول : \" يَعْلَمُ مَا قَدَّمُوا مِنْ أَعْمَالِهِمْ \" /27 * \r\n$E534",
