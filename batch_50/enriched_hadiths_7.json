      "hadith_id": 441094,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 1371,
      "text_ar": "حَدَّثَنَا /94 عَلِيُّ بْنُ الْحَسيَنِ /94 ، ثنا /26 أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ يَعْنِي الدَّشْتَكِيَّ /26 ، حَدَّثَنِي /26 أَبِي /26 ، عَنْ /26 أَبِيهِ /26 ، عَنِ /26 الأَشْعَثِ /26 ، عَنْ /26 جَعْفَرٍ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، \" فِي قَوْلِهِ : /20 /4 وَقُولُوا لِلنَّاسِ حُسْنًا سورة البقرة آية 83 /4 ، قَالَ : الأَمْرُ بِالْمَعْرُوفِ وَالنَّهْيُ عَنِ الْمُنْكَرِ \" /27 *",
      "sanad_ar": "حَدَّثَنَا /94 عَلِيُّ بْنُ الْحَسيَنِ /94",
      "matn_ar": "ثنا /26 أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ يَعْنِي الدَّشْتَكِيَّ /26 ، حَدَّثَنِي /26 أَبِي /26 ، عَنْ /26 أَبِيهِ /26 ، عَنِ /26 الأَشْعَثِ /26 ، عَنْ /26 جَعْفَرٍ /26 ، عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، \" فِي قَوْلِهِ : /20 /4 وَقُولُوا لِلنَّاسِ حُسْنًا سورة البقرة آية 83 /4 ، قَالَ : الأَمْرُ بِالْمَعْرُوفِ وَالنَّهْيُ عَنِ الْمُنْكَرِ \" /27 *",
