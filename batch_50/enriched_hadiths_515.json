    {
      "hadith_id": 448712,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 8989,
      "text_ar": "ذَكَرَهُ /26 أَبِي /26 ، ثنا /26 ابْنُ مَيْسَرَةَ /26 ، ثنا /26 صَالِحُ بْنُ أَبِي خَالِدٍ /26 ، وَأَخْبَرَنِي /26 عُثْمَانُ بْنُ زَائِدَةَ /26 ، قَالَ : /27 سَمِعْتُ /26 وُهَيْبَ بْنَ وَرْدٍ /26 ، يَقُولُ : قَالَ اللَّهُ عَزَّ وَجَلَّ : \" /20 ابْنَ آدَمَ اذْكُرْنِي إِذَا غَضِبْتَ أَذْكُرُكَ إِذَا غَضِبْتُ ، فَلا أُمْحِقُكَ فِيمَنْ أَمْحَقُ ، وَإِذَا ظُلِمْتَ فَاصْبِرْ ، وَارْضَ بِنُصْرَتِي ، فَإِنَّ نَصْرِي لَكَ خَيْرٌ مِنْ نُصْرَتِكَ لِنَفْسِكَ \" /27 *",
      "sanad_ar": "ذَكَرَهُ /26 أَبِي /26",
      "matn_ar": "ثنا /26 ابْنُ مَيْسَرَةَ /26 ، ثنا /26 صَالِحُ بْنُ أَبِي خَالِدٍ /26 ، وَأَخْبَرَنِي /26 عُثْمَانُ بْنُ زَائِدَةَ /26 ، قَالَ : /27 سَمِعْتُ /26 وُهَيْبَ بْنَ وَرْدٍ /26 ، يَقُولُ : قَالَ اللَّهُ عَزَّ وَجَلَّ : \" /20 ابْنَ آدَمَ اذْكُرْنِي إِذَا غَضِبْتَ أَذْكُرُكَ إِذَا غَضِبْتُ ، فَلا أُمْحِقُكَ فِيمَنْ أَمْحَقُ ، وَإِذَا ظُلِمْتَ فَاصْبِرْ ، وَارْضَ بِنُصْرَتِي ، فَإِنَّ نَصْرِي لَكَ خَيْرٌ مِنْ نُصْرَتِكَ لِنَفْسِكَ \" /27 *",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/26,/26,/26,/26,/26,/26,/26,/26,/27,/26,/26,/20,/27",
