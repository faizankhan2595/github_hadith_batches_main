      "hadith_id": 442907,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 3184,
      "text_ar": "حَدَّثَنَا /94 أَبُو زُرْعَةَ /94 ، ثنا /26 أَبُو الأَحْوَصِ مُحَمَّدُ بْنُ حَيَّانَ /26 ، أَخْبَرَنِي /26 عَبَّادُ بْنُ الْعَوَّامِ /26 ، أَخْبَرَنِي /26 هِشَامٌ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، فِي قَوْلِهِ : \" /20 /4 رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً سورة البقرة آية 201 /4 , قَالَ : الْحَسَنَةُ فِي الدُّنْيَا : الْعِلْمُ وَالْعِبَادَةُ \" /27 * \r\n$1917  1917 /8",
      "sanad_ar": "حَدَّثَنَا /94 أَبُو زُرْعَةَ /94",
      "matn_ar": "ثنا /26 أَبُو الأَحْوَصِ مُحَمَّدُ بْنُ حَيَّانَ /26 ، أَخْبَرَنِي /26 عَبَّادُ بْنُ الْعَوَّامِ /26 ، أَخْبَرَنِي /26 هِشَامٌ /26 ، /27 عَنِ /26 الْحَسَنِ /26 ، فِي قَوْلِهِ : \" /20 /4 رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً سورة البقرة آية 201 /4 , قَالَ : الْحَسَنَةُ فِي الدُّنْيَا : الْعِلْمُ وَالْعِبَادَةُ \" /27 * \r\n$1917  1917 /8",
      "grade": null,
      "page_number": null,
