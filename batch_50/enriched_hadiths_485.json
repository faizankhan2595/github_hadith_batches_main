      "hadith_id": 448262,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 8539,
      "text_ar": "أَخْبَرَنَا /94 مُحَمَّدُ بْنُ سَعْدٍ الْعَوْفِيُّ /94 فِيمَا كَتَبَ إِلَيَّ ، حَدَّثَنِي /26 أَبِي /26 ، حَدَّثَنِي /26 عَمِّي /26 ، حَدَّثَنِي /26 أَبِي /26 ، عَنْ /26 أَبِيهِ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 قَوْلَهُ : \" /20 /4 إِلا مَا مَلَكَتْ أَيْمَانُكُمْ سورة النساء آية 24 /4 يَعْنِي : الَّتِي أُحَلَّ لَكَ مِنَ النِّسَاءِ ، وَهُوَ مَا أُحِلَّ مِنْ حَرَائِرِ النِّسَاءِ مَثْنَى وَثُلاثَ وَرُبَاعَ \" /27 * \r\n\u001eE1019",
      "sanad_ar": "أَخْبَرَنَا /94 مُحَمَّدُ بْنُ سَعْدٍ الْعَوْفِيُّ /94 فِيمَا كَتَبَ إِلَيَّ",
      "matn_ar": "حَدَّثَنِي /26 أَبِي /26 ، حَدَّثَنِي /26 عَمِّي /26 ، حَدَّثَنِي /26 أَبِي /26 ، عَنْ /26 أَبِيهِ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 قَوْلَهُ : \" /20 /4 إِلا مَا مَلَكَتْ أَيْمَانُكُمْ سورة النساء آية 24 /4 يَعْنِي : الَّتِي أُحَلَّ لَكَ مِنَ النِّسَاءِ ، وَهُوَ مَا أُحِلَّ مِنْ حَرَائِرِ النِّسَاءِ مَثْنَى وَثُلاثَ وَرُبَاعَ \" /27 * \r\n\u001eE1019",
      "grade": null,
