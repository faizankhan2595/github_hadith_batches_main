    {
      "hadith_id": 448428,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 8705,
      "text_ar": "حَدَّثَنَا /94 الْحَسَنُ بْنُ مُحَمَّدٍ الصَّبَّاحِ /94 ، ثنا /26 إِسْمَاعِيلُ بْنُ عُلَيَّةَ /26 ، عَنْ /26 خَالِدٍ الْحَذَّاءِ /26 ، عَنْ /26 حُمَيْدِ بْنِ هِلالٍ /26 ، عَنْ /26 أَبِي قَتَادَةَ /26 يَعْنِي الْعَدَوِيَّ قَالَ : /27 قُرِئَ عَلَيْنَا كِتَابُ /26 مَعْمَرٍ /26 : \" /20 مِنَ الْكَبَائِرِ جَمْعٌ بَيْنَ الصَّلاتَيْنِ ، يَعْنِي : مِنْ غَيْرِ عُذْرٍ \" /27 * \r\n@ 3 : 933 @",
      "sanad_ar": "حَدَّثَنَا /94 الْحَسَنُ بْنُ مُحَمَّدٍ الصَّبَّاحِ /94",
      "matn_ar": "ثنا /26 إِسْمَاعِيلُ بْنُ عُلَيَّةَ /26 ، عَنْ /26 خَالِدٍ الْحَذَّاءِ /26 ، عَنْ /26 حُمَيْدِ بْنِ هِلالٍ /26 ، عَنْ /26 أَبِي قَتَادَةَ /26 يَعْنِي الْعَدَوِيَّ قَالَ : /27 قُرِئَ عَلَيْنَا كِتَابُ /26 مَعْمَرٍ /26 : \" /20 مِنَ الْكَبَائِرِ جَمْعٌ بَيْنَ الصَّلاتَيْنِ ، يَعْنِي : مِنْ غَيْرِ عُذْرٍ \" /27 * \r\n@ 3 : 933 @",
