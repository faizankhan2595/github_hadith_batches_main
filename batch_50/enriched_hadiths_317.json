    {
      "hadith_id": 445745,
      "book_id": 390,
      "chapter_id": null,
      "hadith_number": 6022,
      "text_ar": "حَدَّثَنَا /94 أَبِي /94 ، ثنا /26 ابْنُ الطَّبَّاعِ /26 ، ثنا /26 إِسْمَاعِيلُ بْنُ عُلَيَّةَ /26 ، عَنْ /26 رَوْحِ بْنِ الْقَاسِمِ /26 ، /27 عَنْ /26 قَتَادَةَ /26 ، قَالَ : \" /20 /4 الْحَوَارِيُّونَ سورة آل عمران آية 52 /4 هُمُ الَّذِينَ تَصْلُحُ لَهُمُ الْخِلافَةُ \" /27 * \r\n@ 2 : 660 @",
