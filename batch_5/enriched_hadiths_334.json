    {
      "hadith_id": 41003,
      "book_id": 53,
      "chapter_id": null,
      "hadith_number": 4073,
      "text_ar": "هَذَا الكافر /4 وَمِنْهُمْ مُقْتَصِدٌ سورة فاطر آية 32 /4 فهؤلاء أصحاب اليمين /4 وَمِنْهُمْ سَابِقٌ بِالْخَيْرَاتِ سورة فاطر آية 32 /4 وهذه موافقٌ تفسيرها تفسير التي فِي الواقعة : /4 فَأَصْحَابُ الْمَيْمَنَةِ سورة الواقعة آية 8 /4 هم   @ 2 : 370 @    المقتصدون ، ويُقال : هم الولْدان ، /4 وَأَصْحَابُ الْمَشْأَمَةِ سورة الواقعة آية 9 /4 الكفار ، والمشأمة : النار ، /4 وَالسَّابِقُونَ السَّابِقُونَ سورة الواقعة آية 10 /4 هَؤُلَاءِ أهل الدرجات الْعُلَى ، /4 أُولَئِكَ الْمُقَرَّبُونَ سورة الواقعة آية 11 /4 فِي جناتِ عَدْنٍ . قوله : \" جَنَّاتُ عَدنٍ \" ومعنى عدنٍ : إقامة بِهِ ، عَدَن بالموضع .",
      "sanad_ar": "هَذَا الكافر /4 وَمِنْهُمْ مُقْتَصِدٌ سورة فاطر آية 32 /4 فهؤلاء أصحاب اليمين /4 وَمِنْهُمْ سَابِقٌ بِالْخَيْرَاتِ سورة فاطر آية 32 /4 وهذه موافقٌ تفسيرها تفسير التي فِي الواقعة",
      "matn_ar": "/4 فَأَصْحَابُ الْمَيْمَنَةِ سورة الواقعة آية 8 /4 هم   @ 2 : 370 @    المقتصدون ، ويُقال : هم الولْدان ، /4 وَأَصْحَابُ الْمَشْأَمَةِ سورة الواقعة آية 9 /4 الكفار ، والمشأمة : النار ، /4 وَالسَّابِقُونَ السَّابِقُونَ سورة الواقعة آية 10 /4 هَؤُلَاءِ أهل الدرجات الْعُلَى ، /4 أُولَئِكَ الْمُقَرَّبُونَ سورة الواقعة آية 11 /4 فِي جناتِ عَدْنٍ . قوله : \" جَنَّاتُ عَدنٍ \" ومعنى عدنٍ : إقامة بِهِ ، عَدَن بالموضع .",
