      "hadith_id": 42711,
      "book_id": 53,
      "chapter_id": null,
      "hadith_number": 5781,
      "text_ar": ". والهلوع : الضجور وصفته كما قَالَ اللَّه : /4 إِذَا مَسَّهُ الشَّرُّ جَزُوعًا سورة المعارج آية 20 /4 /4 وَإِذَا مَسَّهُ الْخَيْرُ مَنُوعًا سورة المعارج آية 21 /4 فهذه صفة الهلوع ، وَيُقَال مِنْهُ : هِلع يهلَع هلَعًا مثل : جزِع يجزع جزعًا ، ثُمَّ قَالَ : /4 إِلا الْمُصَلِّينَ { 22 } الَّذِينَ سورة المعارج آية 22-23 /4 فاستثنى المصلين من الْإِنْسَان ، لأن الْإِنْسَان فِي مذهب جمع ، كما قَالَ اللَّه جل وعز : /4 إِنَّ الإِنْسَانَ لَفِي خُسْرٍ { 2 } إِلا الَّذِينَ آمَنُوا سورة العصر آية 2-3 /4 .\u001dE628",
      "sanad_ar": ". والهلوع",
      "matn_ar": "الضجور وصفته كما قَالَ اللَّه : /4 إِذَا مَسَّهُ الشَّرُّ جَزُوعًا سورة المعارج آية 20 /4 /4 وَإِذَا مَسَّهُ الْخَيْرُ مَنُوعًا سورة المعارج آية 21 /4 فهذه صفة الهلوع ، وَيُقَال مِنْهُ : هِلع يهلَع هلَعًا مثل : جزِع يجزع جزعًا ، ثُمَّ قَالَ : /4 إِلا الْمُصَلِّينَ { 22 } الَّذِينَ سورة المعارج آية 22-23 /4 فاستثنى المصلين من الْإِنْسَان ، لأن الْإِنْسَان فِي مذهب جمع ، كما قَالَ اللَّه جل وعز : /4 إِنَّ الإِنْسَانَ لَفِي خُسْرٍ { 2 } إِلا الَّذِينَ آمَنُوا سورة العصر آية 2-3 /4 .\u001dE628",
