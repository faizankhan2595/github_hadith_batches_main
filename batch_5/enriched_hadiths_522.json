    {
      "hadith_id": 43819,
      "book_id": 58,
      "chapter_id": null,
      "hadith_number": 192,
      "text_ar": "أنا /94 جَعْفَرُ بْنُ سُلَيْمَانَ L2151 /94 ، ثنا /26 عَوْفٌ L6256 /26 ، عَنْ /26 زِيَادِ بْنِ الْحُصَيْنِ L3071 /26 ، عَنْ /26 أَبِي الْعَالِيَةِ L2949 /26 ، قَالَ : سَمِعْتُ /26 ابْنَ عَبَّاسٍ L4883 /26 ، يَقُولُ : /27 حَدَّثَنِي /93 الْفَضْلُ بْنُ الْعَبَّاسِ L1543 /93 ، قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 يَوْمَ النَّحْرِ : \" هَاتِ ، وَالْقُطْ لِي حَصًى ، فَقُلْتُ : حَصَيَاتٌ مِثْلُ حَصَى الْحَذَفِ ، فَوَضَعْتُهُنَّ بَيْنَ يَدَيْهِ ، فَقَالَ : بِأَمْثَالِ هَؤُلاءِ وَإِيَّاكُمْ وَالْغُلُوَّ ، فَإِنَّمَا أَهْلَكَ مَنْ كَانَ قَبْلَكُمُ الْغُلُوُّ فِي الدِّينِ \" /27 * \r\n$176  176 /3",
      "sanad_ar": "أنا /94 جَعْفَرُ بْنُ سُلَيْمَانَ L2151 /94",
      "matn_ar": "ثنا /26 عَوْفٌ L6256 /26 ، عَنْ /26 زِيَادِ بْنِ الْحُصَيْنِ L3071 /26 ، عَنْ /26 أَبِي الْعَالِيَةِ L2949 /26 ، قَالَ : سَمِعْتُ /26 ابْنَ عَبَّاسٍ L4883 /26 ، يَقُولُ : /27 حَدَّثَنِي /93 الْفَضْلُ بْنُ الْعَبَّاسِ L1543 /93 ، قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 يَوْمَ النَّحْرِ : \" هَاتِ ، وَالْقُطْ لِي حَصًى ، فَقُلْتُ : حَصَيَاتٌ مِثْلُ حَصَى الْحَذَفِ ، فَوَضَعْتُهُنَّ بَيْنَ يَدَيْهِ ، فَقَالَ : بِأَمْثَالِ هَؤُلاءِ وَإِيَّاكُمْ وَالْغُلُوَّ ، فَإِنَّمَا أَهْلَكَ مَنْ كَانَ قَبْلَكُمُ الْغُلُوُّ فِي الدِّينِ \" /27 * \r\n$176  176 /3",
