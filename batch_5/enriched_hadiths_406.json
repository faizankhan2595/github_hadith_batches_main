    {
      "hadith_id": 42089,
      "book_id": 53,
      "chapter_id": null,
      "hadith_number": 5159,
      "text_ar": "قراءة النَّاس \" وأنَّ \" ، ولو قُرئ \" إِنّ \" بالكسر عَلَى الاستئناف كانَ صوابًا . @ حدثني الحسنُ بْن عياشٍ ، عَنِ الْأَعْمَش ، عنْ إِبْرَاهِيم ، عنْ علقمة بْن قيس : أَنَّهُ قَرَأَ ما فِي النجم ، وما فِي الجنّ ، \" وأنّ \" بفتح \" إنّ \" . # @ حدثني قيسٌ ، عَنِ الْأَعْمَش ، عنْ إِبْرَاهِيم ، عنْ علقمة بمثلِ ذَلِكَ . #",
      "sanad_ar": "قراءة النَّاس \" وأنَّ \"",
