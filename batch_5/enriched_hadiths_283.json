    {
      "hadith_id": 40242,
      "book_id": 53,
      "chapter_id": null,
      "hadith_number": 3312,
      "text_ar": "ويقرأ : \" تَشَّقَّقُ \" بالتشديد ، وقرأها الأعمش وَعَاصِم : /4 تَشَقَّقُ السَّمَاءُ سورة الفرقان آية 25 /4 بتخفيف الشِّين ، فمن قَرَأ \" تَشَّقق \" أراد تتشقق بتشديد الشِّين والقاف فأدغم كما قَالَ : /4 لا يَسَّمَّعُونَ إِلَى الْمَلإِ الأَعْلَى سورة الصافات آية 8 /4 ، ومعناهُ ، فيما ذكروا : تشُّقق السماء عَن الغمام الأبيض ، ثُمَّ تنزل فِيهِ الملائكة وَعَلَى وعن والياء فِي هَذَا الموضع بمعنى واحد لأن العرب تَقُولُ : رميت عَن القوس وبالقوس وَعَلَى القوس ، يُراد بِهِ معنًى واحد .\u001bE409",
      "sanad_ar": "ويقرأ",
      "matn_ar": "\" تَشَّقَّقُ \" بالتشديد ، وقرأها الأعمش وَعَاصِم : /4 تَشَقَّقُ السَّمَاءُ سورة الفرقان آية 25 /4 بتخفيف الشِّين ، فمن قَرَأ \" تَشَّقق \" أراد تتشقق بتشديد الشِّين والقاف فأدغم كما قَالَ : /4 لا يَسَّمَّعُونَ إِلَى الْمَلإِ الأَعْلَى سورة الصافات آية 8 /4 ، ومعناهُ ، فيما ذكروا : تشُّقق السماء عَن الغمام الأبيض ، ثُمَّ تنزل فِيهِ الملائكة وَعَلَى وعن والياء فِي هَذَا الموضع بمعنى واحد لأن العرب تَقُولُ : رميت عَن القوس وبالقوس وَعَلَى القوس ، يُراد بِهِ معنًى واحد .\u001bE409",
