      "hadith_id": 42037,
      "book_id": 53,
      "chapter_id": null,
      "hadith_number": 5107,
      "text_ar": "قرأها عاصم ، وَالأعمشُ \" يَصعقون \" وأهلُ الحجاز \" يُصعقون \" وَقرأها أَبُو عَبْد الرَّحْمَن السُّلميُّ \" يَصعقون \" بفتح الياء مثل الْأَعْمَش . وَالعربُ تَقُولُ : صُعِق الرجُلُ ، وَصَعق - وَسُعِد ، وَسَعِدَ لغاتٌ كلُّها صوابٌ . /1 ومن سورة النجم /1 بسم اللَّه الرَّحْمَن الرَّحِيم",
      "sanad_ar": "قرأها عاصم",
      "matn_ar": "وَالأعمشُ \" يَصعقون \" وأهلُ الحجاز \" يُصعقون \" وَقرأها أَبُو عَبْد الرَّحْمَن السُّلميُّ \" يَصعقون \" بفتح الياء مثل الْأَعْمَش . وَالعربُ تَقُولُ : صُعِق الرجُلُ ، وَصَعق - وَسُعِد ، وَسَعِدَ لغاتٌ كلُّها صوابٌ . /1 ومن سورة النجم /1 بسم اللَّه الرَّحْمَن الرَّحِيم",
