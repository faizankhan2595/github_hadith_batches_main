    {
      "hadith_id": 39570,
      "book_id": 53,
      "chapter_id": null,
      "hadith_number": 2640,
      "text_ar": "دعاء : /4 اشْدُدْ بِهِ سورة طه آية 31 /4 يا ربّ /4 أَزْرِي { 31 } وَأَشْرِكْهُ سورة طه آية 31-32 /4 يا رب /4 فِي أَمْرِي سورة طه آية 32 /4 ، دعاء من موسى وهي فِي إحدى القراءتين : \" أَشْدُدْ بِهِ أَزْرِي وَأُشْرِكْهُ فِي أمري \" بضم الألف ، وذكر عَن الْحَسَن : \" أَشْدُدْ بِهِ \" جزاء للدعاء ، لقوله : /4 وَاجْعَلْ لِي سورة طه آية 29 /4 ، و \" وأُشْرِكه \" بضم الألف فِي /4 وَأَشْرِكْهُ سورة طه آية 32 /4 لأنَّها فعل لِموسى .    @ 2 : 179 @",
      "sanad_ar": "دعاء",
      "matn_ar": "/4 اشْدُدْ بِهِ سورة طه آية 31 /4 يا ربّ /4 أَزْرِي { 31 } وَأَشْرِكْهُ سورة طه آية 31-32 /4 يا رب /4 فِي أَمْرِي سورة طه آية 32 /4 ، دعاء من موسى وهي فِي إحدى القراءتين : \" أَشْدُدْ بِهِ أَزْرِي وَأُشْرِكْهُ فِي أمري \" بضم الألف ، وذكر عَن الْحَسَن : \" أَشْدُدْ بِهِ \" جزاء للدعاء ، لقوله : /4 وَاجْعَلْ لِي سورة طه آية 29 /4 ، و \" وأُشْرِكه \" بضم الألف فِي /4 وَأَشْرِكْهُ سورة طه آية 32 /4 لأنَّها فعل لِموسى .    @ 2 : 179 @",
