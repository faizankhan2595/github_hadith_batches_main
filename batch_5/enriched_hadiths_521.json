      "hadith_number": 175,
      "text_ar": "عَنْ /26 سُفْيَانَ L3436 /26 ، عَنْ /26 مَنْصُورٍ L7673 /26 ، عَنْ /26 إِبْرَاهِيمَ L902 /26 ، قَالَ : كَانُوا يُسَلِّمُونَ عَلَى النِّسَاءِ ، قَالَ سُفْيَانُ , وَأَخْبَرَنِي /26 عَبْدُ الْعَزِيزِ بْنُ قَرِيرٍ L21369 /26 ، قَالَ : /27 قُلْتُ /26 لِلْحَسَنِ L1239 /26 : \" /20 أَأُسَلِّمُ عَلَى النِّسَاءِ ؟ قَالَ : الْحَقْ بِأَهْلِكَ \" /27 * \r\n$161  161 /3 /141 أنا /94 ابْنُ جُرَيْجٍ L5223 /94 ، عَنْ /26 عَطَاءٍ L5625 /26 ، قَالَ : /27 \" إِنَّمَا كَانَ /93 ابْنُ عَبَّاسٍ L4883 /93 /20 يَنْبُذُ فِي حِيَاضٍ مِنْ أَدَمٍ وَأُحْدِثَتْ هَذِهِ عَلَى عَهْدِ الْحَجَّاجِ \" /27 * \r\n$162  162 /2",
      "sanad_ar": "عَنْ /26 سُفْيَانَ L3436 /26",
      "matn_ar": "عَنْ /26 مَنْصُورٍ L7673 /26 ، عَنْ /26 إِبْرَاهِيمَ L902 /26 ، قَالَ : كَانُوا يُسَلِّمُونَ عَلَى النِّسَاءِ ، قَالَ سُفْيَانُ , وَأَخْبَرَنِي /26 عَبْدُ الْعَزِيزِ بْنُ قَرِيرٍ L21369 /26 ، قَالَ : /27 قُلْتُ /26 لِلْحَسَنِ L1239 /26 : \" /20 أَأُسَلِّمُ عَلَى النِّسَاءِ ؟ قَالَ : الْحَقْ بِأَهْلِكَ \" /27 * \r\n$161  161 /3 /141 أنا /94 ابْنُ جُرَيْجٍ L5223 /94 ، عَنْ /26 عَطَاءٍ L5625 /26 ، قَالَ : /27 \" إِنَّمَا كَانَ /93 ابْنُ عَبَّاسٍ L4883 /93 /20 يَنْبُذُ فِي حِيَاضٍ مِنْ أَدَمٍ وَأُحْدِثَتْ هَذِهِ عَلَى عَهْدِ الْحَجَّاجِ \" /27 * \r\n$162  162 /2",
