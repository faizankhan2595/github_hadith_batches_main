      "hadith_number": 6265,
      "text_ar": ". والشفق : الحمرة التي فِي المغرب من الشمس . @ حدثني ابْنُ أَبِي يَحيى ، عنْ حُسَيْن بْن عَبْد اللَّه بْن ضُمَيرة ، عنْ أَبِيهِ ، عنْ جَدّه رفعه ، قَالَ : الشفق : الحمرة . قَالَ الفراء : وكان بعض الفقهاء ، يَقُولُ : الشفق : البياض ، لأنّ الحمرة تذهب إِذَا أظلمت ، وإنما الشفق : البياض الَّذِي إِذَا ذهب صُلِّيت العشاء الآخرة ، والله أعلم بصواب ذَلِكَ # وسمعت بعض العرب يَقُولُ : عَلَيْهِ ثوبٌ مصبوغ كأنه الشفق ، وكأن أحمر ، فهذا شاهد للحمرة .",
      "sanad_ar": ". والشفق",
      "matn_ar": "الحمرة التي فِي المغرب من الشمس . @ حدثني ابْنُ أَبِي يَحيى ، عنْ حُسَيْن بْن عَبْد اللَّه بْن ضُمَيرة ، عنْ أَبِيهِ ، عنْ جَدّه رفعه ، قَالَ : الشفق : الحمرة . قَالَ الفراء : وكان بعض الفقهاء ، يَقُولُ : الشفق : البياض ، لأنّ الحمرة تذهب إِذَا أظلمت ، وإنما الشفق : البياض الَّذِي إِذَا ذهب صُلِّيت العشاء الآخرة ، والله أعلم بصواب ذَلِكَ # وسمعت بعض العرب يَقُولُ : عَلَيْهِ ثوبٌ مصبوغ كأنه الشفق ، وكأن أحمر ، فهذا شاهد للحمرة .",
