    {
      "hadith_id": 43429,
      "book_id": 53,
      "chapter_id": null,
      "hadith_number": 6499,
      "text_ar": ". يَقُولُ : تحدِّث أخبارها بوحي اللَّه تبارك وتعالى ، وإذنه لها ، ثُمَّ قَالَ : /4 لِيُرَوْا أَعْمَالَهُمْ سورة الزلزلة آية 6 /4 فهي فيما جاء بِهِ التفسير متأخرة ، وهذا موضعها ، اعترض بَيْنَهُما /4 يَوْمَئِذٍ يَصْدُرُ النَّاسُ أَشْتَاتًا سورة الزلزلة آية 6 /4 ،  @ 3 : 284 @    مقدم معناه التأخير ، اجتمع القراء عَلَى \" لِيُرَوْا \" ، ولو قرئت : \" لِيَرَوْا \" كَانَ صوابًا . وفي قراءة عَبْد اللَّه مكان \" تحدّث \" ، \" تنبئ \" ، وكتابها \" تنبّأ \" بالألف . \" يَرَهُ \" تجزم الهاء وترفع . /1 ومن سورة العاديات /1 بسم اللَّه الرَّحْمَن الرَّحِيم",
      "sanad_ar": ". يَقُولُ",
      "matn_ar": "تحدِّث أخبارها بوحي اللَّه تبارك وتعالى ، وإذنه لها ، ثُمَّ قَالَ : /4 لِيُرَوْا أَعْمَالَهُمْ سورة الزلزلة آية 6 /4 فهي فيما جاء بِهِ التفسير متأخرة ، وهذا موضعها ، اعترض بَيْنَهُما /4 يَوْمَئِذٍ يَصْدُرُ النَّاسُ أَشْتَاتًا سورة الزلزلة آية 6 /4 ،  @ 3 : 284 @    مقدم معناه التأخير ، اجتمع القراء عَلَى \" لِيُرَوْا \" ، ولو قرئت : \" لِيَرَوْا \" كَانَ صوابًا . وفي قراءة عَبْد اللَّه مكان \" تحدّث \" ، \" تنبئ \" ، وكتابها \" تنبّأ \" بالألف . \" يَرَهُ \" تجزم الهاء وترفع . /1 ومن سورة العاديات /1 بسم اللَّه الرَّحْمَن الرَّحِيم",
      "grade": null,
