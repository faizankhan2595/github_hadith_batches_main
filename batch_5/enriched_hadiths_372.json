      "hadith_id": 41576,
      "book_id": 53,
      "chapter_id": null,
      "hadith_number": 4646,
      "text_ar": "قَالَ الْفَرَّاءُ : وَقَالَ /26 أَبُو بَكْرٍ /26 : حَدَّثَنِي /26 عَاصِمٌ /26 ، عَنْ /26 أَبِي رَزِينٍ /26 ، عَنْ /26 أَبِي يَحْيَى /26 ، /27 أَنَّ /93 ابْنَ عَبَّاسٍ L4883 /93 /20 قَرَأَ \" يَصِدُّونَ \" أَيْ : يَضْجَرَنَّ يَعِجِّونَ \" /27 * \r\nوفي حديث آخر : أن ابْنُ عَبَّاس لقي ابْنُ أخي عُبَيْد بْن عمير ، فَقَالَ : إن ابْنُ عمك لعربي ،   @ 3 : 37 @    فما لَهُ يلحن فِي قوله : \" إِذَا قومك مِنْهُ يصُدون \" إنَّما هِيَ /90 يصِدون /90 ، العرب تَقُولُ : يصِد ويصُد مثل : يشِد ويشُد ، وينِم وينُم من النميم . يصدون مِنْهُ وعنه سواء .",
      "sanad_ar": "قَالَ الْفَرَّاءُ",
      "matn_ar": "وَقَالَ /26 أَبُو بَكْرٍ /26 : حَدَّثَنِي /26 عَاصِمٌ /26 ، عَنْ /26 أَبِي رَزِينٍ /26 ، عَنْ /26 أَبِي يَحْيَى /26 ، /27 أَنَّ /93 ابْنَ عَبَّاسٍ L4883 /93 /20 قَرَأَ \" يَصِدُّونَ \" أَيْ : يَضْجَرَنَّ يَعِجِّونَ \" /27 * \r\nوفي حديث آخر : أن ابْنُ عَبَّاس لقي ابْنُ أخي عُبَيْد بْن عمير ، فَقَالَ : إن ابْنُ عمك لعربي ،   @ 3 : 37 @    فما لَهُ يلحن فِي قوله : \" إِذَا قومك مِنْهُ يصُدون \" إنَّما هِيَ /90 يصِدون /90 ، العرب تَقُولُ : يصِد ويصُد مثل : يشِد ويشُد ، وينِم وينُم من النميم . يصدون مِنْهُ وعنه سواء .",
