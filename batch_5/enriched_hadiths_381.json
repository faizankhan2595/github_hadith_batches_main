    {
      "hadith_id": 41703,
      "book_id": 53,
      "chapter_id": null,
      "hadith_number": 4773,
      "text_ar": "حَدَّثَنِي بِهِ /94 حِبَّانُ بْنُ عَلِيٍّ الْعَنَزِيُّ L2233 /94 ، عَنِ /26 الْكَلْبِيِّ L6845 /26 ، عَنْ /26 أَبِي صَالِحٍ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، قَالَ : /20 نَزَلَتْ فِي أَبِي بَكْرٍ رَحِمَهُ اللَّهُ إِلَى قوله : /4 أُولَئِكَ الَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ سورة الأحقاف آية 16 /4 إِلَى آخِرِ الآيَةِ \" /27 * \r\nوقرأ يَحيى بْن وثاب ، وذُكرت عنْ بعض أصحاب عَبْد اللَّه : /90 نتقبَّلُ عَنْهُمْ أحْسَنَ ما عَمِلُوا ونتجاوز عنْ سيئاتهم /90 بالنون . وقراءة العوام : \" يُتقبل عَنْهُمْ أحسن ما عملوا ويُتجاوز عنْ سيئاتهم \" بالياء وضمها ، ولو قرئت \" تُتَقَبَّلُ عَنْهُمْ أحسن ما عملوا وتُتجاوز \" كَانَ صوابًا .\u001fE547",
      "sanad_ar": "حَدَّثَنِي بِهِ /94 حِبَّانُ بْنُ عَلِيٍّ الْعَنَزِيُّ L2233 /94",
      "matn_ar": "عَنِ /26 الْكَلْبِيِّ L6845 /26 ، عَنْ /26 أَبِي صَالِحٍ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، قَالَ : /20 نَزَلَتْ فِي أَبِي بَكْرٍ رَحِمَهُ اللَّهُ إِلَى قوله : /4 أُولَئِكَ الَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ سورة الأحقاف آية 16 /4 إِلَى آخِرِ الآيَةِ \" /27 * \r\nوقرأ يَحيى بْن وثاب ، وذُكرت عنْ بعض أصحاب عَبْد اللَّه : /90 نتقبَّلُ عَنْهُمْ أحْسَنَ ما عَمِلُوا ونتجاوز عنْ سيئاتهم /90 بالنون . وقراءة العوام : \" يُتقبل عَنْهُمْ أحسن ما عملوا ويُتجاوز عنْ سيئاتهم \" بالياء وضمها ، ولو قرئت \" تُتَقَبَّلُ عَنْهُمْ أحسن ما عملوا وتُتجاوز \" كَانَ صوابًا .\u001fE547",
