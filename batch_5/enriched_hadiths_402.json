      "hadith_id": 42027,
      "book_id": 53,
      "chapter_id": null,
      "hadith_number": 5097,
      "text_ar": ". إنَّه قرأها عاصم ، والأعمشُ ، والحسنُ \" إنه \" بكسرِ الألفِ ، وقرأها أَبُو جَعْفَر الْمَدَنِيّ ، ونافع \" أَنَّهُ \" ، فمن كسرَ استأنفَ ، ومَن نصَبَ أراد : \" كُنَّا ندعوه بأنه بَرٌّ رحِيمٌ \" ، وهو وجه حسنٌ . قَالَ الفراء : الكسائيُّ ، يفتحُ أَنَّهُ \" ، وأنا أكسِرُ . وإِنما قلتُ : حسنٌ لأن الكِسَائِيّ قرأه .",
      "sanad_ar": ". إنَّه قرأها عاصم",
      "matn_ar": "والأعمشُ ، والحسنُ \" إنه \" بكسرِ الألفِ ، وقرأها أَبُو جَعْفَر الْمَدَنِيّ ، ونافع \" أَنَّهُ \" ، فمن كسرَ استأنفَ ، ومَن نصَبَ أراد : \" كُنَّا ندعوه بأنه بَرٌّ رحِيمٌ \" ، وهو وجه حسنٌ . قَالَ الفراء : الكسائيُّ ، يفتحُ أَنَّهُ \" ، وأنا أكسِرُ . وإِنما قلتُ : حسنٌ لأن الكِسَائِيّ قرأه .",
