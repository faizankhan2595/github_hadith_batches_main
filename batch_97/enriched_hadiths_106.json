    {
      "hadith_id": 865584,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 14139,
      "text_ar": "وفي شوّال جُدِّد مشهد عثمان بجامع دمشق ، وكان أكثره معطِّلًا بآلاتٍ وخشب ، وبعضه بيت للخدم ، فحُرّر جميعه وبُيّض ، وعُمل له طراز مذهب وقُرّر له إمامٌ راتب . وذلك فِي مباشرة ناصر الدِّين أَحْمَد بْن عَبْد السّلام للنّظر ، وصار يجلس به قاضي القضاة للأحكام يوم الْجُمُعَة بعد ذهاب ملك الأمراء . واستمرّ إلى الآن .",
      "sanad_ar": "وفي شوّال جُدِّد مشهد عثمان بجامع دمشق",
      "matn_ar": "وكان أكثره معطِّلًا بآلاتٍ وخشب ، وبعضه بيت للخدم ، فحُرّر جميعه وبُيّض ، وعُمل له طراز مذهب وقُرّر له إمامٌ راتب . وذلك فِي مباشرة ناصر الدِّين أَحْمَد بْن عَبْد السّلام للنّظر ، وصار يجلس به قاضي القضاة للأحكام يوم الْجُمُعَة بعد ذهاب ملك الأمراء . واستمرّ إلى الآن .",
      "grade": null,
