    {
      "hadith_id": 864648,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 13203,
      "text_ar": "وَفِي جُمَادَى الأولى ولي قضاء الحنفيّة بدمشق الشّيخ صدر الدّين سُلَيْمَان بعد وفاة ابن العديم ، فتُوفّي بعد ثلاثة أشهر ، ووُلّي بعده القاضي حسام الدّين الرّوميّ قاضي ملطية .",
      "sanad_ar": "وَفِي جُمَادَى الأولى ولي قضاء الحنفيّة بدمشق الشّيخ صدر الدّين سُلَيْمَان بعد وفاة ابن العديم",
      "matn_ar": "فتُوفّي بعد ثلاثة أشهر ، ووُلّي بعده القاضي حسام الدّين الرّوميّ قاضي ملطية .",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
