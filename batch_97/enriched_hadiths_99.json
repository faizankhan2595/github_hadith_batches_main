    {
      "hadith_id": 865477,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 14032,
      "text_ar": "فِي ثاني المُحَرَّم دخل السّلطان زين الدِّين كَتْبُغا دمشقَ راجعًا من حمص ، ثُمَّ صلّى الْجُمُعَة بالجامع ، وأخذ من النّاس قَصَصَهم حَتَّى قيل : إنّه رَأَى شخصًا بيده قَصّة فتقدّم بنفسه إليه خُطُوات وأخذها منه . ثُمَّ جلس من الغد بدار العدل ، وكتب على القَصَص .",
      "sanad_ar": "فِي ثاني المُحَرَّم دخل السّلطان زين الدِّين كَتْبُغا دمشقَ راجعًا من حمص",
      "matn_ar": "ثُمَّ صلّى الْجُمُعَة بالجامع ، وأخذ من النّاس قَصَصَهم حَتَّى قيل : إنّه رَأَى شخصًا بيده قَصّة فتقدّم بنفسه إليه خُطُوات وأخذها منه . ثُمَّ جلس من الغد بدار العدل ، وكتب على القَصَص .",
