    {
      "hadith_id": 864311,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 12866,
      "text_ar": "وولي تدريس الشّافعيّة بالصّالحيّة صدر الدّين بن القاضي تاج الدّين ، وفُوّض نَظَر الخانقاه السّعيديّة إلى قاضي الحنابلة ، وولي نظر مدرسة الشّافعيّ بهاء الدّين عليّ بن عيسى بن رمضان نيابة عن الصّاحب فخر الدّين بن خير ، وهذه المناصب كلّها كانت بيد القاضي تاج الدّين .",
      "sanad_ar": "وولي تدريس الشّافعيّة بالصّالحيّة صدر الدّين بن القاضي تاج الدّين",
      "matn_ar": "وفُوّض نَظَر الخانقاه السّعيديّة إلى قاضي الحنابلة ، وولي نظر مدرسة الشّافعيّ بهاء الدّين عليّ بن عيسى بن رمضان نيابة عن الصّاحب فخر الدّين بن خير ، وهذه المناصب كلّها كانت بيد القاضي تاج الدّين .",
