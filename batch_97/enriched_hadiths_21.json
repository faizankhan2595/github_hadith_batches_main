    {
      "hadith_id": 864309,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 12864,
      "text_ar": "وفي شعبان ولي قضاء القضاة بالقاهرة والوجه الشّرقيّ الإمام تقيّ الدّين بن رَزِين الحَمَويّ ، وولي قضاء مصر والوجه القبليّ محيي الدّين عبد الله بن القاضي شَرَف الدّين بن عين الدّولة , وولي نظر الأحباس الشّيخ تاج الدّين عليّ بن القسْطلانيّ .",
      "sanad_ar": "وفي شعبان ولي قضاء القضاة بالقاهرة والوجه الشّرقيّ الإمام تقيّ الدّين بن رَزِين الحَمَويّ",
      "matn_ar": "وولي قضاء مصر والوجه القبليّ محيي الدّين عبد الله بن القاضي شَرَف الدّين بن عين الدّولة , وولي نظر الأحباس الشّيخ تاج الدّين عليّ بن القسْطلانيّ .",
