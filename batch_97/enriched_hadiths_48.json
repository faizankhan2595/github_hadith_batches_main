    {
      "hadith_id": 864709,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 13264,
      "text_ar": "ثُمَّ ورد البريد فِي الثامن والعشرين من مصر بأنّا قد عَفَوْنا عن جميع النّاس من الخاصّ والعامّ ، ولم نؤاخِذْ أحدًا ، وأن يُقَرّ كلُّ أحدٍ على منصبه .",
      "sanad_ar": "ثُمَّ ورد البريد فِي الثامن والعشرين من مصر بأنّا قد عَفَوْنا عن جميع النّاس من الخاصّ والعامّ",
      "matn_ar": "ولم نؤاخِذْ أحدًا ، وأن يُقَرّ كلُّ أحدٍ على منصبه .",
