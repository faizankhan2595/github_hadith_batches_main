    {
      "hadith_id": 865574,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 14129,
      "text_ar": "وفيه قَدِمَ دمشقَ على نيابتها الأمير جمال الدِّين الأفرم المَنْصُورِيّ ، ثُمَّ قَدِمَ طُلْبُه بعد أيّام . ووُلّي الشّدّ أقجبا المَنْصُورِيّ . وولاية البلد جمال الدِّين إِبْرَاهِيم بْن النّحاس . وولاية برّ البلد عماد الدِّين حَسَن بن النّشّابيّ .\u001cE9016",
      "sanad_ar": "وفيه قَدِمَ دمشقَ على نيابتها الأمير جمال الدِّين الأفرم المَنْصُورِيّ",
      "matn_ar": "ثُمَّ قَدِمَ طُلْبُه بعد أيّام . ووُلّي الشّدّ أقجبا المَنْصُورِيّ . وولاية البلد جمال الدِّين إِبْرَاهِيم بْن النّحاس . وولاية برّ البلد عماد الدِّين حَسَن بن النّشّابيّ .\u001cE9016",
