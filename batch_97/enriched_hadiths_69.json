    {
      "hadith_id": 865021,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 13576,
      "text_ar": "ثمّ طالبوا نجم الدّين عبّاس الجوهري بمُغَلّ ضيعةٍ كَانَ اشتراها من بِنْت الأشراف بالبقاع ، فأعطاهم جوهرًا قيمته ثمانون ألف درهم ، فقالوا : نَحْنُ نريد دراهم وألحّوا عَلَيْهِ ، فنزل إلى مدرسته وحفر فِي دِهليزها فأخرج لَهُ خَوَنْجاه ذهب مرصَّعة بجواهر ، فقوِّمت بأربع مائة ألف .",
      "sanad_ar": "ثمّ طالبوا نجم الدّين عبّاس الجوهري بمُغَلّ ضيعةٍ كَانَ اشتراها من بِنْت الأشراف بالبقاع",
      "matn_ar": "فأعطاهم جوهرًا قيمته ثمانون ألف درهم ، فقالوا : نَحْنُ نريد دراهم وألحّوا عَلَيْهِ ، فنزل إلى مدرسته وحفر فِي دِهليزها فأخرج لَهُ خَوَنْجاه ذهب مرصَّعة بجواهر ، فقوِّمت بأربع مائة ألف .",
