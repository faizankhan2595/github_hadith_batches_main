    {
      "hadith_id": 865660,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 14215,
      "text_ar": "فِي رابع رجب طلع النّاس إلى المنابر وأخبروا أنّهم رأوا خلْقًا من التَّتَار رائحين فِي عَقَبَة دُمّر . ورحل بلاوي إلى بَعْلَبَكَّ والبقاع ، ونُظِّفت ضواحي دمشق منهم والبلد وسافر النّاس فِي عاشر رجب إلى القبلة والشمال .",
      "sanad_ar": "فِي رابع رجب طلع النّاس إلى المنابر وأخبروا أنّهم رأوا خلْقًا من التَّتَار رائحين فِي عَقَبَة دُمّر . ورحل بلاوي إلى بَعْلَبَكَّ والبقاع",
      "matn_ar": "ونُظِّفت ضواحي دمشق منهم والبلد وسافر النّاس فِي عاشر رجب إلى القبلة والشمال .",
