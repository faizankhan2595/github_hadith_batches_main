    {
      "hadith_id": 865664,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 14219,
      "text_ar": "ويوم ثالث عَشْر رجب تشوّش البلد بسبب رجوع طائفة من التتار إلى ظاهر باب شرقي ، وكان النّاس يتفرّجون فِي غياض السَّفَرْجَل ، فرجعوا مسرعين ، وشُلّح بعضهم وأخذ بعض الصّبيان ، ثُمَّ كان هذا آخر العَهْد بالتّتار ، وكفى اللَّه أمرهم .",
      "sanad_ar": "ويوم ثالث عَشْر رجب تشوّش البلد بسبب رجوع طائفة من التتار إلى ظاهر باب شرقي",
      "matn_ar": "وكان النّاس يتفرّجون فِي غياض السَّفَرْجَل ، فرجعوا مسرعين ، وشُلّح بعضهم وأخذ بعض الصّبيان ، ثُمَّ كان هذا آخر العَهْد بالتّتار ، وكفى اللَّه أمرهم .",
