    {
      "hadith_id": 865665,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 14220,
      "text_ar": "وأمّا قبجق فإنّه يوم نصف رجب انفصل عن البلد هُوَ وأتباعه ومعه عزَّ الدِّين بن القلانسي ، وتوجّهوا إلى نحو مصر ، فقام أرجَواش بأمر البلد ، وأمر بحفظ الأسوار والمبيت عليها بالعُدد ، وأنّ من بات فِي داره شُنِق وأغلق أبواب البلد ، ثُمَّ فتح للناس باب النّصر بعد ارتفاع النّهار ، وجَفَل النّاس من الحواضر .",
      "sanad_ar": "وأمّا قبجق فإنّه يوم نصف رجب انفصل عن البلد هُوَ وأتباعه ومعه عزَّ الدِّين بن القلانسي",
      "matn_ar": "وتوجّهوا إلى نحو مصر ، فقام أرجَواش بأمر البلد ، وأمر بحفظ الأسوار والمبيت عليها بالعُدد ، وأنّ من بات فِي داره شُنِق وأغلق أبواب البلد ، ثُمَّ فتح للناس باب النّصر بعد ارتفاع النّهار ، وجَفَل النّاس من الحواضر .",
