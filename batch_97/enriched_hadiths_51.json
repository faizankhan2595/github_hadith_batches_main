    {
      "hadith_id": 864757,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 13312,
      "text_ar": "ودخل السّلطان دمشق يوم تاسع عشر المحرَّم ، وحمل الْجَتَر البَيْسريُّ يومئذٍ ، فعزل ابن خَلِّكان عن القضاء بابن الصّائغ ، وولي قضاء الحنابلة نجم الدّين أَحْمَد بْن الشَّيْخ شمس الدّين ، وذلك بعد خُلُوّ الشّام من قاضٍ حنبليّ مدّةً .",
      "sanad_ar": "ودخل السّلطان دمشق يوم تاسع عشر المحرَّم",
      "matn_ar": "وحمل الْجَتَر البَيْسريُّ يومئذٍ ، فعزل ابن خَلِّكان عن القضاء بابن الصّائغ ، وولي قضاء الحنابلة نجم الدّين أَحْمَد بْن الشَّيْخ شمس الدّين ، وذلك بعد خُلُوّ الشّام من قاضٍ حنبليّ مدّةً .",
