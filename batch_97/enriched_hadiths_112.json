    {
      "hadith_id": 865671,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 14226,
      "text_ar": "ويوم عاشر شعبان قَدِمَ الأفرم نائب دمشق بعسكر دمشق ، ثُمَّ قَدِمَ أمير سلاح والميسرة المصريّة بعد يومين . ثُمَّ دخلت الميمنة وعليها الحسام أستاذ دار ، ثُمَّ دخل يوم رابع عَشْر شعبان القلب وعليه نائب المملكة سلار ، ونزل الكُلّ بالمرج .",
      "sanad_ar": "ويوم عاشر شعبان قَدِمَ الأفرم نائب دمشق بعسكر دمشق",
      "matn_ar": "ثُمَّ قَدِمَ أمير سلاح والميسرة المصريّة بعد يومين . ثُمَّ دخلت الميمنة وعليها الحسام أستاذ دار ، ثُمَّ دخل يوم رابع عَشْر شعبان القلب وعليه نائب المملكة سلار ، ونزل الكُلّ بالمرج .",
      "grade": null,
