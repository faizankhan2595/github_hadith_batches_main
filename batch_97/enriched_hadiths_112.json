      "chapter_id": null,
      "hadith_number": 14224,
      "text_ar": "ويومئذ دار ابن تيميّة وأصحابه على ما جُدِّد من الخمارات فبدَّد الخمر ، وشقّ الظّروف ، وعَزَّر الخمّارين ، ثُمَّ زُيّن البلد من الغد يوم السّبت .",
      "sanad_ar": "ويومئذ دار ابن تيميّة وأصحابه على ما جُدِّد من الخمارات فبدَّد الخمر",
      "matn_ar": "وشقّ الظّروف ، وعَزَّر الخمّارين ، ثُمَّ زُيّن البلد من الغد يوم السّبت .",
