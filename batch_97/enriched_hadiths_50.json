      "hadith_id": 864737,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 13292,
      "text_ar": ". وَفِي رمضان أعيد تقي الدّين ابن رزين إِلَى قضاء الدِّيار المصريّة ، وعُزِل صدر الدّين ابن بِنْت الأعزّ . وأعيد قبل ذلك إِلَى القضاء القاضيان نفيس الدّين ابن شُكْر ، ومُعِّز الدّين النُّعمان . ورُتّب قاضٍ حنبليّ وهو الشَّيْخ عز الدّين عُمَر بْن عَبْد اللّه بن عوض المقُدسيّ صِهْر الشَّيْخ شمس الدّين بْن العماد .",
      "sanad_ar": ". وَفِي رمضان أعيد تقي الدّين ابن رزين إِلَى قضاء الدِّيار المصريّة",
      "matn_ar": "وعُزِل صدر الدّين ابن بِنْت الأعزّ . وأعيد قبل ذلك إِلَى القضاء القاضيان نفيس الدّين ابن شُكْر ، ومُعِّز الدّين النُّعمان . ورُتّب قاضٍ حنبليّ وهو الشَّيْخ عز الدّين عُمَر بْن عَبْد اللّه بن عوض المقُدسيّ صِهْر الشَّيْخ شمس الدّين بْن العماد .",
      "grade": null,
