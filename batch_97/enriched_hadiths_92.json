    {
      "hadith_id": 865373,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 13928,
      "text_ar": "فَلَمّا كان العشرين من صَفَر بلغ المتولّي نيابةَ السّلطان كَتُبغا أنّ الشُّجاعيّ يريد قتله فتحرّز ، وأعلم جماعةً من صاغيته الذين يبغضون الشُّجاعيّ . ثُمَّ ركب فِي الموكب فقال له أميرٌ : أَيْنَ حسام الدّين لاجين ؟ قال : ما هُوَ عندي ؟ قال : بل هُوَ عندك . ثُمَّ مدّ يده إلى سيفه ، فبدره الأزرق مملوك كتبُغا وضربه حلّ كتفَه ، فسقط ، وذبحوه بسوق الخيل .",
      "sanad_ar": "فَلَمّا كان العشرين من صَفَر بلغ المتولّي نيابةَ السّلطان كَتُبغا أنّ الشُّجاعيّ يريد قتله فتحرّز",
      "matn_ar": "وأعلم جماعةً من صاغيته الذين يبغضون الشُّجاعيّ . ثُمَّ ركب فِي الموكب فقال له أميرٌ : أَيْنَ حسام الدّين لاجين ؟ قال : ما هُوَ عندي ؟ قال : بل هُوَ عندك . ثُمَّ مدّ يده إلى سيفه ، فبدره الأزرق مملوك كتبُغا وضربه حلّ كتفَه ، فسقط ، وذبحوه بسوق الخيل .",
