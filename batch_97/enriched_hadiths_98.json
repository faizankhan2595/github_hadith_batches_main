    {
      "hadith_id": 865460,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 14015,
      "text_ar": "وكان أسمر ، مدوّر الوجه ، صغير العين ، قصيرًا ، فِي ذقنه شعرات يسيرة ، وله رقبة قصيرة ، وكان يوصف بالشجاعة والإقدام ، والدّين التّامّ ، وحُسن الخُلق ، وسلامة الباطن ، والتّواضع ، وتَرْك الفواحش ، وعدم السَّفْك للدّماء وقلّة الظُّلم . لكنّه كان يَضْعُف عن حمل أعباء المُلْك ويُعوِزُه رأيٌ وحزمٌ ، ودهاء ، مع ما فِيهِ من التّقوى وحُسْن الطَّوِيّة .",
      "sanad_ar": "وكان أسمر",
      "matn_ar": "مدوّر الوجه ، صغير العين ، قصيرًا ، فِي ذقنه شعرات يسيرة ، وله رقبة قصيرة ، وكان يوصف بالشجاعة والإقدام ، والدّين التّامّ ، وحُسن الخُلق ، وسلامة الباطن ، والتّواضع ، وتَرْك الفواحش ، وعدم السَّفْك للدّماء وقلّة الظُّلم . لكنّه كان يَضْعُف عن حمل أعباء المُلْك ويُعوِزُه رأيٌ وحزمٌ ، ودهاء ، مع ما فِيهِ من التّقوى وحُسْن الطَّوِيّة .",
