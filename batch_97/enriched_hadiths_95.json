      "hadith_id": 865422,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 13977,
      "text_ar": "وفي شوّال كملت عمارة الحمام الكبير ، والمسجد ، والسُّوق ، وأكثر الحِكْر الَّذِي أنشأه نائب دمشق عزَّ الدِّين الحَمَويّ بين باب الفراديس ومسجد القصب . وكان يُعرف ببستان الوزير ، ورأيته مَبْقَلة كبيرة .",
      "sanad_ar": "وفي شوّال كملت عمارة الحمام الكبير",
      "matn_ar": "والمسجد ، والسُّوق ، وأكثر الحِكْر الَّذِي أنشأه نائب دمشق عزَّ الدِّين الحَمَويّ بين باب الفراديس ومسجد القصب . وكان يُعرف ببستان الوزير ، ورأيته مَبْقَلة كبيرة .",
