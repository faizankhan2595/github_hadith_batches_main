    {
      "hadith_id": 864948,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 13503,
      "text_ar": "وفي رجب درَّس بالأمينية الشّيْخ علاء الدّين ابن الزَّمْلكَانيّ , بعد موت ابن خَلِّكان . ودرَّس شمس الدين بْن الحريري بالفَرُّخْشاهيّة , بعد موت الجمال يَحْيَى مدرِّسها .",
