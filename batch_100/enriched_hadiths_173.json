      "chapter_id": null,
      "hadith_number": 19,
      "text_ar": "إِبْرَاهِيمُ بْنُ عَلِيٍّ الرَّافِعِيُّ ، مُنْكَرُ الْحَدِيثِ ، حَدَّثَ عَنْ /26 مُحَمَّدِ بْنِ عُرْوَةَ بْنِ هِشَامِ بْنِ عُرْوَةَ L29994 /26 ، عَنْ /26 جَدِّهِ L-10000 /26 ، عَنْ /26 أَبِيهِ L-10000 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" /20 نَظِفُّوا مَجْمَعَ اللَّحْيَيْنِ ، وَمَجْمَعَ الشِّدْقَيْنِ ، مَدْخَلَ الطَّعَامِ وَالشَّرَابِ \" /27 * \r\n@ 1 : 49 @ \r\n$11  11 /2",
      "sanad_ar": "إِبْرَاهِيمُ بْنُ عَلِيٍّ الرَّافِعِيُّ",
      "matn_ar": "مُنْكَرُ الْحَدِيثِ ، حَدَّثَ عَنْ /26 مُحَمَّدِ بْنِ عُرْوَةَ بْنِ هِشَامِ بْنِ عُرْوَةَ L29994 /26 ، عَنْ /26 جَدِّهِ L-10000 /26 ، عَنْ /26 أَبِيهِ L-10000 /26 ، /27 عَنْ /93 عَائِشَةَ L4049 /93 ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" /20 نَظِفُّوا مَجْمَعَ اللَّحْيَيْنِ ، وَمَجْمَعَ الشِّدْقَيْنِ ، مَدْخَلَ الطَّعَامِ وَالشَّرَابِ \" /27 * \r\n@ 1 : 49 @ \r\n$11  11 /2",
