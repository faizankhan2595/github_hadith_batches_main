    {
      "hadith_id": 893736,
      "book_id": 1044,
      "chapter_id": null,
      "hadith_number": 172,
      "text_ar": "$58  59 /2 /143 رَوَى عَنْ /26 سِمَاكٍ /26 ، عَنْ /26 طَارِقٍ L3992 /26 ، /27 عَنْ /93 عُمَرَ L5913 /93 ، عَن ِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" /20 بُعِثْتُ دَاعِيًا وَمُبَلِّغًا ، وَلَيْسَ إِلَيَّ مِنَ الْهُدَى شَيْءٌ \" /27 الْحَدِيثَ . قَالَ /26 أَبُو الْحَسَنِ : خَالِدٌ /26 هَذَا الَّذِي حَدَّثَ عَنْ /26 سِمَاكٍ /26 بِهَذَا الْحَدِيثِ /26 رَجُلٌ /26 مَجْهُولٌ ، لا أَعْلَمُهُ رَوَى شَيْئًا مِنَ الْحَدِيثِ غَيْرَ هَذَا الْحَدِيثِ الْبَاطِلِ عَنْ /26 سِمَاكٍ /26 * \r\nوخالد بْن عَبْد الرَّحْمَنِ أبو القاسم شيخ يحدث عن : مالك بْن مغول ، ومالك بْن أنس ، وسفيان الثوري ، ونظرائهم ، في حديثه بعض الضعف ، وليس بمتروك .",
      "sanad_ar": "$58  59 /2 /143 رَوَى عَنْ /26 سِمَاكٍ /26",
      "matn_ar": "عَنْ /26 طَارِقٍ L3992 /26 ، /27 عَنْ /93 عُمَرَ L5913 /93 ، عَن ِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" /20 بُعِثْتُ دَاعِيًا وَمُبَلِّغًا ، وَلَيْسَ إِلَيَّ مِنَ الْهُدَى شَيْءٌ \" /27 الْحَدِيثَ . قَالَ /26 أَبُو الْحَسَنِ : خَالِدٌ /26 هَذَا الَّذِي حَدَّثَ عَنْ /26 سِمَاكٍ /26 بِهَذَا الْحَدِيثِ /26 رَجُلٌ /26 مَجْهُولٌ ، لا أَعْلَمُهُ رَوَى شَيْئًا مِنَ الْحَدِيثِ غَيْرَ هَذَا الْحَدِيثِ الْبَاطِلِ عَنْ /26 سِمَاكٍ /26 * \r\nوخالد بْن عَبْد الرَّحْمَنِ أبو القاسم شيخ يحدث عن : مالك بْن مغول ، ومالك بْن أنس ، وسفيان الثوري ، ونظرائهم ، في حديثه بعض الضعف ، وليس بمتروك .",
