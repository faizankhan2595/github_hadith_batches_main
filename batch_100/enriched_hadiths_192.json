    {
      "hadith_id": 893870,
      "book_id": 1044,
      "chapter_id": null,
      "hadith_number": 306,
      "text_ar": "قَالَ /26 ابْنُ حِبَّانَ : وَهُوَ L28916 /26 الَّذِي رَوَى عَنِ /26 ابْنِ جُرَيْجٍ L5223 /26 ، عَنِ /26 ابْنِ أَبِي مُلَيْكَةَ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :    @ 1 : 124 @   \" /20 مَنْ آتَاهُ اللَّهُ عَزَّ وَجَلَّ وَجْهًا حَسَنًا ، وَاسْمًا حَسَنًا ، وَجَعَلَهُ مِنْ مَوْضِعٍ غَيْرِ شَائِنٍ لَهُ ، فَهُوَ مِنْ صَفْوَةِ اللَّهِ ، عَزَّ وَجَلَّ \" /27 . حَدَّثَنَاهُ حَاجِبُ بْنُ أَرْكِينَ ، ثنا /26 أَبُو عُقَيْلِ بْنُ حَبِيبِ بْنِ أَبِي ثَابِتٍ /26 ، ثنا /26 خَلَفُ بْنُ خَالِدٍ الْعَبْدِيُّ الْبَصْرِيُّ /26 ، ثنا /26 سُلَيْمُ بْنُ مُسْلِمٍ /26 . قَالَ /26 أَبُو الْحَسَنِ /26 : الْحَمْلُ فِي هَذَا الْحَدِيثِ /26 عَلَى خَلَفٍ /26 ، لا /26 عَلَى سُلَيْمٍ /26 ، /26 وَسُلَيْمٌ /26 مُقَارَبٌ ، /26 لَيْسَ /26 مِمَّنْ يُتَّهَمُ بِوَضْعِ الْحَدِيثِ * \r\n@ 1 : 125 @",
      "sanad_ar": "قَالَ /26 ابْنُ حِبَّانَ",
      "matn_ar": "وَهُوَ L28916 /26 الَّذِي رَوَى عَنِ /26 ابْنِ جُرَيْجٍ L5223 /26 ، عَنِ /26 ابْنِ أَبِي مُلَيْكَةَ /26 ، /27 عَنِ /93 ابْنِ عَبَّاسٍ L4883 /93 ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :    @ 1 : 124 @   \" /20 مَنْ آتَاهُ اللَّهُ عَزَّ وَجَلَّ وَجْهًا حَسَنًا ، وَاسْمًا حَسَنًا ، وَجَعَلَهُ مِنْ مَوْضِعٍ غَيْرِ شَائِنٍ لَهُ ، فَهُوَ مِنْ صَفْوَةِ اللَّهِ ، عَزَّ وَجَلَّ \" /27 . حَدَّثَنَاهُ حَاجِبُ بْنُ أَرْكِينَ ، ثنا /26 أَبُو عُقَيْلِ بْنُ حَبِيبِ بْنِ أَبِي ثَابِتٍ /26 ، ثنا /26 خَلَفُ بْنُ خَالِدٍ الْعَبْدِيُّ الْبَصْرِيُّ /26 ، ثنا /26 سُلَيْمُ بْنُ مُسْلِمٍ /26 . قَالَ /26 أَبُو الْحَسَنِ /26 : الْحَمْلُ فِي هَذَا الْحَدِيثِ /26 عَلَى خَلَفٍ /26 ، لا /26 عَلَى سُلَيْمٍ /26 ، /26 وَسُلَيْمٌ /26 مُقَارَبٌ ، /26 لَيْسَ /26 مِمَّنْ يُتَّهَمُ بِوَضْعِ الْحَدِيثِ * \r\n@ 1 : 125 @",
