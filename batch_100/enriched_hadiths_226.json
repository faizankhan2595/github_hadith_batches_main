      "hadith_id": 894378,
      "book_id": 1044,
      "chapter_id": null,
      "hadith_number": 814,
      "text_ar": "قَالَ /26 ابْنُ حِبَّانَ : مُسْلِمُ بْنُ عَطِيَّةَ الْفُقَيْمِيُّ شَيْخٌ /26 يَرْوِي عَنْ /26 عَطَاءِ بْنِ أَبِي رَبَاحٍ L5625 /26 ، رَوَى /26 عَنْهُ بَدْرُ بْنُ الْخَلِيلِ الأَسَدِيُّ L12632 /26 ، رَوَى عَنْ /26 عَطَاءٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، عَن ِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" إِنَّ /20 مِنْ حَقِّ جَلالِ اللَّهِ عَلَى الْعَبْدِ إِكْرَامَ ذِي الشَّيْبَةِ الْمُسْلِمِ ، وَرِعَايَةَ الْقُرْآنِ لِمَنِ اسْتَرْعَاهُ إِيَّاهُ ، وَطَاعَةَ الإِمَامِ الْقَاسِطِ \" /27    @ 1 : 259 @   ثناه الْحَسَنُ بْنُ سُفْيَانَ ، ثنا /26 عَبْدُ الْعَزِيزِ بْنُ سَلامٍ /26 ، ثنا /26 عَبْدُ الْعَزِيزِ بْنُ يَحْيَى /26 ، ثنا /26 عِيسَى بْنُ يُونُسَ /26 ، عَنْ /26 بَدْرِ بْنِ الْخَلِيلِ /26 ، عَنْ /26 مُسْلِمِ بْنِ عَطِيَّةَ /26 * \r\nقَالَ أَبُو الْحَسَنِ : قَوْلُهُ : مُسلم بْن عطية خطأ ، إنما هو سلم بْن عطية . وقوله : الإمام القاسط في المتن خطأ . إنما هو المقسط ، قَالَ اللَّه : /4 وَأَمَّا الْقَاسِطُونَ فَكَانُوا لِجَهَنَّمَ حَطَبًا سورة الجن آية 15 /4 . فالقاسط : الجائر ، والمقسط : العادل ، يقَالَ : قسط الرجل ، إذا جار فهو قاسط . وأقسط إذا عدل فهو مقسط . قَالَ النبي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" المقسطون في الدنيا على منابر من نور يوم القيامة \" الحديث .\u001bE91",
      "sanad_ar": "قَالَ /26 ابْنُ حِبَّانَ",
      "matn_ar": "مُسْلِمُ بْنُ عَطِيَّةَ الْفُقَيْمِيُّ شَيْخٌ /26 يَرْوِي عَنْ /26 عَطَاءِ بْنِ أَبِي رَبَاحٍ L5625 /26 ، رَوَى /26 عَنْهُ بَدْرُ بْنُ الْخَلِيلِ الأَسَدِيُّ L12632 /26 ، رَوَى عَنْ /26 عَطَاءٍ /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، عَن ِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" إِنَّ /20 مِنْ حَقِّ جَلالِ اللَّهِ عَلَى الْعَبْدِ إِكْرَامَ ذِي الشَّيْبَةِ الْمُسْلِمِ ، وَرِعَايَةَ الْقُرْآنِ لِمَنِ اسْتَرْعَاهُ إِيَّاهُ ، وَطَاعَةَ الإِمَامِ الْقَاسِطِ \" /27    @ 1 : 259 @   ثناه الْحَسَنُ بْنُ سُفْيَانَ ، ثنا /26 عَبْدُ الْعَزِيزِ بْنُ سَلامٍ /26 ، ثنا /26 عَبْدُ الْعَزِيزِ بْنُ يَحْيَى /26 ، ثنا /26 عِيسَى بْنُ يُونُسَ /26 ، عَنْ /26 بَدْرِ بْنِ الْخَلِيلِ /26 ، عَنْ /26 مُسْلِمِ بْنِ عَطِيَّةَ /26 * \r\nقَالَ أَبُو الْحَسَنِ : قَوْلُهُ : مُسلم بْن عطية خطأ ، إنما هو سلم بْن عطية . وقوله : الإمام القاسط في المتن خطأ . إنما هو المقسط ، قَالَ اللَّه : /4 وَأَمَّا الْقَاسِطُونَ فَكَانُوا لِجَهَنَّمَ حَطَبًا سورة الجن آية 15 /4 . فالقاسط : الجائر ، والمقسط : العادل ، يقَالَ : قسط الرجل ، إذا جار فهو قاسط . وأقسط إذا عدل فهو مقسط . قَالَ النبي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" المقسطون في الدنيا على منابر من نور يوم القيامة \" الحديث .\u001bE91",
