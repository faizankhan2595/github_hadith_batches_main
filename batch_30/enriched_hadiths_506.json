      "hadith_id": 268583,
      "book_id": 275,
      "chapter_id": null,
      "hadith_number": 1987,
      "text_ar": "حَدَّثَنَا /94 إِبْرَاهِيمُ /94 ، حَدَّثَنَا /26 مُحَمَّدُ بْنُ الصَّبَّاحِ /26 ، حَدَّثَنَا /26 هُشَيْمٌ /26 ، أَخْبَرَنَا /26 هِشَامٌ /26 ، عَنِ /26 ابْنِ سِيرِينَ /26 ، /26 وَحَفْصَةَ /26 ، /27 عَنْ /93 أُمِّ عَطِيَّةَ L7882 /93 ، قَالَتْ : /20 \" الْمُتَوَفَّى عَنْهَا لا تَمَسُّ طِيبًا إِلا نُبْذَةً مِنْ قُسْطٍ وَأَظْفَارٍ عِنْدَ طَهَارَتِهَا \" /27 * \r\n\u001cE446 @ 3 : 1128 @ \r\n$2059  2059 /2 /141 حَدَّثَنَا /94 زُهَيْرُ بْنُ حَرْبٍ L3036 /94 ، حَدَّثَنَا /26 يَعْقُوبُ L8513 /26 ، حَدَّثَنَا /26 أَبِي L823 /26 ، عَنْ /26 صَالِحٍ L3891 /26 ، عَنِ /26 ابْنِ شِهَابٍ L7272 /26 ، عَنْ /26 عُبَيْدِ اللَّهِ L5409 /26 ، عَنِ /26 ابْنِ عَبَّاسٍ L4883 /26 ، /27 عَنْ /93 عَمَّارٍ L5860 /93 : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 عَرَّسَ بِآلاتِ الْجَيْشِ وَمَعَهُ عَائِشَةُ ، فَانْقَطَعَ عِقْدٌ لَهَا مِنْ جَزْعِ /60 ظَفَارٍ /60 \" /27 * \r\n$2060  2060 /2",
      "sanad_ar": "حَدَّثَنَا /94 إِبْرَاهِيمُ /94",
      "matn_ar": "حَدَّثَنَا /26 مُحَمَّدُ بْنُ الصَّبَّاحِ /26 ، حَدَّثَنَا /26 هُشَيْمٌ /26 ، أَخْبَرَنَا /26 هِشَامٌ /26 ، عَنِ /26 ابْنِ سِيرِينَ /26 ، /26 وَحَفْصَةَ /26 ، /27 عَنْ /93 أُمِّ عَطِيَّةَ L7882 /93 ، قَالَتْ : /20 \" الْمُتَوَفَّى عَنْهَا لا تَمَسُّ طِيبًا إِلا نُبْذَةً مِنْ قُسْطٍ وَأَظْفَارٍ عِنْدَ طَهَارَتِهَا \" /27 * \r\n\u001cE446 @ 3 : 1128 @ \r\n$2059  2059 /2 /141 حَدَّثَنَا /94 زُهَيْرُ بْنُ حَرْبٍ L3036 /94 ، حَدَّثَنَا /26 يَعْقُوبُ L8513 /26 ، حَدَّثَنَا /26 أَبِي L823 /26 ، عَنْ /26 صَالِحٍ L3891 /26 ، عَنِ /26 ابْنِ شِهَابٍ L7272 /26 ، عَنْ /26 عُبَيْدِ اللَّهِ L5409 /26 ، عَنِ /26 ابْنِ عَبَّاسٍ L4883 /26 ، /27 عَنْ /93 عَمَّارٍ L5860 /93 : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ /20 عَرَّسَ بِآلاتِ الْجَيْشِ وَمَعَهُ عَائِشَةُ ، فَانْقَطَعَ عِقْدٌ لَهَا مِنْ جَزْعِ /60 ظَفَارٍ /60 \" /27 * \r\n$2060  2060 /2",
