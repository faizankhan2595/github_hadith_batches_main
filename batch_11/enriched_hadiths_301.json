    {
      "hadith_id": 94507,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 13113,
      "text_ar": "مولى عزرة بن ثابت الأنصاري ، ويكنى أبا عثمان ، وكان ثقة كثير الحديث ، صحيح الكتاب ، وكان من أهل البصرة فقدم بغداد ، فلم يزل بها حتى تُوُفّي سنة عشرين ومائتين ، وصلى عليه عاصم بن علي بن عاصم ، وامتحن وسئل عن القرآن فأبى أن يقول القرآن مخلوق .\u001cE2782",
      "sanad_ar": "مولى عزرة بن ثابت الأنصاري",
      "matn_ar": "ويكنى أبا عثمان ، وكان ثقة كثير الحديث ، صحيح الكتاب ، وكان من أهل البصرة فقدم بغداد ، فلم يزل بها حتى تُوُفّي سنة عشرين ومائتين ، وصلى عليه عاصم بن علي بن عاصم ، وامتحن وسئل عن القرآن فأبى أن يقول القرآن مخلوق .\u001cE2782",
      "grade": null,
