      "hadith_id": 91354,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 9960,
      "text_ar": "أَخْبَرَنَا /94 أَبُو أُسَامَةَ /94 ، عَنِ /26 الْفُضَيْلِ بْنِ مَرْزُوقٍ /26 ، عَنْ /26 مَيْسَرَةَ بْنِ حَبِيبٍ النَّهْدِيِّ /26 ، قَالَ : /27 \" مَرَّ /93 عَلِيٌّ L5722 /93 بِقَوْمٍ يَلْعَبُونَ بِشِطْرَنْجٍ , فَقَالَ : /20 مَا هَذِهِ التَّمَاثِيلُ الَّتِي أَنْتُمْ لَهَا عَاكِفُونَ ؟ ! \" /27 *",
      "sanad_ar": "أَخْبَرَنَا /94 أَبُو أُسَامَةَ /94",
      "matn_ar": "عَنِ /26 الْفُضَيْلِ بْنِ مَرْزُوقٍ /26 ، عَنْ /26 مَيْسَرَةَ بْنِ حَبِيبٍ النَّهْدِيِّ /26 ، قَالَ : /27 \" مَرَّ /93 عَلِيٌّ L5722 /93 بِقَوْمٍ يَلْعَبُونَ بِشِطْرَنْجٍ , فَقَالَ : /20 مَا هَذِهِ التَّمَاثِيلُ الَّتِي أَنْتُمْ لَهَا عَاكِفُونَ ؟ ! \" /27 *",
      "grade": null,
