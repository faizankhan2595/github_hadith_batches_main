    {
      "hadith_id": 92000,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 10606,
      "text_ar": "وَقَالَ /26 سُفْيَانُ /26 : قَالَ /26 مِسْعَرٌ /26 , /27 عَنْ /26 أَبِي حَصِينٍ /26 ، قَالَ : /20 \" لَقِيَنِي عَبْدُ اللَّهِ بْنُ مَعْقِلٍ , فَقَالَ : شَغَلَتْكَ التِّجَارَةُ ، قَالَ : قُلْتُ : وَأَنْتَ شَغَلَتْكَ الإِمَارَةُ \" /27 * \r\n$8191  8192 /8",
      "sanad_ar": "وَقَالَ /26 سُفْيَانُ /26",
      "matn_ar": "قَالَ /26 مِسْعَرٌ /26 , /27 عَنْ /26 أَبِي حَصِينٍ /26 ، قَالَ : /20 \" لَقِيَنِي عَبْدُ اللَّهِ بْنُ مَعْقِلٍ , فَقَالَ : شَغَلَتْكَ التِّجَارَةُ ، قَالَ : قُلْتُ : وَأَنْتَ شَغَلَتْكَ الإِمَارَةُ \" /27 * \r\n$8191  8192 /8",
