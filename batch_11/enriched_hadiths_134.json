      "hadith_id": 91999,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 10605,
      "text_ar": "وَقَالَ /26 سُفْيَانُ /26 : عَنْ /18 /26 رَجُلٍ /26 /18 مِنْ أَهْلِ الْكُوفَةِ : /27 سُئِلَ /26 عَامِرٌ /26 لَمَّا حَضَرَتْهُ الْوَفَاةُ ، بِمَنْ تَأْمُرُنَا ؟ قَالَ : /20 \" مَا أَنَا بِعَالِمٍ ، وَلَمْ أَتْرُكْ عَالِمًا ، وَإِنَّ أَبَا حَصِينٍ لَرَجُلٌ صَالِحٌ \" /27 * \r\n$8190  8191 /8",
      "sanad_ar": "وَقَالَ /26 سُفْيَانُ /26",
      "matn_ar": "عَنْ /18 /26 رَجُلٍ /26 /18 مِنْ أَهْلِ الْكُوفَةِ : /27 سُئِلَ /26 عَامِرٌ /26 لَمَّا حَضَرَتْهُ الْوَفَاةُ ، بِمَنْ تَأْمُرُنَا ؟ قَالَ : /20 \" مَا أَنَا بِعَالِمٍ ، وَلَمْ أَتْرُكْ عَالِمًا ، وَإِنَّ أَبَا حَصِينٍ لَرَجُلٌ صَالِحٌ \" /27 * \r\n$8190  8191 /8",
