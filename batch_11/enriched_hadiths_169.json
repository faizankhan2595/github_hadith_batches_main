    {
      "hadith_id": 92524,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 11130,
      "text_ar": "ويكنى أبا الحسن ولي قضاء الشرقية ببغداد ثم ولاه هارون أمير المؤمنين القضاء معه في عسكره حيث كان , فكان يجلس في المسجد الذي ينسب إلى الخلد للقضاء , وخرج مع هارون حين توجه إلى خراسان فمات بقرماسين سنة اثنين وتسعين ومائة , وقد روى علي عن عبيد الله بن عمر وابن أبي ليلى وغيرهما .    @ 6 : 552 @",
      "sanad_ar": "ويكنى أبا الحسن ولي قضاء الشرقية ببغداد ثم ولاه هارون أمير المؤمنين القضاء معه في عسكره حيث كان , فكان يجلس في المسجد الذي ينسب إلى الخلد للقضاء , وخرج مع هارون حين توجه إلى خراسان فمات بقرماسين سنة اثنين وتسعين ومائة , وقد روى علي عن عبيد الله بن عمر وابن أبي ليلى وغيرهما .    @ 6",
      "matn_ar": "552 @",
