    {
      "hadith_id": 92530,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 11136,
      "text_ar": "، واسمه محمد بن عبد الله بن الزبير ، مولى لبني أسد ، وهو ابن أخي فضيل الرماني ، توفي بالأهواز في جمادى الأولى سنة ثلاث ومائتين في خلافة المأمون ، وكان صدوقا كثير الحديث .",
      "sanad_ar": "",
      "matn_ar": "واسمه محمد بن عبد الله بن الزبير ، مولى لبني أسد ، وهو ابن أخي فضيل الرماني ، توفي بالأهواز في جمادى الأولى سنة ثلاث ومائتين في خلافة المأمون ، وكان صدوقا كثير الحديث .",
      "grade": null,
