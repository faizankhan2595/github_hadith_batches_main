    {
      "hadith_id": 95066,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 13672,
      "text_ar": "أُخْبِرْتُ عَنْ /26 أبي الْيَمَانِ /26 ، عَنْ /26 جَرِيرِ بْنِ عُثْمَانَ /26 ، عَنْ /26 سُلَيْمِ بْنِ عَامِرٍ /26 ، قَالَ : /27 قَالَ /26 جُبَيْرُ بْنُ نُفَيْرٍ /26 : /20 \" اسْتَقْبَلْتُ الإِسْلامَ مِنْ أَوَّلِهِ ، وَلَمْ أَزَلْ أَرَى فِي النَّاسِ صَالِحًا وَطَالِحًا \" /27 * \r\n$9453  9456 /8 /141 قَالَ : أُخْبِرْتُ عَنْ /26 عَبْدِ اللَّهِ بْنِ صَالِحٍ /26 ، عَنْ /26 مُعَاوِيَةَ بْنِ صَالِحٍ /26 ، عَنْ /26 أبي الزَّاهِرِيَّةِ /26 ، /26 وَابْنِ جُبَيْرٍ /26 ، قَالا : /27 /20 \" مَا رَأَيْنَا /26 جُبَيْرًا /26 يَجْلِسُ مَجْلِسَ قَوْمِهِ قَطُّ \" /27 * \r\n\u001bE2841",
      "sanad_ar": "أُخْبِرْتُ عَنْ /26 أبي الْيَمَانِ /26",
      "matn_ar": "عَنْ /26 جَرِيرِ بْنِ عُثْمَانَ /26 ، عَنْ /26 سُلَيْمِ بْنِ عَامِرٍ /26 ، قَالَ : /27 قَالَ /26 جُبَيْرُ بْنُ نُفَيْرٍ /26 : /20 \" اسْتَقْبَلْتُ الإِسْلامَ مِنْ أَوَّلِهِ ، وَلَمْ أَزَلْ أَرَى فِي النَّاسِ صَالِحًا وَطَالِحًا \" /27 * \r\n$9453  9456 /8 /141 قَالَ : أُخْبِرْتُ عَنْ /26 عَبْدِ اللَّهِ بْنِ صَالِحٍ /26 ، عَنْ /26 مُعَاوِيَةَ بْنِ صَالِحٍ /26 ، عَنْ /26 أبي الزَّاهِرِيَّةِ /26 ، /26 وَابْنِ جُبَيْرٍ /26 ، قَالا : /27 /20 \" مَا رَأَيْنَا /26 جُبَيْرًا /26 يَجْلِسُ مَجْلِسَ قَوْمِهِ قَطُّ \" /27 * \r\n\u001bE2841",
