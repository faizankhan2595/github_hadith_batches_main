      "hadith_id": 98553,
      "book_id": 89,
      "chapter_id": null,
      "hadith_number": 117,
      "text_ar": "ثنا /94 يَحْيَى بْنُ سَعِيدٍ L8271 /94 ، عَنْ /26 عُثْمَانَ بْنِ غِيَاثٍ L5548 /26 ، /27 عَنْ /26 أَبِي السَّلِيلِ L3976 /26 ، قَالَ : /20 \" كَانَ الرَّجُلُ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُحَدِّثُ النَّاسَ فَيَكْثُرُ عَلَيْهِ فَيَصْعَدُ فَوْقَ بَيْتٍ فَيُحَدِّثُهُمْ \" /27 * \r\n$119  119 /3",
      "sanad_ar": "ثنا /94 يَحْيَى بْنُ سَعِيدٍ L8271 /94",
      "matn_ar": "عَنْ /26 عُثْمَانَ بْنِ غِيَاثٍ L5548 /26 ، /27 عَنْ /26 أَبِي السَّلِيلِ L3976 /26 ، قَالَ : /20 \" كَانَ الرَّجُلُ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُحَدِّثُ النَّاسَ فَيَكْثُرُ عَلَيْهِ فَيَصْعَدُ فَوْقَ بَيْتٍ فَيُحَدِّثُهُمْ \" /27 * \r\n$119  119 /3",
