      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 10448,
      "text_ar": "قَالَ /94 يَحْيَى بْنُ آدَمَ /94 عَنْ /26 أَبِي بَكْرِ بْنِ عَيَّاشٍ /26 ، /27 عَنْ /26 عَاصِمٍ /26 ، قَالَ : /20 \" تَعَلَّمَ يَحْيَى بْنُ وَثَّابٍ مِنْ عُبَيْدِ بْنِ نُضَيْلَةَ آيَةً آيَةً ، فَكَانَ وَاللَّهِ قَارِئًا \" /27 * \r\n$8120  8121 /8",
      "sanad_ar": "قَالَ /94 يَحْيَى بْنُ آدَمَ /94 عَنْ /26 أَبِي بَكْرِ بْنِ عَيَّاشٍ /26",
      "matn_ar": "/27 عَنْ /26 عَاصِمٍ /26 ، قَالَ : /20 \" تَعَلَّمَ يَحْيَى بْنُ وَثَّابٍ مِنْ عُبَيْدِ بْنِ نُضَيْلَةَ آيَةً آيَةً ، فَكَانَ وَاللَّهِ قَارِئًا \" /27 * \r\n$8120  8121 /8",
