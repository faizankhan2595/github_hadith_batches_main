    {
      "hadith_id": 92019,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 10625,
      "text_ar": "أَخْبَرَنَا /94 طَلْقُ بْنُ غَنَّامٍ النَّخَعِيُّ /94 ، قَالَ : /27 سَمِعْتُ /26 حَفْصَ بْنَ غِيَاثٍ /26 ، يَقُولُ : /20 \" ذَكَرَ مَالِكُ بْنُ مِغْوَلٍ فَضْلَ طَلْحَةَ ، يَعْنِي ابْنَ مُصَرِّفٍ ، فَقَالَ لَهُ رَجُلٌ : هَلْ رَأَيْتَ حُصَيْنَ بْنَ عَبْدِ الرَّحْمَنِ النَّخَعِيَّ ؟ قَالَ : لا . قَالَ : لَوْ رَأَيْتَهُ مَا ذَكَرْتَ طَلْحَةَ . يَعْنِي مِنْ فَضْلِهِ \" /27 * \r\n$8193  8194 /8 /141 قَالَ : أخبرنا طلق بن غنام ، قَالَ : سمعت /26 حفص بن غياث /26 ، يقول : /27 \" كان /26 حصين بن عبد الرحمن النخعي /26 /20 يلبس في الشتاء بالنهار قباء محشوا ، فيه ثمانون أستارا ، وكان دثاره بالليل \" /27 *",
      "sanad_ar": "أَخْبَرَنَا /94 طَلْقُ بْنُ غَنَّامٍ النَّخَعِيُّ /94",
      "matn_ar": "قَالَ : /27 سَمِعْتُ /26 حَفْصَ بْنَ غِيَاثٍ /26 ، يَقُولُ : /20 \" ذَكَرَ مَالِكُ بْنُ مِغْوَلٍ فَضْلَ طَلْحَةَ ، يَعْنِي ابْنَ مُصَرِّفٍ ، فَقَالَ لَهُ رَجُلٌ : هَلْ رَأَيْتَ حُصَيْنَ بْنَ عَبْدِ الرَّحْمَنِ النَّخَعِيَّ ؟ قَالَ : لا . قَالَ : لَوْ رَأَيْتَهُ مَا ذَكَرْتَ طَلْحَةَ . يَعْنِي مِنْ فَضْلِهِ \" /27 * \r\n$8193  8194 /8 /141 قَالَ : أخبرنا طلق بن غنام ، قَالَ : سمعت /26 حفص بن غياث /26 ، يقول : /27 \" كان /26 حصين بن عبد الرحمن النخعي /26 /20 يلبس في الشتاء بالنهار قباء محشوا ، فيه ثمانون أستارا ، وكان دثاره بالليل \" /27 *",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/94,/94,/27,/26,/26,/20,/27,/8,/141,/26,/26,/27,/26,/26,/20,/27",
