    {
      "hadith_id": 979761,
      "book_id": 1745,
      "chapter_id": null,
      "hadith_number": 1740,
      "text_ar": "مدرس المدرسة السلفية بالإسكندرية ، له التصانيف في الفنون المتنوعة في الفقه والأصول والخلاف وتخرج به جماعة . قال الحافظ المنذري : سمع بالإسكندرية من أبي الطاهر بن عوف ، وسمعت منه ، وحدث بمكة ومصر وكان كثير الإفادة منتصبًا لمن يقرأ عليه ، كثير التواضع حسن الأخلاق جميل العشرة دينا متورعًا ، توجه إلى الحج ، فأشيع موته ، فأخذت المدرسة ، ثم اتفق عوده ولم ترجع إليه ، فأقام بجامع مصر يقرئ واجتمع عليه جماعة ، ودرس بمدرسة الشريف ثعلب ، وتوفي في شعبان سنة اثنتي عشرة وست مائة .",
      "sanad_ar": "مدرس المدرسة السلفية بالإسكندرية",
      "matn_ar": "له التصانيف في الفنون المتنوعة في الفقه والأصول والخلاف وتخرج به جماعة . قال الحافظ المنذري : سمع بالإسكندرية من أبي الطاهر بن عوف ، وسمعت منه ، وحدث بمكة ومصر وكان كثير الإفادة منتصبًا لمن يقرأ عليه ، كثير التواضع حسن الأخلاق جميل العشرة دينا متورعًا ، توجه إلى الحج ، فأشيع موته ، فأخذت المدرسة ، ثم اتفق عوده ولم ترجع إليه ، فأقام بجامع مصر يقرئ واجتمع عليه جماعة ، ودرس بمدرسة الشريف ثعلب ، وتوفي في شعبان سنة اثنتي عشرة وست مائة .",
      "grade": null,
