    {
      "hadith_id": 853558,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 2113,
      "text_ar": "فيها تُوُفّي : عفّان ببغداد . قولون بن عيسى بن مينا . ومُطَرِّف بن عبد الله بالمدينة . وأبو حُذَيْفة المَرْوزِيّ . وعاصم بن يوسف اليَرْبُوعيّ . وخلّاد بن خالد القارئ بالكوفة . وعثمان بن الهيثم المؤذّن . والخليل بن عمر بن إبراهيم العبْديّ . وعبد الله بن رجاء بالبصرة . وآدم بن أبي أياس بعسقلّان . وعبد الله بن جعفر الرَّقّي بالرَّقّة . وقَرعوس بن العبّاس الثقفيّ صاحب مالك بالأندلس ، ومحمد الجواد ولد عليّ بن موسى الرّضا ببغداد .",
      "sanad_ar": "فيها تُوُفّي",
      "matn_ar": "عفّان ببغداد . قولون بن عيسى بن مينا . ومُطَرِّف بن عبد الله بالمدينة . وأبو حُذَيْفة المَرْوزِيّ . وعاصم بن يوسف اليَرْبُوعيّ . وخلّاد بن خالد القارئ بالكوفة . وعثمان بن الهيثم المؤذّن . والخليل بن عمر بن إبراهيم العبْديّ . وعبد الله بن رجاء بالبصرة . وآدم بن أبي أياس بعسقلّان . وعبد الله بن جعفر الرَّقّي بالرَّقّة . وقَرعوس بن العبّاس الثقفيّ صاحب مالك بالأندلس ، ومحمد الجواد ولد عليّ بن موسى الرّضا ببغداد .",
