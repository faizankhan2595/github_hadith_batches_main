    {
      "hadith_id": 848525,
      "book_id": 910,
      "chapter_id": null,
      "hadith_number": 4078,
      "text_ar": "يفتح الهمزة مولى إِبْرَاهِيم بْن جَعْفَر بْن عَبْد اللَّه الزُّهْرِيّ أصله من سرقسطة وسكن قرطبة يعرف بابن العطار ويكنى أبا مُحَمَّد سَمِعَ أبا عَبْد اللَّه بْن الحاج وأبا إِسْحَاق بْن ثابت وأبا الْحَسَن بْن مغيث وأبا مُحَمَّد النفزي الخطيب وأبا بَكْر بْن العربي وأبا عَبْد اللَّه بْن مكي وأبا عَبْد اللَّه بْن أصبغ وأبا جَعْفَر بْن عَبْد العزيز . . . وأجاز لَهُ أَبُو الْحَسَن شريح بْن مُحَمَّد وسمع مِنْهُ صحيح الْبُخَارِيّ وكتب بخطه كثيرًا وكان من أهل الضبط والإتقان والعناية بالرواية ولا أعلمه حدث . 799 -",
