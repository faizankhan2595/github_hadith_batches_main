    {
      "hadith_id": 854046,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 2601,
      "text_ar": "تُوُفّي فيها : أَبُو إِسْحَاق الجوزجانيّ الحافظ ، وإسحاق بْن وهْب العلَاف ، وإسحاق البَغَوِيّ لؤلؤ ، وأحمد بْن إِسْمَاعِيل السَّهْميّ ، وبشر بْن مطر السامريّ ، وحجاج بْن الشّاعر ، وعلي بْن مَعْبَد نزيل مصر ، ومحمد بْن يزيد السُّلَميّ النَّيسابوري ، ومحمود بْن سميع الدّمشقيّ ، ومحمد بْن آدم المَرْوزِيّ .\u001eE3830",
      "sanad_ar": "تُوُفّي فيها",
