    {
      "hadith_id": 848259,
      "book_id": 910,
      "chapter_id": null,
      "hadith_number": 3812,
      "text_ar": "كتبت من خط  /94  أَبِي بَكْر مُحَمَّد بْن إِسْحَاق الوزير  /94  ، أخبرني  /26  أَبُو مُحَمَّد عليّ بْن أَحْمَد بْن حزم  /26  صاحبنا إملاءً من حفظه ، /27 قَالَ لي  /26  أَبُو عُمَر أَحْمَد بْن مُحَمَّد بْن عَبْد الوارث  /26  مؤدِّبي فِي النحو المعروفة بابن أخي الزَّاهِد : /20 لما احتُضر عمي أَبُو مُحَمَّد عَبْد اللَّه بْن عَبْد الوارث أحاط بِهِ أهله وبنوه يكون وكان لَهُ ابْنُ يسمى محمدًا أكبر بنيه وكان عاقًّا لَهُ فأدْمَن النظر إِلَيْه ثُمَّ تنفس الصعداء وأنشد لأبي يعقوب الخريمي : /50 /51 لا أعرفنك بعد الموت تندبني /51 /51 وفي حياتي ما زودتني زادي /51 /50 ثُمَّ فاضت نفسه رحمه اللَّه /27  * \r\n669 -",
      "sanad_ar": "كتبت من خط  /94  أَبِي بَكْر مُحَمَّد بْن إِسْحَاق الوزير  /94",
      "matn_ar": "أخبرني  /26  أَبُو مُحَمَّد عليّ بْن أَحْمَد بْن حزم  /26  صاحبنا إملاءً من حفظه ، /27 قَالَ لي  /26  أَبُو عُمَر أَحْمَد بْن مُحَمَّد بْن عَبْد الوارث  /26  مؤدِّبي فِي النحو المعروفة بابن أخي الزَّاهِد : /20 لما احتُضر عمي أَبُو مُحَمَّد عَبْد اللَّه بْن عَبْد الوارث أحاط بِهِ أهله وبنوه يكون وكان لَهُ ابْنُ يسمى محمدًا أكبر بنيه وكان عاقًّا لَهُ فأدْمَن النظر إِلَيْه ثُمَّ تنفس الصعداء وأنشد لأبي يعقوب الخريمي : /50 /51 لا أعرفنك بعد الموت تندبني /51 /51 وفي حياتي ما زودتني زادي /51 /50 ثُمَّ فاضت نفسه رحمه اللَّه /27  * \r\n669 -",
