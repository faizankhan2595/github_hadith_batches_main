    {
      "hadith_id": 853214,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 1769,
      "text_ar": "وأقام طاهر عَلَى نهر صَرْصَرٍ ، فكان لا يأتيه جيش مِن جهة الأمين إلا هزمه ، وأخذ الأمين يدسّ الجواسيس إلى قوّاد طاهر يعدهم ويمنّيهم ، فشغبوا عَلَى طاهر ، واستأمَن خلقٌ إلى الأمين فأسنى عطاياهم ، ثمّ كرّوا إلى صَرْصَرٍ لحرب طاهر ، فالتقوا ودام القتال .",
      "sanad_ar": "وأقام طاهر عَلَى نهر صَرْصَرٍ",
      "matn_ar": "فكان لا يأتيه جيش مِن جهة الأمين إلا هزمه ، وأخذ الأمين يدسّ الجواسيس إلى قوّاد طاهر يعدهم ويمنّيهم ، فشغبوا عَلَى طاهر ، واستأمَن خلقٌ إلى الأمين فأسنى عطاياهم ، ثمّ كرّوا إلى صَرْصَرٍ لحرب طاهر ، فالتقوا ودام القتال .",
