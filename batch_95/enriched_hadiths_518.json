      "hadith_number": 2311,
      "text_ar": "فيها تُوُفِيّ : إبراهيم بْن محمد بْن عمّ الشّافِيّ ، وحاتِم الأصمّ الزّاهد ، وسعيد بْن حفص النُّفَيْلِيّ ، والعبّاس بْن الوليد النَّرْسِيّ ، وعبد اللَّه بْن عامر بْن زُرَارَة ، وعبد اللَّه بْن مطيع ، وعبد الأعلى بْن حمّاد النَّرْسِيّ ، وعُبَيْد اللَّه بْن مُعاذ العَنْبَريّ ، وأبو كامل الفُضَيْل بْن الحسن الْجُحْدريّ ، ومحمد بْن قُدامة الجوهريّ ، ووَثِيمة بْن موسى ، نزيل مصر ، وكان إخباريًّا .",
      "sanad_ar": "فيها تُوُفِيّ",
      "matn_ar": "إبراهيم بْن محمد بْن عمّ الشّافِيّ ، وحاتِم الأصمّ الزّاهد ، وسعيد بْن حفص النُّفَيْلِيّ ، والعبّاس بْن الوليد النَّرْسِيّ ، وعبد اللَّه بْن عامر بْن زُرَارَة ، وعبد اللَّه بْن مطيع ، وعبد الأعلى بْن حمّاد النَّرْسِيّ ، وعُبَيْد اللَّه بْن مُعاذ العَنْبَريّ ، وأبو كامل الفُضَيْل بْن الحسن الْجُحْدريّ ، ومحمد بْن قُدامة الجوهريّ ، ووَثِيمة بْن موسى ، نزيل مصر ، وكان إخباريًّا .",
