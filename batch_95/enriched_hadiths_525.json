    {
      "hadith_id": 853873,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 2428,
      "text_ar": "فيها تُوُفيّ : أحمد بن صالح المصريّ ، والحسين الكرابيسيّ ، وطاهر بن عبد الله الأمير ، وعبد الجبّار بن العلاء ، وعبد الملك بن شُعَيب بن اللَّيْث ، وعيسى بن حمّاد زُغْبة ، والقاسم بن عثمان الْجَوْعيّ ، ومحمد بن حُمَيْد الرّازيّ ، والمنتصر بالله محمد ، ومحمد بن زُنْبُور المكّيّ ، وأبو كُرَيْب محمد بن العلاء ، ومحمد بن موسى الحَرَشِيّ ، وأبو هشام الرفاعيّ .",
      "sanad_ar": "فيها تُوُفيّ",
      "matn_ar": "أحمد بن صالح المصريّ ، والحسين الكرابيسيّ ، وطاهر بن عبد الله الأمير ، وعبد الجبّار بن العلاء ، وعبد الملك بن شُعَيب بن اللَّيْث ، وعيسى بن حمّاد زُغْبة ، والقاسم بن عثمان الْجَوْعيّ ، ومحمد بن حُمَيْد الرّازيّ ، والمنتصر بالله محمد ، ومحمد بن زُنْبُور المكّيّ ، وأبو كُرَيْب محمد بن العلاء ، ومحمد بن موسى الحَرَشِيّ ، وأبو هشام الرفاعيّ .",
