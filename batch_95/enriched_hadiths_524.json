    {
      "hadith_id": 853850,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 2405,
      "text_ar": "آخرها قدِم المتوكّل إلى دمشق ، فأعجبته ، وبنى له القصر بدارَيّا ، وَعَزَمَ على سُكْنَاهَا ، فعمل يزيد بن محمد المُهَلّبيّ : /50 /51 أظنُّ الشّام تشمَتُ بالعراقِ /51 /51 إذا عزم الإمامُ على انْطلاقِ /51 /50 /50 /51 فإنْ تَدَعِ العِراقَ وساكنيه /51 /51 فقد تُبْلى المليحةُ بالطّلاقِ /51 /50 فبدا له ورجع بعد شهرين أو ثلاثة ، في سنة أربعٍ .",
      "sanad_ar": "آخرها قدِم المتوكّل إلى دمشق",
      "matn_ar": "فأعجبته ، وبنى له القصر بدارَيّا ، وَعَزَمَ على سُكْنَاهَا ، فعمل يزيد بن محمد المُهَلّبيّ : /50 /51 أظنُّ الشّام تشمَتُ بالعراقِ /51 /51 إذا عزم الإمامُ على انْطلاقِ /51 /50 /50 /51 فإنْ تَدَعِ العِراقَ وساكنيه /51 /51 فقد تُبْلى المليحةُ بالطّلاقِ /51 /50 فبدا له ورجع بعد شهرين أو ثلاثة ، في سنة أربعٍ .",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/50,/51,/51,/51,/51,/50,/50,/51,/51,/51,/51,/50",
