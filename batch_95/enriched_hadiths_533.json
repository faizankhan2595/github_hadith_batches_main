    {
      "hadith_id": 853991,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 2546,
      "text_ar": "فيها تُوُفّي : أَحْمَد بْن عَبْد الواحد بْن عبُّود الدّمشقيّ ، وإبراهيم بْن مجشّر الكاتب ، وبُغَا الصَّغير الشَّرابيّ ، وزياد بْن يحيى الحسّانيّ ، وسَلْم بْن جُنَادَةَ ، والدّارِميّ ، وعلي بْن محمد بْن عَلِيّ بْن مُوسَى الرِّضا أَبو الْحَسَن العسكريّ مِن الاثني عشرية ، ومحمد بْن عَبْد لله المخرَميّ الحافظ ، ومحمد بْن منصور الطُّوسيّ العابد ، ومحمد بْن هاشم البَعْلَبَكّيّ ، والمَرّار بْن حَمُّوَيْه الهَمَدانيّ الفقيه . ولم يجرِ مِنَ الحوادث ما لَهُ صورة .\u001cE3824",
      "sanad_ar": "فيها تُوُفّي",
      "matn_ar": "أَحْمَد بْن عَبْد الواحد بْن عبُّود الدّمشقيّ ، وإبراهيم بْن مجشّر الكاتب ، وبُغَا الصَّغير الشَّرابيّ ، وزياد بْن يحيى الحسّانيّ ، وسَلْم بْن جُنَادَةَ ، والدّارِميّ ، وعلي بْن محمد بْن عَلِيّ بْن مُوسَى الرِّضا أَبو الْحَسَن العسكريّ مِن الاثني عشرية ، ومحمد بْن عَبْد لله المخرَميّ الحافظ ، ومحمد بْن منصور الطُّوسيّ العابد ، ومحمد بْن هاشم البَعْلَبَكّيّ ، والمَرّار بْن حَمُّوَيْه الهَمَدانيّ الفقيه . ولم يجرِ مِنَ الحوادث ما لَهُ صورة .\u001cE3824",
