    {
      "hadith_id": 853840,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 2395,
      "text_ar": "فيها تُوُفّي : أبو مُصْعَب الزُّهْريّ ، والحَسَن بن عليّ الحُلْوانيّ ، وابن ذَكْوان المقرئ ، وزكريّا بن يحيى كاتب العُمريّ ، ومحمد بن أسلم الطُّوسيّ ، ومحمد بن رُمح التُّجَيْبيّ ، ومحمد بن عبد الله بن عمّار ، ويحيى بن أكثم .",
      "sanad_ar": "فيها تُوُفّي",
      "matn_ar": "أبو مُصْعَب الزُّهْريّ ، والحَسَن بن عليّ الحُلْوانيّ ، وابن ذَكْوان المقرئ ، وزكريّا بن يحيى كاتب العُمريّ ، ومحمد بن أسلم الطُّوسيّ ، ومحمد بن رُمح التُّجَيْبيّ ، ومحمد بن عبد الله بن عمّار ، ويحيى بن أكثم .",
