      "hadith_id": 854138,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 2693,
      "text_ar": "وفيها أظهر أبو أَحْمَد الموفَّق العصيان ، فشخَصَ من بغداد ومعه عَبْد الله بْن سُلَيْمَان بْن وهْب ، فَلَمَّا قَرُب من سامُرّاء ، تحوّل المعتمد إِلَى الجانب الغربيّ ، فعسكر به ، فنزل أَحْمَد بظاهر سامُراء ، ثُمَّ تراسلا واصطلحا فِي آخر السنة ، وأطلق سُلَيْمَان بْن وهبْ ، وهرب الْحَسَن بْن مَخْلد ، وأحمد بْن صالح بْن شيرزاد .#E3977",
      "sanad_ar": "وفيها أظهر أبو أَحْمَد الموفَّق العصيان",
      "matn_ar": "فشخَصَ من بغداد ومعه عَبْد الله بْن سُلَيْمَان بْن وهْب ، فَلَمَّا قَرُب من سامُرّاء ، تحوّل المعتمد إِلَى الجانب الغربيّ ، فعسكر به ، فنزل أَحْمَد بظاهر سامُراء ، ثُمَّ تراسلا واصطلحا فِي آخر السنة ، وأطلق سُلَيْمَان بْن وهبْ ، وهرب الْحَسَن بْن مَخْلد ، وأحمد بْن صالح بْن شيرزاد .#E3977",
