    {
      "hadith_id": 853978,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 2533,
      "text_ar": "وفيها تُوُفّي : أحمد بْن سعَيِد الهَمَدانيّ المصريّ ، وسَرِيٌّ السَّقَطيّ الزّاهد ، وعلي بْن شُعَيب السَّمسار ، وعلي بْن مُسلْمِ الطُّوسيّ ، ومحمد بْن عَبْد اللَّه بْن طاهر الأمير ، ومحمد بْن عيسى بْن رَزِين التّميميّ مقرئ الرِّيّ ، ومحمد بْن يحيى بْن أَبِي حَزْم القطعيَ ، وهارون بْن سعَيِد الأيْليّ ، والأمير وصيف التُّرْكيّ ، ويوسف بْن مُوسَى القطّان ، وأبو الْعَبَّاس القَلوَّريّ .",
      "sanad_ar": "وفيها تُوُفّي",
      "matn_ar": "أحمد بْن سعَيِد الهَمَدانيّ المصريّ ، وسَرِيٌّ السَّقَطيّ الزّاهد ، وعلي بْن شُعَيب السَّمسار ، وعلي بْن مُسلْمِ الطُّوسيّ ، ومحمد بْن عَبْد اللَّه بْن طاهر الأمير ، ومحمد بْن عيسى بْن رَزِين التّميميّ مقرئ الرِّيّ ، ومحمد بْن يحيى بْن أَبِي حَزْم القطعيَ ، وهارون بْن سعَيِد الأيْليّ ، والأمير وصيف التُّرْكيّ ، ويوسف بْن مُوسَى القطّان ، وأبو الْعَبَّاس القَلوَّريّ .",
