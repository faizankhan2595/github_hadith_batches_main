    {
      "hadith_id": 848197,
      "book_id": 910,
      "chapter_id": null,
      "hadith_number": 3750,
      "text_ar": "مولى رَسُول اللَّه صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ من أهل قرطبة يكنى أبا حرش كَانَ بصيرًا باللغة والنحو ذكره الرازي وقال : كَانَ فِي عصر واحد مَعَ سَعِيد بْن الرج الرشاش وله معه أخبار تستطرف وذكره الزبيدي وقال : أخذ عنْ جودي يعني ابْنُ عثمان النحوي العيسي وأخذ عَنْهُ أَحْمَد بْن بتري القرموني قَالَ وكان النَّاس إِذَا استفصحوا رجلًا قَالُوا ما هَذَا إلا أَبُو حرش . 639 -#E409",
      "sanad_ar": "مولى رَسُول اللَّه صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ من أهل قرطبة يكنى أبا حرش كَانَ بصيرًا باللغة والنحو ذكره الرازي وقال",
      "matn_ar": "كَانَ فِي عصر واحد مَعَ سَعِيد بْن الرج الرشاش وله معه أخبار تستطرف وذكره الزبيدي وقال : أخذ عنْ جودي يعني ابْنُ عثمان النحوي العيسي وأخذ عَنْهُ أَحْمَد بْن بتري القرموني قَالَ وكان النَّاس إِذَا استفصحوا رجلًا قَالُوا ما هَذَا إلا أَبُو حرش . 639 -#E409",
