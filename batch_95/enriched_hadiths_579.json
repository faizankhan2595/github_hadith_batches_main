    {
      "hadith_id": 854679,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 3234,
      "text_ar": "تُوُفي فيها : أحمد بن حمّاد التُّجَيْبيّ أخو زُغْبَة . وأحمد بن نَجْده الهَرويّ وأحمد بن يحيى الحُلْوانيّ . وخَلَف بن عَمْرو العُكْبُريّ . وعبد الله بن المُعْتَزّ . وأبو حُصَيْن الوادعيّ محمد بن الحسين . ومَعْمَر بن محمد أبو شِهاب البلْخيّ . ويوسف بن موسى القطّان الصّغير .",
      "sanad_ar": "تُوُفي فيها",
      "matn_ar": "أحمد بن حمّاد التُّجَيْبيّ أخو زُغْبَة . وأحمد بن نَجْده الهَرويّ وأحمد بن يحيى الحُلْوانيّ . وخَلَف بن عَمْرو العُكْبُريّ . وعبد الله بن المُعْتَزّ . وأبو حُصَيْن الوادعيّ محمد بن الحسين . ومَعْمَر بن محمد أبو شِهاب البلْخيّ . ويوسف بن موسى القطّان الصّغير .",
      "grade": null,
