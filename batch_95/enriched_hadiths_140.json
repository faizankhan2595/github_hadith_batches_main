    {
      "hadith_id": 848091,
      "book_id": 910,
      "chapter_id": null,
      "hadith_number": 3644,
      "text_ar": "أخبرنا  /94  عَبْد الرَّحْمَن بْن مُحَمَّد هُوَ أَبُو مَنْصُور القزاز  /94  ، قَالَ : أخبرنا  /26  أَحْمَد بْن عليّ يعني أبا بَكْر بْن ثابت الحطيب  /26  ، قَالَ : أخبرنا  /26  يحيى بْن عليّ بْن الطيب  /26  ، قَالَ : أخبرنا  /26  نصر بْن مُحَمَّد الأندلسي  /26  ، قَالَ : /27 سَمِعْتُ  /26  أبا الْحَسَن عليّ بْن القاسم القاضي  /26  ، قَالَ : سَمِعْتُ  /26  أَبِي  /26  ، يَقُولُ : كَانَ /20 مُوسَى بْن إِسْحَاق لا يُرى متبسًمًا قطّ فقالت لَهُ امْرَأَة أيها القاضي لا يحلّ أن يحكم القاضي بْن إثنين وهو غضبان فتبسم /27 أخبرني بذلك  /26  غير واحد  /26  من شيوخنا عنْ  /26  أَبِي الفرج  /26  وفي كتاب الحميدي نصر بْن مُحَمَّد بْن عَبْد الملك وذكره ابْنُ بشكوال وفيه أيضًا نصر بْن عَبْد الملك وقال أخشى أن يكون هَذَا نسبه إلى جَدّه  * \r\n583 -",
      "sanad_ar": "أخبرنا  /94  عَبْد الرَّحْمَن بْن مُحَمَّد هُوَ أَبُو مَنْصُور القزاز  /94",
      "matn_ar": "قَالَ : أخبرنا  /26  أَحْمَد بْن عليّ يعني أبا بَكْر بْن ثابت الحطيب  /26  ، قَالَ : أخبرنا  /26  يحيى بْن عليّ بْن الطيب  /26  ، قَالَ : أخبرنا  /26  نصر بْن مُحَمَّد الأندلسي  /26  ، قَالَ : /27 سَمِعْتُ  /26  أبا الْحَسَن عليّ بْن القاسم القاضي  /26  ، قَالَ : سَمِعْتُ  /26  أَبِي  /26  ، يَقُولُ : كَانَ /20 مُوسَى بْن إِسْحَاق لا يُرى متبسًمًا قطّ فقالت لَهُ امْرَأَة أيها القاضي لا يحلّ أن يحكم القاضي بْن إثنين وهو غضبان فتبسم /27 أخبرني بذلك  /26  غير واحد  /26  من شيوخنا عنْ  /26  أَبِي الفرج  /26  وفي كتاب الحميدي نصر بْن مُحَمَّد بْن عَبْد الملك وذكره ابْنُ بشكوال وفيه أيضًا نصر بْن عَبْد الملك وقال أخشى أن يكون هَذَا نسبه إلى جَدّه  * \r\n583 -",
