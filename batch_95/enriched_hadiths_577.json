    {
      "hadith_id": 854648,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 3203,
      "text_ar": "فيها تُوُفي : إبراهيم بن عليّ الذُّهلّيّ . وداود بن الحسين البَيْهَقيّ . وعبدان المَرْوَزِيّ . والفضل بن العبّاس بن مِهران الأصبهاني . ومحمد بن أسد المَدِينيّ . ومحمد بن عَبْدُوس بن كامل السّرّاج . وهميم بن همّام الطَّبَريّ الأَيْليّ .\u001fE4292",
      "sanad_ar": "فيها تُوُفي",
      "matn_ar": "إبراهيم بن عليّ الذُّهلّيّ . وداود بن الحسين البَيْهَقيّ . وعبدان المَرْوَزِيّ . والفضل بن العبّاس بن مِهران الأصبهاني . ومحمد بن أسد المَدِينيّ . ومحمد بن عَبْدُوس بن كامل السّرّاج . وهميم بن همّام الطَّبَريّ الأَيْليّ .\u001fE4292",
