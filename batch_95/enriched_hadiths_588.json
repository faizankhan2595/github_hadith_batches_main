    {
      "hadith_id": 854810,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 3365,
      "text_ar": "القبض على ابن الجصّاص ومصادرته",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
      "created_at": "2025-11-04 07:49:23",
