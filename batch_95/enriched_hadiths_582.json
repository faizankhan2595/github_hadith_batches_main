    {
      "hadith_id": 854724,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 3279,
      "text_ar": "وفيها استتر أبو عليّ محمد بن عُبَيْد الله الخاقانيّ لوصول رُقْعة له إلى المقتدر يطلب فيها الوزارة فبعث بها إلى ابن الفرات فاتّهم ابن الفُرات عبد الله بن الحسن بن زوزان بأنّه يسعى لأبي عليّ في الوزارة فنفاه إلى الرَّقَّةِ .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
