    {
      "hadith_id": 854200,
      "book_id": 936,
      "chapter_id": null,
      "hadith_number": 2755,
      "text_ar": "وَفِي المُحرّم استأمن إِلَى الموفَّق جَعْفَر بْن إِبْرَاهِيم السّجَان ، وكان صاحب أسرار الخبيث وأحد خواصه ، فخلع عليه الموفَّق وأعطاه مالًا كثيرًا ، وأمر بحمله إِلَى قريب مدينة الخبيث ، فَلَمَّا حاذى قصر الخبيث صاح : ويْحكم إِلَى مَتَى تصبرون على هَذَا الخبيث الكذّاب ، وحدثهم بما اطَّلع عليه من كِذبه وفجوره ، فاستأمن فِي ذلك اليوم خلْق كثير منهم ، وتتابع النّاس فِي الخروج من عند الخبيث .\u001cE3981",
      "sanad_ar": "وَفِي المُحرّم استأمن إِلَى الموفَّق جَعْفَر بْن إِبْرَاهِيم السّجَان",
      "matn_ar": "وكان صاحب أسرار الخبيث وأحد خواصه ، فخلع عليه الموفَّق وأعطاه مالًا كثيرًا ، وأمر بحمله إِلَى قريب مدينة الخبيث ، فَلَمَّا حاذى قصر الخبيث صاح : ويْحكم إِلَى مَتَى تصبرون على هَذَا الخبيث الكذّاب ، وحدثهم بما اطَّلع عليه من كِذبه وفجوره ، فاستأمن فِي ذلك اليوم خلْق كثير منهم ، وتتابع النّاس فِي الخروج من عند الخبيث .\u001cE3981",
