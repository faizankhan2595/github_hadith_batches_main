    {
      "hadith_id": 998735,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 8181,
      "text_ar": "ويقَالُ : أَبُو يزيد ، ويقَالُ : أَبُو مُحَمَّد الكوفي . /10 الحارث بْن مسلم /10 /10 وخيثمة بْن أبي خيثمة البصري ت /10 /10 وزيد العمي ق /10 /10 وسالم بْن عَبْدِ اللَّهِ بْن عُمَرَ /10 /10 وطاوس بْن كيسان /10 /10 وعامر بْن شراحيل الشعبي ق /10 /10 وأبي الطفيل عامر بْن واثلة الليثي الصحابي /10 /10 وأبي حريز عَبْد اللَّهِ بْن الْحُسَيْن قاضي سجستان ق /10 /10 وعَبْد اللَّهِ بْن نجي فق /10 /10 وعَبْد اللَّهِ بْن عبد الرحمن بْن الأسود بْن يزيد ت /10 /10 وعطاء بْن أبي رباح /10 /10 وعكرمة مولى ابْن عباس ق /10 /10 وعمار الدهني ق /10 /10 والقاسم بْن عبد الرحمن بْن عَبْدِ اللَّهِ بْن مسعود ق /10 /10 والقاسم بْن مُحَمَّدِ بْن أَبِي بَكْرٍ الصديق /10 /10 ومجاهد بْن جبر ت /10 /10 ومحمد بْن قرظة الأنصاري ق /10 /10 وأبي الزبير مُحَمَّد بْن مسلم المكي ق /10 /10 وأبي الضحى مسلم بْن صبيح ق /10 /10 وأبي عازب مسلم بْن عمرو ق /10 /10 والمغيرة بْن شبيل د ق /10",
      "sanad_ar": "ويقَالُ",
      "matn_ar": "أَبُو يزيد ، ويقَالُ : أَبُو مُحَمَّد الكوفي . /10 الحارث بْن مسلم /10 /10 وخيثمة بْن أبي خيثمة البصري ت /10 /10 وزيد العمي ق /10 /10 وسالم بْن عَبْدِ اللَّهِ بْن عُمَرَ /10 /10 وطاوس بْن كيسان /10 /10 وعامر بْن شراحيل الشعبي ق /10 /10 وأبي الطفيل عامر بْن واثلة الليثي الصحابي /10 /10 وأبي حريز عَبْد اللَّهِ بْن الْحُسَيْن قاضي سجستان ق /10 /10 وعَبْد اللَّهِ بْن نجي فق /10 /10 وعَبْد اللَّهِ بْن عبد الرحمن بْن الأسود بْن يزيد ت /10 /10 وعطاء بْن أبي رباح /10 /10 وعكرمة مولى ابْن عباس ق /10 /10 وعمار الدهني ق /10 /10 والقاسم بْن عبد الرحمن بْن عَبْدِ اللَّهِ بْن مسعود ق /10 /10 والقاسم بْن مُحَمَّدِ بْن أَبِي بَكْرٍ الصديق /10 /10 ومجاهد بْن جبر ت /10 /10 ومحمد بْن قرظة الأنصاري ق /10 /10 وأبي الزبير مُحَمَّد بْن مسلم المكي ق /10 /10 وأبي الضحى مسلم بْن صبيح ق /10 /10 وأبي عازب مسلم بْن عمرو ق /10 /10 والمغيرة بْن شبيل د ق /10",
