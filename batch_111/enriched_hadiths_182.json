      "hadith_id": 992719,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 2165,
      "text_ar": "وقيل الأزدي مولاهم البصري أخو موسى بْن عَبْد الرحمن بْن مهدي /10 بريه بْن عمر بْن سفينة د ت /10 /10 وجعفر بْن سُلَيْمَان الضبعي /10 /10 وخالد بْن مخلد القطواني س /10 /10 وزيد بْن المبارك الصنعاني /10 /10 وسفيان بْن عيينة /10 /10 وسهل بْن محمود /10 /10 وسيار بْن حاتم /10 /10 وصغدي بْن أبي الحجراء /10 /10 وأبي همام عَبْد الخالق بْن عَبْد الله العبدي الزهراني /10 /10 وأبيه عَبْد الرحمن بْن مهدي /10 /10 وعبد السلام بْن حرب /10 /10 والمثنى بْن رفاعة الكوفي /10 /10 ومجالد بْن عبيد الله /10 /10 ومحمد بْن سُلَيْمَان بْن مسمول /10 /10 ومحمد بْن السمط المهلبي /10 /10 ومحمد بْن صالح الضبي /10 /10 ومروان بْن معاوية الفزاري /10 /10 ومضر القارى /10 /10 ومكي بْن إِبْرَاهِيم البلخي /10 /10 وأبي بكر بْن عياش /10",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
