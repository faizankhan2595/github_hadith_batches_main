    {
      "hadith_id": 993786,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 3232,
      "text_ar": "0 /11 البخاري ، ومات قبله /11 /11 وأبو بكر أحمد بْن عمرو بْن عَبْد الخالق البزار /11 /11 وأبو عمرو أحمد بْن مُحَمَّد بْن أحمد الحيري /11 /11 وإسحاق بْن عَبْد الله بْن سلمة البزاز /11 /11 وإسماعيل بْن العباس الوراق /11 /11 وجعفر بْن مُحَمَّد الصندلي /11 /11 والحسن بْن سعيد بْن يوسف /11 /11 وصالح بْن أحمد بْن أبي مقاتل /11 /11 والعباس بْن العباس بْن المغيرة الجوهري /11 /11 وأبو بكر عَبْد الله بْن أبي داود /11 /11 وأبو بكر عَبْد الله بْن مُحَمَّد بْن أبي الدنيا /11 /11 وعبد الله بْن مُحَمَّد بْن ناجية /11 /11 وعبد الله بْن مُحَمَّد بْن ياسين /11 /11 وعبد الرحمن بْن أبي حاتم الرازي /11 /11 وعلى بْن الحسن بْن هارون البغدادي الحنبلي /11 /11 والقاسم بْن زكريا المطرز /11 /11 وأبو العباس مُحَمَّد بْن إسحاق الثقفي السراج /11 /11 ومحمد بْن عَبْد الله بْن سُلَيْمَان الحضرمي /11 /11 ومحمد بْن مخلد الدوري /11 /11 ويعقوب بْن أحمد بْن عَبْد الرحمن الجصاص /11 /11 وأبو عيسى يعقوب بْن مُحَمَّد بْن عَبْد الوهاب /11 /11 ويوسف بْن إسحاق بْن   الحجاج /11 # قال",
      "sanad_ar": "0 /11 البخاري",
      "matn_ar": "ومات قبله /11 /11 وأبو بكر أحمد بْن عمرو بْن عَبْد الخالق البزار /11 /11 وأبو عمرو أحمد بْن مُحَمَّد بْن أحمد الحيري /11 /11 وإسحاق بْن عَبْد الله بْن سلمة البزاز /11 /11 وإسماعيل بْن العباس الوراق /11 /11 وجعفر بْن مُحَمَّد الصندلي /11 /11 والحسن بْن سعيد بْن يوسف /11 /11 وصالح بْن أحمد بْن أبي مقاتل /11 /11 والعباس بْن العباس بْن المغيرة الجوهري /11 /11 وأبو بكر عَبْد الله بْن أبي داود /11 /11 وأبو بكر عَبْد الله بْن مُحَمَّد بْن أبي الدنيا /11 /11 وعبد الله بْن مُحَمَّد بْن ناجية /11 /11 وعبد الله بْن مُحَمَّد بْن ياسين /11 /11 وعبد الرحمن بْن أبي حاتم الرازي /11 /11 وعلى بْن الحسن بْن هارون البغدادي الحنبلي /11 /11 والقاسم بْن زكريا المطرز /11 /11 وأبو العباس مُحَمَّد بْن إسحاق الثقفي السراج /11 /11 ومحمد بْن عَبْد الله بْن سُلَيْمَان الحضرمي /11 /11 ومحمد بْن مخلد الدوري /11 /11 ويعقوب بْن أحمد بْن عَبْد الرحمن الجصاص /11 /11 وأبو عيسى يعقوب بْن مُحَمَّد بْن عَبْد الوهاب /11 /11 ويوسف بْن إسحاق بْن   الحجاج /11 # قال",
