    {
      "hadith_id": 992217,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 1663,
      "text_ar": "وقيل إِبْرَاهِيم بن إِسْمَاعِيل بن يزيد بن مجمع بن جارية الأنصاري أبو إسحاق المدني /10 جعفر بْن عمرو بْن جعفر بْن عمرو بْن أمية الضمري /10 /10 وسالم بْن عَبْد الله بْن عمر /10 /10 وصالح بْن كيسان /10 /10 وطليق بْن عمران بْن حصين ق /10 /10 وأبي الزناد عَبْد الله بْن ذكوان /10 /10 وعبد الله بْن واقد بْن عَبْد الله بْن عمر ق /10 /10 وعبد الرحمن بْن خلاد /10 /10 وعبد الكريم بْن مالك الجزري ق /10 /10 وعثمان بْن كعب القرظي /10 /10 وعمرو بْن دينار ق /10 /10 ومحمد بْن كعب القرظي /10 /10 وأبي الزبير مُحَمَّد بْن مسلم بْن تدرس المكي ق /10 /10 ومحمد بْن مسلم بْن شهاب الزهري خت /10 /10 وهشام بْن عروة /10 /10 ووهب بْن كيسان /10 /10 ويحيى بْن سعيد الأنصاري /10 /10 ويحيى بْن عباد بْن جارية القيني /10 /10 وعم أبيه يعقوب بْن مجمع بْن جارية الأنصاري /10 /10 وأبي وجزة السعدي /10",
      "sanad_ar": "",
