    {
      "hadith_id": 991858,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 1304,
      "text_ar": "0 /11 الجماعة سوى البخاري /11 /11 وأَبُو يعلى أَحْمَد بْن علي بْن المثنى الموصلي /11 /11 وأَبُو يَعْقُوب إسحاق بْن إِبْرَاهِيم بْن جميل الأصبهاني عنده عَنْهُ المسند /11 /11 وجعفر بْن أَحْمَد بْن نصر الْحَافِظ /11 /11 والحسين بْن مُحَمَّد بْن زياد القباني /11 /11 وحسين غير منسوب قيل : إنه القباني وقيل : ابْن يحيى بْن جَعْفَر البيكندي /11 /11 وابن ابنته أَبُو الْقَاسِم عَبْد اللَّهِ بْن مُحَمَّد بْن عَبْد الْعَزِيزِ البغوي /11 /11 وعبد الله بْن مُحَمَّد بْن عبيد بْن أَبِي الدنيا /11 /11 وعبد الله بْن مُحَمَّد بْن ناجية /11 /11 والقاسم بْن زكريا المطرز /11 /11 ومحمد بْن أَحْمَد بْن مُحَمَّد الشطوي /11 /11 ومحمد بْن إسحاق بْن خزيمة /11 /11 ومحمد بْن إسحاق السراج /11 /11 ومحمد بْن إسحاق الصاغاني /11 /11 وأَبُو حامد مُحَمَّد بْن هارون الحضرمي /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 # قال",
      "sanad_ar": "0 /11 الجماعة سوى البخاري /11 /11 وأَبُو يعلى أَحْمَد بْن علي بْن المثنى الموصلي /11 /11 وأَبُو يَعْقُوب إسحاق بْن إِبْرَاهِيم بْن جميل الأصبهاني عنده عَنْهُ المسند /11 /11 وجعفر بْن أَحْمَد بْن نصر الْحَافِظ /11 /11 والحسين بْن مُحَمَّد بْن زياد القباني /11 /11 وحسين غير منسوب قيل",
      "matn_ar": "إنه القباني وقيل : ابْن يحيى بْن جَعْفَر البيكندي /11 /11 وابن ابنته أَبُو الْقَاسِم عَبْد اللَّهِ بْن مُحَمَّد بْن عَبْد الْعَزِيزِ البغوي /11 /11 وعبد الله بْن مُحَمَّد بْن عبيد بْن أَبِي الدنيا /11 /11 وعبد الله بْن مُحَمَّد بْن ناجية /11 /11 والقاسم بْن زكريا المطرز /11 /11 ومحمد بْن أَحْمَد بْن مُحَمَّد الشطوي /11 /11 ومحمد بْن إسحاق بْن خزيمة /11 /11 ومحمد بْن إسحاق السراج /11 /11 ومحمد بْن إسحاق الصاغاني /11 /11 وأَبُو حامد مُحَمَّد بْن هارون الحضرمي /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 # قال",
