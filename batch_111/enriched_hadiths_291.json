    {
      "hadith_id": 994353,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 3799,
      "text_ar": "نزيل نيسابور /10 أحمد بْن مُحَمَّد بْن حنبل ت سي وله عنه مسائل مفيدة /10 /10 وإسحاق بْن راهويه ت كذلك /10 /10 وإسحاق بْن سُلَيْمَان الرازي ق /10 /10 وبشر بْن شعيب بْن أبي حمزة س /10 /10 وبشر بْن عمر الزهراني /10 /10 وبهلول بْن مورق ق /10 /10 وجعفر بْن عون خ م /10 /10 وحيان بْن هلال خ م ت ق /10 /10 وحجاج بْن منهال /10 /10 وحسين بْن علي الجعفي خ م س /10 /10 وأبي اليمان الحكم بْن نافع /10 /10 وأبي أسامة حماد بْن أسامة خ م س ق /10 /10 وحيوة بْن شريح الحمصي /10 /10 وروح بْن عبادة خ م /10 /10 وزكريا بْن عدي م /10 /10 وسعيد بْن عامر الضبعي ت /10 /10 وسعيد بْن أبي مريم المصري ت /10 /10 وسفيان بْن عيينة ت س /10 /10 وأبي داود سُلَيْمَان بْن داود الطيالسي م تم س ق /10 /10 وسليمان بْن عَبْد الرحمن /10 /10 وصالح بْن زريق العطار ق /10 /10 وأبي عاصم الضحاك بْن مخلد النبيل م ت /10 /10 وعبد الله بْن بكر السهمي ت /10 /10 وعبد الله بْن نمير ت ق /10 /10 وأبي مسهر عَبْد الأعلى بْن مسهر الغساني م /10 /10 وعبد الرحمن بْن مهدي م ت س ق /10 /10 وعبد الرزاق بْن همام خ م ت س ق /10 /10 وعبد الصمد بْن عَبْد الوارث خ م ت س /10 /10 وأبي المغيرة عَبْد القدوس بْن الحجاج الخولاني خ م ت س /10 /10 وأبي بكر عَبْد الكبير بْن عَبْد المجيد الحنفي م /10 /10 وأبي عامر عَبْد الملك بْن عمرو العقدي م تم /10 /10 وعبد الوهاب بْن   عطاء الخفاف ق /10 /10 وأبي علي عبيد الله بْن عَبْد المجيد الحنفي م ق /10 /10 وعبيد الله بْن موسى م /10 /10 وعفان بْن مسلم خ ت /10 /10 وعلي بْن معبد بْن شداد الرفي /10 /10 وأبي داود عمر بْن سعد الحفري م /10 /10 وعمرو بْن الربيع بْن طارق المصري م /10 /10 وعيسى بْن المنذر الحمصي م /10 /10 وكثير بْن هشام م /10 /10 ومحمد بْن بكر البرساني م ق /10 /10 وأبي جعفر مُحَمَّد بْن جهضم م سى /10 /10 ومحمد بْن كثير الصنعاني س /10 /10 ومحمد بْن المبارك الصوري خ م /10 /10 ومحمد بْن يوسف الفريابي م ت س /10 /10 ومعاذ بْن هشام الدستوائي م ت /10 /10 وأبي هشام المغيرة بْن سلمة المخزومي م /10 /10 ومهنا بْن عَبْد الحميد عس /10 /10 والنضر بْن شميل المازني خ م س ق /10 /10 وهارون بْن إِسْمَاعِيل الخزاز ت /10 /10 وأبي الوليد هشام بْن عَبْد الملك الطيالسي م س /10 /10 وهشام بْن عمار الدمشقي /10 /10 ووكيع بْن الجراح /10 /10 ووهب بْن جرير بْن حازم ت س /10 /10 ويحيى بْن حماد الشيباني م /10 /10 ويحيى بْن سعيد القطان ت س ق /10 /10 ويحيى بْن صالح الوحاظي م /10 /10 ومزيد بْن عَبْد ربه الجرجسي م /10 /10 وزيد بْن هارون س /10 /10 ويعقوب بْن إِبْرَاهِيم بْن سعد خ س /10",
