    {
      "hadith_id": 991775,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 1221,
      "text_ar": "نزيل بغداد . أخو صَالِح بْن مُحَمَّد /10 بهلول بْن المورق /10 /10 وحسين بْن المثنى /10 /10 وحسين بْن علي الجعفي /10 /10 وأبي أسامة حَمَّاد بْن أسامة /10 /10 وزيد بْن الحباب /10 /10 وسعيد بْن عامر الضبعي /10 /10 وأبي داود سُلَيْمَان بْن داود الطيالسي /10 /10 وسويد بْن عَمْرو الكلبي /10 /10 وصفوان بْن عيسى الزهوي /10 /10 وعبد الله بْن نمير /10 /10 وعبد الرحمن بْن غزوان المعروف بقراد أَبِي نوح /10 /10 وعبد الرحمن بْن مهدي /10 /10 وأبي عامر عبد الملك بْن عَمْرو العقدي /10 /10 وعبيد بْن أَبِي قرة /10 /10 وعثمان بْن عُمَر بْن فارس /10 /10 وعفان بْن مسلم /10 /10 وعمرو بْن مُحَمَّد العنقزي ق /10 /10 وعمرو بْن النعمان /10 /10 وقريش بْن أنس /10 /10 ومحاضر بْن المورع /10 /10 ومحمد بْن بشر العبدي /10 /10 ومحمد بْن عُمَر الواقدي /10 /10 وأبيه مُحَمَّد بْن يحيى بْن سعيد القطان /10 /10 ومنصور بْن عكرمة /10 /10 وأبي النَّضْر هاشم بْن الْقَاسِم ق /10 /10 ويحيى بْن آدم /10 /10 ويحيى بْن حَمَّاد /10 /10 وجده يحيى بْن سعيد القطان /10 /10 ويحيى بْن عُمَر الفراء /10 /10 ويحيى بْن عيسى الرملي /10 /10 ويزيد بْن هارون /10 /10 ويونس بْن بُكَيْر الشَّيْبَانِيّ /10",
