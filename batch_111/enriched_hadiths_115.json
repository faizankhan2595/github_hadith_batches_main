      "hadith_id": 991714,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 1160,
      "text_ar": "وقيل أَحْمَد بْن مُحَمَّد بْن معروف بْن سنان وقيل أَحْمَد بْن مُحَمَّد بْن سيار الأزدي الحمصي أَبُو حميد العوهي /10 أَحْمَد بْن صَالِح المصري /10 /10 وبشر بْن شعيب بْن أَبِي حمزة /10 /10 وحيوة بْن شريح بْن يزيد الحمصي /10 /10 وسليم بْن عثمان الفوزي أخي الخطاب بْن عثمان /10 /10 وأبي حيوة شريح بْن يزيد الحمصي س /10 /10 وعبد السلام بْن مُحَمَّد الحضرمي /10 /10 وأبي المغيرة عبد القدوس بْن الحجاج الخولاني /10 /10 وعثمان بْن سعيد بْن كثير بْن دينار القرشي س /10 /10 ومحمد بْن المبارك الصوري /10 /10 ومحمد بْن المتوكل العسقلاني /10 /10 والمعافى بْن عِمْرَان الظهري الحمصي /10 /10 ومعاوية بْن حَفْص الشعبي سي /10 /10 وموسى بْن أيوب النصيبي /10 /10 ومؤمل بْن إِسْمَاعِيل /10 /10 ومؤمل بْن إهاب /10 /10 ويحيى بْن سعيد العطار الحمصي /10 /10 ويحيى بْن صَالِح الوحاظي /10",
