      "hadith_id": 996770,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 6216,
      "text_ar": "وهو البختري بْن المختار بْن ذريح العبدي الكوفي ، جد أَحْمَد بْن المعذل بْن غيلان بْن البختري ، وعم والد مُحَمَّد بْن بشر بْن الفرافصة بْن المختار العبدي . /10 عبد الرحمن بْن مسعود اليشكري /10 /10 وعبد الرحمن بْن معقل بْن مقرن المزني /10 /10 وأبي الْحَسَن عبيد بْن الْحَسَن المزني /10 /10 وعيسى بْن مُوسَى بْن طلحة بْن عبيد اللَّه /10 /10 وأبي بردة بْن أبي مُوسَى الأشعري /10 /10 وأَبِي بَكْرِ بْن عمارة بْن رويبة الثقفي م س /10 /10 وأَبِي بَكْرِ بْن أبي مُوسَى الأشعري /10",
      "sanad_ar": "وهو البختري بْن المختار بْن ذريح العبدي الكوفي",
      "matn_ar": "جد أَحْمَد بْن المعذل بْن غيلان بْن البختري ، وعم والد مُحَمَّد بْن بشر بْن الفرافصة بْن المختار العبدي . /10 عبد الرحمن بْن مسعود اليشكري /10 /10 وعبد الرحمن بْن معقل بْن مقرن المزني /10 /10 وأبي الْحَسَن عبيد بْن الْحَسَن المزني /10 /10 وعيسى بْن مُوسَى بْن طلحة بْن عبيد اللَّه /10 /10 وأبي بردة بْن أبي مُوسَى الأشعري /10 /10 وأَبِي بَكْرِ بْن عمارة بْن رويبة الثقفي م س /10 /10 وأَبِي بَكْرِ بْن أبي مُوسَى الأشعري /10",
