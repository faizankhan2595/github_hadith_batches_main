    {
      "hadith_id": 992137,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 1583,
      "text_ar": "وقيل التميمي أبو إسحاق البلخي الزاهد سكن الشام . /10 أبان بْن أبي عياش /10 /10 وإبراهيم بْن ميمون الصائغ /10 /10 وأبيه أدهم بْن منصور البلخي /10 /10 وسعيد بْن المرزبان أبي سعد البقال /10 /10 وسفيان الثوري /10 /10 وسليمان الأعمش /10 /10 وشعبة بْن الحجاج /10 /10 وعباد بْن كثير الثقفي /10 /10 وعبد الله بْن شوذب /10 /10 وعبد الرحمن بْن عمرو الأوزاعي /10 /10 وعبيد الله بْن عمر العمري /10 /10 وعطاء بْن عجلان /10 /10 وأبي إسحاق عمرو بْن عَبْد الله السبيعي /10 /10 وفروة بْن مجاهد اللخمي /10 /10 ومالك بْن دينار /10 /10 ومحمد بْن زياد الجمحي /10 /10 ومحمد بْن عجلان /10 /10 وأبي جعفر مُحَمَّد بْن علي بْن الحسين بْن علي بْن أبي طالب /10 /10 ومحمد بْن الوليد الزبيدي /10 /10 ومقاتل بْن حيان النبطي ت /10 /10 ومنصور بْن المعتمر /10 /10 وموسى بْن عقبة /10 /10 وموسى بْن يزيد البصري /10 /10 ونهاس بْن قهم /10 /10 وهشام بْن حسان /10 /10 ويحيى بْن سعيد الأنصاري /10 /10 ويزيد بْن أبان الرقاشي /10 /10 وأبي بكر بْن أسماء /10 /10 وأبي عَبْد الله الخراساني /10 /10 وأبي عيسى المروزي /10",
      "sanad_ar": "",
      "matn_ar": "",
