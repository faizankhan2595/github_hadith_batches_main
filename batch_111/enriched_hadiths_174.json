      "hadith_number": 2050,
      "text_ar": "2 أَخْبَرَنَا /26 أبو بكر الحافظ /26 ، قال: حدثني /26 الحسين بْن علي الطناجيري /26 قال : حَدَّثَنَا /26 عمر بْن أحمد الواعظ /26 ، قال: حدثني /26 مُحَمَّد بْن عمر بْن غالب /26 ، قال : حدثني /26 جعفر بْن مُحَمَّد النيسابوري /26   ، قال : /27 حَدَّثَنَا /26 يحيى بْن مُحَمَّد بْن يحيى النيسابوري /26",
