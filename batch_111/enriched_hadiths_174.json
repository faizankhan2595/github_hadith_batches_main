      "hadith_id": 992602,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 2048,
      "text_ar": "1 /94 أبو الحسن علي بْن أحمد بْن عَبْد الواحد المقدسي /94 ، أَخْبَرَنَا /26 أبو اليمن زيد بْن الحسن الكندي /26 سنة ست مائة ، قال : أَخْبَرَنَا /26 أبو منصور عَبْد الرحمن بْن مُحَمَّد الشيباني /26 ، قال : أَخْبَرَنَا /26 أبو بكر أحمد بْن علي بْن ثابت الحافظ /26 ، قال : أَخْبَرَنَا /26 مُحَمَّد بْن عمر بْن بكير /26 ، قال : حَدَّثَنَا /26 الحسين بْن أحمد الهروي الصفار /26 قال : حَدَّثَنَا /26 أحمد بْن مُحَمَّد بْن ياسين /26 ، قال : سمعت /26 إسحاق بْن مُحَمَّد بْن بورجة /26 ، يقول : قال /26 مالك بْن سُلَيْمَان /26 :",
      "sanad_ar": "1 /94 أبو الحسن علي بْن أحمد بْن عَبْد الواحد المقدسي /94",
      "matn_ar": "أَخْبَرَنَا /26 أبو اليمن زيد بْن الحسن الكندي /26 سنة ست مائة ، قال : أَخْبَرَنَا /26 أبو منصور عَبْد الرحمن بْن مُحَمَّد الشيباني /26 ، قال : أَخْبَرَنَا /26 أبو بكر أحمد بْن علي بْن ثابت الحافظ /26 ، قال : أَخْبَرَنَا /26 مُحَمَّد بْن عمر بْن بكير /26 ، قال : حَدَّثَنَا /26 الحسين بْن أحمد الهروي الصفار /26 قال : حَدَّثَنَا /26 أحمد بْن مُحَمَّد بْن ياسين /26 ، قال : سمعت /26 إسحاق بْن مُحَمَّد بْن بورجة /26 ، يقول : قال /26 مالك بْن سُلَيْمَان /26 :",
