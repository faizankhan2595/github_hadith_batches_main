    {
      "hadith_id": 995255,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 4701,
      "text_ar": "0 /11 إِسْمَاعِيل بْن رافع المدني /11 /11 وربيعة بْن يزيد عخ /11 /11 وأبو المقدام رجاء بْن أبي سلمة /11 /11 وسعيد بْن بشير /11 /11 وسعيد بْن عبد العزيز م د س /11 /11 وعبد اللَّه بْن عَبْد الرَّحْمَنِ بْن يزيد بْن جَابِر قد /11 /11 وعبد ربه بْن ميمون الأشعري /11 /11 وعَبْد الرَّحْمَنِ بْن عمرو الأوزاعي ق /11 /11 وعَبْد الرَّحْمَنِ بْن يزيد بْن تميم ق /11 /11 وعَبْد الرَّحْمَنِ بْن يزيد بْن جَابِر خ قد س ق /11 /11 وعبد الرزاق بْن عمر الثقفي /11 /11 وابنه عبد العزيز بْن إِسْمَاعِيل بْن عبيد اللَّه /11 /11 وعمرو بْن واقد   /11 /11 وأبو مُحَمَّد عِيسَى بْن موسى القرشي عخ سي أخو سُلَيْمَان بْن موسى /11 /11 وكلثوم بْن زياد المحاربي /11 /11 ومحمد بْن الحجاج القرشي /11 /11 ومحمد بْن سعيد الشامي المصلوب /11 /11 ومحمد بْن مهاجر الأَنْصَارِيّ /11 /11 ومدرك بْن أبي سعد الفزاري /11 /11 ومنصور بْن رجاء /11 /11 والهيثم بْن عمران العنسي /11 /11 وابنه يَحْيَى بْن إِسْمَاعِيل بْن عبيد اللَّه /11 ++ [ وأدرك الحارث بْن الحارث الغامدي ، وعبد اللَّه بْن عمرو بْن العاص ، وعطية بْن عروة السعدي ، ومعاوية بْن أبي سفيان ] #",
      "sanad_ar": "0 /11 إِسْمَاعِيل بْن رافع المدني /11 /11 وربيعة بْن يزيد عخ /11 /11 وأبو المقدام رجاء بْن أبي سلمة /11 /11 وسعيد بْن بشير /11 /11 وسعيد بْن عبد العزيز م د س /11 /11 وعبد اللَّه بْن عَبْد الرَّحْمَنِ بْن يزيد بْن جَابِر قد /11 /11 وعبد ربه بْن ميمون الأشعري /11 /11 وعَبْد الرَّحْمَنِ بْن عمرو الأوزاعي ق /11 /11 وعَبْد الرَّحْمَنِ بْن يزيد بْن تميم ق /11 /11 وعَبْد الرَّحْمَنِ بْن يزيد بْن جَابِر خ قد س ق /11 /11 وعبد الرزاق بْن عمر الثقفي /11 /11 وابنه عبد العزيز بْن إِسْمَاعِيل بْن عبيد اللَّه /11 /11 وعمرو بْن واقد   /11 /11 وأبو مُحَمَّد عِيسَى بْن موسى القرشي عخ سي أخو سُلَيْمَان بْن موسى /11 /11 وكلثوم بْن زياد المحاربي /11 /11 ومحمد بْن الحجاج القرشي /11 /11 ومحمد بْن سعيد الشامي المصلوب /11 /11 ومحمد بْن مهاجر الأَنْصَارِيّ /11 /11 ومدرك بْن أبي سعد الفزاري /11 /11 ومنصور بْن رجاء /11 /11 والهيثم بْن عمران العنسي /11 /11 وابنه يَحْيَى بْن إِسْمَاعِيل بْن عبيد اللَّه /11 ++ [ وأدرك الحارث بْن الحارث الغامدي",
      "matn_ar": "وعبد اللَّه بْن عمرو بْن العاص ، وعطية بْن عروة السعدي ، ومعاوية بْن أبي سفيان ] #",
