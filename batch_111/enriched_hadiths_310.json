    {
      "hadith_id": 994643,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 4089,
      "text_ar": "0 /11 إِبْرَاهِيم بْن إِسْحَاق بْن عِيسَى بْن سلمة بْن عَبْد اللَّهِ بْن حنظلة الغسيلي الأَنْصَارِيّ /11 /11 وإبراهيم بْن عَبْد اللَّهِ بْن أَيُّوب المخرمي /11 /11 وإبراهيم بْن عَبْد اللَّهِ بْن الجنيد الختلي /11 /11 وأحمد بْن الحسن بْن عبد الجبار الصوفي الكبير /11 /11 وأحمد بْن الحسين بْن إِسْحَاق الصوفي الصغير /11 /11 وأبو بكر أَحْمَد بْن أبي خيثمة /11 /11 وأحمد بْن عبيد القنطري /11 /11 وأبو يعلى أَحْمَد بْن علي بْن المثنى الموصلي   /11 /11 وأحمد بْن مُحَمَّد بْن أبان بْن ميمون السراج /11 /11 وأحمد بْن مُحَمَّد بْن الجعد الوشاء /11 /11 وإسحاق بْن إِبْرَاهِيم بْن يونس المنجنيقي /11 /11 وحامد بْن مُحَمَّد بْن شعيب البلخي /11 /11 وزكريا بْن يَحْيَى السجزي س /11 /11 وسليمان بْن أَيُّوب بْن حذلم الدِّمَشْقِيّ /11 /11 وسهل بْن علي الدوري /11 /11 وأبو علي صالح بْن مُحَمَّد الحافظ /11 /11 والعباس بْن أَحْمَدَ الوشاء /11 /11 وعبد اللَّه بْن أَحْمَدَ بْن حنبل /11 /11 وأبو طالب عَبْد اللَّهِ بْن أَحْمَدَ بْن سوادة /11 /11 وعبد اللَّه بْن عَبْد الرَّحْمَنِ الدارمي /11 /11 وأبو بكر عَبْد اللَّهِ بْن مُحَمَّد بْن أبي الدنيا /11 /11 وعبد اللَّه بْن مُحَمَّد بْن عبد العزيز البغوي /11 /11 وأبو زرعة عبيد اللَّه بْن عبد الكريم الرازي /11 /11 وأبو القاسم علي بْن الحسين بْن أبي العنبر المروذي /11 /11 وعمر بْن عبد العزيز بْن مقلاص /11 /11 والفضل بْن مُحَمَّد بْن رومي /11 /11 ومحمد بْن إِبْرَاهِيم بْن أبان السراج /11 /11 ومحمد بْن الحسين البرجلاني /11 /11 ومحمد بْن سعد كاتب الواقدي /11 /11 ومحمد بْن صالح بْن ذريح العكبري /11 /11 ومحمد بْن عبدوس بْن كامل السراج /11 /11 ومحمد بْن علي بْن شعيب السمسار /11 /11 ومحمد بْن موسى النهرتيري /11 /11 ومحمد بْن واصل الْمُقْرِئ /11 /11 وموسى بْن إِسْحَاق بْن موسى الأَنْصَارِيّ القاضي /11 # قال",
