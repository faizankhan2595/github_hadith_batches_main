    {
      "hadith_id": 997363,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 6809,
      "text_ar": "والد إسماعيل بْن بشر بْن منصور ، وسليمة من ولد مالك بْن فهم من الأزد . /10 أيوب السختياني /10 /10 وثور بْن يزيد الحمصي /10 /10 وحمزة بْن نجيح البصري /10 /10 وخالد بْن رباح أبي الفضل الهذلي البصري /10 /10 وزهير بْن مُحَمَّدٍ التميمي سي /10 /10 وسعيد بْن إياس الجريري م /10 /10 وسفيان الثوري /10 /10 وشعبة بْن الحجاج /10 /10 وشعيب بْن الحبحاب /10 /10 وعاصم بْن سليمان الأحول س /10 /10 وعبد الرحمن بْن إِسْحَاقَ المدني د /10 /10 وعبد العزيز بْن أبي رواد /10 /10 وعبد الملك بْن عبد العزيز بْن جريج د /10 /10 وعبيد اللَّه بْن عُمَرَ العمري /10 /10 وعطاء السليمي /10 /10 وعمر بْن مُحَمَّدِ بْن المنكدر /10 /10 وعمر بْن نبهان /10 /10 وقزعة بْن سود الباهلي /10 /10 ومحمد بْن عجلان /10 /10 ومغيرة بْن زياد الموصلي /10 /10 وأبي حرة واصل بْن عبد الرحمن البصري /10 /10 ووهيب بْن الورد المكي /10",
      "sanad_ar": "والد إسماعيل بْن بشر بْن منصور",
      "matn_ar": "وسليمة من ولد مالك بْن فهم من الأزد . /10 أيوب السختياني /10 /10 وثور بْن يزيد الحمصي /10 /10 وحمزة بْن نجيح البصري /10 /10 وخالد بْن رباح أبي الفضل الهذلي البصري /10 /10 وزهير بْن مُحَمَّدٍ التميمي سي /10 /10 وسعيد بْن إياس الجريري م /10 /10 وسفيان الثوري /10 /10 وشعبة بْن الحجاج /10 /10 وشعيب بْن الحبحاب /10 /10 وعاصم بْن سليمان الأحول س /10 /10 وعبد الرحمن بْن إِسْحَاقَ المدني د /10 /10 وعبد العزيز بْن أبي رواد /10 /10 وعبد الملك بْن عبد العزيز بْن جريج د /10 /10 وعبيد اللَّه بْن عُمَرَ العمري /10 /10 وعطاء السليمي /10 /10 وعمر بْن مُحَمَّدِ بْن المنكدر /10 /10 وعمر بْن نبهان /10 /10 وقزعة بْن سود الباهلي /10 /10 ومحمد بْن عجلان /10 /10 ومغيرة بْن زياد الموصلي /10 /10 وأبي حرة واصل بْن عبد الرحمن البصري /10 /10 ووهيب بْن الورد المكي /10",
      "grade": null,
