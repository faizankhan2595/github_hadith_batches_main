    {
      "hadith_id": 997364,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 6810,
      "text_ar": "0 /11 أَحْمَد بْن عبيد اللَّه الغداني /11 /11 وأزهر بْن مروان الرقاشي /11 /11 وابنه إسماعيل بْن بشر بْن منصور /11 /11 وأيوب بْن عَبْد اللَّهِ الأنصاري /11 /11 وبشر بْن الحارث الحافي /11 /11 والحسين بْن حفص الأصبهاني /11 /11 وزهير بْن نعيم البابي أَبُو عبد الرحمن السجستاني /11 /11 وسليمان بْن حرب /11 /11 وسيار بْن حاتم /11 /11 وشيبان بْن فروخ /11 /11 والعباس بْن الوليد النرسي /11 /11 وابن عمه عبد الأعلى بْن حماد النرسي سي /11 /11 وأَبُو همام عبد الخالق الزهراني /11 /11 وعبد الرحمن بْن مهدي د /11 /11 وعبد العزيز بْن السري د /11 /11 وعبيد اللَّه بْن عُمَرَ القواريري س /11 /11 وعثمان بْن حرب البصري بلبل /11 /11 وعلي بْن المديني /11 /11 وأَبُو المعتمر عمار بْن زربي /11 /11 وعمرو بْن مُحَمَّدِ بْن أبي رزين /11 /11 وعون   بْن معمر /11 /11 وأَبُو كامل فضيل بْن حسين الجحدري /11 /11 وفضيل بْن عياض وهو من أقرانه /11 /11 وقرة بْن سليمان الجهضمي /11 /11 وقطن بْن نسير أَبُو عباد الغبري /11 /11 وأَبُو بَكْر مُحَمَّد بْن خلاد الباهلي /11 /11 ومحمد بْن عَبْد اللَّهِ الرقاشي /11 /11 ومحمد بْن عبد العزيز بْن سلمان /11 /11 ومحمد بْن فضالة العابد /11 /11 ومعاذ أَبُو عون /11 /11 ووداع بْن مرجى بْن وداع الراسبي /11 /11 و يحيى بْن بسطام الزهراني /11 /11 ويوسف بْن حماد المعني س /11 # قال",
      "sanad_ar": "",
      "matn_ar": "",
