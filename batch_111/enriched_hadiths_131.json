      "hadith_id": 991960,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 1406,
      "text_ar": "العابد /10 إِبْرَاهِيم بْن مُحَمَّد بْن ميمون الكوفي /10 /10 وأَحْمَد بْن الْمُفَضَّل الحفري /10 /10 وإسحاق بْن مَنْصُور السلولي س /10 /10 وإسماعيل بْن أبان الْوَرَّاق /10 /10 وإسماعيل بْن بهرام الخزاز /10 /10 وإسماعيل بْن أَبِي الحكم الثقفي /10 /10 وأسيد بْن زَيْد الجمال /10 /10 والحسن بْن الحسين العرني /10 /10 والحسن بْن علي الصفار /10 /10 والحسين بْن يزيد الطحان /10 /10 وأبي أسامة حَمَّاد بْن أسامة /10 /10 وزيد بْن الحباب /10 /10 وأبي نعيم ضرار بْن صرد /10 /10 وعبد الله بْن مُحَمَّد بْن سالم المفلوج /10 /10 وعبد الحميد بْن صَالِح /10 /10 وعبد الرحمن بْن دبيس الملائي /10 /10 وعبد الرحمن بْن شريك بْن عَبْد اللَّهِ النخعي /10 /10 وعبيد الله بْن مُوسَى /10 /10 وعثمان بْن سعيد الأحول الكوفي /10 /10 وعلي بْن ثَابِت الدهان /10 /10 وعلي بْن حكيم الأودي /10 /10 وعلي بْن قادم ص /10 /10 وأبي نعيم الفضل بْن دكين س /10 /10 وأبي غسان مَالِك بْن إِسْمَاعِيل النهدي /10 /10 ومحمد بْن بشر العبدي س /10 /10 ومحمد بْن عبيد الطنافسي س /10 /10 ومحمد بْن عقبة الشَّيْبَانِيّ /10 /10 ومخول بْن إِبْرَاهِيم بْن مخول بْن راشد النهدي /10 /10 ويحيى بْن إِسْمَاعِيل الخواص /10 /10 ويعلى بْن عبيد الطنافسي /10 /10 ويوسف بْن يَعْقُوب الصفار /10",
