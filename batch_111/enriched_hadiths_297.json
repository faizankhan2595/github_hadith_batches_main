    {
      "hadith_id": 994454,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 3900,
      "text_ar": "والد مُحَمَّد بْن إسحاق بْن يسار المطلبي المدني مولى مُحَمَّد بْن قيس بْن مخرمة بْن المطلب بْن عَبْد مناف رأى معاوية بْن أبي سفيان ، وكثير بْن الصلت . /10 الحسن بْن علي بْن أبي طالب /10 /10 وعبيد الله بْن عَبْد الله بْن عتبة بْن مسعود /10 /10 وعروة بْن الزبير بْن العوام /10 /10 والمغيرة بْن عَبْد الرحمن بْن الحارث بْن هشام مد /10 /10 ومقسم مولى عَبْد اللَّه بْن الحارث بْن نوفل /10",
      "sanad_ar": "والد مُحَمَّد بْن إسحاق بْن يسار المطلبي المدني مولى مُحَمَّد بْن قيس بْن مخرمة بْن المطلب بْن عَبْد مناف رأى معاوية بْن أبي سفيان",
      "matn_ar": "وكثير بْن الصلت . /10 الحسن بْن علي بْن أبي طالب /10 /10 وعبيد الله بْن عَبْد الله بْن عتبة بْن مسعود /10 /10 وعروة بْن الزبير بْن العوام /10 /10 والمغيرة بْن عَبْد الرحمن بْن الحارث بْن هشام مد /10 /10 ومقسم مولى عَبْد اللَّه بْن الحارث بْن نوفل /10",
