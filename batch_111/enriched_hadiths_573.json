      "chapter_id": null,
      "hadith_number": 8027,
      "text_ar": "واسمه سعيد بْن علاقة القرشي الهاشمي أَبُو الجهم الكوفي مولى أم هانئ بنت أبي طالب . وقيل : مولى زوجها جعدة بْن هبيرة المخزومي . /10 زيد بْن أرقم /10 /10 وسعيد بْن جبير /10 /10 وأبيه أبي فاختة سعيد بْن علاقة ت /10 /10 والطفيل بْن أبي كعب /10 /10 وعَبْد اللَّهِ بْن الزبير /10 /10 وعَبْد اللَّهِ بْن عُمَرَ بْن الخطاب ت /10 /10 ومجاهد بْن جبر ت /10 /10 وأبي جعفر مُحَمَّد بْن عَلِيِّ بْن الْحُسَيْن /10 /10 ويحيى بْن جعفر بْن هبيرة وعن رجل من أهل قباء عَنْ أبيه ت /10",
      "sanad_ar": "واسمه سعيد بْن علاقة القرشي الهاشمي أَبُو الجهم الكوفي مولى أم هانئ بنت أبي طالب . وقيل",
      "matn_ar": "مولى زوجها جعدة بْن هبيرة المخزومي . /10 زيد بْن أرقم /10 /10 وسعيد بْن جبير /10 /10 وأبيه أبي فاختة سعيد بْن علاقة ت /10 /10 والطفيل بْن أبي كعب /10 /10 وعَبْد اللَّهِ بْن الزبير /10 /10 وعَبْد اللَّهِ بْن عُمَرَ بْن الخطاب ت /10 /10 ومجاهد بْن جبر ت /10 /10 وأبي جعفر مُحَمَّد بْن عَلِيِّ بْن الْحُسَيْن /10 /10 ويحيى بْن جعفر بْن هبيرة وعن رجل من أهل قباء عَنْ أبيه ت /10",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10",
