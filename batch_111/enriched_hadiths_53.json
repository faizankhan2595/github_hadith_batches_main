    {
      "hadith_id": 990783,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 229,
      "text_ar": "الْحَافِظ . صاحب أَحْمَد بْن حنبل . رحال طوف الشام . ومصر . والعراق . والحجاز . /10 أَحْمَد بْن مُحَمَّد بْن حنبل خ ت /10 /10 وآدم بْن أَبِي إياس العسقلاني /10 /10 والأسود بْن عامر شاذان /10 /10 وأصبغ بْن الفرج المصري ت /10 /10 وحجاج بْن إِبْرَاهِيم الأزرق /10 /10 وحجاج بْن نصير الفساطيطي ت /10 /10 والحسن بْن بشر البجلي /10 /10 والحسن بْن الربيع البوراني /10 /10 والربيع بْن روح الحمصي /10 /10 وأبي توبة الربيع بْن نَافِع الحلبي /10 /10 وسعيد بْن الحكم بْن أَبِي مريم المصري ت /10 /10 وسعيد بْن كثير بْن عفير المصري /10 /10 وسليمان بْن داود الهاشمي ت /10 /10 وسليمان بْن عَبْد الرَّحْمَنِ الدمشقي ت /10 /10 والضحاك بْن مخلد أَبِي عاصم النبيل البصري /10 /10 وأبي صَالِح عَبْد اللَّهِ بْن صَالِح المصري كاتب الليث بْن سعد /10 /10 وأبي عَبْد الرَّحْمَنِ عَبْد اللَّهِ بْن مسلمة بْن قعنب القعنبي ت /10 /10 وعبد الله بْن نَافِع الصائغ المدني ت /10 /10 وعبد الملك بْن إِبْرَاهِيم الجدي ت /10 /10 وعبيد الله بْن مُوسَى العبسي الكوفي /10 /10 وعلي بْن عياش الحمصي /10 /10 وعمرو بْن عاصم الكلابي /10 /10 وأبي نعيم الفضل بْن دكين الملائي /10 /10 وقيس بْن حَفْص الدارمي /10 /10 ومحمد بْن عَبْد اللَّهِ الأنصاري /10 /10 وأبي الجماهر مُحَمَّد بْن عثمان التنوخي الكفرسوسي /10 /10 ومحمد بْن عرعرة بْن البرند السامي البصري /10 /10 ومحمد بْن عيسى بْن الطباع /10 /10 ومحمد بْن الفضل السدوسي عارم /10 /10 ومحمد بْن مصعب القرقساني /10 /10 ومحمد بْن مُوسَى بْن بزيع الشَّيْبَانِيّ /10 /10 ومحمد بْن يُوسُف الفريابي /10 /10 ومعقل بْن مَالِك الباهلي /10 /10 ومعلى بْن أسد العمي ت /10 /10 وأبي سَلَمَة مُوسَى بْن إِسْمَاعِيل التبوذكي ت /10 /10 ونعيم   بْن حَمَّاد الخزاعي /10 /10 وأبي النَّضْر هاشم بْن الْقَاسِم /10 /10 ووضاح بْن يحيى النهشلي /10 /10 ويحيى بْن سُلَيْمَان الجعفي ت /10 /10 ويحيى بْن صَالِح الوحاظي /10 /10 ويزيد بْن عبد ربه الحمصي المعروف بالجرجسي /10 /10 ومعلى بْن عبيد الطنافسي /10",
