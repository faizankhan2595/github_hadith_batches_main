    {
      "hadith_id": 991092,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 538,
      "text_ar": "0 /11 البخاري /11 /11 وأَبُو داود /11 /11 والنسائي /11 /11 وأَبُو الْعَبَّاس أَحْمَد بْن جَعْفَر بْن نصر الجمال الرازي /11 /11 وأَبُو العلاء أَحْمَد بْن صَالِح بْن مُحَمَّد التَّمِيمِيّ الصوري الأثط /11 /11 وإسحاق بْن أَحْمَد الفارسي /11 /11 والحسن بْن عثمان التستري /11 /11 والعباس بْن الفضل بْن شاذان /11 /11 وأَبُو بَكْر عَبْد اللَّهِ بْن أَبِي داود السجستاني /11 /11 وأَبُو زرعة عُبَيْد اللَّهِ بْن عبد الكريم الرازي /11 /11 وعلي بْن الحسين بْن الجنيد /11 /11 وأَبُو حَاتِم مُحَمَّد بْن إدريس الرازي /11 /11 ومحمد بْن الْعَبَّاس   بْن بسام /11 /11 وأَبُو بَكْر مُحَمَّد بْن يُوسُف بْن يَعْقُوب الرازي /11 /11 ومحمد غير منسوب قيل : إنه ابْن يحيى الذهلي خ /11 /11 ويعقوب بْن شيبة السدوسي /11 # قال",
      "sanad_ar": "0 /11 البخاري /11 /11 وأَبُو داود /11 /11 والنسائي /11 /11 وأَبُو الْعَبَّاس أَحْمَد بْن جَعْفَر بْن نصر الجمال الرازي /11 /11 وأَبُو العلاء أَحْمَد بْن صَالِح بْن مُحَمَّد التَّمِيمِيّ الصوري الأثط /11 /11 وإسحاق بْن أَحْمَد الفارسي /11 /11 والحسن بْن عثمان التستري /11 /11 والعباس بْن الفضل بْن شاذان /11 /11 وأَبُو بَكْر عَبْد اللَّهِ بْن أَبِي داود السجستاني /11 /11 وأَبُو زرعة عُبَيْد اللَّهِ بْن عبد الكريم الرازي /11 /11 وعلي بْن الحسين بْن الجنيد /11 /11 وأَبُو حَاتِم مُحَمَّد بْن إدريس الرازي /11 /11 ومحمد بْن الْعَبَّاس   بْن بسام /11 /11 وأَبُو بَكْر مُحَمَّد بْن يُوسُف بْن يَعْقُوب الرازي /11 /11 ومحمد غير منسوب قيل",
      "matn_ar": "إنه ابْن يحيى الذهلي خ /11 /11 ويعقوب بْن شيبة السدوسي /11 # قال",
