    {
      "hadith_id": 993941,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 3387,
      "text_ar": "واسمه إِبْرَاهِيم بْن كامجر المروزي أبو يعقوب نزيل بغداد /10 إِبْرَاهِيم بْن سعد الزهري /10 /10 جعفر بْن سُلَيْمَان الضبعي /10 /10 حسين بْن علي الجعفي /10 /10 حماد بْن زيد /10 /10 حمزة بْن الحارث بْن عمير /10 /10 حميد بْن عَبْد الرحمن الرؤاسي /10 /10 سفيان بْن عيينة /10 /10 سليم بْن أخضر /10 /10 شريك بْن عَبْد الله النخعي /10 /10 عباد بْن ليث الكرابيسي /10 /10 عَبْد الله بْن إِبْرَاهِيم بْن عمر بْن كيسان عَبْد الله بْن جعفر بْن نجيح المديني /10 /10 عَبْد الله بْن رجاء المكي /10 /10 عَبْد الرحمن بْن أبي الزناد /10 /10 عَبْد الرحمن بْن مهدي /10 /10 عَبْد الرزاق بْن همام /10 /10 عَبْد العزيز بْن أبي حازم /10 /10 عَبْد القدوس بْن حبيب الشامي /10 /10 أبي هشام عَبْد الملك بْن عَبْد الرحمن الذماري /10 /10 وعبد الواحد بْن زياد /10 /10 وعبد الوارث بْن سعيد /10 /10 وعلي بْن هاشم بْن البريد /10 /10 وعيسى بْن يونس /10 /10 وفضيل بْن عياض /10 /10 وكثير بْن عَبْد الله الإبلي /10 /10 ومحمد بْن جابر الحنفي اليمامي /10 /10 ومحمد بْن المنيب العدني سي /10 /10 والنضر بْن شميل /10 /10 والنضر بْن علقمة بخ /10 /10 وهشام بْن يوسف الصنعاني د /10 /10 ورأى زائدة بْن ندامة /10",
