    {
      "hadith_id": 990923,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 369,
      "text_ar": "واسمه يزيد بْن لاعي الجزري أَبُو الحسين الرهاوي الْحَافِظ /10 جَعْفَر بْن عون العمري س /10 /10 والحسن بْن مُحَمَّد بْن أعين الحراني س /10 /10 وحسين بْن علي الجعفي س /10 /10 وحفص أَبِي عُمَر الإمام /10 /10 والخضر بْن مُحَمَّد بْن شجاع الجزري /10 /10 وروح بْن عبادة /10 /10 وزيد بْن الحباب س /10 /10 وسريج بْن يونس /10 /10 وسعيد بْن حَفْص النفيلي الحراني س /10 /10 وسعيد بْن عَبْد الْجَبَّارِ الرهاوي /10 /10 وسعيد بْن مروان الأزدي الرهاوي سي /10 /10 وأبي جَعْفَر عَبْد اللَّهِ بْن مُحَمَّد بْن علي النفيلي س /10 /10 وأبي قتادة عَبْد اللَّهِ بْن واقد الحراني /10 /10 وعبد الجبار بْن مُحَمَّد الخطابي /10 /10 وعبد الرحمن بْن عَمْرو البجلي /10 /10 وعبد الرحيم بْن مطرف الرؤاسي /10 /10 وعبد الرحيم بْن هارون الغساني /10 /10 وأبي الأصبغ عَبْد الْعَزِيزِ بْن يحيى الحراني /10 /10 وعبيد الله بْن مُوسَى س /10 /10 وعثمان بْن عَبْد الرَّحْمَنِ الطرائفي س /10 /10 وعفان بْن مسلم الصفار س /10 /10 وعمر بْن سعد أَبِي داود الحفري س /10 /10 وعمرو بْن عون الواسطي س /10 /10 وأبي نعيم الفضل بْن دكين س /10 /10 وأبي علي الفضل بْن عيسى /10 /10 وقبيصة بْن عقبة عس /10 /10 وقتادة بْن الفضيل الرهاوي س /10 /10 وأبي غسان مَالِك بْن إِسْمَاعِيل النهدي سي /10 /10 ومحاضر بْن المورع س /10 /10 ومحمد بْن بشر العبدي س /10 /10 ومحمد بْن سُلَيْمَان بْن أَبِي داود الحراني س /10 /10 ومحمد بْن عبيد الطنافسي س /10 /10 ومحمد بْن الفضل عارم س /10 /10 ومسكين بْن بُكَيْر الحراني س /10 /10 ومعاوية بْن هشام الكوفي س /10 /10 وموسى بْن داود الضبي س /10 /10 وموسى بْن مروان الرقي س   /10 /10 ومؤمل بْن الفضل الحراني س /10 /10 ويحيى بْن آدم الكوفي س /10 /10 ويزيد بْن هارون س /10 /10 ويعلى بْن عبيد الطنافسي س /10",
