    {
      "hadith_id": 995625,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 5071,
      "text_ar": "وقيل : أَبُو مُحَمَّد المدني نزيل مصر ، وهُوَ أخو عَبْد اللَّهِ بْن مسلمة ، ويحيى بْن مسلمة ، وعبد العزيز بْن مسلمة ، وعبد الملك بْن مسلمة . /10 إدريس بْن يَحْيَى الخولاني /10 /10 وإسحاق بْن صالح المخزومي /10 /10 وإسماعيل بْن عَبْد اللَّهِ بْن يوسف بْن الحارث /10 /10 والحسن بْن أبي جعفر /10 /10 وحماد بْن زيد /10 /10 وحماد بْن سلمة /10 /10 وأبي الأسود حميد بْن الأسود /10 /10 وعمه خلف بْن قعنب /10 /10 وداود بْن قيس الفراء /10 /10 والربيع بْن صبيح /10 /10 وشعبة بْن الحجاج /10 /10 وعبد اللَّه بْن عرادة الشيباني /10 /10 وعبد اللَّه بْن وهب /10 /10 وعَبْد الرَّحْمَنِ بْن زيد بْن أسلم /10 /10 وعبد الرحيم بْن زيد العمي /10 /10 ومحمد بْن معتمر بْن سُلَيْمَان /10 /10 وأبيه مسلمة بْن قعنب /10 /10 ومعتمر بْن سُلَيْمَان /10 /10 ووهيب بْن خَالِد /10 /10 ويعقوب بْن عَبْد الرَّحْمَنِ بْن مُحَمَّد الزهري /10",
      "sanad_ar": "وقيل",
      "matn_ar": "أَبُو مُحَمَّد المدني نزيل مصر ، وهُوَ أخو عَبْد اللَّهِ بْن مسلمة ، ويحيى بْن مسلمة ، وعبد العزيز بْن مسلمة ، وعبد الملك بْن مسلمة . /10 إدريس بْن يَحْيَى الخولاني /10 /10 وإسحاق بْن صالح المخزومي /10 /10 وإسماعيل بْن عَبْد اللَّهِ بْن يوسف بْن الحارث /10 /10 والحسن بْن أبي جعفر /10 /10 وحماد بْن زيد /10 /10 وحماد بْن سلمة /10 /10 وأبي الأسود حميد بْن الأسود /10 /10 وعمه خلف بْن قعنب /10 /10 وداود بْن قيس الفراء /10 /10 والربيع بْن صبيح /10 /10 وشعبة بْن الحجاج /10 /10 وعبد اللَّه بْن عرادة الشيباني /10 /10 وعبد اللَّه بْن وهب /10 /10 وعَبْد الرَّحْمَنِ بْن زيد بْن أسلم /10 /10 وعبد الرحيم بْن زيد العمي /10 /10 ومحمد بْن معتمر بْن سُلَيْمَان /10 /10 وأبيه مسلمة بْن قعنب /10 /10 ومعتمر بْن سُلَيْمَان /10 /10 ووهيب بْن خَالِد /10 /10 ويعقوب بْن عَبْد الرَّحْمَنِ بْن مُحَمَّد الزهري /10",
