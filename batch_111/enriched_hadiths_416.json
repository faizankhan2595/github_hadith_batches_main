    {
      "hadith_id": 996233,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 5679,
      "text_ar": "0 /11 أَبُو الأشعث أَحْمَد بْن المقدام العجلي ت /11 /11 وأبو أَيُّوب سُلَيْمَان بْن عبيد اللَّه الغيلاني البصري س /11 /11 وعَبْد الرَّحْمَنِ بْن بشر بْن الحكم النيسابوري /11 /11 وعَبْد الرَّحْمَنِ بْن عبد الوهاب العمي البصري /11 /11 وعلي بْن الحسين الدرهمي س /11 /11 وعلي بْن المديني /11 /11 وعمرو بْن علي الفلاس سي /11 /11 وعمرو بْن يزيد الجرمي س /11 /11 وأبو بكر مُحَمَّد بْن أَحْمَدَ بْن رافع العبدي ت /11 /11 ومحمد بْن بشار بندار م /11 /11 ومحمد بْن عبد الأعلى الصنعاني س /11 /11 ومحمد بْن عَبْد الرَّحْمَنِ العنبري د /11 /11 ومحمد بْن عثمان بْن أبي صفوان الثقفي س /11 /11 ومحمد بْن عمرو بْن عباد بْن جبلة بْن أبي رواد العتكي م /11 /11 ومحمد بْن عمرو بْن نبهان بْن صفوان الثقفي ت /11 /11 وأبو   عَبْد اللَّهِ مُحَمَّد بْن مالك العنبري /11 /11 وأبو موسى مُحَمَّد بْن المثنى م /11 /11 ومسدد بْن مسرهد د /11 /11 وأخوه هدبة بْن خَالِد /11 /11 ويوسف بْن حماد المعني /11 # قال",
