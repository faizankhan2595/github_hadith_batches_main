      "hadith_id": 991104,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 550,
      "text_ar": "واسمه عيسى بْن سُلَيْمَان بْن دينار الدارمي أَبُو مُحَمَّد الجرجاني قاضي قومس الزاهد ابْن الزاهد /10 إِبْرَاهِيم بْن طهمان الخراساني /10 /10 وإبراهيم بْن مُحَمَّد بْن أَبِي يحيى المدني /10 /10 وإسرائيل بْن يونس /10 /10 وبكير بْن شهاب الدامغاني /10 /10 وحماد بْن سَلَمَة /10 /10 وحمزة بْن حبيب الزيات الْمُقْرِئ /10 /10 وداود بْن سُلَيْمَان /10 /10 والربيع بْن بدر السعدي /10 /10 وسفيان الثوري /10 /10 وأبي الأحوص سلام بْن سليم الحنفي /10 /10 وعبد الرحمن بْن عَبْد اللَّهِ المسعودي /10 /10 وعبد العزيز بْن أَبِي رواد /10 /10 وعمر بْن ذر الهمداني /10 /10 وعمر بْن ميمون بْن الرماح /10 /10 وعمران بْن عبيد الضبي /10 /10 وعنبسة بْن الأَزْهَر قاضي جرجان س /10 /10 وأبيه أَبِي طيبة عيسى بْن سُلَيْمَان الجرجاني /10 /10 والليث بْن سعد /10 /10 ومالك بْن أنس /10 /10 ومالك بْن مغول /10 /10 ومحمد بْن عَبْد الرَّحْمَنِ بْن أَبِي ذئب /10 /10 ومحمد بْن عَبْد الرَّحْمَنِ بْن أَبِي ليلى /10 /10 وأبي معشر نجيح بْن عَبْد الرَّحْمَنِ المدني /10 /10 وورقاء بْن عُمَر اليشكري /10 /10 وأبي يُوسُف يَعْقُوب بْن إِبْرَاهِيم القاضي /10 /10 ويونس بْن أَبِي إسحاق السبيعي /10",
