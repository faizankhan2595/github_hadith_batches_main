    {
      "hadith_id": 997255,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 6701,
      "text_ar": "0 /11 أَحْمَد بْن مُحَمَّدِ بْن حنبل /11 /11 وأَبُو حميد أَحْمَد بْن مُحَمَّدِ بْن سيار العوهي الحمصي /11 /11 وإسحاق بْن إبراهيم بْن العلاء الزبيدي /11 /11 وإسحاق بْن منصور الكوسج س /11 /11 وإسحاق غير منسوب خ ، وهو الكوسج إن شاء اللَّه /11 /11 والحسين بْن أبى السري العسقلاني /11 /11 وصفوان بْن عمرو الحمصي الصغير س /11 /11 وعبد الرحمن بْن جابر بْن البختري الطائي /11 /11 وعبد السلام بْن مُحَمَّدٍ الحضرمي /11 /11 وعمرو بْن عثمان بْن سعيد بْن كثير بْن دينار القرشي /11 /11 وعمران بْن بكار البراد س الحمصيون /11 /11 ومحمد بْن إسماعيل الْبُخَارِيّ فِي غير الجامع /11 /11 ومحمد بْن خالد بْن خلي الحمصي س /11 /11 ومحمد بْن أبي خالد الصومعي /11 /11 وأَبُو بَكْر مُحَمَّد بْن عبد الملك بْن زنجويه البغدادي س /11 /11 ومحمد بْن عوف الطائي /11 /11 ومحمد بْن مصفى /11 /11 ومحمد بْن يحيى الذهلي ت س /11 /11 ويزيد بْن عبد ربه الجرجسي /11 /11 وأَبُو خالد يزيد بْن قرة الحضرمي الحمصي /11 # قال",
      "sanad_ar": "0 /11 أَحْمَد بْن مُحَمَّدِ بْن حنبل /11 /11 وأَبُو حميد أَحْمَد بْن مُحَمَّدِ بْن سيار العوهي الحمصي /11 /11 وإسحاق بْن إبراهيم بْن العلاء الزبيدي /11 /11 وإسحاق بْن منصور الكوسج س /11 /11 وإسحاق غير منسوب خ",
      "matn_ar": "وهو الكوسج إن شاء اللَّه /11 /11 والحسين بْن أبى السري العسقلاني /11 /11 وصفوان بْن عمرو الحمصي الصغير س /11 /11 وعبد الرحمن بْن جابر بْن البختري الطائي /11 /11 وعبد السلام بْن مُحَمَّدٍ الحضرمي /11 /11 وعمرو بْن عثمان بْن سعيد بْن كثير بْن دينار القرشي /11 /11 وعمران بْن بكار البراد س الحمصيون /11 /11 ومحمد بْن إسماعيل الْبُخَارِيّ فِي غير الجامع /11 /11 ومحمد بْن خالد بْن خلي الحمصي س /11 /11 ومحمد بْن أبي خالد الصومعي /11 /11 وأَبُو بَكْر مُحَمَّد بْن عبد الملك بْن زنجويه البغدادي س /11 /11 ومحمد بْن عوف الطائي /11 /11 ومحمد بْن مصفى /11 /11 ومحمد بْن يحيى الذهلي ت س /11 /11 ويزيد بْن عبد ربه الجرجسي /11 /11 وأَبُو خالد يزيد بْن قرة الحضرمي الحمصي /11 # قال",
