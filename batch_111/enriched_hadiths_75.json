      "hadith_id": 991121,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 567,
      "text_ar": "0 /11 البخاري /11 /11 وأَحْمَد بْن حَفْص بْن عَبْد اللَّهِ السلمي النَّيْسَابُورِيّ /11 /11 وإسحاق بْن مَنْصُور الكوسج /11 /11 والحسن بْن أيوب النَّيْسَابُورِيّ /11 /11 والحسين بْن مَنْصُور بْن جَعْفَر السلمي النَّيْسَابُورِيّ /11 /11 وأَبُو سعيد حَمْدَان بْن مُحَمَّد بْن جميل الهروي /11 /11 وأَبُو معشر حمدويه بْن الخطاب البخاري الْحَافِظ مستملي مُحَمَّد بْن إِسْمَاعِيل /11 /11 وعبد الله بْن عَبْد الرَّحْمَنِ الدارمي /11 /11 وأَبُو زرعة عُبَيْد اللَّهِ بْن عبد الكريم الرازي وأَبُو حَاتِم مُحَمَّد بْن إدريس الرازي وقال : صدوق وكتب عَنْهُ على باب إِبْرَاهِيم بْن مُوسَى الرازي /11 # وقال",
      "sanad_ar": "0 /11 البخاري /11 /11 وأَحْمَد بْن حَفْص بْن عَبْد اللَّهِ السلمي النَّيْسَابُورِيّ /11 /11 وإسحاق بْن مَنْصُور الكوسج /11 /11 والحسن بْن أيوب النَّيْسَابُورِيّ /11 /11 والحسين بْن مَنْصُور بْن جَعْفَر السلمي النَّيْسَابُورِيّ /11 /11 وأَبُو سعيد حَمْدَان بْن مُحَمَّد بْن جميل الهروي /11 /11 وأَبُو معشر حمدويه بْن الخطاب البخاري الْحَافِظ مستملي مُحَمَّد بْن إِسْمَاعِيل /11 /11 وعبد الله بْن عَبْد الرَّحْمَنِ الدارمي /11 /11 وأَبُو زرعة عُبَيْد اللَّهِ بْن عبد الكريم الرازي وأَبُو حَاتِم مُحَمَّد بْن إدريس الرازي وقال",
      "matn_ar": "صدوق وكتب عَنْهُ على باب إِبْرَاهِيم بْن مُوسَى الرازي /11 # وقال",
