      "chapter_id": null,
      "hadith_number": 4973,
      "text_ar": "2 \r\n$146  -10 /2 /141 أخبرنا /94 أَبُو الْحَسَنِ عَلِيُّ بْنُ أَحْمَدَ بْنِ عَبْدِ الْوَاحِدِ الْمَقْدِسِيُّ L75025 /94 ، وغَيْرُ واحِدٍ ، قَالُوا : أخبرنا /26 أَبُو حَفْصٍ عُمَرُ بْنُ مُحَمَّدِ بْنِ طَبَرْزَدَ L25365 /26 ، قال : أخبرنا الْقَاضِي /26 أَبُو بَكْرٍ مُحَمَّدُ بْنُ عَبْدِ الْبَاقِي الأَنْصَارِيُّ L29436 /26 ، قال : أخبرنا /26 أَبُو مُحَمَّدٍ الْحَسَنُ بْنُ عَلِيِّ بْنِ مُحَمَّدٍ الْجَوْهَرِيُّ L14939 /26 ، /26 وأَبُو الْقَاسِمِ عُمَرُ بْنُ الْحُسَيْنِ بْنِ إِبْرَاهِيمَ الْخَفَّافُ L25020 /26 فَرَّقَهُمَا ، قال الْجَوْهَرِيُّ : أخبرنا /26 أَبُو الْحَسَنِ عَلِيُّ بْنُ مُحَمَّدِ بْنِ أَحْمَدَ بْنِ لُؤْلُؤٍ الْوَرَّاقُ L24692 /26 ، وقال الْخَفَّافُ : أخبرنا /26 أَبُو حَفْصٍ عُمَرُ بْنُ مُحَمَّدِ بْنِ عَلِيِّ بْنِ الزَّيَّاتِ L25372 /26 ، قَالا : أخبرنا /26 حَمْزَةُ بْنُ مُحَمَّدِ بْنِ عِيسَى الْكَاتِبُ L15868 /26 ، قال : حدثنا /26 نُعَيْمُ بْنُ حَمَّادٍ L7912 /26 ، قال : حدثنا /26 ابْنُ الْمُبَارَكِ L4716 /26 ، عن /26 مُصْعَبِ بْنِ ثَابِتِ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ L7513 /26 ، عن /26 إِسْمَاعِيلَ بْنِ مُحَمَّدٍ L1056 /26 ، عن /26 عَامِرِ بْنِ سَعْدٍ L4098 /26 ، /27 عن أَبِيهِ /93 سَعْدٍ L3232 /93 ، قال : \" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ /20 يُسَلِّمُ فِي الصَّلاةِ تَسْلِيمَتَيْنِ ، تَسْلِيمَةً عن يَمِينِهِ : السَّلامُ عَلَيْكُمْ ورَحْمَةُ اللَّهِ ، وتَسْلِيمَةً عن يَسَارِهِ : السَّلامُ عَلَيْكُمْ ورَحْمَةُ اللَّهِ ، حَتَّى يُرَى بَيَاضُ خَدِّهِ مِنْ هَاهُنا ، ومِنْ هَاهُنا \" /27 قال : فذكر هَذَا الْحَدِيث عند الزهري ، فَقَالَ : هَذَا حديث لم نسمعه من حديث رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، فَقَالَ لَهُ إِسْمَاعِيل بْن مُحَمَّد : أكل حديث رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ سمعت ؟ قال الزهري : لا ، قال : فثلثيه ؟ قال : لا ، قال : فنصفه ؟ قال : فوقف الزهري عند النصف أو عند الثلث ، فَقَالَ لَهُ إِسْمَاعِيل : اجعل هَذَا الْحَدِيث فيما لم تسمع . رواه مسلم ، والنسائي من حديث عَبْد اللَّهِ بْن جعفر المخرمي ، عن إِسْمَاعِيل ، ورواه ابن مَاجَهْ من حديث مصعب بْن ثابت ، عنه مختصرا ، ولم يذكروا قصة الزهري . * \r\n# قال",
      "sanad_ar": "2 \r\n$146  -10 /2 /141 أخبرنا /94 أَبُو الْحَسَنِ عَلِيُّ بْنُ أَحْمَدَ بْنِ عَبْدِ الْوَاحِدِ الْمَقْدِسِيُّ L75025 /94",
      "matn_ar": "وغَيْرُ واحِدٍ ، قَالُوا : أخبرنا /26 أَبُو حَفْصٍ عُمَرُ بْنُ مُحَمَّدِ بْنِ طَبَرْزَدَ L25365 /26 ، قال : أخبرنا الْقَاضِي /26 أَبُو بَكْرٍ مُحَمَّدُ بْنُ عَبْدِ الْبَاقِي الأَنْصَارِيُّ L29436 /26 ، قال : أخبرنا /26 أَبُو مُحَمَّدٍ الْحَسَنُ بْنُ عَلِيِّ بْنِ مُحَمَّدٍ الْجَوْهَرِيُّ L14939 /26 ، /26 وأَبُو الْقَاسِمِ عُمَرُ بْنُ الْحُسَيْنِ بْنِ إِبْرَاهِيمَ الْخَفَّافُ L25020 /26 فَرَّقَهُمَا ، قال الْجَوْهَرِيُّ : أخبرنا /26 أَبُو الْحَسَنِ عَلِيُّ بْنُ مُحَمَّدِ بْنِ أَحْمَدَ بْنِ لُؤْلُؤٍ الْوَرَّاقُ L24692 /26 ، وقال الْخَفَّافُ : أخبرنا /26 أَبُو حَفْصٍ عُمَرُ بْنُ مُحَمَّدِ بْنِ عَلِيِّ بْنِ الزَّيَّاتِ L25372 /26 ، قَالا : أخبرنا /26 حَمْزَةُ بْنُ مُحَمَّدِ بْنِ عِيسَى الْكَاتِبُ L15868 /26 ، قال : حدثنا /26 نُعَيْمُ بْنُ حَمَّادٍ L7912 /26 ، قال : حدثنا /26 ابْنُ الْمُبَارَكِ L4716 /26 ، عن /26 مُصْعَبِ بْنِ ثَابِتِ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ L7513 /26 ، عن /26 إِسْمَاعِيلَ بْنِ مُحَمَّدٍ L1056 /26 ، عن /26 عَامِرِ بْنِ سَعْدٍ L4098 /26 ، /27 عن أَبِيهِ /93 سَعْدٍ L3232 /93 ، قال : \" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ /20 يُسَلِّمُ فِي الصَّلاةِ تَسْلِيمَتَيْنِ ، تَسْلِيمَةً عن يَمِينِهِ : السَّلامُ عَلَيْكُمْ ورَحْمَةُ اللَّهِ ، وتَسْلِيمَةً عن يَسَارِهِ : السَّلامُ عَلَيْكُمْ ورَحْمَةُ اللَّهِ ، حَتَّى يُرَى بَيَاضُ خَدِّهِ مِنْ هَاهُنا ، ومِنْ هَاهُنا \" /27 قال : فذكر هَذَا الْحَدِيث عند الزهري ، فَقَالَ : هَذَا حديث لم نسمعه من حديث رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، فَقَالَ لَهُ إِسْمَاعِيل بْن مُحَمَّد : أكل حديث رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ سمعت ؟ قال الزهري : لا ، قال : فثلثيه ؟ قال : لا ، قال : فنصفه ؟ قال : فوقف الزهري عند النصف أو عند الثلث ، فَقَالَ لَهُ إِسْمَاعِيل : اجعل هَذَا الْحَدِيث فيما لم تسمع . رواه مسلم ، والنسائي من حديث عَبْد اللَّهِ بْن جعفر المخرمي ، عن إِسْمَاعِيل ، ورواه ابن مَاجَهْ من حديث مصعب بْن ثابت ، عنه مختصرا ، ولم يذكروا قصة الزهري . * \r\n# قال",
