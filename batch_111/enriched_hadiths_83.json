    {
      "hadith_id": 991234,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 680,
      "text_ar": "0 /11 أَبُو داود /11 /11 وأَحْمَد بْن جَعْفَر بْن نصر الجمال /11 /11 وأَبُو بَكْر أَحْمَد بْن الْقَاسِم بْن عطية الْحَافِظ /11 /11 وجعفر بْن مُحَمَّد أَبُو يحيى الزعفراني الْحَافِظ /11 /11 وأَبُو علي الْحَسَن بْن الْعَبَّاس الجمال /11 /11 وابنه أَبُو سعيد عَبْد اللَّهِ بْن أَحْمَد بْن عَبْد الرَّحْمَنِ الدشتكي /11 /11 وعلي بْن الحسين بْن الجنيد /11 /11 وعلي بْن سعيد بْن بشير /11 /11 وأَبُو حَاتِم مُحَمَّد بْن إدريس /11 /11 ومحمد بْن أيوب بْن يحيى بْن الضريس /11 /11 وأَبُو بشر مُحَمَّد بْن عِمْرَان بْن الجنيد /11 /11 ومحمد بْن الفضل القسطاني الرازيون /11 # قال",
