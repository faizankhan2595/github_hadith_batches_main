    {
      "hadith_id": 998336,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 7782,
      "text_ar": "، ويقَالُ : الكناني أَبُو مُحَمَّد ، ويقَالُ : أَبُو إسماعيل الكوفي العابد . /10 إسرائيل بْن يونس /10 /10 والحارث بْن النعمان الليثي ت ابْن أخت سعيد بْن جبير /10 /10 وحسين بْن عَلِيٍّ الجعفي /10 /10 وزائدة بْن قدامة /10 /10 وسفيان الثوري خ /10 /10 وسلمة العابد /10 /10 وعبد الرحمن بْن مُحَمَّدٍ المحاربي /10 /10 وعمار بْن سيف الضبي /10 /10 وفضيل بْن عياض /10 /10 وفضيل بْن مرزوق /10 /10 وفطر بْن خليفة /10 /10 ومحمد بْن أبان الجعفي /10 /10 ومحمد بْن طلحة بْن مصرف /10 /10 ومحمد بْن عبيد اللَّه العرزمي /10 /10 ومسعر بْن كدام خ /10 /10 وأَبِي بَكْرِ بْن عياش /10",
      "sanad_ar": "",
      "matn_ar": "ويقَالُ : الكناني أَبُو مُحَمَّد ، ويقَالُ : أَبُو إسماعيل الكوفي العابد . /10 إسرائيل بْن يونس /10 /10 والحارث بْن النعمان الليثي ت ابْن أخت سعيد بْن جبير /10 /10 وحسين بْن عَلِيٍّ الجعفي /10 /10 وزائدة بْن قدامة /10 /10 وسفيان الثوري خ /10 /10 وسلمة العابد /10 /10 وعبد الرحمن بْن مُحَمَّدٍ المحاربي /10 /10 وعمار بْن سيف الضبي /10 /10 وفضيل بْن عياض /10 /10 وفضيل بْن مرزوق /10 /10 وفطر بْن خليفة /10 /10 ومحمد بْن أبان الجعفي /10 /10 ومحمد بْن طلحة بْن مصرف /10 /10 ومحمد بْن عبيد اللَّه العرزمي /10 /10 ومسعر بْن كدام خ /10 /10 وأَبِي بَكْرِ بْن عياش /10",
