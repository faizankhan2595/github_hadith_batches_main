    {
      "hadith_id": 993764,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 3210,
      "text_ar": "0 /11 أبو داود في المراسيل وغيره /11 /11 والترمذي /11 /11 والنسائي /11 /11 وابن ماجه /11 /11 وابنه إِبْرَاهِيم بْن إسحاق بْن إِبْرَاهِيم الشهيدي /11 /11 وإبراهيم بْن مُحَمَّد بْن إِبْرَاهِيم الكندي الصيرفي /11 /11 وأحمد بْن بطة بْن إسحاق الأصبهاني /11 /11 وأحمد بْن حمدون بْن رستم الأعمشي /11 /11 وأحمد بْن مُحَمَّد بْن بحر العطار البصري /11 /11 وأحمد بْن مُحَمَّد بْن عَبْد الله الجواربي /11 /11 وأحمد بْن منصور الرمادي /11 /11 وإسماعيل بْن إسحاق القاضي /11 /11 وجعفر بْن مُحَمَّد بْن الحسن الفريابي /11 /11 والحسن بْن عَبْد ربه الأهوازي /11 /11 والحسن بْن علي بْن نصر الطوسي /11 /11 والحسن بْن مُحَمَّد بْن شعبة الأنصاري /11 /11 وأبو عروبة الحسن بْن مُحَمَّد بْن مودود الحراني /11 /11 والعباس بْن حمدان   الحنفي الأصبهاني /11 /11 وأبو يعلى عباس بْن مُحَمَّد الرخجي /11 /11 وأبو بكر عَبْد الله بْن أبي داود /11 /11 وعبد الله بْن عروة الهروي /11 /11 وعلي بْن حسنويه القطان /11 /11 وعمر بْن مُحَمَّد بْن بجير البجيري /11 /11 والقاسم بْن موسى بْن الحسن بْن موسى الأشيب /11 /11 وأبو عيسى مُحَمَّد بْن أحمد بْن إِبْرَاهِيم بْن خالد بْن يزيد الشلاثائي البصري /11 /11 وأبو بكر مُحَمَّد بْن إسحاق بْن خزيمة /11 /11 ومحمد بْن الحسن بْن علي بْن بحر بْن بري /11 /11 وأبو بكر مُحَمَّد بْن عَبْد الله بْن يوسف بْن أيوب الضرير /11 /11 ومحمد بْن عَلِيّ الحكيم الترمذي /11 /11 ومحمد بْن غسان بْن جبلة /11 /11 ومحمد بْن مروان القرشي /11 /11 ومحمد بْن يحيى بْن منده العبدي الأصبهاني /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 /11 ويوسف بْن حميد الكشاني /11 # قال",
      "sanad_ar": "",
      "matn_ar": "",
