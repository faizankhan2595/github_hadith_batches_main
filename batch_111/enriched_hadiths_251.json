    {
      "hadith_id": 993763,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 3209,
      "text_ar": "/10 أبيه إِبْرَاهِيم بْن حبيب بْن الشهيد /10 /10 وبزيع بْن عَبْد الله اللحام /10 /10 وبشر بْن المفضل ق /10 /10 والحارث بْن النعمان بْن سالم بْن أبي النضر الأكفاني /10 /10 وحفص بْن غياث فق /10 /10 وحماد بْن يحيى بْن حماد /10 /10 وحميد بْن عَبْد الرحمن الرؤاسي مد /10 /10 وعبد الله بْن نمير /10 /10 وعبد الرحمن بْن مُحَمَّد المحاربي ق /10 /10 وعبدة بْن سُلَيْمَان ق /10 /10 وعتاب بْن بشير مد ت /10 /10 وعمر بْن أيوب الموصلي /10 /10 وعمر بْن عبيد الطنافسي ق /10 /10 وقريش بْن أنس مد /10 /10 وأبي معاوية مُحَمَّد بْن خازم الضرير ق /10 /10 ومحمد بْن سلمة الحراني ت /10 /10 ومحمد بْن فضيل بْن غزوان ت سي ق /10 /10 ومعاذ بْن هشام الدستوائي ت /10 /10 ومعتمر بْن سُلَيْمَان س ق /10 /10 ويحيى بْن حميد الطويل /10 /10 ويحيى بْن يمان س /10 /10 وأبي بكر بْن عياش س /10",
