    {
      "hadith_id": 997608,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 7054,
      "text_ar": "ختن أبي عبد الرحمن المقرئ .#E537 /10 إبراهيم بْن خالد الصنعاني د /10 /10 وأزهر بْن القاسم /10 /10 وإسماعيل بْن داود المخراقي /10 /10 وبشر بْن المفضل /10 /10 وبكر بْن صدقة المديني /10 /10 وحسين بْن عروة البصري /10 /10 وحماد بْن سعيد البراء البصري /10 /10 وحمزة بْن الحارث بْن عمير ق /10 /10 وأبي الأسود حميد بْن الأسود ق /10 /10 وخالد بْن الحارث ق /10 /10 وروح بْن عبادة ق /10 /10 وزكريا بْن يَحْيَى بْن عمارة ق /10 /10 وزهير بْن القاسم /10 /10 وسالم بْن نوح /10 /10 وسفيان بْن عيينة /10 /10 وأبي قتيبة سلم بْن قتيبة /10 /10 وسلمة بْن رجاء ق /10 /10 وصفوان بْن عِيسَى ق /10 /10 وأبي عاصم الضحاك بْن مخلد ق /10 /10 وعبد الأعلى بْن عبد الأعلى ق /10 /10 وعبد الرحمن بْن مهدي ق /10 /10 وعبد الرزاق بْن همام ق /10 /10 وأَبِي بَكْرٍ عبد الكبير بْن عبد المجيد الحنفي ق /10 /10 وعبد الوهاب بْن عبد المجيد الثقفي /10 /10 وأبي عَلِيّ عبيد اللَّه بْن عبد المجيد الحنفي /10 /10 وعبيد اللَّه بْن مُوسَى ق /10 /10 وعثمان بْن يمان /10 /10 وعمر بْن سهل المازني ق /10 /10 وعمر بْن عَلِيٍّ المقدمي ق /10 /10 وغسان بْن مضر الأزدي /10 /10 وقبيصة بْن عقبة ق /10 /10 ومحمد بْن بكر البرساني خت /10 /10 ومحمد بْن جعفر غندر ق /10 /10 ومحمد بْن حرب المكي /10 /10 ومحمد بْن أبي الضيف ق /10 /10 ومحمد بْن أبي عدي ق /10 /10 ومرحوم بْن عبد العزيز العطار ق /10 /10 ومعاذ بْن معاذ العنبري فق /10 /10 ومعاذ بْن هشام ق /10 /10 ومعتمر بْن سليمان /10 /10 وأبي اليمان المعلى بْن راشد النبال /10 /10 ومؤمل بْن إسماعيل /10 /10 ووهب بْن جرير بْن حازم /10 /10 ويحيى بْن سعيد القطان   ق /10 /10 وأبي زكريا يحيى بن مُحَمَّدِ بْن قيس المدني ق /10 /10 وأبي تميلة يَحْيَى بْن واضح /10 /10 ويزيد بْن زريع ق /10 /10 وأَبِي بَكْرٍ الكلبي /10",
