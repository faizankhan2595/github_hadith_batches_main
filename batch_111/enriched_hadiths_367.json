    {
      "hadith_id": 995505,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 4951,
      "text_ar": "ويقال : الأودي ، مولاهم أَبُو مُحَمَّد الكوفي العطار المكفوف . /10 الحجاج بْن أرطاة /10 /10 وداود بْن أبي هند /10 /10 وأبي مالك سعد بْن طارق الأشجعي /10 /10 وسعدان الْجُهَنِيّ /10 /10 وعبد الجبار بْن الْعَبَّاس الشبامي ت /10 /10 وعَبْد الرَّحْمَنِ بْن عبد الملك بْن أبجر /10 /10 وأبيه عبد الملك بْن أبجر /10 /10 وأبيه مُحَمَّد بْن جحادة /10 /10 وموسى الْجُهَنِيّ /10",
      "sanad_ar": "ويقال",
      "matn_ar": "الأودي ، مولاهم أَبُو مُحَمَّد الكوفي العطار المكفوف . /10 الحجاج بْن أرطاة /10 /10 وداود بْن أبي هند /10 /10 وأبي مالك سعد بْن طارق الأشجعي /10 /10 وسعدان الْجُهَنِيّ /10 /10 وعبد الجبار بْن الْعَبَّاس الشبامي ت /10 /10 وعَبْد الرَّحْمَنِ بْن عبد الملك بْن أبجر /10 /10 وأبيه عبد الملك بْن أبجر /10 /10 وأبيه مُحَمَّد بْن جحادة /10 /10 وموسى الْجُهَنِيّ /10",
