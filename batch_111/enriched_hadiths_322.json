    {
      "hadith_id": 994826,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 4272,
      "text_ar": "ثم الخبذعي الوشاء الخزاز الكوفي . /10 بسام الصيرفي /10 /10 والحسن بْن مُحَمَّد بْن عثمان ابْن بنت الشعبي ق /10 /10 وأبي أسامة حماد بْن أسامة /10 /10 وسعير بْن الخمس التميمي /10 /10 وعَبْد الرَّحْمَنِ بْن زيد بْن أسلم /10 /10 وعَبْد الرَّحْمَنِ بْن مالك بْن مغول /10 /10 وعَبْد الرَّحْمَنِ بْن مُحَمَّد المحاربي /10 /10 وعبد العزيز بْن مُحَمَّد الدَّرَاوَرْدِيّ /10 /10 وعبيد اللَّه بْن عبيد الرحمن الأشجعي ق /10 /10 ومحمد بْن جعفر بْن مُحَمَّد بْن علي بْن الحسين بْن علي بْن أبي طالب /10 /10 ومحمد بْن الفرات التميمي /10 /10 ووكيع بْن الجراح /10 /10 ويحيى بْن يمان /10",
