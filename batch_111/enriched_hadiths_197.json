    {
      "hadith_id": 992946,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 2392,
      "text_ar": "ابْن عم الإمام أبي عَبْد الله مُحَمَّد بْن إدريس الشافعي /10 أبي عمير الحارث بْن عمير /10 /10 وحفص بْن غياث النخعي /10 /10 وحماد بْن زيد /10 /10 وداود بْن عَبْد الرحمن العطار ق /10 /10 وسفيان بْن عيينة ق /10 /10 وعبد الله بْن رجاء المكي ق /10 /10 وعبد العزيز بْن أبي حازم /10 /10 وعمرو بْن يحيى بْن سعيد السعيدي /10 /10 وفضيل بْن عياض /10 /10 ومحمد بْن حنظلة المخزومي ق /10 /10 وأبيه مُحَمَّد بْن العباس بْن عثمان بْن شافع ق /10 /10 وأبي غرارة مُحَمَّد بْن عَبْد الرحمن بْن أبي بكر المليكي زوج جبرة بنت مُحَمَّد بْن سباع /10 /10 وجده لامه مُحَمَّد بْن علي بْن شافع س /10 /10 والمنكدر بْن مُحَمَّد بْن المنكدر /10",
