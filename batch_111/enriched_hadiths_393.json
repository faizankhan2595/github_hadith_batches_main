    {
      "hadith_id": 995884,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 5330,
      "text_ar": "ويقال لَهُ : صاحب التوابيت ، ويقال : الأثرم ، ويقال مولى ثقيف ، وكَانَ على قضاء الأهواز /10 بكير بْن الأخنس /10 /10 وبكير بْن عَبْد اللَّهِ الطويل الضخم /10 /10 وجهم بْن دينار /10 /10 والحسن البصري ت ق /10 /10 والحكم بْن عتيبة س /10 /10 وزياد بْن علاقة /10 /10 وزياد بْن فيروز /10 /10 وسعد بْن إِبْرَاهِيم /10 /10 وسلمة بْن كهيل /10 /10 وعامر الشعبي م ت /10 /10 وعبد الملك بْن ميسرة الزراد /10 /10 وعبيد اللَّه بْن أبي بكر بْن أَنَس بْن مالك /10 /10 وعدي بْن ثابت ت س ق /10 /10 وعكرمة مولى ابْن عباس س /10 /10 وعلي بْن مدرك /10 /10 وأبي إِسْحَاق عمرو بْن عَبْد اللَّهِ السبيعي ت م س /10 /10 وعمير بْن سعيد النَّخَعِيّ /10 /10 وعون بْن أبي جحيفة ت /10 /10 وغيلان بْن جرير /10 /10 والقاسم بْن عَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ بْن مسعود /10 /10 وكردوس الثعلبي بخ /10 /10 ومحمد بْن سيرين ق /10 /10 ومحمد بْن مسلم بْن شهاب الزهري /10 /10 وأبي الزبير مُحَمَّد بْن مسلم المكي بخ ت س ق /10 /10 ونافع مولى ابْن عمر /10 /10 وأبي هبيرة يَحْيَى بْن عباد الأَنْصَارِيّ /10 /10 ويحيى بْن هانئ بْن عروة المرادي /10 /10 ويزيد بْن صهيب الفقير /10 /10 وأبي بردة بْن أبي موسى الأشعري بخ /10",
      "sanad_ar": "ويقال لَهُ",
      "matn_ar": "صاحب التوابيت ، ويقال : الأثرم ، ويقال مولى ثقيف ، وكَانَ على قضاء الأهواز /10 بكير بْن الأخنس /10 /10 وبكير بْن عَبْد اللَّهِ الطويل الضخم /10 /10 وجهم بْن دينار /10 /10 والحسن البصري ت ق /10 /10 والحكم بْن عتيبة س /10 /10 وزياد بْن علاقة /10 /10 وزياد بْن فيروز /10 /10 وسعد بْن إِبْرَاهِيم /10 /10 وسلمة بْن كهيل /10 /10 وعامر الشعبي م ت /10 /10 وعبد الملك بْن ميسرة الزراد /10 /10 وعبيد اللَّه بْن أبي بكر بْن أَنَس بْن مالك /10 /10 وعدي بْن ثابت ت س ق /10 /10 وعكرمة مولى ابْن عباس س /10 /10 وعلي بْن مدرك /10 /10 وأبي إِسْحَاق عمرو بْن عَبْد اللَّهِ السبيعي ت م س /10 /10 وعمير بْن سعيد النَّخَعِيّ /10 /10 وعون بْن أبي جحيفة ت /10 /10 وغيلان بْن جرير /10 /10 والقاسم بْن عَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ بْن مسعود /10 /10 وكردوس الثعلبي بخ /10 /10 ومحمد بْن سيرين ق /10 /10 ومحمد بْن مسلم بْن شهاب الزهري /10 /10 وأبي الزبير مُحَمَّد بْن مسلم المكي بخ ت س ق /10 /10 ونافع مولى ابْن عمر /10 /10 وأبي هبيرة يَحْيَى بْن عباد الأَنْصَارِيّ /10 /10 ويحيى بْن هانئ بْن عروة المرادي /10 /10 ويزيد بْن صهيب الفقير /10 /10 وأبي بردة بْن أبي موسى الأشعري بخ /10",
