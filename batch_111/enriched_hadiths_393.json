    {
      "hadith_id": 995885,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 5331,
      "text_ar": "0 /11 إِبْرَاهِيم بْن الزبرقان /11 /11 وأسباط بْن مُحَمَّد القرشي س /11 /11 وإسماعيل بْن زَكَرِيَّا /11 /11 وبشر بْن الحسن البصري /11 /11 وبشير بْن ميمون ق /11 /11 وبكر بْن خنيس /11 /11 وجرير بْن عبد الحميد /11 /11 وحبان بْن علي العنزي /11 /11 والحسن بْن صالح بْن حي /11 /11 وحفص بْن غياث بخ ت ق /11 /11 وزياد بْن عَبْد اللَّهِ البكائي   /11 /11 وسعد بْن الصلت /11 /11 وسفيان الثوري /11 /11 وأبو خَالِد سُلَيْمَان بْن حيان الأحمر س /11 /11 وسنان بْن هارون البرجمي /11 /11 وشريك بْن عَبْد اللَّهِ النَّخَعِيّ /11 /11 وشعبة بْن الحجاج /11 /11 وصالح بْن عمر الواسطي /11 /11 وعائذ بْن حبيب /11 /11 وعباد بْن العوام /11 /11 وأبو زبيد عبثر بْن القاسم بخ ت س ق /11 /11 وعبد اللَّه بْن الأجلح /11 /11 وابنه عَبْد اللَّهِ بْن أشعث بْن سوار /11 /11 وعبد اللَّه بْن نمير ت ق /11 /11 وعَبْد الرَّحْمَنِ بْن مُحَمَّد المحاربي /11 /11 وعَبْد الرَّحْمَنِ بْن مسهر أخو علي بْن مسهر /11 /11 وعبد الرحيم بْن سُلَيْمَان /11 /11 وعلي بْن مسهر بخ /11 /11 وعمر بْن علي المقدمي /11 /11 وأبو إِسْحَاق عمرو بْن عَبْد اللَّهِ السبيعي وهو من شيوخه /11 /11 وأبو مالك عمرو بْن هاشم الجنبي /11 /11 وعيسى بْن يونس بْن أبي إِسْحَاق السبيعي /11 /11 والفضل بْن العلاء س /11 /11 وفضيل بْن عياض /11 /11 وابن مُحَمَّد بْن أشعث بْن سوار /11 /11 ومحمد بْن فضيل بْن غزوان /11 /11 ومروان بْن عَبْد اللَّهِ والد جنادة بْن مروان الأزدي /11 /11 ومروان بين مُعَاوِيَة الفزاري /11 /11 ومعمر بْن راشد /11 /11 وهشيم بْن بشير م ت ق /11 /11 ويحيى بْن زَكَرِيَّا بْن أبي زائدة /11 /11 ويزيد بْن عبد العزيز بْن سياه /11 /11 ويزيد بْن هارون وهو آخر من روى عنه /11 /11 والقاضي أَبُو يوسف يعقوب بْن إِبْرَاهِيم الأَنْصَارِيّ الكوفي /11 # قال",
