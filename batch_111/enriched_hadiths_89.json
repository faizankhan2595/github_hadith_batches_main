    {
      "hadith_id": 991327,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 773,
      "text_ar": "ابْن أخي علي بْن حكيم الأودي /10 أَحْمَد بْن الْمُفَضَّل القرشي الحفري /10 /10 وإسحاق بْن مَنْصُور السلولي /10 /10 وبكر بْن عَبْد الرَّحْمَنِ الكوفي القاضي س /10 /10 وبكر بْن يونس بْن بُكَيْر الشَّيْبَانِيّ /10 /10 وجعفر بْن عون س ق /10 /10 والحسن بْن بشر البجلي /10 /10 والحسن بْن علي الطلحي ابْن أخي ليث مولى بني طلحة /10 /10 وخالد بْن مخلد القطواني م س /10 /10 وعمه ذبيان بْن حكيم بْن ذبيان الأودي /10 /10 وزكريا بْن عَدِيّ س /10 /10 وسليمان بْن عُبَيْد اللَّهِ الحطاب الرقي ق /10 /10 وشريح بْن مسلمة التنوخي خ س /10 /10 وعبد الرحمن بْن شريك بْن عَبْد اللَّهِ النخعي /10 /10 وعبيد الله بْن مُوسَى العبسي س /10 /10 وأبيه عثمان بْن حكيم الأودي س /10 /10 وعثمان بْن زفر التيمي /10 /10 وعثمان بْن سعيد بْن مرة المري /10 /10 وعثمان بْن سعيد الزيات /10 /10 وعلي بْن ثَابِت الدهان ق /10 /10 وعمه علي بْن حكيم الأودي /10 /10 وعلي بْن قادم الخزاعي /10 /10 وعمرو بْن حَمَّاد بْن طلحة القناد س /10 /10 وعمرو بْن مُحَمَّد العنقزي س /10 /10 وعون بْن سلام الكوفي /10 /10 وأبي نعيم الفضل بْن دكين س ق /10 /10 وأبي غسان مَالِك بْن إِسْمَاعِيل النهدي س ق /10 /10 ومحمد بْن الصلت الأسدي س /10",
