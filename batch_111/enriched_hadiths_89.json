      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 774,
      "text_ar": "0 /11 البخاري /11 /11 ومسلم /11 /11 والنسائي /11 /11 وابن ماجه /11 /11 وأَبُو عُبَيْد اللَّهِ أَحْمَد بْن عَمْرو بْن عثمان المعدل الواسطي /11 /11 وأَحْمَد بْن مُحَمَّد بْن يزيد الزعفراني /11 /11 وأَحْمَد بْن مُحَمَّد بْن يَعْقُوب الخزاز الأصبهاني /11 /11 وأَبُو الْقَاسِم بدر بْن الهيثم القاضي /11 /11 والحسن بْن علي بْن نصر الطوسي /11 /11 والحسين بْن إِسْمَاعِيل   المحاملي /11 /11 وأَبُو بَكْر عَبْد اللَّهِ بْن أَبِي داود /11 /11 وعبد الله بْن مُحَمَّد بْن إسحاق المروزي المعروف بالحامض /11 /11 وأَبُو بَكْر عَبْد اللَّهِ بْن مُحَمَّد بْن أَبِي الدنيا /11 /11 وعبد الله بْن مُحَمَّد بْن ناجية /11 /11 وعبد الله بْن مُحَمَّد بْن يزيد الدقيقي /11 /11 وعبد الرحمن بْن أَبِي حَاتِم الرازي /11 /11 وعبد الرحمن بْن يُوسُف بْن خراش /11 /11 وأَبُو عبيد الْقَاسِم بْن إِسْمَاعِيل المحاملي /11 /11 والقاسم بْن زكريا المطرز /11 /11 وأَبُو حَاتِم مُحَمَّد بْن إدريس الرازي /11 /11 ومحمد بْن عَبْد اللَّهِ بْن سُلَيْمَان الحضرمي /11 /11 ومحمد بْن مخلد بْن حَفْص الدوري /11 /11 وموسى بْن إسحاق بْن مُوسَى الأنصاري /11 /11 والهيثم بْن خلف الدوري /11 /11 ويحيى بْن الْحَسَن بْن جَعْفَر العلوي النسابة /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 /11 وأَبُو عوانة يَعْقُوب بْن إسحاق الإسفرائيني /11 /11 ويعقوب بْن سفيان الفارسي /11 # قال",
