    {
      "hadith_id": 995181,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 4627,
      "text_ar": "مولى زينب بنت قيس بْن مخرمة وقيل : مولى بني هاشم ، أصله حجازي ، سكن الكوفة ، وكَانَ يقعد فِي سدة باب الجامع بالكوفة ، فسمي السدي ، وهُوَ السدي الكبير . /10 أَنَس بْن مالك م ت عس /10 /10 وأوس بْن ضمعج /10 /10 وأبي صالح باذان ت فق /10 /10 وحفص بْن أبي حفص /10 /10 ورفاعة الفتياني /10 /10 وسعد بْن عبيدة م ت س /10 /10 وصبيح مولى أم سلمة ت ق /10 /10 وعباد بْن أبي يزيد ت /10 /10 وعبد اللَّه بْن حبيب أبي عَبْد الرَّحْمَنِ السلمي /10 /10 وعبد اللَّه بْن عباس د /10 /10 وعبد اللَّه البهي م ت /10 /10 وعبد خير الهمداني عس /10 /10 وأبيه عَبْد الرَّحْمَنِ بْن أبي كريمة د ت /10 /10 وعدي بْن ثابت س ق /10 /10 وعطاء بْن أبي رباح /10 /10 وعكرمة مولى ابْن عباس /10 /10 وعمرو بْن حريث المخزومي /10 /10 وغزوان أبي مالك الغفاري حد ت /10 /10 ومرة الهمداني ت /10 /10 ومصعب بْن سعد بْن أبي وقاص د س /10 /10 والوليد بْن أبي هشام ويقال : ابن أبي هاشم /10 /10 وأبي هبيرة يَحْيَى بْن عباد الأَنْصَارِيّ م د ت /10 /10 وأبي حَكِيم البارقي /10 /10 وأبي سعد الأزدي ت ق /10",
      "sanad_ar": "مولى زينب بنت قيس بْن مخرمة وقيل",
      "matn_ar": "مولى بني هاشم ، أصله حجازي ، سكن الكوفة ، وكَانَ يقعد فِي سدة باب الجامع بالكوفة ، فسمي السدي ، وهُوَ السدي الكبير . /10 أَنَس بْن مالك م ت عس /10 /10 وأوس بْن ضمعج /10 /10 وأبي صالح باذان ت فق /10 /10 وحفص بْن أبي حفص /10 /10 ورفاعة الفتياني /10 /10 وسعد بْن عبيدة م ت س /10 /10 وصبيح مولى أم سلمة ت ق /10 /10 وعباد بْن أبي يزيد ت /10 /10 وعبد اللَّه بْن حبيب أبي عَبْد الرَّحْمَنِ السلمي /10 /10 وعبد اللَّه بْن عباس د /10 /10 وعبد اللَّه البهي م ت /10 /10 وعبد خير الهمداني عس /10 /10 وأبيه عَبْد الرَّحْمَنِ بْن أبي كريمة د ت /10 /10 وعدي بْن ثابت س ق /10 /10 وعطاء بْن أبي رباح /10 /10 وعكرمة مولى ابْن عباس /10 /10 وعمرو بْن حريث المخزومي /10 /10 وغزوان أبي مالك الغفاري حد ت /10 /10 ومرة الهمداني ت /10 /10 ومصعب بْن سعد بْن أبي وقاص د س /10 /10 والوليد بْن أبي هشام ويقال : ابن أبي هاشم /10 /10 وأبي هبيرة يَحْيَى بْن عباد الأَنْصَارِيّ م د ت /10 /10 وأبي حَكِيم البارقي /10 /10 وأبي سعد الأزدي ت ق /10",
      "grade": null,
