    {
      "hadith_id": 993925,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 3371,
      "text_ar": "نزيل طرسوس /10 أسامة بْن زيد بْن أسلم /10 /10 وأبي الغصن ثابت بْن قيس المدني /10 /10 وسفيان الثوري /10 /10 وشريك بْن عَبْد الله النخعي /10 /10 وعبد الله بْن عمر العمري /10 /10 وعبد الرحمن بْن أبي الموال /10 /10 وكثير بْن عَبْد الله بْن عمرو بْن عوف المزني ق /10 /10 ومالك بْن أنس /10 /10 وهشام بْن سعد /10 /10 ويزيد بْن عَبْد الملك النوفلي وقال : قرأته غير مرة د يعني كتاب قطيعة النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ لبلال بْن الحارث المزني /10",
      "sanad_ar": "نزيل طرسوس /10 أسامة بْن زيد بْن أسلم /10 /10 وأبي الغصن ثابت بْن قيس المدني /10 /10 وسفيان الثوري /10 /10 وشريك بْن عَبْد الله النخعي /10 /10 وعبد الله بْن عمر العمري /10 /10 وعبد الرحمن بْن أبي الموال /10 /10 وكثير بْن عَبْد الله بْن عمرو بْن عوف المزني ق /10 /10 ومالك بْن أنس /10 /10 وهشام بْن سعد /10 /10 ويزيد بْن عَبْد الملك النوفلي وقال",
      "matn_ar": "قرأته غير مرة د يعني كتاب قطيعة النَّبِيّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ لبلال بْن الحارث المزني /10",
