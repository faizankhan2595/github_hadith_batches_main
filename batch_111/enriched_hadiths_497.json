      "hadith_id": 997450,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 6896,
      "text_ar": "والد النعمان بْن بشير شهد بدرا مع رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، وهو أول أنصاري بايع أبا بكر بعد وفاة رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ لَهُ /10 النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ س حديث واحد ، وهو حديث النحل عَلَى خلاف فيه /10",
      "sanad_ar": "والد النعمان بْن بشير شهد بدرا مع رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ",
      "matn_ar": "وهو أول أنصاري بايع أبا بكر بعد وفاة رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ لَهُ /10 النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ س حديث واحد ، وهو حديث النحل عَلَى خلاف فيه /10",
