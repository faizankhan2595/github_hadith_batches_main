    {
      "hadith_id": 995318,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 4764,
      "text_ar": "نزيل بغداد ، وقال أَبُو زرعة الرازي : يعد فِي البغداديين ، وذكره مُحَمَّد بْن سعد فيمن كَانَ ببغداد من العلماء . /10 البراء بْن سليم الضبي /10 /10 وداود بْن قيس الفراء م س /10 /10 وسعيد بْن زيد د أخي حماد بْن زيد /10 /10 وسفيان الثوري /10 /10 وعَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ المسعودي /10 /10 وعَبْد الْوَاحِدِ أبي حمزة مولى عروة بْن الزبير /10 /10 وعيسى بْن دينار /10 /10 وعيسى بْن طهمان /10 /10 وقرة بْن خَالِد /10 /10 وكامل أبي العلاء /10 /10 ومالك بْن أَنَس /10 /10 ومالك بْن مغول /10 /10 ومعرف بْن واصل /10 /10 وورقاء بْن عمر اليشكري /10 /10 ويونس بْن أبي إِسْحَاق م /10 /10 وأبي عَبْد الرَّحْمَنِ العمري الزاهد /10 /10 وعن من عخ سمع المعتمر بْن سُلَيْمَان ينكر على من قال القرآن مخلوق ويبدعه /10",
      "sanad_ar": "نزيل بغداد",
      "matn_ar": "وقال أَبُو زرعة الرازي : يعد فِي البغداديين ، وذكره مُحَمَّد بْن سعد فيمن كَانَ ببغداد من العلماء . /10 البراء بْن سليم الضبي /10 /10 وداود بْن قيس الفراء م س /10 /10 وسعيد بْن زيد د أخي حماد بْن زيد /10 /10 وسفيان الثوري /10 /10 وعَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ المسعودي /10 /10 وعَبْد الْوَاحِدِ أبي حمزة مولى عروة بْن الزبير /10 /10 وعيسى بْن دينار /10 /10 وعيسى بْن طهمان /10 /10 وقرة بْن خَالِد /10 /10 وكامل أبي العلاء /10 /10 ومالك بْن أَنَس /10 /10 ومالك بْن مغول /10 /10 ومعرف بْن واصل /10 /10 وورقاء بْن عمر اليشكري /10 /10 ويونس بْن أبي إِسْحَاق م /10 /10 وأبي عَبْد الرَّحْمَنِ العمري الزاهد /10 /10 وعن من عخ سمع المعتمر بْن سُلَيْمَان ينكر على من قال القرآن مخلوق ويبدعه /10",
