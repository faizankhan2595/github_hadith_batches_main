      "chapter_id": null,
      "hadith_number": 721,
      "text_ar": "0 /11 أَبُو داود /11 /11 والنسائي /11 /11 وإبراهيم بْن دحيم الدمشقي /11 /11 وإبراهيم بْن عَبْد الرَّحْمَنِ بْن مروان القرشي الْحَافِظ /11 /11 وأَحْمَد بْن عامر بْن عَبْد الْوَاحِدِ البرقعيدي /11 /11 وأَبُو بَكْر أَحْمَد بْن عَمْرو بْن أَبِي عاصم النبيل /11 /11 وأَبُو الْحَسَن أَحْمَد بْن عمير بْن يُوسُف بْن جوصى /11 /11 وأَبُو الدحداح أَحْمَد بْن مُحَمَّد بْن إِسْمَاعِيل التَّمِيمِيّ /11 /11 وأَحْمَد بْن المعلى بْن يزيد القاضي /11 /11 وإسماعيل بْن مُحَمَّد بْن قيراط /11 /11 وجعفر بْن مُحَمَّد بْن أَحْمَد بْن حَمَّاد التَّمِيمِيّ والد الفضل بْن جَعْفَر /11 /11 والحسن بْن علي بْن روح بْن عوانة /11 /11 وأَبُو سُلَيْمَان داود بْن الوسيم البوشنجي /11 /11 وسليمان بْن مُحَمَّد بْن إِسْمَاعِيل الخزاعي /11 /11 وعبد الله بْن أَحْمَد بْن مُوسَى عبدان الأهوازي /11 /11 وأَبُو بَكْر   عَبْد اللَّهِ بْن أَبِي داود /11 /11 وعمر بْن مُحَمَّد بْن بجير السمرقندي /11 /11 والقاسم بْن عيسى العصار /11 /11 والقاسم بْن مُوسَى بْن الْحَسَن بْن مُوسَى الأشيب /11 /11 وأَبُو بشر مُحَمَّد بْن أَحْمَد بْن حَمَّاد الدولابي /11 /11 وأَبُو الْحَسَن مُحَمَّد بْن إسحاق بْن الحريص /11 /11 ومحمد بْن الْقَاسِم بْن عبد الخالق المؤذن /11 /11 وموسى بْن جمهور التنيسي /11 # قال",
