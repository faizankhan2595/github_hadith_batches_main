    {
      "hadith_id": 996743,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 6189,
      "text_ar": "مولى بني سعد من خولان /10 إبراهيم بْن إسماعيل ابْن علية المتكلم /10 /10 وإسحاق بْن الفرات المصري /10 /10 وإسحاق بْن مُحَمَّدِ بْن واصل العقيلي /10 /10 وأسد بْن مُوسَى /10 /10 وأشهب بْن عبد العزيز /10 /10 وأيوب بْن سويد الرملي /10 /10 وبشر بْن بكر التنيسي /10 /10 وخالد بْن عبد الرحمن الخراساني كن /10 /10 والخصيب بْن ناصح /10 /10 وضمرة بْن ربيعة /10 /10 وعافية بْن أيوب /10 /10 وعَبْد اللَّهِ بْن وهب /10 /10 وعبد الرحمن بْن زياد الرصاصي /10 /10 وعلي بْن معبد بْن شداد الرقي /10 /10 ومحمد بْن إدريس الشافعي /10 /10 وأبيه نصر بْن سابق الخولاني /10 /10 ووهب أبي اليسع /10 /10 ويحيى بْن حيان التنيسي /10 /10 ويحيى بْن سلام /10",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10",
