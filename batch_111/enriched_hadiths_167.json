      "hadith_id": 992499,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 1945,
      "text_ar": "طبري الأصل /10 أحمد بْن إسحاق الحضرمي س /10 /10 وأبي الجواب الأحوص بْن جواب ت سي /10 /10 وأزهر بْن سعد السمان /10 /10 وإسماعيل بْن أبي أويس ت /10 /10 والأسود بْن عامر بْن شاذان ت ص /10 /10 وأصرم بْن جوشب /10 /10 وأبي ضمرة أنس بْن عياض ق /10 /10 وحجاج بْن مُحَمَّد الأعور /10 /10 وحسين بْن مُحَمَّد المروذي /10 /10 وأبي اليمان الحكم بْن نافع ت /10 /10 وأبي أسامة حماد بْن أسامة م د ت /10 /10 وخلف بْن تميم /10 /10 وأبي توبة الربيع بْن نافع الحلبي ق /10 /10 وروح بْن عبادة ق /10 /10 وريحان بْن سعيد سي /10 /10 وزيد بْن الحباب د /10 /10 وسعد بْن عَبْد الحميد بْن جعفر ت ق /10 /10 وسفيان بْن عيينة س /10 /10 وشبابة بْن سوار س /10 /10 والعباس بْن الهيثم الأنطاكي /10 /10 وعبد الله بْن نمير /10 /10 وأبي صالح عَبْد الغفار بْن داود الحراني ق /10 /10 وعبد الوهاب بْن عَبْد المجيد الثقفي ق /10 /10 وعبد الوهاب بْن عطاء الخفاف ت /10 /10 وعبيد بْن أبي قرة /10 /10 وعمر بْن سعد أبي داود الحفري /10 /10 وعمر بْن شبيب المسلي ق /10 /10 وأبي صالح محبوب بْن موسى الفراء الأنطاكي /10 /10 ومحمد بْن بشر العبدي /10 /10 ومحمد بْن خازم أبي معاوية الضرير /10 /10 ومحمد بْن ربيعة الكلابي ت /10 /10 ومحمد بْن عمر الواقدي /10 /10 وأبي أحمد مُحَمَّد بْن عَبْد الله بْن الزبير الزبيري ق /10 /10 ومحمد بْن فضيل بْن غزوان الضبي س /10 /10 ومحمد بْن القاسم الأسدي /10 /10 ووكيع بْن الجراح د ق /10 /10 ويحيى بْن يزيد بْن عَبْد الملك النوفلي /10",
