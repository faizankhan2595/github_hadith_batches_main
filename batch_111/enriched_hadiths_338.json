      "hadith_id": 995060,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 4506,
      "text_ar": "نزيل مكة ، والد مُحَمَّد بْن إِسْمَاعِيل بْن سالم الصائغ الكبير . /10 إِسْحَاق بْن يوسف الأزرق /10 /10 وإسماعيل ابْن علية م /10 /10 وأبي خَالِد سُلَيْمَان بْن حيان الأحمر /10 /10 وعباد بْن عباد المهلبي /10 /10 وعَبْد الرَّحْمَنِ بْن مالك بْن مغول /10 /10 وعبيد اللَّه بْن موسى /10 /10 ومروان بْن مُعَاوِيَة الفزاري /10 /10 وأبي المغيرة النضر بْن إِسْمَاعِيل /10 /10 وهشيم بْن بشير م /10 /10 ويحيى بْن أبي بكير الكرماني /10 /10 ويحيى بْن زَكَرِيَّا بْن أبي زائدة /10 /10 ويزيد بْن هارون /10 /10 ويونس بْن مُحَمَّد المؤدب /10",
      "sanad_ar": "نزيل مكة",
      "matn_ar": "والد مُحَمَّد بْن إِسْمَاعِيل بْن سالم الصائغ الكبير . /10 إِسْحَاق بْن يوسف الأزرق /10 /10 وإسماعيل ابْن علية م /10 /10 وأبي خَالِد سُلَيْمَان بْن حيان الأحمر /10 /10 وعباد بْن عباد المهلبي /10 /10 وعَبْد الرَّحْمَنِ بْن مالك بْن مغول /10 /10 وعبيد اللَّه بْن موسى /10 /10 ومروان بْن مُعَاوِيَة الفزاري /10 /10 وأبي المغيرة النضر بْن إِسْمَاعِيل /10 /10 وهشيم بْن بشير م /10 /10 ويحيى بْن أبي بكير الكرماني /10 /10 ويحيى بْن زَكَرِيَّا بْن أبي زائدة /10 /10 ويزيد بْن هارون /10 /10 ويونس بْن مُحَمَّد المؤدب /10",
