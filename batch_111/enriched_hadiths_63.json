    {
      "hadith_id": 990940,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 386,
      "text_ar": "0 /11 النسائي /11 /11 وأَبُو حمزة أَحْمَد بْن عَبْد اللَّهِ بْن عِمْرَان المروزي /11 /11 وأَبُو عَمْرو أَحْمَد بْن المبارك المستملي /11 /11 وأَحْمَد بْن مُحَمَّد بْن عُمَر بْن بسطام /11 /11 وحاجب بْن أَحْمَد بْن يرحم بْن سفيان الطوسي /11 /11 والحسن بْن علي بْن نصر الطوسي /11 /11 وزكريا بْن يحيى السجزي خياط السنة /11 /11 وأَبُو بَكْر عَبْد اللَّهِ بْن أَبِي داود /11 /11 وعبد الله بْن ناجية /11 /11 وأَبُو بَكْر عبد بْن مُحَمَّد بْن محمود النسفي /11 /11 وعلي بْن الحسين بْن الجنيد الرازي /11 /11 وعمر بْن أَحْمَد بْن علي المروزي الجوهري /11 /11 وعمر بْن مُحَمَّد   المروزي /11 /11 وأَبُو الْعَبَّاس مُحَمَّد بْن أَحْمَد بْن محبوب المحبوبي راوية الترمذي /11 /11 وأَبُو بَكْر مُحَمَّد بْن إسحاق بْن خزيمة /11 /11 ومحمد بْن إِسْمَاعِيل البخاري فِي غير الجامع /11 /11 ومحمد بْن عقيل بْن الأَزْهَر البلخي /11 /11 ومحمد بْن المنذر بْن سعيد الهروي شكر /11 /11 ومحمد بْن نصر المروزي الفقيه /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 ++ وروى البخاري فِي الجامع حديثا عَنْ أَحْمَد ، عَنْ مُحَمَّد بْن أَبِي بَكْر المقدمي . فقيل : إنه أَحْمَد بْن سيار هذا . # قال",
      "sanad_ar": "0 /11 النسائي /11 /11 وأَبُو حمزة أَحْمَد بْن عَبْد اللَّهِ بْن عِمْرَان المروزي /11 /11 وأَبُو عَمْرو أَحْمَد بْن المبارك المستملي /11 /11 وأَحْمَد بْن مُحَمَّد بْن عُمَر بْن بسطام /11 /11 وحاجب بْن أَحْمَد بْن يرحم بْن سفيان الطوسي /11 /11 والحسن بْن علي بْن نصر الطوسي /11 /11 وزكريا بْن يحيى السجزي خياط السنة /11 /11 وأَبُو بَكْر عَبْد اللَّهِ بْن أَبِي داود /11 /11 وعبد الله بْن ناجية /11 /11 وأَبُو بَكْر عبد بْن مُحَمَّد بْن محمود النسفي /11 /11 وعلي بْن الحسين بْن الجنيد الرازي /11 /11 وعمر بْن أَحْمَد بْن علي المروزي الجوهري /11 /11 وعمر بْن مُحَمَّد   المروزي /11 /11 وأَبُو الْعَبَّاس مُحَمَّد بْن أَحْمَد بْن محبوب المحبوبي راوية الترمذي /11 /11 وأَبُو بَكْر مُحَمَّد بْن إسحاق بْن خزيمة /11 /11 ومحمد بْن إِسْمَاعِيل البخاري فِي غير الجامع /11 /11 ومحمد بْن عقيل بْن الأَزْهَر البلخي /11 /11 ومحمد بْن المنذر بْن سعيد الهروي شكر /11 /11 ومحمد بْن نصر المروزي الفقيه /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 ++ وروى البخاري فِي الجامع حديثا عَنْ أَحْمَد",
      "matn_ar": "عَنْ مُحَمَّد بْن أَبِي بَكْر المقدمي . فقيل : إنه أَحْمَد بْن سيار هذا . # قال",
