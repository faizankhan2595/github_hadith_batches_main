      "hadith_number": 380,
      "text_ar": "0 /11 النسائي فِي حديث مَالِك /11 /11 والباقون سوى الترمذي /11 /11 وإبراهيم بْن أورمة الأصبهاني /11 /11 وابنه جَعْفَر بْن أَحْمَد بْن سنان القطان /11 /11 وزكريا بْن يحيى الساجي /11 /11 وأَبُو بَكْر عَبْد اللَّهِ بْن أبي داود /11 /11 وأَبُو الحسين عَبْد اللَّهِ بْن مُحَمَّد بْن عَبْد اللَّهِ بْن يونس السمناني /11 /11 وعبد الله بْن مُحَمَّد بْن ياسين /11 /11 وعبد الرحمن بْن أَبِي حَاتِم الرازي /11 /11 وأَبُو سعيد عَبْد الرَّحْمَنِ بْن سعيد بْن هارون الأصبهاني /11 /11 والقاسم بْن مُوسَى بْن الْحَسَن بْن مُوسَى الأشيب /11 /11 ومحمد بْن أَحْمَد بْن صَالِح بْن علي الأزدي /11 /11 وأَبُو حَاتِم مُحَمَّد بْن إدريس الرازي /11 /11 وأَبُو بَكْر مُحَمَّد بْن إسحاق بْن خزيمة   /11 /11 وأَبُو مُوسَى مُحَمَّد بْن المثنى وهو من أقرانه /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 # قال",
