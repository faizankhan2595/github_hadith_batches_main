    {
      "hadith_id": 993611,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 3057,
      "text_ar": "0 /11 البخاري /11 /11 والنسائي /11 /11 وأحمد بْن الحسين بْن إسحاق الصوفي الصغير /11 /11 وأبو بكر أحمد بْن عمرو بْن عَبْد الخالق البزار /11 /11 وأحمد بْن مُحَمَّد بْن الجهم السمري /11 /11 وأحمد بْن يحيى بْن زهير التستري /11 /11 وجعفر بْن أحمد بْن سنان القطان الواسطي /11 /11 وأبو مُحَمَّد جعفر بْن نصر النيسابوري الحافظ المعروف بالحصيري /11 /11 والحسين بْن أحمد بْن بسطام الزعفراني /11 /11 والحسين بْن إسحاق التستري /11 /11 وأبو عروبة الحسين بْن مُحَمَّد الحراني /11 /11 وزكريا بْن يحيى السجزي خياط السنة /11 /11 وسعيد بْن عمرو البردعي الحافظ /11 /11 وأبو أيوب سُلَيْمَان بْن عيسى الجوهري /11 /11 وصالح بْن   أحمد بْن أبي مقاتل /11 /11 وأبو بكر عَبْد الله بْن أبي داود /11 /11 وعبد الله بْن مُحَمَّد بْن ناجية /11 /11 وعبدان الأهوازي الحافظ /11 /11 وعلي بْن العباس البجلي المقانعي /11 /11 وعمر بْن مُحَمَّد بْن بجير السمرقندي /11 /11 وأبو حامد مُحَمَّد بْن هارون الحضرمي /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 # قال",
