      "chapter_id": null,
      "hadith_number": 1703,
      "text_ar": "نا /94 قُرَيْرٌ /94 ، عَنْ /26 عِيسَى بْنِ عُمَرَ الْفَارِقِيِّ الْحِزَامِيِّ /26 ، عَنْ /26 عَمْرِو بْنِ مُرَّةَ /26 ، /27 عَنْ /26 سَعِيدِ بْنِ جُبَيْرٍ /26 ، /20 فِيمَنْ قَالَ : الْحِلُّ عَلَيْهِ حَرَامٌ \" يَمِينٌ مِنَ الأَيْمَانِ يُكَفِّرُهَا \" /27 * \r\n$1618  1618 /3",
