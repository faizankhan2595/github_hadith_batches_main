    {
      "hadith_id": 71083,
      "book_id": 70,
      "chapter_id": null,
      "hadith_number": 799,
      "text_ar": "نا /94 هُشَيْمٌ /94 ، قَالَ : أنا /26 حَجَّاجٌ /26 ، /27 عَنْ /26 عَمْرِو بْنِ شُعَيْبٍ /26 ، عَنْ /26 أَبِيهِ /26 ، عَنْ /93 جَدِّهِ L4980 /93 , أَنَّهُ : /20 \" لا تُحْصِنُ الأَمَةُ الْحُرَّ ، وَلا تُحْصِنُ الْحُرَّةُ الْعَبْدَ , وَلا تُحْصِنُ الْمُسْلِمَ الْيَهُودِيَّةُ وَلا النَّصْرَانِيَّةُ ، وَإِنْ قَذَفَ وَاحِدَةً مِنْهُنَّ لَمْ يَكُنْ بَيْنَهَا وَبَيْنَ زَوْجِهَا لِعَانٌ \" /27 * \r\n$759  759 /3",
      "sanad_ar": "نا /94 هُشَيْمٌ /94",
      "matn_ar": "قَالَ : أنا /26 حَجَّاجٌ /26 ، /27 عَنْ /26 عَمْرِو بْنِ شُعَيْبٍ /26 ، عَنْ /26 أَبِيهِ /26 ، عَنْ /93 جَدِّهِ L4980 /93 , أَنَّهُ : /20 \" لا تُحْصِنُ الأَمَةُ الْحُرَّ ، وَلا تُحْصِنُ الْحُرَّةُ الْعَبْدَ , وَلا تُحْصِنُ الْمُسْلِمَ الْيَهُودِيَّةُ وَلا النَّصْرَانِيَّةُ ، وَإِنْ قَذَفَ وَاحِدَةً مِنْهُنَّ لَمْ يَكُنْ بَيْنَهَا وَبَيْنَ زَوْجِهَا لِعَانٌ \" /27 * \r\n$759  759 /3",
