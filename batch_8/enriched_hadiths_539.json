      "chapter_id": null,
      "hadith_number": 793,
      "text_ar": "نا /94 سُفْيَانُ L3443 /94 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ L4632 /26 ، /27 عَنْ /26 عَبْدِ الْمَلِكِ بْنِ أَبِي بَكْرٍ L5191 /26 ، قَالَ : لَمَّا دَخَلَتْ أُمُّ سَلَمَةَ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" إِنَّهُ /20 لَيْسَ بِكِ عَلَى أَهْلِكِ هَوَانٌ ، فَإِنْ شِئْتِ سَبَّعْتُ لَكِ وَإِلا فَثَلَّثْتُكِ ثُمَّ    @ 1 : 205 @   أَدُورُ \" /27 * \r\n$753  753 /2 /141 نا /94 هُشَيْمٌ L8062 /94 قَالَ : أنا /26 حُمَيْدٌ L2531 /26 ، /27 عَنْ /93 أَنَسِ بْنِ مَالِكٍ L720 /93 ، قَالَ : /20 \" أَصَابَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَفِيَّةَ بِنْتَ حُيَيٍّ حِينَ اتَّخَذَهَا أَقَامَ عِنْدَهَا ثَلاثًا \" /27 * \r\n$754  754 /2",
      "sanad_ar": "نا /94 سُفْيَانُ L3443 /94",
      "matn_ar": "عَنْ /26 عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ L4632 /26 ، /27 عَنْ /26 عَبْدِ الْمَلِكِ بْنِ أَبِي بَكْرٍ L5191 /26 ، قَالَ : لَمَّا دَخَلَتْ أُمُّ سَلَمَةَ عَلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" إِنَّهُ /20 لَيْسَ بِكِ عَلَى أَهْلِكِ هَوَانٌ ، فَإِنْ شِئْتِ سَبَّعْتُ لَكِ وَإِلا فَثَلَّثْتُكِ ثُمَّ    @ 1 : 205 @   أَدُورُ \" /27 * \r\n$753  753 /2 /141 نا /94 هُشَيْمٌ L8062 /94 قَالَ : أنا /26 حُمَيْدٌ L2531 /26 ، /27 عَنْ /93 أَنَسِ بْنِ مَالِكٍ L720 /93 ، قَالَ : /20 \" أَصَابَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَفِيَّةَ بِنْتَ حُيَيٍّ حِينَ اتَّخَذَهَا أَقَامَ عِنْدَهَا ثَلاثًا \" /27 * \r\n$754  754 /2",
