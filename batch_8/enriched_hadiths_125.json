    {
      "hadith_id": 64870,
      "book_id": 60,
      "chapter_id": null,
      "hadith_number": 17357,
      "text_ar": "عَنِ /94 الثَّوْرِيِّ /94 ، عَنْ /26 مَنْصُورٍ /26 ، /27 عَنْ /26 إِبْرَاهِيمَ /26 , قَالَ : \" كَانَ يُقَالُ فِي /20 كُلِّ وَاحِدٍ مِنَ الإِنْسَانِ : اللِّسَانِ ، وَالأَنْفِ ، وَشِبْهِ ذَلِكَ ، الدِّيَةُ ، وَفِي الاثْنَيْنِ الدِّيَةُ \" , قُلْتُ : الشَّفَتَيْنِ ؟ قَالَ : \" لَعَلَّ ذَلِكَ \" /27 * \r\n\u0018E2975",
