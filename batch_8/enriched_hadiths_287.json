      "chapter_id": null,
      "hadith_number": 180,
      "text_ar": "حَدَّثَنَا /94 الْوَصَّافِيُّ L5378 /94 ، قَالَ : حَدَّثَنَا /26 مُحَمَّدُ بْنُ نَافِعٍ L30829 /26 ، قَالَ : /27 قَالَتْ /93 عَائِشَةُ L4049 /93 : /20 \" نَزَلَتْ هَذِهِ الآيَةُ فِي الْمُؤَذِّنِينَ : /4 وَمَنْ أَحْسَنُ قَوْلا مِمَّنْ دَعَا إِلَى اللَّهِ وَعَمِلَ صَالِحًا سورة فصلت آية 33 /4 فَأَذِّنْ وَصَلِّ فَهُوَ عَمَلٌ صَالِحٌ \" /27 * \r\n$158  158 /3",
      "sanad_ar": "حَدَّثَنَا /94 الْوَصَّافِيُّ L5378 /94",
      "matn_ar": "قَالَ : حَدَّثَنَا /26 مُحَمَّدُ بْنُ نَافِعٍ L30829 /26 ، قَالَ : /27 قَالَتْ /93 عَائِشَةُ L4049 /93 : /20 \" نَزَلَتْ هَذِهِ الآيَةُ فِي الْمُؤَذِّنِينَ : /4 وَمَنْ أَحْسَنُ قَوْلا مِمَّنْ دَعَا إِلَى اللَّهِ وَعَمِلَ صَالِحًا سورة فصلت آية 33 /4 فَأَذِّنْ وَصَلِّ فَهُوَ عَمَلٌ صَالِحٌ \" /27 * \r\n$158  158 /3",
      "grade": null,
