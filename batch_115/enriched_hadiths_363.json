    {
      "hadith_id": 1031439,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 40885,
      "text_ar": "0 /11 ابْن ماجه /11 /11 وأَبُو بكر إبراهيم بْن مُحَمَّد بْن جعفر بْن عمار البرجمي /11 /11 وإبراهيم بْن مُحَمَّد بْن الحسن بْن متويه الأصبهاني /11 /11 وأَحْمَد بْن سهل بْن بحر النيسابوري /11 /11 وأَحْمَد بْن يحيى بْن زهير التستري /11 /11 وبدر بْن الهيثم القاضي /11 /11 وحاجب بْن أركين الفرغاني /11 /11 وخليل بْن أَبِي رافع الواسطي /11 /11 والعباس بْن الفضل بْن شاذان /11 /11 وأَبُو بكر عَبْد اللَّه بْن أَبِي داود /11 /11 وعَبْد الرحمن بْن أَبِي حاتم الرازي /11 /11 وعبيد اللَّه بْن ثابت بْن أَحْمَد الجريري /11 /11 وعلي بْن العباس البجلي المقانعي /11 /11 وأَبُو العباس مُحَمَّد بْن أَحْمَد بْن سليمان الهروي /11 /11 وأَبُو حاتم مُحَمَّد بْن إدريس الرازي /11 /11 وأَبُو بكر مُحَمَّد بْن إسحاق بْن خزيمة /11 /11 وأَبُو جعفر مُحَمَّد بْن الحسين بْن علي بْن حريث بْن بحر المعروف بابن حاجب النيسابوري /11 /11 ومُحَمَّد بْن مسلم بْن وراة الرازي /11 # قال أبو زرعة : رأيت مُحَمَّد بْن مسلم يعظم شأن عَمْرو الأودي ، ويطنب   في ذكره . # وقال",
      "sanad_ar": "0 /11 ابْن ماجه /11 /11 وأَبُو بكر إبراهيم بْن مُحَمَّد بْن جعفر بْن عمار البرجمي /11 /11 وإبراهيم بْن مُحَمَّد بْن الحسن بْن متويه الأصبهاني /11 /11 وأَحْمَد بْن سهل بْن بحر النيسابوري /11 /11 وأَحْمَد بْن يحيى بْن زهير التستري /11 /11 وبدر بْن الهيثم القاضي /11 /11 وحاجب بْن أركين الفرغاني /11 /11 وخليل بْن أَبِي رافع الواسطي /11 /11 والعباس بْن الفضل بْن شاذان /11 /11 وأَبُو بكر عَبْد اللَّه بْن أَبِي داود /11 /11 وعَبْد الرحمن بْن أَبِي حاتم الرازي /11 /11 وعبيد اللَّه بْن ثابت بْن أَحْمَد الجريري /11 /11 وعلي بْن العباس البجلي المقانعي /11 /11 وأَبُو العباس مُحَمَّد بْن أَحْمَد بْن سليمان الهروي /11 /11 وأَبُو حاتم مُحَمَّد بْن إدريس الرازي /11 /11 وأَبُو بكر مُحَمَّد بْن إسحاق بْن خزيمة /11 /11 وأَبُو جعفر مُحَمَّد بْن الحسين بْن علي بْن حريث بْن بحر المعروف بابن حاجب النيسابوري /11 /11 ومُحَمَّد بْن مسلم بْن وراة الرازي /11 # قال أبو زرعة",
      "matn_ar": "رأيت مُحَمَّد بْن مسلم يعظم شأن عَمْرو الأودي ، ويطنب   في ذكره . # وقال",
