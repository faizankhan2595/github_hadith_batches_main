    {
      "hadith_id": 1034493,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 43939,
      "text_ar": "قاضيها أخو أبي عبيدة بْن معن ، وابن أخي القاسم بْن عَبْد الرَّحْمَنِ /10 أبان بْن تغلب /10 /10 وإبراهيم بْن مُحَمَّد بْن المنتشر /10 /10 والأجلح بْن عَبْد اللَّهِ الكندي /10 /10 وإسماعيل بْن أبي خالد /10 /10 وإسماعيل بْن مسلم /10 /10 وجعفر بْن مُحَمَّد الصادق /10 /10 وحجاج بْن أرطاة /10 /10 وحصين بْن عَبْد الرَّحْمَنِ /10 /10 وحميد الطويل /10 /10 وداود بْن أبي هند /10 /10 وسليمان الأعمش س /10 /10 وسليمان التيمي /10 /10 وسليمان الشيباني /10 /10 وطلحة بْن يَحْيَى بْن طلحة بْن عبيد الله س /10 /10 وعاصم الأحول /10 /10 وعَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ المسعودي د /10 /10 وعبد الملك بْن جريج /10 /10 وعبد الملك بْن أبي سليمان /10 /10 وعبد الملك بْن عمير /10 /10 ومجالد بْن سعيد /10 /10 ومُحَمَّد بْن سوقة /10 /10 ومُحَمَّد بْن عجلان /10 /10 ومُحَمَّد بْن عمرو بْن علقمة /10 /10 ومسعر بْن كدام /10 /10 ومنصور بْن المعتمر س /10 /10 وموسى بْن عقبة /10 /10 وأبي حنيفة النعمان بْن ثابت /10 /10 وهشام بْن حسان /10 /10 وهشام بْن عروة /10 /10 ويحيى بْن أبي أنيسة الجزري /10 /10 ويحيى بْن سعيد الأنصاري /10",
      "sanad_ar": "قاضيها أخو أبي عبيدة بْن معن",
      "matn_ar": "وابن أخي القاسم بْن عَبْد الرَّحْمَنِ /10 أبان بْن تغلب /10 /10 وإبراهيم بْن مُحَمَّد بْن المنتشر /10 /10 والأجلح بْن عَبْد اللَّهِ الكندي /10 /10 وإسماعيل بْن أبي خالد /10 /10 وإسماعيل بْن مسلم /10 /10 وجعفر بْن مُحَمَّد الصادق /10 /10 وحجاج بْن أرطاة /10 /10 وحصين بْن عَبْد الرَّحْمَنِ /10 /10 وحميد الطويل /10 /10 وداود بْن أبي هند /10 /10 وسليمان الأعمش س /10 /10 وسليمان التيمي /10 /10 وسليمان الشيباني /10 /10 وطلحة بْن يَحْيَى بْن طلحة بْن عبيد الله س /10 /10 وعاصم الأحول /10 /10 وعَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ المسعودي د /10 /10 وعبد الملك بْن جريج /10 /10 وعبد الملك بْن أبي سليمان /10 /10 وعبد الملك بْن عمير /10 /10 ومجالد بْن سعيد /10 /10 ومُحَمَّد بْن سوقة /10 /10 ومُحَمَّد بْن عجلان /10 /10 ومُحَمَّد بْن عمرو بْن علقمة /10 /10 ومسعر بْن كدام /10 /10 ومنصور بْن المعتمر س /10 /10 وموسى بْن عقبة /10 /10 وأبي حنيفة النعمان بْن ثابت /10 /10 وهشام بْن حسان /10 /10 وهشام بْن عروة /10 /10 ويحيى بْن أبي أنيسة الجزري /10 /10 ويحيى بْن سعيد الأنصاري /10",
