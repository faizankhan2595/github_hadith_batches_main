    {
      "hadith_id": 1030695,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 40141,
      "text_ar": "2 . # وقال أَبُو طالب ، عن أحمد بْن حنبل : كل شيء روى ابْن جريج ، عن عمر بْن عطاء ، عن عكرمة ، فهو عمر بْن عطاء بْن وراز . وكل شيء روى ابْن جريج ، عن عمر بْن عطاء ، عن ابْن عباس ، فهو عمر بْن عطاء بْن أَبِي الخوار ، كَانَ كبيرا قِيلَ لَهُ : أيروي ابْن أَبِي الخوار ، عن عكرمة ؟ قال : لا ، من قال عمر بْن عطاء بْن أَبِي الخوار ، عن عكرمة ، فقد أخطأ ، إنما روى عن عكرمة عمر بْن عطاء بْن وراز ولم يرو ابْن أَبِي الخوار عن عكرمة شيئا # وقال",
      "sanad_ar": "2 . # وقال أَبُو طالب",
      "matn_ar": "عن أحمد بْن حنبل : كل شيء روى ابْن جريج ، عن عمر بْن عطاء ، عن عكرمة ، فهو عمر بْن عطاء بْن وراز . وكل شيء روى ابْن جريج ، عن عمر بْن عطاء ، عن ابْن عباس ، فهو عمر بْن عطاء بْن أَبِي الخوار ، كَانَ كبيرا قِيلَ لَهُ : أيروي ابْن أَبِي الخوار ، عن عكرمة ؟ قال : لا ، من قال عمر بْن عطاء بْن أَبِي الخوار ، عن عكرمة ، فقد أخطأ ، إنما روى عن عكرمة عمر بْن عطاء بْن وراز ولم يرو ابْن أَبِي الخوار عن عكرمة شيئا # وقال",
