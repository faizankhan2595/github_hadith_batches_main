    {
      "hadith_id": 1032975,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 42421,
      "text_ar": "0 /11 أَبُو داود /11 /11 وأَحْمَد بْن يحيى بْن زهير التستري /11 /11 والحسين بْن أَحْمَد بْن بسطام الزعفراني /11 /11 وأَبُو عروبة الحسين بْن مُحَمَّد الحراني /11 /11 وزكريا بْن يحيى الساجي /11 /11 وسهل بْن موسى شيران الرامهرمزي /11 /11 وأَبُو بكر عَبْد اللَّه بْن أَبِي داود /11 /11 وعَبْدان بْن أَحْمَد الأهوازي /11 /11 وعلي بْن عَبْد اللَّه بْن مبشر الواسطي /11 /11 ومُحَمَّد بْن صالح بْن الوليد النرسي /11 /11 ومحمود بْن مُحَمَّد الواسطي /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 /11 وأَبُو العباس الهروي /11 # قال أَبُو داود : ما رأيت أَحْمَد مدح انسانا قط إلا عيسى بْن شاذان ، وسمعت أَحْمَد يقول : عيسى بْن شاذان كيس . # وقال أَبُو عبيد الآجري : سمعت أبا داود يقول : ما رأيت أحفظ من النفيلي ، قلت له : ولا عيسى بْن شاذان ؟ قال : ولا عيسى   بْن شاذان . #",
      "sanad_ar": "0 /11 أَبُو داود /11 /11 وأَحْمَد بْن يحيى بْن زهير التستري /11 /11 والحسين بْن أَحْمَد بْن بسطام الزعفراني /11 /11 وأَبُو عروبة الحسين بْن مُحَمَّد الحراني /11 /11 وزكريا بْن يحيى الساجي /11 /11 وسهل بْن موسى شيران الرامهرمزي /11 /11 وأَبُو بكر عَبْد اللَّه بْن أَبِي داود /11 /11 وعَبْدان بْن أَحْمَد الأهوازي /11 /11 وعلي بْن عَبْد اللَّه بْن مبشر الواسطي /11 /11 ومُحَمَّد بْن صالح بْن الوليد النرسي /11 /11 ومحمود بْن مُحَمَّد الواسطي /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 /11 وأَبُو العباس الهروي /11 # قال أَبُو داود",
