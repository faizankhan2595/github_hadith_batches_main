    {
      "hadith_id": 1032974,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 42420,
      "text_ar": "نزيل مصر . /10 إبراهيم بْن أَبِي سويد الذراع /10 /10 وحفص بْن عمر الحوضي /10 /10 وداود بْن شبيب /10 /10 وزيد بْن عوف /10 /10 وشهاب بْن عباد العَبْدي /10 /10 وأبي همام الصلت بْن مُحَمَّد الخاركي /10 /10 وعَبْد اللَّه بْن رجاء الغداني /10 /10 وعلي بْن الحسين بْن حويص الكوفي /10 /10 وعمر بْن حفص بْن غياث /10 /10 وعمرو بْن العباس الباهلي /10 /10 وعياش بْن الوليد الرقام د /10 /10 وأبي كامل فضيل بْن حسين الجحدري /10 /10 وأبي يَعْلَى مُحَمَّد بْن الصلت التوزي /10 /10 وأبي النعمان مُحَمَّد بْن الفضل السدوسي /10 /10 ومُحَمَّد بْن محبوب البناني /10 /10 وأبي حذيفة موسى بْن مسعود النهدي /10 /10 وهشام بْن عمار السلمي /10 /10 وأبي مُحَمَّد الأشعري الحراني /10 /10 وأبي همام الدلال /10 /10 وأبي الوليد الطيالسي /10",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10,/10",
      "created_at": "2025-11-04 07:50:02",
