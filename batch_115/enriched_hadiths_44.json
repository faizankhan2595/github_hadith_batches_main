    {
      "hadith_id": 1026657,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 36103,
      "text_ar": "ويقال عُثْمَان بْن حصن بْن عُبَيْدَة بْن علاق ويقال عُثْمَان بْن عُبَيْدَة بْن حصن بْن علاق ويقال عُثْمَان بْن عَبْد الرَّحْمَنِ بْن علاق ويقال عُثْمَان بْن عَبْد الرَّحْمَنِ بْن حصن بْن عُبَيْدَة بْن علاق الشامي أَبُو عَبْد الرَّحْمَنِ ويقال أَبُو عَبْد اللَّهِ الدمشقي مولى قريش /10 ثابت بْن ثوبان /10 /10 وثور بْن يَزِيد الحمصي /10 /10 وجناح والد مَرْوَان بْن جناح /10 /10 وروح بْن جناح /10 /10 والحجاج بْن لوط من ولد البراء بْن عازب /10 /10 وحفص بْن سُلَيْمَان /10 /10 والربيع بْن لوط من ولد البراء بْن عازب /10 /10 وزرعة بْن إِبْرَاهِيم /10 /10 وزهير بْن مُحَمَّد التميمي /10 /10 وزيد بْن واقد س /10 /10 وسعيد بْن عَبْد الْعَزِيز /10 /10 وعَبْد الرَّحْمَنِ بْن عَمْرو الأوزاعي /10 /10 وعروة بْن رويم اللخمي س /10 /10 وعمرو بْن قَيْس السكوني الحمصي /10 /10 وعمرو بْن مهاجر الأَنْصَارِي /10 /10 والعلاء بْن الْحَارِث /10 /10 وموسى بْن يسار الدمشقي /10 /10 ويزيد بْن عُبَيْدَة بْن أَبِي المهاجر مد /10 /10 ويزيد بْن أَبِي مريم الشامي /10 /10 وأبي سُفْيَان القيني /10",
