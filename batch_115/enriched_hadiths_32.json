      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 35914,
      "text_ar": "ثُمَّ الشعباني أَبُو الْعَبَّاس الشامي الأردني الطَّبَرَانِي /10 إِبْرَاهِيم بْن سَعْد فيما قيل /10 /10 وحرام بْن حَكِيم الدمشقي /10 /10 وحصين بْن حرملة المهري /10 /10 وسليمان بْن موسى الدمشقي /10 /10 وسليمان بْن يَزِيد النصري /10 /10 وأبي سُفْيَان طَلْحَة بْن نَافِع ق /10 /10 وعبادة بْن نسي /10 /10 وعبد اللَّه بْن سويد العكي الألهاني /10 /10 وعبد اللَّه بْن عَبْد اللَّهِ بْن جبر الأَنْصَارِي /10 /10 وعبد اللَّه بْن عيسى د وقيل عيسى بْن عَبْد اللَّهِ /10 /10 وعَبْد الرَّحْمَنِ بْن أَبِي قَيْس /10 /10 وأبي مريم عَبْد الغفار بْن القاسم الكوفي /10 /10 وعبد الْمَلِك بْن أَبِي بَكْر بْن عَبْد الرَّحْمَنِ بْن الْحَارِث بْن هِشَام س /10 /10 وعبد الْمَلِك بْن جريج ومَاتَ قبله /10 /10 وعطاء الخراساني /10 /10 وعمارة بْن راشد الليثي /10 /10 وعمرو بْن جارية اللخمي عخ د ت ق /10 /10 وعيسى بْن عَبْد اللَّهِ بْن مَالِك الدار /10 /10 وعيسى بْن عَبْد الرَّحْمَنِ بْن أَبِي ليلى /10 /10 والقاسم أَبِي عَبْد الرَّحْمَنِ الشامي /10 /10 وقَتَادَة بْن دعامة /10 /10 ومُحَمَّد بْن مُسْلِم بْن شهاب الزهري ت /10 /10 ومكحول الشامي /10 /10 وهبيرة بْن عَبْد الرَّحْمَنِ الشامي /10 /10 ويزيد بْن أبان الرقاشي /10",
