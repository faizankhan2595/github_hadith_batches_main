    {
      "hadith_id": 1026907,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 36353,
      "text_ar": "0 /11 إِسْمَاعِيل بْن عَمْرو البجلي /11 /11 وصغدي بْن سنان /11 /11 وأَبُو عَاصِم الضحاك بْن مخلد تم ق /11 /11 وعبد اللَّه بْن دَاوُد الخريبي /11 /11 ومُحَمَّد بْن ربيعة الكلابي /11 ++ قال أَبُو طَالِب ، عَنْ أَحْمَد بْن حنبل : مستقيم بْن عَبْد الْمَلِك اسمه عُثْمَان بْن عَبْد الْمَلِك ، ومستقيم لقبه ، حَدِيثه لَيْسَ بذاك . # وقال عَبَّاس الدوري ، عَنْ يَحْيَى بْن معين : مستقيم بْن عَبْد الْمَلِك رجل من أَهل مَكَّة ، وليس بِهِ بأس ، مَا رأينا أحد يحدث عَنْهُ إلا مُحَمَّد بْن ربيعة ، ورجلا آخر . # وقال",
      "sanad_ar": "0 /11 إِسْمَاعِيل بْن عَمْرو البجلي /11 /11 وصغدي بْن سنان /11 /11 وأَبُو عَاصِم الضحاك بْن مخلد تم ق /11 /11 وعبد اللَّه بْن دَاوُد الخريبي /11 /11 ومُحَمَّد بْن ربيعة الكلابي /11 ++ قال أَبُو طَالِب",
      "matn_ar": "عَنْ أَحْمَد بْن حنبل : مستقيم بْن عَبْد الْمَلِك اسمه عُثْمَان بْن عَبْد الْمَلِك ، ومستقيم لقبه ، حَدِيثه لَيْسَ بذاك . # وقال عَبَّاس الدوري ، عَنْ يَحْيَى بْن معين : مستقيم بْن عَبْد الْمَلِك رجل من أَهل مَكَّة ، وليس بِهِ بأس ، مَا رأينا أحد يحدث عَنْهُ إلا مُحَمَّد بْن ربيعة ، ورجلا آخر . # وقال",
