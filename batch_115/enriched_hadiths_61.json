      "hadith_id": 1026906,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 36352,
      "text_ar": "مؤذن الْمَسْجِد الحرام يقال لَهُ مستقيم بْن عَبْد الْمَلِك قال أَحْمَد بْن حنبل : مستقيم لقب ، رأى الْحَسَن والحسين وابن عُمَر . /10 سالم بْن عَبْد اللَّهِ بْن عُمَر تم ق /10 /10 وسعيد بْن الْمُسَيِّب /10 /10 وشهر بْن حوشب /10 /10 وعطاء بْن أَبِي رباح /10",
      "sanad_ar": "مؤذن الْمَسْجِد الحرام يقال لَهُ مستقيم بْن عَبْد الْمَلِك قال أَحْمَد بْن حنبل",
