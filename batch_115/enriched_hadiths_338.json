    {
      "hadith_id": 1031068,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 40514,
      "text_ar": "0 /11 إسماعيل بْن أَبِي خالد بخ /11 /11 ومولاه أصبغ د ق /11 /11 وابْنه جعفر بْن عمرو بْن حريث م د تم س ق /11 /11 والحسن العرني خ م س /11 /11 وخلف بْن خليفة تم رآه رؤية /11 /11 وخليفة والد فطر بْن خليفة د /11 /11 وسعيد بْن مردانبة /11 /11 وسوقة والد محمد بْن سوقة /11 /11 وأبو همام عبد اللَّه بْن يسار الكوفي /11 /11 وعبد الملك بْن عمير خ م ت س ق /11 /11 وعطاء بْن السائب /11 /11 وابْن أخيه عمرو بْن عبد الملك بْن حريث /11 /11 والمغيرة بْن سبيع ت ق /11 /11 ومولاه أَبُو موسى هارون بْن سلمان الفراء الكوفي /11 /11 والوليد بْن سريع م س /11 /11 وأبو الأسود المحاربي س /11 ++ قال الواقدي : توفي النبي صَلَّى اللَّهُ عليه وسلم ، وهو ابْن اثنتي عشرة سنة . \r\n$2480  -10 /3 /141 وقال /26 الوليد بْن أبان الأصبهاني /26 : حَدَّثَنَا /26 محمد بْن يحيى المصاحفي /26 ، قال : حَدَّثَنَا /26 عبيد اللَّه بْن معاذ /26 ، قال : حَدَّثَنَا /26 أَبِي /26 ، قال : حَدَّثَنَا /26 قرة بْن خالد /26 ، عن /26 محمد بْن سيرين /26 ، /27 أن /93 عمرو بْن حريث /93 /20 تزوج بْنت عدي بْن حاتم عَلَى حكم عدي ، فندمه الناس ، وقالوا : لعله يحكم فيكثر ، فحكم عدي ثنتي عشرة أوقية ، فأرسل إِلَيْهِ عمرو ببدرة فِيهَا عشرة آلاف /27 . أَخْبَرَنَا بذلك /94 أَبُو الحسن بْن البخاري L75025 /94 ، قال : أَنْبَأَنَا /26 أَبُو جعفر الصيدلاني L46610 /26 ، قال : أَخْبَرَنَا /26 محمود بن إسماعيل الصيرفي L31136 /26 ، قال : أَخْبَرَنَا /26 أَبُو بكر بْن شاذان الأعرج L44975 /26 ، قال : أَخْبَرَنَا /26 أَبُو بكر بْن فورك القباب L44949/26 ، قال : حَدَّثَنَا الوليد بْن أبان ، فذكره * \r\n++ قال البخاري ، وغيره : توفي سنة خمس وثمانين . ++ روى له الجماعة . @ 6067 [ 4346 ] د\u001dE3762",
      "sanad_ar": "0 /11 إسماعيل بْن أَبِي خالد بخ /11 /11 ومولاه أصبغ د ق /11 /11 وابْنه جعفر بْن عمرو بْن حريث م د تم س ق /11 /11 والحسن العرني خ م س /11 /11 وخلف بْن خليفة تم رآه رؤية /11 /11 وخليفة والد فطر بْن خليفة د /11 /11 وسعيد بْن مردانبة /11 /11 وسوقة والد محمد بْن سوقة /11 /11 وأبو همام عبد اللَّه بْن يسار الكوفي /11 /11 وعبد الملك بْن عمير خ م ت س ق /11 /11 وعطاء بْن السائب /11 /11 وابْن أخيه عمرو بْن عبد الملك بْن حريث /11 /11 والمغيرة بْن سبيع ت ق /11 /11 ومولاه أَبُو موسى هارون بْن سلمان الفراء الكوفي /11 /11 والوليد بْن سريع م س /11 /11 وأبو الأسود المحاربي س /11 ++ قال الواقدي",
      "matn_ar": "توفي النبي صَلَّى اللَّهُ عليه وسلم ، وهو ابْن اثنتي عشرة سنة . \r\n$2480  -10 /3 /141 وقال /26 الوليد بْن أبان الأصبهاني /26 : حَدَّثَنَا /26 محمد بْن يحيى المصاحفي /26 ، قال : حَدَّثَنَا /26 عبيد اللَّه بْن معاذ /26 ، قال : حَدَّثَنَا /26 أَبِي /26 ، قال : حَدَّثَنَا /26 قرة بْن خالد /26 ، عن /26 محمد بْن سيرين /26 ، /27 أن /93 عمرو بْن حريث /93 /20 تزوج بْنت عدي بْن حاتم عَلَى حكم عدي ، فندمه الناس ، وقالوا : لعله يحكم فيكثر ، فحكم عدي ثنتي عشرة أوقية ، فأرسل إِلَيْهِ عمرو ببدرة فِيهَا عشرة آلاف /27 . أَخْبَرَنَا بذلك /94 أَبُو الحسن بْن البخاري L75025 /94 ، قال : أَنْبَأَنَا /26 أَبُو جعفر الصيدلاني L46610 /26 ، قال : أَخْبَرَنَا /26 محمود بن إسماعيل الصيرفي L31136 /26 ، قال : أَخْبَرَنَا /26 أَبُو بكر بْن شاذان الأعرج L44975 /26 ، قال : أَخْبَرَنَا /26 أَبُو بكر بْن فورك القباب L44949/26 ، قال : حَدَّثَنَا الوليد بْن أبان ، فذكره * \r\n++ قال البخاري ، وغيره : توفي سنة خمس وثمانين . ++ روى له الجماعة . @ 6067 [ 4346 ] د\u001dE3762",
