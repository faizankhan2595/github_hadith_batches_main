    {
      "hadith_id": 1034470,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 43916,
      "text_ar": "أخبرنا /94 أبو الحسن بن البخاري L75025 /94 ، في جماعة ، قَالُوا : أخبرنا /26 أَبُو حَفْص بْن طبرزد /26 ، قال : أخبرنا القاضي /26 أَبُو بَكْر مُحَمَّد بْن عَبْد الْبَاقِي الأنصاري /26 ، قال : أخبرني /26 أبي /26 ، قال : أخبرنا /26 أَبُو الحسن أَحْمَد بْن مُحَمَّد بْن الصلت المجبر /26 ، قال : أخبرنا /26 أَبُو إِسْحَاق إِبْرَاهِيم بْن عَبْد الصَّمَدِ الهاشمي /26 ، قال : حدثنا /26 مُحَمَّد بْن الوليد المخزومي /26   مولى لقريش ، قال : حدثنا /26 القاسم بْن أبي سفيان المعمري /26 ، قال : حدثنا /26 عَبْد الرَّحْمَنِ بْن مُحَمَّد بْن حبيب بْن أبي حبيب /26 ، عَنْ /26 أبيه /26 ، عَنْ /26 جده /26 ، قال : /27 شهدت /26 خالد بْن عَبْد اللَّهِ القسري /26 ، خطب الناس يوم النحر ، فَقَالَ : /20 من كان منكم يريد أن يضحي فلينطلق فليضح ، فبارك الله له أضحيته ، فإني مضح بالجعد بْن درهم زعم أن الله لم يكلم مُوسَى تكليما ، ولم يتخذ إِبْرَاهِيم خليلا ، سبحان الله عما يقول الجعد علوا كبيرا ، ثم نزل إليه فذبحه /27 . رواه عَنْ قتيبة عنه ، فوقع لنا بَدَلا عاليا ، وقد كتبناه من وجه آخر ، عَنْ قتيبة ، في ترجمة خالد القسري * \r\n. @ 6661 [ 4822 ] ق\u001fE4116",
      "sanad_ar": "أخبرنا /94 أبو الحسن بن البخاري L75025 /94",
      "matn_ar": "في جماعة ، قَالُوا : أخبرنا /26 أَبُو حَفْص بْن طبرزد /26 ، قال : أخبرنا القاضي /26 أَبُو بَكْر مُحَمَّد بْن عَبْد الْبَاقِي الأنصاري /26 ، قال : أخبرني /26 أبي /26 ، قال : أخبرنا /26 أَبُو الحسن أَحْمَد بْن مُحَمَّد بْن الصلت المجبر /26 ، قال : أخبرنا /26 أَبُو إِسْحَاق إِبْرَاهِيم بْن عَبْد الصَّمَدِ الهاشمي /26 ، قال : حدثنا /26 مُحَمَّد بْن الوليد المخزومي /26   مولى لقريش ، قال : حدثنا /26 القاسم بْن أبي سفيان المعمري /26 ، قال : حدثنا /26 عَبْد الرَّحْمَنِ بْن مُحَمَّد بْن حبيب بْن أبي حبيب /26 ، عَنْ /26 أبيه /26 ، عَنْ /26 جده /26 ، قال : /27 شهدت /26 خالد بْن عَبْد اللَّهِ القسري /26 ، خطب الناس يوم النحر ، فَقَالَ : /20 من كان منكم يريد أن يضحي فلينطلق فليضح ، فبارك الله له أضحيته ، فإني مضح بالجعد بْن درهم زعم أن الله لم يكلم مُوسَى تكليما ، ولم يتخذ إِبْرَاهِيم خليلا ، سبحان الله عما يقول الجعد علوا كبيرا ، ثم نزل إليه فذبحه /27 . رواه عَنْ قتيبة عنه ، فوقع لنا بَدَلا عاليا ، وقد كتبناه من وجه آخر ، عَنْ قتيبة ، في ترجمة خالد القسري * \r\n. @ 6661 [ 4822 ] ق\u001fE4116",
