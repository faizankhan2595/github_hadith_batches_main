    {
      "hadith_id": 1034954,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 44400,
      "text_ar": "/34 أخبرنا بِهِ /94 أحمد بن أبي الخير L63250 /94 ، بِالإِسْنَادِ الْمَذْكُورِ آنِفًا ، إِلَى /26 أَبِي نُعَيْمٍ L9927 /26 ، قال : حدثنا /26 أَبُو عَمْرُو بْنُ حَمْدَانَ L28230 /26 ، قال : حدثنا /26 الْحَسَنُ بْنُ سُفْيَانَ L14872 /26 . ح قال : وحدثنا /26 سُلَيْمَانُ بْنُ أَحْمَدَ L18570 /26 ، قال : حدثنا /26 عُبَيْدُ بْنُ غَنَّامٍ L22778 /26 ، قَالا : حدثنا /26 أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ L5049 /26 ، قال : حدثنا /26 وكيع L8160 /26 ، عَنْ /26 سُفْيَانَ L3436 /26 ، عَنْ /26 عَلْقَمَةَ بْنِ مَرْثَدٍ L5716 /26 ، /27 عَنْ /26 سُلَيْمَانَ بْنِ بُرَيْدَةَ L3572 /26 ، عَنْ /93 أَبِيهِ L1841 /93 ، قال رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ : /20 \" حُرْمَةُ نِسَاءِ الْمُجَاهِدِينَ عَلَى الْقَاعِدِينَ كَحُرْمَةِ أُمَّهَاتِهِمْ ، ومَا أَحَدٌ مِنَ الْقَاعِدِينَ يَخْلُفُ أَحَدًا مِنَ الْمُجَاهِدِينَ فِي أَهْلِهِ بِسُوءٍ إِلا أُقِيمَ لَهُ يَوْمَ الْقِيَامَةِ ، فَقِيلَ : هَذَا خَلَفَكَ فِي أَهْلِكَ بِسُوءٍ فَخُذْ مِنْ حَسَنَاتِهِ بِمَا شِئْتَ ، فَمَا ظَنُّكُمْ \" /27 ، وبه قال : حدثنا",
      "sanad_ar": "/34 أخبرنا بِهِ /94 أحمد بن أبي الخير L63250 /94",
