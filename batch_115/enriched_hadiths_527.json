    {
      "hadith_id": 1033905,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 43351,
      "text_ar": "/10 إدريس بْن يَحْيَى الخولاني /10 /10 وأسد بْن مُوسَى /10 /10 وحبيب بْن أبي حبيب ق كاتب مالك /10 /10 وحجاج بْن مُحَمَّد المصيصي خ /10 /10 والحسن بْن بلال البصري /10 /10 والحسن بْن مُحَمَّد بْن أعين الجزري خ /10 /10 ورواد بْن الجراح العسقلاني /10 /10 وزيد بْن يَحْيَى بْن عبيد الدمشقي /10 /10 وسعيد بْن مسلمة الأموي /10 /10 وأبي عاصم الضحاك بْن مخلد /10 /10 وطاهر بْن حماد بْن عمرو النصيبي /10 /10 وطلق بْن السمح المصري /10 /10 وعَبْد اللَّهِ بْن جَعْفَر الرقي خ /10 /10 وعبيد الله بْن مُوسَى الكوفي /10 /10 وعمرو بْن عثمان الكلابي الرقي /10 /10 ومُحَمَّد بْن سابق البزاز خ /10 /10 ومُحَمَّد بْن سليمان بْن أبي دَاوُد الحراني /10 /10 ومُحَمَّد بْن يوسف الفريابي /10 /10 ومروان بْن مُحَمَّد الطاطري /10 /10 ومعمر بْن مخلد السروجي /10 /10 وأبي النضر هاشم بْن القاسم /10 /10 والهيثم بْن جميل /10 /10 ووهب الله بْن راشد المصري المؤذن /10 /10 ويحيى بْن السكن البصري /10 /10 ويحيى بْن يَحْيَى النيسابوري /10 /10 وأبي قتادة الحراني /10",
      "sanad_ar": "",
      "matn_ar": "",
