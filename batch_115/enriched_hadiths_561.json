      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 43851,
      "text_ar": "2 ++ روى له النسائي في مسند عَلِيّ حديثا واحدا ، وقد وقع لنا بعلو عنه . ++ \r\n$2735  -10 /2 /141 أخبرنا بِهِ /94أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 المقدسيان ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حنبل بْن عَبْد اللَّهِ L62448 /26 قال : أخبرنا /26 أَبُو الْقَاسِمِ بْن الحصين L46125/26 ، قال : أخبرنا /26 أَبُو عَلِيّ بْن المذهب L14991 /26 قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مالك L8994 /26 ، قال : حدثنا /26عَبْد اللَّهِ بْن أَحْمَد L4657 /26 ، قال : حَدَّثَنِي /26 أبي L488 /26 ، قال : حدثنا /26 عَبْد الرَّحْمَنِ L4493 /26 ، عَنْ /26 سفيان L3436 /26 ، عَنْ /26 أبي هاشم القاسم بْن كثير L1593 /26 ، عَنْ /26 قيس الخارفي L6524 /26 ، قال : /27 سمعت /93 عليا L5722 /93 ، يقول : /20 سبق رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، وصلى أَبُو بَكْر ، وثلَّث عمر ، ثم خطبتنا أو أصابتنا فتنة ، فما شاء الله /27 . قال عَبْد اللَّهِ : قال أبي : قوله خطبتنا فتنة أراد أن يتواضع بذلك . رواه عَنْ إِسْحَاق بْن إِبْرَاهِيم ، عَنْ عَبْد الرَّحْمَنِ بْن مهدي ، فوقع لنا بَدَلا عاليا ، ورواه من وجوه أخر عَنْ سفيان * \r\n@ 6655 [ 4816 ]",
      "sanad_ar": "2 ++ روى له النسائي في مسند عَلِيّ حديثا واحدا",
      "matn_ar": "وقد وقع لنا بعلو عنه . ++ \r\n$2735  -10 /2 /141 أخبرنا بِهِ /94أَبُو الْفَرَجِ بْنُ قُدَامَةَ L46136 /94 ، /94 وأَبُو الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 المقدسيان ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حنبل بْن عَبْد اللَّهِ L62448 /26 قال : أخبرنا /26 أَبُو الْقَاسِمِ بْن الحصين L46125/26 ، قال : أخبرنا /26 أَبُو عَلِيّ بْن المذهب L14991 /26 قال : أخبرنا /26 أَبُو بَكْرِ بْنُ مالك L8994 /26 ، قال : حدثنا /26عَبْد اللَّهِ بْن أَحْمَد L4657 /26 ، قال : حَدَّثَنِي /26 أبي L488 /26 ، قال : حدثنا /26 عَبْد الرَّحْمَنِ L4493 /26 ، عَنْ /26 سفيان L3436 /26 ، عَنْ /26 أبي هاشم القاسم بْن كثير L1593 /26 ، عَنْ /26 قيس الخارفي L6524 /26 ، قال : /27 سمعت /93 عليا L5722 /93 ، يقول : /20 سبق رَسُول اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ ، وصلى أَبُو بَكْر ، وثلَّث عمر ، ثم خطبتنا أو أصابتنا فتنة ، فما شاء الله /27 . قال عَبْد اللَّهِ : قال أبي : قوله خطبتنا فتنة أراد أن يتواضع بذلك . رواه عَنْ إِسْحَاق بْن إِبْرَاهِيم ، عَنْ عَبْد الرَّحْمَنِ بْن مهدي ، فوقع لنا بَدَلا عاليا ، ورواه من وجوه أخر عَنْ سفيان * \r\n@ 6655 [ 4816 ]",
