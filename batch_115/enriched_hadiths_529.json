      "hadith_id": 1033931,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 43377,
      "text_ar": "ابْن أخي كامل بْن طلحة الجحدري /10 إِسْمَاعِيل ابْن علية د /10 /10 وبشر بْن المفضل م /10 /10 وبشر بْن مَنْصُور السليمي /10 /10 وجعفر بْن سليمان الضبعي /10 /10 والحارث بْن نبهان /10 /10 وحصين بْن نمير /10 /10 وحماد بْن زيد م د /10 /10 وحماد بْن سلمة /10 /10 وخالد بْن الحارث م د /10 /10 وخالد بْن عَبْد اللَّهِ د /10 /10 وخلف بْن إِسْمَاعِيل /10 /10 وروح بْن عطاء بْن أبي ميمونة /10 /10 وسليم بْن أخضر م د /10 /10 وسلام بْن أبي الصهباء /10 /10 وعاصم بْن هلال البارقي /10 /10 وعَبْد اللَّهِ بْن جَعْفَر المديني /10 /10 وعبد الحميد بْن الحسن الهلالي /10 /10 وعبد العزيز بْن عَبْد الصَّمَدِ العمي م /10 /10 وعبد العزيز بْن المختار م د /10 /10 وعبد الواحد بْن زياد م د /10 /10 وعثمان بْن عَبْد الرَّحْمَنِ الجمحي /10 /10 وفضيل بْن سليمان النميري /10 /10 ومُحَمَّد بْن جَعْفَر غندر /10 /10 وأبي بشر مطهر بْن سوار /10 /10 ونوح بْن قيس الحداني قد /10 /10 وأبي عوانة الوضاح بْن عَبْد اللَّهِ م د س /10 /10 ويحيى بْن سعيد القطان م /10 /10 ويحيى بْن كثير أبي النضر /10 /10 ويزيد بْن زريع م د /10 /10 وأبي دَاوُد الطيالسي د /10 /10 وأبي عَلِيّ الحنفي /10 /10 وأبي معشر البراء خت /10",
