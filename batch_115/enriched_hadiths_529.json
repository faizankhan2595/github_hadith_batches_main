    {
      "hadith_id": 1033925,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 43371,
      "text_ar": "أخبرنا بِهِ /94 أبو الحسن بن البخاري L75025 /94 ، قال : أَنْبَأَنَا /26 مُحَمَّدُ بْنُ أَبِي زَيْدٍ الْكَرَّانِيُّ L75048/26 ، قال : أخبرنا /26 مَحْمُودُ بْنُ إِسْمَاعِيلَ الصَّيْرَفِيُّ L31136 /26 ، قال : أخبرنا /26أَبُو الْحُسَيْنِ بْنُ فَاذَشَاهْ L36872 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ الطَّبَرَانِيُّ L18570 /26 ، قال : حدثنا /26 مُعَاذُ بْنُ الْمُثَنَّى L31773 /26 ، /26 ومُوسَى بْنُ هَارُونَ L32474 /26 ، /26 ومُحَمَّدُ بْنُ العَبَّاسِ الْمُؤَدِّبُ L27795 /26 ، قَالُوا : حدثنا /26 سَعِيدُ بْنُ يَعْقُوبَ الطَّالِقَانِيُّ L3419 /26 ، قال : حدثنا /26 يَحْيَى بْنُ الضُّرَيْسِ L8226 /26 ، عَنْ /26 أَبِي مَوْدُودٍ L6419 /26 ، عَنْ /26 سُلَيْمَانَ التَّيْمِيِّ L3601 /26 ، عَنْ /26 أَبِي عُثْمَانَ النَّهْدِيِّ L4492 /26 ، /27 عَنْ /93 سَلْمَانَ L3476 /93 ، قال : قال النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ : /20 \" لا يَزِيدُ فِي الْعُمُرِ إِلا الْبِرُّ ولا يَرُدُّ الْقَضَاءَ إِلا الدُّعَاءَ “ /27 . رواه عَنْ سعيد بْن يعقوب ، وغيره فوافقناه فيه بعلو ، وقال : حسن غريب لا نعرفه إلا من حديث يَحْيَى ، وأبو مودود اثنان أحدهما ، يقال له : فضة ، والآخر : عبد العزيز بْن أبي سليمان ، أحدهما : بصري ، والآخر : مدني ، وكانا في عصر واحد ، وأبو مودود الذي روى هذا الحديث اسمه فضة بصري ، هكذا قال الترمذي * \r\n@ 6576 ولهم شيخ آخر ثالث يقال له   @ 6577 [ 4757 ] تمييز#E4058",
      "sanad_ar": "أخبرنا بِهِ /94 أبو الحسن بن البخاري L75025 /94",
      "matn_ar": "قال : أَنْبَأَنَا /26 مُحَمَّدُ بْنُ أَبِي زَيْدٍ الْكَرَّانِيُّ L75048/26 ، قال : أخبرنا /26 مَحْمُودُ بْنُ إِسْمَاعِيلَ الصَّيْرَفِيُّ L31136 /26 ، قال : أخبرنا /26أَبُو الْحُسَيْنِ بْنُ فَاذَشَاهْ L36872 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ الطَّبَرَانِيُّ L18570 /26 ، قال : حدثنا /26 مُعَاذُ بْنُ الْمُثَنَّى L31773 /26 ، /26 ومُوسَى بْنُ هَارُونَ L32474 /26 ، /26 ومُحَمَّدُ بْنُ العَبَّاسِ الْمُؤَدِّبُ L27795 /26 ، قَالُوا : حدثنا /26 سَعِيدُ بْنُ يَعْقُوبَ الطَّالِقَانِيُّ L3419 /26 ، قال : حدثنا /26 يَحْيَى بْنُ الضُّرَيْسِ L8226 /26 ، عَنْ /26 أَبِي مَوْدُودٍ L6419 /26 ، عَنْ /26 سُلَيْمَانَ التَّيْمِيِّ L3601 /26 ، عَنْ /26 أَبِي عُثْمَانَ النَّهْدِيِّ L4492 /26 ، /27 عَنْ /93 سَلْمَانَ L3476 /93 ، قال : قال النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وسَلَّمَ : /20 \" لا يَزِيدُ فِي الْعُمُرِ إِلا الْبِرُّ ولا يَرُدُّ الْقَضَاءَ إِلا الدُّعَاءَ “ /27 . رواه عَنْ سعيد بْن يعقوب ، وغيره فوافقناه فيه بعلو ، وقال : حسن غريب لا نعرفه إلا من حديث يَحْيَى ، وأبو مودود اثنان أحدهما ، يقال له : فضة ، والآخر : عبد العزيز بْن أبي سليمان ، أحدهما : بصري ، والآخر : مدني ، وكانا في عصر واحد ، وأبو مودود الذي روى هذا الحديث اسمه فضة بصري ، هكذا قال الترمذي * \r\n@ 6576 ولهم شيخ آخر ثالث يقال له   @ 6577 [ 4757 ] تمييز#E4058",
