    {
      "hadith_id": 1026734,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 36180,
      "text_ar": "0 /11 جارية بْن هرم /11 /11 ورحمة بْن مُصْعَب /11 /11 وروح بْن عُبَادَة /11 /11 وشعبة بْن الْحَجَّاج /11 /11 وأَبُو عَاصِم الضحاك بْن مخلد ت /11 /11 وعبد السَّلام بْن هاشم البزاز /11 /11 وعمرو بْن النعمان الْبَاهِلِي /11 /11 ومُحَمَّد بْن بَكْر البرساني تم /11 /11 ومُحَمَّد بْن حمران القيسي /11 /11 ومُحَمَّد بْن عَبْد اللَّهِ الأَنْصَارِي /11 /11 ومُحَمَّد بْن عَبْد الْوَاحِد بْن أَبِي حزم القطعي /11 /11 ومكي بْن إِبْرَاهِيم البلخي /11 /11 ويَحْيَى بْن كثير العنبري د /11 /11 ويونس بْن مُحَمَّد المؤدب /11 /11 وأَبُو عُبَيْدَة الْحَدَّاد ت /11 ++ قال عَبْد السَّلام بْن هاشم : حَدَّثَنَا عُثْمَان بْن سَعْد الكاتب ، وكَانَ لَهُ مروءة وعقل . ++ وقال عَلِي بْن المديني : ذكرت عُثْمَان بْن سَعْد ، ليحيى بْن سَعِيد ، فجعل يعجب من الرواية عَنْهُ ، وقال : سمعته يوما ، يَقُول : حَدَّثَنِي عُبَيْد بْن عمير ، قال يَحْيَى : فوصفه ، فَإذَا هُوَ عَبْد اللَّهِ بْن عُبَيْد بْن عمير . ++ وقال أَبُو بَكْر الأثرم : سمعت أبا عَبْد اللَّهِ ، يسأل عَنْ عُثْمَان بْن سَعْد الكاتب ، يَرْوِي عَنْ مجاهد ، قال : كَانَ روح يكثر عَنْهُ ، يحدث عَنْ أَنَس ، وقَدْ حكوا عَنْ يَحْيَى بْن سَعِيد فِيهِ شَيْئًا شديدا . ++ وقال عَبَّاس الدوري ، عَنْ يَحْيَى بْن معين : لَيْسَ بذاك ،   وكَذَلِكَ قال إِبْرَاهِيم بْن عَبْد اللَّهِ بْن الجنيد ، عَنْ مُحَمَّد بْن عَبْد اللَّهِ بْن نمير . # وقال",
      "sanad_ar": "0 /11 جارية بْن هرم /11 /11 ورحمة بْن مُصْعَب /11 /11 وروح بْن عُبَادَة /11 /11 وشعبة بْن الْحَجَّاج /11 /11 وأَبُو عَاصِم الضحاك بْن مخلد ت /11 /11 وعبد السَّلام بْن هاشم البزاز /11 /11 وعمرو بْن النعمان الْبَاهِلِي /11 /11 ومُحَمَّد بْن بَكْر البرساني تم /11 /11 ومُحَمَّد بْن حمران القيسي /11 /11 ومُحَمَّد بْن عَبْد اللَّهِ الأَنْصَارِي /11 /11 ومُحَمَّد بْن عَبْد الْوَاحِد بْن أَبِي حزم القطعي /11 /11 ومكي بْن إِبْرَاهِيم البلخي /11 /11 ويَحْيَى بْن كثير العنبري د /11 /11 ويونس بْن مُحَمَّد المؤدب /11 /11 وأَبُو عُبَيْدَة الْحَدَّاد ت /11 ++ قال عَبْد السَّلام بْن هاشم",
