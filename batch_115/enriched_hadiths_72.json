    {
      "hadith_id": 1027070,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 36516,
      "text_ar": "أَبُو الْفَضْلِ ، ويقال : أَبُو عَلِي البصري وقال سَعِيد بْن سُلَيْمَان : حَدَّثَنَا عُثْمَان بْن عَبْد اللَّهِ المطري . /10 ثابت البناني /10 /10 والحسن بْن أَبِي جَعْفَر الجعفري ق /10 /10 وحنظلة السدوسي /10 /10 وزَكَرِيَّا بْن ميسرة ق /10 /10 وصخر بْن جويرية /10 /10 وعامر الأحول /10 /10 وأبي حريز عَبْد اللَّهِ بْن الْحُسَيْن قَاضِي سجستان /10 /10 وأبي الصباح عَبْد الغفور بْن عَبْد الْعَزِيز الأَنْصَارِي الواسطي /10 /10 وعلي بْن الحكم البناني /10 /10 ومُحَمَّد بْن عَبْد الرَّحْمَنِ بْن أَبِي ذئب /10 /10 ومعمر بْن راشد /10 /10 والهيثم بْن جماز /10 /10 ويَحْيَى بْن عُبَيْد /10 /10 ويزيد بْن زريع وهُوَ من أقرانه /10 /10 وأَبي هَارُون العبدي /10",
      "sanad_ar": "أَبُو الْفَضْلِ",
      "matn_ar": "ويقال : أَبُو عَلِي البصري وقال سَعِيد بْن سُلَيْمَان : حَدَّثَنَا عُثْمَان بْن عَبْد اللَّهِ المطري . /10 ثابت البناني /10 /10 والحسن بْن أَبِي جَعْفَر الجعفري ق /10 /10 وحنظلة السدوسي /10 /10 وزَكَرِيَّا بْن ميسرة ق /10 /10 وصخر بْن جويرية /10 /10 وعامر الأحول /10 /10 وأبي حريز عَبْد اللَّهِ بْن الْحُسَيْن قَاضِي سجستان /10 /10 وأبي الصباح عَبْد الغفور بْن عَبْد الْعَزِيز الأَنْصَارِي الواسطي /10 /10 وعلي بْن الحكم البناني /10 /10 ومُحَمَّد بْن عَبْد الرَّحْمَنِ بْن أَبِي ذئب /10 /10 ومعمر بْن راشد /10 /10 والهيثم بْن جماز /10 /10 ويَحْيَى بْن عُبَيْد /10 /10 ويزيد بْن زريع وهُوَ من أقرانه /10 /10 وأَبي هَارُون العبدي /10",
