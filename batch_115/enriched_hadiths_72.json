    {
      "hadith_id": 1027071,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 36517,
      "text_ar": "0 /11 أَبُو إِبْرَاهِيم إِسْمَاعِيل بْن إِبْرَاهِيم الترجماني /11 /11 وبشر بْن الْوَلِيد الكندي الْقَاضِي /11 /11 وبشر بْن يُوسُف البصري جار عارم /11 /11 وسريج بْن يُونُس /11 /11 وسعد بْن عَبْد الحميد بْن جَعْفَر الأَنْصَارِي /11 /11 وسعيد بْن سُلَيْمَان الواسطي /11 /11 وسعيد بْن هبيرة الكعبي /11 /11 وسويد بْن سَعِيد ق /11 /11 وعبد اللَّه بْن سالم الباجدائي /11 /11 وعبد اللَّه بْن عون الخراز /11 /11 وعَبْد الرَّحْمَنِ بْن المبارك العيشي /11 /11 وعَبْد الرَّحْمَنِ بْن مُحَمَّد المحاربي /11 /11 وعبد الْمَلِك بْن عَبْد ربه الطائي /11 /11 وعلي بْن الجعد /11 /11 وعلي بْن أَبِي هاشم بْن طبراخ /11 /11 وعيسى بْن إِبْرَاهِيم البركي /11 /11 والفيض بْن الوثيق الثقفي /11 /11 ومحرز بْن عون الهلالي /11 /11 ومُحَمَّد بْن أبان الواسطي /11 /11 ومُحَمَّد بْن بُكَيْر الحضرمي /11 /11 ومُحَمَّد بْن الصباح الدولابي /11 /11 ومُحَمَّد بْن عُبَيْد اللَّه /11 /11 ومسلم بْن إِبْرَاهِيم /11 /11 ومعلى بْن مهدي الموصلي /11 /11 وأَبُو همام الْوَلِيد بْن شجاع السكوني /11 /11 ويسرة بْن صفوان الدمشقي /11 /11 وأَبُو بَكْر بْن عياش الأحدب /11 ++ قال حنبل بْن إِسْحَاق   : سمعت أبا عَبْد اللَّهِ ، يَقُول : عُثْمَان بْن مطر بصري قدم بغداد ، قُلْت لَهُ : فكيف هُوَ ؟ قال : لا أدري ، قُلْت : من روى عنه ؟ قال : لا أعلمه ، ولَمْ يعرف حَدِيثه . # وقال",
      "sanad_ar": "0 /11 أَبُو إِبْرَاهِيم إِسْمَاعِيل بْن إِبْرَاهِيم الترجماني /11 /11 وبشر بْن الْوَلِيد الكندي الْقَاضِي /11 /11 وبشر بْن يُوسُف البصري جار عارم /11 /11 وسريج بْن يُونُس /11 /11 وسعد بْن عَبْد الحميد بْن جَعْفَر الأَنْصَارِي /11 /11 وسعيد بْن سُلَيْمَان الواسطي /11 /11 وسعيد بْن هبيرة الكعبي /11 /11 وسويد بْن سَعِيد ق /11 /11 وعبد اللَّه بْن سالم الباجدائي /11 /11 وعبد اللَّه بْن عون الخراز /11 /11 وعَبْد الرَّحْمَنِ بْن المبارك العيشي /11 /11 وعَبْد الرَّحْمَنِ بْن مُحَمَّد المحاربي /11 /11 وعبد الْمَلِك بْن عَبْد ربه الطائي /11 /11 وعلي بْن الجعد /11 /11 وعلي بْن أَبِي هاشم بْن طبراخ /11 /11 وعيسى بْن إِبْرَاهِيم البركي /11 /11 والفيض بْن الوثيق الثقفي /11 /11 ومحرز بْن عون الهلالي /11 /11 ومُحَمَّد بْن أبان الواسطي /11 /11 ومُحَمَّد بْن بُكَيْر الحضرمي /11 /11 ومُحَمَّد بْن الصباح الدولابي /11 /11 ومُحَمَّد بْن عُبَيْد اللَّه /11 /11 ومسلم بْن إِبْرَاهِيم /11 /11 ومعلى بْن مهدي الموصلي /11 /11 وأَبُو همام الْوَلِيد بْن شجاع السكوني /11 /11 ويسرة بْن صفوان الدمشقي /11 /11 وأَبُو بَكْر بْن عياش الأحدب /11 ++ قال حنبل بْن إِسْحَاق",
      "matn_ar": "سمعت أبا عَبْد اللَّهِ ، يَقُول : عُثْمَان بْن مطر بصري قدم بغداد ، قُلْت لَهُ : فكيف هُوَ ؟ قال : لا أدري ، قُلْت : من روى عنه ؟ قال : لا أعلمه ، ولَمْ يعرف حَدِيثه . # وقال",
