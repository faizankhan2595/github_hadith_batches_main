      "hadith_id": 1034253,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 43699,
      "text_ar": "أخو عَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ بْن عمر العمري وابن أخي عبيد الله بْن عمر /10 جَعْفَر بْن مُحَمَّد الصادق /10 /10 وسعد بْن سعيد الأنصاري /10 /10 وسهيل بْن أبي صالح /10 /10 وعاصم بْن عبيد الله بْن عاصم بْن عمر بْن الخطاب /10 /10 وعَبْد اللَّهِ بْن دينار /10 /10 وأبي طوالة عَبْد اللَّهِ بْن عَبْد الرَّحْمَنِ بْن معمر /10 /10 وعَبْد الرَّحْمَنِ بْن الحارث بْن عياش بْن أبي ربيعة /10 /10 وعمه عبيد الله بْن عمر /10 /10 وعلي بْن زيد بْن جدعان /10 /10 وعمرو بْن شعيب /10 /10 وكثير بْن عَبْد اللَّهِ بْن عمرو بْن عوف المزني /10 /10 ومُحَمَّد بْن المنكدر ق /10 /10 وأبي بَكْر بْن عمر بْن عَبْد الرَّحْمَنِ بْن عَبْد اللَّهِ بْن عمر بْن الخطاب /10",
