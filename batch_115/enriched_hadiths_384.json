    {
      "hadith_id": 1031759,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 41205,
      "text_ar": "0 /11 إبراهيم بْن مرزوق البصري نزيل مصر /11 /11 وإبراهيم بْن المستمر العروقي /11 /11 وأَحْمَد بْن إبراهيم الدورقي /11 /11 وأَحْمَد بْن سعيد الدارمي /11 /11 وأَحْمَد بْن عَبْد اللَّه بْن عَلِيّ بْن منجوف السدوسي /11 /11 وأَحْمَد بْن المنذر القزاز /11 /11 والحسن بْن أَبِي الربيع الجرجاني /11 /11 ورجاء بْن مُحَمَّد العذري البصري ت /11 /11 وعباد بْن الوليد الغبري /11 /11 وعَبْدة بْن عَبْد اللَّه الصفار ت /11 /11 وعلي بْن مسلم الطوسي /11 /11 ومُحَمَّد بْن بشار بندار /11 /11 ومُحَمَّد بْن الحسين البرجلاني /11 /11 ومُحَمَّد بْن سنان القزاز /11 /11 ومُحَمَّد بْن شعبة بْن جوان /11 /11 وأَبُو موسى مُحَمَّد بْن المثنى /11 /11 ومُحَمَّد بْن مرزوق البصري /11 /11 ومُحَمَّد بْن يونس الكديمي /11 /11 ويحيى بْن معين /11 /11 ويعقوب بْن إبراهيم الدورقي /11 ++ قال أَحْمَد بْن سعيد الدارمي : دلنا عليه أَبُو داود الطيالسي . #",
      "sanad_ar": "0 /11 إبراهيم بْن مرزوق البصري نزيل مصر /11 /11 وإبراهيم بْن المستمر العروقي /11 /11 وأَحْمَد بْن إبراهيم الدورقي /11 /11 وأَحْمَد بْن سعيد الدارمي /11 /11 وأَحْمَد بْن عَبْد اللَّه بْن عَلِيّ بْن منجوف السدوسي /11 /11 وأَحْمَد بْن المنذر القزاز /11 /11 والحسن بْن أَبِي الربيع الجرجاني /11 /11 ورجاء بْن مُحَمَّد العذري البصري ت /11 /11 وعباد بْن الوليد الغبري /11 /11 وعَبْدة بْن عَبْد اللَّه الصفار ت /11 /11 وعلي بْن مسلم الطوسي /11 /11 ومُحَمَّد بْن بشار بندار /11 /11 ومُحَمَّد بْن الحسين البرجلاني /11 /11 ومُحَمَّد بْن سنان القزاز /11 /11 ومُحَمَّد بْن شعبة بْن جوان /11 /11 وأَبُو موسى مُحَمَّد بْن المثنى /11 /11 ومُحَمَّد بْن مرزوق البصري /11 /11 ومُحَمَّد بْن يونس الكديمي /11 /11 ويحيى بْن معين /11 /11 ويعقوب بْن إبراهيم الدورقي /11 ++ قال أَحْمَد بْن سعيد الدارمي",
      "matn_ar": "دلنا عليه أَبُو داود الطيالسي . #",
