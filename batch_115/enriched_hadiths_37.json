    {
      "hadith_id": 1026554,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 36000,
      "text_ar": "أخبرنا بِهِ /94 أَحْمَد بْن بي الخير /94 ، قال : أَنْبَأَنَا الْقَاضِي /26 أَبُو الْمَكَارِمِ اللَّبَّانُ /26 ، قال : أخبرنا /26 أبو علي الحداد L14761 /26 ، قال : أخبرنا /26 أبو نعيم الحافظ L9927 /26 قال : حَدَّثَنَا /26 أَحْمَد بْن إِسْحَاق /26 ، قال : حَدَّثَنَا /26 أَبُو بَكْر بْن أَبِي دَاوُد /26 ، قال : حَدَّثَنَا /26 مَحْمُود بْن خَالِد /26 ، قال : حَدَّثَنَا /26 الْوَلِيد بْن مُسْلِم /26 ، عَنِ /26 الأوزاعي /26 ، عَنْ /26 هَارُون بْن رئاب /26 ، عَنْ /26 عتبة بْن غزوان الرقاشي /26 ، قال : /27 قال لي /26 أَبُو موسى /26 : مَا لي أرى عينك نافرة ، فَقُلْتُ : إني التفت التفاتة فرأيت جارية لبعض الجيش ، فلحظتها لحظة ، فصككتها صكة ، فنفرت فصارت إِلَى مَا ترى ، فَقَالَ : استغفر ربك ، ظلمت /20 عينك إِن لَهَا أول نظرة وعليك مَا بعدها /27 * \r\n++ ذكرناه للتمييز بينهما . @ 5394 [ 3783 ] س :'E3318",
      "sanad_ar": "أخبرنا بِهِ /94 أَحْمَد بْن بي الخير /94",
