    {
      "hadith_id": 1026295,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 35741,
      "text_ar": "أخبرنا بِهِ /94 أبو الحسن بن البخاري L75025 /94 ، /94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حنبل L62448 /26 ، قال : أخبرنا /26 ابن الحصين L46125 /26 ، قال : أخبرنا /26 ابن المذهب L14991 /26 ، قال : أخبرنا /26 القطيعي L8994 /26 ، قال : حَدَّثَنَا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حَدَّثَنَا /26 يَحْيَى بْنُ سَعِيدٍ L8271 /26 ، عَنِ /26 ابْنِ جُرَيْجٍ L5223 /26 ، قال : أَخْبَرَنِي /26 يَحْيَى بْنُ عُبَيْدٍ L8306 /26 ، عَنْ /26 أَبِيهِ L41203 /26 ، /27 عَنْ /93 عَبْدِ اللَّهِ بْنِ السَّائِبِ L4701 /93 ، قال : سَمِعْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم ، يَقُولُ /20 بَيْنَ الرُّكْنِ الْيَمَانِيِّ والْحِجْرِ : “ /4 رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وفِي الآخِرَةِ حَسَنَةً وقِنَا عَذَابَ النَّارِ /4 “ /27 . ح رَوَاهُ أَبُو دَاوُد ، عَنْ مسدد ، عَنْ عيسى بْن يُونُس ، عَنِ ابْن جريج ، ورواه النسائي ، عَنْ يَعْقُوب بْن إِبْرَاهِيم الدورقي ، عَنْ يَحْيَى بْن سَعِيد ، فوقع لنا بدلا عاليا * \r\n@ 5347 عُبَيْد الصيد هُوَ ابْن عَبْد الرَّحْمَنِ . تقدم . @ 5348 عُبَيْد المكتب هُوَ ابْن مهران . تقدم . @ 5349 عُبَيْد أَبُو عامر الأشعري . يَأْتِي من الكنى . @ 5350 ومن الأوهام : وهُمْ @ 5351.E3296",
      "sanad_ar": "أخبرنا بِهِ /94 أبو الحسن بن البخاري L75025 /94",
      "matn_ar": "/94 وأَبُو الْغَنَائِمِ بْنُ عَلانَ L46139 /94 ، /94 وأَحْمَدُ بْنُ شَيْبَانَ L75042 /94 ، قَالُوا : أخبرنا /26 حنبل L62448 /26 ، قال : أخبرنا /26 ابن الحصين L46125 /26 ، قال : أخبرنا /26 ابن المذهب L14991 /26 ، قال : أخبرنا /26 القطيعي L8994 /26 ، قال : حَدَّثَنَا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حَدَّثَنَا /26 يَحْيَى بْنُ سَعِيدٍ L8271 /26 ، عَنِ /26 ابْنِ جُرَيْجٍ L5223 /26 ، قال : أَخْبَرَنِي /26 يَحْيَى بْنُ عُبَيْدٍ L8306 /26 ، عَنْ /26 أَبِيهِ L41203 /26 ، /27 عَنْ /93 عَبْدِ اللَّهِ بْنِ السَّائِبِ L4701 /93 ، قال : سَمِعْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم ، يَقُولُ /20 بَيْنَ الرُّكْنِ الْيَمَانِيِّ والْحِجْرِ : “ /4 رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وفِي الآخِرَةِ حَسَنَةً وقِنَا عَذَابَ النَّارِ /4 “ /27 . ح رَوَاهُ أَبُو دَاوُد ، عَنْ مسدد ، عَنْ عيسى بْن يُونُس ، عَنِ ابْن جريج ، ورواه النسائي ، عَنْ يَعْقُوب بْن إِبْرَاهِيم الدورقي ، عَنْ يَحْيَى بْن سَعِيد ، فوقع لنا بدلا عاليا * \r\n@ 5347 عُبَيْد الصيد هُوَ ابْن عَبْد الرَّحْمَنِ . تقدم . @ 5348 عُبَيْد المكتب هُوَ ابْن مهران . تقدم . @ 5349 عُبَيْد أَبُو عامر الأشعري . يَأْتِي من الكنى . @ 5350 ومن الأوهام : وهُمْ @ 5351.E3296",
