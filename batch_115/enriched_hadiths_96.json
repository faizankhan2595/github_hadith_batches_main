    {
      "hadith_id": 1027438,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 36884,
      "text_ar": "2 ++ روى له أبو داود ، والترمذي في الشمائل ، وابن مَاجَهْ حديثا واحدا ، وقد وقع لنا بعلو عنه . ++ \r\n$2186  -10 /2 /143 أخبرنا بِهِ /94 أبَوُ الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، /94 وأحمد بن شيبان L75042 /94 ، /94 وإِسْمَاعِيلُ بْنُ الْعَسْقَلانِيِّ L63233 /94 ، /94 وزَيْنَبُ بِنْتُ مَكِّيِّ L75040 /94 ، قَالُوا : أخبرنا /26 أبو حفص بن طبرزد L25365 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو طَالِبِ بْنُ غَيْلانَ L30523 /26 ، قال : أخبرنا /26 أَبُو بَكْرٍ الشَّافِعِيُّ L29718 /26 ، قال : حَدَّثَنِي /26 إِسْحَاقُ بْنُ الْحَسَنِ الْحَرْبِيُّ L12002 /26 ، قال : حدثنا /26 أَبُو غَسَّانَ L6661 /26 ، قال : حدثنا /26 زُهَيْرٌ L3044 /26 ، قال : حدثنا /26 عُرْوَةُ بْنُ عَبْدِ اللَّهِ بْنِ قُشَيْرٍ أَبُو مَهَلٍ L5600 /26 ، قال : /27 حَدَّثَنِي /26 مُعَاوِيَةُ بْنُ قُرَّةَ L7591 /26 ، عَنْ /93 أَبِيهِ L6471 /93 ، قال : \" أَتَيْتُ النَّبِيَّ صلى الله عليه وسلم ، فِي رَهْطٍ مِنْ مُزَيْنَةَ ، فَبَايَعْنَاهُ ، وإِنَّ /20 قَمِيصَهُ لَمُطْلَقٌ ، قال : ثُمَّ أَدْخَلْتُ يَدِي مِنْ جَيْبِ قَمِيصِهِ فَمَسَسْتُ الْخَاتَمَ /27 ، قال عُرْوَةُ : فَمَا رَأَيْتُ مُعَاوِيَةَ ، ولا ابْنَهُ فِي شِتَاءٍ يَعْنِي ، ولا صَيْفٍ إِلا مُطْلِقِي أَزْرَارَهُمَا لا يَزُرَّانِ أَبَدًا \" . رَوَاهُ أَبُو دَاوُدَ ، عَنِ النُّفَيْلِيِّ ، وأَحْمَدُ بْنُ يُونُسَ ، عَنْ زُهَيْرٍ ، فَوَقَعَ لَنَا بَدَلا عَالِيًا ، ورَوَاهُ التِّرْمِذِيُّ ، وابْنُ مَاجَهْ مِنْ حَدِيثِ أَبِي نُعَيْمٍ ، عَنْ زُهَيْرٍ ، فَوَقَع لَنَا عَالِيًا بِدَرَجَتَيْنِ * \r\n@ 5534 [ 3910 ] بخ م س)E3430",
      "sanad_ar": "2 ++ روى له أبو داود",
      "matn_ar": "والترمذي في الشمائل ، وابن مَاجَهْ حديثا واحدا ، وقد وقع لنا بعلو عنه . ++ \r\n$2186  -10 /2 /143 أخبرنا بِهِ /94 أبَوُ الْحَسَنِ بْنُ الْبُخَارِيِّ L75025 /94 ، /94 وأحمد بن شيبان L75042 /94 ، /94 وإِسْمَاعِيلُ بْنُ الْعَسْقَلانِيِّ L63233 /94 ، /94 وزَيْنَبُ بِنْتُ مَكِّيِّ L75040 /94 ، قَالُوا : أخبرنا /26 أبو حفص بن طبرزد L25365 /26 ، قال : أخبرنا /26 أَبُو الْقَاسِمِ بْنُ الْحُصَيْنِ L46125 /26 ، قال : أخبرنا /26 أَبُو طَالِبِ بْنُ غَيْلانَ L30523 /26 ، قال : أخبرنا /26 أَبُو بَكْرٍ الشَّافِعِيُّ L29718 /26 ، قال : حَدَّثَنِي /26 إِسْحَاقُ بْنُ الْحَسَنِ الْحَرْبِيُّ L12002 /26 ، قال : حدثنا /26 أَبُو غَسَّانَ L6661 /26 ، قال : حدثنا /26 زُهَيْرٌ L3044 /26 ، قال : حدثنا /26 عُرْوَةُ بْنُ عَبْدِ اللَّهِ بْنِ قُشَيْرٍ أَبُو مَهَلٍ L5600 /26 ، قال : /27 حَدَّثَنِي /26 مُعَاوِيَةُ بْنُ قُرَّةَ L7591 /26 ، عَنْ /93 أَبِيهِ L6471 /93 ، قال : \" أَتَيْتُ النَّبِيَّ صلى الله عليه وسلم ، فِي رَهْطٍ مِنْ مُزَيْنَةَ ، فَبَايَعْنَاهُ ، وإِنَّ /20 قَمِيصَهُ لَمُطْلَقٌ ، قال : ثُمَّ أَدْخَلْتُ يَدِي مِنْ جَيْبِ قَمِيصِهِ فَمَسَسْتُ الْخَاتَمَ /27 ، قال عُرْوَةُ : فَمَا رَأَيْتُ مُعَاوِيَةَ ، ولا ابْنَهُ فِي شِتَاءٍ يَعْنِي ، ولا صَيْفٍ إِلا مُطْلِقِي أَزْرَارَهُمَا لا يَزُرَّانِ أَبَدًا \" . رَوَاهُ أَبُو دَاوُدَ ، عَنِ النُّفَيْلِيِّ ، وأَحْمَدُ بْنُ يُونُسَ ، عَنْ زُهَيْرٍ ، فَوَقَعَ لَنَا بَدَلا عَالِيًا ، ورَوَاهُ التِّرْمِذِيُّ ، وابْنُ مَاجَهْ مِنْ حَدِيثِ أَبِي نُعَيْمٍ ، عَنْ زُهَيْرٍ ، فَوَقَع لَنَا عَالِيًا بِدَرَجَتَيْنِ * \r\n@ 5534 [ 3910 ] بخ م س)E3430",
