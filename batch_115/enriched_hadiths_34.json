    {
      "hadith_id": 1026509,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 35955,
      "text_ar": "0 /11 الْبُخَارِي فِي كتاب القراءة خلف الإِمَام /11 /11 وإبراهيم بْن سَعِيد الجوهري /11 /11 وأَحْمَد بْن عَبْد الْوَهَّاب بْن نجدة الحوطي /11 /11 وأَبُو سليم إِسْمَاعِيل بْن حصن الجبيلي /11 /11 وعبد الكريم بْن الهيثم الديرعاقولي /11 /11 وعثمان بْن سَعِيد الدارمي /11 /11 وعمر بْن أَبِي عُمَر البلخي /11 /11 وعمران بْن بكار الحمصي /11 /11 والقاسم بْن هاشم السمسار /11 /11 وأَبُو أمية مُحَمَّد بْن إِبْرَاهِيم الطرسوسي /11 /11 ومُحَمَّد بْن عوف الطائي /11 /11 ومُحَمَّد بْن مصفى الحمصي /11 /11 ومُحَمَّد بْن يَحْيَى الذهلي وكناه /11 # قال",
      "sanad_ar": "",
