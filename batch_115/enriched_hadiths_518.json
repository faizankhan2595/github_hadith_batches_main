    {
      "hadith_id": 1033768,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 43214,
      "text_ar": "الرام /10 إِبْرَاهِيم بْن عَبْد الرَّحْمَنِ بْن مهدي د ت /10 /10 وأحمد بْن حنبل /10 /10 وأبي الجواب الأحوص بْن جواب س /10 /10 والأسود بْن عامر شاذان سي /10 /10 والحسن بْن مُوسَى الأشيب خ س /10 /10 وحسين بْن عَلِيّ الجعفي /10 /10 وحسين بْن مُحَمَّد المروذي خ /10 /10 وحفص بْن عمر الحوضي عس /10 /10 وخلف بْن تميم /10 /10 وداود بْن عمرو الضبي س /10 /10 وداود بْن المحبر /10 /10 وزيد بْن الحباب /10 /10 وسريج بْن النعمان الجوهري سي /10 /10 وشبابة بْن سوار م /10 /10 وأبي عاصم الضحاك بْن مخلد /10 /10 وأبي معمر عَبْد اللَّهِ بْن عمرو المنقري س /10 /10 وعَبْد الرَّحْمَنِ بْن غزوان المعروف بقراد أبي نوح ت /10 /10 وعبد الوهاب بْن عطاء الخفاف /10 /10 وعفان بْن مسلم مق ص /10 /10 وعلي بْن المديني /10 /10 وأبي الحسن غالب بْن فهيد المغالبي الكوفي /10 /10 وقبيصة بْن عقبة /10 /10 ومُحَمَّد بْن بشر العبدي /10 /10 ومُحَمَّد بْن جَعْفَر المدائني /10 /10 ومُحَمَّد بْن الصلت الأسدي /10 /10 وأبي أَحْمَد مُحَمَّد بْن عَبْد اللَّهِ بْن الزبير الزبيري م /10 /10 ومُحَمَّد بْن عَبْد اللَّهِ الرقاشي سي /10 /10 ومعلى بْن أسد العمي /10 /10 ومعلى بْن مَنْصُور الرازي مق /10 /10 وأبي علقمة مُوسَى بْن ميمون بْن مُوسَى بْن عَبْد الرَّحْمَنِ بْن صفوان بْن قدامة المرائي /10 /10 وموسى بْن هلال النخعي الكوفي /10 /10 والصحيح أن بينهما الهذيل بْن أبي الغريف الهمداني /10 /10 وعن أبي النضر هاشم بْن القاسم خ س /10 /10 والهذيل بْن أبي الغريف الهمداني /10 /10 وهشام بْن سعيد الطالقاني /10 /10 والوليد بْن صالح النحاس مق /10 /10 ويحيى بْن غيلان م ت س /10 /10 ويزيد بْن هارون م /10 /10 ويعقوب   بْن إِبْرَاهِيم بْن سعد س /10 /10 ويونس بْن مُحَمَّد المؤدب ت /10",
