    {
      "hadith_id": 1033769,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 43215,
      "text_ar": "0 /11 الجماعة سوى : ابْن ماجه /11 /11 وأبو بَكْر أَحْمَد بْن عمرو بْن أبي عاصم /11 /11 وأبو بَكْر أَحْمَد بْن عمرو بْن عبد الخالق البزار /11 /11 وأحمد بْن مُحَمَّد بْن الجراح الضراب /11 /11 والحسن بْن سفيان النسائي /11 /11 والحسين بْن إِسْمَاعِيل المحاملي /11 /11 والحسين بْن عَبْد اللَّهِ بْن شاكر /11 /11 وعَبْد اللَّهِ بْن أَحْمَد بْن حنبل /11 /11 وأبو بَكْر عَبْد اللَّهِ بْن مُحَمَّد بْن أبي الدنيا /11 /11 وأَبُو الْقَاسِمِ عَبْد اللَّهِ بْن مُحَمَّد بْن عبد العزيز البغوي /11 /11 وعبدان بْن أَحْمَد الأهوازي /11 /11 وعمر بْن مُحَمَّد بْن بجير البجيري /11 /11 والقاسم بْن زكريا المطرز /11 /11 وأبو حاتم مُحَمَّد بْن إدريس الرازي /11 /11 ومُحَمَّد بْن إِسْحَاق الثقفي السراج /11 /11 ومُحَمَّد بْن مخلد الدوري /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 # قال",
      "sanad_ar": "0 /11 الجماعة سوى",
      "matn_ar": "ابْن ماجه /11 /11 وأبو بَكْر أَحْمَد بْن عمرو بْن أبي عاصم /11 /11 وأبو بَكْر أَحْمَد بْن عمرو بْن عبد الخالق البزار /11 /11 وأحمد بْن مُحَمَّد بْن الجراح الضراب /11 /11 والحسن بْن سفيان النسائي /11 /11 والحسين بْن إِسْمَاعِيل المحاملي /11 /11 والحسين بْن عَبْد اللَّهِ بْن شاكر /11 /11 وعَبْد اللَّهِ بْن أَحْمَد بْن حنبل /11 /11 وأبو بَكْر عَبْد اللَّهِ بْن مُحَمَّد بْن أبي الدنيا /11 /11 وأَبُو الْقَاسِمِ عَبْد اللَّهِ بْن مُحَمَّد بْن عبد العزيز البغوي /11 /11 وعبدان بْن أَحْمَد الأهوازي /11 /11 وعمر بْن مُحَمَّد بْن بجير البجيري /11 /11 والقاسم بْن زكريا المطرز /11 /11 وأبو حاتم مُحَمَّد بْن إدريس الرازي /11 /11 ومُحَمَّد بْن إِسْحَاق الثقفي السراج /11 /11 ومُحَمَّد بْن مخلد الدوري /11 /11 ويحيى بْن مُحَمَّد بْن صاعد /11 # قال",
