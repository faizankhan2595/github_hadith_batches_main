    {
      "hadith_id": 1033078,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 42524,
      "text_ar": "أَبُو الْعَبَّاسِ ويقال أَبُو مُوسَى المدني ثم البغدادي أخو دَاوُد بْن عَلِيّ وسليمان بْن عَلِيّ ، وعَبْد الصَّمَدِ بْن عَلِيّ ، ومُحَمَّد بْن عَلِيّ ، وعم السفاح ، والمنصور كان يكون بالشراة من أرض البلقاء ، ثم سكن بغداد ، وإليه ينسب قصر عِيسَى ، ونهر عِيسَى ، وقطيعة عِيسَى ببغداد . /10 أبيه عَلِيّ بْن عَبْد اللَّهِ بْن عَبَّاس د ت /10 /10 وأخيه مُحَمَّد بْن عَلِيّ بْن عَبْد اللَّهِ بْن عَبَّاس /10",
      "sanad_ar": "أَبُو الْعَبَّاسِ ويقال أَبُو مُوسَى المدني ثم البغدادي أخو دَاوُد بْن عَلِيّ وسليمان بْن عَلِيّ",
      "matn_ar": "وعَبْد الصَّمَدِ بْن عَلِيّ ، ومُحَمَّد بْن عَلِيّ ، وعم السفاح ، والمنصور كان يكون بالشراة من أرض البلقاء ، ثم سكن بغداد ، وإليه ينسب قصر عِيسَى ، ونهر عِيسَى ، وقطيعة عِيسَى ببغداد . /10 أبيه عَلِيّ بْن عَبْد اللَّهِ بْن عَبَّاس د ت /10 /10 وأخيه مُحَمَّد بْن عَلِيّ بْن عَبْد اللَّهِ بْن عَبَّاس /10",
      "grade": null,
      "page_number": null,
      "formatting_codes": "/10,/10,/10,/10",
