      "hadith_id": 1026925,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 36371,
      "text_ar": "أخبرنا /94 أبو الفرج بن قدامة L46136 /94 ، /94 وأبو الحسن بن البخاري L75025 /94 ، /94 وأبو الغنائم بن علان L46139 /94 ، /94 وأحمد بن شيبان L75042 /94 ، /94 وزَيْنَبُ بِنْتُ مَكِّيٍّ L75040 /94 ، بِدِمَشْقَ ، /94 وغَازِي بْنُ أَبِي الْفَضْلِ L75044 /94 بقَطيا ، قَالُوا : أخبرنا /26 حنبل L62448 /26 ، قال : أخبرنا /26 ابن الحصين L46125 /26 ، قال : أخبرنا /26 ابن المذهب L14991 /26 ، قال : أخبرنا /26 القطيعي L8994 /26 ، قال : حَدَّثَنَا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حَدَّثَنَا /26 عُثْمَانُ بْنُ عُثْمَانَ يَعْنِي الْغَطْفَانِيَّ L5540 /26 ، قال : أخبرنا /26 عُمَرُ بْنُ نَافِعٍ L6013 /26 ، عَنْ /26 أَبِيهِ L7863 /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قال : “ نَهَى رَسُولُ اللَّهِ صلى الله عليه وسلم عَنِ /20 الْفَرْعِ “ /27 ، والْفَرْعُ أَنْ يَحْلِقَ الصَّبِيُّ فَيَتْرُكَ بَعْضَ شَعْرِهِ . رَوَاهُ مُسْلِم ، عَنْ مُحَمَّد بْن المثنى ، عَنْهُ ، فوقع لنا بدلا عاليا ، وليس لَهُ عنده غيره ، ورواه أَبُو دَاوُد ، عَنْ أَحْمَد بْن حنبل ، فوافقناه فِيهِ بعلو ، وأخرجه الْبُخَارِي ، والنسائي ، وابن ماجه من حَدِيث عُمَر بْن نَافِع * \r\n@ 5462 [ 3845 ] خ م د س ق#E3368",
      "sanad_ar": "أخبرنا /94 أبو الفرج بن قدامة L46136 /94",
      "matn_ar": "/94 وأبو الحسن بن البخاري L75025 /94 ، /94 وأبو الغنائم بن علان L46139 /94 ، /94 وأحمد بن شيبان L75042 /94 ، /94 وزَيْنَبُ بِنْتُ مَكِّيٍّ L75040 /94 ، بِدِمَشْقَ ، /94 وغَازِي بْنُ أَبِي الْفَضْلِ L75044 /94 بقَطيا ، قَالُوا : أخبرنا /26 حنبل L62448 /26 ، قال : أخبرنا /26 ابن الحصين L46125 /26 ، قال : أخبرنا /26 ابن المذهب L14991 /26 ، قال : أخبرنا /26 القطيعي L8994 /26 ، قال : حَدَّثَنَا /26 عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ L4657 /26 ، قال : حَدَّثَنِي /26 أَبِي L488 /26 ، قال : حَدَّثَنَا /26 عُثْمَانُ بْنُ عُثْمَانَ يَعْنِي الْغَطْفَانِيَّ L5540 /26 ، قال : أخبرنا /26 عُمَرُ بْنُ نَافِعٍ L6013 /26 ، عَنْ /26 أَبِيهِ L7863 /26 ، /27 عَنِ /93 ابْنِ عُمَرَ L4967 /93 ، قال : “ نَهَى رَسُولُ اللَّهِ صلى الله عليه وسلم عَنِ /20 الْفَرْعِ “ /27 ، والْفَرْعُ أَنْ يَحْلِقَ الصَّبِيُّ فَيَتْرُكَ بَعْضَ شَعْرِهِ . رَوَاهُ مُسْلِم ، عَنْ مُحَمَّد بْن المثنى ، عَنْهُ ، فوقع لنا بدلا عاليا ، وليس لَهُ عنده غيره ، ورواه أَبُو دَاوُد ، عَنْ أَحْمَد بْن حنبل ، فوافقناه فِيهِ بعلو ، وأخرجه الْبُخَارِي ، والنسائي ، وابن ماجه من حَدِيث عُمَر بْن نَافِع * \r\n@ 5462 [ 3845 ] خ م د س ق#E3368",
