    {
      "hadith_id": 1026493,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 35939,
      "text_ar": "القارئ إمام الْمَسْجِد الجامع بدمشق /10 خَالِد بْن يَزِيد بْن صَالِح بْن صبيح المري /10 /10 وسعيد بْن بشير /10 /10 وسعيد بْن عَبْد الْعَزِيز /10 /10 وسُفْيَان بْن عُيَيْنَة /10 /10 وعَبْد الرَّحْمَنِ بْن ثابت بْن ثوبان ق /10 /10 وعَبْد الرَّحْمَنِ بْن أَبِي الزناد /10 /10 وعَبْد الرَّحْمَنِ بْن عَمْرو الأوزاعي /10 /10 وعبد الْعَزِيز بْن إِسْمَاعِيل بْن عُبَيْد اللَّه بْن أَبِي المهاجر /10 /10 والليث بْن سَعْد /10 /10 ومَالِك بْن أَنَس /10 /10 ومُحَمَّد بْن الْوَلِيد الزبيدي /10 /10 ومنيب بْن مدرك /10 /10 والوضين بْن عَطَاء /10",
