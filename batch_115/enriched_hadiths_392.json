    {
      "hadith_id": 1031870,
      "book_id": 1857,
      "chapter_id": null,
      "hadith_number": 41316,
      "text_ar": "كنيته أَبُو سعيد /10 إبراهيم بْن موسى الرازي س /10 /10 وأَحْمَد بْن حَنْبَل س /10 /10 وآدم بْن أَبِي إياس العسقلاني س /10 /10 وأصبغ بْن الفرج المصري سي /10 /10 وحجاج بْن منهال س /10 /10 وحرمي بْن حفص س /10 /10 وحسان بْن عَبْد اللَّه الواسطي س /10 /10 والحسن بْن الربيع البوراني س /10 /10 وأبي عمر حفص بْن عمر الحوضي س /10 /10 والحكم بْن موسى القنطري س /10 /10 وأبي اليمان الحكم بْن نافع البهراني س /10 /10 والخضر بْن مُحَمَّد بْن شجاع الجزري /10 /10 وخلف بْن موسى بْن خلف العمي س /10 /10 وروح بْن عَبْد المؤمن المقرئ /10 /10 وسعيد بْن ذؤيب المروزي س /10 /10 وسعيد بْن المغيرة المصيصي الصياد /10 /10 وسعيد بْن منصور عس /10 /10 وسليمان بْن حرب س /10 /10 وسليمان بْن عَبْد الرحمن الدمشقي /10 /10 وسليمان بْن عبيد اللَّه الخطاب الرقي /10 /10 وسهل بْن مُحَمَّد بْن الزبير العسكري س /10 /10 وعاصم بْن يوسف اليربوعي س /10 /10 وعَبْد اللَّه بْن جعفر الرقي س /10 /10 وعَبْد اللَّه بْن رجاء الغداني س /10 /10 وعَبْد اللَّه بْن عَبْد الوهاب الحجبي س /10 /10 وعَبْد اللَّه بْن مُحَمَّد بْن أسماء الضبعي س /10 /10 وأبي جعفر عَبْد اللَّه بْن مُحَمَّد النفيلي س /10 /10 وعَبْد اللَّه بْن مسلمة القعنبي س /10 /10 وعَبْد اللَّه بْن يوسف التنيسي /10 /10 وأبي مسهر عَبْد الأعلى بْن مسهر الغساني س /10 /10 وعَبْد الحميد بْن صالح البرجمي س /10 /10 وعَبْد الرحمن بْن المبارك العيشي س /10 /10 وأبي قدامة عبيد اللَّه بْن سعيد السرخسي /10 /10 وعثمان بْن صالح السهمي س /10 /10 وعفان بْن مسلم س /10 /10 وعلي بْن الحسن النسائي ثم الرقي /10 /10 وعلي بْن عياش الحمصي س /10 /10 وعمر   بْن حفص بْن غياث س /10 /10 وأبي نعيم الفضل بْن دكين س /10 /10 ومُحَمَّد بْن الصلت الأسدي س /10 /10 ومُحَمَّد بْن عَبْد اللَّه الرقاشي س /10 /10 ومُحَمَّد بْن عيسى بْن الطباع س /10 /10 ومُحَمَّد بْن كثير المصيصي سي /10 /10 وأبي همام الدلال مُحَمَّد بْن محبب س /10 /10 ومُحَمَّد بْن محبوب البصري سي /10 /10 ومسلم بْن إبراهيم س /10 /10 ومعلى بْن أسد العمي س /10 /10 ومقاتل بْن مُحَمَّد الرازي /10 /10 وموسى بْن داود الضبي س /10 /10 وهشام بْن بهرام المدائني س /10 /10 وأبي الوليد هشام بْن عَبْد الملك الطيالسي س /10 /10 والهيثم بْن خارجة س /10 /10 ويزيد بْن مهران الخباز س /10",
