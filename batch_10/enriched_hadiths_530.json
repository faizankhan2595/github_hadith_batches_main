    {
      "hadith_id": 88949,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 7555,
      "text_ar": "مولى عبد الله بن الزبير بن العوام . توفي سنة سبع وعشرين ومائة ، وسألت محمد بن عمر عن وهب بن كيسان فقال : لم يكن له فتوى ، وكان محدثا ثقة . وكان يصلي وينصرف ، وقد لقي عدة من أصحاب رسول الله صلى الله عليه وسلم . \r\n$6803  6804 /3 /141 أَخْبَرَنَا /94 مُحَمَّدُ بْنُ عُمَرَ /94 , قَالَ : أَخْبَرَنَا /26 عَبْدُ اللَّهِ بْنِ عُمَرَ الْعُمَرِيُّ /26 , قَالَ : أَخْبَرَنِي /26 وَهْبُ بْنُ كَيْسَانَ /26 , قَالَ : /27 \" رَأَيْتُ /93 سَعْدَ بْنَ أَبِي وَقَّاصٍ L3232 /93 , /93 وَجَابِرَ بْنَ عَبْدِ اللَّهِ L2069 /93 , /93 وَأَبَا سَعِيدٍ الْخُدْرِيَّ L3260 /93 , /93 وَأَبَا هُرَيْرَةَ L4396 /93 /20 يَلْبَسُونَ الْخَزَّ \" /27 * \r\n\u001fE2116",
      "sanad_ar": "مولى عبد الله بن الزبير بن العوام . توفي سنة سبع وعشرين ومائة",
      "matn_ar": "وسألت محمد بن عمر عن وهب بن كيسان فقال : لم يكن له فتوى ، وكان محدثا ثقة . وكان يصلي وينصرف ، وقد لقي عدة من أصحاب رسول الله صلى الله عليه وسلم . \r\n$6803  6804 /3 /141 أَخْبَرَنَا /94 مُحَمَّدُ بْنُ عُمَرَ /94 , قَالَ : أَخْبَرَنَا /26 عَبْدُ اللَّهِ بْنِ عُمَرَ الْعُمَرِيُّ /26 , قَالَ : أَخْبَرَنِي /26 وَهْبُ بْنُ كَيْسَانَ /26 , قَالَ : /27 \" رَأَيْتُ /93 سَعْدَ بْنَ أَبِي وَقَّاصٍ L3232 /93 , /93 وَجَابِرَ بْنَ عَبْدِ اللَّهِ L2069 /93 , /93 وَأَبَا سَعِيدٍ الْخُدْرِيَّ L3260 /93 , /93 وَأَبَا هُرَيْرَةَ L4396 /93 /20 يَلْبَسُونَ الْخَزَّ \" /27 * \r\n\u001fE2116",
      "grade": null,
