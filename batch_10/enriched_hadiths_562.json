    {
      "hadith_id": 89422,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 8028,
      "text_ar": ", وكان يسار مكاتبًا لرجل من أسلم فأدى عنه عبد الله بن أبي فروة كتابته فعتق فصار هو وولده مع آل عبد الله بن أبي فروة وفي دعوتهم , وكاتن مطرف من أصحاب مالك بن أنس , وكان ثقة وكان به صمم , ومات بالمدينة في أول سنة عشرين ومائتين .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
