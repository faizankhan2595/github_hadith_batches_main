    {
      "hadith_id": 89419,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 8025,
      "text_ar": ", وهو أبو أويس بن عبد الله بن أويس بن مالك بن أبي عامر , وأمه أخت مالك بن أنس , وكان أبو بكر صاحب عربية وقراءة ورواية عن نافع بن أبي نعيم وسليمان بن بلال وغيرهما . وأخوه",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
