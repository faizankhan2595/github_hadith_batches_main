    {
      "hadith_id": 89441,
      "book_id": 82,
      "chapter_id": null,
      "hadith_number": 8047,
      "text_ar": ", وأمه من آل خالد بن الزبير بن العوام وأم أبيه أم ولد , وأم جده أم ولد , ويكنى إبراهيم أبا إسحاق , وقتل حمزة بن مصعب وابنه عمارة بن حمزة بقديد , ولم يجالس إبراهيم بن حمزة مالك بن أنس , وسمع من عبد العزيز بن محمد بن الداوردي وعبد العزيز بن أبي حازم وغيرهما من رجال أهل المدينة , وهو ثقة صدوق في الحديث , ويأتي الربذة كثيرًا فيقيم بها ويتجر بها ويشهد العيدين بالمدينة .",
      "sanad_ar": "",
      "matn_ar": "",
      "grade": null,
      "page_number": null,
      "formatting_codes": "",
