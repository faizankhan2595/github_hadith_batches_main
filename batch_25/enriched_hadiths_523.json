    {
      "hadith_id": 223832,
      "book_id": 176,
      "chapter_id": null,
      "hadith_number": 601,
      "text_ar": "/27 سَأَلْتُ /94 أَبَا عَبْدِ اللَّهِ /94 \" عَنِ /20 الْخَرْدَلِ يُطْرَحُ فِيهِ الزَّبِيبُ ؟ قَالَ : يُؤْكَلُ إِلَى ثَلاثٍ \" ، قُلْتُ : فَإِنَّهُ لا يَغْلِي ، فَأَيْشِ تَكْرَهُ مِنْ أَكْلِهِ ؟ فَقَالَ : \" الْعَصِيرُ يُشْرَبُ إِلَى ثَلاثٍ ، فَإِذَا كَانَ بَعْدَ ثَلاثٍ لَمْ يُشْرَبُ ، وَإِنْ لَمْ يَغْلِ بَعْدَ الثَّلاثِ هَذَا رَأْيُ ابْنِ عُمَرَ \" . قُلْتُ : فَقِسْتُ الْخَرْدَلِ عَلَى الْعَصِيرِ ؟ قَالَ : \" نَعَمْ ، أَلَيْسَ فِيهِ زَبِيبٌ ! لا يُؤْكَلْ بَعْدَ ثَلاثٍ ، إِلَّا أَنْ يُصَبَّ فِيهِ الْخَلُّ \" ، قُلْتُ : فَالسَّلْجَمُ يُصَبُّ فِيهِ الرّوسَانُ ، قَالَ : \" إِذَا غَلا لَمْ يُؤْكَلْ ، وَلَكِنْ يُصَبُّ فِيهِ الْخَلُّ حَتَّى لا يَغْلِيَ \" /27 * \r\n\u001bE89 @ 1 : 174 @ \r\n$532  532 /8",
      "sanad_ar": "/27 سَأَلْتُ /94 أَبَا عَبْدِ اللَّهِ /94 \" عَنِ /20 الْخَرْدَلِ يُطْرَحُ فِيهِ الزَّبِيبُ ؟ قَالَ",
