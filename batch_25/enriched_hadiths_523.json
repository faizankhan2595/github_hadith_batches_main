    {
      "hadith_id": 223840,
      "book_id": 176,
      "chapter_id": null,
      "hadith_number": 609,
      "text_ar": "/27 سَمِعْتُ رَجُلًا مِنْ أَهْلِ حِمْصٍ ، يَقُولُ /26 لِأَبِي عَبْدِ اللَّهِ /26 : إِنِّي قَدْ غِبْتُ عَنْ أَبِي ، وَلَهُ كُرُومٌ ، وَيَسْأَلُنِي /20 أَنْ أُعِينَهُ عَلَى بَيْعِ الْعَصِيرِ ؟    @ 1 : 175 @   فَقَالَ : \" إِنْ عَلِمْتَ أَنَّهُ يَعْمَلُهُ خَمْرًا فَلا تُعِينُهُ \" /27 * \r\n$540  540 /3",
