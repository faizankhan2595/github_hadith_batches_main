    {
      "hadith_id": 1064436,
      "book_id": 4008,
      "chapter_id": null,
      "hadith_number": 476,
      "text_ar": "حَدَّثَنَا /26 عَلِيُ بْنُ الْجَعْدِ L5730 /26 ، قَالَ : أَخْبَرَنَا /26 عَبْدُ الرَّحْمَنِ بْنِ ثَابِتِ بْنِ ثَوْبَانَ L4327 /26 ، عَنْ /26 أَبِيهِ L2016 /26 ، عَنْ /26 مَكْحُولٍ L7659 /26 ، عَنْ /26 يَزِيدَ بْنِ جَارِيَةَ L8405 /26 ، /27 عَنْ /93 حَبِيبِ بْنِ مَسْلَمَةَ L2272 /93 ، قَالَ : /20 \" شَهِدْتُ النَّبِيَّ ، صَلَّى اللَّهُ عَلَيْهِ ، نَفَّلَ الثُّلُثَ \" /27 * \r\nسَمِعْتُ أَبِي ، يَقُولُ : حَبِيبُ بْنُ مَسْلَمَةَ أَبُو عَبْدِ الرَّحْمَنِ .\u001fE71",
      "sanad_ar": "حَدَّثَنَا /26 عَلِيُ بْنُ الْجَعْدِ L5730 /26",
      "matn_ar": "قَالَ : أَخْبَرَنَا /26 عَبْدُ الرَّحْمَنِ بْنِ ثَابِتِ بْنِ ثَوْبَانَ L4327 /26 ، عَنْ /26 أَبِيهِ L2016 /26 ، عَنْ /26 مَكْحُولٍ L7659 /26 ، عَنْ /26 يَزِيدَ بْنِ جَارِيَةَ L8405 /26 ، /27 عَنْ /93 حَبِيبِ بْنِ مَسْلَمَةَ L2272 /93 ، قَالَ : /20 \" شَهِدْتُ النَّبِيَّ ، صَلَّى اللَّهُ عَلَيْهِ ، نَفَّلَ الثُّلُثَ \" /27 * \r\nسَمِعْتُ أَبِي ، يَقُولُ : حَبِيبُ بْنُ مَسْلَمَةَ أَبُو عَبْدِ الرَّحْمَنِ .\u001fE71",
