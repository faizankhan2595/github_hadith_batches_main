    {
      "hadith_id": 1064094,
      "book_id": 4008,
      "chapter_id": null,
      "hadith_number": 134,
      "text_ar": "$79  /2 /141 حَدَّثَنَا /94 أَبُو نُعَيْمٍ L1548 /94 ، قَالَ : نا /26 عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ L4908 /26 ، قَالَ : حَدَّثَنِي /26 عُثْمَانُ بْنُ عَبْدِ اللَّهِ بْنِ أَوْسٍ L5532 /26 ، /27 عَنْ /93 جَدِّهِ L728 /93 ، /20 \" أَنَّهُ كَانَ فِي الْوَفْدِ الَّذِينَ قَدِمُوا إِلَى رَسُولِ اللَّهِ مِنْ بَنِي مَالِكٍ ، فَأَنْزَلَهُمْ فِي قُبَّةٍ لَهُ بَيْنَ الْمَسْجِدِ وَبَيْنَ أَهْلِهِ ، فَكَانَ يَخْتَلِفُ إِلَيْهِمْ ، فَيُحَدِّثُهُمْ بَعْدَ الْعِشَاءِ الآخِرَةِ \" /27 . وَهَذَا هُوَ أَوْسُ بْنُ حُذَيْفَةَ * \r\n$80  /2 /141 حَدَّثَنَا بِذَاكَ /94 عَبْدُ اللَّهِ بْنُ جَعْفَرٍ L4764 /94 ، عَنْ /26 عِيسَى بْنِ يُونُسَ L6343 /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ L4908 /26 ، قَالَ : حَدَّثَنِي /26 عُثْمَانُ بْنُ عَبْدِ اللَّهِ بْنِ أَوْسِ بْنِ حُذَيْفَةَ L5532 /26 ، /27 عَنْ /93 جَدِّهِ L728 /93 ، أَنَّهُ قَدِمَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ فِي وَفْدٍ مِنْ ثَقِيفٍ ، /20 \" فَأُنْزِلَ رَهْطُ الْمُغِيرَةِ عَلَى الْمُغِيرَةِ \" /27 . ثُمَّ ذَكَرَ نَحْوَ حَدِيثِ أَبِي نُعَيْمٍ * \r\n$81  /8",
      "sanad_ar": "$79  /2 /141 حَدَّثَنَا /94 أَبُو نُعَيْمٍ L1548 /94",
      "matn_ar": "قَالَ : نا /26 عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ L4908 /26 ، قَالَ : حَدَّثَنِي /26 عُثْمَانُ بْنُ عَبْدِ اللَّهِ بْنِ أَوْسٍ L5532 /26 ، /27 عَنْ /93 جَدِّهِ L728 /93 ، /20 \" أَنَّهُ كَانَ فِي الْوَفْدِ الَّذِينَ قَدِمُوا إِلَى رَسُولِ اللَّهِ مِنْ بَنِي مَالِكٍ ، فَأَنْزَلَهُمْ فِي قُبَّةٍ لَهُ بَيْنَ الْمَسْجِدِ وَبَيْنَ أَهْلِهِ ، فَكَانَ يَخْتَلِفُ إِلَيْهِمْ ، فَيُحَدِّثُهُمْ بَعْدَ الْعِشَاءِ الآخِرَةِ \" /27 . وَهَذَا هُوَ أَوْسُ بْنُ حُذَيْفَةَ * \r\n$80  /2 /141 حَدَّثَنَا بِذَاكَ /94 عَبْدُ اللَّهِ بْنُ جَعْفَرٍ L4764 /94 ، عَنْ /26 عِيسَى بْنِ يُونُسَ L6343 /26 ، عَنْ /26 عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ L4908 /26 ، قَالَ : حَدَّثَنِي /26 عُثْمَانُ بْنُ عَبْدِ اللَّهِ بْنِ أَوْسِ بْنِ حُذَيْفَةَ L5532 /26 ، /27 عَنْ /93 جَدِّهِ L728 /93 ، أَنَّهُ قَدِمَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ فِي وَفْدٍ مِنْ ثَقِيفٍ ، /20 \" فَأُنْزِلَ رَهْطُ الْمُغِيرَةِ عَلَى الْمُغِيرَةِ \" /27 . ثُمَّ ذَكَرَ نَحْوَ حَدِيثِ أَبِي نُعَيْمٍ * \r\n$81  /8",
